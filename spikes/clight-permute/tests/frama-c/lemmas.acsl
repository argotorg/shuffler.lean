      \param("lemma","moved_frame_all"), \param("P1",A), \param("P2",B),
      \param("P3",P), \param("P4",K), \children(RankSMT));
  proof RankSMT: moved_bounds;
  proof RankFrameCorollary: moved_frame;
  proof RankUpdateCorollary: moved_update;
*/


     \select(H), \param("P1",K), \children(TraceFramePremise)), TraceFrameUnfold;
 strategy TraceNewValue:
   \tactic("Wp.unfold", \ingoal(T: L_replay_value(_,_,_,_,_,_,_)), \select(T), \children(TraceFrameAt)), TraceFrameAt;
 proof TraceNewValue: trace_after_replay;
 proof TraceFrameAt: trace_replay,trace_last_change;

import Skel.Render
import Skel.Driver
import Skel.Gen.Types

/-! The module of a function for its callers (task FULL-DRV, W9). The check files of a caller import the module of each callee
instead of the text of the callee: the module is built once (`lake build`), so a caller's check does not elaborate the callee's
model and proofs again.

The module of `F` has the imports of the check files of `F` (with the modules of the callees of `F`), the namespace of the check
files of `F`, its L2 model text, and each closed L2 row of `F` as a theorem with the name that the caller's texts use (a block
row: its label; `decompiles_l2`). The caller's model names the callee as `F.l2` and `F.decompiles_l2`
(`Skel/Gen/Stmt.lean`); in the namespace `P.G` of the caller these names resolve to `P.F.l2` and `P.F.decompiles_l2`. A row that
is not closed is not in the module: a caller's row that needs it does not check, and the ledger has it as `callee open`. -/

namespace Skel.Full

open Skel Skel.Gen

/-- The module name of the function `short` under the root `root` (`Lift.Shuffler.Proved`). -/
def moduleName (root short : String) : String := s!"{root}.{short}"

/-- The path of a module, from the repository root. -/
def modulePath (m : String) : System.FilePath := System.FilePath.mk (m.replace "." "/" ++ ".lean")

/-- The header `h` with the modules `mods` imported after its imports. -/
def withImports (h : Header) (mods : List String) : Header :=
  { h with imports := (h.imports ++ mods).eraseDups }

/-- The closed L2 rows of `g` as theorems, in ledger order: `proofs` has the proof text of each closed row by name. -/
def closedTheorems (g : Generated) (proofs : List (String × String)) : List String :=
  g.obligations.filterMap fun ob =>
    (proofs.lookup ob.id.name).map fun p => Skel.Driver.answerText ob p

/-- Region proof tasks are generated after their invariant map is known. Their checked statements
and proofs precede the joint row, after its other generated dependencies. -/
def semanticTheorems (g : Generated) (proofs : List (String × String))
    (tasks : List (String × String × String)) : List String :=
  g.obligations.flatMap fun ob =>
    let helpers := if ob.id.name == "regions" then tasks.map fun (name, statement, proof) =>
        theoremText name statement proof else []
    helpers ++ (proofs.lookup ob.id.name).toList.map (Skel.Driver.answerText ob)

/-- The text of the module of a function: the header `h` of its L2 check files, its L2 generation `g`, the proofs of its
closed rows. -/
def moduleTextSemantic (h : Header) (g : Generated) (proofs : List (String × String)) (interface : String)
    (semantic : Option Generated) (tasks : List (String × String × String) := []) : String :=
  let opens := if h.opens.isEmpty then [] else [s!"open {" ".intercalate h.opens}"]
  let summaries := semantic.toList.map fun u =>
    let body := "\n".intercalate (u.modelText :: semanticTheorems u proofs tasks)
    let names := Source.declarationNames body
    let body := Source.relocateQualifiedHelpers body h.namespace_ "skel_semantic" names
    "\n".intercalate ["namespace skel_semantic", body, "end skel_semantic"]
  let body := [g.modelText, interface] ++ closedTheorems g proofs ++ summaries
  let imports := proofScopeImports h.imports ("\n".intercalate body)
  "\n".intercalate (["-- Generated by skel full (Skel/Full/Module.lean). Do not edit by hand."] ++ imports.map (s!"import {·}") ++
    [s!"namespace {h.namespace_}"] ++ opens ++ body ++
    [s!"end {h.namespace_}"]) ++ "\n"

/-- The code-only module renderer. -/
def moduleText (h : Header) (g : Generated) (proofs : List (String × String)) (interface : String := "") : String :=
  moduleTextSemantic h g proofs interface none

end Skel.Full

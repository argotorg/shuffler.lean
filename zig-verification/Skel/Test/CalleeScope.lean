import Skel.RowExec
import Skel.Test.GenMultiCallee

/-! Callee row types must keep their model scope when RowExec makes dependency binders. -/

namespace CalleeScopeTests

open Skel Skel.Gen

def generated (bytes : Bool) (modules : Bool := false) : Except GenError Generated := do
  let (cs, us) ← GenMultiCalleeTests.twoUnits
  let sh ← GenUpperCallTests.toyShape 16
  let sh := if bytes then { sh with call := .callB } else sh
  let g := (← generateUpper (GenMultiCalleeTests.target "two" cs) .storeChain GenMultiCalleeTests.code .table
    "Skel.Test.CallMem.Code.code" "two" sh GenUpperCallTests.hint ⟨[], [], "Two", []⟩ none us
    (if modules then GenMultiCalleeTests.mods else [])).generated
  pure { g with modelText := GenUpperBothTests.specText GenUpperBothTests.wide ++
    GenUpperResultTests.specText ++ "\n" ++ g.modelText }

def header : Header :=
  { imports := GenUpperCallTests.toyImports ++ ["Lift.Sem.CallArmBytes"], namespace_ := "CalleeScope",
    opens := ["Lift.P2.Total", "Lift.Sem", "Skel.Test.CallMem", "Lift.Spike", "Lift.Sem.Bridge"] }

def file (bytes : Bool) (name : String) (wrongCallee : Bool := false) (modules : Bool := false) : Except GenError LeanFile := do
  let g ← generated bytes modules
  let g := if wrongCallee then
      { g with obligations := g.obligations.map fun o =>
          if o.id.name == "Put.refines_l2p" then { o with statement := "Inc.skel_row_types.refines_l2p" } else o }
    else g
  let some row := g.obligations.find? (·.id.name == name) | throw (.shape 0 s!"no row {name}")
  let some (_, proof) := g.det.find? (·.1 == row.id) | throw (.shape 0 s!"no proof {name}")
  let f := Skel.RowExec.checkFile header g (Ledger.init g.obligations) row proof 120000
  if !modules then return f
  -- Production imports callee modules at the root, before the caller's namespace.
  let moduleText := (← GenMultiCalleeTests.moduleOf "put" "TwoMod.Put") ++
    (← GenMultiCalleeTests.moduleOf "inc" "TwoMod.Inc")
  let moduleText := s!"open {" ".intercalate header.opens}\n\n" ++ moduleText
  let text := f.text.replace s!"namespace {header.namespace_}\n"
    (moduleText ++ s!"\nnamespace {header.namespace_}\n")
  pure { f with text := withProofScopeImport text }

/-- A pending callee block and a closed sibling block have the same short name. -/
def sharedEntryFile (bytes wrong : Bool) : Except GenError LeanFile := do
  let g ← generated bytes
  let some row := g.obligations.find? (·.id.name == "Put.decompiles_l2") | throw (.shape 0 "no Put row")
  let some other := g.obligations.find? (·.id.name == "Inc.entry") | throw (.shape 0 "no Inc entry")
  let some (_, proof) := g.det.find? (·.1 == row.id) | throw (.shape 0 "no Put proof")
  let proof := if wrong then proof.replace "Put.entry" "Inc.entry" else proof
  let row := { row with deps := row.deps ++ [other.id] }
  let l := Ledger.init g.obligations
  let c : Closure :=
    { rung := .liftBlock, triple := none, proof := "by intros; first | lift_block_split | lift_block",
      axioms := [], ms := 0 }
  let l : Ledger := ⟨l.records.map fun r =>
    if r.ob.id == other.id then { r with status := .closed c }
    else r⟩
  pure (Skel.RowExec.checkFile header g l row proof 120000)

def check (f : LeanFile) : IO Outcome := do
  let dir ← Skel.tempDir "callee-scope"
  IO.FS.writeFile (dir / "check.lean") f.text
  pure (← Skel.Io.checkFile .bvDecide (dir / "check.lean") f.name f.limitMs).1

def leanChecks : IO (List (String × Bool × String)) := do
  let mut checks := []
  for bytes in [false, true] do
    for name in ["refines_l2p", "decompiles_l2", "Put.decompiles_l2", "Inc.decompiles_l2"] do
      let label := s!"callee dependency binders keep their model scope ({bytes}, {name})"
      match file bytes name with
      | .error e => checks := checks ++ [(label, false, reprStr e)]
      | .ok f =>
        let out ← check f
        checks := checks ++ [(label, GenMultiCalleeTests.accepted out, reprStr out)]
    let label := s!"a heap callee cannot use the scalar callee's row ({bytes})"
    match file bytes "refines_l2p" true with
    | .error e => checks := checks ++ [(label, false, reprStr e)]
    | .ok f =>
      let out ← check f
      let rejected := match out with
        | .failed errors => errors.any fun e => GenMultiCalleeTests.has e.toLower "type mismatch"
        | _ => false
      checks := checks ++ [(label, rejected, reprStr out)]
    let label := s!"module callee dependency binders keep their model scope ({bytes})"
    match file bytes "refines_l2p" false true with
    | .error e => checks := checks ++ [(label, false, reprStr e)]
    | .ok f =>
      let out ← check f
      checks := checks ++ [(label, GenMultiCalleeTests.accepted out, reprStr out)]
    for wrong in [false, true] do
      let label := s!"callee entry names keep separate scopes ({bytes}, wrong={wrong})"
      match sharedEntryFile bytes wrong with
      | .error e => checks := checks ++ [(label, false, reprStr e)]
      | .ok f =>
        let out ← check f
        let ok := if wrong then
            match out with
            | .failed errors => errors.any fun e => GenMultiCalleeTests.has e.toLower "type mismatch"
            | _ => false
          else GenMultiCalleeTests.accepted out
        checks := checks ++ [(label, ok, reprStr out)]
  pure checks

def run (_seed _cases : Nat) (only : Option String) : IO Nat := do
  if only.isSome && only != some "calleescope" then return 0
  let mut n := 0
  for (name, ok, msg) in ← leanChecks do
    unless ok do
      n := n + 1
      IO.println s!"FAIL  calleescope: {name}\n{msg}"
  return n

end CalleeScopeTests

        rw [hsim.hmem]
        exact hsim.sin.2.2.2.2.2.2.1
      simp only [blocksP, Res.ok.injEq] at hstep
      subst hstep
      refine ⟨⟨y.input.policy, m1, y.r15, y.rdi⟩,

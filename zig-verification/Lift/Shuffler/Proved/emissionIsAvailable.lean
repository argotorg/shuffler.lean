  have h : (x.replaceLow b).setWidth 8 = b := by
    simp [BitVec.replaceLow]
    bv_decide
  have h2 := congrArg BitVec.toNat h
  simpa [BitVec.toNat_setWidth, Nat.reducePow] using h2

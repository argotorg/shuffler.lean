  have hheap' : a.heap = hh := by rw [hhh]; exact hheap
  have hae : a = { a with heap := hh } := by cases a; simp_all
  rw [hae]
  have hHex : (objsP self target spills data st offset ++ frame).Holds pol m := by rw [← hheap]; exact hH

        refine ⟨?_, ?_, ?_⟩
        · rw [e]; exact hpw
        · rw [e]; exact hpr
        · rw [e, writeRam_ok_eq hw1]
          rw [show y.input.sp - 24 - 8 = y.input.sp - BitVec.ofNat 64 32 from by bv_omega]
          exact SysV.mapped_storeInt_of_disjoint
            (a := y.input.sp - BitVec.ofNat 64 32) (b := y.input.sp - BitVec.ofNat 64 40)
            (fun i hi j hj e => by bv_omega) hm
      simp only [blocksP, Res.ok.injEq] at hstep
      subst hstep
      refine ⟨⟨y.input.policy, m1, y.input.sp - 24 - 8, y.r15, y.r14⟩,
        fun r => (.o64, { y with rdi := y.r14, rsi := y.r15, mem := r.2, rax := r.1 }), ?_, ?_, ?_⟩
      · simp only [blocks, hw1]
      · exact ⟨hsim.hr15, hsim.hr14, hh1, hperm, hpriv, hbel, hroom8, by rw [hsp]⟩
      · rintro r r' hr1
        obtain ⟨hrv, hrf⟩ := hr1
        refine ⟨?_, ?_⟩
        · rw [hrv]
        · refine ⟨hsim.sin, hrv, hsim.hrbx, hsim.hr15, hsim.hr14, hsim.hr14, hsim.hr15, ?_, ?_,
            hsim.hcv, ?_, hsim.hmem, hsim.hin⟩
          · exact holds_congr hh1 fun b hc =>
              hrf b fun hb => hsim.hcv b (by unfold SysV.Below at hb ⊢; bv_omega) hc
          · intro c hc
            exact (hrf c fun hb => hc (by unfold SysV.Below at hb ⊢; bv_omega)).trans (hf1 c hc)

    | o53 =>
      change SimR 40 b x y at hsim
      obtain ⟨m1, hw1, hroom1, hd1, hout1⟩ := hsim.hroom.push (a := y.input.sp - 24 - 8) (k := 32)
        (by decide) (by decide) (by decide) (by decide) (by bv_omega)
        ((Lift.Shuffler.emissionIsAvailablePC + 64)).toBitVec
      have hh1 := Heap.Holds.push hsim.hh hsim.hcv hout1
      have hf1 : ∀ c, ¬ SysV.Below y.input.sp 40 c → m1.get? c = y.input.mem.get? c := by

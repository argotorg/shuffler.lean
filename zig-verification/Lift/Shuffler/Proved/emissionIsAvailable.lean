theorem decompiles_l2 : Decompiles Lift.Shuffler.L1.step l2 := by
  refine Decompiles.ofBlocks blocks Cal.model (fun | .c0 => emissionIsSpilled.decompiles_l2 | .c1 => emissionShallowestCopyPosition.decompiles_l2.restrict _) .entry init decompiles_l2_inv
    (fun _ _ h => h) (fun _ _ _ h => ⟨h, rfl, rfl, fun _ => rfl, fun ra hra => by simp only [init]; rw [h.2.1]; exact Sites.readRet h.2.2.1 hra, by simp only [init]; rw [h.2.1]; exact SysV.MappedMemory.refl _⟩) ?_
  intro policy a s₀ l x s h n hn
  cases l with
  | entry => have H := decompiles_l2_entry entry policy a s₀ x s h n hn; cases n <;> exact H
  | o25 => have H := decompiles_l2_o25 o25 policy a s₀ x s h n hn; cases n <;> exact H
  | o38 => have H := decompiles_l2_o38 o38 policy a s₀ x s h n hn; cases n <;> exact H
  | o49 => have H := decompiles_l2_o49 o49 policy a s₀ x s h n hn; cases n <;> exact H
  | o53 => have H := decompiles_l2_o53 o53 policy a s₀ x s h n hn; cases n <;> exact H
  | o64 => have H := decompiles_l2_o64 o64 policy a s₀ x s h n hn; cases n <;> exact H
  | LBB8_4 => have H := decompiles_l2_LBB8_4 LBB8_4 policy a s₀ x s h n hn; cases n <;> exact H
end decompiles_l2.skel_proof
theorem decompiles_l2 : decompiles_l2.skel_statement := @decompiles_l2.skel_proof.decompiles_l2
def refines_l2p.skel_statement : Prop := Refines SimIn (fun a b r r' => SimOut a b r r') l2p.returns l2.returns
namespace refines_l2p.skel_proof
skel_proof_aliases refines_l2p.skel_proof excluding [SimR, calleeSimX, calleeSimY, roomAt_mono, readRam_roomAt, SimR.weaken, refines_l2p]
structure SimR (n : Nat) (b : In2) (x : St In2p Heap) (y : St In2 DataMem) : Prop where
  sin : SimIn x.input y.input
  hrax : x.rax = y.rax
  hrbx : x.rbx = y.rbx
  hrsi : x.rsi = y.rsi
  hrdi : x.rdi = y.rdi
  hr14 : x.r14 = y.r14
  hr15 : x.r15 = y.r15
  hh : x.mem.Holds y.input.policy y.mem
  hf : ∀ c, ¬ SysV.Below y.input.sp 40 c → y.mem.get? c = y.input.mem.get? c
  hcv : ∀ c, SysV.Below y.input.sp 40 c → ¬ Covered x.mem c
  hroom : SysV.RoomAt y.input.policy y.mem y.input.sp n
  hmem : x.mem = x.input.heap
  hin : y.input = b

def calleeSimX : (c : Cal) → CalP.In c → Cal.In c → Prop
  | .c0 => emissionIsSpilled.SimIn
  | .c1 => emissionShallowestCopyPosition.SimIn

def calleeSimY : (c : Cal) → CalP.In c → Cal.In c → CalP.Out c → Cal.Out c → Prop
  | .c0 => fun _ _ y y' => y = y'
  | .c1 => fun x xl y y' => emissionShallowestCopyPosition.SimOut x xl y y'

theorem roomAt_mono {policy : CpuPolicy} {m : DataMem} {sp : BitVec 64} {n n' : Nat}
    (h : SysV.RoomAt policy m sp n) (hn : n' ≤ n) : SysV.RoomAt policy m sp n' :=
  fun k hk8 hkn hd => h k hk8 (Nat.le_trans hkn hn) hd

theorem readRam_roomAt {policy : CpuPolicy} {m : DataMem} {sp : BitVec 64} {n k : Nat}
    (h : SysV.RoomAt policy m sp n) (hk8 : 8 ≤ k) (hkn : k ≤ n) (hd : 8 ∣ k) :
    ∃ v, readRam policy m (sp - BitVec.ofNat 64 k) .W64 = .ok v := by
  obtain ⟨-, hp, hm⟩ := h k hk8 hkn hd
  obtain ⟨x, hx⟩ := Option.ne_none_iff_exists'.mp hm
  exact ⟨BitVec.ofInt Width.W64.bits x,
    by simp only [Lift.P2.Total.readRam, hp, hx, ↓reduceIte]⟩

def SimR.weaken {n n' : Nat} {b : In2} {x : St In2p Heap} {y : St In2 DataMem} (h : n' ≤ n)
    (r : SimR n b x y) : SimR n' b x y :=
  ⟨r.sin, r.hrax, r.hrbx, r.hrsi, r.hrdi, r.hr14, r.hr15, r.hh, r.hf, r.hcv,
    roomAt_mono r.hroom h, r.hmem, r.hin⟩
theorem refines_l2p : Refines SimIn (fun a b r r' => SimOut a b r r') l2p.returns l2.returns := by
  intro a b r hs h
  have hcal : ∀ c, Refines (calleeSimX c) (calleeSimY c) (CalP.rel c) ((Cal.model c).returns) := by
    intro c
    cases c with
    | c0 => exact emissionIsSpilled.refines_l2p
    | c1 =>
      intro x xl y hx hr
      obtain ⟨yl, hlo, hy⟩ := emissionShallowestCopyPosition.refines_l2p x xl y hx hr
      exact ⟨yl, ⟨hlo, fun i hi => hy.2 _ (by unfold SysV.Below; bv_omega)⟩, hy⟩
  refine Blocks.Returns.simAt calleeSimX calleeSimY
    (fun l => match l with | .o64 => SimR 32 b | .LBB8_4 => SimR 32 b | _ => SimR 40 b)
    (fun r r' => SimOut a b r r') hcal ?_ h ?_
  · rintro l x y n hsim hstep
    cases l with
    | entry =>
      change SimR 40 b x y at hsim
      have hperm : Heap.Permits y.input.policy x.mem := by
        rw [hsim.hmem]
        exact hsim.sin.2.2.2.2.2.2.1
      obtain ⟨m1, hw1, hroom1, hd1, hout1⟩ := hsim.hroom.push (a := y.input.sp - 8) (k := 8)
        (by decide) (by decide) (by decide) (by decide) (by bv_omega) y.r15.toBitVec
      obtain ⟨m2, hw2, hroom2, hd2, hout2⟩ := hroom1.push (a := y.input.sp - 16) (k := 16)
        (by decide) (by decide) (by decide) (by decide) (by bv_omega) y.r14.toBitVec
      obtain ⟨m3, hw3, hroom3, hd3, hout3⟩ := hroom2.push (a := y.input.sp - 24) (k := 24)
        (by decide) (by decide) (by decide) (by decide) (by bv_omega) y.rbx.toBitVec
      have hh1 := Heap.Holds.push hsim.hh hsim.hcv hout1
      have hh2 := Heap.Holds.push hh1 hsim.hcv hout2
      have hh3 := Heap.Holds.push hh2 hsim.hcv hout3
      have hf1 : ∀ c, ¬ SysV.Below y.input.sp 40 c → m1.get? c = y.input.mem.get? c := by
        intro c hc
        exact (hout1 c hc).trans (hsim.hf c hc)
      have hf2 : ∀ c, ¬ SysV.Below y.input.sp 40 c → m2.get? c = y.input.mem.get? c := by
        intro c hc
        exact (hout2 c hc).trans (hf1 c hc)
      have hf3 : ∀ c, ¬ SysV.Below y.input.sp 40 c → m3.get? c = y.input.mem.get? c := by
        intro c hc
        exact (hout3 c hc).trans (hf2 c hc)
      simp only [blocksP] at hstep
      cases hl : x.mem.loadB x.rdi.toBitVec .W64 with
      | ok v =>
        simp only [hl] at hstep
        cases hl2 : x.mem.loadB (v + x.rsi.toBitVec * 8) .W64 with
        | ok v1 =>
          simp only [hl2] at hstep
          have hr1 : readRam y.input.policy m3 y.rdi.toBitVec .W64 = .ok v := by
            rw [← hsim.hrdi]
            exact Heap.loadB_sound hh3 hperm hl
          have hr2 : readRam y.input.policy m3 (v + y.rsi.toBitVec * 8) .W64 = .ok v1 := by
            rw [← hsim.hrsi]
            exact Heap.loadB_sound hh3 hperm hl2
          by_cases hc : (UInt64.ofBitVec v1 >>> (40 : UInt64)).toUInt8.toUInt64 = 0
          · simp only [if_pos hc, Res.ok.injEq] at hstep
            subst hstep
            refine ⟨{ y with mem := m3, r15 := UInt64.ofBitVec v1, rbx := (y.rbx &&& 18446744073709551360) ||| (1 &&& 255), rax := UInt64.ofBitVec v1 >>> (40 : UInt64) }, ?_, ?_⟩
            · simp only [blocks, hw1, hw2, hw3, hr1, hr2]
              rw [if_pos hc]
            · refine ⟨hsim.sin, rfl, ?_, hsim.hrsi, hsim.hrdi, hsim.hr14, rfl, hh3, hf3, hsim.hcv,
                roomAt_mono hroom3 (by decide), hsim.hmem, hsim.hin⟩
              rw [hsim.hrbx]
          · simp only [if_neg hc, Res.ok.injEq] at hstep
            subst hstep
            refine ⟨{ y with mem := m3, r15 := UInt64.ofBitVec v1, rbx := (y.rbx &&& 18446744073709551360) ||| (1 &&& 255), rax := UInt64.ofBitVec v1 >>> (40 : UInt64) }, ?_, ?_⟩
            · simp only [blocks, hw1, hw2, hw3, hr1, hr2]
              rw [if_neg hc]
            · refine ⟨hsim.sin, rfl, ?_, hsim.hrsi, hsim.hrdi, hsim.hr14, rfl, hh3, hf3, hsim.hcv,
                hroom3, hsim.hmem, hsim.hin⟩
              rw [hsim.hrbx]
        | stuck why =>
          simp only [hl2] at hstep
          cases hstep
        | noFuel =>
          simp only [hl2] at hstep
          cases hstep
      | stuck why =>
        simp only [hl] at hstep
        cases hstep
      | noFuel =>
        simp only [hl] at hstep
        cases hstep
    | o25 =>
      change SimR 40 b x y at hsim
      simp only [blocksP] at hstep
      by_cases hc : 2 ≤ ((x.r15 >>> (32 : UInt64)).toUInt8.toUInt64 - 1).toUInt8.toUInt64
      · simp only [if_pos hc, Res.ok.injEq] at hstep
        subst hstep
        have hcy : 2 ≤ ((y.r15 >>> (32 : UInt64)).toUInt8.toUInt64 - 1).toUInt8.toUInt64 := by
          rw [← hsim.hr15]; exact hc
        refine ⟨{ y with rax := (y.r15 >>> (32 : UInt64) &&& 18446744073709551360) ||| (((y.r15 >>> (32 : UInt64)).toUInt8.toUInt64 - 1).toUInt8.toUInt64 &&& 255) }, ?_, ?_⟩
        · simp only [blocks]
          rw [if_pos hcy]
        · refine ⟨hsim.sin, ?_, hsim.hrbx, hsim.hrsi, hsim.hrdi, hsim.hr14, hsim.hr15, hsim.hh,
            hsim.hf, hsim.hcv, hsim.hroom, hsim.hmem, hsim.hin⟩
          simp only [hsim.hr15]
      · simp only [if_neg hc, Res.ok.injEq] at hstep
        subst hstep
        have hcy : ¬ 2 ≤ ((y.r15 >>> (32 : UInt64)).toUInt8.toUInt64 - 1).toUInt8.toUInt64 := by
          rw [← hsim.hr15]; exact hc
        have hw := SimR.weaken (b := b) (by decide : (32 : Nat) ≤ 40) hsim
        refine ⟨{ y with rax := (y.r15 >>> (32 : UInt64) &&& 18446744073709551360) ||| (((y.r15 >>> (32 : UInt64)).toUInt8.toUInt64 - 1).toUInt8.toUInt64 &&& 255) }, ?_, ?_⟩
        · simp only [blocks]
          rw [if_neg hcy]
        · refine ⟨hw.sin, ?_, hw.hrbx, hw.hrsi, hw.hrdi, hw.hr14, hw.hr15, hw.hh,
            hw.hf, hw.hcv, hw.hroom, hw.hmem, hw.hin⟩
          simp only [hsim.hr15]
    | o49 =>
      change SimR 40 b x y at hsim
      simp only [blocksP] at hstep
      by_cases hc : 1 &&& (x.rax).toUInt8.toUInt64 = 0
      · simp only [if_pos hc, Res.ok.injEq] at hstep
        subst hstep
        have hcy : 1 &&& (y.rax).toUInt8.toUInt64 = 0 := by rw [← hsim.hrax]; exact hc
        refine ⟨y, ?_, hsim⟩
        simp only [blocks]
        rw [if_pos hcy]
      · simp only [if_neg hc, Res.ok.injEq] at hstep
        subst hstep
        have hcy : ¬ 1 &&& (y.rax).toUInt8.toUInt64 = 0 := by rw [← hsim.hrax]; exact hc
        refine ⟨y, ?_, SimR.weaken (b := b) (by decide : (32 : Nat) ≤ 40) hsim⟩
        simp only [blocks]
        rw [if_neg hcy]
    | o38 =>
      change SimR 40 b x y at hsim
      obtain ⟨m1, hw1, hroom1, hd1, hout1⟩ := hsim.hroom.push (a := y.input.sp - 24 - 8) (k := 32)
        (by decide) (by decide) (by decide) (by decide) (by bv_omega)
        ((Lift.Shuffler.emissionIsAvailablePC + 49)).toBitVec

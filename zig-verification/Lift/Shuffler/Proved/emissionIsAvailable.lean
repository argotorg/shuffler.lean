    have h' : ((n : Int) % 256) = ((n % 256 : Nat) : Int) := h.symm
    rw [h', h3]
  have h2 : ((254 + n : Int) % 256) = (((254 + m) % 256 : Nat) : Int) := by
    have h := Int.natCast_emod (254 + n) 256
    have h' : ((254 + n : Int) % 256) = (((254 + n) % 256 : Nat) : Int) := h.symm
    rw [h', show (254 + n) % 256 = (254 + m) % 256 by rw [Nat.add_mod, h3, Nat.add_mod]]
  rw [h1, h2]

theorem load_self (self target spills data : BitVec 64) (frame : Heap) (st : Zig.St)
    (offset : FlatShuffler.Word) (pol : CpuPolicy) (m : DataMem)
    (hH : (objsP self target spills data st offset ++ frame).Holds pol m) :
    (objsP self target spills data st offset ++ frame).load self .W64 = .ok target := by
  have ho : toObj (Lift.Shuffler.Internal.Proposed.Layout.targetPtr
      (Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf self target spills data)) ∈
      objsP self target spills data st offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.IsAvailableStatement.objects]
  have hc : (0, ⟨.W64, target⟩) ∈ offsets 0 (toObj (Lift.Shuffler.Internal.Proposed.Layout.targetPtr
      (Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf self target spills data))).cells := by
    simp [toObj, toCell, Lift.Shuffler.Internal.Proposed.Layout.targetPtr,
      Lift.Shuffler.Internal.Proposed.Layout.word, offsets.eq_def,
      Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf]
  have h := Heap.load_cell hH ho hc
  simp only [toObj, Lift.Shuffler.Internal.Proposed.Layout.targetPtr,
    Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf, BitVec.add_zero] at h
  exact h


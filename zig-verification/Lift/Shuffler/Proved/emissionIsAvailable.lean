      have hperm : Heap.Permits y.input.policy x.mem := by
        rw [hsim.hmem]
        exact hsim.sin.2.2.2.2.2.2.1
      have hpriv : ∀ c, (c - ((y.input.sp - 24 - 8) - BitVec.ofNat 64 8)).toNat < 16 → ¬ Covered x.mem c := by
        intro c hc
        have hc' : (c - (y.input.sp - BitVec.ofNat 64 40)).toNat < 16 := by
          rw [show (y.input.sp - 24 - 8) - BitVec.ofNat 64 8
              = y.input.sp - BitVec.ofNat 64 40 from by bv_omega] at hc

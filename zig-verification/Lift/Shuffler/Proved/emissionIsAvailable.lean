theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : UInt64) (q : UInt64) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  have hcallee : ∀ f, Refines (fun x y => x = y) (fun _ _ u v => u = v) (CalP.rel f) (skel_call.CalP.rel f) := by
    intro f x y v h hc
    cases h
    exact ⟨v, hc, rfl⟩
  have hblock : ∀ (l : Lbl) (x : St In2p Heap) (y : St skel_call.In2p Heap)
      (n : Next Lbl (St In2p Heap) UInt64 Cal CalP.In CalP.Out),
      callState x y → blocksP.step l x = .ok n →
      Next.Sim (fun (f : Cal) (x : CalP.In f) (y : skel_call.CalP.In f) => x = y)
        (fun (f : Cal) (_ : CalP.In f) (_ : skel_call.CalP.In f) (u : CalP.Out f) (v : skel_call.CalP.Out f) => u = v)
        callState (fun (r q : UInt64) => r = q) n (skel_call.blocksP.step l y) := by
    intro l x z n hs ht
    rcases hs with ⟨hinput, h_rax, h_rbx, h_rsi, h_rdi, h_r14, h_r15, h_mem, htrue⟩
    cases l <;> simp only [blocksP, callInput, hinput, h_rax, h_rbx, h_rsi, h_rdi, h_r14, h_r15, h_mem] at ht
    all_goals repeat' split at ht
    all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
    all_goals subst n
    all_goals simp_all [-UInt64.not_le, skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
    · exact ⟨_, _, rfl, rfl, by intro y y' hyy'; simp [callState, callInput, hyy'] <;> rfl⟩
    · exact ⟨_, _, rfl, rfl, by intro y y' hyy'; simp [callState, callInput, hyy'] <;> rfl⟩
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    callState (fun (r q : UInt64) => r = q) hcallee hblock hr
    (by simp [callState, initP, skel_call.initP, callInput])

            refine ⟨hpw, hpr, ?_⟩
            rw [show Mem.loadInt r'.2 (y.input.sp - BitVec.ofNat 64 k) 8
                = Mem.loadInt m1 (y.input.sp - BitVec.ofNat 64 k) 8 from
              Mem.loadInt_congr fun i hi => hrf _ (by unfold SysV.Below; bv_omega)]

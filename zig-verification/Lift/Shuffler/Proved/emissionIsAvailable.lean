theorem load_target (self target spills data : BitVec 64) (frame : Heap) (st : Zig.St)
    (offset : FlatShuffler.Word) (pol : CpuPolicy) (m : DataMem)
    (hH : (objsP self target spills data st offset ++ frame).Holds pol m)
    (hC : offset.toNat < 1024) :
    (objsP self target spills data st offset ++ frame).load (target + offset * 8) .W64
      = .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord
          (st.target.toList.getD offset.toNat default) (st.targetPad.toList.getD offset.toNat 0)) := by
  have ho : toObj (Lift.Shuffler.Internal.Proposed.Layout.target
      (Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf self target spills data) st) ∈
      objsP self target spills data st offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.IsAvailableStatement.objects]
  have hx := Lift.Sem.Bridge.mem_offsets_words64
    ((List.range 1024).map fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord
      (st.target.toList.getD i default) (st.targetPad.toList.getD i 0)) 0 offset.toNat
    (by simp [hC])
  have hc : (8 * offset.toNat, ⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord
      (st.target.toList.getD offset.toNat default) (st.targetPad.toList.getD offset.toNat 0)⟩) ∈
      offsets 0 (toObj (Lift.Shuffler.Internal.Proposed.Layout.target
        (Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf self target spills data) st)).cells := by
    rw [Lift.Sem.Bridge.mem_offsets_toObj]
    refine ⟨_, hx, ?_⟩
    simp [Lift.Shuffler.Internal.Proposed.Layout.target, toObj, toCell, List.map_map,
      Lift.Shuffler.Internal.Proposed.Layout.word]
  have h := Heap.load_cell hH ho hc
  simp only [toObj, Lift.Shuffler.Internal.Proposed.Layout.target,
    Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf, BitVec.add_zero] at h
  have haddr : offset * 8 = BitVec.ofNat 64 (8 * offset.toNat) := by
    apply BitVec.eq_of_toNat_eq
    simp [BitVec.toNat_mul, BitVec.toNat_ofNat, Nat.mul_comm]
  rw [haddr]
  exact h

theorem load_data (self target spills data : BitVec 64) (frame : Heap) (st : Zig.St)
    (offset : FlatShuffler.Word) (pol : CpuPolicy) (m : DataMem)
    (hH : (objsP self target spills data st offset ++ frame).Holds pol m)
    (i : Nat) (hi : i < 1024) :
    (objsP self target spills data st offset ++ frame).load (data + BitVec.ofNat 64 (8 * i)) .W64
      = .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord
          (st.data.toList.getD i default) (st.pad.toList.getD i 0)) := by
  have ho : toObj (Lift.Shuffler.Internal.Proposed.Layout.data
      (Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf self target spills data) st false) ∈
      objsP self target spills data st offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.IsAvailableStatement.objects]
  have hx := Lift.Sem.Bridge.mem_offsets_words64
    ((List.range 1024).map fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord
      (st.data.toList.getD i default) (st.pad.toList.getD i 0)) 0 i (by simp [hi])
  have hc : (8 * i, ⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord
      (st.data.toList.getD i default) (st.pad.toList.getD i 0)⟩) ∈
      offsets 0 (toObj (Lift.Shuffler.Internal.Proposed.Layout.data
        (Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf self target spills data) st false)).cells := by
    rw [Lift.Sem.Bridge.mem_offsets_toObj]
    refine ⟨_, hx, ?_⟩
    simp [Lift.Shuffler.Internal.Proposed.Layout.data, toObj, toCell, List.map_map,
      Lift.Shuffler.Internal.Proposed.Layout.word]
  have h := Heap.load_cell hH ho hc
  simp only [toObj, Lift.Shuffler.Internal.Proposed.Layout.data,
    Lift.Shuffler.Internal.Proposed.IsAvailableStatement.envOf, BitVec.add_zero] at h
  exact h

theorem slotWord_truncate32 (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad).truncate 32 = s.payload := by
  obtain ⟨pl, k, op⟩ := s
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word]
  bv_decide

theorem slotWord_ushr32 (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    ((Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (32 : Nat)).truncate 8 = s.kind := by
  obtain ⟨pl, k, op⟩ := s
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word]
  bv_decide

theorem slotWord_ushr40 (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    ((Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (40 : Nat)).truncate 8 = s.valueOpcode := by
  obtain ⟨pl, k, op⟩ := s
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word]
  bv_decide

theorem slotWord_low48_eq (a b : FlatShuffler.StackSlot) (p q : BitVec 16) :
    (Lift.Shuffler.Internal.Proposed.Layout.slotWord a p &&& 281474976710655 =
      Lift.Shuffler.Internal.Proposed.Layout.slotWord b q &&& 281474976710655) ↔ a = b := by
  obtain ⟨pl, k, op⟩ := a
  obtain ⟨pl', k', op'⟩ := b
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word, FlatShuffler.StackSlot.mk.injEq]
  constructor
  · intro h; bv_decide
  · intro h; obtain ⟨rfl, rfl, rfl⟩ := h; bv_decide

theorem lowByte_or (rbx : UInt64) (b : Bool) :
    ((((rbx &&& 18446744073709551360) ||| ((if b then (1:UInt64) else 0) &&& 255)).toUInt32.toUInt64).toBitVec).setWidth 8
      = (if b then (1 : BitVec 8) else 0) := by
  cases b <;>
    simp only [UInt64.toBitVec_and, UInt64.toBitVec_or, UInt64.toBitVec_toUInt32,
      UInt32.toBitVec_toUInt64, Bool.false_eq_true, if_true, if_false, reduceIte] <;>
    bv_decide

theorem toUInt8_toUInt64_toBitVec (x : UInt64) :
    (x.toUInt8.toUInt64).toBitVec = (x.toBitVec.setWidth 8).setWidth 64 := by
  apply BitVec.eq_of_toNat_eq
  show (x.toUInt8.toUInt64).toNat = ((x.toBitVec.setWidth 8).setWidth 64).toNat
  simp only [UInt8.toNat_toUInt64, UInt64.toNat_toUInt8, BitVec.toNat_setWidth]
  rw [Nat.mod_eq_of_lt (Nat.lt_of_lt_of_le (Nat.mod_lt _ (by decide)) (by decide))]
  rfl

theorem setWidth8_eq_zero_of {x : BitVec 64} (h : (x.setWidth 8).setWidth 64 = 0) : x.setWidth 8 = 0 := by
  have h1 : (x.setWidth 8).toNat = 0 := by
    have h2 := congrArg BitVec.toNat h
    simp only [BitVec.toNat_setWidth] at h2
    rw [Nat.mod_eq_of_lt (Nat.lt_of_lt_of_le (Nat.mod_lt _ (by decide)) (by decide))] at h2
    simpa using h2
  exact BitVec.eq_of_toNat_eq (by simpa using h1)

theorem flat_get_eq_getD {α : Type} [Inhabited α] (v : Vector α 1024) (i : BitVec 64)
    (hi : i.toNat < FlatShuffler.maxStackSize) :
    FlatShuffler.Flat.get v i = v.toList.getD i.toNat default := by
  have hi' : i.toNat < 1024 := hi
  simp only [FlatShuffler.Flat.get, dif_pos hi, List.getD]
  rw [List.getElem?_eq_getElem (by simpa using hi')]
  rfl

theorem and_if_one_zero (P Q : Prop) [Decidable P] [Decidable Q] :
    (((if P then (1:UInt64) else 0) &&& (if Q then 1 else 0)) = 0) ↔ ¬ (P ∧ Q) := by
  by_cases hp : P <;> by_cases hq : Q <;> simp [hp, hq]

theorem toUInt8_toUInt64_eq_zero (x : UInt64) :
    (x.toUInt8.toUInt64 = 0) ↔ (x.toBitVec.setWidth 8 = 0) := by
  constructor
  · intro h
    have h2 := congrArg UInt64.toBitVec h
    rw [toUInt8_toUInt64_toBitVec] at h2
    simp only [UInt64.toBitVec_zero] at h2
    exact setWidth8_eq_zero_of h2
  · intro h
    apply UInt64.toBitVec_inj.mp
    rw [toUInt8_toUInt64_toBitVec, h, UInt64.toBitVec_zero]
    rfl

theorem ushr40_zero_iff (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    ((UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (40 : UInt64)).toUInt8.toUInt64 = 0)
      ↔ s.valueOpcode = 0 := by
  rw [toUInt8_toUInt64_eq_zero]
  have h1 : (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (40 : UInt64)).toBitVec
      = Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad >>> (40 : Nat) := by simp
  rw [h1, ← BitVec.truncate_eq_setWidth, slotWord_ushr40]

theorem ushr32_zero_iff (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    ((UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (32 : UInt64)).toUInt8.toUInt64 = 0)
      ↔ s.kind = 0 := by
  rw [toUInt8_toUInt64_eq_zero]
  have h1 : (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (32 : UInt64)).toBitVec
      = Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad >>> (32 : Nat) := by simp
  rw [h1, ← BitVec.truncate_eq_setWidth, slotWord_ushr32]

theorem entry_cond (s : FlatShuffler.StackSlot) (pad : BitVec 16)
    (h40 : (((UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (40 : UInt64)).toUInt8.toUInt64 = 0) ↔ s.valueOpcode = 0))
    (h32 : (((UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (32 : UInt64)).toUInt8.toUInt64 = 0) ↔ s.kind = 0)) :
    ((if ¬ ((UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0)
      &&& (if ((UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (32 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) : UInt64) = 0
    ↔ ¬ FlatShuffler.Flat.isVariable s := by
  rw [and_if_one_zero]
  simp only [h40, h32]
  by_cases hk : s.kind = 0 <;> by_cases ho : s.valueOpcode = 0 <;>
    simp [FlatShuffler.Flat.isVariable, FlatShuffler.isLiteralValue, FlatShuffler.Value, FlatShuffler.Const, hk, ho]
  grind

theorem isSpilled_word (a : BitVec 64) (b : BitVec 8) :
    (UInt64.ofBitVec a &&& 18446744073709551360) ||| ((if ¬ (UInt64.ofBitVec (BitVec.zeroExtend 64 b) = 0) then 1 else 0) &&& 255)
    = UInt64.ofBitVec ((a &&& 18446744073709551360) ||| (if b ≠ 0 then (1 : BitVec 64) else 0)) := by
  apply UInt64.toBitVec_inj.mp
  simp only [UInt64.toBitVec_or, UInt64.toBitVec_and, UInt64.toBitVec_ofNat]
  bv_decide

theorem spill_addr (spills : BitVec 64) (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    spills + BitVec.zeroExtend 64 (BitVec.truncate 32 (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad)) * 1
      = spills + s.payload.setWidth 64 := by
  rw [slotWord_truncate32]
  bv_decide

theorem isSpilled_returns (self target spills data : BitVec 64) (frame : Heap) (st : Zig.St)
    (offset : FlatShuffler.Word) (pol : CpuPolicy) (m : DataMem) (rdi : UInt64)
    (hHex : (objsP self target spills data st offset ++ frame).Holds pol m)
    (hC : offset.toNat < FlatShuffler.maxStackSize) (hrdi : rdi.toBitVec = self) :
    emissionIsSpilled.l2p.returns
      ⟨objsP self target spills data st offset ++ frame,
       UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
         (st.target.toList.getD offset.toNat default) (st.targetPad.toList.getD offset.toNat 0)), rdi⟩
      (UInt64.ofBitVec (if FlatShuffler.Flat.isVariable (st.target.toList.getD offset.toNat default)
       then (spills &&& 18446744073709551360) |||
         (if st.spills (st.target.toList.getD offset.toNat default).payload ≠ 0 then (1 : BitVec 64) else 0)
       else 0)) := by
  let slot : FlatShuffler.StackSlot := st.target.toList.getD offset.toNat default
  let pad : BitVec 16 := st.targetPad.toList.getD offset.toNat 0
  have hslot : FlatShuffler.Flat.get st.target offset = slot := flat_get_eq_getD st.target offset hC
  let heap : Heap := objsP self target spills data st offset ++ frame
  let a : emissionIsSpilled.In2p :=
    ⟨heap, UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord slot pad), rdi⟩
  let x0 := emissionIsSpilled.initP a
  change emissionIsSpilled.blocksP.Returns noCall .entry x0
    (UInt64.ofBitVec (if FlatShuffler.Flat.isVariable slot
       then (spills &&& 18446744073709551360) |||
         (if st.spills slot.payload ≠ 0 then (1 : BitVec 64) else 0)
       else 0))
  let cond : UInt64 :=
    ((if ¬ ((x0.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0)
      &&& (if ((x0.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0))
  let xn : emissionIsSpilled.St emissionIsSpilled.In2p :=
    { x0 with
      rax := (x0.input.rsi >>> (32 : UInt64) &&& 18446744073709551360) ||| ((if (x0.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then 1 else 0) &&& 255),
      rcx := (x0.input.rsi >>> (40 : UInt64) &&& 18446744073709551360) ||| ((if ¬ ((x0.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) &&& 255) }
  have hentry : emissionIsSpilled.blocksP.step .entry x0 =
      .ok (if cond = 0 then .goto .o28 xn else .goto .LBB13_3 xn) := by
    simp only [emissionIsSpilled.blocksP, x0, emissionIsSpilled.initP, xn, cond]
  have hcond_iff : cond = 0 ↔ ¬ FlatShuffler.Flat.isVariable slot :=
    entry_cond slot pad (ushr40_zero_iff slot pad) (ushr32_zero_iff slot pad)
  by_cases hv : FlatShuffler.Flat.isVariable slot
  · have hcond : cond ≠ 0 := fun h => (hcond_iff.mp h) hv
    have hstep1 : emissionIsSpilled.blocksP.step .entry x0 = .ok (.goto .LBB13_3 xn) := by
      rw [hentry]; simp only [if_neg hcond]
    have hld1 : xn.input.heap.loadB (xn.input.rdi.toBitVec + 16) .W64 = .ok spills := by
      simp only [xn, x0, emissionIsSpilled.initP, a]
      rw [hrdi]
      exact Heap.loadB_of_load (load_spills self target spills data frame st offset pol m hHex)
    have hld2 : xn.input.heap.loadB
        (spills + BitVec.zeroExtend 64 (BitVec.truncate 32 (xn.input.rsi.toBitVec)) * 1) .W8
        = .ok (st.spills slot.payload) := by
      simp only [xn, x0, emissionIsSpilled.initP, a]
      rw [spill_addr]
      have h := load_spillByte self target spills data frame st offset pol m hHex
      rw [hslot] at h
      exact Heap.loadB_of_load h
    have hstep2 : emissionIsSpilled.blocksP.step .LBB13_3 xn =
        .ok (.ret ((UInt64.ofBitVec spills &&& 18446744073709551360) |||
          ((if ¬ (UInt64.ofBitVec (BitVec.zeroExtend 64 (st.spills slot.payload)) = 0) then 1 else 0) &&& 255))) := by
      simp only [emissionIsSpilled.blocksP, hld1, hld2]
    have hres : ((UInt64.ofBitVec spills &&& 18446744073709551360) |||
          ((if ¬ (UInt64.ofBitVec (BitVec.zeroExtend 64 (st.spills slot.payload)) = 0) then 1 else 0) &&& 255))
        = UInt64.ofBitVec ((spills &&& 18446744073709551360) |||
            (if st.spills slot.payload ≠ 0 then (1 : BitVec 64) else 0)) :=
      isSpilled_word spills (st.spills slot.payload)
    have hr : (UInt64.ofBitVec (if FlatShuffler.Flat.isVariable slot
          then (spills &&& 18446744073709551360) |||
            (if st.spills slot.payload ≠ 0 then (1 : BitVec 64) else 0)
          else 0))
        = UInt64.ofBitVec ((spills &&& 18446744073709551360) |||
            (if st.spills slot.payload ≠ 0 then (1 : BitVec 64) else 0)) := by
      rw [if_pos hv]
    rw [hr, ← hres]
    exact .goto hstep1 (.ret hstep2)
  · have hcond : cond = 0 := hcond_iff.mpr hv
    have hstep1 : emissionIsSpilled.blocksP.step .entry x0 = .ok (.goto .o28 xn) := by
      rw [hentry]; simp only [if_pos hcond]
    have hstep2 : emissionIsSpilled.blocksP.step .o28 xn = .ok (.ret 0) := by
      simp only [emissionIsSpilled.blocksP]
    have hr : (UInt64.ofBitVec (if FlatShuffler.Flat.isVariable slot
          then (spills &&& 18446744073709551360) |||
            (if st.spills slot.payload ≠ 0 then (1 : BitVec 64) else 0)
          else 0)) = 0 := by
      rw [if_neg hv]; rfl
    rw [hr]
    exact .goto hstep1 (.ret hstep2)

theorem o12_addr (data : BitVec 64) (x_rax : UInt64) (h0 : x_rax ≠ 0) :
    data + x_rax.toBitVec * 8 + 18446744073709551608 = data + BitVec.ofNat 64 (8 * (x_rax.toNat - 1)) := by
  have h0n : 1 ≤ x_rax.toNat := by
    rcases Nat.eq_zero_or_pos x_rax.toNat with h | h
    · exfalso; apply h0; apply UInt64.toNat_inj.mp; rw [h]; rfl
    · exact h
  have hsub : (x_rax - 1).toNat = x_rax.toNat - 1 := by
    rw [UInt64.toNat_sub_of_toNat_le (a := x_rax) (b := 1) (by rw [UInt64.toNat_one]; omega), UInt64.toNat_one]
  have haddr1 : data + x_rax.toBitVec * 8 + 18446744073709551608 = data + (x_rax - 1).toBitVec * 8 := by
    rw [UInt64.toBitVec_sub, UInt64.toBitVec_one]
    bv_omega
  have h2 : (x_rax - 1).toBitVec * 8 = BitVec.ofNat 64 (8 * (x_rax.toNat - 1)) := by
    apply BitVec.eq_of_toNat_eq
    rw [BitVec.toNat_mul, UInt64.toNat_toBitVec, hsub]
    have h8 : BitVec.toNat (8 : BitVec 64) = 8 := by decide
    rw [h8, Nat.mul_comm (x_rax.toNat - 1) 8, BitVec.toNat_ofNat]
  rw [haddr1, h2]

theorem slotWord_cmp (a : FlatShuffler.StackSlot) (p : BitVec 16) (b : FlatShuffler.StackSlot) (q : BitVec 16) :
    (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord a p) &&& 281474976710655
      = UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord b q) &&& 281474976710655) ↔ a = b := by
  rw [← UInt64.toBitVec_inj]
  simp only [UInt64.toBitVec_and]
  exact slotWord_low48_eq a b p q

theorem load_data_at (self target spills data : BitVec 64) (frame : Heap) (st : Zig.St)
    (offset : FlatShuffler.Word) (pol : CpuPolicy) (m : DataMem)
    (hH : (objsP self target spills data st offset ++ frame).Holds pol m)
    (x_rax : UInt64) (h0 : x_rax ≠ 0) (hle : x_rax.toNat ≤ st.size.toNat) (hs : st.size.toNat ≤ 1024) :
    (objsP self target spills data st offset ++ frame).load
        (data + x_rax.toBitVec * 8 + 18446744073709551608) .W64
      = .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord
          (st.data.toList.getD (x_rax.toNat - 1) default) (st.pad.toList.getD (x_rax.toNat - 1) 0)) := by
  have hi : x_rax.toNat - 1 < 1024 := by omega
  rw [o12_addr data x_rax h0]
  exact load_data self target spills data frame st offset pol m hH (x_rax.toNat - 1) hi

theorem copyBelow_zero (st : Zig.St) (slot : FlatShuffler.StackSlot) :
    Zig.copyBelow st slot 0 = FlatShuffler.Flat.NONE := by
  rw [Zig.copyBelow.eq_def]; simp

theorem copyBelow_hit (st : Zig.St) (slot : FlatShuffler.StackSlot) (pos : FlatShuffler.Word)
    (h0 : pos ≠ 0) (h : FlatShuffler.Flat.get st.data (pos - 1) = slot) :
    Zig.copyBelow st slot pos = pos - 1 := by
  rw [Zig.copyBelow.eq_def, dif_neg h0, if_pos h]

theorem copyBelow_miss (st : Zig.St) (slot : FlatShuffler.StackSlot) (pos : FlatShuffler.Word)
    (h0 : pos ≠ 0) (h : FlatShuffler.Flat.get st.data (pos - 1) ≠ slot) :
    Zig.copyBelow st slot pos = Zig.copyBelow st slot (pos - 1) := by
  rw [Zig.copyBelow.eq_def, dif_neg h0, if_neg h]

theorem get_sub_one (st : Zig.St) (x_rax : UInt64) (h0 : x_rax ≠ 0) (hle : x_rax.toNat ≤ st.size.toNat) (hs : st.size.toNat ≤ 1024) :
    FlatShuffler.Flat.get st.data (x_rax.toBitVec - 1) = st.data.toList.getD (x_rax.toNat - 1) default := by
  have h0n : 1 ≤ x_rax.toNat := by
    rcases Nat.eq_zero_or_pos x_rax.toNat with h | h
    · exfalso; apply h0; apply UInt64.toNat_inj.mp; rw [h]; rfl
    · exact h
  have hsub : (x_rax - 1).toNat = x_rax.toNat - 1 := by
    rw [UInt64.toNat_sub_of_toNat_le (a := x_rax) (b := 1) (by rw [UInt64.toNat_one]; omega), UInt64.toNat_one]
  have hpos : x_rax.toBitVec - 1 = (x_rax - 1).toBitVec := by
    simp [UInt64.toBitVec_sub, UInt64.toBitVec_one]
  have hpos2 : (x_rax - 1).toBitVec = BitVec.ofNat 64 (x_rax.toNat - 1) := by
    apply BitVec.eq_of_toNat_eq
    rw [UInt64.toNat_toBitVec, hsub, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
  rw [hpos, hpos2]
  have hi : (BitVec.ofNat 64 (x_rax.toNat - 1)).toNat < FlatShuffler.maxStackSize := by
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
    simp only [FlatShuffler.maxStackSize]; omega
  have h := flat_get_eq_getD st.data (BitVec.ofNat 64 (x_rax.toNat - 1)) hi
  rw [h]
  congr 1
  rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]

theorem shallowest_returns (self target spills data : BitVec 64) (frame : Heap) (st : Zig.St)
    (offset : FlatShuffler.Word) (pol : CpuPolicy) (m : DataMem) (rdi : UInt64) (sp : BitVec 64)
    (hHex : (objsP self target spills data st offset ++ frame).Holds pol m)
    (hC : offset.toNat < FlatShuffler.maxStackSize) (hrdi : rdi.toBitVec = self)
    (hs : st.size.toNat ≤ FlatShuffler.maxStackSize) :
    emissionShallowestCopyPosition.l2p.returns
      ⟨objsP self target spills data st offset ++ frame,
       UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
         (st.target.toList.getD offset.toNat default) (st.targetPad.toList.getD offset.toNat 0)), rdi, sp⟩
      (UInt64.ofBitVec (Lift.Shuffler.Zig.copyBelow st (st.target.toList.getD offset.toNat default) st.size)) := by
  let slot : FlatShuffler.StackSlot := st.target.toList.getD offset.toNat default
  let pad : BitVec 16 := st.targetPad.toList.getD offset.toNat 0
  have hslot : FlatShuffler.Flat.get st.target offset = slot := flat_get_eq_getD st.target offset hC
  let heap : Heap := objsP self target spills data st offset ++ frame
  let a : emissionShallowestCopyPosition.In2p :=
    ⟨heap, UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord slot pad), rdi, sp⟩
  let x0 := emissionShallowestCopyPosition.initP a
  change emissionShallowestCopyPosition.blocksP.Returns noCall .entry x0
    (UInt64.ofBitVec (Zig.copyBelow st slot st.size))
  have hload : x0.mem.loadB (x0.input.rdi.toBitVec + 48) .W64 = .ok st.size := by
    simp only [x0, emissionShallowestCopyPosition.initP, a]
    rw [hrdi]
    exact Heap.loadB_of_load (load_size self target spills data frame st offset pol m hHex)
  let x1 : emissionShallowestCopyPosition.St emissionShallowestCopyPosition.In2p Heap :=
    { x0 with rax := UInt64.ofBitVec st.size, rcx := UInt64.ofBitVec FlatShuffler.Flat.NONE }
  have hentry : emissionShallowestCopyPosition.blocksP.step .entry x0 = .ok (.goto .LBB11_1 x1) := by
    simp only [emissionShallowestCopyPosition.blocksP, hload, x1]; rfl
  let I : emissionShallowestCopyPosition.St emissionShallowestCopyPosition.In2p Heap → Prop :=
    fun x => x.input = a ∧ x.rcx = UInt64.ofBitVec FlatShuffler.Flat.NONE ∧
      x.rax.toNat ≤ st.size.toNat ∧ x.mem = heap
  let out : emissionShallowestCopyPosition.St emissionShallowestCopyPosition.In2p Heap → UInt64 :=
    fun x => UInt64.ofBitVec (Zig.copyBelow st slot x.rax.toBitVec)
  have hloop : emissionShallowestCopyPosition.blocksP.Returns noCall .LBB11_1 x1 (out x1) := by
    refine Blocks.Returns.loop I (fun x => x.rax.toNat) out ?_ x1 ⟨rfl, rfl, ?_, rfl⟩
    intro x hI ih
    obtain ⟨hinp, hrcx, hle, hmem⟩ := hI
    by_cases hx0 : x.rax = 0
    · have hstep1 : emissionShallowestCopyPosition.blocksP.step .LBB11_1 x = .ok (.goto .LBB11_2 x) := by
        simp only [emissionShallowestCopyPosition.blocksP]; rw [if_pos hx0]
      have hstep2 : emissionShallowestCopyPosition.blocksP.step .LBB11_2 x = .ok (.ret x.rcx) := by
        simp only [emissionShallowestCopyPosition.blocksP]
      have hout : out x = x.rcx := by
        simp only [out, hx0, UInt64.toBitVec_zero, hrcx]
        congr 1
        exact copyBelow_zero st slot
      rw [hout]; exact .goto hstep1 (.ret hstep2)
    · have hpos0 : 0 < x.rax.toNat := by
        rcases Nat.eq_zero_or_pos x.rax.toNat with h | h
        · exfalso; apply hx0; apply UInt64.toNat_inj.mp; rw [h]; rfl
        · exact h
      have hstep1 : emissionShallowestCopyPosition.blocksP.step .LBB11_1 x = .ok (.goto .o12 x) := by
        simp only [emissionShallowestCopyPosition.blocksP]; rw [if_neg hx0]
      have hd : x.mem.loadB (x.input.rdi.toBitVec + 40) .W64 = .ok data := by
        rw [hinp, hmem]; simp only [a]; rw [hrdi]
        exact Heap.loadB_of_load (load_dataPtr self target spills data frame st offset pol m hHex)
      have hsl : x.mem.loadB (data + x.rax.toBitVec * 8 + 18446744073709551608) .W64
          = .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord
              (st.data.toList.getD (x.rax.toNat - 1) default) (st.pad.toList.getD (x.rax.toNat - 1) 0)) := by
        rw [hmem]
        exact Heap.loadB_of_load (load_data_at self target spills data frame st offset pol m hHex x.rax hx0 hle hs)
      have hcmp : (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
              (st.data.toList.getD (x.rax.toNat - 1) default) (st.pad.toList.getD (x.rax.toNat - 1) 0)) &&& 281474976710655
            = x.input.rsi &&& 281474976710655)
          ↔ st.data.toList.getD (x.rax.toNat - 1) default = slot := by
        rw [hinp]; simp only [a]
        exact slotWord_cmp _ _ slot pad
      have hget : FlatShuffler.Flat.get st.data (x.rax.toBitVec - 1) = st.data.toList.getD (x.rax.toNat - 1) default :=
        get_sub_one st x.rax hx0 hle hs
      have hposne : x.rax.toBitVec ≠ 0 := by
        intro h; apply hx0; apply UInt64.toBitVec_inj.mp; simp [h]
      have hsubn : (x.rax - 1).toNat = x.rax.toNat - 1 := by
        rw [UInt64.toNat_sub_of_toNat_le (a := x.rax) (b := 1) (by rw [UInt64.toNat_one]; omega), UInt64.toNat_one]
      have hbitt : (x.rax - 1).toBitVec = x.rax.toBitVec - 1 := by
        simp [UInt64.toBitVec_sub, UInt64.toBitVec_one]
      by_cases hhit : (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
              (st.data.toList.getD (x.rax.toNat - 1) default) (st.pad.toList.getD (x.rax.toNat - 1) 0)) &&& 281474976710655
            = x.input.rsi &&& 281474976710655)
      · have hse : st.data.toList.getD (x.rax.toNat - 1) default = slot := hcmp.mp hhit
        have hget' : FlatShuffler.Flat.get st.data (x.rax.toBitVec - 1) = slot := by rw [hget, hse]
        have hcb : Zig.copyBelow st slot x.rax.toBitVec = x.rax.toBitVec - 1 :=
          copyBelow_hit st slot x.rax.toBitVec hposne hget'
        let y : emissionShallowestCopyPosition.St emissionShallowestCopyPosition.In2p Heap :=
          { x with rax := x.rax - 1, rdx := (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
              (st.data.toList.getD (x.rax.toNat - 1) default) (st.pad.toList.getD (x.rax.toNat - 1) 0)) ^^^ x.input.rsi) <<< (16 : UInt64) }
        have hstep2 : emissionShallowestCopyPosition.blocksP.step .o12 x = .ok (.goto .o33 y) := by
          simp only [emissionShallowestCopyPosition.blocksP, hd, hsl]; rw [if_pos hhit]
        have hstep3 : emissionShallowestCopyPosition.blocksP.step .o33 y = .ok (.ret (x.rax - 1)) := by
          simp only [emissionShallowestCopyPosition.blocksP, y]
        have hout : out x = x.rax - 1 := by
          simp only [out]
          rw [hcb]
          show UInt64.ofBitVec (x.rax.toBitVec - 1) = x.rax - 1
          rw [show x.rax.toBitVec - 1 = (x.rax - 1).toBitVec from hbitt.symm]
        rw [hout]
        exact .goto hstep1 (.goto hstep2 (.ret hstep3))
      · have hse : ¬ st.data.toList.getD (x.rax.toNat - 1) default = slot := fun h => hhit (hcmp.mpr h)
        have hget' : FlatShuffler.Flat.get st.data (x.rax.toBitVec - 1) ≠ slot := by rw [hget]; exact hse
        have hcb : Zig.copyBelow st slot x.rax.toBitVec = Zig.copyBelow st slot (x.rax.toBitVec - 1) :=
          copyBelow_miss st slot x.rax.toBitVec hposne hget'
        let y : emissionShallowestCopyPosition.St emissionShallowestCopyPosition.In2p Heap :=
          { x with rax := x.rax - 1, rdx := (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
              (st.data.toList.getD (x.rax.toNat - 1) default) (st.pad.toList.getD (x.rax.toNat - 1) 0)) ^^^ x.input.rsi) <<< (16 : UInt64) }
        have hstep2 : emissionShallowestCopyPosition.blocksP.step .o12 x = .ok (.goto .LBB11_1 y) := by
          simp only [emissionShallowestCopyPosition.blocksP, hd, hsl]; rw [if_neg hhit]
        have hIy : I y := by
          refine ⟨?_, ?_, ?_, ?_⟩
          · simp only [y, hinp]
          · simp only [y, hrcx]
          · simp only [y]; rw [hsubn]; omega
          · simp only [y, hmem]
        have hμ : y.rax.toNat < x.rax.toNat := by
          simp only [y]; rw [hsubn]; omega
        have hout : out y = out x := by
          simp only [out, y]
          rw [hbitt, hcb]
        rw [← hout]
        exact .goto hstep1 (.goto hstep2 (ih y hIy hμ))
    show x1.rax.toNat ≤ st.size.toNat
    exact Nat.le_refl _
  have hr1 : out x1 = UInt64.ofBitVec (Zig.copyBelow st slot st.size) := by
    simp only [out, x1]
  rw [← hr1]
  exact .goto hentry hloop

theorem lowByte_or_mask (a : BitVec 64) (p : Prop) [Decidable p] :
    (UInt64.ofBitVec ((a &&& 18446744073709551360) ||| (if p then (1 : BitVec 64) else 0))).toUInt8.toUInt64
      = (if p then (1 : UInt64) else 0) := by
  apply UInt64.toBitVec_inj.mp
  rw [toUInt8_toUInt64_toBitVec]
  by_cases hp : p
  · simp only [hp, ite_true]
    bv_decide
  · simp only [hp, ite_false]
    bv_decide

theorem lowByte_or_prop (rbx : UInt64) (p : Prop) [Decidable p] :
    ((((rbx &&& 18446744073709551360) ||| ((if p then (1 : UInt64) else 0) &&& 255)).toUInt32.toUInt64).toBitVec).setWidth 8
      = (if p then (1 : BitVec 8) else 0) := by
  by_cases hp : p
  · rw [show (if p then (1:UInt64) else 0) = 1 from if_pos hp,
        show (if p then (1:BitVec 8) else 0) = 1 from if_pos hp]
    simpa using lowByte_or rbx true
  · rw [show (if p then (1:UInt64) else 0) = 0 from if_neg hp,
        show (if p then (1:BitVec 8) else 0) = 0 from if_neg hp]
    simpa using lowByte_or rbx false

theorem rbx_or_mask (rbx : UInt64) (p : Prop) [Decidable p] :
    (((rbx &&& 18446744073709551360) ||| (1 &&& 255)) &&& 18446744073709551360) ||| ((if p then (1 : UInt64) else 0) &&& 255)
      = (rbx &&& 18446744073709551360) ||| ((if p then (1 : UInt64) else 0) &&& 255) := by
  by_cases hp : p
  · rw [if_pos hp]
    apply UInt64.toBitVec_inj.mp
    simp only [UInt64.toBitVec_or, UInt64.toBitVec_and, UInt64.toBitVec_ofNat]
    bv_decide
  · rw [if_neg hp]
    apply UInt64.toBitVec_inj.mp
    simp only [UInt64.toBitVec_or, UInt64.toBitVec_and, UInt64.toBitVec_ofNat]
    bv_decide

theorem ofBitVec_none_iff (x : BitVec 64) :
    (UInt64.ofBitVec x = 18446744073709551615) ↔ x = FlatShuffler.Flat.NONE := by
  rw [← UInt64.toBitVec_inj]
  rfl

theorem toUInt8_ushr32 (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (32 : UInt64)).toUInt8.toBitVec = s.kind := by
  have h1 : (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (32 : UInt64)).toBitVec
      = Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad >>> (32 : Nat) := by simp
  show ((UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad) >>> (32 : UInt64)).toBitVec).setWidth 8 = s.kind
  rw [h1, ← BitVec.truncate_eq_setWidth, slotWord_ushr32]

theorem uint8_kind_ne : ∀ k : UInt8, 2 ≤ (k.toUInt64 - 1).toUInt8.toUInt64 →
    k.toBitVec ≠ FlatShuffler.Junk ∧ k.toBitVec ≠ FlatShuffler.FunctionCallReturnLabel := by decide

theorem uint8_kind_cases : ∀ k : UInt8, ¬ 2 ≤ (k.toUInt64 - 1).toUInt8.toUInt64 →
    k.toBitVec = FlatShuffler.Junk ∨ k.toBitVec = FlatShuffler.FunctionCallReturnLabel := by decide

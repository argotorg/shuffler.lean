      show ([⟨.W8, (if Zig.isAvailable st offset then (1 : BitVec 8) else 0)⟩] : List Lift.Trusted.Field)
        = [⟨.W8, (x1.rbx.toUInt32.toUInt64).toBitVec.setWidth 8⟩]
      rw [hav, hb]
      rfl
  · let x1 : St In2p Heap := { x0 with rax := UInt64.ofBitVec w >>> (40 : UInt64), rbx := (x0.rbx &&& 18446744073709551360) ||| (1 &&& 255), r15 := UInt64.ofBitVec w }
    have hstep1 : blocksP.step .entry x0 = .ok (.goto .o25 x1) := by

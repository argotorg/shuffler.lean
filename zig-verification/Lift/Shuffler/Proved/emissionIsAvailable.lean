        rw [show y.input.sp - 24 + 8 = y.input.sp - BitVec.ofNat 64 16 from by bv_omega]
        exact hv1
      have h2 : readRam y.input.policy y.mem (y.input.sp - 24 + 16) .W64 = .ok v2 := by
        rw [show y.input.sp - 24 + 16 = y.input.sp - BitVec.ofNat 64 8 from by bv_omega]
        exact hv2
      refine ⟨(y.rbx.toUInt32.toUInt64, y.mem), ?_, ?_⟩
      · simp only [blocks]
        rw [hv0', h1, h2]
      · refine ⟨?_, ?_⟩
        · rw [hsim.hrbx]
        · intro c hc
          rw [← hsim.hin] at hc ⊢
          exact hsim.hf c hc
  · refine ⟨hs, rfl, hs.1, hs.2.1, hs.2.2.1, hs.2.2.2.1, hs.2.2.2.2.1, hs.2.2.2.2.2.1, ?_,
      hs.2.2.2.2.2.2.2.2.1, hs.2.2.2.2.2.2.2.2.2.1, rfl, rfl⟩
    intro c hc
    rfl

      · exact ⟨hsim.hr15, hsim.hrdi, hh1, hperm⟩
      · rintro r r' hr1
        subst hr1
        exact ⟨rfl, ⟨hsim.sin, rfl, hsim.hrbx, hsim.hr15, hsim.hrdi, hsim.hrdi, hsim.hr15, hh1,

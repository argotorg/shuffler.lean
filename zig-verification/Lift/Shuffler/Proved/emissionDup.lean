open Lift.Shuffler.Internal.Proposed in
theorem HeapAt_store_size {policy : CpuPolicy} {e : Layout.Env} {frame : Heap}
    {st : Lift.Shuffler.Zig.St} {T : Obj} {m : DataMem} (v : BitVec 64)
    (hm : Heap.Holds policy (HeapAt e frame st T) m) :
    (HeapAt e frame st T).storeB (e.self + 48) .W64 (st.size + 1) =

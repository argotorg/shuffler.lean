    Lift.Shuffler.Internal.Proposed.DupStatement.envOf]

/-- The size of the `data` array. -/
theorem size_dataObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St} :
    (toObj (Lift.Shuffler.Internal.Proposed.Layout.data (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).size = 1024 * 8 := by
  simp [Bridge.toObj, Bridge.toCell, Lift.Shuffler.Internal.Proposed.Layout.data,
    Lift.Shuffler.Internal.Proposed.DupStatement.envOf, Lift.Shuffler.Internal.Proposed.Layout.slotWord,
    Obj.size, List.map_map, Function.comp_def, FlatShuffler.maxStackSize, Width.bytes, sum_map_const]

/-- The size of a list of 64-bit cells. -/
theorem cellsSize_eq64 (cs : List Cell) (hall : ∀ c ∈ cs, c.w = .W64) : cellsSize cs = cs.length * 8 := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    have hc : c.w.bytes = 8 := by rw [hall c (List.mem_cons_self ..)]
    have ih' : cellsSize cs = cs.length * 8 := ih (fun c' hc' => hall c' (List.mem_cons_of_mem _ hc'))
    rw [show cellsSize (c :: cs) = c.w.bytes + cellsSize cs from rfl, hc, ih', List.length_cons]
    omega

/-- An object of 64-bit cells spans its element `k`. -/
theorem spans_cells64 {base : BitVec 64} {wr : Bool} {cs : List Cell} {k : BitVec 64}
    (hall : ∀ c ∈ cs, c.w = .W64) (hk : k.toNat < cs.length)
    (hn : base.toNat + cs.length * 8 ≤ 2 ^ 64) :
    (Obj.mk base wr cs).Spans (base + k * 8) .W64 := by
  have hsz : cellsSize cs = cs.length * 8 := cellsSize_eq64 cs hall
  have hsize : ({addr := base, writable := wr, cells := cs} : Obj).size = cellsSize cs := rfl
  have hb : Width.W64.bytes = 8 := rfl
  unfold Obj.Spans
  dsimp only
  rw [hsize, hsz, hb]
  have e : (base + k * 8).toNat = base.toNat + k.toNat * 8 := by bv_omega
  rw [e]
  constructor <;> omega

/-- The trace array spans the bytes of its operation `k`, at a bit-vector offset. -/
theorem spans_trace_at {base K off : BitVec 64}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240}
    {w : Width} (hK : K.toNat < 10240) (hoff : off.toNat + w.bytes ≤ 12)
    (hn : base.toNat + 10240 * 12 ≤ 2 ^ 64) :
    (Obj.mk base true (traceCells trace0)).Spans (base + K * 12 + off) w := by
  have hsz : (Obj.mk base true (traceCells trace0)).size = 10240 * 12 := cellsSize_traceCells trace0
  unfold Obj.Spans
  rw [hsz]
  dsimp only
  have hw := width_bytes_pos w
  have e : (base + K * 12 + off).toNat = base.toNat + 12 * K.toNat + off.toNat := by bv_omega
  rw [e]
  omega

/-- The `traceSize` field of the statement spans its cell. -/
theorem spans_traceSizeObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St} :
    (toObj (Lift.Shuffler.Internal.Proposed.Layout.traceSize (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).Spans ((Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping).self + 64) .W64 := by
  have h : toObj (Lift.Shuffler.Internal.Proposed.Layout.traceSize (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true) =
      Obj.mk (self + 64) true [⟨.W64, BitVec.ofNat 64 st.trace.length⟩] := by
    simp [Bridge.toObj, Bridge.toCell, Lift.Shuffler.Internal.Proposed.Layout.traceSize,
      Lift.Shuffler.Internal.Proposed.Layout.word, Lift.Shuffler.Internal.Proposed.DupStatement.envOf]
  rw [h]
  exact spans_self_cell64

/-- The `size` field of the statement spans its cell. -/
theorem spans_sizeObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St} :
    (toObj (Lift.Shuffler.Internal.Proposed.Layout.size (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).Spans ((Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping).self + 48) .W64 := by
  have h : toObj (Lift.Shuffler.Internal.Proposed.Layout.size (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true) =
      Obj.mk (self + 48) true [⟨.W64, st.size⟩] := by
    simp [Bridge.toObj, Bridge.toCell, Lift.Shuffler.Internal.Proposed.Layout.size,
      Lift.Shuffler.Internal.Proposed.Layout.word, Lift.Shuffler.Internal.Proposed.DupStatement.envOf]
  rw [h]
  exact spans_self_cell64

/-- The trace array of the statement spans the bytes of its operation `k`. -/
theorem spans_traceObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St}
    {copy destination : FlatShuffler.Word}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240} {K off : BitVec 64} {w : Width}
    (hK : K.toNat < 10240) (hoff : off.toNat + w.bytes ≤ 12) (hn : trace.toNat + 10240 * 12 ≤ 2 ^ 64) :
    (toObj (⟨trace, trace0.toList.flatMap (fun t => ([⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] : List Lift.Trusted.Field)), true⟩ : Lift.Trusted.Object)).Spans (trace + K * 12 + off) w := by
  have hobj : toObj (⟨trace, trace0.toList.flatMap (fun t => ([⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] : List Lift.Trusted.Field)), true⟩ : Lift.Trusted.Object) = Obj.mk trace true (traceCells trace0) := by
    simp only [Bridge.toObj]
    rw [traceCells_map]
  rw [hobj]
  exact spans_trace_at hK hoff hn

/-- The `data` array of the statement spans the word `k`. -/
theorem spans_dataObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St} {k : BitVec 64}
    (hk : k.toNat < 1024) (hn : data.toNat + 1024 * 8 ≤ 2 ^ 64) :
    (toObj (Lift.Shuffler.Internal.Proposed.Layout.data (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).Spans (data + k * 8) .W64 := by
  have hobj : toObj (Lift.Shuffler.Internal.Proposed.Layout.data (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true) =
      Obj.mk data true ((List.range 1024).map (fun i => (⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord (st.data.toList.getD i default) (st.pad.toList.getD i 0)⟩ : Cell))) := by
    simp [Bridge.toObj, Bridge.toCell, Lift.Shuffler.Internal.Proposed.Layout.data,
      Lift.Shuffler.Internal.Proposed.DupStatement.envOf, List.map_map, Function.comp_def, FlatShuffler.maxStackSize]
  rw [hobj]
  refine spans_cells64 ?_ ?_ ?_
  · intro c hc
    simp only [List.mem_map] at hc
    obtain ⟨i, -, rfl⟩ := hc
    rfl
  · simpa using hk
  · simpa using hn

/-- Two distinct objects of a heap that the memory holds are apart. -/
theorem apart_of_holds {policy : CpuPolicy} {m : DataMem} {h : Heap} (hh : h.Holds policy m)
    {o o' : Obj} (ho : o ∈ h) (ho' : o' ∈ h) (hne : o ≠ o')
    (hw : o.writable = true ∨ o'.writable = true) : o.Apart o' :=
  pairwise_of_mem (fun {a b} (h : (a.writable = true ∨ b.writable = true) → a.Apart b) hw' =>
    Or.symm (h (Or.symm hw'))) hh.apart ho ho' hne hw

/-- An object apart from a spanned access does not span it. -/
theorem not_spans_of_apart {o o' : Obj} {a : BitVec 64} {w : Width}
    (hap : o'.Apart o) (hsp : o'.Spans a w) : ¬ o.Spans a w :=
  fun hs => Obj.not_apart_of_spans hsp hs hap

/-- Objects of different sizes are different. -/
theorem ne_of_size {o o' : Obj} (h : o.size ≠ o'.size) : o ≠ o' :=
  fun e => h (congrArg Obj.size e)

namespace CalleeHeapPartition

open Lift.P2.Total Lift.Sem Lift.Sem.CallArm Lift.Sem.Bridge Lift.Shuffler
open Lift.Shuffler.Internal.Proposed


theorem dup_partition : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (copy : FlatShuffler.Word) (destination : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre self data trace mapping frame st copy destination trace0 a → skel_call.l2p.returns a q → ∃ (g : Obj → Obj) (m : DataMem), q.2 = (objsP self data trace mapping st copy destination trace0).map g ++ frame ∧ FrameHeap (objsP self data trace mapping st copy destination trace0) frame [] a.policy g m := by
  intro self data trace mapping frame st copy destination trace0 a q hpre hret
  simp only [callPre, SimArr, callInput] at hpre
  obtain ⟨hC, hrdi, hrsi, hrdx, hheap, m0, hm0⟩ := hpre
  obtain ⟨⟨hcopy, hsize, hdest, htrace⟩, -⟩ := hC
  let objs := objsP self data trace mapping st copy destination trace0
  have hholds0 : Heap.Holds a.policy (objs ++ frame) m0 := by rw [← hheap]; exact hm0
  have hid : FrameHeap objs frame [] a.policy id m0 :=
    ⟨fun _ _ => rfl, fun _ _ _ => rfl, fun o ho => absurd ho List.not_mem_nil, fun _ _ => rfl,
      by rw [List.map_id]; exact hholds0⟩
  simp only [skel_call.l2p] at hret
  have key : ∃ (g : Obj → Obj) (m : DataMem), q.2 = objs.map g ++ frame ∧ FrameHeap objs frame [] a.policy g m := by
    refine Lift.Sem.CallArm.Blocks.Returns.inv
      (FrameInv objs frame a st.size (BitVec.ofNat 64 st.trace.length) mapping copy)
      (fun r => ∃ (g : Obj → Obj) (m : DataMem), r.2 = objs.map g ++ frame ∧ FrameHeap objs frame [] a.policy g m) ?_ hret ?_
    · rintro l x n hI hs
      cases l with
      | entry =>
        obtain ⟨hinput, hmem, hrsi'⟩ := hI
        simp only [skel_call.blocksP] at hs
        cases hl1 : x.mem.loadB (x.input.rdi.toBitVec + 40) .W64 with
        | ok v =>
          cases hl2 : x.mem.loadB (v + x.rsi.toBitVec * 8 + 4) .W8 with
          | ok v1 =>
            simp only [hl1, hl2] at hs
            simp only [Res.ok.injEq] at hs
            subst n

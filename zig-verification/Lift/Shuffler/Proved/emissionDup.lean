  · rw [hdup]
    subst hr
    simp only [DupStatement.result, FlatShuffler.Flat.ExecutionControl.done, reduceCtorEq,
      if_true, UInt64.toBitVec_zero, BitVec.setWidth_zero]
    rfl
  · intro o ho

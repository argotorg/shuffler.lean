          simpa using h
        have hlen_dest : st.dest.toList.length = 1024 := by
          rw [Vector.length_toList]
          rfl
        have hlen_pos : st.pos.toList.length = 1024 := by
          rw [Vector.length_toList]
          rfl
        have hn_dest' : mapping.toNat + 1024 * 8 ≤ 2 ^ 64 := by rw [← hlen_dest]; exact hn_dest
        have hn_pos' : (mapping + 8192).toNat + 1024 * 8 ≤ 2 ^ 64 := by rw [← hlen_pos]; exact hn_pos
        have heq_dest : toObj (Lift.Shuffler.Internal.Proposed.Layout.dest (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true) =
            Obj.words mapping true .W64 st.dest.toList := by
          simp only [Bridge.toObj, Bridge.toCell, Lift.Shuffler.Internal.Proposed.Layout.dest, Obj.words,
            Lift.Shuffler.Internal.Proposed.DupStatement.envOf, List.map_map, Function.comp_def, Cell.mk]
        have heq_pos : toObj (Lift.Shuffler.Internal.Proposed.Layout.pos (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true) =
            Obj.words (mapping + 8192) true .W64 st.pos.toList := by
          simp only [Bridge.toObj, Bridge.toCell, Lift.Shuffler.Internal.Proposed.Layout.pos, Obj.words,
            Lift.Shuffler.Internal.Proposed.DupStatement.envOf, List.map_map, Function.comp_def, Cell.mk]
        have hsp1 : (toObj (Lift.Shuffler.Internal.Proposed.Layout.dest (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).Spans (mapping + st.size * 8) .W64 := by
          rw [heq_dest]
          exact spans_words_bv (base := mapping) (wr := true) (xs := st.dest.toList) (k := st.size)
            (by rw [hlen_dest]; exact hbnd_size) hn_dest
        have haddr : mapping + destination * 8 + 8192 = (mapping + 8192) + destination * 8 := by
          rw [BitVec.add_assoc, BitVec.add_comm (destination * 8) (8192 : BitVec 64), ← BitVec.add_assoc]
        have hsp2 : (toObj (Lift.Shuffler.Internal.Proposed.Layout.pos (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).Spans (mapping + destination * 8 + 8192) .W64 := by
          rw [heq_pos, haddr]
          exact spans_words_bv (base := mapping + 8192) (wr := true) (xs := st.pos.toList) (k := destination)
            (by rw [hlen_pos]; exact hdest) hn_pos
        rw [hinput, hrdx, hrsi', hrcx'] at hs
        simp only [UInt64.toBitVec_ofBitVec] at hs
        rw [hmem] at hs
        cases h1 : Heap.storeB (objs.map g ++ frame) (mapping + st.size * 8) .W64 destination with
        | ok h' =>
          simp only [h1] at hs
          obtain ⟨g1, m1, hmem1, hrel1, -⟩ := FrameHeap.storeB hrel (fun o ho => absurd ho List.not_mem_nil)
            ⟨_, hmem_dest, rfl, hsp1⟩ (fun o ho => absurd ho List.not_mem_nil) h1
          cases h2 : Heap.storeB h' (mapping + destination * 8 + 8192) .W64 st.size with
          | ok h'' =>
            simp only [h2] at hs
            rw [hmem1] at h2
            obtain ⟨g2, m2, hmem2, hrel2, -⟩ := FrameHeap.storeB hrel1 (fun o ho => absurd ho List.not_mem_nil)
              ⟨_, hmem_pos, rfl, hsp2⟩ (fun o ho => absurd ho List.not_mem_nil) h2
            simp only [Res.ok.injEq] at hs
            subst n
            exact ⟨rfl, g2, m2, hmem2, hrel2⟩
          | stuck why => simp only [h2] at hs; cases hs
          | noFuel => simp only [h2] at hs; cases hs
        | stuck why => simp only [h1] at hs; cases hs
        | noFuel => simp only [h1] at hs; cases hs
      | LBB14_5 =>
        obtain ⟨hinput, g, m', hmem, hrel⟩ := hI
        simp only [skel_call.blocksP] at hs
        simp only [Res.ok.injEq] at hs
        subst n
        exact ⟨g, m', hmem, hrel⟩
    · refine ⟨rfl, rfl, ?_⟩
      show a.rsi = UInt64.ofBitVec copy
      rw [← UInt64.ofBitVec_toBitVec (a := a.rsi), hrsi]
  exact key

end CalleeHeapPartition

theorem call_frame : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (copy : FlatShuffler.Word) (destination : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre self data trace mapping frame st copy destination trace0 a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro self data trace mapping frame st copy destination trace0 a q hp hr m hm
  obtain ⟨g, memory, heq, relation⟩ := CalleeHeapPartition.dup_partition self data trace mapping frame st copy destination trace0 a q hp hr
  exact Heap.Holds.sublist hm (heq ▸ List.sublist_append_right _ frame)

end call_frame.skel_proof
theorem call_frame : call_frame.skel_statement := @call_frame.skel_proof.call_frame

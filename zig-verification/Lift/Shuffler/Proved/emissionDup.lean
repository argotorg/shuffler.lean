/-- A map that fixes each object of a list does not change it. -/
theorem List.map_eq_self_of {l : List Obj} {f : Obj → Obj} (h : ∀ p ∈ l, f p = p) : l.map f = l := by
  induction l with
  | nil => rfl
  | cons a t ih =>
    rw [List.map_cons, h a (List.mem_cons_self ..), ih (fun p hp => h p (List.mem_cons_of_mem _ hp))]

theorem not_mem_of_holds_split {policy : CpuPolicy} {m : DataMem} {l₁ l₂ : Heap} {W : Obj}
    (hh : Heap.Holds policy (l₁ ++ W :: l₂) m) (hw : W.writable = true) (hs : 0 < W.size) :
    W ∉ l₁ ∧ W ∉ l₂ := by
  have hp := hh.apart
  rw [List.pairwise_append] at hp
  obtain ⟨hp₁, hpW, hp₁₂⟩ := hp
  have hWa : ∀ b ∈ l₂, W.Apart b :=
    fun b hb => (List.pairwise_cons.mp hpW).1 b hb (Or.inl hw)
  have haW : ∀ a ∈ l₁, a.Apart W :=
    fun a ha => hp₁₂ a ha W (List.mem_cons_self ..) (Or.inr hw)
  constructor
  · intro hWl
    have h := haW W hWl
    unfold Obj.Apart at h
    omega
  · intro hWl
    have h := hWa W hWl
    unfold Obj.Apart at h
    omega

theorem Heap.store_split {policy : CpuPolicy} {m : DataMem} {O : Obj} {l₁ l₂ : Heap}
    {a : BitVec 64} {w : Width} {v : w.type}
    (hh : Heap.Holds policy (l₁ ++ O :: l₂) m) (hw : O.writable = true)
    (hc : (O.get a w).isSome)
    (hothers : ∀ p ∈ l₁ ++ l₂, p.set a w v = p) :
    Heap.store (l₁ ++ O :: l₂) a w v = .ok (l₁ ++ O.set a w v :: l₂) := by
  have ho : O ∈ l₁ ++ O :: l₂ := List.mem_append_right _ (List.mem_cons_self ..)
  obtain ⟨v₀, hv₀⟩ := Option.isSome_iff_exists.mp hc
  obtain ⟨⟨d, c⟩, hx₀, hax, hxc⟩ := Obj.get_some hv₀
  cases hxc
  have hst := Heap.store_cell (h := l₁ ++ O :: l₂) (O := O) ho hw hx₀ v
  rw [hax] at hst
  rw [hst, List.map_append, List.map_cons]
  rw [List.map_eq_self_of (fun p hp => hothers p (List.mem_append_left _ hp)),
    List.map_eq_self_of (fun p hp => hothers p (List.mem_append_right _ hp))]

theorem Heap.store_words64_split {policy : CpuPolicy} {m : DataMem} {base : BitVec 64}
    {xs : List (BitVec 64)} {l₁ l₂ : Heap} {i : BitVec 64} {v : BitVec 64}
    (hh : Heap.Holds policy (l₁ ++ Obj.words base true .W64 xs :: l₂) m) (hi : i.toNat < xs.length) :
    Heap.store (l₁ ++ Obj.words base true .W64 xs :: l₂) (base + i * 8) .W64 v =
      .ok (l₁ ++ Obj.words base true .W64 (xs.set i.toNat v) :: l₂) := by
  have ho : Obj.words base true .W64 xs ∈ l₁ ++ Obj.words base true .W64 xs :: l₂ :=
    List.mem_append_right _ (List.mem_cons_self ..)
  have hsz : (Obj.words base true .W64 xs).size = 8 * xs.length := by
    rw [Obj.size, Obj.words, words_bytes]
  have ea : BitVec.ofNat 64 (8 * i.toNat) = i * 8 := by
    apply BitVec.eq_of_toNat_eq
    simp [BitVec.toNat_mul, Nat.mul_comm]
  have hx : (8 * i.toNat, (⟨.W64, xs[i.toNat]⟩ : Cell)) ∈
      offsets 0 (Obj.words base true .W64 xs).cells := by
    simpa [Obj.words] using mem_offsets_words .W64 xs 0 i.toNat hi
  have hc : ((Obj.words base true .W64 xs).get (base + i * 8) .W64).isSome := by
    have h := Obj.get_isSome_of_mem (o := Obj.words base true .W64 xs) hx
    rwa [ea] at h
  obtain ⟨hn₁, hn₂⟩ := not_mem_of_holds_split hh rfl (by rw [hsz]; omega)
  have hothers : ∀ p ∈ l₁ ++ l₂, p.set (base + i * 8) .W64 v = p := by
    intro p hp
    rcases List.mem_append.mp hp with h | h
    · simpa [ea, Obj.words] using hh.set_other ho rfl hx (List.mem_append_left _ h) (fun e => hn₁ (e ▸ h)) v
    · simpa [ea, Obj.words] using hh.set_other ho rfl hx (List.mem_append_right _ (List.mem_cons_of_mem _ h))
        (fun e => hn₂ (e ▸ h)) v
  have hst := Heap.store_split hh rfl hc hothers
  rw [hst, Obj.set_words64 (by
    have h := hh.noWrap _ ho
    rw [hsz] at h
    simpa [Obj.words] using h) hi v]

theorem Heap.store_cellObj_split {policy : CpuPolicy} {m : DataMem} {addr : BitVec 64} {w : Width}
    {v v' : w.type} {l₁ l₂ : Heap}
    (hh : Heap.Holds policy (l₁ ++ (⟨addr, true, [⟨w, v⟩]⟩ : Obj) :: l₂) m) :
    Heap.store (l₁ ++ (⟨addr, true, [⟨w, v⟩]⟩ : Obj) :: l₂) addr w v' =
      .ok (l₁ ++ (⟨addr, true, [⟨w, v'⟩]⟩ : Obj) :: l₂) := by
  have ho : (⟨addr, true, [⟨w, v⟩]⟩ : Obj) ∈ l₁ ++ (⟨addr, true, [⟨w, v⟩]⟩ : Obj) :: l₂ :=
    List.mem_append_right _ (List.mem_cons_self ..)
  have hx : (0, (⟨w, v⟩ : Cell)) ∈ offsets 0 (⟨addr, true, [⟨w, v⟩]⟩ : Obj).cells := by
    simp [Lift.Sem.offsets]
  have hc : ((⟨addr, true, [⟨w, v⟩]⟩ : Obj).get addr w).isSome := by
    have h := Obj.get_isSome_of_mem (o := (⟨addr, true, [⟨w, v⟩]⟩ : Obj))
      (x := (0, (⟨w, v⟩ : Cell))) hx
    simpa using h
  obtain ⟨hn₁, hn₂⟩ := not_mem_of_holds_split hh rfl (by
    show 0 < (⟨addr, true, [⟨w, v⟩]⟩ : Obj).size
    rw [Obj.size]
    simpa using width_bytes_pos w)
  have hothers : ∀ p ∈ l₁ ++ l₂, p.set addr w v' = p := by
    intro p hp
    rcases List.mem_append.mp hp with h | h
    · simpa using hh.set_other ho rfl hx (List.mem_append_left _ h) (fun e => hn₁ (e ▸ h)) v'
    · simpa using hh.set_other ho rfl hx (List.mem_append_right _ (List.mem_cons_of_mem _ h))
        (fun e => hn₂ (e ▸ h)) v'
  have hst := Heap.store_split hh rfl hc hothers
  rw [hst]
  simp [Obj.set, setCells]

theorem cellSet_trace1 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) (k : BitVec 8) :
    cellSet (traceCell1 t) 0 .W8 k = traceCell1 (k, t.2.1, t.2.2.1, t.2.2.2) := by
  simp [traceCell1, cellSet, Width.bytes, Cell.get]

theorem cellSet_trace2 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) (d : BitVec 8) :
    cellSet (traceCell1 t) 1 .W8 d = traceCell1 (t.1, d, t.2.2.1, t.2.2.2) := by
  simp [traceCell1, cellSet, Width.bytes, Cell.get]

theorem cellSet_trace3 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) (s : BitVec 64) :
    cellSet (traceCell1 t) 4 .W64 s = traceCell1 (t.1, t.2.1, t.2.2.1, s) := by
  simp [traceCell1, cellSet, Width.bytes, Cell.get]

theorem Heap.store_trace_set {policy : CpuPolicy} {m : DataMem} {addr : BitVec 64}
    {A B : List Cell} {t t' : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64} {l₁ l₂ : Heap} {L : Nat}
    (hA : cellsSize A = 12 * L) (r : Nat) (hr : r < 12) (w : Width) (v : w.type)
    (hrec : cellSet (traceCell1 t) r w v = traceCell1 t')
    (hcell : (cellGet (traceCell1 t) r w).isSome)
    (hh : Heap.Holds policy (l₁ ++ (⟨addr, true, A ++ traceCell1 t ++ B⟩ : Obj) :: l₂) m) :
    Heap.store (l₁ ++ (⟨addr, true, A ++ traceCell1 t ++ B⟩ : Obj) :: l₂)
        (addr + BitVec.ofNat 64 (L * 12 + r)) w v =
      .ok (l₁ ++ (⟨addr, true, A ++ traceCell1 t' ++ B⟩ : Obj) :: l₂) := by
  have hsz : cellsSize (traceCell1 t) = 12 := cellsSize_traceCell1 t
  have ho : (⟨addr, true, A ++ traceCell1 t ++ B⟩ : Obj) ∈
      l₁ ++ (⟨addr, true, A ++ traceCell1 t ++ B⟩ : Obj) :: l₂ :=
    List.mem_append_right _ (List.mem_cons_self ..)
  have hcget : (cellGet (A ++ traceCell1 t ++ B) (L * 12 + r) w).isSome := by
    rw [List.append_assoc, cellGet_append_right w (by rw [hA]; omega),
      show L * 12 + r - cellsSize A = r by rw [hA]; omega]
    rw [cellGet_append_left w (by rw [hsz]; omega)]
    exact hcell
  obtain ⟨v₀, hv₀⟩ := Option.isSome_iff_exists.mp hcget
  have hc_mem : (0 + (L * 12 + r), (⟨w, v₀⟩ : Cell)) ∈ offsets 0 (A ++ traceCell1 t ++ B) :=
    mem_offsets_of_cellGet 0 hv₀
  have hget : ((⟨addr, true, A ++ traceCell1 t ++ B⟩ : Obj).get
      (addr + BitVec.ofNat 64 (L * 12 + r)) w).isSome := by
    have h := Obj.get_isSome_of_mem (o := (⟨addr, true, A ++ traceCell1 t ++ B⟩ : Obj)) hc_mem
    simpa using h
  obtain ⟨hn₁, hn₂⟩ := not_mem_of_holds_split hh rfl (by
    show 0 < (⟨addr, true, A ++ traceCell1 t ++ B⟩ : Obj).size
    rw [Obj.size_eq_cellsSize, cellsSize_append, cellsSize_append, cellsSize_traceCell1]
    omega)
  have hothers : ∀ p ∈ l₁ ++ l₂, p.set (addr + BitVec.ofNat 64 (L * 12 + r)) w v = p := by
    intro p hp
    rcases List.mem_append.mp hp with h | h
    · simpa using hh.set_other ho rfl hc_mem (List.mem_append_left _ h)
        (fun e => hn₁ (e ▸ h)) v
    · simpa using hh.set_other ho rfl hc_mem
        (List.mem_append_right _ (List.mem_cons_of_mem _ h)) (fun e => hn₂ (e ▸ h)) v
  have hset : (⟨addr, true, A ++ traceCell1 t ++ B⟩ : Obj).set
      (addr + BitVec.ofNat 64 (L * 12 + r)) w v = ⟨addr, true, A ++ traceCell1 t' ++ B⟩ := by
    have hnw := hh.noWrap _ ho
    unfold Obj.set
    simp only [↓reduceIte]
    congr 2
    have hb : 0 + cellsSize (A ++ traceCell1 t ++ B) ≤ 2 ^ 64 := by
      rw [Obj.size_eq_cellsSize,
        show (⟨addr, true, A ++ traceCell1 t ++ B⟩ : Obj).cells = A ++ traceCell1 t ++ B from rfl]
        at hnw
      omega
    have hd : 0 + (L * 12 + r) < 2 ^ 64 := by
      have h1 := cellGet_lt_size hcget
      omega
    rw [show L * 12 + r = 0 + (L * 12 + r) from (Nat.zero_add _).symm]
    rw [setCells_eq_cellSet addr w v (A ++ traceCell1 t ++ B) 0 (L * 12 + r) hb hd]
    rw [List.append_assoc, cellSet_append_right w v (by rw [hA]; omega),
      show L * 12 + r - cellsSize A = r by rw [hA]; omega,
      cellSet_append_left w v (by rw [hsz]; omega), hrec, ← List.append_assoc]
  have hst := Heap.store_split hh rfl hget hothers
  rw [hst, hset]

open Lift.Shuffler.Internal.Proposed in
theorem HeapAt_store_data {policy : CpuPolicy} {e : Layout.Env} {frame : Heap}
    {st : Lift.Shuffler.Zig.St} {T : Obj} {m : DataMem}
    (hm : Heap.Holds policy (HeapAt e frame st T) m) (i : BitVec 64)
    (hi : i.toNat < FlatShuffler.maxStackSize) (s : FlatShuffler.StackSlot) (p : BitVec 16) :
    (HeapAt e frame st T).storeB (e.data + i * 8) .W64 (Layout.slotWord s p) =
      .ok (HeapAt e frame { st with data := st.data.setIfInBounds i.toNat s, pad := st.pad.setIfInBounds i.toNat p } T) := by
  have h := Heap.store_words64_split (base := e.data) (xs := dataWords st) (l₁ := [sizeObj e st]) hm
    (by simpa [dataWords] using hi) (v := Layout.slotWord s p)
  rw [← dataWords_put st i.toNat hi s p] at h
  refine (Heap.storeB_of_store h).trans ?_
  rfl

open Lift.Shuffler.Internal.Proposed in

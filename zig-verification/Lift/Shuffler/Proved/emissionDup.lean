/-- The size of the `traceSize` field. -/
theorem size_traceSizeObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St} :
    (toObj (Lift.Shuffler.Internal.Proposed.Layout.traceSize (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).size = 8 := by

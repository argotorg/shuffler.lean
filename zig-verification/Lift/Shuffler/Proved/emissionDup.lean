    {frame : Heap} {st : Lift.Shuffler.Zig.St} {copy destination : FlatShuffler.Word}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240}
    (hm : Heap.Holds policy (objsP self data trace mapping st copy destination trace0 ++ frame) m)
    {o : Lift.Trusted.Object}
    (ho : o ∈ Lift.Shuffler.Internal.Proposed.DupStatement.objects st copy destination trace0
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping)) :

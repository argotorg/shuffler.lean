/-- The address of the `data` array. -/
theorem addr_dataObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St} :
    (toObj (Lift.Shuffler.Internal.Proposed.Layout.data (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).addr = data := by

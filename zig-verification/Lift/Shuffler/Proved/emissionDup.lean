      Lift.Shuffler.Internal.Proposed.DupStatement.envOf, Layout.size, Layout.word, toObj, toCell,
      offsets] using
      key (Layout.size (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true) st.size
        (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects])
        (by simp [toObj, toCell, Layout.size, Layout.word, offsets,
          Lift.Shuffler.Internal.Proposed.DupStatement.envOf])
  · simpa [Lift.Shuffler.Internal.Proposed.DupStatement.objects,
      Lift.Shuffler.Internal.Proposed.DupStatement.envOf, Layout.tracePtr, Layout.word, toObj, toCell,
      offsets] using
      key (Layout.tracePtr (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping)) trace
        (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects])
        (by simp [toObj, toCell, Layout.tracePtr, Layout.word, offsets,
          Lift.Shuffler.Internal.Proposed.DupStatement.envOf])
  · simpa [Lift.Shuffler.Internal.Proposed.DupStatement.objects,
      Lift.Shuffler.Internal.Proposed.DupStatement.envOf, Layout.traceSize, Layout.word, toObj, toCell,
      offsets] using
      key (Layout.traceSize (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)
        (BitVec.ofNat 64 st.trace.length)
        (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects])
        (by simp [toObj, toCell, Layout.traceSize, Layout.word, offsets,
          Lift.Shuffler.Internal.Proposed.DupStatement.envOf])
  · simpa [Lift.Shuffler.Internal.Proposed.DupStatement.objects,
      Lift.Shuffler.Internal.Proposed.DupStatement.envOf, Layout.mappingPtr, Layout.word, toObj, toCell,
      offsets] using
      key (Layout.mappingPtr (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping)) mapping
        (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects])
        (by simp [toObj, toCell, Layout.mappingPtr, Layout.word, offsets,
          Lift.Shuffler.Internal.Proposed.DupStatement.envOf])

theorem ofBytes_take_one_drop (bs : List UInt8) (k : Nat) (hk : k < bs.length) :
    Int.ofBytes ((bs.drop k).take 1) = ((bs[k]'hk).toNat : Int) := by
  have h1 : (bs.drop k).take 1 = [bs[k]'hk] := by
    rw [List.drop_eq_getElem_cons hk, List.take_succ_cons, List.take_zero]
  rw [h1]
  simp [Int.ofBytes]

theorem ofInt_toNat_toBitVec (b : UInt8) : BitVec.ofInt 8 (b.toNat : Int) = b.toBitVec := by simp

theorem toBytes_getElem_four (v : BitVec 64) {h : 4 < (Int.toBytes 8 v.toInt).length} :
    ((Int.toBytes 8 v.toInt)[4]'h).toNat = (v.extractLsb' 32 8).toNat := by
  have hlen : 4 < (Int.toBytes 8 v.toInt).length := by rw [Int.toBytes_length]; omega
  have hh := Lift.Sem.ByteLemmas.ofInt_slice_toBytes 8 v 4 1 (by decide)
  rw [ofBytes_take_one_drop _ 4 hlen, ofInt_toNat_toBitVec] at hh
  have := congrArg BitVec.toNat hh
  simpa using this

theorem ofInt_toNat_bitvec (k : BitVec 8) : BitVec.ofInt 8 (k.toNat : Int) = k := by simp

theorem slotWord_kind (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    (Lift.Shuffler.Internal.Proposed.Layout.slotWord s pad).extractLsb' 32 8 = s.kind := by
  unfold Lift.Shuffler.Internal.Proposed.Layout.slotWord
  rw [Lift.Pilot.kind_byte]
  rfl

theorem List.getElem?_flatMap_mul_add {α : Type} {g : α → List UInt8} {l : List α} {s k r : Nat}
    (hs : ∀ x, (g x).length = s) (hk : k < l.length) (hr : r < s) :
    (l.flatMap g)[k * s + r]? = (g l[k])[r]? := by
  induction l generalizing k with
  | nil => exact absurd hk (by simp)
  | cons x t ih =>
    rw [List.flatMap_cons]
    cases k with
    | zero =>
      simp only [Nat.zero_mul, Nat.zero_add]
      rw [List.getElem?_append_left (by rw [hs]; exact hr)]
      rfl
    | succ k =>
      rw [Nat.succ_mul, List.getElem?_append_right (by rw [hs]; omega), hs x,
        show k * s + s + r - s = k * s + r by omega,
        ih (by simpa using hk)]
      simp

theorem List.flatMap_map_cells {α : Type} {f : α → BitVec 64} (xs : List α) :
    ((xs.map fun x => (⟨.W64, f x⟩ : Cell)).flatMap Cell.bytes) =
      xs.flatMap (fun x => Int.toBytes 8 (f x).toInt) := by
  rw [List.map_eq_flatMap, List.flatMap_assoc]
  simp [Cell.bytes, Width.bytes]

theorem getElem?_data_bytes' (xs : List (BitVec 64)) (k r : Nat) (hk : k < xs.length) (hr : r < 8) :
    (List.flatMap (fun c : Cell => Int.toBytes c.w.bytes c.v.toInt)
        (List.map (fun x => (⟨.W64, x⟩ : Cell)) xs))[k * 8 + r]?
      = ((Int.toBytes 8 (xs[k]).toInt)[r]?) := by
  have e : List.flatMap (fun c : Cell => Int.toBytes c.w.bytes c.v.toInt)
      (List.map (fun x => (⟨.W64, x⟩ : Cell)) xs)
      = List.flatMap Cell.bytes (List.map (fun x => (⟨.W64, x⟩ : Cell)) xs) := rfl
  rw [e, List.flatMap_map_cells]
  exact List.getElem?_flatMap_mul_add (fun x => Int.toBytes_length _ _) hk hr


theorem data_bytes_kind (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (hc : copy.toNat < FlatShuffler.maxStackSize) :
    (toObj (Lift.Shuffler.Internal.Proposed.Layout.data
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).bytes[8 * copy.toNat + 4]!.toNat
      = (FlatShuffler.Flat.get st.data copy).kind.toNat := by
  have hbytes : (toObj (Lift.Shuffler.Internal.Proposed.Layout.data
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).bytes
      = List.flatMap (fun c : Cell => Int.toBytes c.w.bytes c.v.toInt)
          (List.map (fun x => (⟨.W64, x⟩ : Cell))
            (List.map (fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord
                (st.data.toList.getD i default) (st.pad.toList.getD i 0))
              (List.range FlatShuffler.maxStackSize))) := by
    simp only [Obj.bytes, toObj, Lift.Shuffler.Internal.Proposed.Layout.data, List.map_map,
      Function.comp_def, toCell]
  rw [hbytes]
  have hmax : FlatShuffler.maxStackSize = 1024 := rfl
  have hlen : copy.toNat < (List.map (fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord
      (st.data.toList.getD i default) (st.pad.toList.getD i 0))
      (List.range FlatShuffler.maxStackSize)).length := by
    rw [List.length_map, List.length_range, hmax]; exact hc
  have h1 := getElem?_data_bytes' (List.map (fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord
      (st.data.toList.getD i default) (st.pad.toList.getD i 0))
      (List.range FlatShuffler.maxStackSize)) copy.toNat 4 hlen (by decide)
  have h2 : (List.map (fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord
      (st.data.toList.getD i default) (st.pad.toList.getD i 0))
      (List.range FlatShuffler.maxStackSize))[copy.toNat]
      = Lift.Shuffler.Internal.Proposed.Layout.slotWord
        (st.data.toList.getD copy.toNat default) (st.pad.toList.getD copy.toNat 0) := by
    simp only [List.getElem_map, List.getElem_range]
  rw [getElem!_def, show 8 * copy.toNat + 4 = copy.toNat * 8 + 4 by omega, h1, h2]
  have h4 : 4 < (Int.toBytes 8 (Lift.Shuffler.Internal.Proposed.Layout.slotWord
      (st.data.toList.getD copy.toNat default) (st.pad.toList.getD copy.toNat 0)).toInt).length := by
    rw [Int.toBytes_length]; omega
  rw [List.getElem?_eq_getElem h4]
  simp only [Option.getD_some]
  rw [toBytes_getElem_four, slotWord_kind]
  rw [FlatShuffler.Flat.get, dif_pos (by rw [hmax]; exact hc)]
  have hvl : st.data.toList.length = FlatShuffler.maxStackSize := by simp
  have hgl : st.data.toList.getD copy.toNat default = st.data.toList[copy.toNat]'(
      by rw [hvl, hmax]; exact hc) := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by rw [hvl, hmax]; exact hc)]
    rfl
  rw [hgl, Vector.getElem_toList]

theorem List.exists_findSome?_of_mem {α β : Type} {f : α → Option β} {a : α} {b : β}
    {l : List α} (ha : a ∈ l) (hb : f a = some b) : ∃ c, l.findSome? f = some c := by
  induction l with
  | nil => exact absurd ha (by simp)
  | cons x t ih =>
    rw [List.mem_cons] at ha
    rcases ha with rfl | ha
    · exact ⟨b, by simp [hb]⟩
    · obtain ⟨c, hc⟩ := ih ha
      rw [List.findSome?_cons]
      cases hfx : f x with
      | some d => exact ⟨d, rfl⟩
      | none => exact ⟨c, hc⟩

theorem toNat_sub_eq (a b : BitVec 64) (h : b.toNat ≤ a.toNat) :
    (a - b).toNat = a.toNat - b.toNat := by
  rw [BitVec.toNat_sub]
  have := a.isLt; have := b.isLt
  omega

theorem spans_byte_index {o : Obj} {a : BitVec 64} (hsp : o.Spans a .W8) :
    (a - o.addr).toNat < o.bytes.length := by
  rw [o.bytes_length, toNat_sub_eq a o.addr hsp.1]
  rw [Obj.Spans] at hsp
  have hw : Width.W8.bytes = 1 := rfl
  rw [hw] at hsp
  omega

/-- Two objects of a heap that the memory holds agree on a byte that both span. -/
theorem Obj.getElem!_eq_of_contains {m : DataMem} {o o' : Obj}
    (h1 : m.Contains o.addr o.bytes) (h2 : m.Contains o'.addr o'.bytes)
    {a : BitVec 64} (hsp1 : o.Spans a .W8) (hsp2 : o'.Spans a .W8) :
    o.bytes[(a - o.addr).toNat]! = o'.bytes[(a - o'.addr).toNat]! := by
  have hk1 := spans_byte_index hsp1
  have hk2 := spans_byte_index hsp2
  have e1 := Mem.Contains.loadInt h1 hk1
  have e2 := Mem.Contains.loadInt h2 hk2
  rw [e1] at e2
  have h : ((o.bytes[(a - o.addr).toNat]!).toNat : Int)
      = ((o'.bytes[(a - o'.addr).toNat]!).toNat : Int) := Option.some.inj e2
  exact UInt8.toNat_inj.mp (Int.ofNat.inj h)

/-- The `loadB` at a byte that an object of a heap that the memory holds spans. -/
theorem Heap.loadB_byte_of_spans {policy : CpuPolicy} {h : Heap} {m : DataMem}
    (hh : h.Holds policy m) {o : Obj} (ho : o ∈ h) {a : BitVec 64} (hsp : o.Spans a .W8) :
    h.loadB a .W8 = .ok (BitVec.ofInt 8 (o.bytes[(a - o.addr).toNat]!.toNat : Int)) := by
  have hc := hh.contains ho
  have hk := spans_byte_index hsp
  have hli := Mem.Contains.loadInt hc hk
  have hoff : a.toNat - o.addr.toNat = (a - o.addr).toNat := (toNat_sub_eq a o.addr hsp.1).symm
  have hlb : o.loadBytes a .W8
      = some (BitVec.ofInt 8 (o.bytes[(a - o.addr).toNat]!.toNat : Int)) := by
    unfold Obj.loadBytes
    rw [ite_eq_left hsp, hoff, ofBytes_take_one_drop _ _ hk, getElem!_pos o.bytes _ hk]
  unfold Heap.loadB
  split
  · rename_i w hw
    have hs := Heap.load_sound hh hw
    unfold readRam at hs
    split at hs
    · split at hs
      · rename_i y hy
        cases hs
        rw [hli] at hy
        rw [Option.some.inj hy]
      · cases hs
    · cases hs
  · obtain ⟨c, hfc⟩ := List.exists_findSome?_of_mem (f := fun o => o.loadBytes a .W8) ho hlb
    obtain ⟨o', ho', hf'⟩ := List.exists_of_findSome?_eq_some hfc
    obtain ⟨k', ha', hk', hcv⟩ := Obj.loadBytes_spec hf'
    have hno := hh.noWrap o' ho'
    have hsz : o'.size = o'.bytes.length := o'.bytes_length.symm
    have hw8 : Width.W8.bytes = 1 := rfl
    have hk64 : k' < 2 ^ 64 := by rw [hw8] at hk'; omega
    have hsp' : o'.Spans a .W8 := by
      rw [Obj.Spans, ha', hw8]
      constructor
      · rw [toNat_add_ofNat _ _ (by omega)]; omega
      · rw [toNat_add_ofNat _ _ (by omega)]; omega
    have hk'' : k' < o'.bytes.length := by rw [hw8] at hk'; omega
    have hidx : (a - o'.addr).toNat = k' := by
      rw [ha']
      have e : o'.addr + BitVec.ofNat 64 k' - o'.addr = BitVec.ofNat 64 k' := by bv_omega
      rw [e, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hk64]
    have hcv' : c = BitVec.ofInt 8 (o'.bytes[k']!.toNat : Int) := by
      rw [hcv]
      show BitVec.ofInt 8 (Int.ofBytes (List.take 1 (List.drop k' o'.bytes)))
        = BitVec.ofInt 8 (o'.bytes[k']!.toNat : Int)
      rw [ofBytes_take_one_drop _ _ hk'', getElem!_pos o'.bytes _ hk'']
    have heq := Obj.getElem!_eq_of_contains hc (hh.contains ho') hsp hsp'
    rw [hidx] at heq
    rw [hfc, hcv', heq]

/-- A load of a cell of an object of a heap is `ok`. -/
theorem Heap.load_ok_of_mem_get {h : Heap} {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width}
    {v : w.type} (hg : o.get a w = some v) : ∃ v', h.load a w = .ok v' := by
  obtain ⟨v', hv'⟩ := List.exists_findSome?_of_mem (f := fun o => o.get a w) ho hg
  exact ⟨v', by unfold Heap.load; rw [hv']⟩

/-- A `loadB` of a cell of an object of a heap is `ok`. -/
theorem Heap.loadB_ok_of_mem_get {h : Heap} {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width}
    {v : w.type} (hg : o.get a w = some v) : ∃ v', h.loadB a w = .ok v' := by
  obtain ⟨v', hv'⟩ := Heap.load_ok_of_mem_get ho hg
  exact ⟨v', by unfold Heap.loadB; rw [hv']⟩

/-- A store of a cell of a writable object of a heap is `ok`. -/
theorem Heap.storeB_ok_of_mem_get {h : Heap} {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width}
    {v : w.type} (hw : o.writable = true) (hg : o.get a w = some v) :
    ∃ h', h.storeB a w v = .ok h' := by
  have hc : h.any (fun o => o.writable && (o.get a w).isSome) = true :=
    List.any_eq_true.mpr ⟨o, ho, by simp [hw, hg]⟩
  refine ⟨h.map (Obj.set a w v), Heap.storeB_of_store ?_⟩
  unfold Heap.store
  rw [if_pos hc]

/-- The cell of a one-cell object at its own address. -/
theorem Obj.get_self (addr : BitVec 64) (wr : Bool) (w : Width) (v : w.type) :
    (⟨addr, wr, [⟨w, v⟩]⟩ : Obj).get addr w = some v := by
  unfold Obj.get
  simp [offsets, Cell.get]

/-- A `storeB` at a cell of a writable object of the heap: the new heap is the map of `Obj.set`. -/
theorem Heap.storeB_eq_map {h : Heap} {a : BitVec 64} {w : Width} {v : w.type}
    (hc : h.any (fun o => o.writable && (o.get a w).isSome) = true) :
    h.storeB a w v = .ok (h.map (Obj.set a w v)) := by
  have hs : h.store a w v = .ok (h.map (Obj.set a w v)) := by
    unfold Heap.store
    rw [if_pos hc]
  exact Heap.storeB_of_store hs

/-- A `storeB` at a cell of a writable object of the heap: the new heap is the map of `Obj.set`. -/
theorem Heap.storeB_eq_map_of_mem {h : Heap} {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width}
    {v : w.type} (hw : o.writable = true) (hg : o.get a w = some v) :
    h.storeB a w v = .ok (h.map (Obj.set a w v)) :=
  Heap.storeB_eq_map (List.any_eq_true.mpr ⟨o, ho, by simp [hw, hg]⟩)

open Lift.P2.Total Lift.Sem Lift.Sem.Bridge Lift.Shuffler.Internal.Proposed in

/-- The kind byte of the slot at `copy` of the data array, read by the byte fallback of `loadB` at
`data + 8 * copy + 4`. -/
theorem loadB_kind (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (policy : CpuPolicy) (m : DataMem)
    (hm : Heap.Holds policy (objsP self data trace mapping st copy destination trace0 ++ frame) m)
    (hc : copy.toNat < FlatShuffler.maxStackSize) :
    (objsP self data trace mapping st copy destination trace0 ++ frame).loadB
      (data + copy * 8 + 4) .W8 = .ok (FlatShuffler.Flat.get st.data copy).kind := by
  have hd : toObj (Lift.Shuffler.Internal.Proposed.Layout.data
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)
      ∈ objsP self data trace mapping st copy destination trace0 ++ frame := by
    rw [objsP]
    exact List.mem_append_left _ (List.mem_map_of_mem
      (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects]))
  have hno := hm.noWrap _ hd
  have hsz : (toObj (Lift.Shuffler.Internal.Proposed.Layout.data
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).size = 8192 := by
    rw [size_toObj]
    simp only [Lift.Trusted.Object.size, Lift.Shuffler.Internal.Proposed.Layout.data, List.map_map,
      Function.comp_def, Width.bytes, Lift.Sem.sum_map_const, List.length_range]
    decide
  have haddr : (toObj (Lift.Shuffler.Internal.Proposed.Layout.data
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).addr = data := rfl
  have hno' : data.toNat + 8192 ≤ 2 ^ 64 := by rw [haddr, hsz] at hno; exact hno
  have hmax : FlatShuffler.maxStackSize = 1024 := rfl
  have hc1024 : copy.toNat < 1024 := by rw [hmax] at hc; exact hc
  have hidx : ((data + copy * 8 + 4) - (toObj (Lift.Shuffler.Internal.Proposed.Layout.data
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).addr).toNat
      = 8 * copy.toNat + 4 := by
    rw [haddr]
    have e1 : data + copy * 8 + 4 - data = copy * 8 + 4 := by bv_omega
    rw [e1]
    bv_omega
  have hsp : (toObj (Lift.Shuffler.Internal.Proposed.Layout.data
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).Spans
      (data + copy * 8 + 4) .W8 := by
    rw [Obj.Spans, haddr, hsz]
    have hw : Width.W8.bytes = 1 := rfl
    rw [hw]
    have eadd : data + copy * 8 + 4 = data + BitVec.ofNat 64 (8 * copy.toNat + 4) := by bv_omega
    constructor
    · rw [eadd, toNat_add_ofNat _ _ (by omega)]; omega
    · rw [eadd, toNat_add_ofNat _ _ (by omega)]; omega
  rw [Heap.loadB_byte_of_spans hm hd hsp, hidx,
    data_bytes_kind self data trace mapping frame st copy destination trace0 hc, ofInt_toNat_bitvec]

open Lift.P2.Total Lift.Sem Lift.Sem.Bridge Lift.Shuffler.Internal.Proposed in
/-- The kind of the slot is the function return label when the shifted word is `3 <<< 32`. -/
theorem kind_eq_of_shift (k : BitVec 8)
    (h : UInt64.ofBitVec (BitVec.zeroExtend 64 k) <<< (32 : UInt64) = 12884901888) :
    k = FlatShuffler.FunctionReturnLabel := by
  have hb := congrArg UInt64.toBitVec h
  simp only [UInt64.toBitVec_shiftLeft, UInt64.toBitVec_ofNat, FlatShuffler.FunctionReturnLabel] at hb ⊢
  bv_decide

/-- The converse: the function return label gives the shifted word `3 <<< 32`. -/
theorem shift_of_kind (k : BitVec 8) (h : k = FlatShuffler.FunctionReturnLabel) :
    UInt64.ofBitVec (BitVec.zeroExtend 64 k) <<< (32 : UInt64) = 12884901888 := by
  subst h
  decide

/-- The low 16 bits of the `rax` of the assertion paths of `dup`: `(v &&& mask) ||| 1` is `1`. -/
theorem rax_low (v : BitVec 64) :
    (({ toBitVec := v } &&& 18446744073709486080) ||| (1 &&& 65535) : UInt64).toBitVec.setWidth 16 = (1 : BitVec 16) := by
  simp only [UInt64.toBitVec_and, UInt64.toBitVec_or, UInt64.toBitVec_ofNat]
  bv_decide

attribute [heap_field] List.length_range List.getElem_range List.getElem_map FlatShuffler.maxStackSize
  Vector.length_toList

/-- The cells of an array built as `List.map` of `List.map` are a `flatMap` of one cell per element,
the shape that `cellGet_flatMap` computes. -/
theorem cells_map_map {α β : Type} (f : α → β) (g : β → Cell) (l : List α) :
    List.map g (List.map f l) = l.flatMap (fun x => [g (f x)]) := by
  rw [List.map_eq_flatMap, List.map_eq_flatMap, List.flatMap_assoc]
  simp

theorem cellGet_map_cell {α : Type} (xs : List α) (f : α → BitVec 64) (k : Nat) (hk : k < xs.length) :
    cellGet (xs.map fun x => (⟨.W64, f x⟩ : Cell)) (8 * k) .W64 = some (f (xs[k])) := by
  induction xs generalizing k with
  | nil => simp at hk
  | cons x t ih =>
    cases k with
    | zero => simp [cellGet, Cell.get]
    | succ k =>
      have hk' : k < t.length := by simpa using hk
      simp only [List.map_cons]
      rw [show 8 * (k + 1) = 8 * k + 8 by omega]
      rw [cellGet_cons_ge (c := (⟨.W64, f x⟩ : Cell))
        (cs := t.map fun x => (⟨.W64, f x⟩ : Cell)) (d := 8 * k + 8) .W64 (by simp)]
      rw [show 8 * k + 8 - 8 = 8 * k by omega, ih k hk']
      simp

theorem arr_get_isSome {α : Type} (base : BitVec 64) (wr : Bool) (xs : List α) (f : α → BitVec 64)
    (k : Nat) (hk : k < xs.length) :
    ((⟨base, wr, xs.map fun x => (⟨.W64, f x⟩ : Cell)⟩ : Obj).get
      (base + BitVec.ofNat 64 (8 * k)) .W64).isSome = true := by
  rw [Obj.get_isSome_iff]
  refine ⟨(8 * k, (⟨.W64, f (xs[k])⟩ : Cell)), ?_, ?_, rfl⟩
  · simpa using mem_offsets_of_cellGet 0 (cellGet_map_cell xs f k hk)
  · simp

theorem word_get_isSome (addr : BitVec 64) (wr : Bool) (v : BitVec 64) :
    ((⟨addr, wr, [⟨.W64, v⟩]⟩ : Obj).get addr .W64).isSome = true := by
  simp [Obj.get_self]

/-- The cells of two lists with the same widths have the same offsets and the same widths. -/
theorem offsets_widths {cs cs' : List Cell} (h : cs'.map (fun c => c.w) = cs.map (fun c => c.w)) (n : Nat) :
    (offsets n cs').map (fun x => (x.1, x.2.w)) = (offsets n cs).map (fun x => (x.1, x.2.w)) := by
  induction cs' generalizing cs n with
  | nil => cases cs with
    | nil => rfl
    | cons c t => simp at h
  | cons c' t' ih =>
    cases cs with
    | nil => simp at h
    | cons c t =>
      simp only [List.map_cons, List.cons.injEq] at h
      obtain ⟨hw, htl⟩ := h
      simp only [offsets, List.map_cons, List.cons.injEq]
      refine ⟨by rw [hw], ?_⟩
      rw [show n + c'.w.bytes = n + c.w.bytes by rw [hw]]
      exact ih htl (n + c.w.bytes)

/-- Two objects with the same address, writability and cell widths: a cell of one is a cell of the other. -/
def ObjShape (o o' : Obj) : Prop :=
  o'.addr = o.addr ∧ o'.writable = o.writable ∧
    o'.cells.map (fun c => c.w) = o.cells.map (fun c => c.w)

theorem Obj.get_isSome_of_shape {o o' : Obj} (h : ObjShape o o') {a : BitVec 64} {w : Width}
    (hg : (o.get a w).isSome = true) : (o'.get a w).isSome = true := by
  obtain ⟨ha, hw, hc⟩ := h
  rw [Obj.get_isSome_iff] at hg ⊢
  obtain ⟨x, hx, hx1, hx2⟩ := hg
  have hmap := offsets_widths hc 0
  have hm : (x.1, x.2.w) ∈ (offsets 0 o'.cells).map (fun y => (y.1, y.2.w)) := by
    rw [hmap]; exact List.mem_map_of_mem hx
  obtain ⟨x', hx', hx'eq⟩ := List.mem_map.mp hm
  obtain ⟨hfst, hsnd⟩ := (Prod.mk.injEq ..).mp hx'eq
  exact ⟨x', hx', by rw [ha, ← hx1, hfst], by rw [hsnd, hx2]⟩

theorem setCells_map_width (base a : BitVec 64) (w : Width) (v : w.type) (n : Nat) (cs : List Cell) :
    (setCells base a w v n cs).map (fun c => c.w) = cs.map (fun c => c.w) := by
  induction cs generalizing n with
  | nil => rfl
  | cons c cs ih =>
    simp only [setCells, List.map_cons]
    split
    · rename_i h1
      simp only [h1.2]
      rw [ih]
    · rw [ih]

theorem Obj.shape_set (o : Obj) (a : BitVec 64) (w : Width) (v : w.type) : ObjShape o (o.set a w v) := by
  unfold Obj.set
  split
  · exact ⟨rfl, rfl, setCells_map_width o.addr a w v 0 o.cells⟩
  · exact ⟨rfl, rfl, rfl⟩

theorem cellsOfBytes_map_width (bs : List UInt8) (cs : List Cell) :
    (cellsOfBytes bs cs).map (fun c => c.w) = cs.map (fun c => c.w) := by
  induction cs generalizing bs with
  | nil => rfl
  | cons c cs ih =>
    simp only [cellsOfBytes, List.map_cons]
    rw [ih]

theorem Obj.shape_setBytes (o : Obj) (a : BitVec 64) (w : Width) (v : w.type) :
    ObjShape o (o.setBytes a w v) := by
  unfold Obj.setBytes
  split
  · exact ⟨rfl, rfl, cellsOfBytes_map_width _ _⟩
  · exact ⟨rfl, rfl, rfl⟩

/-- A heap whose objects have the same addresses, writability and cell widths as those of another. -/
def HeapShape (h h' : Heap) : Prop := ∀ o ∈ h, ∃ o' ∈ h', ObjShape o o'

theorem HeapShape.refl (h : Heap) : HeapShape h h := fun o ho => ⟨o, ho, rfl, rfl, rfl⟩

theorem HeapShape.trans {h₁ h₂ h₃ : Heap} (h : HeapShape h₁ h₂) (h' : HeapShape h₂ h₃) : HeapShape h₁ h₃ := by
  intro o ho
  obtain ⟨o₂, ho₂, ha, hw, hc⟩ := h o ho
  obtain ⟨o₃, ho₃, ha', hw', hc'⟩ := h' o₂ ho₂
  exact ⟨o₃, ho₃, ha'.trans ha, hw'.trans hw, hc'.trans hc⟩

theorem HeapShape.map {h : Heap} {f : Obj → Obj} (hf : ∀ o, ObjShape o (f o)) : HeapShape h (h.map f) := by
  intro o ho
  exact ⟨f o, List.mem_map_of_mem ho, hf o⟩

theorem Heap.storeB_ok_cases {h h' : Heap} {a : BitVec 64} {w : Width} {v : w.type}
    (hs : Heap.storeB h a w v = .ok h') :
    h' = h.map (Obj.set a w v) ∨ h' = h.map (Obj.setBytes a w v) := by
  unfold Heap.storeB Heap.store at hs
  split at hs
  · split at hs
    · exact Or.inl (Res.ok.inj hs).symm
    · cases hs
  · split at hs
    · exact Or.inr (Res.ok.inj hs).symm
    · split at hs <;> cases hs

theorem HeapShape.storeB {h h' : Heap} {a : BitVec 64} {w : Width} {v : w.type}
    (hs : Heap.storeB h a w v = .ok h') : HeapShape h h' := by
  rcases Heap.storeB_ok_cases hs with rfl | rfl
  · exact HeapShape.map (fun o => Obj.shape_set o a w v)
  · exact HeapShape.map (fun o => Obj.shape_setBytes o a w v)

theorem Heap.load_ok_of_mem_isSome {h : Heap} {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width}
    (hg : (o.get a w).isSome = true) : ∃ v, Heap.load h a w = .ok v := by
  unfold Heap.load
  cases hf : h.findSome? (fun o => o.get a w) with
  | some v => exact ⟨v, rfl⟩
  | none =>
    rw [List.findSome?_eq_none_iff] at hf
    rw [hf o ho] at hg
    cases hg

theorem Heap.storeB_ok_of_mem_isSome {h : Heap} {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width}
    (hw : o.writable = true) (hg : (o.get a w).isSome = true) (v : w.type) :
    ∃ h', Heap.storeB h a w v = .ok h' := by
  have h1 : (h.any fun o => (o.get a w).isSome) = true := List.any_eq_true.mpr ⟨o, ho, hg⟩
  have h2 : (h.any fun o => o.writable && (o.get a w).isSome) = true :=
    List.any_eq_true.mpr ⟨o, ho, by rw [hw, hg]; rfl⟩
  refine ⟨h.map (Obj.set a w v), ?_⟩
  unfold Heap.storeB Heap.store
  rw [h1, h2]
  rfl

theorem Heap.storeB_ok_of_shape {h₀ h : Heap} (hss : HeapShape h₀ h) {o : Obj} (ho : o ∈ h₀)
    {a : BitVec 64} {w : Width} (hw : o.writable = true) (hg : (o.get a w).isSome = true)
    (v : w.type) : ∃ h', Heap.storeB h a w v = .ok h' := by
  obtain ⟨o', ho', ha, hw', hc⟩ := hss o ho
  exact Heap.storeB_ok_of_mem_isSome ho' (hw'.trans hw) (Obj.get_isSome_of_shape ⟨ha, hw', hc⟩ hg) v

theorem Heap.loadB_ok_of_shape {h₀ h : Heap} (hss : HeapShape h₀ h) {o : Obj} (ho : o ∈ h₀)
    {a : BitVec 64} {w : Width} (hg : (o.get a w).isSome = true) : ∃ v, Heap.loadB h a w = .ok v := by
  obtain ⟨o', ho', ha, hw', hc⟩ := hss o ho
  obtain ⟨v, hv⟩ := Heap.load_ok_of_mem_isSome ho' (Obj.get_isSome_of_shape ⟨ha, hw', hc⟩ hg)
  exact ⟨v, Heap.loadB_of_load hv⟩

theorem cellsSize_record (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) :
    cellsSize [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] = 12 := by
  simp [cellsSize, Width.bytes]

theorem cellGet_record (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) :
    cellGet [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] 4 .W64
      = some t.2.2.2 := by
  rw [cellGet_cons_ge (c := (⟨.W8, t.1⟩ : Cell)) (d := 4) .W64 (by simp)]
  rw [show 4 - 1 = 3 by omega]
  rw [cellGet_cons_ge (c := (⟨.W8, t.2.1⟩ : Cell)) (d := 3) .W64 (by simp)]
  rw [show 3 - 1 = 2 by omega]
  rw [cellGet_cons_ge (c := (⟨.W16, t.2.2.1⟩ : Cell)) (d := 2) .W64 (by simp)]
  rw [show 2 - 2 = 0 by omega, cellGet_cons_zero]
  simp [Cell.get]

/-- The cells of the trace object are one record per entry of `trace0`. -/
theorem trace_cells (trace : BitVec 64) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    (toObj (⟨trace, trace0.toList.flatMap (fun t =>
      [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩ :
        Lift.Trusted.Object)).cells
      = trace0.toList.flatMap (fun t =>
        [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]) := by
  simp only [toObj, List.map_flatMap, toCell, List.map_cons, List.map_nil]

theorem trace_get_isSome (trace : BitVec 64)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (k : Nat) (hk : k < 10240) :
    ((toObj (⟨trace, trace0.toList.flatMap (fun t =>
      [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩ :
        Lift.Trusted.Object)).get (trace + BitVec.ofNat 64 (12 * k + 4)) .W64).isSome = true := by
  have hlen : k < trace0.toList.length := by simpa using hk
  have hrec : cellGet (trace0.toList.flatMap (fun t =>
      [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩])) (12 * k + 4) .W64
      = some (trace0.toList[k]).2.2.2 := by
    rw [show 12 * k + 4 = k * 12 + 4 by omega]
    rw [cellGet_flatMap .W64 (s := 12) (fun t => cellsSize_record t) hlen (by decide)]
    exact cellGet_record _
  have hobj : toObj (⟨trace, trace0.toList.flatMap (fun t =>
      [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩ :
        Lift.Trusted.Object)
      = ⟨trace, true, trace0.toList.flatMap (fun t =>
        [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩])⟩ := by
    simp only [toObj, List.map_flatMap, toCell, List.map_cons, List.map_nil]
  rw [hobj, Obj.get_isSome_iff]
  refine ⟨(12 * k + 4, (⟨.W64, (trace0.toList[k]).2.2.2⟩ : Cell)), ?_, ?_, rfl⟩
  · simpa using mem_offsets_of_cellGet 0 hrec
  · simp


/-- Two different objects of a heap that a memory holds are apart. -/
theorem Holds.apart_of_mem {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : Heap.Holds policy h m)
    {o o' : Obj} (ho : o ∈ h) (ho' : o' ∈ h) (hne : o ≠ o') (hw : o.writable = true) :
    o.Apart o' := by
  have sym : ∀ {a b : Obj}, ((a.writable ∨ b.writable) → a.Apart b) →
      ((b.writable ∨ a.writable) → b.Apart a) := by
    intro a b hab hba
    rcases hab hba.symm with h1 | h1
    · exact Or.inr h1
    · exact Or.inl h1
  exact pairwise_of_mem sym hh.apart ho ho' hne (Or.inl hw)

/-- The cells of two apart objects have different addresses. -/
theorem Obj.Apart.add_ne {o o' : Obj} (h : o.Apart o') {i j : Nat} (hi : i < o.size)
    (hj : j < o'.size) (h1 : o.addr.toNat + o.size ≤ 2 ^ 64) (h2 : o'.addr.toNat + o'.size ≤ 2 ^ 64) :
    o.addr + BitVec.ofNat 64 i ≠ o'.addr + BitVec.ofNat 64 j := by
  intro he
  have e := congrArg BitVec.toNat he
  rw [toNat_add_ofNat _ _ (by omega), toNat_add_ofNat _ _ (by omega)] at e
  rcases h with h | h <;> omega

theorem size_word (p : BitVec 64) (wr : Bool) (v : BitVec 64) :
    (toObj (⟨p, [⟨.W64, v⟩], wr⟩ : Lift.Trusted.Object)).size = 8 := by
  simp [Obj.size, toObj, toCell]

theorem size_arr (base : BitVec 64) (wr : Bool) (l : List (BitVec 64)) :
    (toObj (⟨base, l.map fun v => (⟨.W64, v⟩ : Lift.Trusted.Field), wr⟩ :
      Lift.Trusted.Object)).size = l.length * 8 := by
  rw [Obj.size,
    show (toObj (⟨base, l.map fun v => (⟨.W64, v⟩ : Lift.Trusted.Field), wr⟩ :
      Lift.Trusted.Object)).cells = l.map fun v => (⟨.W64, v⟩ : Cell) from by
      simp only [toObj, List.map_map, Function.comp_def, toCell]]
  rw [List.map_map]
  rw [show ((fun c : Cell => c.w.bytes) ∘ (fun v => (⟨.W64, v⟩ : Cell))) = (fun _ => 8) from by
    funext v
    rfl]
  rw [sum_map_const]

theorem size_trace (trace : BitVec 64) (wr : Bool)
    (l : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)) :
    (toObj (⟨trace, l.flatMap fun t =>
      [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩], wr⟩ :
      Lift.Trusted.Object)).size = l.length * 12 := by
  rw [Obj.size_eq_cellsSize,
    show (toObj (⟨trace, l.flatMap fun t =>
      [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩], wr⟩ :
      Lift.Trusted.Object)).cells
      = l.flatMap (fun t =>
        [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]) from by
      simp only [toObj, List.map_flatMap, toCell, List.map_cons, List.map_nil]]
  rw [cellsSize_flatMap,
    show (l.map fun t => cellsSize [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩])
      = l.map fun _ => 12 from by
      apply List.map_congr_left
      intro t _
      exact cellsSize_record t,
    sum_map_const]

theorem setCells_eq_self {base a : BitVec 64} {w : Width} {v : w.type} (n : Nat) (cs : List Cell)
    (h : ∀ x ∈ offsets n cs, base + BitVec.ofNat 64 x.1 ≠ a) : setCells base a w v n cs = cs := by
  induction cs generalizing n with
  | nil => rfl
  | cons c cs ih =>
    simp only [setCells]
    rw [if_neg]
    · rw [ih]
      intro x hx
      exact h x (by simp only [offsets, List.mem_cons]; exact Or.inr hx)
    · intro hc
      exact h (n, c) (by simp [offsets]) hc.1

theorem Obj.set_eq_self {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (h : ∀ x ∈ offsets 0 o.cells, o.addr + BitVec.ofNat 64 x.1 ≠ a) : o.set a w v = o := by
  unfold Obj.set
  split
  · congr 1
    exact setCells_eq_self 0 o.cells h
  · rfl

/-- A store at a cell of another object, one that is apart, does not change the object. -/
theorem Obj.set_eq_self_of_apart {o o' : Obj} (h : o.Apart o') {j : Nat} (hj : j < o'.size)
    (h1 : o.addr.toNat + o.size ≤ 2 ^ 64) (h2 : o'.addr.toNat + o'.size ≤ 2 ^ 64) (w : Width)
    (v : w.type) : o.set (o'.addr + BitVec.ofNat 64 j) w v = o := by
  apply Obj.set_eq_self
  intro x hx
  have hx2 : x.1 + x.2.w.bytes ≤ o.size := by
    show x.1 + x.2.w.bytes ≤ (o.cells.map fun c => c.w.bytes).sum
    simpa using (offsets_bound hx).2
  have hp := width_bytes_pos x.2.w
  exact Obj.Apart.add_ne h (by omega) hj h1 h2

theorem objsP_mem {self data trace mapping : BitVec 64} {frame : Heap} {st : Lift.Shuffler.Zig.St}
    {copy destination : FlatShuffler.Word}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240} {o : Lift.Trusted.Object}
    (ho : o ∈ Lift.Shuffler.Internal.Proposed.DupStatement.objects st copy destination trace0
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping)) :
    toObj o ∈ objsP self data trace mapping st copy destination trace0 ++ frame := by
  simp only [objsP, List.mem_append]
  exact Or.inl (List.mem_map_of_mem ho)

theorem objsP_size_cell (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    ∃ o ∈ objsP self data trace mapping st copy destination trace0 ++ frame,
      o.writable = true ∧ (o.get (self + 48) .W64).isSome = true :=
  ⟨toObj (Lift.Shuffler.Internal.Proposed.Layout.size
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true),
    objsP_mem (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects]), rfl,
    word_get_isSome _ _ _⟩

theorem objsP_traceSize_cell (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    ∃ o ∈ objsP self data trace mapping st copy destination trace0 ++ frame,
      o.writable = true ∧ (o.get (self + 64) .W64).isSome = true :=
  ⟨toObj (Lift.Shuffler.Internal.Proposed.Layout.traceSize
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true),
    objsP_mem (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects]), rfl,
    word_get_isSome _ _ _⟩

theorem objsP_dataPtr_cell (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    ∃ o ∈ objsP self data trace mapping st copy destination trace0 ++ frame,
      o.writable = false ∧ (o.get (self + 40) .W64).isSome = true :=
  ⟨toObj (Lift.Shuffler.Internal.Proposed.Layout.dataPtr
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping)),
    objsP_mem (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects]), rfl,
    word_get_isSome _ _ _⟩

theorem objsP_mappingPtr_cell (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    ∃ o ∈ objsP self data trace mapping st copy destination trace0 ++ frame,
      o.writable = false ∧ (o.get (self + 72) .W64).isSome = true :=
  ⟨toObj (Lift.Shuffler.Internal.Proposed.Layout.mappingPtr
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping)),
    objsP_mem (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects]), rfl,
    word_get_isSome _ _ _⟩

theorem objsP_data_cell (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (k : BitVec 64) (hk : k.toNat < 1024) :
    ∃ o ∈ objsP self data trace mapping st copy destination trace0 ++ frame,
      o.writable = true ∧ (o.get (data + k * 8) .W64).isSome = true := by
  refine ⟨toObj (Lift.Shuffler.Internal.Proposed.Layout.data
    (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true),
    objsP_mem (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects]), rfl, ?_⟩
  have hobj : toObj (Lift.Shuffler.Internal.Proposed.Layout.data
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)
      = (⟨data, true, (List.range FlatShuffler.maxStackSize).map (fun i =>
        (⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord
          (st.data.toList.getD i default) (st.pad.toList.getD i 0)⟩ : Cell))⟩ : Obj) := by
    simp only [toObj, Lift.Shuffler.Internal.Proposed.Layout.data, List.map_map,
      Function.comp_def, toCell, Lift.Shuffler.Internal.Proposed.DupStatement.envOf]
  rw [hobj, show data + k * 8 = data + BitVec.ofNat 64 (8 * k.toNat) by bv_omega]
  exact arr_get_isSome data true _ _ k.toNat (by simpa [FlatShuffler.maxStackSize] using hk)

theorem objsP_dest_cell (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (k : BitVec 64) (hk : k.toNat < 1024) :
    ∃ o ∈ objsP self data trace mapping st copy destination trace0 ++ frame,
      o.writable = true ∧ (o.get (mapping + k * 8) .W64).isSome = true := by
  refine ⟨toObj (Lift.Shuffler.Internal.Proposed.Layout.dest
    (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true),
    objsP_mem (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects]), rfl, ?_⟩
  have hobj : toObj (Lift.Shuffler.Internal.Proposed.Layout.dest
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)
      = (⟨mapping, true, st.dest.toList.map (fun v => (⟨.W64, v⟩ : Cell))⟩ : Obj) := by
    simp only [toObj, Lift.Shuffler.Internal.Proposed.Layout.dest, List.map_map,
      Function.comp_def, toCell, Lift.Shuffler.Internal.Proposed.DupStatement.envOf]
  rw [hobj, show mapping + k * 8 = mapping + BitVec.ofNat 64 (8 * k.toNat) by bv_omega]
  exact arr_get_isSome mapping true _ _ k.toNat (by
    rw [Vector.length_toList]; simpa [FlatShuffler.maxStackSize] using hk)

theorem objsP_pos_cell (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (k : BitVec 64) (hk : k.toNat < 1024) :
    ∃ o ∈ objsP self data trace mapping st copy destination trace0 ++ frame,
      o.writable = true ∧ (o.get (mapping + k * 8 + 8192) .W64).isSome = true := by
  refine ⟨toObj (Lift.Shuffler.Internal.Proposed.Layout.pos
    (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true),
    objsP_mem (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects]), rfl, ?_⟩
  have hobj : toObj (Lift.Shuffler.Internal.Proposed.Layout.pos
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)
      = (⟨mapping + 8192, true, st.pos.toList.map (fun v => (⟨.W64, v⟩ : Cell))⟩ : Obj) := by
    simp only [toObj, Lift.Shuffler.Internal.Proposed.Layout.pos, List.map_map,
      Function.comp_def, toCell, Lift.Shuffler.Internal.Proposed.DupStatement.envOf]
  rw [hobj, show mapping + k * 8 + 8192 = (mapping + 8192) + BitVec.ofNat 64 (8 * k.toNat) by
    bv_omega]
  exact arr_get_isSome (mapping + 8192) true _ _ k.toNat (by
    rw [Vector.length_toList]; simpa [FlatShuffler.maxStackSize] using hk)

theorem objsP_trace_cell (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (L : Nat) (hL : L < 10240) :
    ∃ o ∈ objsP self data trace mapping st copy destination trace0 ++ frame,
      o.writable = true ∧ (o.get (trace + BitVec.ofNat 64 (12 * L + 4)) .W64).isSome = true :=
  ⟨toObj (⟨trace, trace0.toList.flatMap (fun t =>
      [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩ :
      Lift.Trusted.Object),
    objsP_mem (by simp [Lift.Shuffler.Internal.Proposed.DupStatement.objects,
      Lift.Shuffler.Internal.Proposed.DupStatement.envOf]), rfl,
    trace_get_isSome trace trace0 L hL⟩

theorem Holds.apart_of_mem2 {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : Heap.Holds policy h m)
    {o o' : Obj} (ho : o ∈ h) (ho' : o' ∈ h) (hne : o ≠ o') (hw : o.writable = true ∨ o'.writable = true) :
    o.Apart o' := by
  have sym : ∀ {a b : Obj}, ((a.writable ∨ b.writable) → a.Apart b) →
      ((b.writable ∨ a.writable) → b.Apart a) := by
    intro a b hab hba
    rcases hab hba.symm with h1 | h1
    · exact Or.inr h1
    · exact Or.inl h1
  exact pairwise_of_mem sym hh.apart ho ho' hne hw

/-- A store at an address other than the cell of a one-cell object does not change it. -/
theorem Obj.set_word_ne {p a : BitVec 64} (wr : Bool) (x : BitVec 64) (w : Width) (v : w.type)
    (hne : a ≠ p) : (⟨p, wr, [⟨.W64, x⟩]⟩ : Obj).set a w v = ⟨p, wr, [⟨.W64, x⟩]⟩ := by
  apply Obj.set_eq_self
  intro y hy
  simp only [offsets, List.mem_cons, List.not_mem_nil, or_false] at hy
  subst hy
  simpa using hne.symm

/-- The one-cell objects of `h` are still in `h'`, with their values. -/
def Keeps (h h' : Heap) : Prop :=
  ∀ (p : BitVec 64) (wr : Bool) (x : BitVec 64),
    (⟨p, wr, [⟨.W64, x⟩]⟩ : Obj) ∈ h → (⟨p, wr, [⟨.W64, x⟩]⟩ : Obj) ∈ h'

theorem Keeps.refl (h : Heap) : Keeps h h := fun _ _ _ hm => hm

theorem Keeps.trans {h₁ h₂ h₃ : Heap} (h : Keeps h₁ h₂) (h' : Keeps h₂ h₃) : Keeps h₁ h₃ :=
  fun p wr x hm => h' p wr x (h p wr x hm)

theorem Keeps.storeB {h h' : Heap} {a : BitVec 64} {w : Width} {v : w.type}
    (hmap : h' = h.map (Obj.set a w v))
    (hne : ∀ p wr x, (⟨p, wr, [⟨.W64, x⟩]⟩ : Obj) ∈ h → a ≠ p) : Keeps h h' := by
  subst hmap
  intro p wr x hmem
  refine List.mem_map.mpr ⟨_, hmem, ?_⟩
  exact Obj.set_word_ne wr x w v (hne p wr x hmem)

theorem Keeps.loadB {h h' : Heap} {m : DataMem} {policy : CpuPolicy} (hh : h'.Holds policy m)
    (hk : Keeps h h') {p : BitVec 64} {wr : Bool} {x : BitVec 64}
    (hmem : (⟨p, wr, [⟨.W64, x⟩]⟩ : Obj) ∈ h) : h'.loadB p .W64 = .ok x := by
  have ho := hk p wr x hmem
  have hx : (0, (⟨.W64, x⟩ : Cell)) ∈ offsets 0 [(⟨.W64, x⟩ : Cell)] := by simp [offsets]
  have h1 := Heap.load_of_mem hh ho hx
  simpa using Heap.loadB_of_load h1

theorem Heap.store_ok_eq_of_mem_isSome {h : Heap} {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width}
    (hw : o.writable = true) (hg : (o.get a w).isSome = true) (v : w.type) :
    Heap.store h a w v = .ok (h.map (Obj.set a w v)) := by
  have h2 : (h.any fun o => o.writable && (o.get a w).isSome) = true :=
    List.any_eq_true.mpr ⟨o, ho, by rw [hw, hg]; rfl⟩
  unfold Heap.store
  rw [h2]
  rfl

theorem Heap.storeB_ok_eq_of_mem_isSome {h : Heap} {o : Obj} (ho : o ∈ h) {a : BitVec 64}
    {w : Width} (hw : o.writable = true) (hg : (o.get a w).isSome = true) (v : w.type) :
    Heap.storeB h a w v = .ok (h.map (Obj.set a w v)) := by
  have h1 : (h.any fun o => (o.get a w).isSome) = true := List.any_eq_true.mpr ⟨o, ho, hg⟩
  unfold Heap.storeB
  rw [h1]
  exact Heap.store_ok_eq_of_mem_isSome ho hw hg v

theorem Heap.storeB_holds {policy : CpuPolicy} {h h' : Heap} {m : DataMem} {a : BitVec 64}
    {w : Width} {v : w.type} (hh : h.Holds policy m) {o : Obj} (ho : o ∈ h)
    (hw : o.writable = true) (hg : (o.get a w).isSome = true)
    (hs : h.storeB a w v = .ok h') : ∃ m', h'.Holds policy m' := by
  have he := Heap.storeB_ok_eq_of_mem_isSome ho hw hg v
  rw [he] at hs
  obtain rfl := Res.ok.inj hs
  exact Heap.store_holds hh (Heap.store_ok_eq_of_mem_isSome ho hw hg v)

/-! ### The heap of the call as `HeapAt` (the objects of the statement with an abstract trace object) -/

open Lift.Shuffler.Internal.Proposed in
/-- The stack words of a state, with their padding. -/
abbrev dataWords (st : Lift.Shuffler.Zig.St) : List (BitVec 64) :=
  (List.range FlatShuffler.maxStackSize).map fun i =>
    Layout.slotWord (st.data.toList.getD i default) (st.pad.toList.getD i 0)

/-- The fields of one operation of the trace. -/
abbrev traceField1 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) : List Lift.Trusted.Field :=
  [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]

/-- The fields of the trace array of a list of operations. -/
abbrev traceFields (l : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)) : List Lift.Trusted.Field :=
  l.flatMap traceField1

/-- The cells of one operation of the trace. -/
abbrev traceCell1 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) : List Cell :=
  [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]

theorem traceFields_cells (l : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)) :
    (traceFields l).map toCell = l.flatMap traceCell1 := by
  simp [traceFields, traceField1, traceCell1, toCell, List.map_flatMap]

theorem cellsSize_traceCell1 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) :
    cellsSize (traceCell1 t) = 12 := by
  simp [traceCell1, cellsSize, Width.bytes]

/-- The cells of the `dest` array of a state. -/
def destWords (st : Lift.Shuffler.Zig.St) : List (BitVec 64) := st.dest.toList

/-- The cells of the `pos` array of a state. -/
def posWords (st : Lift.Shuffler.Zig.St) : List (BitVec 64) := st.pos.toList

open Lift.Shuffler.Internal.Proposed in
theorem toObj_data (e : Layout.Env) (st : Lift.Shuffler.Zig.St) (w : Bool) :
    toObj (Layout.data e st w) = Obj.words e.data w .W64 (dataWords st) := by
  simp only [Layout.data, toObj, toCell, Obj.words, dataWords, List.map_map, Function.comp_def]

open Lift.Shuffler.Internal.Proposed in
theorem toObj_dest (e : Layout.Env) (st : Lift.Shuffler.Zig.St) (w : Bool) :
    toObj (Layout.dest e st w) = Obj.words e.mapping w .W64 (destWords st) := by
  simp only [Layout.dest, toObj, toCell, Obj.words, destWords, List.map_map, Function.comp_def]

open Lift.Shuffler.Internal.Proposed in
theorem toObj_pos (e : Layout.Env) (st : Lift.Shuffler.Zig.St) (w : Bool) :
    toObj (Layout.pos e st w) = Obj.words (e.mapping + 8192) w .W64 (posWords st) := by
  simp only [Layout.pos, toObj, toCell, Obj.words, posWords, List.map_map, Function.comp_def]

open Lift.Shuffler.Internal.Proposed in
theorem toObj_size (e : Layout.Env) (st : Lift.Shuffler.Zig.St) (w : Bool) :
    toObj (Layout.size e st w) = ⟨e.self + 48, w, [⟨.W64, st.size⟩]⟩ := by
  simp [Layout.size, Layout.word, toObj, toCell]

open Lift.Shuffler.Internal.Proposed in
theorem toObj_traceSize (e : Layout.Env) (st : Lift.Shuffler.Zig.St) (w : Bool) :
    toObj (Layout.traceSize e st w) = ⟨e.self + 64, w, [⟨.W64, BitVec.ofNat 64 st.trace.length⟩]⟩ := by
  simp [Layout.traceSize, Layout.word, toObj, toCell]

open Lift.Shuffler.Internal.Proposed in
theorem toObj_dataPtr (e : Layout.Env) : toObj (Layout.dataPtr e) = ⟨e.self + 40, false, [⟨.W64, e.data⟩]⟩ := by
  simp [Layout.dataPtr, Layout.word, toObj, toCell]

open Lift.Shuffler.Internal.Proposed in
theorem toObj_tracePtr (e : Layout.Env) : toObj (Layout.tracePtr e) = ⟨e.self + 56, false, [⟨.W64, e.trace⟩]⟩ := by
  simp [Layout.tracePtr, Layout.word, toObj, toCell]

open Lift.Shuffler.Internal.Proposed in
theorem toObj_mappingPtr (e : Layout.Env) :
    toObj (Layout.mappingPtr e) = ⟨e.self + 72, false, [⟨.W64, e.mapping⟩]⟩ := by
  simp [Layout.mappingPtr, Layout.word, toObj, toCell]

open Lift.Shuffler.Internal.Proposed in
/-- The trace object of the statement is the trace array of `trace0`. -/
theorem traceObj0_toObj (e : Layout.Env)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    toObj (⟨e.trace, traceFields trace0.toList, true⟩ : Lift.Trusted.Object) =
      (⟨e.trace, true, trace0.toList.flatMap traceCell1⟩ : Obj) := by
  simp only [toObj, traceFields_cells]

def sizeObj (e : Lift.Shuffler.Internal.Proposed.Layout.Env) (st : Lift.Shuffler.Zig.St) : Obj :=
  ⟨e.self + 48, true, [⟨.W64, st.size⟩]⟩

def dataObj (e : Lift.Shuffler.Internal.Proposed.Layout.Env) (st : Lift.Shuffler.Zig.St) : Obj :=
  Obj.words e.data true .W64 (dataWords st)

def destObj (e : Lift.Shuffler.Internal.Proposed.Layout.Env) (st : Lift.Shuffler.Zig.St) : Obj :=
  Obj.words e.mapping true .W64 (destWords st)

def posObj (e : Lift.Shuffler.Internal.Proposed.Layout.Env) (st : Lift.Shuffler.Zig.St) : Obj :=
  Obj.words (e.mapping + 8192) true .W64 (posWords st)

def dataPtrObj (e : Lift.Shuffler.Internal.Proposed.Layout.Env) : Obj :=
  ⟨e.self + 40, false, [⟨.W64, e.data⟩]⟩

def mappingPtrObj (e : Lift.Shuffler.Internal.Proposed.Layout.Env) : Obj :=
  ⟨e.self + 72, false, [⟨.W64, e.mapping⟩]⟩

def tracePtrObj (e : Lift.Shuffler.Internal.Proposed.Layout.Env) : Obj :=
  ⟨e.self + 56, false, [⟨.W64, e.trace⟩]⟩

def traceSizeObj (e : Lift.Shuffler.Internal.Proposed.Layout.Env) (st : Lift.Shuffler.Zig.St) : Obj :=
  ⟨e.self + 64, true, [⟨.W64, BitVec.ofNat 64 st.trace.length⟩]⟩

/-- The objects of the heap of the call, in the order of `DupStatement.objects`, with an abstract
trace object `T`. -/
def HeapAt (e : Lift.Shuffler.Internal.Proposed.Layout.Env) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (T : Obj) : Heap :=
  sizeObj e st :: dataObj e st :: destObj e st :: posObj e st :: dataPtrObj e ::
    mappingPtrObj e :: tracePtrObj e :: traceSizeObj e st :: T :: frame

open Lift.Shuffler.Internal.Proposed in
/-- The heap of the call is `HeapAt` with the trace object of `trace0`. -/
theorem objsP_HeapAt (self data trace mapping : BitVec 64) (frame : Heap)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    objsP self data trace mapping st copy destination trace0 ++ frame =
      HeapAt (DupStatement.envOf self data trace mapping) frame st
        ⟨(DupStatement.envOf self data trace mapping).trace, true,
          trace0.toList.flatMap traceCell1⟩ := by
  rw [objsP, DupStatement.objects, List.map_cons, List.map_cons, List.map_cons, List.map_cons,
    List.map_cons, List.map_cons, List.map_cons, List.map_cons, List.map_cons, List.map_nil,
    traceObj0_toObj]
  simp only [HeapAt, sizeObj, dataObj, destObj, posObj, dataPtrObj, mappingPtrObj, tracePtrObj,
    traceSizeObj, toObj_size, toObj_data, toObj_dest, toObj_pos, toObj_dataPtr,
    toObj_mappingPtr, toObj_tracePtr, toObj_traceSize, List.cons_append, List.nil_append]

/-! ### The words of the arrays and the model's `get` and `put` -/

theorem List.getD_set {α : Type} (l : List α) (d : α) (k : Nat) (hk : k < l.length) (v : α)
    (i : Nat) : (l.set k v).getD i d = if i = k then v else l.getD i d := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_set]
  by_cases h : k = i
  · subst h
    simp [hk]
  · rw [if_neg h, if_neg (Ne.symm h)]

theorem List.map_set_of_nodup {α β : Type} [DecidableEq α] {l : List α} (hnd : l.Nodup) (f : α → β)
    {k : Nat} (hk : k < l.length) (v : β) :
    (l.map f).set k v = l.map fun x => if x = l[k] then v else f x := by
  induction l generalizing k with
  | nil => simp at hk
  | cons a t ih =>
    obtain ⟨hnot, hnd'⟩ := List.nodup_cons.mp hnd
    cases k with
    | zero =>
      simp only [List.map_cons, List.set_cons_zero, List.getElem_cons_zero, if_true,
        List.cons.injEq, true_and]
      apply List.map_congr_left
      intro x hx
      rw [if_neg (fun (e : x = a) => hnot (e ▸ hx))]
    | succ k =>
      have hk' : k < t.length := by simpa using hk
      have hmem : t[k] ∈ t := List.mem_iff_getElem.mpr ⟨k, hk', rfl⟩
      have hne : ¬ (a = t[k]) := fun e => hnot (e ▸ hmem)
      simp only [List.map_cons, List.set_cons_succ, List.getElem_cons_succ]
      rw [if_neg hne, ih (k := k) hnd' hk']

theorem range_map_set {β : Type} (n k : Nat) (hk : k < n) (f : Nat → β) (v : β) :
    ((List.range n).map f).set k v = (List.range n).map fun i => if i = k then v else f i := by
  rw [List.map_set_of_nodup (l := List.range n) List.nodup_range f (k := k) (by simpa using hk) v]
  apply List.map_congr_left
  intro i hi
  rw [List.getElem_range (by simpa using hk)]

open Lift.Shuffler.Internal.Proposed in
theorem dataWords_put (st : Lift.Shuffler.Zig.St) (k : Nat) (hk : k < FlatShuffler.maxStackSize)
    (s : FlatShuffler.StackSlot) (p : BitVec 16) :
    dataWords { st with data := st.data.setIfInBounds k s, pad := st.pad.setIfInBounds k p } =
      (dataWords st).set k (Layout.slotWord s p) := by
  have hk1 : k < st.data.toList.length := by simpa using hk
  have hk2 : k < st.pad.toList.length := by simpa using hk
  simp only [dataWords, Vector.toList_setIfInBounds]
  rw [range_map_set FlatShuffler.maxStackSize k hk _ (Layout.slotWord s p)]
  apply List.map_congr_left
  intro i hi
  rw [List.getD_set _ _ k hk1 s i, List.getD_set _ _ k hk2 p i]
  by_cases h : i = k
  · rw [if_pos h, if_pos h, if_pos h]
  · rw [if_neg h, if_neg h, if_neg h]

theorem destWords_put (st : Lift.Shuffler.Zig.St) (k : Nat) (v : BitVec 64) :
    destWords { st with dest := st.dest.setIfInBounds k v } = (destWords st).set k v := by
  simp [destWords]

theorem posWords_put (st : Lift.Shuffler.Zig.St) (k : Nat) (v : BitVec 64) :
    posWords { st with pos := st.pos.setIfInBounds k v } = (posWords st).set k v := by
  simp [posWords]

theorem cellGet_words (w : Width) (xs : List w.type) (k : Nat) (hk : k < xs.length) :
    cellGet (xs.map (Cell.mk w)) (k * w.bytes) w = some xs[k] := by
  conv => lhs; rw [List.map_eq_flatMap]
  rw [← Nat.add_zero (k * w.bytes)]
  rw [cellGet_flatMap (s := w.bytes) w (fun x => by simp [cellsSize]) hk (width_bytes_pos w)]
  simp [cellGet, Cell.get, width_bytes_pos]

theorem cellSet_words (w : Width) (xs : List w.type) (k : Nat) (hk : k < xs.length) (v : w.type) :
    cellSet (xs.map (Cell.mk w)) (k * w.bytes) w v = (xs.set k v).map (Cell.mk w) := by
  conv => lhs; rw [List.map_eq_flatMap]
  conv => rhs; rw [List.map_eq_flatMap]
  rw [← Nat.add_zero (k * w.bytes)]
  rw [cellSet_flatMap (s := w.bytes) w v (fun x => by simp [cellsSize]) hk (width_bytes_pos w)]
  rw [flatMap_set v hk]
  simp [cellSet, Cell.get, width_bytes_pos]

theorem Heap.loadB_words64_getD {policy : CpuPolicy} {h : Heap} {m : DataMem} {base : BitVec 64}
    {xs : List (BitVec 64)} {i : BitVec 64} (hh : h.Holds policy m)
    (ho : Obj.words base true .W64 xs ∈ h) (hi : i.toNat < xs.length) :
    h.loadB (base + i * 8) .W64 = .ok (xs.getD i.toNat 0) := by
  rw [Heap.loadB_of_load (Heap.load_words64_mul hh ho hi), List.getElem_eq_getD]

theorem destWords_getD (st : Lift.Shuffler.Zig.St) (i : BitVec 64)
    (hi : i.toNat < FlatShuffler.maxStackSize) :
    (destWords st).getD i.toNat 0 = FlatShuffler.Flat.get st.dest i := by
  unfold FlatShuffler.Flat.get
  rw [dif_pos hi, ← List.getElem_eq_getD (l := destWords st) (i := i.toNat)
    (h := by simpa [destWords] using hi) 0]
  simp [destWords]

open Lift.Shuffler.Internal.Proposed in
theorem dataWords_getD (st : Lift.Shuffler.Zig.St) (i : BitVec 64)
    (hi : i.toNat < FlatShuffler.maxStackSize) :
    (dataWords st).getD i.toNat 0 =
      Layout.slotWord (FlatShuffler.Flat.get st.data i) (FlatShuffler.Flat.get st.pad i) := by
  unfold FlatShuffler.Flat.get
  rw [dif_pos hi, dif_pos hi]
  have h1 : (dataWords st).getD i.toNat 0 =
      Layout.slotWord (st.data.toList.getD i.toNat default) (st.pad.toList.getD i.toNat 0) := by
    simp only [dataWords]
    rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range (by simpa using hi)]
    rfl
  rw [h1]
  have e1 : st.data.toList.getD i.toNat default = st.data[i.toNat] := by
    rw [← List.getElem_eq_getD (l := st.data.toList) (h := by simpa using hi) default]
    simp
  have e2 : st.pad.toList.getD i.toNat 0 = st.pad[i.toNat] := by
    rw [← List.getElem_eq_getD (l := st.pad.toList) (h := by simpa using hi) 0]
    simp
  rw [e1, e2]

theorem posWords_getD (st : Lift.Shuffler.Zig.St) (i : BitVec 64)
    (hi : i.toNat < FlatShuffler.maxStackSize) :
    (posWords st).getD i.toNat 0 = FlatShuffler.Flat.get st.pos i := by
  unfold FlatShuffler.Flat.get
  rw [dif_pos hi, ← List.getElem_eq_getD (l := posWords st) (i := i.toNat)
    (h := by simpa [posWords] using hi) 0]
  simp [posWords]


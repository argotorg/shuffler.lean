theorem written_mem_objects_self (self data trace mapping : BitVec 64)
    (st : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :

        (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) (.assertionExit, st),
      o ∈ Lift.Shuffler.Internal.Proposed.DupStatement.objects st copy destination trace0
        (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) := by
  have htf : (Vector.ofFn fun i : Fin 10240 =>
      let t := trace0[i]
      if st.trace.length ≤ i.val ∧ i.val < st.trace.length then
        let op := st.trace.getD i.val ⟨⟨0, 0, default⟩, 0⟩
        (op.op.kind, op.op.depth, t.2.2.1, Lift.Shuffler.Internal.Proposed.Layout.slotWord op.op.slot op.pad)
      else t) = trace0 := by
    apply Vector.ext
    intro i hi
    simp only [Vector.getElem_ofFn]
    rw [if_neg (by omega)]
    rfl
  intro o ho
  simp only [Lift.Shuffler.Internal.Proposed.DupStatement.written,
    Lift.Shuffler.Internal.Proposed.DupStatement.objects, htf, List.mem_cons, List.not_mem_nil,
    or_false] at ho ⊢
  grind


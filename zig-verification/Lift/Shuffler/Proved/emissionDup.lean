open Lift.Shuffler.Internal.Proposed
/-! ### The frame of the callee's heap

A store of the callee's block model writes the bytes of one writable object; when that object is an
object of the statement, the frame and the objects whose values the block still reads do not
change. `FrameHeap` is the relation of the heap of a block state to the statement's objects and the
caller's frame. -/

/-- An object that is not writable does not change in a store. -/
theorem obj_set_of_not_writable {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (h : o.writable = false) : Obj.set a w v o = o := by
  unfold Obj.set
  simp only [h, Bool.false_eq_true, ↓reduceIte]

/-- An object that does not span the access does not change in a store. -/
theorem obj_set_of_not_spans {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (hn : o.addr.toNat + o.size ≤ 2 ^ 64) (hsp : ¬ o.Spans a w) : Obj.set a w v o = o := by
  by_cases hw : o.writable = true
  · unfold Obj.set
    rw [if_pos hw]
    have hnone : setCells o.addr a w v 0 o.cells = o.cells := by
      refine setCells_of_no_match _ _ _ _ _ _ ?_
      intro x hx hc
      exact hsp (by
        obtain ⟨e, b⟩ := Obj.toNat_cell hn hx
        have hb : x.fst + w.bytes ≤ o.size := by rw [← hc.2]; exact b
        unfold Obj.Spans
        rw [← hc.1, e]
        omega)
    rw [hnone]
  · exact obj_set_of_not_writable (by simpa using hw)

/-- An object that is not a writable object spanning the access does not change in a byte store. -/
theorem obj_setBytes_of_not {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (h : ¬ (o.writable = true ∧ o.Spans a w)) : Obj.setBytes a w v o = o := by
  by_cases hw : o.writable = true
  · exact Obj.setBytes_of_not_spans fun hs => h ⟨hw, hs⟩
  · exact Obj.setBytes_of_not_writable (by simpa using hw)

/-- An object that is not a writable object spanning the access does not change in a store. -/
theorem obj_set_of_not {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (hn : o.addr.toNat + o.size ≤ 2 ^ 64) (h : ¬ (o.writable = true ∧ o.Spans a w)) :
    Obj.set a w v o = o := by
  by_cases hw : o.writable = true
  · exact obj_set_of_not_spans hn fun hs => h ⟨hw, hs⟩
  · exact obj_set_of_not_writable (by simpa using hw)

/-- A load of the single 64-bit cell of an object. -/
theorem loadB_cell64 {policy : CpuPolicy} {m : DataMem} {h : Heap} {o : Obj} {addr val : BitVec 64}
    (hh : h.Holds policy m) (ho : o ∈ h) (ha : o.addr = addr) (hc : o.cells = [⟨.W64, val⟩]) :
    h.loadB addr .W64 = .ok val := by
  have hx : (0, (⟨.W64, val⟩ : Cell)) ∈ offsets 0 o.cells := by
    rw [hc]; exact List.mem_cons_self ..
  have hl := Heap.load_of_mem hh ho hx
  simp only [Nat.zero_add, BitVec.add_zero, ha] at hl
  exact Heap.loadB_of_load hl

/-- The relation of the heap of a block state to the objects of the statement and the frame. `g` is
the map that the stores of the run applied to the objects; it keeps the shape of each object, fixes
the read-only objects, the objects of `keep` and the frame. -/
def FrameHeap (objs frame keep : Heap) (policy : CpuPolicy) (g : Obj → Obj) (m : DataMem) : Prop :=
  (∀ o ∈ objs, (g o).shape = o.shape) ∧
  (∀ o ∈ objs, o.writable = false → g o = o) ∧
  (∀ o ∈ keep, g o = o) ∧
  (∀ p ∈ frame, g p = p) ∧
  Heap.Holds policy (objs.map g ++ frame) m

theorem FrameHeap.mono_keep {objs frame keep keep' : Heap} {policy : CpuPolicy} {g : Obj → Obj}
    {m : DataMem} (h : FrameHeap objs frame keep policy g m)
    (hk : ∀ o ∈ keep', o ∈ keep) : FrameHeap objs frame keep' policy g m :=
  ⟨h.1, h.2.1, fun o ho => h.2.2.1 o (hk o ho), h.2.2.2.1, h.2.2.2.2⟩

/-- A byte store whose access is inside a writable object of `objs` keeps the frame, the shape of
the objects and the objects of `keep`. -/
theorem FrameHeap.storeB {objs frame keep : Heap} {policy : CpuPolicy} {g : Obj → Obj} {m : DataMem}
    {a : BitVec 64} {w : Width} {v : w.type} {h' : Heap}
    (hrel : FrameHeap objs frame keep policy g m)
    (hsub : ∀ o ∈ keep, o ∈ objs)
    (hex : ∃ O ∈ objs, O.writable = true ∧ O.Spans a w)
    (hkeep : ∀ o ∈ keep, ¬ (o.writable = true ∧ o.Spans a w))
    (hs : Heap.storeB (objs.map g ++ frame) a w v = .ok h') :
    ∃ g' m', h' = objs.map g' ++ frame ∧ FrameHeap objs frame keep policy g' m' ∧
      ∀ o ∈ keep, g' o = g o := by
  obtain ⟨hshape, hfixNW, hkeepG, hfixF, hholds⟩ := hrel
  obtain ⟨O, hO, hOw, hOs⟩ := hex
  have hOg : g O ∈ objs.map g := List.mem_map_of_mem hO
  obtain ⟨hOa, hOw', hOz⟩ := Obj.fields_of_shape (hshape O hO)
  have hOgw : (g O).writable = true := by rw [hOw']; exact hOw
  have hOgs : (g O).Spans a w := by
    unfold Obj.Spans at hOs ⊢
    rw [hOa, hOz]
    exact hOs
  have hsep : Heap.Separated (objs.map g) frame := hholds.separated
  have hfix : ∀ p ∈ frame, Obj.set a w v p = p ∧ Obj.setBytes a w v p = p := by
    intro p hp
    have hnot : ¬ (p.writable = true ∧ p.Spans a w) := fun hc =>
      Obj.not_apart_of_spans hOgs hc.2 (hsep (g O) hOg p hp (Or.inl hOgw))
    exact ⟨obj_set_of_not (hholds.noWrap p (List.mem_append_right _ hp)) hnot,
      obj_setBytes_of_not hnot⟩
  have hkeepnot : ∀ o ∈ keep, ¬ ((g o).writable = true ∧ (g o).Spans a w) := by
    intro o ho hc
    have hsh := hshape o (hsub o ho)
    obtain ⟨ha, hw, hz⟩ := Obj.fields_of_shape hsh
    refine hkeep o ho ⟨?_, ?_⟩
    · show o.writable = true
      rw [← hw]
      exact hc.1
    · unfold Obj.Spans at hc ⊢
      rw [← ha, ← hz]
      exact hc.2
  have hkeepfix : ∀ o ∈ keep, Obj.set a w v (g o) = g o ∧ Obj.setBytes a w v (g o) = g o := by
    intro o ho
    have hnot := hkeepnot o ho
    exact ⟨obj_set_of_not (hholds.noWrap (g o)
      (List.mem_append_left _ (List.mem_map_of_mem (hsub o ho)))) hnot,
      obj_setBytes_of_not hnot⟩
  have hmap : ∃ f : Obj → Obj, h' = (objs.map g ++ frame).map f ∧
      (∀ p ∈ frame, f p = p) ∧ (∀ o ∈ keep, f (g o) = g o) ∧
      (∀ x, (f x).shape = x.shape) ∧ (∀ x, x.writable = false → f x = x) := by
    unfold Heap.storeB at hs
    split at hs
    · unfold Heap.store at hs
      split at hs
      · cases hs
        exact ⟨Obj.set a w v, rfl, fun p hp => (hfix p hp).1, fun o ho => (hkeepfix o ho).1,
          fun x => Obj.set_shape a w v x, fun x hx => obj_set_of_not_writable hx⟩
      · repeat' (first | cases hs | split at hs)
    · split at hs
      · cases hs
        exact ⟨Obj.setBytes a w v, rfl, fun p hp => (hfix p hp).2, fun o ho => (hkeepfix o ho).2,
          fun x => Obj.setBytes_shape a w v x, fun x hx => Obj.setBytes_of_not_writable hx⟩
      · repeat' (first | cases hs | split at hs)
  obtain ⟨f, hh', hfF, hfK, hfShape, hfNW⟩ := hmap
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hholds hs
  have hframe : frame.map f = frame := by
    simpa only [List.map_id] using
      (List.map_congr_left (f := f) (g := id) (l := frame) fun p hp => hfF p hp)
  have heq : h' = objs.map (fun o => f (g o)) ++ frame := by
    rw [hh', List.map_append, List.map_map, hframe]
    rfl
  refine ⟨fun o => f (g o), m', heq, ?_, ?_⟩
  · refine ⟨fun o ho => ?_, fun o ho hw => ?_, fun o ho => ?_, fun p hp => ?_, ?_⟩
    · show (f (g o)).shape = o.shape
      rw [hfShape, hshape o ho]
    · show f (g o) = o
      rw [hfixNW o ho hw, hfNW o hw]
    · show f (g o) = o
      rw [hfK o ho, hkeepG o ho]
    · show f (g p) = p
      rw [hfixF p hp, hfF p hp]
    · rw [← heq]
      exact hm'
  · intro o ho
    show f (g o) = g o
    exact hfK o ho

/-- The cells of the trace array of the statement. -/
def traceCells (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) : List Cell :=
  trace0.toList.flatMap fun t => [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]

theorem cellsSize_traceCells (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    cellsSize (traceCells trace0) = 10240 * 12 := by
  have hlen : trace0.toList.length = 10240 := by simp
  rw [traceCells, cellsSize_flatMap]
  have h : ∀ t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64,
      cellsSize [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] = 12 := by
    intro t
    simp [cellsSize, Width.bytes]
  simp only [h, sum_map_const, hlen]

/-- A single 64-bit cell at the address of its object is spanned by the object. -/
theorem spans_self_cell64 {addr val : BitVec 64} {wr : Bool} :
    (Obj.mk addr wr [⟨.W64, val⟩]).Spans addr .W64 := by
  unfold Obj.Spans
  simp only [Obj.size, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Width.bytes]
  omega

/-- An array of 64-bit words spans its element `k`. -/
theorem spans_words {base : BitVec 64} {wr : Bool} {xs : List (BitVec 64)} {k : Nat}
    (hk : k < xs.length) (hn : base.toNat + xs.length * 8 ≤ 2 ^ 64) :
    (Obj.words base wr .W64 xs).Spans (base + BitVec.ofNat 64 (8 * k)) .W64 := by
  have hsz : (Obj.words base wr .W64 xs).size = xs.length * 8 := by
    simp only [Obj.words, Obj.size, List.map_map, Function.comp_def, Width.bytes, sum_map_const]
  unfold Obj.Spans
  rw [hsz]
  simp only [Obj.words, Obj.size, List.map_map, Function.comp_def, Width.bytes, sum_map_const]
  rw [toNat_add_ofNat base (8 * k) (by omega)]
  omega

/-- An array of 64-bit words spans its element `k`, with the bit-vector index of a machine access. -/
theorem spans_words_bv {base : BitVec 64} {wr : Bool} {xs : List (BitVec 64)} {k : BitVec 64}
    (hk : k.toNat < xs.length) (hn : base.toNat + xs.length * 8 ≤ 2 ^ 64) :
    (Obj.words base wr .W64 xs).Spans (base + k * 8) .W64 := by
  have hsz : (Obj.words base wr .W64 xs).size = xs.length * 8 := by
    simp only [Obj.words, Obj.size, List.map_map, Function.comp_def, Width.bytes, sum_map_const]
  unfold Obj.Spans
  rw [hsz]
  simp only [Obj.words, Obj.size, List.map_map, Function.comp_def, Width.bytes, sum_map_const]
  have e : (base + k * 8).toNat = base.toNat + k.toNat * 8 := by bv_omega
  rw [e]
  omega

/-- The trace array spans the bytes of its operation `k`. -/
theorem spans_trace {base K : BitVec 64} {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240}
    {off : Nat} {w : Width} (hK : K.toNat < 10240) (hoff : off + w.bytes ≤ 12)
    (hn : base.toNat + 10240 * 12 ≤ 2 ^ 64) :
    (Obj.mk base true (traceCells trace0)).Spans (base + K * 12 + BitVec.ofNat 64 off) w := by
  have hsz : (Obj.mk base true (traceCells trace0)).size = 10240 * 12 := cellsSize_traceCells trace0
  unfold Obj.Spans
  rw [hsz]
  dsimp only
  have hK' : BitVec.ofNat 64 K.toNat = K := by rw [BitVec.ofNat_toNat, BitVec.setWidth_eq]
  have hmul : K * 12 = BitVec.ofNat 64 (K.toNat * 12) := by
    conv => lhs; rw [← hK']
    rw [show (12 : BitVec 64) = BitVec.ofNat 64 12 from rfl, ← BitVec.ofNat_mul]
  have e : (base + K * 12 + BitVec.ofNat 64 off).toNat = base.toNat + (12 * K.toNat + off) := by
    have hw1 : 1 ≤ w.bytes := width_bytes_pos w
    rw [hmul, BitVec.add_assoc, ← BitVec.ofNat_add]
    rw [toNat_add_ofNat base (K.toNat * 12 + off) (by omega)]
    congr 1
    omega
  rw [e]
  omega

/-- The invariant of the frame proof of the callee's block model. -/
def FrameInv (objs frame : Heap) (a : skel_call.In2p) (sizeB traceB mappingB copyB : BitVec 64) :
    Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x.input = a ∧ x.mem = a.heap ∧ x.rsi = UInt64.ofBitVec copyB
  | .o32, x => x.input = a ∧ x.mem = a.heap ∧ x.rsi = UInt64.ofBitVec copyB
  | .o45, x => x.input = a ∧ x.mem = a.heap ∧ x.rsi = UInt64.ofBitVec copyB ∧
      x.rcx = UInt64.ofBitVec sizeB ∧ sizeB.toNat < 1024
  | .o58, x => x.input = a ∧ x.mem = a.heap ∧ x.rsi = UInt64.ofBitVec copyB ∧
      x.rcx = UInt64.ofBitVec sizeB ∧ x.r8 = UInt64.ofBitVec traceB ∧
      sizeB.toNat < 1024 ∧ traceB.toNat < 10240
  | .o140, x => x.input = a ∧ x.rsi = UInt64.ofBitVec mappingB ∧
      x.rcx = UInt64.ofBitVec sizeB ∧ sizeB.toNat < 1024 ∧ traceB.toNat < 10240 ∧
      ∃ g m, x.mem = objs.map g ++ frame ∧ FrameHeap objs frame [] a.policy g m
  | .LBB14_5, x => x.input = a ∧
      ∃ g m, x.mem = objs.map g ++ frame ∧ FrameHeap objs frame [] a.policy g m

/-- An object of the statement's list is an object of the statement's heap. -/
theorem mem_objsP {self data trace mapping : BitVec 64} {st : Zig.St} {copy destination : FlatShuffler.Word}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240} {X : Lift.Trusted.Object}
    (hX : X ∈ Lift.Shuffler.Internal.Proposed.DupStatement.objects st copy destination trace0
      (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping)) :
    toObj X ∈ objsP self data trace mapping st copy destination trace0 :=
  List.mem_map_of_mem hX


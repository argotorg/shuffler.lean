    exact has_of_holds_mem hm (hpost o ho)

open Lift.Shuffler.Internal.Proposed in
/-- The `written` objects after the record of `rec`: their trace object is the updated trace array. -/
theorem HeapAt_written_after {self data trace mapping : BitVec 64} {frame : Heap}
    {st st' : Lift.Shuffler.Zig.St} {copy destination : FlatShuffler.Word}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240}
    (rec : Lift.Shuffler.Zig.OpP) (hLt : st.trace.length < 10240)
    (htr : st'.trace = st.trace ++ [rec]) (ex : Lift.Shuffler.Zig.Exit FlatShuffler.Flat.Status) :
    ∀ o ∈ DupStatement.written st copy destination trace0 (EnvOf self data trace mapping)
        (ex, st'),
      toObj o ∈ HeapAt (EnvOf self data trace mapping) frame st'
        ⟨(EnvOf self data trace mapping).trace, true,
          (trace0.toList.take st.trace.length).flatMap traceCell1 ++
            traceCell1 (rec.op.kind, rec.op.depth,
              (trace0.toList[st.trace.length]'(by simpa using hLt)).2.2.1,
              Layout.slotWord rec.op.slot rec.pad) ++
            (trace0.toList.drop (st.trace.length + 1)).flatMap traceCell1⟩ := by
  intro o ho
  unfold DupStatement.written at ho
  dsimp only at ho
  rw [htr] at ho
  simp only [List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false] at ho
  rcases ho with h | h | h | h | h | h
  · rw [h]; simp [HeapAt, toObj_size, sizeObj]
  · rw [h]; simp [HeapAt, toObj_data, dataObj]
  · rw [h]; simp [HeapAt, toObj_dest, destObj]
  · rw [h]; simp [HeapAt, toObj_pos, posObj]
  · rw [h]; simp [HeapAt, toObj_traceSize, traceSizeObj]
  · rw [h, traceObj_toObj, traceFinal_append_flatMap st trace0 rec hLt]

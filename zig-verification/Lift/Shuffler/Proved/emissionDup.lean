    Lift.Shuffler.Internal.Proposed.Layout.word, Obj.size, Width.bytes]

/-- The address of the `traceSize` field. -/
theorem addr_traceSizeObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St} :
    (toObj (Lift.Shuffler.Internal.Proposed.Layout.traceSize (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).addr = self + 64 := by

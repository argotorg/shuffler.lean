  have h := Heap.store_cellObj_split (policy := policy) (m := m) (addr := e.self + 48) (w := .W64)
    (v := st.size) (v' := st.size + 1) (l₁ := [])
    (l₂ := [dataObj e st, destObj e st, posObj e st, dataPtrObj e, mappingPtrObj e, tracePtrObj e,
      traceSizeObj e st, T] ++ frame)

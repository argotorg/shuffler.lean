  refine (Heap.storeB_of_store h).trans ?_
  rfl

open Lift.Shuffler.Internal.Proposed in
theorem HeapAt_store_traceSize {policy : CpuPolicy} {e : Layout.Env} {frame : Heap}
    {st : Lift.Shuffler.Zig.St} {T : Obj} {m : DataMem} (rec : Lift.Shuffler.Zig.OpP)
    (hm : Heap.Holds policy (HeapAt e frame st T) m) :
    (HeapAt e frame st T).storeB (e.self + 64) .W64 (BitVec.ofNat 64 st.trace.length + 1) =
      .ok (HeapAt e frame { st with trace := st.trace ++ [rec] } T) := by
  have hlen : BitVec.ofNat 64 (st.trace ++ [rec]).length = BitVec.ofNat 64 st.trace.length + 1 := by
    simp only [List.length_append, List.length_cons, List.length_nil, Nat.zero_add]
    rw [BitVec.ofNat_add]
    rfl
  have h := Heap.store_cellObj_split (policy := policy) (m := m) (addr := e.self + 64) (w := .W64)
    (v := BitVec.ofNat 64 st.trace.length) (v' := BitVec.ofNat 64 st.trace.length + 1)
    (l₁ := [sizeObj e st, dataObj e st, destObj e st, posObj e st, dataPtrObj e, mappingPtrObj e,
      tracePtrObj e])
    (l₂ := [T] ++ frame)
    (by simpa only [HeapAt, traceSizeObj, List.singleton_append, List.cons_append, List.nil_append]
      using hm)
  have hobj : (⟨e.self + 64, true, [⟨.W64, BitVec.ofNat 64 st.trace.length + 1⟩]⟩ : Obj) =
      traceSizeObj e { st with trace := st.trace ++ [rec] } := by
    simp only [traceSizeObj, hlen]
  rw [hobj] at h
  refine (Heap.storeB_of_store h).trans ?_
  rfl

open Lift.Shuffler.Internal.Proposed in
theorem HeapAt_store_trace {policy : CpuPolicy} {e : Layout.Env} {frame : Heap}
    {st : Lift.Shuffler.Zig.St} {A B : List Cell}
    {t t' : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64} {m : DataMem}
    (hm : Heap.Holds policy (HeapAt e frame st ⟨e.trace, true, A ++ traceCell1 t ++ B⟩) m)
    (L r : Nat) (hA : cellsSize A = 12 * L) (hr : r < 12) (w : Width) (v : w.type)
    (hrec : cellSet (traceCell1 t) r w v = traceCell1 t')
    (hcell : (cellGet (traceCell1 t) r w).isSome) :
    (HeapAt e frame st ⟨e.trace, true, A ++ traceCell1 t ++ B⟩).storeB
        (e.trace + BitVec.ofNat 64 (L * 12 + r)) w v =
      .ok (HeapAt e frame st ⟨e.trace, true, A ++ traceCell1 t' ++ B⟩) := by
  have h := Heap.store_trace_set (policy := policy) (m := m) (addr := e.trace)
    (l₁ := [sizeObj e st, dataObj e st, destObj e st, posObj e st, dataPtrObj e, mappingPtrObj e,
      tracePtrObj e, traceSizeObj e st])
    (l₂ := frame)
    hA r hr w v hrec hcell
    (by simpa only [HeapAt, List.singleton_append, List.cons_append, List.nil_append] using hm)
  refine (Heap.storeB_of_store h).trans ?_
  rfl

/-! ### The trace vector of `written` -/

theorem vector_ofFn_ite_eq_set {α : Type} {n : Nat} (v : Vector α n) (L : Nat) (hL : L < n)
    (a : α) : (Vector.ofFn fun i : Fin n => if i.val = L then a else v[i]) = v.set L a := by
  apply Vector.ext
  intro i hi
  simp only [Vector.getElem_ofFn, Vector.getElem_set]
  by_cases h : i = L
  · rw [if_pos h, if_pos h.symm]
  · rw [if_neg h, if_neg (fun e => h e.symm)]
    rfl

theorem flatMap_traceCell1_split (l : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64))
    (L : Nat) (hL : L < l.length) :
    l.flatMap traceCell1 =
      (l.take L).flatMap traceCell1 ++ traceCell1 l[L] ++ (l.drop (L + 1)).flatMap traceCell1 := by
  conv => lhs; rw [← List.take_append_drop L l, List.drop_eq_getElem_cons hL]
  rw [List.flatMap_append, List.flatMap_cons, ← List.append_assoc]

theorem cellsSize_take_flatMap (l : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64))
    (L : Nat) (hL : L ≤ l.length) :
    cellsSize ((l.take L).flatMap traceCell1) = 12 * L := by
  induction l generalizing L with
  | nil => simp only [List.length_nil, Nat.le_zero] at hL; rw [hL]; rfl
  | cons a t ih =>
    cases L with
    | zero => rfl
    | succ k =>
      have hk : k ≤ t.length := by simpa using hL
      simp only [List.take_succ_cons, List.flatMap_cons, cellsSize_append, cellsSize_traceCell1,
        ih k hk]
      omega

theorem flatMap_traceCell1_set (l : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64))
    (L : Nat) (hL : L < l.length) (x : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) :
    (l.set L x).flatMap traceCell1 =
      (l.take L).flatMap traceCell1 ++ traceCell1 x ++ (l.drop (L + 1)).flatMap traceCell1 := by
  conv => lhs; rw [List.set_eq_take_append_cons_drop, if_pos hL]
  rw [List.flatMap_append, List.flatMap_cons, ← List.append_assoc]

open Lift.Shuffler.Internal.Proposed in
theorem traceFinal_append_flatMap (st : Lift.Shuffler.Zig.St)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (rec : Lift.Shuffler.Zig.OpP) (hLt : st.trace.length < 10240) :
    (Vector.ofFn fun i : Fin 10240 =>
      let t := trace0[i]
      if st.trace.length ≤ i.val ∧ i.val < (st.trace ++ [rec]).length then
        (let op := (st.trace ++ [rec]).getD i.val ⟨⟨0, 0, default⟩, 0⟩
         (op.op.kind, op.op.depth, t.2.2.1, Layout.slotWord op.op.slot op.pad))
      else t).toList.flatMap traceCell1 =
      (trace0.toList.take st.trace.length).flatMap traceCell1 ++
        traceCell1 (rec.op.kind, rec.op.depth, (trace0.toList[st.trace.length]'(by simpa using hLt)).2.2.1,
          Layout.slotWord rec.op.slot rec.pad) ++
        (trace0.toList.drop (st.trace.length + 1)).flatMap traceCell1 := by
  have hfun : (fun i : Fin 10240 =>
      let t := trace0[i]
      if st.trace.length ≤ i.val ∧ i.val < (st.trace ++ [rec]).length then
        (let op := (st.trace ++ [rec]).getD i.val ⟨⟨0, 0, default⟩, 0⟩
         (op.op.kind, op.op.depth, t.2.2.1, Layout.slotWord op.op.slot op.pad))
      else t) =
      (fun i : Fin 10240 =>
        if i.val = st.trace.length then
          (rec.op.kind, rec.op.depth, (trace0.toList[st.trace.length]'(by simpa using hLt)).2.2.1,
            Layout.slotWord rec.op.slot rec.pad)
        else trace0[i]) := by
    funext i
    have hlen : (st.trace ++ [rec]).length = st.trace.length + 1 := by simp
    by_cases h : i.val = st.trace.length
    · have hcond : st.trace.length ≤ i.val ∧ i.val < (st.trace ++ [rec]).length := by omega
      have hgd : (st.trace ++ [rec]).getD i.val ⟨⟨0, 0, default⟩, 0⟩ = rec := by
        rw [h, List.getD_eq_getElem?_getD]
        simp
      have e : trace0[i] = trace0.toList[st.trace.length]'(by simpa using hLt) := by
        have h1 : trace0[i] = trace0.toList[i.val]'(by simpa using i.isLt) := rfl
        rw [h1]
        simp only [h]
      rw [if_pos hcond, if_pos h, hgd, e]
    · have hcond : ¬ (st.trace.length ≤ i.val ∧ i.val < (st.trace ++ [rec]).length) := by omega
      rw [if_neg hcond, if_neg h]
  rw [hfun, vector_ofFn_ite_eq_set trace0 st.trace.length hLt, Vector.toList_set,
    flatMap_traceCell1_set trace0.toList st.trace.length (by simpa using hLt)]

open Lift.Shuffler.Internal.Proposed in
/-- The trace object of a list of operations at the address of the environment. -/
theorem traceObj_toObj (e : Layout.Env)
    (l : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)) :
    toObj (⟨e.trace, traceFields l, true⟩ : Lift.Trusted.Object) =
      (⟨e.trace, true, l.flatMap traceCell1⟩ : Obj) := by
  simp only [toObj, traceFields_cells]

/-- The environment of the statement of `dup`. -/
abbrev EnvOf (self data trace mapping : BitVec 64) : Lift.Shuffler.Internal.Proposed.Layout.Env :=
  Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping

/-- The trace object of `trace0`, the ninth object of the statement. -/
abbrev TraceObj0 (self data trace mapping : BitVec 64)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) : Obj :=
  ⟨(EnvOf self data trace mapping).trace, true, trace0.toList.flatMap traceCell1⟩

/-! ### The objects that an exit writes -/

open Lift.Shuffler.Internal.Proposed in
/-- The trace vector of `written` is the input when the state does not change. -/
theorem traceFinal_of (st : Lift.Shuffler.Zig.St)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (y : Lift.Shuffler.Zig.Outcome FlatShuffler.Flat.Status) (hy : y.2.trace = st.trace) :
    (Vector.ofFn fun i =>
      let t := trace0[i]
      if st.trace.length ≤ i.val ∧ i.val < y.2.trace.length then
        (let op := y.2.trace.getD i.val ⟨⟨0, 0, default⟩, 0⟩
         (op.op.kind, op.op.depth, t.2.2.1, Layout.slotWord op.op.slot op.pad))
      else t) = trace0 := by
  rw [hy]
  apply Vector.ext
  intro i hi
  simp only [Vector.getElem_ofFn]
  have hlt : ¬ (st.trace.length ≤ i ∧ i < st.trace.length) := by omega
  simp only [hlt, ↓reduceIte]
  rfl

open Lift.Shuffler.Internal.Proposed in
/-- The `written` list at an assertion exit that keeps the trace. -/
theorem written_assert (st st' : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (e : Layout.Env)
    (htr : st'.trace = st.trace) :
    DupStatement.written st copy destination trace0 e (Lift.Shuffler.Zig.Exit.assertionExit, st') =
      [Layout.size e st' true, Layout.data e st' true, Layout.dest e st' true,
        Layout.pos e st' true, Layout.traceSize e st' true,
        ⟨e.trace, traceFields trace0.toList, true⟩] := by
  unfold DupStatement.written
  dsimp only
  rw [traceFinal_of st trace0 (Lift.Shuffler.Zig.Exit.assertionExit, st') htr]

open Lift.Shuffler.Internal.Proposed in
theorem HeapAt_written_assert {self data trace mapping : BitVec 64} {frame : Heap}
    {st st' : Lift.Shuffler.Zig.St} {copy destination : FlatShuffler.Word}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240}
    {T : Obj} (htr : st'.trace = st.trace) (hT : T = TraceObj0 self data trace mapping trace0) :
    ∀ o ∈ DupStatement.written st copy destination trace0 (EnvOf self data trace mapping)
        (Lift.Shuffler.Zig.Exit.assertionExit, st'),
      toObj o ∈ HeapAt (EnvOf self data trace mapping) frame st' T := by
  intro o ho
  rw [written_assert st st' copy destination trace0 _ htr] at ho
  simp only [List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false] at ho
  rcases ho with h | h | h | h | h | h
  · rw [h, hT]; simp [HeapAt, toObj_size, sizeObj]
  · rw [h, hT]; simp [HeapAt, toObj_data, dataObj]
  · rw [h, hT]; simp [HeapAt, toObj_dest, destObj]
  · rw [h, hT]; simp [HeapAt, toObj_pos, posObj]
  · rw [h, hT]; simp [HeapAt, toObj_traceSize, traceSizeObj]
  · rw [h, hT]; simp [HeapAt, traceObj0_toObj]

open Lift.Shuffler.Internal.Proposed in
/-- The postcondition of the statement at an assertion exit. -/
theorem post_assert (self data trace mapping : BitVec 64) (frame : Heap)
    (st st' : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (policy : CpuPolicy)
    (r : UInt64) (m : DataMem) (T : Obj)
    (hdup : Lift.Shuffler.Zig.dup st copy destination = (Lift.Shuffler.Zig.Exit.assertionExit, st'))
    (hr : r.toBitVec.setWidth 16 = (1 : BitVec 16))
    (hpost : ∀ o ∈ DupStatement.written st copy destination trace0 (EnvOf self data trace mapping)
        (Lift.Shuffler.Zig.Exit.assertionExit, st'),
      toObj o ∈ HeapAt (EnvOf self data trace mapping) frame st' T)
    (hm : (HeapAt (EnvOf self data trace mapping) frame st' T).Holds policy m) :
    DupStatement.post st copy destination trace0 (EnvOf self data trace mapping) policy
      ⟨.W16, r.toBitVec.setWidth 16⟩ m := by
  unfold DupStatement.post
  refine ⟨Lift.Shuffler.Zig.dup st copy destination, rfl, ?_, ?_⟩
  · rw [hdup]
    simp only [DupStatement.result, FlatShuffler.Flat.ExecutionControl.done, reduceCtorEq,
      if_false, hr]
    rfl
  · intro o ho
    rw [hdup] at ho
    exact has_of_holds_mem hm (hpost o ho)

open Lift.Shuffler.Internal.Proposed in
/-- The postcondition of the statement at the normal return: the heap is the model state with the
trace object of the written objects. -/
theorem post_done (self data trace mapping : BitVec 64) (frame : Heap)
    (st st' : Lift.Shuffler.Zig.St) (copy destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (policy : CpuPolicy)
    (r : UInt64) (m : DataMem) (T : Obj)
    (hdup : Lift.Shuffler.Zig.dup st copy destination = (Lift.Shuffler.Zig.Exit.done, st'))

    (hpost : ∀ o ∈ DupStatement.written st copy destination trace0 (EnvOf self data trace mapping)
        (Lift.Shuffler.Zig.Exit.done, st'),
      toObj o ∈ HeapAt (EnvOf self data trace mapping) frame st' T)
    (hm : (HeapAt (EnvOf self data trace mapping) frame st' T).Holds policy m) :
    DupStatement.post st copy destination trace0 (EnvOf self data trace mapping) policy
      ⟨.W16, r.toBitVec.setWidth 16⟩ m := by
  unfold DupStatement.post

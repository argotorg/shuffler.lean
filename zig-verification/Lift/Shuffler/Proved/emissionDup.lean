/-- The cells of the trace array, in the mapped form of the statement's object. -/
theorem traceCells_map {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240} :
    (trace0.toList.flatMap (fun t => ([⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] : List Lift.Trusted.Field))).map Bridge.toCell = traceCells trace0 := by
  rw [List.map_flatMap]
  simp [traceCells, Bridge.toCell]

/-- The trace array of the statement is an object of the statement's heap. -/
theorem mem_traceObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St}
    {copy destination : FlatShuffler.Word}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240} :
    (⟨trace, true, traceCells trace0⟩ : Obj) ∈ objsP self data trace mapping st copy destination trace0 := by
  have hmem : (⟨trace, trace0.toList.flatMap (fun t => ([⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] : List Lift.Trusted.Field)), true⟩ : Lift.Trusted.Object) ∈
      Lift.Shuffler.Internal.Proposed.DupStatement.objects st copy destination trace0 (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) := by
    simp only [Lift.Shuffler.Internal.Proposed.DupStatement.objects]
    exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
      (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
      (List.mem_cons_self ..))))))))
  have h := mem_objsP hmem
  simp only [Bridge.toObj] at h
  rw [traceCells_map] at h
  exact h

/-- The size of the trace array. -/
theorem size_traceObj {trace : BitVec 64}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240} :
    (⟨trace, true, traceCells trace0⟩ : Obj).size = 10240 * 12 :=
  cellsSize_traceCells trace0

/-- The address of the `size` field. -/
theorem addr_sizeObj {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St} :
    (toObj (Lift.Shuffler.Internal.Proposed.Layout.size (Lift.Shuffler.Internal.Proposed.DupStatement.envOf self data trace mapping) st true)).addr = self + 48 := by

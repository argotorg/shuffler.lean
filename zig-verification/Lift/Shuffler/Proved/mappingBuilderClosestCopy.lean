theorem LBB29_1 : ∀ (self : BitVec 64) (sp : BitVec 64) (tp : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (a : In2p) (y : (BitVec 64)) (v_rcx : BitVec 64), SimArr self sp tp dp mp frame src tgt dropped dest t loc a → a.heap.loadB (a.rdi.toBitVec + 8) .W64 = .ok v_rcx → Lift.Pilot.ClosestCopySpec.run src tgt dropped dest t loc = some y → blocksP.Returns noCall .LBB29_1 ⟨a, 18446744073709551615, a.rbx, (UInt64.ofBitVec v_rcx), a.rbp, (0 - a.rsi), 0, 4294967296, a.rsi, a.r14, a.r15, a.heap⟩ (UInt64.ofBitVec y) := by
  intro self sp tp dp mp frame src tgt dropped dest t loc a y v_rcx
  rintro ⟨hC, hself, hrsi, hloc, hheap, policy, m, hh⟩ hload hy
  have hhN : Heap.Holds policy (heapN self sp tp dp mp src tgt dropped dest frame) m := by
    rw [← heapN_eq, ← hheap]

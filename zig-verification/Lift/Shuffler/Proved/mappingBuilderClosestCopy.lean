theorem take_foldl_succ {α β : Type} (l : List α) (n : Nat) (a : β) (f : β → α → β) (x : α)
    (h : l[n]? = some x) : (l.take (n+1)).foldl f a = f ((l.take n).foldl f a) x := by
  rw [List.take_succ, h]
  simp [List.foldl_append]

theorem bestAt_succ (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (src : List Lift.Pilot.Slot)
    (n : Nat) (hn : n < src.length) (h1024 : src.length ≤ 1024) :
    bestAt tgt dropped dest t loc src (n + 1)
      = stepF tgt dropped dest t loc (bestAt tgt dropped dest t loc src n)
          ((pairs src)[n]'(by rw [pairs_length src h1024]; exact hn)) := by
  unfold bestAt
  rw [take_foldl_succ _ _ _ _ _
    (List.getElem?_eq_getElem (by rw [pairs_length src h1024]; exact hn))]

theorem uint64_toBitVec_ofNat (x : UInt64) : BitVec.ofNat 64 x.toNat = x.toBitVec := by
  simp

theorem dec_lemma (s b : Nat) (h : b < s) : s - (b + 1) < s - b := by

/-- `stepF` keeps the accumulator when its guard fails. -/
theorem stepF_self (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (best : BitVec 64)
    (i : Fin 1024) (s : Lift.Pilot.Slot)
    (h : ¬ (tgt[t]?.any (Lift.Pilot.ShallowestSpec.eql s) ∧ dropped[i] = 0 ∧
        dest[i] = Lift.Pilot.IsRetainedSpec.none64 ∧
        Lift.Pilot.ClosestCopySpec.inWildcardSlot tgt i = decide (loc ≠ 0))) :
    stepF tgt dropped dest t loc best (i, s) = best := by
  simp only [stepF]
  rw [ite_eq_right h]

/-- `stepF` takes the index when its guard holds and the index is at least as close. -/
theorem stepF_idx (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (best : BitVec 64)
    (i : Fin 1024) (s : Lift.Pilot.Slot)
    (h : tgt[t]?.any (Lift.Pilot.ShallowestSpec.eql s) ∧ dropped[i] = 0 ∧
        dest[i] = Lift.Pilot.IsRetainedSpec.none64 ∧
        Lift.Pilot.ClosestCopySpec.inWildcardSlot tgt i = decide (loc ≠ 0))
    (h2 : best = Lift.Pilot.IsRetainedSpec.none64 ∨
          Lift.Pilot.ClosestCopySpec.absDiff i t ≤
            Lift.Pilot.ClosestCopySpec.absDiff best.toNat t) :
    stepF tgt dropped dest t loc best (i, s) = BitVec.ofNat 64 i := by
  simp only [stepF]
  rw [ite_eq_left h, ite_eq_left h2]

/-- `stepF` keeps the accumulator when its guard holds and the index is farther. -/
theorem stepF_best (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (best : BitVec 64)
    (i : Fin 1024) (s : Lift.Pilot.Slot)
    (h : tgt[t]?.any (Lift.Pilot.ShallowestSpec.eql s) ∧ dropped[i] = 0 ∧
        dest[i] = Lift.Pilot.IsRetainedSpec.none64 ∧
        Lift.Pilot.ClosestCopySpec.inWildcardSlot tgt i = decide (loc ≠ 0))
    (h2 : ¬ (best = Lift.Pilot.IsRetainedSpec.none64 ∨
          Lift.Pilot.ClosestCopySpec.absDiff i t ≤
            Lift.Pilot.ClosestCopySpec.absDiff best.toNat t)) :
    stepF tgt dropped dest t loc best (i, s) = best := by
  simp only [stepF]
  rw [ite_eq_left h, ite_eq_right h2]

theorem words_size (addr : BitVec 64) (wr : Bool) (w : Width) (xs : List w.type) :
    (Obj.words addr wr w xs).size = xs.length * w.bytes := by
  unfold Obj.words Obj.size
  induction xs with
  | nil => simp
  | cons x xs ih =>
    simp only [List.map_cons, List.sum_cons, List.length_cons, ih, Nat.add_mul, Nat.one_mul]
    omega

theorem heapN_tgt_bound {self sp tp dp mp : BitVec 64} {src tgt : List Lift.Pilot.Slot}
    {dropped : Vector (BitVec 8) 1024} {dest : Vector (BitVec 64) 1024} {frame : Heap}
    {policy : CpuPolicy} {m : DataMem}
    (hh : Heap.Holds policy (heapN self sp tp dp mp src tgt dropped dest frame) m) :
    tgt.length < 2 ^ 64 := by
  have ho : Obj.words tp false .W64 (tgt.map Lift.Pilot.Slot.word)
      ∈ heapN self sp tp dp mp src tgt dropped dest frame := by
    unfold heapN
    simp
  have h := hh.noWrap _ ho
  rw [words_size] at h
  simp only [Obj.words, List.length_map] at h
  have h8 : Width.bytes .W64 = 8 := rfl
  rw [h8] at h
  omega

theorem toUInt8_bridge (a : UInt64) :
    (a.toUInt8.toUInt64 = 0) ↔ (a.toBitVec.setWidth 8 = 0) := by
  bv_decide

theorem absDiff_rax (rax rsi : UInt64) (i t : Nat) (h : rax.toNat = i) (hrsi : rsi.toNat = t) :
    (if rsi ≤ rax then rax - rsi else rsi - rax).toNat =
      Lift.Pilot.ClosestCopySpec.absDiff i t := by
  by_cases hc : rsi ≤ rax
  · have h1 : t ≤ i := by rw [← h, ← hrsi]; exact UInt64.le_iff_toNat_le.mp hc
    rw [ite_eq_left hc, UInt64.toNat_sub_of_le _ _ hc]
    unfold Lift.Pilot.ClosestCopySpec.absDiff
    by_cases h2 : t < i
    · rw [ite_eq_left (by omega)]
      omega
    · rw [ite_eq_right (by omega)]
      omega
  · have h1 : i < t := by
      rw [← h, ← hrsi]
      exact UInt64.lt_iff_toNat_lt.mp (UInt64.not_le.mp hc)
    rw [ite_eq_right hc, UInt64.toNat_sub_of_le _ _ (UInt64.le_iff_toNat_le.mpr (by omega))]
    unfold Lift.Pilot.ClosestCopySpec.absDiff
    rw [ite_eq_right (by omega)]
    omega

theorem eql_of_word (s u : Lift.Pilot.Slot)
    (h : s.word &&& 281474976710655 = u.word &&& 281474976710655) :
    Lift.Pilot.ShallowestSpec.eql s u = true := (eql_iff_and s u).mpr h

/-- The four tests of one step of the fold, for the pair at index `n`. -/
def guard (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (n : Nat) (hn : n < 1024)
    (s : Lift.Pilot.Slot) : Prop :=
  tgt[t]?.any (Lift.Pilot.ShallowestSpec.eql s) ∧ dropped.get ⟨n, hn⟩ = 0 ∧
    dest.get ⟨n, hn⟩ = Lift.Pilot.IsRetainedSpec.none64 ∧
    Lift.Pilot.ClosestCopySpec.inWildcardSlot tgt n = decide (loc ≠ 0)

/-- The choice of a step of the fold, for the pair at index `n`. -/
def better (best : BitVec 64) (n t : Nat) : Prop :=
  best = Lift.Pilot.IsRetainedSpec.none64 ∨
    Lift.Pilot.ClosestCopySpec.absDiff n t ≤ Lift.Pilot.ClosestCopySpec.absDiff best.toNat t

theorem stepF_keep (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (best : BitVec 64)
    (n : Nat) (hn : n < 1024) (s : Lift.Pilot.Slot)
    (h : ¬ guard tgt dropped dest t loc n hn s) :
    stepF tgt dropped dest t loc best (⟨n, hn⟩, s) = best :=
  stepF_self tgt dropped dest t loc best ⟨n, hn⟩ s h

theorem stepF_take (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (best : BitVec 64)
    (n : Nat) (hn : n < 1024) (s : Lift.Pilot.Slot)
    (h : guard tgt dropped dest t loc n hn s) (h2 : better best n t) :
    stepF tgt dropped dest t loc best (⟨n, hn⟩, s) = BitVec.ofNat 64 n := by
  have h' := stepF_idx tgt dropped dest t loc best ⟨n, hn⟩ s h h2
  simpa using h'

theorem stepF_keep2 (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (best : BitVec 64)
    (n : Nat) (hn : n < 1024) (s : Lift.Pilot.Slot)
    (h : guard tgt dropped dest t loc n hn s) (h2 : ¬ better best n t) :
    stepF tgt dropped dest t loc best (⟨n, hn⟩, s) = best :=
  stepF_best tgt dropped dest t loc best ⟨n, hn⟩ s h h2

theorem decide_ne_false {loc : BitVec 8} (h : loc = 0) : decide (loc ≠ 0) = false := by
  cases hd : decide (loc ≠ 0) with
  | false => rfl
  | true => exact absurd (of_decide_eq_true hd) (by rw [h]; simp)

theorem decide_ne_true {loc : BitVec 8} (h : loc ≠ 0) : decide (loc ≠ 0) = true := by
  cases hd : decide (loc ≠ 0) with
  | false => exact absurd h (of_decide_eq_false hd)
  | true => rfl

theorem getElem_nat_congr {α : Type} {l : List α} {n1 n2 : Nat} (h : n1 = n2)
    (p1 : n1 < l.length) (p2 : n2 < l.length) : l[n1]'p1 = l[n2]'p2 := by
  subst h
  rfl

theorem load_src' {self sp tp dp mp : BitVec 64} {src tgt : List Lift.Pilot.Slot}
    {dropped : Vector (BitVec 8) 1024} {dest : Vector (BitVec 64) 1024}
    {frame : Heap} {policy : CpuPolicy} {m : DataMem}
    (hh : Heap.Holds policy (heapN self sp tp dp mp src tgt dropped dest frame) m)
    (i : UInt64) (hi : i.toNat < src.length) :
    (heapN self sp tp dp mp src tgt dropped dest frame).loadB (sp + i.toBitVec * 8) .W64
      = .ok (src[i.toNat]'hi).word := by
  have hi' : i.toBitVec.toNat < src.length := by simpa using hi
  have h := load_src hh i.toBitVec hi'
  rw [h]
  simp only [Lift.Sem.Res.ok.injEq]
  exact congrArg Lift.Pilot.Slot.word (getElem_nat_congr (UInt64.toNat_toBitVec i) hi' hi)
end loop

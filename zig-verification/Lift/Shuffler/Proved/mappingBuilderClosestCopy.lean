theorem call_summary : callSummary := by
  intro self sp tp dp mp frame src tgt dropped dest t loc a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 self sp tp dp mp frame src tgt dropped dest t loc () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨r, hrel, hmap⟩⟩

/-- The pairs that `Lift.Pilot.ClosestCopySpec.run` folds over. -/
def pairs (src : List Lift.Pilot.Slot) : List (Fin 1024 × Lift.Pilot.Slot) :=
  (List.finRange 1024).zip src

/-- One step of the fold of `Lift.Pilot.ClosestCopySpec.run`, the same function. -/
def stepF (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) :
    BitVec 64 → Fin 1024 × Lift.Pilot.Slot → BitVec 64
  | best, (i, s) =>
    if tgt[t]?.any (Lift.Pilot.ShallowestSpec.eql s) ∧ dropped[i] = 0 ∧
        dest[i] = Lift.Pilot.IsRetainedSpec.none64 ∧
        Lift.Pilot.ClosestCopySpec.inWildcardSlot tgt i = decide (loc ≠ 0) then
      if best = Lift.Pilot.IsRetainedSpec.none64 ∨
          Lift.Pilot.ClosestCopySpec.absDiff i t ≤
            Lift.Pilot.ClosestCopySpec.absDiff best.toNat t then
        BitVec.ofNat 64 i
      else best
    else best

/-- The accumulator of the fold of `Lift.Pilot.ClosestCopySpec.run` after the first `n` pairs. -/
def bestAt (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (src : List Lift.Pilot.Slot)
    (n : Nat) : BitVec 64 :=
  ((pairs src).take n).foldl (stepF tgt dropped dest t loc) Lift.Pilot.IsRetainedSpec.none64

/-- The result of the loop: the fold over all the pairs; it does not depend on the state. -/
def outF (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (_ : St In2p Heap) : UInt64 :=
  UInt64.ofBitVec
    ((pairs src).foldl (stepF tgt dropped dest t loc) Lift.Pilot.IsRetainedSpec.none64)

/-- The loop invariant: the source size in `rcx`, the counters, and the accumulator of the fold. -/
def invF (a : In2p) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8) (src : List Lift.Pilot.Slot)
    (x : St In2p Heap) : Prop :=
  x.input = a ∧ x.mem = a.heap ∧ x.rcx.toNat = src.length ∧ x.r9.toNat ≤ src.length ∧
    x.r11 = a.rsi - x.r9 ∧ x.r8 = 0 - a.rsi ∧ x.r10 = 4294967296 ∧
    x.rax.toBitVec = bestAt tgt dropped dest t loc src x.r9.toNat

theorem map_toCell_flatMap (w : Width) (l : List w.type) :
    List.map Lift.Sem.Bridge.toCell
        (List.flatMap (fun v => [({ w := w, v := v } : Lift.Trusted.Field)]) l)
      = List.map (Lift.Sem.Cell.mk w) l := by
  induction l with
  | nil => rfl
  | cons v l ih => simp [List.flatMap_cons, ih, Lift.Sem.Bridge.toCell]

theorem toObj_encode_vector8 (p : BitVec 64) (xs : Vector (BitVec 8) 1024) (wr : Bool) :
    Lift.Sem.Bridge.toObj ⟨p, Lift.Trusted.Encode.encode xs, wr⟩
      = Lift.Sem.Obj.words p wr .W8 xs.toList := by
  simp only [Lift.Sem.Bridge.toObj, Lift.Sem.Obj.words, Lift.Trusted.Encode.encode]
  exact congrArg (fun cs => ({ addr := p, writable := wr, cells := cs } : Lift.Sem.Obj))
    (map_toCell_flatMap .W8 xs.toList)

theorem toObj_encode_vector64 (p : BitVec 64) (xs : Vector (BitVec 64) 1024) (wr : Bool) :
    Lift.Sem.Bridge.toObj ⟨p, Lift.Trusted.Encode.encode xs, wr⟩
      = Lift.Sem.Obj.words p wr .W64 xs.toList := by
  simp only [Lift.Sem.Bridge.toObj, Lift.Sem.Obj.words, Lift.Trusted.Encode.encode]
  exact congrArg (fun cs => ({ addr := p, writable := wr, cells := cs } : Lift.Sem.Obj))
    (map_toCell_flatMap .W64 xs.toList)

/-- The heap of `objsP`, with the arrays as `Obj.words`. -/
def heapN (self sp tp dp mp : BitVec 64) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (frame : Heap) : Heap :=
  ⟨self, false, [⟨.W64, sp⟩]⟩ ::
  ⟨self + 8, false, [⟨.W64, BitVec.ofNat 64 src.length⟩]⟩ ::
  ⟨self + 16, false, [⟨.W64, tp⟩]⟩ ::
  ⟨self + 24, false, [⟨.W64, BitVec.ofNat 64 tgt.length⟩]⟩ ::
  ⟨self + 32, false, [⟨.W64, dp⟩]⟩ ::
  ⟨self + 48, false, [⟨.W64, mp⟩]⟩ ::
  Lift.Sem.Obj.words sp false .W64 (src.map Lift.Pilot.Slot.word) ::
  Lift.Sem.Obj.words tp false .W64 (tgt.map Lift.Pilot.Slot.word) ::
  Lift.Sem.Obj.words dp false .W8 dropped.toList ::
  Lift.Sem.Obj.words mp false .W64 dest.toList :: frame

theorem heapN_eq (self sp tp dp mp : BitVec 64) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (t : Nat) (loc : BitVec 8)
    (frame : Heap) :
    objsP self sp tp dp mp src tgt dropped dest t loc ++ frame
      = heapN self sp tp dp mp src tgt dropped dest frame := by
  unfold objsP Lift.Shuffler.Internal.ClosestCopyStatement.objects heapN
  simp only [List.map_cons, List.map_nil, List.cons_append, List.nil_append,
    Lift.Sem.Bridge.toObj_encode_words64, toObj_encode_vector8, toObj_encode_vector64]
  simp only [Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, Lift.Trusted.Encode.encode, List.map_cons,
    List.map_nil]


theorem eql_iff_and (a b : Lift.Pilot.Slot) :
    (Lift.Pilot.ShallowestSpec.eql a b = true) ↔
      (a.word &&& 281474976710655 = b.word &&& 281474976710655) := by
  obtain ⟨p, k, o, d⟩ := a; obtain ⟨p', k', o', d'⟩ := b
  simp only [Lift.Pilot.ShallowestSpec.eql, Lift.Pilot.Slot.word, Bool.and_eq_true,
    decide_eq_true_eq]

theorem absDiff_best (a b : UInt64) :
    Lift.Pilot.ClosestCopySpec.absDiff a.toNat b.toNat =
      (if b ≤ a then (a - b).toNat else (b - a).toNat) := by
  by_cases h : b ≤ a
  · have h' : b.toNat ≤ a.toNat := UInt64.le_iff_toNat_le.mp h
    rw [ite_eq_left h, UInt64.toNat_sub_of_le _ _ h]
    unfold Lift.Pilot.ClosestCopySpec.absDiff
    split <;> omega
  · have h' : ¬ (b.toNat ≤ a.toNat) := fun hh => h (UInt64.le_iff_toNat_le.mpr hh)
    rw [ite_eq_right h, UInt64.toNat_sub_of_le _ _ (UInt64.le_iff_toNat_le.mpr (by omega))]
    unfold Lift.Pilot.ClosestCopySpec.absDiff
    split <;> omega

theorem absDiff_idx (r9 r11 r8 rsi : UInt64) (i t : Nat) (hr9 : r9.toNat = i) (hrsi : rsi.toNat = t)
    (hr11 : r11 = rsi - r9) (hr8 : r8 = 0 - rsi) :
    (if r9 ≤ rsi then r11 else r8 + r9).toNat = Lift.Pilot.ClosestCopySpec.absDiff i t := by
  by_cases h : r9 ≤ rsi
  · have hi : i ≤ t := by rw [← hr9, ← hrsi]; exact UInt64.le_iff_toNat_le.mp h
    rw [ite_eq_left h, hr11, UInt64.toNat_sub_of_le _ _ h]
    unfold Lift.Pilot.ClosestCopySpec.absDiff
    rw [ite_eq_right (by omega)]
    omega
  · have hi : ¬ i ≤ t := by rw [← hr9, ← hrsi]; exact fun hh => h (UInt64.le_iff_toNat_le.mpr hh)
    rw [ite_eq_right h, hr8]
    have e : (0 - rsi) + r9 = r9 - rsi := by
      apply UInt64.toBitVec_inj.mp
      simp [UInt64.toBitVec_add, UInt64.toBitVec_sub]
      bv_omega
    rw [e, UInt64.toNat_sub_of_le _ _ (UInt64.le_iff_toNat_le.mpr (by omega))]
    unfold Lift.Pilot.ClosestCopySpec.absDiff
    rw [ite_eq_left (by omega)]
    omega

theorem inWildcardSlot_get (tgt : List Lift.Pilot.Slot) (i : Nat) (hi : i < tgt.length) :

def callInput (a : skel_call.In2p) : In2p := { heap := a.heap, rbx := a.rbx, rdx := a.rdx, rsi := a.rsi, rdi := a.rdi, rbp := a.rbp, r14 := a.r14, r15 := a.r15, sp := a.sp }


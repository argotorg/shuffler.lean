    have hy' : (pairs src).foldl (stepF tgt dropped dest t loc) Lift.Pilot.IsRetainedSpec.none64 = y := by
      simp only [Lift.Pilot.ClosestCopySpec.run, hC, ite_true, Option.some.injEq, pairs] at hy ⊢
      exact hy
    refine ⟨⟨rfl, rfl, ?_, ?_, ?_, rfl, rfl, ?_⟩, ?_⟩
    · rw [hv, UInt64.toNat_ofBitVec, BitVec.toNat_ofNat]
      exact Nat.mod_eq_of_lt (by have := hC.1; omega)
    · simp
    · simp

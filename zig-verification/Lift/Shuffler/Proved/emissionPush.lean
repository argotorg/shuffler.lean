theorem loadB_size {self data trace mapping : BitVec 64} {st : Zig.St}
    {policy : CpuPolicy} {m : DataMem} {h : Heap} (hh : h.Holds policy m)
    (ho : sizeObj self data trace mapping st ∈ h) :
    h.loadB (self + 48) .W64 = .ok st.size := by
  have ho' : (⟨self + 48, true, [⟨.W64, st.size⟩]⟩ : Obj) ∈ h := by rwa [eq_sizeObj] at ho
  exact loadB_cell64 hh ho' rfl rfl


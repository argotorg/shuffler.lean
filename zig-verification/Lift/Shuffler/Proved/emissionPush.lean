theorem call_bridge_step (l : Lbl) (x : St In2p Heap) (y : St skel_call.In2p Heap)
    (hs : callState x y) :
    ∀ n, blocksP.step l x = .ok n →
      Next.Sim (fun f => f.elim) (fun f => f.elim) callState (fun r q => r = q) n
        (skel_call.blocksP.step l y) := by
  intro n ht
  rcases hs with ⟨hinput, hrax, hrcx, hr8, hr9, hmem, htrue⟩
  cases l <;> simp only [blocksP, callInput, hinput, hrax, hrcx, hr8, hr9, hmem] at ht
  all_goals repeat' split at ht
  all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
  all_goals subst n
  all_goals simp_all [skel_call.blocksP, Next.Sim, callState, callInput, ← UInt64.not_le]
theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : (UInt64 × Heap)) (q : (UInt64 × Heap)) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  change ∃ yl, skel_call.blocksP.Returns noCall .entry (skel_call.initP b) yl ∧ r = yl
  obtain ⟨q, hq, hqr⟩ := Blocks.Returns.sim (l := .entry) (x := initP (callInput b))
    (y := skel_call.initP b) (r := r) (fun f => f.elim) (fun f => f.elim)
    callState (fun (r : UInt64 × Heap) (q : (UInt64 × Heap)) => r = q)
    (fun f => f.elim)
    (fun l x y n hs ht => call_bridge_step l x y hs n ht)
    (show blocksP.Returns noCall .entry (initP (callInput b)) r from hr)
    (by simp [callState, initP, skel_call.initP, callInput])
  exact ⟨q, hq, hqr⟩
end call_bridge.skel_proof
theorem call_bridge : call_bridge.skel_statement := @call_bridge.skel_proof.call_bridge
def call_bridge_rev.skel_statement : Prop := Refines (fun a b => b = callInput a) (fun _ _ (q : (UInt64 × Heap)) (r : (UInt64 × Heap)) => r = q) skel_call.l2p.returns l2p.returns

theorem size_sizeObj_ne_traceSizeObj {self data trace mapping : BitVec 64} {st : Zig.St} :
    sizeObj self data trace mapping st ≠ traceSizeObj self data trace mapping st := by
  intro e
  have h1 := congrArg Obj.addr e
  rw [addr_sizeObj, addr_traceSizeObj] at h1
  have h2 : (self + 48).toNat = (self + 64).toNat := by rw [h1]
  bv_omega

theorem spans_dataObj {self data trace mapping : BitVec 64} {st : Zig.St} {k : BitVec 64}
    (hk : k.toNat < 1024) (hn : data.toNat + 1024 * 8 ≤ 2 ^ 64) :
    (dataObj self data trace mapping st).Spans (data + k * 8) .W64 := by
  have hobj : dataObj self data trace mapping st =
      Obj.mk data true ((List.range 1024).map (fun i =>
        (⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord (st.data.toList.getD i default)
          (st.pad.toList.getD i 0)⟩ : Cell))) := by
    simp [dataObj, envP, Bridge.toObj, Bridge.toCell,
      Lift.Shuffler.Internal.Proposed.PushStatement.envOf,
      Lift.Shuffler.Internal.Proposed.Layout.data, List.map_map, Function.comp_def,
      FlatShuffler.maxStackSize]
  rw [hobj]
  refine spans_cells64 ?_ ?_ ?_
  · intro c hc
    simp only [List.mem_map] at hc
    obtain ⟨i, -, rfl⟩ := hc
    rfl
  · simpa using hk
  · simpa using hn

theorem spans_destObj {self data trace mapping : BitVec 64} {st : Zig.St} {k : BitVec 64}
    (hk : k.toNat < st.dest.toList.length)
    (hn : mapping.toNat + st.dest.toList.length * 8 ≤ 2 ^ 64) :
    (destObj self data trace mapping st).Spans (mapping + k * 8) .W64 := by
  have hobj : destObj self data trace mapping st = Obj.words mapping true .W64 st.dest.toList := by
    simp only [destObj, envP, Bridge.toObj, Bridge.toCell,
      Lift.Shuffler.Internal.Proposed.PushStatement.envOf,
      Lift.Shuffler.Internal.Proposed.Layout.dest, Obj.words, List.map_map, Function.comp_def,
      Cell.mk]
  rw [hobj]
  exact spans_words_bv hk hn


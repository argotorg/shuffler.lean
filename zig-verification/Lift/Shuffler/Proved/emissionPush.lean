/-- The trace array of the statement is an object of the statement's heap. -/
theorem mem_traceObj {self data trace mapping : BitVec 64} {st : Zig.St}
    {slot : FlatShuffler.StackSlot} {slotPad : BitVec 16} {destination : FlatShuffler.Word}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240} :
    traceObj trace trace0 ∈ objsP self data trace mapping st slot slotPad destination trace0 := by
  have hmem : (⟨trace, trace0.toList.flatMap (fun t => ([⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] : List Lift.Trusted.Field)), true⟩ : Lift.Trusted.Object) ∈
      Lift.Shuffler.Internal.Proposed.PushStatement.objects st slot slotPad destination trace0
        (envP self data trace mapping) := by
    simp only [Lift.Shuffler.Internal.Proposed.PushStatement.objects]
    exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
      (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_self ..)))))
  have h := mem_objsP hmem
  simp only [Bridge.toObj] at h
  rw [traceCells_map] at h
  exact h


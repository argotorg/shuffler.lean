 theorem forget_frame {objs frame keep : Heap} {policy : CpuPolicy} {g0 g : Obj → Obj}
    {m : DataMem} (h : FrameHeap objs frame keep policy g0 g m) :
    FrameHeap objs frame [] policy id g m :=
  ⟨h.1, h.2.1, by simp, h.2.2.2.1, h.2.2.2.2⟩

def PartitionInv (objs frame : Heap) (a : skel_call.In2p) (self data trace mapping : BitVec 64)
    (st : Zig.St) : Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x.input = a ∧ x.mem = a.heap
  | .o21, x => x.input = a ∧ x.mem = a.heap ∧ x.rcx = UInt64.ofBitVec st.size ∧
      st.size.toNat < 1024
  | .o46, x => x.input = a ∧ x.rcx = UInt64.ofBitVec (BitVec.ofNat 64 st.trace.length) ∧
      (BitVec.ofNat 64 st.trace.length).toNat < 10240 ∧ st.size.toNat < 1024 ∧
      ∃ g m, x.mem = objs.map g ++ frame ∧
        FrameHeap objs frame
          [sizeObj self data trace mapping st, traceSizeObj self data trace mapping st]
          a.policy (Obj.set (self + 48) .W64 (st.size + 1)) g m
  | .o134, x => x.input = a ∧ x.rcx = UInt64.ofBitVec mapping ∧ st.size.toNat < 1024 ∧
      ∃ g m, x.mem = objs.map g ++ frame ∧
        FrameHeap objs frame [sizeObj self data trace mapping st]
          a.policy (Obj.set (self + 48) .W64 (st.size + 1)) g m
  | .LBB15_4, x => x.input = a ∧ ∃ (g : Obj → Obj) (m : DataMem), x.mem = objs.map g ++ frame ∧ FrameHeap objs frame [] a.policy id g m
theorem push_partition : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre self data trace mapping frame st slot slotPad destination trace0 a → skel_call.l2p.returns a q → ∃ (g : Obj → Obj) (m : DataMem), q.2 = (objsP self data trace mapping st slot slotPad destination trace0).map g ++ frame ∧ FrameHeap (objsP self data trace mapping st slot slotPad destination trace0) frame [] a.policy id g m := by
  intro self data trace mapping frame st slot slotPad destination trace0 a q hpre hret
  simp only [callPre, SimArr, callInput] at hpre
  obtain ⟨hC, hrdi, hrsi, hrdx, hheap, m0, hm0⟩ := hpre
  obtain ⟨⟨hsizeC, htraceC, hdestC⟩, -⟩ := hC
  have hrdi' : a.rdi.toBitVec = self := hrdi
  have hh0 : Heap.Holds a.policy a.heap m0 := hm0
  have hmem_objs : ∀ o ∈ objsP self data trace mapping st slot slotPad destination trace0, o ∈ a.heap := by
    intro o ho; rw [hheap]; exact List.mem_append_left _ ho
  have hlen_dest : st.dest.toList.length = 1024 := by rw [Vector.length_toList]; rfl
  have hlen_pos : st.pos.toList.length = 1024 := by rw [Vector.length_toList]; rfl
  have hn_data : data.toNat + 1024 * 8 ≤ 2 ^ 64 := by
    have h := hh0.noWrap (dataObj self data trace mapping st) (hmem_objs _ mem_dataObj)
    rw [addr_dataObj, size_dataObj] at h
    simpa using h
  have hn_trace : trace.toNat + 10240 * 12 ≤ 2 ^ 64 := by
    have h := hh0.noWrap (traceObj trace trace0) (hmem_objs _ mem_traceObj)
    rw [size_traceObj] at h
    simpa using h
  have hn_size : (self + 48).toNat + 8 ≤ 2 ^ 64 := by
    have h := hh0.noWrap (sizeObj self data trace mapping st) (hmem_objs _ mem_sizeObj)
    rw [addr_sizeObj, size_sizeObj] at h
    simpa using h
  have hn_traceSize : (self + 64).toNat + 8 ≤ 2 ^ 64 := by
    have h := hh0.noWrap (traceSizeObj self data trace mapping st) (hmem_objs _ mem_traceSizeObj)
    rw [addr_traceSizeObj, size_traceSizeObj] at h
    simpa using h
  have hn_dest : mapping.toNat + 1024 * 8 ≤ 2 ^ 64 := by
    have h := hh0.noWrap (destObj self data trace mapping st) (hmem_objs _ mem_destObj)
    rw [addr_destObj, size_destObj] at h
    simpa using h
  have hn_pos : (mapping + 8192).toNat + 1024 * 8 ≤ 2 ^ 64 := by
    have h := hh0.noWrap (posObj self data trace mapping st) (hmem_objs _ mem_posObj)
    rw [addr_posObj, size_posObj] at h
    simpa using h
  have hne_ts : traceObj trace trace0 ≠ sizeObj self data trace mapping st := by
    refine ne_of_size ?_; rw [size_traceObj, size_sizeObj]; omega
  have hne_tt : traceObj trace trace0 ≠ traceSizeObj self data trace mapping st := by
    refine ne_of_size ?_; rw [size_traceObj, size_traceSizeObj]; omega
  have hne_st : sizeObj self data trace mapping st ≠ traceSizeObj self data trace mapping st :=
    size_sizeObj_ne_traceSizeObj
  have hne_ds : dataObj self data trace mapping st ≠ sizeObj self data trace mapping st := by
    refine ne_of_size ?_; rw [size_dataObj, size_sizeObj]; omega
  have hne_dt : dataObj self data trace mapping st ≠ traceSizeObj self data trace mapping st := by
    refine ne_of_size ?_; rw [size_dataObj, size_traceSizeObj]; omega
  have hne_Des : destObj self data trace mapping st ≠ sizeObj self data trace mapping st := by
    refine ne_of_size ?_; rw [size_destObj, size_sizeObj]; omega
  have hne_Ps : posObj self data trace mapping st ≠ sizeObj self data trace mapping st := by
    refine ne_of_size ?_; rw [size_posObj, size_sizeObj]; omega
  have hset_t : Obj.set (self + 48) .W64 (st.size + 1) (traceSizeObj self data trace mapping st) =
      traceSizeObj self data trace mapping st := by
    refine obj_set_of_not ?_ ?_
    · rw [addr_traceSizeObj, size_traceSizeObj]; omega
    · exact fun hc => not_spans_of_apart
        (apart_of_holds hh0 (hmem_objs _ mem_sizeObj) (hmem_objs _ mem_traceSizeObj)
          hne_st (Or.inl rfl)) spans_sizeObj hc.2
  have hsub2 : ∀ o ∈ [sizeObj self data trace mapping st, traceSizeObj self data trace mapping st],
      o ∈ objsP self data trace mapping st slot slotPad destination trace0 := by
    intro o ho
    simp only [List.mem_cons, List.not_mem_nil, or_false] at ho
    rcases ho with rfl | rfl
    exact mem_sizeObj
    exact mem_traceSizeObj
  have hsub1 : ∀ o ∈ [sizeObj self data trace mapping st],
      o ∈ objsP self data trace mapping st slot slotPad destination trace0 := by
    intro o ho
    simp only [List.mem_singleton] at ho
    subst ho
    exact mem_sizeObj
  simp only [skel_call.l2p] at hret
  have key : ∃ (g : Obj → Obj) (m : DataMem),
      q.2 = (objsP self data trace mapping st slot slotPad destination trace0).map g ++ frame ∧ FrameHeap (objsP self data trace mapping st slot slotPad destination trace0) frame [] a.policy id g m := by
    refine Lift.Sem.CallArm.Blocks.Returns.inv
      (PartitionInv (objsP self data trace mapping st slot slotPad destination trace0) frame a
        self data trace mapping st)
      (fun r => ∃ (g : Obj → Obj) (m : DataMem),
        r.2 = (objsP self data trace mapping st slot slotPad destination trace0).map g ++ frame ∧ FrameHeap (objsP self data trace mapping st slot slotPad destination trace0) frame [] a.policy id g m) ?_ hret ?_
    · rintro l x n hI hs
      cases l with
      | entry =>
        obtain ⟨hinput, hmem⟩ := hI
        simp only [skel_call.blocksP] at hs
        cases hl : Heap.loadB x.mem (x.input.rdi.toBitVec + 48) .W64 with
        | ok v =>
          have hh : Heap.Holds a.policy x.mem m0 := hmem ▸ hm0
          have hmem_size : sizeObj self data trace mapping st ∈ x.mem := by
            rw [hmem, hheap]; exact List.mem_append_left _ mem_sizeObj
          have hl' : Heap.loadB x.mem (x.input.rdi.toBitVec + 48) .W64 = .ok st.size := by
            rw [hinput, hrdi']
            exact loadB_size hh hmem_size
          rw [hl] at hl'
          simp only [Res.ok.injEq] at hl'
          subst hl'
          rw [hl] at hs
          dsimp only at hs
          simp only [Res.ok.injEq] at hs
          subst n
          split
          · refine ⟨hinput, id, m0, ?_, ?_⟩
            · show x.mem = (objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame
              rw [List.map_id, hmem]
              exact hheap
            · exact ⟨fun _ _ => rfl, fun _ _ _ => rfl, by simp, fun _ _ => rfl, by simpa [hheap] using hm0⟩
          · rename_i hguard
            have hbnd : st.size.toNat < 1024 := by
              have h1 : UInt64.ofBitVec st.size ≤ (1023 : UInt64) := UInt64.not_lt.mp hguard
              have h2 := UInt64.le_iff_toNat_le.mp h1
              have h3 : (1023 : UInt64).toNat = 1023 := by decide
              simp only [UInt64.toNat_ofBitVec, h3] at h2
              omega
            exact ⟨hinput, hmem, rfl, hbnd⟩
        | stuck why => rw [hl] at hs; cases hs
        | noFuel => rw [hl] at hs; cases hs
      | o21 =>
        obtain ⟨hinput, hmem, hrcx, hbnd⟩ := hI
        simp only [skel_call.blocksP] at hs
        have hmapid : objsP self data trace mapping st slot slotPad destination trace0 ++ frame =
            (objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame := by
          rw [List.map_id]
        have hrcxb : x.rcx.toBitVec = st.size := by rw [hrcx, UInt64.toBitVec_ofBitVec]
        rw [hinput, hrdi', hmem, hheap, hmapid, hrcxb] at hs
        have hh0' : Heap.Holds a.policy
            ((objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame) m0 := by
          rw [List.map_id, ← hheap]; exact hm0
        have hrel0 : FrameHeap (objsP self data trace mapping st slot slotPad destination trace0) frame
            [sizeObj self data trace mapping st, traceSizeObj self data trace mapping st]
            a.policy id id m0 :=
          ⟨fun _ _ => rfl, fun _ _ _ => rfl, fun _ _ => rfl, fun _ _ => rfl, hh0'⟩
        have hmem_dp : dataPtrObj self data trace mapping ∈
            (objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame :=
          List.mem_append_left _ (List.mem_map_of_mem mem_dataPtrObj)
        have hmem_data : dataObj self data trace mapping st ∈
            (objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame :=
          List.mem_append_left _ (List.mem_map_of_mem mem_dataObj)
        have hmem_size : sizeObj self data trace mapping st ∈
            (objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame :=
          List.mem_append_left _ (List.mem_map_of_mem mem_sizeObj)
        have hmem_ts : traceSizeObj self data trace mapping st ∈
            (objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame :=
          List.mem_append_left _ (List.mem_map_of_mem mem_traceSizeObj)
        cases hl : Heap.loadB
            ((objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame)
            (self + 40) .W64 with
        | ok v =>
          have hv : v = data := by
            have h2 : Heap.loadB
                ((objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame)
                (self + 40) .W64 = .ok data := loadB_dataPtr hh0' hmem_dp
            rw [hl] at h2
            simpa using h2
          rw [hl] at hs
          dsimp only at hs
          rw [hv] at hs
          have hsp1 : (dataObj self data trace mapping st).Spans (data + st.size * 8) .W64 :=
            spans_dataObj hbnd hn_data
          have hkeep1 : ∀ o ∈ [sizeObj self data trace mapping st,
              traceSizeObj self data trace mapping st],
              ¬ (o.writable = true ∧ o.Spans (data + st.size * 8) .W64) := by
            intro o ho
            simp only [List.mem_cons, List.not_mem_nil, or_false] at ho
            rcases ho with rfl | rfl
            · exact fun hc => not_spans_of_apart
                (apart_of_holds hh0 (hmem_objs _ mem_dataObj) (hmem_objs _ mem_sizeObj)
                  hne_ds (Or.inl rfl)) hsp1 hc.2
            · exact fun hc => not_spans_of_apart
                (apart_of_holds hh0 (hmem_objs _ mem_dataObj) (hmem_objs _ mem_traceSizeObj)
                  hne_dt (Or.inl rfl)) hsp1 hc.2
          cases h1 : Heap.storeB
            ((objsP self data trace mapping st slot slotPad destination trace0).map id ++ frame)
            (data + st.size * 8) .W64 a.rsi.toBitVec with
          | ok h1' =>
            rw [h1] at hs
            dsimp only at hs
            obtain ⟨g1, m1, hm1, hrel1, hfix1⟩ :=
              FrameHeap.storeB hrel0
                (by intro o ho
                    simp only [List.mem_cons, List.not_mem_nil, or_false] at ho
                    rcases ho with rfl | rfl
                    exact mem_sizeObj
                    exact mem_traceSizeObj)
                ⟨dataObj self data trace mapping st, mem_dataObj, writable_dataObj, hsp1⟩
                hkeep1 h1
            have hg1s : g1 (sizeObj self data trace mapping st) =
                sizeObj self data trace mapping st := hfix1 _ (by simp)
            have hload1 : h1'.loadB (self + 48) .W64 = .ok st.size := by
              rw [hm1]
              have hm : sizeObj self data trace mapping st ∈
                  (objsP self data trace mapping st slot slotPad destination trace0).map g1 ++ frame := by
                have hm0 : g1 (sizeObj self data trace mapping st) ∈
                    (objsP self data trace mapping st slot slotPad destination trace0).map g1 :=
                  List.mem_map_of_mem mem_sizeObj
                rw [hg1s] at hm0
                exact List.mem_append_left _ hm0
              exact loadB_size hrel1.2.2.2.2 hm
            cases h2 : h1'.loadB (self + 48) .W64 with
            | ok v1 =>
              have hv1 : v1 = st.size := by
                have h2' : Heap.loadB (h1') (self + 48) .W64 = .ok st.size := hload1
                rw [h2] at h2'
                simpa using h2'
              rw [h2] at hs
              dsimp only at hs
              rw [hv1] at hs
              rw [hm1] at hs
              have hg1t : g1 (traceSizeObj self data trace mapping st) =
                  traceSizeObj self data trace mapping st := hfix1 _ (by simp)
              have hcell_size : ((g1 (sizeObj self data trace mapping st)).get (self + 48) .W64).isSome
                  = true := by
                rw [hg1s, get_sizeObj]; rfl
              have hkeep2 : ∀ o ∈ [traceSizeObj self data trace mapping st],
                  ¬ (o.writable = true ∧ o.Spans (self + 48) .W64) := by
                intro o ho
                simp only [List.mem_singleton] at ho
                subst ho
                exact fun hc => not_spans_of_apart
                  (apart_of_holds hh0 (hmem_objs _ mem_sizeObj) (hmem_objs _ mem_traceSizeObj)
                    hne_st (Or.inl rfl)) spans_sizeObj hc.2
              cases h3 : Heap.storeB
                ((objsP self data trace mapping st slot slotPad destination trace0).map g1 ++ frame)
                (self + 48) .W64 (st.size + 1) with
              | ok h3' =>
                rw [h3] at hs
                dsimp only at hs
                obtain ⟨g2, m2, hm2, hrel2, hfix2, hg2⟩ :=
                  FrameHeap.storeB_cell
                    (FrameHeap.mono_keep hrel1
                      (by intro o ho
                          simp only [List.mem_singleton] at ho
                          subst ho
                          exact List.mem_cons_of_mem _ (List.mem_cons_self ..)))
                    (by intro o ho
                        simp only [List.mem_singleton] at ho
                        subst ho
                        exact mem_traceSizeObj)
                    mem_sizeObj writable_sizeObj hcell_size hkeep2 h3
                rw [hm2] at hs
                have hset_t : Obj.set (self + 48) .W64 (st.size + 1)
                    (traceSizeObj self data trace mapping st) =
                    traceSizeObj self data trace mapping st := by
                  refine obj_set_of_not ?_ ?_
                  · rw [addr_traceSizeObj, size_traceSizeObj]; omega
                  · exact fun hc => not_spans_of_apart
                      (apart_of_holds hh0 (hmem_objs _ mem_sizeObj) (hmem_objs _ mem_traceSizeObj)
                        hne_st (Or.inl rfl)) spans_sizeObj hc.2
                have hset_s : Obj.set (self + 48) .W64 (st.size + 1)
                    (sizeObj self data trace mapping st) =
                    ⟨self + 48, true, [⟨.W64, st.size + 1⟩]⟩ := by
                  rw [eq_sizeObj]
                  simp [Obj.set, setCells, Cell.get]
                have hrebase : ∀ o ∈ [sizeObj self data trace mapping st,
                    traceSizeObj self data trace mapping st],
                    g2 o = Obj.set (self + 48) .W64 (st.size + 1) o := by
                  intro o ho
                  simp only [List.mem_cons, List.not_mem_nil, or_false] at ho
                  rcases ho with rfl | rfl
                  · rw [hg2, hg1s, hset_s]
                  · rw [hfix2 _ (by simp), hg1t, hset_t]
                have hrel3 : FrameHeap (objsP self data trace mapping st slot slotPad destination trace0)
                    frame [sizeObj self data trace mapping st, traceSizeObj self data trace mapping st]
                    a.policy (Obj.set (self + 48) .W64 (st.size + 1)) g2 m2 :=
                  ⟨hrel2.1, hrel2.2.1, hrebase, hrel2.2.2.2.1, hrel2.2.2.2.2⟩
                have hg2t : g2 (traceSizeObj self data trace mapping st) =
                    traceSizeObj self data trace mapping st := by
                  rw [hrebase _ (by simp), hset_t]
                have hload2 : Heap.loadB
                    ((objsP self data trace mapping st slot slotPad destination trace0).map g2 ++ frame)
                    (self + 64) .W64 = .ok (BitVec.ofNat 64 st.trace.length) := by
                  have hm : traceSizeObj self data trace mapping st ∈
                      (objsP self data trace mapping st slot slotPad destination trace0).map g2 ++ frame := by
                    have hm0 : g2 (traceSizeObj self data trace mapping st) ∈
                        (objsP self data trace mapping st slot slotPad destination trace0).map g2 :=
                      List.mem_map_of_mem mem_traceSizeObj
                    rw [hg2t] at hm0
                    exact List.mem_append_left _ hm0
                  exact loadB_traceSize hrel3.2.2.2.2 hm
                cases h4 : Heap.loadB
                    ((objsP self data trace mapping st slot slotPad destination trace0).map g2 ++ frame)
                    (self + 64) .W64 with
                | ok v2 =>
                  have hv2 : v2 = BitVec.ofNat 64 st.trace.length := by
                    have h4' : Heap.loadB
                        ((objsP self data trace mapping st slot slotPad destination trace0).map g2 ++ frame)
                        (self + 64) .W64 = .ok (BitVec.ofNat 64 st.trace.length) := hload2
                    rw [h4] at h4'
                    simpa using h4'
                  rw [h4] at hs
                  dsimp only at hs
                  rw [hv2] at hs
                  simp only [Res.ok.injEq] at hs
                  subst n
                  split
                  · exact ⟨rfl, g2, m2, rfl, forget_frame hrel3⟩
                  · rename_i hguard
                    have hbnd2 : (BitVec.ofNat 64 st.trace.length).toNat < 10240 := by
                      have h1 : UInt64.ofBitVec (BitVec.ofNat 64 st.trace.length) ≤ (10239 : UInt64) :=
                        UInt64.not_lt.mp hguard
                      have h2 := UInt64.le_iff_toNat_le.mp h1
                      have h3 : (10239 : UInt64).toNat = 10239 := by decide
                      simp only [UInt64.toNat_ofBitVec, h3] at h2
                      omega
                    exact ⟨rfl, rfl, hbnd2, hbnd, g2, m2, rfl, hrel3⟩
                | stuck why => rw [h4] at hs; cases hs
                | noFuel => rw [h4] at hs; cases hs
              | stuck why => rw [h3] at hs; cases hs
              | noFuel => rw [h3] at hs; cases hs
            | stuck why => rw [h2] at hs; cases hs
            | noFuel => rw [h2] at hs; cases hs
          | stuck why => rw [h1] at hs; cases hs
          | noFuel => rw [h1] at hs; cases hs
        | stuck why => rw [hl] at hs; cases hs
        | noFuel => rw [hl] at hs; cases hs
      | o46 =>
        obtain ⟨hinput, hrcx, hbndT, hbnd, hrest⟩ := hI
        obtain ⟨g, m', hmem, hrel⟩ := hrest
        simp only [skel_call.blocksP] at hs
        have hrcxb : x.rcx.toBitVec = BitVec.ofNat 64 st.trace.length := by
          rw [hrcx, UInt64.toBitVec_ofBitVec]
        rw [hinput, hrdi', hmem, hrcxb, hrdx] at hs
        have hhold : Heap.Holds a.policy
            ((objsP self data trace mapping st slot slotPad destination trace0).map g ++ frame) m' :=
          hrel.2.2.2.2
        have hspT0 : (traceObj trace trace0).Spans
            (trace + BitVec.ofNat 64 st.trace.length * 12) .W8 := by
          have h := spans_trace_at (base := trace) (trace0 := trace0)
            (K := BitVec.ofNat 64 st.trace.length) (off := 0) (w := .W8) hbndT
            (by simp [Width.bytes]) hn_trace
          simpa using h
        have hspT1 : (traceObj trace trace0).Spans
            (trace + BitVec.ofNat 64 st.trace.length * 12 + 1) .W8 := by
          have h := spans_trace_at (base := trace) (trace0 := trace0)
            (K := BitVec.ofNat 64 st.trace.length) (off := 1) (w := .W8) hbndT
            (by simp [Width.bytes]) hn_trace
          simpa using h
        have hspT4 : (traceObj trace trace0).Spans
            (trace + BitVec.ofNat 64 st.trace.length * 12 + 4) .W64 := by
          have h := spans_trace_at (base := trace) (trace0 := trace0)
            (K := BitVec.ofNat 64 st.trace.length) (off := 4) (w := .W64) hbndT
            (by simp [Width.bytes]) hn_trace
          simpa using h
        have hkeepT : ∀ (a' : BitVec 64) (w : Width), (traceObj trace trace0).Spans a' w →
            ∀ o ∈ [sizeObj self data trace mapping st, traceSizeObj self data trace mapping st],
              ¬ (o.writable = true ∧ o.Spans a' w) := by
          intro a' w hsp o ho
          simp only [List.mem_cons, List.not_mem_nil, or_false] at ho
          rcases ho with rfl | rfl
          · exact fun hc => not_spans_of_apart
              (apart_of_holds hh0 (hmem_objs _ mem_traceObj) (hmem_objs _ mem_sizeObj)
                hne_ts (Or.inl rfl)) hsp hc.2
          · exact fun hc => not_spans_of_apart
              (apart_of_holds hh0 (hmem_objs _ mem_traceObj) (hmem_objs _ mem_traceSizeObj)
                hne_tt (Or.inl rfl)) hsp hc.2
        have hg_tp : g (tracePtrObj self data trace mapping) = tracePtrObj self data trace mapping :=
          hrel.2.1 _ mem_tracePtrObj rfl
        have hmem_tp : tracePtrObj self data trace mapping ∈
            (objsP self data trace mapping st slot slotPad destination trace0).map g ++ frame := by
          have hm0 : g (tracePtrObj self data trace mapping) ∈
              (objsP self data trace mapping st slot slotPad destination trace0).map g :=
            List.mem_map_of_mem mem_tracePtrObj

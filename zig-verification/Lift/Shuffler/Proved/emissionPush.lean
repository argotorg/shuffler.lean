/-- The invariant of the frame proof of the callee's block model. -/
def FrameInv (objs frame : Heap) (a : skel_call.In2p) (self data trace mapping : BitVec 64)
    (st : Zig.St) : Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x.input = a ∧ x.mem = a.heap
  | .o21, x => x.input = a ∧ x.mem = a.heap ∧ x.rcx = UInt64.ofBitVec st.size ∧
      st.size.toNat < 1024
  | .o46, x => x.input = a ∧ x.rcx = UInt64.ofBitVec (BitVec.ofNat 64 st.trace.length) ∧
      (BitVec.ofNat 64 st.trace.length).toNat < 10240 ∧ st.size.toNat < 1024 ∧
      ∃ g m, x.mem = objs.map g ++ frame ∧
        FrameHeap objs frame
          [sizeObj self data trace mapping st, traceSizeObj self data trace mapping st]
          a.policy (Obj.set (self + 48) .W64 (st.size + 1)) g m
  | .o134, x => x.input = a ∧ x.rcx = UInt64.ofBitVec mapping ∧ st.size.toNat < 1024 ∧
      ∃ g m, x.mem = objs.map g ++ frame ∧
        FrameHeap objs frame [sizeObj self data trace mapping st]
          a.policy (Obj.set (self + 48) .W64 (st.size + 1)) g m
  | .LBB15_4, x => x.input = a ∧ ∃ (g : Obj → Obj) (m : DataMem), x.mem = objs.map g ++ frame

namespace CalleeHeapPartition

open Lift.P2.Total Lift.Sem Lift.Sem.CallArm

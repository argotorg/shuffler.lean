open Lift.P2.Total Lift.Sem Lift.Sem.Bridge

/-- The size of a uniform array of `n` cells. -/
theorem cellsSize_range_map (n : Nat) (w : Width) (f : Nat → w.type) :
    cellsSize ((List.range n).map fun i => (⟨w, f i⟩ : Cell)) = n * w.bytes := by
  induction n with
  | zero => simp [cellsSize]
  | succ n ih =>
    rw [List.range_succ, List.map_append, cellsSize_append, ih]
    simp only [List.map_singleton, cellsSize_cons, cellsSize_nil, List.sum_cons, List.sum_nil,
      List.map_nil, Nat.add_zero]
    rw [Nat.succ_mul]

/-- A store at the element `k` of a uniform array. -/
theorem cellSet_range_map (n k : Nat) (w : Width) (f : Nat → w.type) (v : w.type) (hk : k < n) :
    cellSet ((List.range n).map fun i => (⟨w, f i⟩ : Cell)) (k * w.bytes) w v
      = (List.range n).map (fun i => if i = k then (⟨w, v⟩ : Cell) else ⟨w, f i⟩) := by
  have hb := width_bytes_pos w
  induction n with
  | zero => simp at hk
  | succ n ih =>
    rw [List.range_succ, List.map_append, List.map_append]
    simp only [List.map_cons, List.map_nil]
    rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.mp hk) with h | h
    · rw [cellSet_append_left w v (by rw [cellsSize_range_map]; exact Nat.mul_lt_mul_of_pos_right h hb)]
      rw [ih h, if_neg (show ¬ (n = k) by omega)]
    · subst k
      rw [cellSet_append_right w v (by rw [cellsSize_range_map]; omega)]
      rw [cellsSize_range_map]
      rw [show n * w.bytes - n * w.bytes = 0 by omega, cellSet_cons_zero]
      congr 1
      · apply List.map_congr_left
        intro i hi
        simp only [List.mem_range] at hi
        rw [if_neg (show ¬ (i = n) by omega)]
      · simp

/-- A load of the element `k` of a uniform array. -/
theorem cellGet_range_map (n k : Nat) (w : Width) (f : Nat → w.type) (hk : k < n) :
    cellGet ((List.range n).map fun i => (⟨w, f i⟩ : Cell)) (k * w.bytes) w = some (f k) := by
  have hb := width_bytes_pos w
  induction n with
  | zero => simp at hk
  | succ n ih =>
    rw [List.range_succ, List.map_append]
    simp only [List.map_cons, List.map_nil]
    rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.mp hk) with h | h
    · rw [cellGet_append_left w (by rw [cellsSize_range_map]; exact Nat.mul_lt_mul_of_pos_right h hb)]
      exact ih h
    · subst k
      rw [cellGet_append_right w (by rw [cellsSize_range_map]; omega)]
      rw [cellsSize_range_map]
      rw [show n * w.bytes - n * w.bytes = 0 by omega, cellGet_cons_zero, Cell.get_self]


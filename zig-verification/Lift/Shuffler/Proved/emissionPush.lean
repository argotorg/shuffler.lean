def postP (a : In2p) (r : UInt64 × Heap) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ r.2.Holds a.policy t.data.dmem ∧ ∀ b, ¬ a.heap.Owned b → ¬ SysV.Below s.data.regs.rsp.toBitVec 8 b → t.data.dmem.get? b = s.data.dmem.get? b

def l2p : Model In2p (UInt64 × Heap) where
  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ Heap.Permits policy a.heap ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.emissionPushPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rdx = a.rdx ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ (∀ b, SysV.Below s.data.regs.rsp.toBitVec 8 b → ¬ Covered a.heap b) ∧ SysV.StackRoom policy s 8 ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocksP.Returns noCall .entry (initP a) r
  post := postP


end skel_call

def callInput (a : skel_call.In2p) : In2p := { policy := a.policy, heap := a.heap, rax := a.rax, rdx := a.rdx, rsi := a.rsi, rdi := a.rdi, sp := a.sp }

def callState (x : St In2p Heap) (z : St skel_call.In2p Heap) : Prop := x.input = callInput z.input ∧ x.rax = z.rax ∧ x.rcx = z.rcx ∧ x.r8 = z.r8 ∧ x.r9 = z.r9 ∧ x.mem = z.mem ∧ True


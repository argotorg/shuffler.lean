            (fun t => [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩ : Object)).setAt
        (trace + BitVec.ofNat 64 (st.trace.length * 12)) .W8 k := by

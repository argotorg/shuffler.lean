    (k : BitVec 8) (hlen : st.trace.length < 10240) :
    Heap.StoreAt (trace + BitVec.ofNat 64 (st.trace.length * 12)) .W8 k
      (H self data trace mapping st slot slotPad destination T frame)
      (H self data trace mapping st slot slotPad destination
        (T.set st.trace.length (k, (T[st.trace.length]).2.1, (T[st.trace.length]).2.2.1,
          (T[st.trace.length]).2.2.2)) frame) := by
  have h12 : st.trace.length * 12 < 2 ^ 64 := by omega
  have haddr : (trace + BitVec.ofNat 64 (st.trace.length * 12) - trace).toNat
      = st.trace.length * 12 := by
    have := BitVec.isLt trace
    bv_omega
  have hobj : Bridge.toObj (⟨(PushStatement.envOf self data trace mapping).trace,
        (T.set st.trace.length (k, (T[st.trace.length]).2.1, (T[st.trace.length]).2.2.1,

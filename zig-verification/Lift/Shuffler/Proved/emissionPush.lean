/-- A store of the stack size. -/
theorem H_store_size (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (frame : Heap) :
    Heap.StoreAt (self + 48) .W64 (st.size + 1)
      (H self data trace mapping st slot slotPad destination T frame)
      (H self data trace mapping { st with size := st.size + 1 } slot slotPad destination T frame) := by
  have hobj : Bridge.toObj (Layout.size (PushStatement.envOf self data trace mapping)
        { st with size := st.size + 1 } true)
      = (Bridge.toObj (Layout.size (PushStatement.envOf self data trace mapping) st true)).setAt
        (self + 48) .W64 (st.size + 1) := by
    rw [toObj_size, toObj_size, Obj.setAt]
    simp only [PushStatement.envOf]
    simp [Lift.Sem.cellSet, Width.bytes]
  rw [H_eq_list (st := st) (trace0 := T),
    H_eq_list (st := { st with size := st.size + 1 }) (trace0 := T), hobj]
  refine Heap.StoreAt.head ?_ ?_
  · rw [toObj_size]
  · rw [toObj_size]
    simp [PushStatement.envOf, Lift.Sem.cellGet, Lift.Sem.Cell.get]

/-- A store of the word at the top of the data array. -/
theorem H_store_data (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (frame : Heap)
    (hsize : st.size.toNat < FlatShuffler.maxStackSize) :
    Heap.StoreAt (data + BitVec.ofNat 64 (8 * st.size.toNat)) .W64 (Layout.slotWord slot slotPad)
      (H self data trace mapping st slot slotPad destination T frame)
      (H self data trace mapping
        { st with data := FlatShuffler.Flat.put st.data st.size slot, pad := FlatShuffler.Flat.put st.pad st.size slotPad }
        slot slotPad destination T frame) := by
  have h8 : 8 * st.size.toNat < 2 ^ 64 := by
    have := hsize; simp only [FlatShuffler.maxStackSize] at this; omega
  have haddr : (data + BitVec.ofNat 64 (8 * st.size.toNat) - data).toNat = 8 * st.size.toNat := by
    have := BitVec.isLt data
    bv_omega
  have hval : (Lift.Sem.cellGet (dataCells st) (8 * st.size.toNat) .W64).isSome = true := by
    rw [dataCells_eq,
      show 8 * st.size.toNat = st.size.toNat * Width.W64.bytes by simp [Width.bytes, Nat.mul_comm]]
    rw [Aux.cellGet_range_map FlatShuffler.maxStackSize st.size.toNat .W64
      (fun i => Layout.slotWord (st.data.toList.getD i default) (st.pad.toList.getD i 0)) hsize]
    rfl
  have hobj : Bridge.toObj (Layout.data (PushStatement.envOf self data trace mapping) { st with data := FlatShuffler.Flat.put st.data st.size slot, pad := FlatShuffler.Flat.put st.pad st.size slotPad } true)
      = (Bridge.toObj (Layout.data (PushStatement.envOf self data trace mapping) st true)).setAt
        (data + BitVec.ofNat 64 (8 * st.size.toNat)) .W64 (Layout.slotWord slot slotPad) := by
    rw [toObj_data, toObj_data, Obj.setAt]
    simp [PushStatement.envOf, haddr, dataCells_cellSet st slot slotPad hsize]
  rw [H_eq_list (st := st) (trace0 := T),
    H_eq_list (st := { st with data := FlatShuffler.Flat.put st.data st.size slot, pad := FlatShuffler.Flat.put st.pad st.size slotPad }) (trace0 := T), hobj]
  refine Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.head ?_ ?_)))
  · simp [toObj_data]
  · simp [PushStatement.envOf, toObj_data, haddr, hval]

/-- A store of the trace size. -/
theorem H_store_traceSize (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (frame : Heap)
    (op : Lift.Shuffler.Zig.OpP) :
    Heap.StoreAt (self + 64) .W64 (BitVec.ofNat 64 (st.trace ++ [op]).length)
      (H self data trace mapping st slot slotPad destination T frame)
      (H self data trace mapping { st with trace := st.trace ++ [op] } slot slotPad destination T frame) := by
  have hobj : Bridge.toObj (Layout.traceSize (PushStatement.envOf self data trace mapping)
        { st with trace := st.trace ++ [op] } true)
      = (Bridge.toObj (Layout.traceSize (PushStatement.envOf self data trace mapping) st true)).setAt
        (self + 64) .W64 (BitVec.ofNat 64 (st.trace ++ [op]).length) := by
    rw [toObj_traceSize, toObj_traceSize, Obj.setAt]
    simp only [PushStatement.envOf]
    simp [Lift.Sem.cellSet, Width.bytes]
  rw [H_eq_list (st := st) (trace0 := T),
    H_eq_list (st := { st with trace := st.trace ++ [op] }) (trace0 := T), hobj]
  refine Heap.StoreAt.tail (Heap.StoreAt.head ?_ ?_)
  · rw [toObj_traceSize]
  · rw [toObj_traceSize]
    simp [PushStatement.envOf, Lift.Sem.cellGet, Lift.Sem.Cell.get]

/-- A store of the kind byte of the trace entry `len`. -/
theorem H_store_trace0 (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)

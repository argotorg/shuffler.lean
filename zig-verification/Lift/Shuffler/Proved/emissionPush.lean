theorem call_summary : callSummary := by
  intro self data trace mapping frame st slot slotPad destination trace0 a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 self data trace mapping frame st slot slotPad destination trace0 () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨⟨r, hrel, hmap⟩, call_shape a q hq, call_frame self data trace mapping frame st slot slotPad destination trace0 a q hs hq⟩⟩

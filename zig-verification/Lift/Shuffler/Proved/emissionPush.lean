      (T[st.trace.length]).2.2.1, (T[st.trace.length]).2.2.2))), hobj]
  refine Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail
    (Heap.StoreAt.tail (Heap.StoreAt.head ?_ ?_)))))
  · rw [toObj_trace]
  · rw [toObj_trace]
    show (Lift.Sem.cellGet (traceCells T) (trace + BitVec.ofNat 64 (st.trace.length * 12) - trace).toNat .W8).isSome = true
    rw [haddr, cellGet_traceCells_kind T st.trace.length hlen]
    rfl

/-- A store of the depth byte of the trace entry `len`. -/
theorem H_store_trace1 (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)

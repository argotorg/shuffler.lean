  · rw [toObj_trace]
    show (Lift.Sem.cellGet (traceCells T) (trace + BitVec.ofNat 64 (st.trace.length * 12 + 1) - trace).toNat .W8).isSome = true
    rw [haddr, cellGet_traceCells_depth T st.trace.length hlen]
    rfl

/-- A store of the slot word of the trace entry `len`. -/
theorem H_store_trace4 (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (frame : Heap)
    (v : BitVec 64) (hlen : st.trace.length < 10240) :
    Heap.StoreAt (trace + BitVec.ofNat 64 (st.trace.length * 12 + 4)) .W64 v
      (H self data trace mapping st slot slotPad destination T frame)
      (H self data trace mapping st slot slotPad destination
        (T.set st.trace.length ((T[st.trace.length]).1, (T[st.trace.length]).2.1,
          (T[st.trace.length]).2.2.1, v)) frame) := by
  have h12 : st.trace.length * 12 + 4 < 2 ^ 64 := by omega
  have haddr : (trace + BitVec.ofNat 64 (st.trace.length * 12 + 4) - trace).toNat
      = st.trace.length * 12 + 4 := by
    have := BitVec.isLt trace
    bv_omega
  have hobj : Bridge.toObj (⟨(PushStatement.envOf self data trace mapping).trace,
        (T.set st.trace.length ((T[st.trace.length]).1, (T[st.trace.length]).2.1,
          (T[st.trace.length]).2.2.1, v)).toList.flatMap
          (fun t => [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩ : Object)
      = (Bridge.toObj (⟨(PushStatement.envOf self data trace mapping).trace,
          T.toList.flatMap
            (fun t => [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩ : Object)).setAt
        (trace + BitVec.ofNat 64 (st.trace.length * 12 + 4)) .W64 v := by
    rw [toObj_trace, toObj_trace, Obj.setAt]
    show (⟨trace, true, traceCells (T.set st.trace.length ((T[st.trace.length]).1, (T[st.trace.length]).2.1, (T[st.trace.length]).2.2.1, v))⟩ : Obj)
      = ⟨trace, true, cellSet (traceCells T) (trace + BitVec.ofNat 64 (st.trace.length * 12 + 4) - trace).toNat .W64 v⟩
    rw [haddr, traceCells_word T st.trace.length hlen v]
  rw [H_eq_list (st := st) (trace0 := T),
    H_eq_list (st := st) (trace0 := (T.set st.trace.length ((T[st.trace.length]).1,
      (T[st.trace.length]).2.1, (T[st.trace.length]).2.2.1, v))), hobj]
  refine Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail
    (Heap.StoreAt.tail (Heap.StoreAt.head ?_ ?_)))))
  · rw [toObj_trace]
  · rw [toObj_trace]
    show (Lift.Sem.cellGet (traceCells T) (trace + BitVec.ofNat 64 (st.trace.length * 12 + 4) - trace).toNat .W64).isSome = true
    rw [haddr, cellGet_traceCells_word T st.trace.length hlen]
    rfl

/-- A store of the destination at the index `k`. -/
theorem H_store_dest (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (frame : Heap)
    (k v : FlatShuffler.Word) (hk : k.toNat < FlatShuffler.maxStackSize) :
    Heap.StoreAt (mapping + BitVec.ofNat 64 (8 * k.toNat)) .W64 v
      (H self data trace mapping st slot slotPad destination T frame)
      (H self data trace mapping { st with dest := FlatShuffler.Flat.put st.dest k v } slot slotPad
        destination T frame) := by
  have h8 : 8 * k.toNat < 2 ^ 64 := by
    have := hk; simp only [FlatShuffler.maxStackSize] at this; omega
  have haddr : (mapping + BitVec.ofNat 64 (8 * k.toNat) - mapping).toNat = 8 * k.toNat := by
    have := BitVec.isLt mapping
    bv_omega
  have hval : (Lift.Sem.cellGet (destCells st) (8 * k.toNat) .W64).isSome = true := by
    rw [destCells_eq,
      show 8 * k.toNat = Width.W64.bytes * k.toNat by simp [Width.bytes]]
    rw [Aux3.cellGet_map_mk .W64 st.dest.toList k.toNat (by simpa [Vector.length_toList] using hk)]
    rfl
  have hobj : Bridge.toObj (Layout.dest (PushStatement.envOf self data trace mapping)
        { st with dest := FlatShuffler.Flat.put st.dest k v } true)
      = (Bridge.toObj (Layout.dest (PushStatement.envOf self data trace mapping) st true)).setAt
        (mapping + BitVec.ofNat 64 (8 * k.toNat)) .W64 v := by
    rw [toObj_dest, toObj_dest, Obj.setAt]
    simp [PushStatement.envOf, haddr, destCells_cellSet st k v hk]
  rw [H_eq_list (st := st) (trace0 := T),
    H_eq_list (st := { st with dest := FlatShuffler.Flat.put st.dest k v }) (trace0 := T), hobj]
  refine Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail
    (Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.head ?_ ?_)))))))
  · simp [toObj_dest]
  · simp [PushStatement.envOf, toObj_dest, haddr, hval]

/-- A store of the position of the destination `k`. -/
theorem H_store_pos (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (frame : Heap)
    (k v : FlatShuffler.Word) (hk : k.toNat < FlatShuffler.maxStackSize) :
    Heap.StoreAt (mapping + 8192 + BitVec.ofNat 64 (8 * k.toNat)) .W64 v
      (H self data trace mapping st slot slotPad destination T frame)
      (H self data trace mapping { st with pos := FlatShuffler.Flat.put st.pos k v } slot slotPad
        destination T frame) := by
  have h8 : 8 * k.toNat < 2 ^ 64 := by
    have := hk; simp only [FlatShuffler.maxStackSize] at this; omega
  have haddr : (mapping + 8192 + BitVec.ofNat 64 (8 * k.toNat) - (mapping + 8192)).toNat
      = 8 * k.toNat := by
    have := BitVec.isLt mapping
    bv_omega
  have haddr' : (18446744073709551616 - (mapping.toNat + 8192) % 18446744073709551616 +
      (mapping.toNat + 8192 + 8 * k.toNat)) % 18446744073709551616 = 8 * k.toNat := by
    have := BitVec.isLt mapping
    omega
  have hval : (Lift.Sem.cellGet (posCells st) (8 * k.toNat) .W64).isSome = true := by
    rw [posCells_eq,
      show 8 * k.toNat = Width.W64.bytes * k.toNat by simp [Width.bytes]]
    rw [Aux3.cellGet_map_mk .W64 st.pos.toList k.toNat (by simpa [Vector.length_toList] using hk)]
    rfl
  have hobj : Bridge.toObj (Layout.pos (PushStatement.envOf self data trace mapping)
        { st with pos := FlatShuffler.Flat.put st.pos k v } true)
      = (Bridge.toObj (Layout.pos (PushStatement.envOf self data trace mapping) st true)).setAt
        (mapping + 8192 + BitVec.ofNat 64 (8 * k.toNat)) .W64 v := by
    rw [toObj_pos, toObj_pos, Obj.setAt]
    simp [PushStatement.envOf, haddr', posCells_cellSet st k v hk]
  rw [H_eq_list (st := st) (trace0 := T),
    H_eq_list (st := { st with pos := FlatShuffler.Flat.put st.pos k v }) (trace0 := T), hobj]
  refine Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail
    (Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail (Heap.StoreAt.tail
      (Heap.StoreAt.head ?_ ?_))))))))
  · simp [toObj_pos]
  · simp [PushStatement.envOf, toObj_pos, haddr', hval]

/-- A vector built by `ofFn` with the condition `m ≤ i < m` is the original vector. -/
theorem vector_ofFn_of_false' {α : Type} {n : Nat} (T : Vector α n) (f : Fin n → α) (m : Nat) :
    (Vector.ofFn fun i => if m ≤ (i : Nat) ∧ (i : Nat) < m then f i else T[i]) = T :=
  Aux3.vector_ofFn_of_false T f (fun k => m ≤ k ∧ k < m) (by intro i; omega)

/-- The objects written by the statement when it exits with an assertion, at the state `st`. -/
theorem written_assertion (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    PushStatement.written st slot slotPad destination T (PushStatement.envOf self data trace mapping)
      (Lift.Shuffler.Zig.Exit.assertionExit, st)
      = [Layout.size (PushStatement.envOf self data trace mapping) st true,
         Layout.traceSize (PushStatement.envOf self data trace mapping) st true,
         Layout.data (PushStatement.envOf self data trace mapping) st true,
         ⟨(PushStatement.envOf self data trace mapping).trace,
           T.toList.flatMap (fun t => [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩,
         Layout.dest (PushStatement.envOf self data trace mapping) st true,
         Layout.pos (PushStatement.envOf self data trace mapping) st true] := by
  simp only [PushStatement.written]
  rw [vector_ofFn_of_false' T _ st.trace.length]

end Aux5

namespace PushRepair
open Lift.Shuffler Lift.Shuffler.Internal.Proposed

def traceAfter {n : Nat} (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) n)
    (old current : List Zig.OpP) : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) n :=
  Vector.ofFn fun i =>
    let t := T[i]
    if old.length ≤ i.val ∧ i.val < current.length then
      let op := current.getD i.val ⟨⟨0, 0, default⟩, 0⟩
      (op.op.kind, op.op.depth, t.2.2.1, Layout.slotWord op.op.slot op.pad)
    else t

theorem traceAfter_append {n : Nat}
    (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) n)
    (old : List Zig.OpP) (op : Zig.OpP) (h : old.length < n) :
    traceAfter T old (old ++ [op]) = T.set old.length
      (op.op.kind, op.op.depth, (T[old.length]).2.2.1, Layout.slotWord op.op.slot op.pad) := by
  array_update [traceAfter]

theorem has_written (self data trace mapping : BitVec 64) (st : Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (T T' : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (frame : Heap)
    (y : Zig.Outcome FlatShuffler.Flat.Status) (policy : CpuPolicy) (m : DataMem)
    (hh : (Aux2.H self data trace mapping y.2 slot slotPad destination T' frame).Holds policy m)
    (heq : traceAfter T st.trace y.2.trace = T') :
    ∀ o ∈ PushStatement.written st slot slotPad destination T
      (PushStatement.envOf self data trace mapping) y, Lift.Trusted.Mem.has policy m o := by
  intro o ho
  simp only [PushStatement.written] at ho
  unfold traceAfter at heq
  rw [heq] at ho
  have horig : o ∈ PushStatement.objects y.2 slot slotPad destination T'
      (PushStatement.envOf self data trace mapping) := by
    simp only [PushStatement.objects, List.mem_cons, List.not_mem_nil, or_false] at ho ⊢
    rcases ho with rfl | rfl | rfl | rfl | rfl | rfl <;> simp
  exact Lift.Sem.Bridge.has_of_holds_mem hh
    (List.mem_append_left frame (Aux2.mem_objsP horig))

end PushRepair

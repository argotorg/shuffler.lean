/-! ### The frame of the callee's heap

A store of the callee's block model writes the bytes of one writable object; when that object is an
object of the statement, the frame does not change. `FrameHeap` is the relation of the heap of a
block state to the statement's objects and the caller's frame. -/

/-- An object that is not writable does not change in a store. -/
theorem obj_set_of_not_writable {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (h : o.writable = false) : Obj.set a w v o = o := by
  unfold Obj.set
  simp only [h, Bool.false_eq_true, ↓reduceIte]

/-- An object that does not span the access does not change in a store. -/
theorem obj_set_of_not_spans {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (hn : o.addr.toNat + o.size ≤ 2 ^ 64) (hsp : ¬ o.Spans a w) : Obj.set a w v o = o := by
  by_cases hw : o.writable = true
  · unfold Obj.set
    rw [if_pos hw]
    have hnone : setCells o.addr a w v 0 o.cells = o.cells := by
      refine setCells_of_no_match _ _ _ _ _ _ ?_
      intro x hx hc
      exact hsp (by
        obtain ⟨e, b⟩ := Obj.toNat_cell hn hx
        have hb : x.fst + w.bytes ≤ o.size := by rw [← hc.2]; exact b
        unfold Obj.Spans
        rw [← hc.1, e]
        omega)
    rw [hnone]
  · exact obj_set_of_not_writable (by simpa using hw)

/-- An object that is not a writable object spanning the access does not change in a byte store. -/
theorem obj_setBytes_of_not {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (h : ¬ (o.writable = true ∧ o.Spans a w)) : Obj.setBytes a w v o = o := by
  by_cases hw : o.writable = true
  · exact Obj.setBytes_of_not_spans fun hs => h ⟨hw, hs⟩
  · exact Obj.setBytes_of_not_writable (by simpa using hw)

/-- An object that is not a writable object spanning the access does not change in a store. -/
theorem obj_set_of_not {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (hn : o.addr.toNat + o.size ≤ 2 ^ 64) (h : ¬ (o.writable = true ∧ o.Spans a w)) :
    Obj.set a w v o = o := by
  by_cases hw : o.writable = true
  · exact obj_set_of_not_spans hn fun hs => h ⟨hw, hs⟩
  · exact obj_set_of_not_writable (by simpa using hw)

/-- A load of the single 64-bit cell of an object. -/
theorem loadB_cell64 {policy : CpuPolicy} {m : DataMem} {h : Heap} {o : Obj} {addr val : BitVec 64}
    (hh : h.Holds policy m) (ho : o ∈ h) (ha : o.addr = addr) (hc : o.cells = [⟨.W64, val⟩]) :
    h.loadB addr .W64 = .ok val := by
  have hx : (0, (⟨.W64, val⟩ : Cell)) ∈ offsets 0 o.cells := by
    rw [hc]; exact List.mem_cons_self ..
  have hl := Heap.load_of_mem hh ho hx
  simp only [Nat.zero_add, BitVec.add_zero, ha] at hl
  exact Heap.loadB_of_load hl

/-- A load of a cell that an object has. -/
theorem loadB_get {policy : CpuPolicy} {m : DataMem} {h : Heap} {o : Obj} {a : BitVec 64}
    {w : Width} {v : w.type} (hh : h.Holds policy m) (ho : o ∈ h) (hg : o.get a w = some v) :
    h.loadB a w = .ok v := by
  obtain ⟨x, hx, ha, hxc⟩ := Obj.get_some hg
  have hl := Heap.load_of_mem hh ho hx
  rw [ha, hxc] at hl
  exact Heap.loadB_of_load hl

/-- The relation of the heap of a block state to the objects of the statement and the frame. `g` is
the map that the stores of the run applied to the objects; it keeps the shape of each object, fixes
the read-only objects and the frame, and agrees with the reference map `g₀` on the objects of
`keep`. -/
def FrameHeap (objs frame keep : Heap) (policy : CpuPolicy) (g₀ g : Obj → Obj) (m : DataMem) :
    Prop :=
  (∀ o ∈ objs, (g o).shape = o.shape) ∧
  (∀ o ∈ objs, o.writable = false → g o = o) ∧
  (∀ o ∈ keep, g o = g₀ o) ∧
  (∀ p ∈ frame, g p = p) ∧
  Heap.Holds policy (objs.map g ++ frame) m

theorem FrameHeap.mono_keep {objs frame keep keep' : Heap} {policy : CpuPolicy} {g₀ g : Obj → Obj}
    {m : DataMem} (h : FrameHeap objs frame keep policy g₀ g m)
    (hk : ∀ o ∈ keep', o ∈ keep) : FrameHeap objs frame keep' policy g₀ g m :=
  ⟨h.1, h.2.1, fun o ho => h.2.2.1 o (hk o ho), h.2.2.2.1, h.2.2.2.2⟩

theorem FrameHeap.rebase {objs frame keep : Heap} {policy : CpuPolicy} {g₀ g₀' g : Obj → Obj}
    {m : DataMem} (h : FrameHeap objs frame keep policy g₀ g m)
    (hk : ∀ o ∈ keep, g o = g₀' o) : FrameHeap objs frame keep policy g₀' g m :=
  ⟨h.1, h.2.1, hk, h.2.2.2.1, h.2.2.2.2⟩

/-- A byte store whose access is inside a writable object of `objs` keeps the frame, the shape of
the objects and the objects of `keep`. -/
theorem FrameHeap.storeB {objs frame keep : Heap} {policy : CpuPolicy} {g₀ g : Obj → Obj}
    {m : DataMem} {a : BitVec 64} {w : Width} {v : w.type} {h' : Heap}
    (hrel : FrameHeap objs frame keep policy g₀ g m)
    (hsub : ∀ o ∈ keep, o ∈ objs)
    (hex : ∃ O ∈ objs, O.writable = true ∧ O.Spans a w)
    (hkeep : ∀ o ∈ keep, ¬ (o.writable = true ∧ o.Spans a w))
    (hs : Heap.storeB (objs.map g ++ frame) a w v = .ok h') :
    ∃ g' m', h' = objs.map g' ++ frame ∧ FrameHeap objs frame keep policy g₀ g' m' ∧
      ∀ o ∈ keep, g' o = g o := by
  obtain ⟨hshape, hfixNW, hkeepG, hfixF, hholds⟩ := hrel
  obtain ⟨O, hO, hOw, hOs⟩ := hex
  have hOg : g O ∈ objs.map g := List.mem_map_of_mem hO
  obtain ⟨hOa, hOw', hOz⟩ := Obj.fields_of_shape (hshape O hO)
  have hOgw : (g O).writable = true := by rw [hOw']; exact hOw
  have hOgs : (g O).Spans a w := by
    unfold Obj.Spans at hOs ⊢
    rw [hOa, hOz]
    exact hOs
  have hsep : Heap.Separated (objs.map g) frame := hholds.separated
  have hfix : ∀ p ∈ frame, Obj.set a w v p = p ∧ Obj.setBytes a w v p = p := by
    intro p hp
    have hnot : ¬ (p.writable = true ∧ p.Spans a w) := fun hc =>
      Obj.not_apart_of_spans hOgs hc.2 (hsep (g O) hOg p hp (Or.inl hOgw))
    exact ⟨obj_set_of_not (hholds.noWrap p (List.mem_append_right _ hp)) hnot,
      obj_setBytes_of_not hnot⟩
  have hkeepnot : ∀ o ∈ keep, ¬ ((g o).writable = true ∧ (g o).Spans a w) := by
    intro o ho hc
    have hsh := hshape o (hsub o ho)
    obtain ⟨ha, hw, hz⟩ := Obj.fields_of_shape hsh
    refine hkeep o ho ⟨?_, ?_⟩
    · show o.writable = true
      rw [← hw]
      exact hc.1
    · unfold Obj.Spans at hc ⊢
      rw [← ha, ← hz]
      exact hc.2
  have hkeepfix : ∀ o ∈ keep, Obj.set a w v (g o) = g o ∧ Obj.setBytes a w v (g o) = g o := by
    intro o ho
    have hnot := hkeepnot o ho
    exact ⟨obj_set_of_not (hholds.noWrap (g o)
      (List.mem_append_left _ (List.mem_map_of_mem (hsub o ho)))) hnot,
      obj_setBytes_of_not hnot⟩
  have hmap : ∃ f : Obj → Obj, h' = (objs.map g ++ frame).map f ∧
      (∀ p ∈ frame, f p = p) ∧ (∀ o ∈ keep, f (g o) = g o) ∧
      (∀ x, (f x).shape = x.shape) ∧ (∀ x, x.writable = false → f x = x) := by
    unfold Heap.storeB at hs
    split at hs
    · unfold Heap.store at hs
      split at hs
      · cases hs
        exact ⟨Obj.set a w v, rfl, fun p hp => (hfix p hp).1, fun o ho => (hkeepfix o ho).1,
          fun x => Obj.set_shape a w v x, fun x hx => obj_set_of_not_writable hx⟩
      · repeat' (first | cases hs | split at hs)
    · split at hs
      · cases hs
        exact ⟨Obj.setBytes a w v, rfl, fun p hp => (hfix p hp).2, fun o ho => (hkeepfix o ho).2,
          fun x => Obj.setBytes_shape a w v x, fun x hx => Obj.setBytes_of_not_writable hx⟩
      · repeat' (first | cases hs | split at hs)
  obtain ⟨f, hh', hfF, hfK, hfShape, hfNW⟩ := hmap
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hholds hs
  have hframe : frame.map f = frame := by
    simpa only [List.map_id] using
      (List.map_congr_left (f := f) (g := id) (l := frame) fun p hp => hfF p hp)
  have heq : h' = objs.map (fun o => f (g o)) ++ frame := by
    rw [hh', List.map_append, List.map_map, hframe]
    rfl
  refine ⟨fun o => f (g o), m', heq, ?_, ?_⟩
  · refine ⟨fun o ho => ?_, fun o ho hw => ?_, fun o ho => ?_, fun p hp => ?_, ?_⟩
    · show (f (g o)).shape = o.shape
      rw [hfShape, hshape o ho]
    · show f (g o) = o
      rw [hfixNW o ho hw, hfNW o hw]
    · show f (g o) = g₀ o
      rw [hfK o ho]
      exact hkeepG o ho
    · show f (g p) = p
      rw [hfixF p hp, hfF p hp]
    · rw [← heq]
      exact hm'
  · intro o ho
    show f (g o) = g o
    exact hfK o ho

/-- A byte store on the cell of a writable object of `objs`: the frame, the shape of the objects
and the objects of `keep` are kept, and the object takes the new value. -/
theorem FrameHeap.storeB_cell {objs frame keep : Heap} {policy : CpuPolicy} {g₀ g : Obj → Obj}
    {m : DataMem} {a : BitVec 64} {w : Width} {v : w.type} {h' : Heap} {O : Obj}
    (hrel : FrameHeap objs frame keep policy g₀ g m)
    (hsub : ∀ o ∈ keep, o ∈ objs)
    (hO : O ∈ objs) (hOw : O.writable = true) (hcell : ((g O).get a w).isSome = true)
    (hkeep : ∀ o ∈ keep, ¬ (o.writable = true ∧ o.Spans a w))
    (hs : Heap.storeB (objs.map g ++ frame) a w v = .ok h') :
    ∃ g' m', h' = objs.map g' ++ frame ∧ FrameHeap objs frame keep policy g₀ g' m' ∧
      (∀ o ∈ keep, g' o = g o) ∧ g' O = Obj.set a w v (g O) := by
  obtain ⟨hshape, hfixNW, hkeepG, hfixF, hholds⟩ := hrel
  have hOg : g O ∈ objs.map g := List.mem_map_of_mem hO
  obtain ⟨hOa, hOw', hOz⟩ := Obj.fields_of_shape (hshape O hO)
  have hOgw : (g O).writable = true := by rw [hOw']; exact hOw
  obtain ⟨v₀, hv₀⟩ := Option.isSome_iff_exists.mp hcell
  have hOgs : (g O).Spans a w := by
    obtain ⟨x, hx, ha, hxc⟩ := Obj.get_some hv₀
    have hb := Obj.toNat_cell (hholds.noWrap (g O) (List.mem_append_left _ hOg)) hx
    rw [hxc] at hb
    have ha' : a.toNat = (g O).addr.toNat + x.1 := by rw [← ha]; exact hb.1
    have hb' : x.1 + w.bytes ≤ (g O).size := hb.2
    unfold Obj.Spans
    constructor <;> omega
  have hany : (objs.map g ++ frame).any (fun o => (o.get a w).isSome) = true :=
    List.any_eq_true.mpr ⟨g O, List.mem_append_left _ hOg, hcell⟩
  have hst : Heap.store (objs.map g ++ frame) a w v = .ok h' := by
    unfold Heap.storeB at hs
    rw [hany] at hs
    simpa using hs
  have hsep : Heap.Separated (objs.map g) frame := hholds.separated
  have hfix : ∀ p ∈ frame, Obj.set a w v p = p := by
    intro p hp
    have hnot : ¬ (p.writable = true ∧ p.Spans a w) := fun hc =>
      Obj.not_apart_of_spans hOgs hc.2 (hsep (g O) hOg p hp (Or.inl hOgw))
    exact obj_set_of_not (hholds.noWrap p (List.mem_append_right _ hp)) hnot
  have hkeepnot : ∀ o ∈ keep, ¬ ((g o).writable = true ∧ (g o).Spans a w) := by
    intro o ho hc
    have hsh := hshape o (hsub o ho)
    obtain ⟨ha, hw, hz⟩ := Obj.fields_of_shape hsh
    refine hkeep o ho ⟨?_, ?_⟩
    · show o.writable = true
      rw [← hw]
      exact hc.1
    · unfold Obj.Spans at hc ⊢
      rw [← ha, ← hz]
      exact hc.2
  have hkeepfix : ∀ o ∈ keep, Obj.set a w v (g o) = g o := by
    intro o ho
    exact obj_set_of_not (hholds.noWrap (g o)
      (List.mem_append_left _ (List.mem_map_of_mem (hsub o ho)))) (hkeepnot o ho)
  obtain ⟨hc, rfl⟩ := Heap.store_eq_ok_iff.mp hst
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hholds hs
  have hframe : frame.map (Obj.set a w v) = frame := by
    simpa only [List.map_id] using
      (List.map_congr_left (f := Obj.set a w v) (g := id) (l := frame) fun p hp => hfix p hp)
  have heq : (objs.map g ++ frame).map (Obj.set a w v) =
      objs.map (fun o => Obj.set a w v (g o)) ++ frame := by
    rw [List.map_append, List.map_map, hframe]
    rfl
  refine ⟨fun o => Obj.set a w v (g o), m', heq, ?_, ?_, rfl⟩
  · refine ⟨fun o ho => ?_, fun o ho hw => ?_, fun o ho => ?_, fun p hp => ?_, ?_⟩
    · show (Obj.set a w v (g o)).shape = o.shape
      rw [Obj.set_shape, hshape o ho]
    · show Obj.set a w v (g o) = o
      rw [hfixNW o ho hw, obj_set_of_not_writable hw]
    · show Obj.set a w v (g o) = g₀ o
      rw [hkeepfix o ho]
      exact hkeepG o ho
    · show Obj.set a w v (g p) = p
      rw [hfixF p hp, hfix p hp]
    · rw [← heq]
      exact hm'
  · intro o ho
    exact hkeepfix o ho

/-! ### The objects of the statement -/

/-- The cells of the trace array of the statement. -/
def traceCells (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) : List Cell :=
  trace0.toList.flatMap fun t => [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]

theorem cellsSize_traceCells (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    cellsSize (traceCells trace0) = 10240 * 12 := by
  have hlen : trace0.toList.length = 10240 := by simp
  rw [traceCells, cellsSize_flatMap]
  have h : ∀ t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64,
      cellsSize [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] = 12 := by
    intro t
    simp [cellsSize, Width.bytes]
  simp only [h, sum_map_const, hlen]

/-- The cells of the trace array, in the mapped form of the statement's object. -/
theorem traceCells_map {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240} :
    (trace0.toList.flatMap (fun t => ([⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] : List Lift.Trusted.Field))).map Bridge.toCell = traceCells trace0 := by
  rw [List.map_flatMap]
  simp [traceCells, Bridge.toCell]

/-- A single 64-bit cell at the address of its object is spanned by the object. -/
theorem spans_self_cell64 {addr val : BitVec 64} {wr : Bool} :
    (Obj.mk addr wr [⟨.W64, val⟩]).Spans addr .W64 := by
  unfold Obj.Spans
  simp only [Obj.size, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Width.bytes]
  omega

/-- A single 64-bit cell at the address of its object is its value. -/
theorem get_self_cell64 {addr val a : BitVec 64} {wr : Bool} (ha : a = addr) :
    (Obj.mk addr wr [⟨.W64, val⟩]).get a .W64 = some val := by
  subst ha
  simp [Obj.get, offsets, Cell.get, BitVec.add_zero]

theorem set_self_cell64 {addr val : BitVec 64} (v : BitVec 64) :
    (Obj.mk addr true [⟨.W64, val⟩]).set addr .W64 v = Obj.mk addr true [⟨.W64, v⟩] := by
  simp [Obj.set, setCells, Cell.get]

/-- An array of 64-bit words spans its element `k`, with the bit-vector index of a machine access. -/
theorem spans_words_bv {base : BitVec 64} {wr : Bool} {xs : List (BitVec 64)} {k : BitVec 64}
    (hk : k.toNat < xs.length) (hn : base.toNat + xs.length * 8 ≤ 2 ^ 64) :
    (Obj.words base wr .W64 xs).Spans (base + k * 8) .W64 := by
  have hsz : (Obj.words base wr .W64 xs).size = xs.length * 8 := by
    simp only [Obj.words, Obj.size, List.map_map, Function.comp_def, Width.bytes, sum_map_const]
  unfold Obj.Spans
  rw [hsz]
  simp only [Obj.words, Obj.size, List.map_map, Function.comp_def, Width.bytes, sum_map_const]
  have e : (base + k * 8).toNat = base.toNat + k.toNat * 8 := by bv_omega
  rw [e]
  omega

/-- The trace array spans the bytes of its operation `k`, at a bit-vector offset. -/
theorem spans_trace_at {base K off : BitVec 64}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240}
    {w : Width} (hK : K.toNat < 10240) (hoff : off.toNat + w.bytes ≤ 12)
    (hn : base.toNat + 10240 * 12 ≤ 2 ^ 64) :
    (Obj.mk base true (traceCells trace0)).Spans (base + K * 12 + off) w := by
  have hsz : (Obj.mk base true (traceCells trace0)).size = 10240 * 12 := cellsSize_traceCells trace0
  unfold Obj.Spans
  rw [hsz]
  dsimp only
  have hw := width_bytes_pos w
  have e : (base + K * 12 + off).toNat = base.toNat + 12 * K.toNat + off.toNat := by bv_omega
  rw [e]
  omega

/-- The size of a list of 64-bit cells. -/
theorem cellsSize_eq64 (cs : List Cell) (hall : ∀ c ∈ cs, c.w = .W64) : cellsSize cs = cs.length * 8 := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    have hc : c.w.bytes = 8 := by rw [hall c (List.mem_cons_self ..)]
    have ih' : cellsSize cs = cs.length * 8 := ih (fun c' hc' => hall c' (List.mem_cons_of_mem _ hc'))
    rw [show cellsSize (c :: cs) = c.w.bytes + cellsSize cs from rfl, hc, ih', List.length_cons]
    omega

/-- An object of 64-bit cells spans its element `k`. -/
theorem spans_cells64 {base : BitVec 64} {wr : Bool} {cs : List Cell} {k : BitVec 64}
    (hall : ∀ c ∈ cs, c.w = .W64) (hk : k.toNat < cs.length)
    (hn : base.toNat + cs.length * 8 ≤ 2 ^ 64) :
    (Obj.mk base wr cs).Spans (base + k * 8) .W64 := by
  have hsz : cellsSize cs = cs.length * 8 := cellsSize_eq64 cs hall
  have hsize : ({addr := base, writable := wr, cells := cs} : Obj).size = cellsSize cs := rfl
  have hb : Width.W64.bytes = 8 := rfl
  unfold Obj.Spans
  dsimp only
  rw [hsize, hsz, hb]
  have e : (base + k * 8).toNat = base.toNat + k.toNat * 8 := by bv_omega
  rw [e]
  constructor <;> omega

/-- Two distinct objects of a heap that the memory holds are apart. -/
theorem apart_of_holds {policy : CpuPolicy} {m : DataMem} {h : Heap} (hh : h.Holds policy m)
    {o o' : Obj} (ho : o ∈ h) (ho' : o' ∈ h) (hne : o ≠ o')
    (hw : o.writable = true ∨ o'.writable = true) : o.Apart o' :=
  pairwise_of_mem (fun {a b} (h : (a.writable = true ∨ b.writable = true) → a.Apart b) hw' =>
    Or.symm (h (Or.symm hw'))) hh.apart ho ho' hne hw

/-- An object apart from a spanned access does not span it. -/
theorem not_spans_of_apart {o o' : Obj} {a : BitVec 64} {w : Width}
    (hap : o'.Apart o) (hsp : o'.Spans a w) : ¬ o.Spans a w :=
  fun hs => Obj.not_apart_of_spans hsp hs hap

/-- Objects of different sizes are different. -/
theorem ne_of_size {o o' : Obj} (h : o.size ≠ o'.size) : o ≠ o' :=
  fun e => h (congrArg Obj.size e)

theorem bv_add8 (sz : BitVec 64) :
    (sz + 1) * 8 + (18446744073709551608 : BitVec 64) = sz * 8 := by
  have h8 : (18446744073709551608 : BitVec 64) = 0 - 8 := by decide
  have h0 : (8 : BitVec 64) + (0 - 8) = 0 := by decide
  have hm : (sz + 1) * 8 = sz * 8 + 8 := by rw [BitVec.add_mul]; simp
  rw [h8, hm, BitVec.add_assoc, h0]
  exact BitVec.add_zero _

theorem bv_pos_addr (mapping destination : BitVec 64) :
    mapping + destination * 8 + 8192 = (mapping + 8192) + destination * 8 := by
  rw [BitVec.add_assoc, BitVec.add_comm (destination * 8) (8192 : BitVec 64), ← BitVec.add_assoc]


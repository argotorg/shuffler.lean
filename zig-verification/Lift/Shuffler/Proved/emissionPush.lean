theorem call_frame : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre self data trace mapping frame st slot slotPad destination trace0 a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro self data trace mapping frame st slot slotPad destination trace0 a q hp hr m hm
  obtain ⟨g, memory, heq, relation⟩ := CalleeHeapPartition.push_partition self data trace mapping frame st slot slotPad destination trace0 a q hp hr
  exact Heap.Holds.sublist hm (heq ▸ List.sublist_append_right _ frame)


theorem bitvec_mul_ofNat (k : BitVec 64) (n : Nat) (hn : n < 2 ^ 64) (hk : k.toNat * n < 2 ^ 64) :
    k * BitVec.ofNat 64 n = BitVec.ofNat 64 (k.toNat * n) := by
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_mul, BitVec.toNat_ofNat, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hn,
    Nat.mod_eq_of_lt hk]

abbrev H (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (frame : Heap) : Heap :=
  objsP self data trace mapping st slot slotPad destination trace0 ++ frame

def traceCells (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) : List Cell :=
  (trace0.toList.flatMap fun t =>
    ([⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩] : List Field)).map toCell

def dataCells (st : Lift.Shuffler.Zig.St) : List Cell :=
  ((List.range FlatShuffler.maxStackSize).map fun i =>
    (⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord (st.data.toList.getD i default)
      (st.pad.toList.getD i 0)⟩ : Field)).map toCell

def destCells (st : Lift.Shuffler.Zig.St) : List Cell :=
  (st.dest.toList.map fun v => (⟨.W64, v⟩ : Field)).map toCell

def posCells (st : Lift.Shuffler.Zig.St) : List Cell :=
  (st.pos.toList.map fun v => (⟨.W64, v⟩ : Field)).map toCell

def traceGroup (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) : List Cell :=
  [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]

theorem cellsSize_traceGroup (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) :
    cellsSize (traceGroup t) = 12 := by
  simp [traceGroup, cellsSize, Width.bytes]

theorem traceCells_eq (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    traceCells trace0 = trace0.toList.flatMap traceGroup := by
  simp only [traceCells, traceGroup, List.map_flatMap, toCell]
  rfl


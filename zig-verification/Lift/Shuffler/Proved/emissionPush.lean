/-- `Vector.toList.getD` after `setIfInBounds` at a valid index. -/
theorem toList_getD_setIfInBounds {α : Type} [Inhabited α] {n : Nat} (v : Vector α n) (i : Nat) (hi : i < n)
    (x : α) (j : Nat) (d : α) :
    (v.setIfInBounds i x).toList.getD j d = if j = i then x else v.toList.getD j d := by
  rw [Vector.toList_setIfInBounds, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_set]
  by_cases h : i = j
  · rw [if_pos h, if_pos (by simpa [Vector.length_toList] using hi), Option.getD_some, if_pos h.symm]
  · rw [if_neg h, if_neg (Ne.symm h)]

/-- A store at the element `k` of an array of cells of one width. -/
theorem cellSet_map_mk (w : Width) (xs : List w.type) (k : Nat) (hk : k < xs.length) (v : w.type) :
    cellSet (xs.map (Cell.mk w)) (w.bytes * k) w v = (xs.set k v).map (Cell.mk w) := by
  induction xs generalizing k with
  | nil => simp at hk
  | cons x xs ih =>
    cases k with
    | zero => simp [cellSet_cons_zero, Cell.mk]
    | succ k =>
      have hb := width_bytes_pos w
      simp only [List.map_cons]
      rw [Nat.mul_succ, cellSet_cons_ge (d := w.bytes * k + w.bytes) w v
        (by show w.bytes ≤ w.bytes * k + w.bytes; omega)]
      rw [show w.bytes * k + w.bytes - w.bytes = w.bytes * k by omega, ih k (by simpa using hk)]
      simp [List.set_cons_succ]

/-- A store of the word at the index `size` of the data array. -/
theorem dataCells_cellSet (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16)
    (hsize : st.size.toNat < FlatShuffler.maxStackSize) :
    cellSet (dataCells st) (8 * st.size.toNat) .W64
        (Lift.Shuffler.Internal.Proposed.Layout.slotWord slot slotPad)
      = dataCells { st with data := FlatShuffler.Flat.put st.data st.size slot, pad := FlatShuffler.Flat.put st.pad st.size slotPad } := by
  rw [dataCells_eq, dataCells_eq]
  rw [show 8 * st.size.toNat = st.size.toNat * Width.W64.bytes by simp [Width.bytes, Nat.mul_comm]]
  rw [Aux.cellSet_range_map FlatShuffler.maxStackSize st.size.toNat .W64
    (fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord (st.data.toList.getD i default)
      (st.pad.toList.getD i 0)) _ hsize]
  apply List.map_congr_left
  intro i hi
  rw [show FlatShuffler.Flat.put st.data st.size slot = st.data.setIfInBounds st.size.toNat slot from rfl,
    show FlatShuffler.Flat.put st.pad st.size slotPad = st.pad.setIfInBounds st.size.toNat slotPad from rfl,
    toList_getD_setIfInBounds st.data st.size.toNat hsize slot i default,
    toList_getD_setIfInBounds st.pad st.size.toNat hsize slotPad i 0]
  by_cases h : i = st.size.toNat
  · simp [h]
  · simp [h]

/-- A store of the word at the index `k` of the destination array. -/
theorem destCells_cellSet (st : Lift.Shuffler.Zig.St) (k v : FlatShuffler.Word)
    (hk : k.toNat < FlatShuffler.maxStackSize) :
    cellSet (destCells st) (8 * k.toNat) .W64 v
      = destCells { st with dest := FlatShuffler.Flat.put st.dest k v } := by
  rw [destCells_eq, destCells_eq]
  rw [show FlatShuffler.Flat.put st.dest k v = st.dest.setIfInBounds k.toNat v from rfl,
    Vector.toList_setIfInBounds]
  rw [show 8 * k.toNat = Width.W64.bytes * k.toNat by simp [Width.bytes]]
  rw [cellSet_map_mk .W64 st.dest.toList k.toNat (by simpa [Vector.length_toList] using hk) v]

/-- A store of the word at the index `k` of the position array. -/
theorem posCells_cellSet (st : Lift.Shuffler.Zig.St) (k v : FlatShuffler.Word)
    (hk : k.toNat < FlatShuffler.maxStackSize) :
    cellSet (posCells st) (8 * k.toNat) .W64 v
      = posCells { st with pos := FlatShuffler.Flat.put st.pos k v } := by
  rw [posCells_eq, posCells_eq]
  rw [show FlatShuffler.Flat.put st.pos k v = st.pos.setIfInBounds k.toNat v from rfl,
    Vector.toList_setIfInBounds]
  rw [show 8 * k.toNat = Width.W64.bytes * k.toNat by simp [Width.bytes]]
  rw [cellSet_map_mk .W64 st.pos.toList k.toNat (by simpa [Vector.length_toList] using hk) v]

/-- The value of the cell at the offset of an element of an array of one width. -/
theorem cellGet_map_mk (w : Width) (xs : List w.type) (k : Nat) (hk : k < xs.length) :
    cellGet (xs.map (Cell.mk w)) (w.bytes * k) w = some (xs[k]) := by
  induction xs generalizing k with
  | nil => simp at hk
  | cons x xs ih =>
    cases k with
    | zero => simp [cellGet_cons_zero, Cell.get_self]
    | succ k =>
      have hb := width_bytes_pos w
      simp only [List.map_cons]
      rw [Nat.mul_succ, cellGet_cons_ge w (by show w.bytes ≤ w.bytes * k + w.bytes; omega)]
      rw [show w.bytes * k + w.bytes - w.bytes = w.bytes * k by omega,
        ih k (by simpa using hk)]
      simp

/-- A store at the byte `r` of the trace entry `len`. -/
theorem traceCells_cellSet (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (len r : Nat) (hlen : len < 10240) (hr : r < 12) (w : Width) (v : w.type) (g : List Cell)
    (hg : cellSet (traceGroup (T[len])) r w v = g) :
    cellSet (traceCells T) (len * 12 + r) w v
      = (T.toList.take len).flatMap traceGroup ++ g ++ (T.toList.drop (len + 1)).flatMap traceGroup := by
  have hk : len < T.toList.length := by simpa using hlen
  have hgt : cellSet (traceGroup (T.toList[len]'hk)) r w v = g := by
    rw [show T.toList[len]'hk = T[len] from Vector.getElem_toList hk]
    exact hg
  rw [traceCells_eq, cellSet_flatMap (s := 12) (k := len) (r := r) w v cellsSize_traceGroup hk hr, hgt]

/-- The cells of an array of one width, at the offset of an element. -/
theorem mem_offsets_map_mk (w : Width) (xs : List w.type) (n j : Nat) (hj : j < xs.length) :
    (n + w.bytes * j, Cell.mk w (xs[j])) ∈ Lift.Sem.offsets n (xs.map (Cell.mk w)) := by
  induction xs generalizing n j with
  | nil => simp at hj
  | cons x xs ih =>
    cases j with
    | zero =>
      simp only [List.map_cons, Lift.Sem.offsets, Nat.mul_zero, Nat.add_zero]
      exact List.mem_cons_self ..
    | succ j =>
      have hb := width_bytes_pos w
      simp only [List.map_cons, Lift.Sem.offsets, List.mem_cons]
      right
      rw [List.getElem_cons_succ]
      have := ih (n + w.bytes) j (by simpa using hj)
      rw [show n + w.bytes * (j + 1) = n + w.bytes + w.bytes * j by rw [Nat.mul_succ]; omega]
      exact this

/-- A vector built by `ofFn` with a condition that never holds is the original vector. -/
theorem vector_ofFn_of_false {α : Type} {n : Nat} (T : Vector α n) (f : Fin n → α) (c : Nat → Prop)
    [DecidablePred c] (h : ∀ i : Fin n, ¬ c i.val) :
    (Vector.ofFn fun i => if c i.val then f i else T[i]) = T := by
  apply Vector.ext
  intro i hi
  rw [Vector.getElem_ofFn hi]
  simp [h ⟨i, hi⟩]

/-- The heap of the objects of the statement, as a list. -/
theorem H_eq_list (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) (destination : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (frame : Heap) :
    H self data trace mapping st slot slotPad destination trace0 frame =
      Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.size (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping) st true) ::
      Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.traceSize (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping) st true) ::
      Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.dataPtr (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping)) ::
      Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.data (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping) st true) ::
      Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.tracePtr (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping)) ::
      Bridge.toObj (⟨(Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping).trace,
        trace0.toList.flatMap (fun t => [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩ : Object) ::
      Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.mappingPtr (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping)) ::
      Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.dest (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping) st true) ::
      Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.pos (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping) st true) ::
      frame := by
  simp [Aux2.H, objsP, Lift.Shuffler.Internal.Proposed.PushStatement.objects]

set_option maxRecDepth 10000 in
theorem H_loadB_pos {policy : CpuPolicy} {m : DataMem} {self data trace mapping : BitVec 64}
    {st : Lift.Shuffler.Zig.St} {slot : FlatShuffler.StackSlot} {slotPad : BitVec 16}
    {destination : FlatShuffler.Word}
    {trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240} {frame : Heap}
    (hh : (H self data trace mapping st slot slotPad destination trace0 frame).Holds policy m)
    (hd : destination.toNat < FlatShuffler.maxStackSize) :
    (H self data trace mapping st slot slotPad destination trace0 frame).loadB
        (mapping + 8192 + destination * 8) .W64
      = .ok (st.pos.toList.getD destination.toNat default) := by
  have ho : Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.pos
      (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping) st true)
      ∈ H self data trace mapping st slot slotPad destination trace0 frame :=
    List.mem_append_left _ (mem_objsP (by simp [Lift.Shuffler.Internal.Proposed.PushStatement.objects]))
  have hpos : destination.toNat < st.pos.toList.length := by simpa [Vector.length_toList] using hd
  have hmem := mem_offsets_map_mk .W64 st.pos.toList 0 destination.toNat hpos
  rw [Nat.zero_add, show Width.W64.bytes = 8 from rfl] at hmem
  have hgd : st.pos.toList.getD destination.toNat default = st.pos.toList[destination.toNat]'hpos := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hpos]
    rfl
  rw [hgd]
  have hx : (8 * destination.toNat, (⟨.W64, st.pos.toList[destination.toNat]'hpos⟩ : Cell)) ∈
      offsets 0 (Bridge.toObj (Lift.Shuffler.Internal.Proposed.Layout.pos
        (Lift.Shuffler.Internal.Proposed.PushStatement.envOf self data trace mapping) st true)).cells := by
    rw [toObj_pos, posCells_eq]
    exact hmem
  have hl := Heap.load_of_mem hh ho hx
  rw [toObj_pos] at hl
  simp only [Lift.Shuffler.Internal.Proposed.PushStatement.envOf, BitVec.add_zero] at hl
  have hmul : destination * 8 = BitVec.ofNat 64 (8 * destination.toNat) := by
    have h8 : (8 : BitVec 64) = BitVec.ofNat 64 8 := rfl
    rw [h8, Aux2.bitvec_mul_ofNat destination 8 (by omega)
      (by have h := hd; simp only [FlatShuffler.maxStackSize] at h; omega),
      Nat.mul_comm destination.toNat 8]
  rw [hmul, Heap.loadB_of_load hl]

end Aux3

namespace Aux4

open Lift.P2.Total Lift.Sem Lift.Sem.Bridge Lift.Trusted
open Aux Aux2 Aux3

/-- The byte `4` of the shift of a word, as a `BitVec`. -/
theorem toUInt8_shift_toBitVec (u : UInt64) :
    ((u >>> (32 : UInt64)).toUInt8).toUInt64.toBitVec
      = BitVec.setWidth 64 (u.toBitVec.extractLsb' 32 8) := by
  have h32 : (32 : UInt64).toNat = 32 := by decide
  apply BitVec.eq_of_toNat_eq
  simp only [UInt64.toNat_toBitVec, UInt8.toNat_toUInt64, UInt64.toNat_toUInt8,
    UInt64.toNat_shiftRight, BitVec.toNat_setWidth, BitVec.extractLsb'_toNat, Nat.reducePow,
    Nat.reduceMod, Nat.shiftRight_eq_div_pow, h32]
  omega

/-- The kind byte of a slot word is zero at `kind = 0`. -/
theorem kind_cond (p : BitVec 32) (k o : BitVec 8) (slotPad : BitVec 16) :
    (((UInt64.ofBitVec (slotPad ++ o ++ k ++ p)) >>> (32 : UInt64)).toUInt8.toUInt64 = 0) ↔ k = 0 := by
  rw [UInt64.eq_iff_toBitVec_eq, toUInt8_shift_toBitVec, UInt64.toBitVec_zero,
    UInt64.toBitVec_ofBitVec]
  bv_decide

/-- The opcode byte of a slot word is not zero exactly at `valueOpcode ≠ 0`. -/
theorem opcode_cond (p : BitVec 32) (k o : BitVec 8) (slotPad : BitVec 16) :
    (1 ≤ (280375465082880 &&& UInt64.ofBitVec (slotPad ++ o ++ k ++ p))) ↔ o ≠ 0 := by
  rw [show (280375465082880 : UInt64) = UInt64.ofBitVec (BitVec.ofNat 64 280375465082880) from rfl,
    UInt64.le_iff_toBitVec_le, show (1 : UInt64).toBitVec = (1 : BitVec 64) from rfl,
    UInt64.toBitVec_and, UInt64.toBitVec_ofBitVec]
  bv_decide

/-- The kind of a pushed operation, as a proposition. -/
theorem op_push_kind_eq (slot : FlatShuffler.StackSlot) :
    (FlatShuffler.Op.push slot).kind
      = if slot.kind = 0 ∧ slot.valueOpcode ≠ 0 then (4 : BitVec 8) else 3 := by
  obtain ⟨p, k, o⟩ := slot
  simp only [FlatShuffler.Op.push, FlatShuffler.isLiteralValue, FlatShuffler.Value,
    FlatShuffler.Const, FlatShuffler.Push, FlatShuffler.Load, Bool.and_eq_true, beq_iff_eq,
    Bool.not_eq_true, beq_eq_false_iff_ne, Bool.false_eq_true, decide_eq_true_eq]
  by_cases h1 : k = 0 <;> by_cases h2 : o = 0 <;> simp [h1, h2]

/-- The kind byte that the code writes for a pushed operation. -/
theorem kind_byte_val (slot : FlatShuffler.StackSlot) (slotPad : BitVec 16) :
    BitVec.truncate 8 (BitVec.zeroExtend 64 (BitVec.truncate 8
        (if ((UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord slot slotPad)) >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then
          BitVec.zeroExtend 64 (BitVec.truncate 8 ((4 - (if ¬ (1 ≤ 280375465082880 &&& UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord slot slotPad)) then 1 else 0) : BitVec 64)))
        else BitVec.zeroExtend 64 (BitVec.truncate 32 (3 : BitVec 64)))))
      = (FlatShuffler.Op.push slot).kind := by
  obtain ⟨p, k, o⟩ := slot
  have hw : Lift.Shuffler.Internal.Proposed.Layout.slotWord ⟨p, k, o⟩ slotPad
      = slotPad ++ o ++ k ++ p := rfl
  rw [hw, op_push_kind_eq]
  have hA := kind_cond p k o slotPad
  have hB := opcode_cond p k o slotPad
  by_cases hk : k = 0
  · rw [if_pos (hA.mpr hk)]
    by_cases ho : o = 0
    · rw [if_pos (by rw [hB]; exact fun h => h ho), if_neg (fun h => h.2 ho)]
      bv_decide
    · rw [if_neg (by rw [hB]; exact fun h => h ho), if_pos (show k = 0 ∧ o ≠ 0 from ⟨hk, ho⟩)]
      bv_decide
  · rw [if_neg (fun h => hk (hA.mp h)), if_neg (fun h => hk h.1)]
    bv_decide

/-- The depth byte that the code writes for a pushed operation. -/
theorem depth_byte_val (slot : FlatShuffler.StackSlot) :
    BitVec.truncate 8 (0 : BitVec 64) = (FlatShuffler.Op.push slot).depth := by
  simp [FlatShuffler.Op.push]

/-- A store of the kind byte of the trace entry `len`. -/
theorem traceCells_kind (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (len : Nat) (hlen : len < 10240) (k : BitVec 8) :
    cellSet (traceCells T) (len * 12) .W8 k
      = traceCells (T.set len (k, (T[len]).2.1, (T[len]).2.2.1, (T[len]).2.2.2)) := by
  have hcell : cellSet (traceGroup (T[len])) 0 .W8 k
      = traceGroup (k, (T[len]).2.1, (T[len]).2.2.1, (T[len]).2.2.2) := by
    simp [traceGroup, cellSet, Width.bytes]
  have h1 := traceCells_cellSet T len 0 hlen (by omega) .W8 k _ hcell
  rw [Nat.add_zero] at h1
  rw [h1, traceCells_eq, Vector.toList_set (by simpa using hlen),
    flatMap_set _ (by simpa using hlen)]

/-- A store of the depth byte of the trace entry `len`. -/
theorem traceCells_depth (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (len : Nat) (hlen : len < 10240) (d : BitVec 8) :
    cellSet (traceCells T) (len * 12 + 1) .W8 d
      = traceCells (T.set len ((T[len]).1, d, (T[len]).2.2.1, (T[len]).2.2.2)) := by
  have hcell : cellSet (traceGroup (T[len])) 1 .W8 d
      = traceGroup ((T[len]).1, d, (T[len]).2.2.1, (T[len]).2.2.2) := by
    simp [traceGroup, cellSet, cellSet_cons_ge, cellSet_cons_zero, Width.bytes]
  have h1 := traceCells_cellSet T len 1 hlen (by omega) .W8 d _ hcell
  rw [h1, traceCells_eq, Vector.toList_set (by simpa using hlen),
    flatMap_set _ (by simpa using hlen)]

/-- A store of the slot word of the trace entry `len`. -/
theorem traceCells_word (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (len : Nat) (hlen : len < 10240) (v : BitVec 64) :
    cellSet (traceCells T) (len * 12 + 4) .W64 v
      = traceCells (T.set len ((T[len]).1, (T[len]).2.1, (T[len]).2.2.1, v)) := by
  have hcell : cellSet (traceGroup (T[len])) 4 .W64 v
      = traceGroup ((T[len]).1, (T[len]).2.1, (T[len]).2.2.1, v) := by
    simp [traceGroup, cellSet, cellSet_cons_ge, cellSet_cons_zero, Width.bytes]
  have h1 := traceCells_cellSet T len 4 hlen (by omega) .W64 v _ hcell
  rw [h1, traceCells_eq, Vector.toList_set (by simpa using hlen),
    flatMap_set _ (by simpa using hlen)]

/-- The kind byte of the trace entry `len`. -/
theorem cellGet_traceCells_kind (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (len : Nat) (hlen : len < 10240) :
    Lift.Sem.cellGet (traceCells T) (len * 12) .W8 = some (T[len]).1 := by
  have hk : len < T.toList.length := by simpa using hlen
  rw [traceCells_eq,
    show len * 12 = len * 12 + 0 from (Nat.add_zero _).symm,
    cellGet_flatMap (s := 12) (k := len) (r := 0) .W8 cellsSize_traceGroup hk (by omega)]
  rw [show T.toList[len]'hk = T[len] from Vector.getElem_toList hk]
  simp [traceGroup, Lift.Sem.cellGet, Lift.Sem.cellGet_cons_ge, Lift.Sem.cellGet_cons_zero,
    Lift.Sem.Cell.get_self, Width.bytes]

/-- The depth byte of the trace entry `len`. -/
theorem cellGet_traceCells_depth (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (len : Nat) (hlen : len < 10240) :
    Lift.Sem.cellGet (traceCells T) (len * 12 + 1) .W8 = some (T[len]).2.1 := by
  have hk : len < T.toList.length := by simpa using hlen
  rw [traceCells_eq,
    cellGet_flatMap (s := 12) (k := len) (r := 1) .W8 cellsSize_traceGroup hk (by omega)]
  rw [show T.toList[len]'hk = T[len] from Vector.getElem_toList hk]
  simp [traceGroup, Lift.Sem.cellGet, Lift.Sem.cellGet_cons_ge, Lift.Sem.cellGet_cons_zero,
    Lift.Sem.Cell.get_self, Width.bytes]

/-- The slot word of the trace entry `len`. -/
theorem cellGet_traceCells_word (T : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (len : Nat) (hlen : len < 10240) :
    Lift.Sem.cellGet (traceCells T) (len * 12 + 4) .W64 = some (T[len]).2.2.2 := by
  have hk : len < T.toList.length := by simpa using hlen
  rw [traceCells_eq,
    cellGet_flatMap (s := 12) (k := len) (r := 4) .W64 cellsSize_traceGroup hk (by omega)]
  rw [show T.toList[len]'hk = T[len] from Vector.getElem_toList hk]
  simp [traceGroup, Lift.Sem.cellGet, Lift.Sem.cellGet_cons_ge, Lift.Sem.cellGet_cons_zero,
    Lift.Sem.Cell.get_self, Width.bytes]

end Aux4

namespace Aux5


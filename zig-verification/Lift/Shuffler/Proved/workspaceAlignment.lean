    have e : m' = Mem.storeInt m a 8 v.toInt := by
      unfold writeRam at hw
      split at hw
      · split at hw
        · exact (Except.ok.inj hw).symm
        · cases hw
      · cases hw
    rw [e]
    simp [readRam, hr, Width.bytes, Width.bits, Mem.loadInt_storeInt_64, BitVec.ofInt_ofBytes_toBytes_64]
  cases hat
  rw [hent rfl] at hn hkeep hmapped
  have kp := hkeep ra hra
  simp only [init] at kp
  rw [hmem] at kp
  simp only [blocks, init] at hn
  split at hn
  · rename_i m1 hw1
    split at hn
    · rename_i v hv
      simp only [Res.ok.injEq] at hn
      subst hn
      obtain ⟨d, pc⟩ := s₀
      obtain rfl : pc = Lift.Shuffler.workspaceAlignmentPC := he.pc
      rw [hpol, hmem, hsp] at hw1
      rw [hpol, hsp] at hv
      refine entry hx d m1 ?_ (UInt64.ofBitVec v) ?_ ra ?_ (fun _ => ⟨⟨hra, (by apply UInt64.toBitVec_inj.mp; simp [UInt64.toBitVec_add, UInt64.toBitVec_sub] <;> bv_omega), rfl, rfl, rfl, rfl, rfl, rfl⟩, (by first | (simp only [init, hmem]; done) | rfl | assumption), (by first | (simp only [init, hmem]; done) | rfl | assumption), SysV.MappedMemory.trans ((by simpa only [init, hmem] using hmapped)) (SysV.MappedMemory.writeRam hw1)⟩)
      · exact hw1
      · exact hv
      · exact hrr (by first | bv_omega | (simp [UInt64.toBitVec_sub, UInt64.toBitVec_add] <;> bv_omega)) (Sites.readRam_of_writeRam (w' := .W64) hw1 (by intro i hi l hl e; have hi8 : i < 8 := hi; have hl8 : l < 8 := hl; bv_omega) (kp))
    · cases hn
  · cases hn
theorem decompiles_l2 : Decompiles Lift.Shuffler.L1.step l2 := by
  refine Decompiles.ofBlocks blocks noCallee (fun f => f.elim) .entry init decompiles_l2_inv
    (fun _ _ h => h) (fun _ _ _ h => ⟨h, rfl, rfl, fun _ => rfl, fun ra hra => by simp only [init]; rw [h.2.1]; exact Sites.readRet h.2.2.1 hra, by simp only [init]; rw [h.2.1]; exact SysV.MappedMemory.refl _⟩) ?_
  intro policy a s₀ l x s h n hn
  cases l with
  | entry => have H := decompiles_l2_entry entry policy a s₀ x s h n hn; cases n <;> exact H
end decompiles_l2.skel_proof
theorem decompiles_l2 : decompiles_l2.skel_statement := @decompiles_l2.skel_proof.decompiles_l2
theorem refines_l2p : Refines SimIn (fun a b r r' => SimOut a b r r') l2p.returns l2.returns := by
  intro a b r hs h
  refine Blocks.Returns.sim (fun f => f.elim) (fun f => f.elim) (fun x y => SimSt x y ∧ x.input = a ∧ y.input = b ∧ ∀ c, x.mem.Owned c → x.input.heap.Owned c) (fun r r' => SimOut a b r r') (fun f => f.elim) ?_ h
    (y := init b) ⟨⟨hs, rfl, hs.1, fun _ _ => rfl, hs.2.2.1, hs.2.2.2.1⟩, rfl, rfl, fun _ => id⟩
  rintro l x y n ⟨⟨⟨hh, harea, hbel, hrm, hsp⟩, hst_rax, hmh, hmo, hcv, hroom⟩, hxa, hyb, hown⟩ hstep
  cases l with
  | entry =>
    simp only [blocksP, Res.ok.injEq] at hstep
    subst hstep
    obtain ⟨m1, hw0, hroom0, hrd0, hout0⟩ := hroom.push (a := (y.input.sp - 8)) (k := 8) (by decide) (by decide) (by decide) (by decide) (by bv_omega) 8
    have hhs0 := hmh.push hcv hout0
    have hfs0 : ∀ c, ¬ SysV.Below y.input.sp 8 c → m1.get? c = y.input.mem.get? c := fun c hb => (hout0 c hb).trans (hmo c hb)
    have hp0 := SysV.readRam_at hrd0 (y.input.sp - 8) (by bv_omega)
    exact ⟨(UInt64.ofBitVec (8), m1), by simp only [blocks, hw0, hp0], ⟨rfl, by rw [← hyb]; exact hfs0⟩⟩
theorem above_l2p : Above l2 l2p := by
  refine Above.ofRefines (fun _ _ => SimIn) (fun _ _ a b r r' => SimOut a b r r') (fun _ _ => refines_l2p) ?_ ?_
  · rintro policy a s ⟨hh, he, harea, hbelow, hroom, hsp⟩
    exact ⟨⟨policy, s.data.dmem, s.data.regs.rsp.toBitVec⟩, ⟨rfl, rfl, he, rfl, hroom⟩, ⟨hh, harea, hbelow, hroom, hsp⟩⟩
  · rintro _ _ _ _ _ _ _ - ⟨-, hbm, -, hbsp, -⟩ ⟨hv, hout⟩ ⟨hex, hrax, hmem, -⟩
    exact ⟨hex, (fun c hc => by rw [hmem, hout c (by rwa [hbsp]), hbm]), by rw [hrax, ← hv]⟩
theorem refines_l3 : ∀ (frame : Heap), Refines (fun (_ : Unit) => SimArr frame) (fun _ _ y r => r.toBitVec = y) (fun _ y => Lift.Pilot.AlignmentSpec.run = some y) l2p.returns := by
  intro frame
  intro _ a y hs hy
  split_hyps
  lift_straight! [Lift.Pilot.AlignmentSpec.run, objsP, Lift.Shuffler.Internal.AlignmentStatement.objects, initP, Lift.Shuffler.Internal.AlignmentStatement.post]
theorem above_l3 : ∀ (frame : Heap), Above l2p (l3 frame) := by
  intro frame
  refine Above.ofRefines (fun _ _ _ => SimArr frame) _ (fun _ _ => refines_l3 frame) ?_ ?_
  · rintro policy _ s ⟨hh, hC, he, harea, hbelow, hroom⟩
    exact ⟨⟨objsP  ++ frame, s.data.regs.rsp.toBitVec⟩, ⟨hh, he, harea, hbelow, hroom, rfl⟩, ⟨hC, rfl, ⟨policy, _, hh⟩⟩⟩
  · rintro _ _ _ _ _ _ _ _ _ hr ⟨hx, hm, ht⟩
    exact ⟨hx, hm, by rw [ht, hr]⟩
theorem total : Lift.Pilot.AlignmentSpec.C → ∃ y, Lift.Pilot.AlignmentSpec.run = some y := by intros; apply Lift.Pilot.AlignmentSpec.total; assumption
theorem decompiles : ∀ (frame : Heap), Decompiles Lift.Shuffler.L1.step (l3 frame) := by intros; apply Decompiles.above (decompiles_l2.above above_l2p); apply above_l3
theorem decompiles_code : ∀ (frame : Heap), Decompiles (fun s => Lift.Shuffler.Code.code.step s .done) (l3 frame) := by intros; exact (Sites.decompiles_l1Spec_iff Lift.Shuffler.Code.code Lift.Shuffler.L1.step Lift.Shuffler.L1.spec _).mp (by apply decompiles)
theorem contract : ∀ (frame : Heap) (policy : CpuPolicy) (s : MachineState), (l3 frame).rep policy () s → Lift.Pilot.AlignmentSpec.C → Reaches (fun s => Lift.Shuffler.Code.code.step s .done) policy (fun t => ∃ y, (l3 frame).post () y s t ∧ Lift.Pilot.AlignmentSpec.run = some y) s := by intros; rename_i _ _ _ _; apply Decompiles.transfer _ (fun (_ : Unit) => Lift.Pilot.AlignmentSpec.C) (fun _ y => Lift.Pilot.AlignmentSpec.run = some y) (fun _ h => total h) (fun _ _ _ h => h) <;> first | assumption | apply decompiles_code
theorem final : Lift.Shuffler.Internal.AlignmentStatement.AlignmentStatement := by
  intro hC policy ra s he
  have hrep : (l3 []).rep policy () s :=
    ⟨Lift.Sem.Final.holds he, hC, Lift.Sem.Bridge.Fn.Entry.sysV (lo := Lift.Shuffler.shufflePC) (hi := Lift.Shuffler.shufflerEndPC) he (by decide +kernel) (by decide +kernel), Lift.Sem.Final.not_covered he 8 rfl, Lift.Sem.Final.hidden he 8 rfl, Lift.Sem.Final.room he 8 rfl⟩
  refine (contract [] policy s hrep hC).mono ?_
  rintro t ⟨y, ⟨hexit, hmem, hrel⟩, hrun⟩
  refine Lift.Sem.Final.ret he 8 rfl hexit (fun b _ hb => hmem b hb) ?_
  simp only [Lift.Shuffler.Internal.AlignmentStatement.post, Lift.Shuffler.Internal.AlignmentStatement.workspaceAlignment]
  first | exact ⟨y, hrun, hrel⟩ | (refine ⟨y, hrun, ?_⟩; simp [Lift.Trusted.Encode.encode, Width.bits, hrel]; done) | (refine ⟨y, hrun, ?_⟩; simpa [Width.bits] using hrel; done)
theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : UInt64) (q : UInt64) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    callState (fun (r : UInt64) (q : UInt64) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l x z n hs ht
      rcases hs with ⟨hinput, h_rax, h_mem, htrue⟩
      cases l <;> simp only [blocksP, callInput, hinput, h_rax, h_mem] at ht
      all_goals repeat' split at ht
      all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
      all_goals subst n
      all_goals simp_all [skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
      all_goals refine ⟨_, _, ⟨rfl, rfl⟩, rfl, ?_⟩
      all_goals intros; simp_all [callState, callInput])
    hr (by simp [callState, initP, skel_call.initP, callInput])
def call_bridge_rev.skel_statement : Prop := Refines (fun a b => b = callInput a) (fun _ _ (q : UInt64) (r : UInt64) => r = q) skel_call.l2p.returns l2p.returns
namespace call_bridge_rev.skel_proof
skel_proof_aliases call_bridge_rev.skel_proof excluding [bridgeState, BridgeHiNext, BridgeLoNext, bridgeNext, bridgeRes, bridgeState_related, bridge_related_eq, bridgeNext_related, bridgeNext_related_rev, bridge_goto, bridge_step_eq_entry, bridge_step_eq, call_bridge_rev]
def bridgeState (z : St skel_call.In2p Heap) : St In2p Heap := { input := callInput z.input, rax := z.rax, mem := z.mem }

abbrev BridgeHiNext := Next Lbl (St In2p Heap) UInt64 Empty Empty.elim Empty.elim
abbrev BridgeLoNext := Next Lbl (St skel_call.In2p Heap) UInt64 Empty Empty.elim Empty.elim

def bridgeNext : BridgeLoNext → BridgeHiNext
  | .goto l z => .goto l (bridgeState z)
  | .ret r => .ret r
  | .call f x k => .call f x (fun r => ((k r).1, bridgeState (k r).2))

def bridgeRes : Res BridgeLoNext → Res BridgeHiNext
  | .ok n => .ok (bridgeNext n)
  | .stuck why => .stuck why
  | .noFuel => .noFuel

theorem bridgeState_related (z : St skel_call.In2p Heap) : callState (bridgeState z) z := by
  simp [callState, bridgeState]

theorem bridge_related_eq (x : St In2p Heap) (z : St skel_call.In2p Heap)
    (h : callState x z) : x = bridgeState z := by
  cases x
  cases z
  simp_all [callState, bridgeState, callInput]

theorem bridgeNext_related (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      callState (fun (r : UInt64) (q : UInt64) => r = q) (bridgeNext n) (.ok n) := by
  cases n with
  | goto l z => exact ⟨z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, k, rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridgeNext_related_rev (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q) n (.ok (bridgeNext n)) := by
  cases n with
  | goto l z => exact ⟨bridgeState z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, (fun r => ((k r).1, bridgeState (k r).2)), rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridge_goto {l : Lbl} {input : skel_call.In2p} {rax : UInt64} {mem : Heap} :
    (Res.ok (Next.goto l { input := callInput input, rax := rax, mem := mem }) : Res BridgeHiNext) =
      bridgeRes (.ok (.goto l { input := input, rax := rax, mem := mem })) := rfl

set_option maxHeartbeats 400000 in
theorem bridge_step_eq_entry (z : St skel_call.In2p Heap) :
    blocksP.step .entry (bridgeState z) = bridgeRes (skel_call.blocksP.step .entry z) := by
  simp only [blocksP, skel_call.blocksP, bridgeState, callInput]
  all_goals repeat' split
  all_goals first | exact bridge_goto | rfl

theorem bridge_step_eq (l : Lbl) (z : St skel_call.In2p Heap) :
    blocksP.step l (bridgeState z) = bridgeRes (skel_call.blocksP.step l z) := by
  cases l with
  | entry => exact bridge_step_eq_entry z
theorem call_bridge_rev : Refines (fun a b => b = callInput a) (fun _ _ (q : UInt64) (r : UInt64) => r = q) skel_call.l2p.returns l2p.returns := by
  intro a b r hab hr
  subst b
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l z x n hs ht
      have hx := bridge_related_eq x z hs
      subst x
      rw [bridge_step_eq, ht]
      exact bridgeNext_related_rev n)
    hr (by simp [callState, initP, skel_call.initP, callInput])
end call_bridge_rev.skel_proof
theorem call_bridge_rev : call_bridge_rev.skel_statement := @call_bridge_rev.skel_proof.call_bridge_rev
theorem call_summary : callSummary := by
  intro frame a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 frame () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨r, hrel, hmap⟩⟩
end skel_semantic
end Skel.Gen.Level3.Shuffler.workspaceAlignment

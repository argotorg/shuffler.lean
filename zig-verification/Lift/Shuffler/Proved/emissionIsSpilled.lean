theorem decompiles_l2 : Decompiles Lift.Shuffler.L1.step l2 := by
  refine Decompiles.ofBlocks blocks noCallee (fun f => f.elim) .entry init
    (fun policy a s₀ l x s => l2.rep policy a s₀ ∧ x.input = a ∧ At s₀ l x s)
    (fun _ _ h => h) (fun _ _ _ h => ⟨h, rfl, rfl⟩) ?_
  rintro policy a s₀ l x s ⟨hrep, rfl, hat⟩ n hn
  have ⟨hpol, hmem, he, hrsi, hrdi⟩ := hrep
  obtain ⟨ra, hra⟩ := he.ret
  have hx := he.exec
  cases l with
  | entry =>
    cases hat
    simp only [blocks] at hn
    obtain ⟨d, pc⟩ := s₀
    obtain rfl : pc = Lift.Shuffler.emissionIsSpilledPC := he.pc
    refine entry hx d (fun h f' => ?_) (fun h f' => ?_)
    · have e : ((if ¬ ((x.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) &&& (if (x.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then 1 else 0) : UInt64) = 0 := by rw [← hrsi]; exact h
      simp only [e, ↓reduceIte, Res.ok.injEq] at hn
      subst hn
      exact ⟨hrep, rfl, f', by simp only [← hrsi]⟩
    · have e : ((if ¬ ((x.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) &&& (if (x.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then 1 else 0) : UInt64) ≠ 0 := by rw [← hrsi]; exact h
      simp only [e, ↓reduceIte, Res.ok.injEq] at hn
      subst hn
      exact ⟨hrep, rfl, f', by simp only [← hrsi]⟩
  | o28 =>
    obtain ⟨f, rfl⟩ := hat
    simp only [blocks, Res.ok.injEq] at hn
    subst hn
    refine o28 hx _ ra ?_ fun _ => ⟨⟨hra, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩, rfl, rfl⟩
    exact Sites.readRet he hra
  | LBB13_3 =>
    obtain ⟨f, rfl⟩ := hat
    simp only [blocks] at hn
    split at hn
    · rename_i v hv
      split at hn
      · rename_i v1 hv1
        simp only [Res.ok.injEq] at hn
        subst hn
        rw [hpol, hmem, ← hrdi] at hv
        rw [hpol, hmem, ← hrsi] at hv1
        refine LBB13_3 hx _ (UInt64.ofBitVec v) ?_ v1 ?_ ra ?_ fun _ => ⟨⟨hra, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩, rfl, (by first | rfl | simp only [← hrsi])⟩
        · exact hv
        · exact hv1
        · exact Sites.readRet he hra
      · cases hn
    · cases hn
theorem refines_l2p : Refines SimIn (fun _ _ => Eq) l2p.returns l2.returns := by
  intro a b r hs h
  refine Blocks.Returns.sim (fun f => f.elim) (fun f => f.elim) SimSt Eq (fun f => f.elim) ?_ h
    (y := init b) ⟨hs, rfl, rfl⟩
  rintro l x y n ⟨⟨hin_rsi, hin_rdi, hh, hperm⟩, hst_rax, hst_rcx⟩ hstep
  cases l with
  | entry =>
    simp only [blocksP, Res.ok.injEq] at hstep
    subst hstep
    by_cases hc : ((if ¬ ((x.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) &&& (if (x.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then 1 else 0) : UInt64) = 0
    · rw [ite_eq_left hc]
      exact ⟨{ y with rax := (y.input.rsi >>> (32 : UInt64) &&& 18446744073709551360) ||| ((if (y.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then 1 else 0) &&& 255), rcx := (y.input.rsi >>> (40 : UInt64) &&& 18446744073709551360) ||| ((if ¬ ((y.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) &&& 255) }, by simp only [blocks, ← hin_rsi, hc, ↓reduceIte], ⟨⟨hin_rsi, hin_rdi, hh, hperm⟩, by simp only [hin_rsi], by simp only [hin_rsi]⟩⟩
    · rw [ite_eq_right hc]
      exact ⟨{ y with rax := (y.input.rsi >>> (32 : UInt64) &&& 18446744073709551360) ||| ((if (y.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then 1 else 0) &&& 255), rcx := (y.input.rsi >>> (40 : UInt64) &&& 18446744073709551360) ||| ((if ¬ ((y.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) &&& 255) }, by simp only [blocks, ← hin_rsi, hc, ↓reduceIte], ⟨⟨hin_rsi, hin_rdi, hh, hperm⟩, by simp only [hin_rsi], by simp only [hin_rsi]⟩⟩
  | o28 =>
    simp only [blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact ⟨_, rfl, rfl⟩
  | LBB13_3 =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i v hl0
      split at hstep
      · rename_i v1 hl1
        simp only [Res.ok.injEq] at hstep
        subst hstep
        have hr0 := Heap.loadB_sound hh hperm hl0
        rw [hin_rdi] at hr0
        have hr1 := Heap.loadB_sound hh hperm hl1
        rw [hin_rsi] at hr1
        exact ⟨((UInt64.ofBitVec v &&& 18446744073709551360) ||| ((if ¬ (UInt64.ofBitVec (BitVec.zeroExtend 64 v1) = 0) then 1 else 0) &&& 255)), by simp only [blocks, hr0, hr1], rfl⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
theorem above_l2p : Above l2 l2p := by
  refine Above.ofRefines (fun _ _ => SimIn) (fun _ _ _ _ => Eq) (fun _ _ => refines_l2p) ?_ ?_
  · rintro policy a s ⟨hh, hperm, he, hr_rsi, hr_rdi⟩
    exact ⟨⟨policy, s.data.dmem, a.rsi, a.rdi⟩, ⟨rfl, rfl, he, hr_rsi, hr_rdi⟩, ⟨rfl, rfl, hh, hperm⟩⟩
  · rintro _ _ _ _ _ _ _ _ _ rfl ht
    exact ht

  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word, FlatShuffler.Flat.isVariable, FlatShuffler.isLiteralValue,
    FlatShuffler.Value, FlatShuffler.Const] at h ⊢
  bv_decide

theorem encode_result (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (y : Bool) :
    Lift.Trusted.Encode.encode (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.result st slot y) =
      [⟨.W8, if y then (1 : BitVec 8) else 0⟩] := rfl
theorem refines_l3 : ∀ (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot), Refines (fun (_ : Unit) => SimArr self spills pad frame st slot) (fun _ _ y r => Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.IsSpilledStatement.result st slot y) y) = [⟨.W8, r.toBitVec.setWidth 8⟩]) (fun _ y => Lift.Shuffler.Internal.Proposed.IsSpilledStatement.run st slot = some y) l2p.returns := by
  intro self spills pad frame st slot
  intro _ a y hs hy
  obtain ⟨_, hself, hrsi, hheap, hpol, hmem, hHolds⟩ := hs
  have hyv : y = (FlatShuffler.Flat.isVariable slot && (st.spills slot.payload != 0)) := by
    have h : Lift.Shuffler.Zig.isSpilled st slot = y := by
      simpa [Lift.Shuffler.Internal.Proposed.IsSpilledStatement.run] using hy
    rw [← h]
    rfl
  have ho1 : toObj (Lift.Shuffler.Internal.Proposed.Layout.spillsPtr (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad)) ∈ a.heap := by
    rw [hheap]
    simp [objsP, Lift.Shuffler.Internal.Proposed.IsSpilledStatement.objects]
  have hx1 : (0, (⟨.W64, spills⟩ : Cell)) ∈ offsets 0 (toObj (Lift.Shuffler.Internal.Proposed.Layout.spillsPtr (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad))).cells := by
    simp [toObj, toCell, Lift.Shuffler.Internal.Proposed.Layout.spillsPtr, Lift.Shuffler.Internal.Proposed.Layout.word,
      Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf, offsets]
  have hload1 : a.heap.load (a.rdi.toBitVec + 16) .W64 = .ok spills := by
    have h := Heap.load_of_mem hHolds ho1 hx1
    simpa [toObj, Lift.Shuffler.Internal.Proposed.Layout.spillsPtr, hself] using h
  have hloadB1 : (initP a).input.heap.loadB ((initP a).input.rdi.toBitVec + 16) .W64 = .ok spills := by
    simpa [initP] using Heap.loadB_of_load hload1
  have hrsi' : ((initP a).input.rsi).toBitVec = Lift.Shuffler.Internal.Proposed.Layout.slotWord slot (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).pad := by
    simpa [initP] using hrsi
  have ho2 : toObj (Lift.Shuffler.Internal.Proposed.Layout.spillByte (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad) st slot.payload false) ∈ a.heap := by
    rw [hheap]
    simp [objsP, Lift.Shuffler.Internal.Proposed.IsSpilledStatement.objects]
  have hx2 : (0, (⟨.W8, st.spills slot.payload⟩ : Cell)) ∈ offsets 0 (toObj (Lift.Shuffler.Internal.Proposed.Layout.spillByte (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad) st slot.payload false)).cells := by
    simp [toObj, toCell, Lift.Shuffler.Internal.Proposed.Layout.spillByte,
      Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf, offsets]
  have hload2 : a.heap.load (spills + slot.payload.setWidth 64) .W8 = .ok (st.spills slot.payload) := by
    have h := Heap.load_of_mem hHolds ho2 hx2
    simpa [toObj, Lift.Shuffler.Internal.Proposed.Layout.spillByte,
      Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf] using h
  have hloadB2 : (initP a).input.heap.loadB (spills + slot.payload.setWidth 64) .W8 = .ok (st.spills slot.payload) := by
    simpa [initP] using Heap.loadB_of_load hload2
  lift_straight
  case ret_1 =>
    have hvar : FlatShuffler.Flat.isVariable slot = false :=
      isVariable_of_cond_eq_zero slot (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).pad (initP a).input.rsi (by simpa [initP] using hrsi) hp1
    rw [encode_result, hyv, hvar]
    simp
  case ret_2 =>
    have hvar : FlatShuffler.Flat.isVariable slot = true :=
      isVariable_of_cond_ne_zero slot (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).pad (initP a).input.rsi (by simpa [initP] using hrsi) hp1
    have hv1 : v1 = spills := by
      rw [hloadB1] at hp2
      exact (Res.ok.inj hp2).symm
    have hv2 : v2 = st.spills slot.payload := by
      have hmul : slot.payload.setWidth 64 * 1 = slot.payload.setWidth 64 := by bv_decide
      rw [hv1, hrsi', slotWord_truncate slot (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).pad,
        BitVec.zeroExtend_eq_setWidth, hmul, hloadB2] at hp3
      exact (Res.ok.inj hp3).symm
    rw [encode_result, hv1, hv2, hyv, hvar]
    simp only [Bool.true_and]
    have hmain : (if (st.spills slot.payload != 0) = true then (1 : BitVec 8) else 0) =
        BitVec.setWidth 8 (((UInt64.ofBitVec spills &&& 18446744073709551360) ||| ((if ¬ (UInt64.ofBitVec (BitVec.zeroExtend 64 (st.spills slot.payload)) = 0) then 1 else 0) &&& 255) : UInt64).toBitVec) := by
      bv_decide
    simpa using hmain
  case nofault_1 =>
    rw [hloadB1] at hp2
    have hv1 : v1 = spills := (Res.ok.inj hp2).symm
    have hmul : slot.payload.setWidth 64 * 1 = slot.payload.setWidth 64 := by bv_decide
    rw [hv1, hrsi', slotWord_truncate slot (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).pad,
      BitVec.zeroExtend_eq_setWidth, hmul, hloadB2] at hp3
    cases hp3
  case nofault_2 =>
    rw [hloadB1] at hp2
    have hv1 : v1 = spills := (Res.ok.inj hp2).symm
    have hmul : slot.payload.setWidth 64 * 1 = slot.payload.setWidth 64 := by bv_decide
    rw [hv1, hrsi', slotWord_truncate slot (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).pad,
      BitVec.zeroExtend_eq_setWidth, hmul, hloadB2] at hp3
    cases hp3
  case nofault_3 =>
    rw [hloadB1] at hp2
    cases hp2
  case nofault_4 =>
    rw [hloadB1] at hp2
    cases hp2
end refines_l3.skel_proof
theorem refines_l3 : refines_l3.skel_statement := @refines_l3.skel_proof.refines_l3
theorem above_l3 : ∀ (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot), Above l2p (l3 self spills pad frame st slot) := by
  intro self spills pad frame st slot
  refine Above.ofRefines (fun _ _ _ => SimArr self spills pad frame st slot) _ (fun _ _ => refines_l3 self spills pad frame st slot) ?_ ?_
  · rintro policy _ s ⟨hh, hperm, hC, he, hq0, hq1⟩
    exact ⟨⟨objsP self spills pad st slot ++ frame, s.data.regs.rsi, s.data.regs.rdi⟩, ⟨hh, hperm, he, rfl, rfl⟩, ⟨hC, hq0, hq1, rfl, ⟨policy, _, hh⟩⟩⟩
  · rintro _ _ _ _ _ _ _ _ _ hr ⟨hx, hm, ht⟩
    exact ⟨hx, hm, by rw [ht]; exact hr⟩
theorem total : ∀ (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64), Lift.Shuffler.Internal.Proposed.IsSpilledStatement.C st slot → ∃ y, Lift.Shuffler.Internal.Proposed.IsSpilledStatement.run st slot = some y := by intros; exact ⟨_, rfl⟩
theorem decompiles : ∀ (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot), Decompiles Lift.Shuffler.L1.step (l3 self spills pad frame st slot) := by intros; apply Decompiles.above (decompiles_l2.above above_l2p); apply above_l3
theorem decompiles_code : ∀ (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot), Decompiles (fun s => Lift.Shuffler.Code.code.step s .done) (l3 self spills pad frame st slot) := by intros; exact (Sites.decompiles_l1Spec_iff Lift.Shuffler.Code.code Lift.Shuffler.L1.step Lift.Shuffler.L1.spec _).mp (by apply decompiles)
theorem contract : ∀ (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (policy : CpuPolicy) (s : MachineState), (l3 self spills pad frame st slot).rep policy () s → Lift.Shuffler.Internal.Proposed.IsSpilledStatement.C st slot → Reaches (fun s => Lift.Shuffler.Code.code.step s .done) policy (fun t => ∃ y, (l3 self spills pad frame st slot).post () y s t ∧ Lift.Shuffler.Internal.Proposed.IsSpilledStatement.run st slot = some y) s := by intro self spills pad; intros; rename_i st slot _ _ _ _; apply Decompiles.transfer _ (fun (_ : Unit) => Lift.Shuffler.Internal.Proposed.IsSpilledStatement.C st slot) (fun _ y => Lift.Shuffler.Internal.Proposed.IsSpilledStatement.run st slot = some y) (fun _ h => total st slot self spills pad h) (fun _ _ _ h => h) <;> first | assumption | apply decompiles_code
theorem final : Lift.Shuffler.Internal.Proposed.IsSpilledStatement.IsSpilledStatement := by
  intro st slot hC self spills pad policy ra s heB
  have he := heB.1
  have hrep : (l3 self spills pad [] st slot).rep policy () s :=
    ⟨Lift.Sem.Final.holds he, Lift.Sem.Final.permits heB, hC, Lift.Sem.Bridge.Fn.Entry.sysV (lo := Lift.Shuffler.shufflePC) (hi := Lift.Shuffler.shufflerEndPC) he (by decide +kernel) (by decide +kernel), Lift.Sem.Final.bv64 he.inRegs 0 rfl, Lift.Sem.Final.bv64 he.inRegs 1 rfl⟩
  refine (contract self spills pad [] st slot policy s hrep hC).mono ?_
  rintro t ⟨y, ⟨hexit, hmem, hrel⟩, hrun⟩
  refine Lift.Sem.Final.ret he 0 rfl hexit (fun _ _ _ => by rw [hmem]) ?_
  simp only [Lift.Shuffler.Internal.Proposed.IsSpilledStatement.post, Lift.Shuffler.Internal.Proposed.IsSpilledStatement.fn]
  first | exact ⟨y, hrun, hrel⟩ | (refine ⟨y, hrun, ?_⟩; simp [Lift.Trusted.Encode.encode, Width.bits, hrel]; done) | (refine ⟨y, hrun, ?_⟩; simpa [Width.bits] using hrel; done)
theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : UInt64) (q : UInt64) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    callState (fun (r : UInt64) (q : UInt64) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l x z n hs ht
      rcases hs with ⟨hinput, h_rax, h_rcx, htrue⟩
      cases l <;> simp only [blocksP, callInput, hinput, h_rax, h_rcx] at ht
      all_goals repeat' split at ht
      all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
      all_goals subst n
      all_goals simp_all [skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
      all_goals refine ⟨_, _, ⟨rfl, rfl⟩, rfl, ?_⟩
      all_goals intros; simp_all [callState, callInput])
    hr (by simp [callState, initP, skel_call.initP, callInput])
def call_bridge_rev.skel_statement : Prop := Refines (fun a b => b = callInput a) (fun _ _ (q : UInt64) (r : UInt64) => r = q) skel_call.l2p.returns l2p.returns
namespace call_bridge_rev.skel_proof
skel_proof_aliases call_bridge_rev.skel_proof excluding [bridgeState, BridgeHiNext, BridgeLoNext, bridgeNext, bridgeRes, bridgeState_related, bridge_related_eq, bridgeNext_related, bridgeNext_related_rev, bridge_goto, bridge_step_eq_entry, bridge_step_eq_o28, bridge_step_eq_LBB13_3, bridge_step_eq, call_bridge_rev]
def bridgeState (z : St skel_call.In2p) : St In2p := { input := callInput z.input, rax := z.rax, rcx := z.rcx }

abbrev BridgeHiNext := Next Lbl (St In2p) UInt64 Empty Empty.elim Empty.elim
abbrev BridgeLoNext := Next Lbl (St skel_call.In2p) UInt64 Empty Empty.elim Empty.elim

def bridgeNext : BridgeLoNext → BridgeHiNext
  | .goto l z => .goto l (bridgeState z)
  | .ret r => .ret r
  | .call f x k => .call f x (fun r => ((k r).1, bridgeState (k r).2))

def bridgeRes : Res BridgeLoNext → Res BridgeHiNext
  | .ok n => .ok (bridgeNext n)
  | .stuck why => .stuck why
  | .noFuel => .noFuel

theorem bridgeState_related (z : St skel_call.In2p) : callState (bridgeState z) z := by
  simp [callState, bridgeState]

theorem bridge_related_eq (x : St In2p) (z : St skel_call.In2p)
    (h : callState x z) : x = bridgeState z := by
  cases x
  cases z
  simp_all [callState, bridgeState, callInput]

theorem bridgeNext_related (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      callState (fun (r : UInt64) (q : UInt64) => r = q) (bridgeNext n) (.ok n) := by
  cases n with
  | goto l z => exact ⟨z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, k, rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridgeNext_related_rev (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q) n (.ok (bridgeNext n)) := by
  cases n with
  | goto l z => exact ⟨bridgeState z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, (fun r => ((k r).1, bridgeState (k r).2)), rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridge_goto {l : Lbl} {input : skel_call.In2p} {rax : UInt64} {rcx : UInt64} :
    (Res.ok (Next.goto l { input := callInput input, rax := rax, rcx := rcx }) : Res BridgeHiNext) =
      bridgeRes (.ok (.goto l { input := input, rax := rax, rcx := rcx })) := rfl

set_option maxHeartbeats 400000 in
theorem bridge_step_eq_entry (z : St skel_call.In2p) :
    blocksP.step .entry (bridgeState z) = bridgeRes (skel_call.blocksP.step .entry z) := by
  simp only [blocksP, skel_call.blocksP, bridgeState, callInput]
  all_goals repeat' split
  all_goals first | exact bridge_goto | rfl

set_option maxHeartbeats 400000 in
theorem bridge_step_eq_o28 (z : St skel_call.In2p) :
    blocksP.step .o28 (bridgeState z) = bridgeRes (skel_call.blocksP.step .o28 z) := by
  simp only [blocksP, skel_call.blocksP, bridgeState, callInput]
  all_goals repeat' split
  all_goals first | exact bridge_goto | rfl

set_option maxHeartbeats 400000 in
theorem bridge_step_eq_LBB13_3 (z : St skel_call.In2p) :
    blocksP.step .LBB13_3 (bridgeState z) = bridgeRes (skel_call.blocksP.step .LBB13_3 z) := by
  simp only [blocksP, skel_call.blocksP, bridgeState, callInput]
  all_goals repeat' split
  all_goals first | exact bridge_goto | rfl

theorem bridge_step_eq (l : Lbl) (z : St skel_call.In2p) :
    blocksP.step l (bridgeState z) = bridgeRes (skel_call.blocksP.step l z) := by
  cases l with
  | entry => exact bridge_step_eq_entry z
  | o28 => exact bridge_step_eq_o28 z
  | LBB13_3 => exact bridge_step_eq_LBB13_3 z
theorem call_bridge_rev : Refines (fun a b => b = callInput a) (fun _ _ (q : UInt64) (r : UInt64) => r = q) skel_call.l2p.returns l2p.returns := by
  intro a b r hab hr
  subst b
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l z x n hs ht
      have hx := bridge_related_eq x z hs
      subst x
      rw [bridge_step_eq, ht]
      exact bridgeNext_related_rev n)
    hr (by simp [callState, initP, skel_call.initP, callInput])
end call_bridge_rev.skel_proof
theorem call_bridge_rev : call_bridge_rev.skel_statement := @call_bridge_rev.skel_proof.call_bridge_rev
theorem call_summary : callSummary := by
  intro self spills pad frame st slot a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 self spills pad frame st slot () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨r, hrel, hmap⟩⟩
end skel_semantic
end Skel.Gen.Level3.Shuffler.emissionIsSpilled

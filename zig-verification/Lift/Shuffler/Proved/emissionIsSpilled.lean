def SimSt (x : St In2p) (y : St In2) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rcx = y.rcx

def SimArr (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (a : In2p) : Prop := (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.C st slot) ∧ a.rdi.toBitVec = ((Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).self) ∧ a.rsi.toBitVec = (Lift.Shuffler.Internal.Proposed.Layout.slotWord slot (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).pad) ∧ a.heap = objsP self spills pad st slot ++ frame ∧ ∃ policy m, a.heap.Holds policy m

def l3 (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) : Model Unit (Bool) where
  rep policy _ s := Heap.Holds policy (objsP self spills pad st slot ++ frame) s.data.dmem ∧ Heap.Permits policy (objsP self spills pad st slot ++ frame) ∧ (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.C st slot) ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.emissionIsSpilledPC s ∧ s.data.regs.rdi.toBitVec = ((Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).self) ∧ s.data.regs.rsi.toBitVec = (Lift.Shuffler.Internal.Proposed.Layout.slotWord slot (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.envOf self spills pad).pad)
  returns _ y := Lift.Shuffler.Internal.Proposed.IsSpilledStatement.run st slot = some y
  post _ y s t := SysV.Exit s t ∧ t.data.dmem = s.data.dmem ∧ Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.IsSpilledStatement.result st slot y) y) = [⟨.W8, t.data.regs.rax.toBitVec.setWidth 8⟩]

namespace skel_call

structure In2p where
  heap : Heap
  rsi : UInt64
  rdi : UInt64

def initP {I : Type} (a : I) : St I := ⟨a, 0, 0⟩

def blocksP : Leaf Lbl (St In2p) UInt64 where
  step
    | .entry, x =>
      .ok (if ((if ¬ ((x.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) &&& (if (x.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then 1 else 0) : UInt64) = 0 then .goto .o28 { x with rax := (x.input.rsi >>> (32 : UInt64) &&& 18446744073709551360) ||| ((if (x.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then 1 else 0) &&& 255), rcx := (x.input.rsi >>> (40 : UInt64) &&& 18446744073709551360) ||| ((if ¬ ((x.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) &&& 255) } else .goto .LBB13_3 { x with rax := (x.input.rsi >>> (32 : UInt64) &&& 18446744073709551360) ||| ((if (x.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then 1 else 0) &&& 255), rcx := (x.input.rsi >>> (40 : UInt64) &&& 18446744073709551360) ||| ((if ¬ ((x.input.rsi >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) &&& 255) })
    | .o28, x =>
      .ok (.ret 0)
    | .LBB13_3, x =>
      match x.input.heap.loadB (x.input.rdi.toBitVec + 16) .W64 with
      | .ok v =>
        match x.input.heap.loadB (v + BitVec.zeroExtend 64 (BitVec.truncate 32 (x.input.rsi.toBitVec)) * 1) .W8 with
        | .ok v1 =>
          .ok (.ret ((UInt64.ofBitVec v &&& 18446744073709551360) ||| ((if ¬ (UInt64.ofBitVec (BitVec.zeroExtend 64 v1) = 0) then 1 else 0) &&& 255)))
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel

def postP {A : Type} (_ : A) (r : UInt64) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.dmem = s.data.dmem ∧ t.data.regs.rax = r

def l2p : Model In2p UInt64 where
  rep policy a s := a.heap.Holds policy s.data.dmem ∧ Heap.Permits policy a.heap ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.emissionIsSpilledPC s ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi
  returns a r := blocksP.Returns noCall .entry (initP a) r
  post := postP


end skel_call

def callInput (a : skel_call.In2p) : In2p := { heap := a.heap, rsi := a.rsi, rdi := a.rdi }

def callState (x : St In2p) (z : St skel_call.In2p) : Prop := x.input = callInput z.input ∧ x.rax = z.rax ∧ x.rcx = z.rcx ∧ True

def callPre (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (a : skel_call.In2p) : Prop := SimArr self spills pad frame st slot (callInput a)

def callPost (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.run st slot)) (q : UInt64) : Prop := (∃ (r : UInt64), (Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.IsSpilledStatement.result st slot y) y) = [⟨.W8, r.toBitVec.setWidth 8⟩]) ∧ r = q)

abbrev callSummary : Prop := ∀ (self : BitVec 64) (spills : BitVec 64) (pad : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (slot : FlatShuffler.StackSlot) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Shuffler.Internal.Proposed.IsSpilledStatement.run st slot)), callPre self spills pad frame st slot a → Lift.Shuffler.Internal.Proposed.IsSpilledStatement.run st slot = some y → ∃ q, skel_call.l2p.returns a q ∧ callPost self spills pad frame st slot a y q

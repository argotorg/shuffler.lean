theorem hdr_load_24 {h : Heap} {m : DataMem} {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder}
    (hh : h.Holds policy m) (ho : hdrObj b ∈ h) :
    h.load (24 : BitVec 64) .W64 = .ok b.targetSize := by
  refine hdr_load hh ho ?_
  have h2 := mem_offsets_index (hdrObj b).cells 0 3 (by simp [hdrObj_cells])
  simpa [hdrObj_cells] using h2

theorem load_words8 {h : Heap} {m : DataMem} {policy : CpuPolicy} {base : BitVec 64}
    {wr : Bool} {xs : List (BitVec 8)} {i : BitVec 64}
    (hh : h.Holds policy m) (ho : Obj.words base wr .W8 xs ∈ h) (hi : i.toNat < xs.length) :
    h.load (base + i) .W8 = .ok xs[i.toNat] := by
  have hi' : i.toNat < (Obj.words base wr .W8 xs).cells.length := by
    simpa [Obj.words] using hi
  have hx := mem_offsets_index (Obj.words base wr .W8 xs).cells 0 i.toNat hi'
  have hf : ((List.map (fun c => c.w.bytes) ((Obj.words base wr .W8 xs).cells.take i.toNat)).sum)
      = i.toNat := by
    have h := words_fieldOff .W8 xs i.toNat (Nat.le_of_lt hi)
    simpa [Obj.words] using h
  rw [Nat.zero_add, hf] at hx
  have hc : (Obj.words base wr .W8 xs).cells[i.toNat] = (⟨.W8, xs[i.toNat]⟩ : Cell) := by
    simp [Obj.words]
  rw [hc] at hx
  have h1 := Heap.load_cell hh ho hx
  simpa [Obj.words] using h1

theorem loadB_ok_of_spans {h : Heap} {o : Obj} {a : BitVec 64} {w : Width}
    (ho : o ∈ h) (hsp : o.Spans a w) : ∃ v, h.loadB a w = .ok v := by
  have hsome : (List.findSome? (fun o => o.loadBytes a w) h).isSome := by
    rw [List.isSome_findSome?, List.any_eq_true]
    refine ⟨o, ho, ?_⟩
    unfold Obj.loadBytes
    rw [if_pos hsp]
    rfl
  obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp hsome
  cases hl : h.load a w with
  | ok u => exact ⟨u, by rw [Heap.loadB, hl]⟩
  | stuck s => exact ⟨v, by rw [Heap.loadB, hl, hv]⟩
  | noFuel => exact ⟨v, by rw [Heap.loadB, hl, hv]⟩

theorem byte4_toNat (w : BitVec 64) :
    ((Int.toBytes 8 w.toInt)[4]!).toNat = (w.extractLsb' 32 8).toNat := by
  have hlen : 4 < (Int.toBytes 8 w.toInt).length := by rw [Int.toBytes_length]; decide
  have e1 : ((Int.toBytes 8 w.toInt).drop 4).take 1 = [(Int.toBytes 8 w.toInt)[4]!] :=
    drop_take_one hlen
  have e2 := kind_byte_of_word w
  rw [e1, ofInt_byte] at e2
  rw [← e2, UInt8.toNat_toBitVec]

theorem slotWord_kind_toNat (s : FlatShuffler.StackSlot) :
    ((Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0).extractLsb' 32 8).toNat = s.kind.toNat := by
  have h := Lift.Pilot.kind_byte (Lift.Shuffler.Zig.Slot.join (s, 0))
  have e : Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0
      = (Lift.Shuffler.Zig.Slot.join (s, 0)).word := rfl
  rw [e, h]
  rfl

theorem tgtWords_get (b : FlatShuffler.Flat.Builder) (j : BitVec 64)
    (hj : j.toNat < FlatShuffler.maxStackSize) :
    (tgtWords b).get ⟨j.toNat, by rw [tgtWords_length]; exact hj⟩ =
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (FlatShuffler.Flat.get b.target j) 0 := by
  rw [get_eq_toList b.target j hj]
  simp [tgtWords, List.getElem_map]

theorem drop_load {policy : CpuPolicy} {h : Heap} {m : DataMem} {b : FlatShuffler.Flat.Builder}
    {j : BitVec 64} (hh : h.Holds policy m) (ho : dropObj b ∈ h)
    (hj : j.toNat < FlatShuffler.maxStackSize) :
    h.load (0x5000 + j) .W8 =
      .ok (b.dropped.toList[j.toNat]'(by simpa using hj)) :=
  load_words8 hh ho (by simpa using hj)

theorem dest_load {policy : CpuPolicy} {h : Heap} {m : DataMem}
    {M : FlatShuffler.Flat.Mapping} {j : BitVec 64}
    (hh : h.Holds policy m) (ho : destObj M ∈ h) (hj : j.toNat < FlatShuffler.maxStackSize) :
    h.load (0x6000 + 8 * j) .W64 =
      .ok (M.dest.toList[j.toNat]'(by simpa using hj)) :=
  Heap.load_words64 hh ho (by simpa using hj)

theorem pos_load {policy : CpuPolicy} {h : Heap} {m : DataMem}
    {M : FlatShuffler.Flat.Mapping} {j : BitVec 64}
    (hh : h.Holds policy m) (ho : posObj M ∈ h) (hj : j.toNat < FlatShuffler.maxStackSize) :
    h.load (0x8000 + 8 * j) .W64 =
      .ok (M.pos.toList[j.toNat]'(by simpa using hj)) :=
  Heap.load_words64 hh ho (by simpa using hj)

theorem tgt_byte_eq {policy : CpuPolicy} {h : Heap} {m : DataMem} {b : FlatShuffler.Flat.Builder}
    {j : BitVec 64} (hh : h.Holds policy m) (ht : tgtObj b ∈ h)
    (hj : j.toNat < FlatShuffler.maxStackSize) :
    (tgtObj b).bytes[8 * j.toNat + 4]! =
      (Int.toBytes 8 ((tgtWords b).get ⟨j.toNat, by
        rw [tgtWords_length]; exact hj⟩).toInt)[4]! := by
  have hw := Heap.load_words64 hh ht (i := j) (by rw [tgtWords_length]; exact hj)
  have hcont := readRam_contains (Heap.load_sound hh hw)
  have h1 := contains_byte hcont (i := 4) (by rw [Int.toBytes_length]; decide)
  have h2 := contains_byte (hh.contains ht) (i := 8 * j.toNat + 4) (by
    rw [tgtObj_bytes_length]
    have := hj
    simp only [FlatShuffler.maxStackSize] at this ⊢
    omega)
  have haddr : 0x3000 + BitVec.ofNat 64 (8 * j.toNat + 4) =
      (0x3000 + 8 * j) + BitVec.ofNat 64 4 := by
    have := hj
    simp only [FlatShuffler.maxStackSize] at this
    bv_omega
  rw [show (tgtObj b).addr = 0x3000 from rfl, haddr] at h2
  rw [h1] at h2
  exact (UInt8.toNat_inj.mp (by exact_mod_cast (Option.some.inj h2))).symm

theorem tgtObj_size (b : FlatShuffler.Flat.Builder) :
    (tgtObj b).size = 8 * FlatShuffler.maxStackSize := by
  rw [← Obj.bytes_length, tgtObj_bytes_length]

theorem Obj.ne_of_addr {o o' : Obj} (h : o.addr ≠ o'.addr) : o ≠ o' :=
  fun e => h (congrArg (fun x => x.addr) e)

theorem hdrObj_ne_destObj (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    hdrObj b ≠ destObj M :=
  Obj.ne_of_addr (by
    rw [hdrObj_addr, show (destObj M).addr = 0x6000 from rfl]
    decide)

theorem hdrObj_ne_posObj (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    hdrObj b ≠ posObj M :=
  Obj.ne_of_addr (by
    rw [hdrObj_addr, show (posObj M).addr = 0x8000 from rfl]
    decide)

theorem tgtObj_ne_destObj (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    tgtObj b ≠ destObj M :=
  Obj.ne_of_addr (by
    rw [show (tgtObj b).addr = 0x3000 from rfl, show (destObj M).addr = 0x6000 from rfl]
    decide)

theorem tgtObj_ne_posObj (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    tgtObj b ≠ posObj M :=
  Obj.ne_of_addr (by
    rw [show (tgtObj b).addr = 0x3000 from rfl, show (posObj M).addr = 0x8000 from rfl]
    decide)

theorem dropObj_ne_destObj (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :

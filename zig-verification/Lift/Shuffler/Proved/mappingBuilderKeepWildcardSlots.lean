theorem encode_field (f : Lift.Trusted.Field) : Lift.Trusted.Encode.encode f = [f] := rfl

theorem result_done (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (s : FlatShuffler.Flat.Mapping) :
    Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.result b M
      (FlatShuffler.Flat.ExecutionControl.done, s) = ⟨.W16, 0⟩ := rfl

theorem keepFrom_done {b : FlatShuffler.Flat.Builder} (M : FlatShuffler.Flat.Mapping)
    (j : FlatShuffler.Word) :
    (FlatShuffler.Flat.keepFrom b M j).1 = FlatShuffler.Flat.ExecutionControl.done := by
  have key : ∀ n : Nat, ∀ (M : FlatShuffler.Flat.Mapping) (j : FlatShuffler.Word),
      (FlatShuffler.Flat.commonSize b).toNat - j.toNat = n →
      (FlatShuffler.Flat.keepFrom b M j).1 = FlatShuffler.Flat.ExecutionControl.done := by
    intro n
    induction n with
    | zero =>
      intro M j hj
      rw [keepFrom_ge (b := b) (M := M) (j := j) (by omega)]
    | succ n ih =>
      intro M j hj
      by_cases h : j.toNat < (FlatShuffler.Flat.commonSize b).toNat
      · have hsucc : ((j + 1 : FlatShuffler.Word)).toNat = j.toNat + 1 := by
          rw [BitVec.toNat_add]
          have h1 : (1 : BitVec 64).toNat = 1 := by simp
          rw [h1, Nat.mod_eq_of_lt]
          omega
        rw [keepFrom_step (b := b) (M := M) (j := j) h]
        exact ih (stepM b M j) (j + 1) (by rw [hsucc]; omega)
      · rw [keepFrom_ge (b := b) (M := M) (j := j) (by omega)]
  exact key _ M j rfl

open FlatShuffler.Flat Lift.Trusted

/-- The fields of the header object of the statement's heap. -/
def hdrFields (b : FlatShuffler.Flat.Builder) : List Field :=
  [⟨.W64, 0x1000⟩, ⟨.W64, b.sourceSize⟩, ⟨.W64, 0x3000⟩, ⟨.W64, b.targetSize⟩,
   ⟨.W64, 0x5000⟩, ⟨.W8, if b.take then 1 else 0⟩, ⟨.W32, 0⟩, ⟨.W16, 0⟩, ⟨.W8, 0⟩,
   ⟨.W64, 0x6000⟩]

/-- The header object at address 0. -/
def hdrObj (b : FlatShuffler.Flat.Builder) : Obj := toObj ⟨0, hdrFields b, false⟩

def srcObj (b : FlatShuffler.Flat.Builder) : Obj :=
  Obj.words 0x1000 false .W64
    (b.source.toList.map fun s => Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0)

def tgtObj (b : FlatShuffler.Flat.Builder) : Obj :=
  Obj.words 0x3000 false .W64
    (b.target.toList.map fun s => Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0)

def dropObj (b : FlatShuffler.Flat.Builder) : Obj := Obj.words 0x5000 false .W8 b.dropped.toList

def destObj (xs : List (BitVec 64)) : Obj := Obj.words 0x6000 true .W64 xs

def posObj (ys : List (BitVec 64)) : Obj := Obj.words 0x8000 true .W64 ys

theorem objsP_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    objsP b M = [hdrObj b, srcObj b, tgtObj b, dropObj b, destObj M.dest.toList,
      posObj M.pos.toList] := by
  simp [objsP, Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.objects,
    hdrObj, hdrFields, srcObj, tgtObj, dropObj, destObj, posObj, Obj.words, toObj, toCell]

theorem hdrObj_get_8 (b : FlatShuffler.Flat.Builder) :
    (hdrObj b).get 8 .W64 = some b.sourceSize := by
  simp [hdrObj, hdrFields, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem hdrObj_get_24 (b : FlatShuffler.Flat.Builder) :
    (hdrObj b).get 24 .W64 = some b.targetSize := by
  simp [hdrObj, hdrFields, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem hdrObj_get_48 (b : FlatShuffler.Flat.Builder) :
    (hdrObj b).get 48 .W64 = some 0x6000 := by
  simp [hdrObj, hdrFields, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem hdrObj_get_32 (b : FlatShuffler.Flat.Builder) :
    (hdrObj b).get 32 .W64 = some 0x5000 := by
  simp [hdrObj, hdrFields, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem hdrObj_get_16 (b : FlatShuffler.Flat.Builder) :
    (hdrObj b).get 16 .W64 = some 0x3000 := by
  simp [hdrObj, hdrFields, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem hdrObj_writable (b : FlatShuffler.Flat.Builder) : (hdrObj b).writable = false := rfl

theorem hdrObj_addr (b : FlatShuffler.Flat.Builder) : (hdrObj b).addr = 0 := rfl

theorem destObj_size (xs : List (BitVec 64)) : (destObj xs).size = 8 * xs.length := by
  have := words_bytes .W64 xs
  simpa [destObj, Obj.words, Obj.size, Width.bytes] using this

theorem posObj_size (ys : List (BitVec 64)) : (posObj ys).size = 8 * ys.length := by
  have := words_bytes .W64 ys
  simpa [posObj, Obj.words, Obj.size, Width.bytes] using this

/-- A load of a cell of an object of a heap that a memory holds. -/
theorem loadB_of_get {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds policy m)
    {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width} {v : w.type} (hg : o.get a w = some v) :
    h.loadB a w = .ok v := by
  obtain ⟨x, hx, ha, hc⟩ := Obj.get_some hg
  have hl := Heap.load_of_mem hh ho hx
  rw [ha, hc] at hl
  exact Heap.loadB_of_load hl

/-- The own heap of the callee: the statement's objects, with the contents of the two written
arrays as parameters. -/
def ownHeap (b : FlatShuffler.Flat.Builder) (xs ys : List (BitVec 64)) : Heap :=
  [hdrObj b, srcObj b, tgtObj b, dropObj b, destObj xs, posObj ys]

theorem objsP_ownHeap (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    objsP b M = ownHeap b M.dest.toList M.pos.toList := by
  rw [objsP_eq]; rfl

theorem Obj.not_apart_self {O : Obj} (h : 0 < O.size) : ¬ O.Apart O := by
  unfold Obj.Apart; omega

/-- An object of the frame is not the writable object of the own heap, when a memory holds the
concatenation of the two. -/
theorem Obj.ne_of_holds_append {policy : CpuPolicy} {m : DataMem} {own frame : Heap}
    (hholds : (own ++ frame).Holds policy m) {O : Obj} (hO : O ∈ own) (hOw : O.writable)
    (hOsize : 0 < O.size) {p : Obj} (hp : p ∈ frame) : p ≠ O := by
  intro hpo
  subst hpo
  obtain ⟨i, hi, hie⟩ := List.getElem_of_mem hO
  obtain ⟨j, hj, hje⟩ := List.getElem_of_mem hp
  have hlen : i < (own ++ frame).length := by simp; omega
  have hlen2 : own.length + j < (own ++ frame).length := by simp; omega
  have hR := List.pairwise_iff_getElem.mp hholds.apart i (own.length + j) hlen hlen2 (by omega)
  rw [List.getElem_append_left hi] at hR
  rw [List.getElem_append_right (by omega)] at hR
  simp only [Nat.add_sub_cancel_left] at hR
  rw [hie, hje] at hR
  exact absurd (hR (Or.inl hOw)) (Obj.not_apart_self hOsize)

theorem set_of_not_writable {a : BitVec 64} {w : Width} {v : w.type} {o : Obj}
    (h : o.writable = false) : Obj.set a w v o = o := by
  unfold Obj.set; rw [h]; rfl

/-- The address `0x6000 + 8 * i` of the cell at index `i` of an array of words. -/
theorem ofNat_mul_eight (i : BitVec 64) (hi : i.toNat < 2 ^ 61) :
    BitVec.ofNat 64 (8 * i.toNat) = 8 * i := by
  rw [BitVec.ofNat_mul, BitVec.ofNat_toNat]
  simp

theorem destObj_set_self {xs : List (BitVec 64)} (hlen : xs.length = 1024) {i : BitVec 64}
    (hi : i.toNat < xs.length) (v : BitVec 64) :
    Obj.set (0x6000 + 8 * i) .W64 v (destObj xs) = destObj (xs.set i.toNat v) := by
  have hi' : i.toNat < (destObj xs).cells.length := by simpa [destObj, Obj.words] using hi
  have hno : (destObj xs).addr.toNat + (destObj xs).size ≤ 2 ^ 64 := by
    have h1 : (destObj xs).addr = 0x6000 := rfl
    have h2 := destObj_size xs
    rw [h1, h2, hlen]
    decide
  have h := Obj.set_field (o := destObj xs) rfl hno i.toNat hi' .W64 (by simp [destObj, Obj.words]) v
  have hfo : (destObj xs).fieldOff i.toNat = 8 * i.toNat := by
    have := words_fieldOff .W64 xs i.toNat (Nat.le_of_lt hi)
    simpa [destObj, Obj.words, Obj.fieldOff, Width.bytes] using this
  have haddr : (destObj xs).addr + BitVec.ofNat 64 ((destObj xs).fieldOff i.toNat) =
      0x6000 + 8 * i := by
    rw [hfo]
    show (0x6000 : BitVec 64) + BitVec.ofNat 64 (8 * i.toNat) = 0x6000 + 8 * i
    rw [ofNat_mul_eight i (by omega)]
  rw [haddr] at h
  rw [h]
  simp only [destObj, Obj.words]
  rw [← List.map_set]

theorem destObj_ne_posObj (xs ys : List (BitVec 64)) : destObj xs ≠ posObj ys := by
  intro h
  have := congrArg Obj.addr h
  simp [destObj, posObj, Obj.words] at this

theorem posObj_set_self {ys : List (BitVec 64)} (hlen : ys.length = 1024) {j : BitVec 64}
    (hj : j.toNat < ys.length) (v : BitVec 64) :
    Obj.set (0x8000 + 8 * j) .W64 v (posObj ys) = posObj (ys.set j.toNat v) := by
  have hi' : j.toNat < (posObj ys).cells.length := by simpa [posObj, Obj.words] using hj
  have hno : (posObj ys).addr.toNat + (posObj ys).size ≤ 2 ^ 64 := by
    have h1 : (posObj ys).addr = 0x8000 := rfl
    have h2 := posObj_size ys
    rw [h1, h2, hlen]
    decide
  have h := Obj.set_field (o := posObj ys) rfl hno j.toNat hi' .W64 (by simp [posObj, Obj.words]) v
  have hfo : (posObj ys).fieldOff j.toNat = 8 * j.toNat := by
    have := words_fieldOff .W64 ys j.toNat (Nat.le_of_lt hj)
    simpa [posObj, Obj.words, Obj.fieldOff, Width.bytes] using this
  have haddr : (posObj ys).addr + BitVec.ofNat 64 ((posObj ys).fieldOff j.toNat) =
      0x8000 + 8 * j := by
    rw [hfo]
    show (0x8000 : BitVec 64) + BitVec.ofNat 64 (8 * j.toNat) = 0x8000 + 8 * j
    rw [ofNat_mul_eight j (by omega)]
  rw [haddr] at h
  rw [h]
  simp only [posObj, Obj.words]
  rw [← List.map_set]

theorem destObj_cell_mem {xs : List (BitVec 64)} {i : BitVec 64} (hi : i.toNat < xs.length) :
    ((8 * i.toNat : Nat), (⟨.W64, xs[i.toNat]⟩ : Cell)) ∈ offsets 0 (destObj xs).cells := by
  have := mem_offsets_words .W64 xs 0 i.toNat hi
  simpa [destObj, Obj.words] using this

theorem posObj_cell_mem {ys : List (BitVec 64)} {j : BitVec 64} (hj : j.toNat < ys.length) :
    ((8 * j.toNat : Nat), (⟨.W64, ys[j.toNat]⟩ : Cell)) ∈ offsets 0 (posObj ys).cells := by
  have := mem_offsets_words .W64 ys 0 j.toNat hj
  simpa [posObj, Obj.words] using this

/-- A store into the destination array, as a map of the own heap and the frame. -/
theorem map_ownHeap_dest (b : FlatShuffler.Flat.Builder) (xs ys : List (BitVec 64))
    (frame : Heap) {policy : CpuPolicy} {m : DataMem} {xmem : Heap}
    (hperm : (ownHeap b xs ys ++ frame).Perm xmem) (hm : xmem.Holds policy m)
    (hlenx : xs.length = 1024) (hleny : ys.length = 1024) {i : BitVec 64}
    (hi : i.toNat < xs.length) (v : BitVec 64) :
    (ownHeap b xs ys ++ frame).map (Obj.set (0x6000 + 8 * i) .W64 v) =
      ownHeap b (xs.set i.toNat v) ys ++ frame := by
  have hh : (ownHeap b xs ys ++ frame).Holds policy m := (Heap.Holds_perm hperm).mpr hm
  have hD : destObj xs ∈ ownHeap b xs ys := by simp [ownHeap]
  have hD' : destObj xs ∈ ownHeap b xs ys ++ frame := List.mem_append_left _ hD
  have hsizeD : 0 < (destObj xs).size := by rw [destObj_size, hlenx]; omega
  have haddri : (destObj xs).addr + BitVec.ofNat 64 (8 * i.toNat) = 0x6000 + 8 * i := by
    show (0x6000 : BitVec 64) + BitVec.ofNat 64 (8 * i.toNat) = 0x6000 + 8 * i
    rw [ofNat_mul_eight i (by omega)]
  have hset : ∀ p ∈ ownHeap b xs ys ++ frame, p ≠ destObj xs →
      Obj.set (0x6000 + 8 * i) .W64 v p = p := by
    intro p hp hne
    have := Heap.Holds.set_other hh hD' rfl (destObj_cell_mem hi) hp hne v
    rwa [haddri] at this
  have hframe : frame.map (Obj.set (0x6000 + 8 * i) .W64 v) = frame := by
    have hg : ∀ p ∈ frame, Obj.set (0x6000 + 8 * i) .W64 v p = p :=
      fun p hp => hset p (List.mem_append_right _ hp)
        (Obj.ne_of_holds_append hh hD rfl hsizeD hp)
    calc frame.map (Obj.set (0x6000 + 8 * i) .W64 v) = frame.map id := List.map_congr_left hg
      _ = frame := List.map_id frame
  have hown : (ownHeap b xs ys).map (Obj.set (0x6000 + 8 * i) .W64 v) =
      ownHeap b (xs.set i.toNat v) ys := by
    simp only [ownHeap, List.map_cons, List.map_nil]
    rw [set_of_not_writable (o := hdrObj b) rfl, set_of_not_writable (o := srcObj b) rfl,
      set_of_not_writable (o := tgtObj b) rfl, set_of_not_writable (o := dropObj b) rfl,
      destObj_set_self hlenx hi v,
      hset (posObj ys) (by simp [ownHeap]) (destObj_ne_posObj xs ys).symm]
  rw [List.map_append, hown, hframe]

/-- A store into the position array, as a map of the own heap and the frame. -/
theorem map_ownHeap_pos (b : FlatShuffler.Flat.Builder) (xs ys : List (BitVec 64))
    (frame : Heap) {policy : CpuPolicy} {m : DataMem} {xmem : Heap}
    (hperm : (ownHeap b xs ys ++ frame).Perm xmem) (hm : xmem.Holds policy m)
    (hlenx : xs.length = 1024) (hleny : ys.length = 1024) {j : BitVec 64}
    (hj : j.toNat < ys.length) (v : BitVec 64) :
    (ownHeap b xs ys ++ frame).map (Obj.set (0x8000 + 8 * j) .W64 v) =
      ownHeap b xs (ys.set j.toNat v) ++ frame := by
  have hh : (ownHeap b xs ys ++ frame).Holds policy m := (Heap.Holds_perm hperm).mpr hm
  have hP : posObj ys ∈ ownHeap b xs ys := by simp [ownHeap]
  have hP' : posObj ys ∈ ownHeap b xs ys ++ frame := List.mem_append_left _ hP
  have hsizeP : 0 < (posObj ys).size := by rw [posObj_size, hleny]; omega
  have haddrj : (posObj ys).addr + BitVec.ofNat 64 (8 * j.toNat) = 0x8000 + 8 * j := by
    show (0x8000 : BitVec 64) + BitVec.ofNat 64 (8 * j.toNat) = 0x8000 + 8 * j
    rw [ofNat_mul_eight j (by omega)]
  have hset : ∀ p ∈ ownHeap b xs ys ++ frame, p ≠ posObj ys →
      Obj.set (0x8000 + 8 * j) .W64 v p = p := by
    intro p hp hne
    have := Heap.Holds.set_other hh hP' rfl (posObj_cell_mem hj) hp hne v
    rwa [haddrj] at this
  have hframe : frame.map (Obj.set (0x8000 + 8 * j) .W64 v) = frame := by
    have hg : ∀ p ∈ frame, Obj.set (0x8000 + 8 * j) .W64 v p = p :=
      fun p hp => hset p (List.mem_append_right _ hp)
        (Obj.ne_of_holds_append hh hP rfl hsizeP hp)
    calc frame.map (Obj.set (0x8000 + 8 * j) .W64 v) = frame.map id := List.map_congr_left hg
      _ = frame := List.map_id frame
  have hown : (ownHeap b xs ys).map (Obj.set (0x8000 + 8 * j) .W64 v) =
      ownHeap b xs (ys.set j.toNat v) := by
    simp only [ownHeap, List.map_cons, List.map_nil]
    rw [set_of_not_writable (o := hdrObj b) rfl, set_of_not_writable (o := srcObj b) rfl,
      set_of_not_writable (o := tgtObj b) rfl, set_of_not_writable (o := dropObj b) rfl,
      hset (destObj xs) (by simp [ownHeap]) (destObj_ne_posObj xs ys),
      posObj_set_self hleny hj v]
  rw [List.map_append, hown, hframe]

/-- The data of the invariant of the callee's run. -/
structure InnerData (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (xs ys : List (BitVec 64)) (l : mappingBuilderMap.Lbl)
    (x : mappingBuilderMap.St mappingBuilderMap.In2p Heap) : Prop where
  hxs : xs.length = 1024
  hys : ys.length = 1024
  perm : (ownHeap b xs ys ++ frame).Perm x.mem
  holds : ∃ m, x.mem.Holds policy m
  rdi : x.input.rdi.toBitVec = 0
  rsi : x.input.rsi.toNat < 1024
  rdx : x.input.rdx.toNat < 1024
  rcx : (l = .o25 ∨ l = .o36) → x.rcx.toBitVec = 0x6000

def InnerInv (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (l : mappingBuilderMap.Lbl) (x : mappingBuilderMap.St mappingBuilderMap.In2p Heap) : Prop :=
  ∃ xs ys, InnerData policy b frame xs ys l x

/-- The result of the callee's run. -/
structure InnerRes (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (r : UInt64 × Heap) : Prop where
  perm : ∃ xs ys, xs.length = 1024 ∧ ys.length = 1024 ∧ (ownHeap b xs ys ++ frame).Perm r.2
  holds : ∃ m, r.2.Holds policy m

theorem inner_block (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap) :
    ∀ (l : mappingBuilderMap.Lbl) (x : mappingBuilderMap.St mappingBuilderMap.In2p Heap)
      (n : Next mappingBuilderMap.Lbl (mappingBuilderMap.St mappingBuilderMap.In2p Heap)
        (UInt64 × Heap) Empty Empty.elim Empty.elim),
      InnerInv policy b frame l x → mappingBuilderMap.blocksP.step l x = .ok n →
      Lift.Sem.CallArm.Next.Inv (InnerInv policy b frame) (InnerRes policy b frame) noCall n := by
  intro l x n hI hstep
  obtain ⟨xs, ys, hI⟩ := hI
  cases l with
  | entry =>
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · split at hstep
      · split at hstep
        · cases hstep
          exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, hI.holds, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
        · cases hstep
          exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, hI.holds, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o14 =>
    obtain ⟨m, hm⟩ := hI.holds
    have hhdr : hdrObj b ∈ x.mem := hI.perm.subset (by simp [ownHeap])
    have hload : x.mem.loadB (x.input.rdi.toBitVec + 48) .W64 = .ok 0x6000 := by
      rw [hI.rdi]
      exact loadB_of_get hm hhdr (hdrObj_get_48 b)
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · rename_i v hv
      have hv0 : v = 0x6000 := by
        rw [hload] at hv
        exact (Res.ok.inj hv).symm
      subst hv0
      split at hstep
      · split at hstep
        · cases hstep
          exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, ⟨m, hm⟩, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
        · cases hstep
          exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, ⟨m, hm⟩, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o25 =>
    have hrcx : x.rcx.toBitVec = 0x6000 := hI.rcx (Or.inl rfl)
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · split at hstep
      · cases hstep
        exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, hI.holds, hI.rdi, hI.rsi, hI.rdx, fun _ => hrcx⟩⟩
      · cases hstep
        exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, hI.holds, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
    · cases hstep
    · cases hstep
  | o36 =>
    obtain ⟨m, hm⟩ := hI.holds
    have hrsi : x.input.rsi.toNat < xs.length := by rw [hI.hxs]; exact hI.rsi
    have hrdx : x.input.rdx.toNat < ys.length := by rw [hI.hys]; exact hI.rdx
    have hrcx : x.rcx.toBitVec = 0x6000 := hI.rcx (Or.inr rfl)
    have hD : destObj xs ∈ x.mem := hI.perm.subset (by simp [ownHeap])
    have hP : posObj ys ∈ x.mem := hI.perm.subset (by simp [ownHeap])
    obtain ⟨h1, hstore1, -⟩ := Heap.store_words64 hm hD hrsi x.input.rdx.toBitVec
    have hsb1 : x.mem.storeB (0x6000 + 8 * x.input.rsi.toBitVec) .W64 x.input.rdx.toBitVec
        = .ok h1 := Heap.storeB_of_store hstore1
    obtain ⟨m1, hm1⟩ := Heap.storeB_holds hm hsb1
    have e1 : h1 = x.mem.map (Obj.set (0x6000 + 8 * x.input.rsi.toBitVec) .W64
        x.input.rdx.toBitVec) := (Heap.store_ok hstore1).1
    have hperm1 : (ownHeap b (xs.set x.input.rsi.toNat x.input.rdx.toBitVec) ys ++ frame).Perm h1 := by
      have hm1' := (hI.perm.map (Obj.set (0x6000 + 8 * x.input.rsi.toBitVec) .W64
        x.input.rdx.toBitVec)).symm
      rw [map_ownHeap_dest (i := x.input.rsi.toBitVec) b xs ys frame hI.perm hm hI.hxs hI.hys
        hrsi x.input.rdx.toBitVec] at hm1'
      rw [← e1] at hm1'
      exact hm1'.symm
    have hP1 : posObj ys ∈ h1 := hperm1.subset (by simp [ownHeap])
    obtain ⟨h2, hstore2, -⟩ := Heap.store_words64 hm1 hP1 hrdx x.input.rsi.toBitVec
    have hsb2 : h1.storeB (0x8000 + 8 * x.input.rdx.toBitVec) .W64 x.input.rsi.toBitVec
        = .ok h2 := Heap.storeB_of_store hstore2
    obtain ⟨m2, hm2⟩ := Heap.storeB_holds hm1 hsb2
    have e2 : h2 = h1.map (Obj.set (0x8000 + 8 * x.input.rdx.toBitVec) .W64
        x.input.rsi.toBitVec) := (Heap.store_ok hstore2).1
    have hperm2 : (ownHeap b (xs.set x.input.rsi.toNat x.input.rdx.toBitVec)
        (ys.set x.input.rdx.toNat x.input.rsi.toBitVec) ++ frame).Perm h2 := by
      have hm2' := (hperm1.map (Obj.set (0x8000 + 8 * x.input.rdx.toBitVec) .W64
        x.input.rsi.toBitVec)).symm
      rw [map_ownHeap_pos (j := x.input.rdx.toBitVec) b (xs.set x.input.rsi.toNat x.input.rdx.toBitVec)
        ys frame hperm1 hm1 (by rw [List.length_set]; exact hI.hxs) hI.hys hrdx x.input.rsi.toBitVec] at hm2'
      rw [← e2] at hm2'
      exact hm2'.symm
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · rename_i h1' hs1
      rw [show x.rcx.toBitVec + x.input.rsi.toBitVec * 8 =
          0x6000 + 8 * x.input.rsi.toBitVec from by rw [hrcx, BitVec.mul_comm]] at hs1
      rw [hsb1] at hs1
      have h1e : h1' = h1 := (Res.ok.inj hs1).symm
      subst h1e
      split at hstep
      · rename_i h2' hs2
        rw [show x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192 =
            0x8000 + 8 * x.input.rdx.toBitVec from by rw [hrcx]; bv_decide] at hs2
        rw [hsb2] at hs2
        have h2e : h2' = h2 := (Res.ok.inj hs2).symm
        subst h2e
        cases hstep
        exact ⟨_, _, ⟨by rw [List.length_set]; exact hI.hxs,
          by rw [List.length_set]; exact hI.hys, hperm2, ⟨m2, hm2⟩, hI.rdi, hI.rsi, hI.rdx,
          by simp⟩⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | LBB25_4 =>
    simp only [mappingBuilderMap.blocksP] at hstep
    cases hstep
    exact ⟨⟨xs, ys, hI.hxs, hI.hys, hI.perm⟩, hI.holds⟩

/-- The callee keeps the frame: a run of its blocks from a heap that is a permutation of the own
objects and the frame leaves a heap that still has the frame. -/
theorem inner_frame (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (k : mappingBuilderMap.In2p) (r : UInt64 × Heap)
    (hrdi : k.rdi.toBitVec = 0) (hrsi : k.rsi.toNat < 1024) (hrdx : k.rdx.toNat < 1024)
    (xs ys : List (BitVec 64)) (hlenx : xs.length = 1024) (hleny : ys.length = 1024)
    (hperm : (ownHeap b xs ys ++ frame).Perm k.heap)
    (hm : ∃ m, k.heap.Holds policy m)
    (hr : mappingBuilderMap.l2p.returns k r) :
    InnerRes policy b frame r := by
  refine Lift.Sem.CallArm.Blocks.Returns.inv (I := InnerInv policy b frame) (Q := InnerRes policy b frame)
    (block := inner_block policy b frame) hr ?_
  exact ⟨xs, ys, ⟨hlenx, hleny, hperm, hm, hrdi, hrsi, hrdx, by simp⟩⟩

/-- The data of the invariant of the caller's run. -/
structure OuterData (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder)
    (xs ys : List (BitVec 64)) (l : Lbl) (x : St skel_call.In2p Heap) : Prop where
  hxs : xs.length = 1024
  hys : ys.length = 1024
  perm : (ownHeap b xs ys ++ frame).Perm x.mem
  holds : ∃ m, x.mem.Holds a.policy m
  inp : x.input = a
  rbx : x.rbx.toBitVec = 0
  r14 : x.r14.toNat ≤ x.r15.toNat
  r15 : x.r15.toNat ≤ 1024
  strict : (l = .o44 ∨ l = .o63 ∨ l = .o78 ∨ l = .o89 ∨ l = .o96 ∨ l = .o110 ∨
    l = .LBB26_5) → x.r14.toNat < x.r15.toNat

def OuterInv (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder) :
    Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x = skel_call.initP a
  | l, x => ∃ xs ys, OuterData a frame b xs ys l x

/-- The result of the caller's run. -/
structure OuterRes (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder)
    (r : UInt64 × Heap) : Prop where
  perm : ∃ xs ys, xs.length = 1024 ∧ ys.length = 1024 ∧ (ownHeap b xs ys ++ frame).Perm r.2

theorem min_toNat (b : FlatShuffler.Flat.Builder) :
    (if UInt64.ofBitVec b.targetSize ≤ UInt64.ofBitVec b.sourceSize then
      UInt64.ofBitVec b.targetSize else UInt64.ofBitVec b.sourceSize).toNat =
      (commonSize b).toNat := by
  by_cases h : b.sourceSize < b.targetSize
  · have h' : ¬ (UInt64.ofBitVec b.targetSize ≤ UInt64.ofBitVec b.sourceSize) := by
      rw [UInt64.le_iff_toNat_le, UInt64.toNat_ofBitVec, UInt64.toNat_ofBitVec]
      rw [BitVec.lt_def] at h
      omega
    rw [if_neg h', commonSize, if_pos h]
    rw [UInt64.toNat_ofBitVec]
  · have h' : UInt64.ofBitVec b.targetSize ≤ UInt64.ofBitVec b.sourceSize := by
      rw [UInt64.le_iff_toNat_le, UInt64.toNat_ofBitVec, UInt64.toNat_ofBitVec]
      rw [BitVec.lt_def] at h
      omega
    rw [if_pos h', commonSize, if_neg h]
    rw [UInt64.toNat_ofBitVec]

theorem OuterData.go {a : skel_call.In2p} {frame : Heap} {b : FlatShuffler.Flat.Builder}
    {xs ys : List (BitVec 64)} {l l' : Lbl} {x x' : St skel_call.In2p Heap}
    (h : OuterData a frame b xs ys l x) (hmem : x'.mem = x.mem) (hinp : x'.input = x.input)
    (hrbx : x'.rbx = x.rbx) (hr14 : x'.r14 = x.r14) (hr15 : x'.r15 = x.r15)
    (hstrict : (l' = .o44 ∨ l' = .o63 ∨ l' = .o78 ∨ l' = .o89 ∨ l' = .o96 ∨ l' = .o110 ∨
      l' = .LBB26_5) → x'.r14.toNat < x'.r15.toNat) :
    OuterData a frame b xs ys l' x' where
  hxs := h.hxs
  hys := h.hys
  perm := by rw [hmem]; exact h.perm
  holds := by rw [hmem]; exact h.holds
  inp := by rw [hinp]; exact h.inp
  rbx := by rw [hrbx]; exact h.rbx
  r14 := by rw [hr14, hr15]; exact h.r14
  r15 := by rw [hr15]; exact h.r15
  strict := hstrict

/-- The callee relation of the caller's model. -/
def CallRel : ∀ _ : Unit, mappingBuilderMap.In2p → (UInt64 × Heap) → Prop :=
  fun _ x y => Lift.Sem.CallFrame.PermLift
    (fun k k' => mappingBuilderMap.l2p.returns {x with heap := k} (y.1, k')) x.heap y.2

theorem outer_block (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder)
    (M : FlatShuffler.Flat.Mapping) (hC : (commonSize b).toNat ≤ 1024)
    (hrdi : a.rdi.toBitVec = 0) (hheap : a.heap = objsP b M ++ frame)
    (hm0 : ∃ m, a.heap.Holds a.policy m) :
    ∀ (l : Lbl) (x : St skel_call.In2p Heap)
      (n : Next Lbl (St skel_call.In2p Heap) (UInt64 × Heap) Unit
        (fun _ => mappingBuilderMap.In2p) (fun _ => UInt64 × Heap)),
      OuterInv a frame b l x → skel_call.blocksP.step l x = .ok n →
      Lift.Sem.CallArm.Next.Inv (OuterInv a frame b) (OuterRes a frame b) CallRel n := by
  intro l x n hI hstep
  cases l with
  | entry =>
    obtain rfl : x = skel_call.initP a := hI
    have hhdr : hdrObj b ∈ a.heap := by
      rw [hheap, objsP_ownHeap]
      exact List.mem_append_left _ (by simp [ownHeap])
    obtain ⟨m0, hm0⟩ := hm0
    have hload8 : a.heap.loadB (a.rdi.toBitVec + 8) .W64 = .ok b.sourceSize := by
      rw [hrdi]; exact loadB_of_get hm0 hhdr (hdrObj_get_8 b)
    have hload24 : a.heap.loadB (a.rdi.toBitVec + 24) .W64 = .ok b.targetSize := by
      rw [hrdi]; exact loadB_of_get hm0 hhdr (hdrObj_get_24 b)
    simp only [skel_call.blocksP, skel_call.initP] at hstep
    rw [hload8, hload24] at hstep
    cases hstep
    refine ⟨M.dest.toList, M.pos.toList, ⟨Vector.length_toList, Vector.length_toList, ?_,
      ⟨m0, hm0⟩, rfl, ?_, ?_, ?_, by simp⟩⟩
    · rw [hheap, objsP_ownHeap]
    · exact hrdi
    · show (0 : Nat) ≤ _
      omega
    · rw [min_toNat]; exact hC
  | LBB26_1 =>
    obtain ⟨xs, ys, hI⟩ := hI
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · rename_i hc
      cases hstep
      exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (by simp)⟩
    · rename_i hc
      have hne : x.r14.toNat < x.r15.toNat := by
        have h1 := hI.r14
        have h2 : x.r14 ≠ x.r15 := fun e => hc e.symm
        have h3 : x.r14.toNat ≠ x.r15.toNat := fun e => h2 (UInt64.toNat_inj.mp e)
        omega
      cases hstep
      exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hne)⟩
  | o44 =>
    obtain ⟨xs, ys, hI⟩ := hI
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · split at hstep
      · split at hstep
        · cases hstep
          exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
        · cases hstep
          exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o63 =>
    obtain ⟨xs, ys, hI⟩ := hI
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · split at hstep
      · split at hstep
        · cases hstep
          exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
        · cases hstep
          exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o78 =>
    obtain ⟨xs, ys, hI⟩ := hI
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · split at hstep
      · split at hstep
        · cases hstep
          exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
        · cases hstep
          exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o89 =>
    obtain ⟨xs, ys, hI⟩ := hI
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · split at hstep
      · cases hstep
        exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
      · cases hstep
        exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
    · cases hstep
    · cases hstep
  | o96 =>
    obtain ⟨xs, ys, hI⟩ := hI
    have hlt : x.r14.toNat < 1024 := by
      have h1 := hI.strict (by simp)
      have h2 := hI.r15
      omega
    simp only [skel_call.blocksP] at hstep
    cases hstep
    intro y hy
    obtain ⟨hh, hh', hr, hsp⟩ := hy
    have hpol : x.input.policy = a.policy := by rw [hI.inp]
    rw [hpol] at hr
    have hperm' : (ownHeap b xs ys ++ frame).Perm hh := hI.perm.trans hsp.perm_in
    have hholds' : ∃ m, hh.Holds a.policy m := by
      obtain ⟨m, hm⟩ := hI.holds
      exact ⟨m, (Heap.Holds_perm hsp.perm_in).mp hm⟩
    have hin := inner_frame a.policy b frame
      ⟨a.policy, hh, x.rax, x.r14, x.r14, x.rbx, x.input.sp - 40 - 8⟩ (y.1, hh')
      hI.rbx hlt hlt xs ys hI.hxs hI.hys hperm' hholds' hr
    obtain ⟨xs', ys', hxs', hys', hperm''⟩ := hin.perm
    refine ⟨xs', ys', ⟨hxs', hys', ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩⟩
    · exact hperm''.trans hsp.perm_out.symm
    · obtain ⟨m, hm⟩ := hin.holds
      exact ⟨m, (Heap.Holds_perm hsp.perm_out.symm).mp hm⟩
    · exact hI.inp
    · exact hI.rbx
    · exact hI.r14
    · exact hI.r15
    · exact fun _ => hI.strict (by simp)
  | o110 =>
    obtain ⟨xs, ys, hI⟩ := hI
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · cases hstep
      exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
    · cases hstep
      exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (fun _ => hI.strict (by simp))⟩
  | LBB26_5 =>
    obtain ⟨xs, ys, hI⟩ := hI
    have hlt : x.r14.toNat < x.r15.toNat := hI.strict (by simp)
    simp only [skel_call.blocksP] at hstep
    cases hstep
    refine ⟨xs, ys, ?_⟩
    refine ⟨hI.hxs, hI.hys, hI.perm, hI.holds, hI.inp, hI.rbx, ?_, hI.r15, by simp⟩
    show (x.r14 + 1).toNat ≤ x.r15.toNat
    have h1 : (x.r14 + 1).toNat = (x.r14.toNat + 1) % 2 ^ 64 := UInt64.toNat_add ..
    rw [h1]
    have h2 : (x.r14.toNat + 1) % 2 ^ 64 ≤ x.r14.toNat + 1 := Nat.mod_le ..
    omega
  | LBB26_2 =>
    obtain ⟨xs, ys, hI⟩ := hI
    simp only [skel_call.blocksP] at hstep
    cases hstep
    exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (by simp)⟩
  | LBB26_3 =>
    obtain ⟨xs, ys, hI⟩ := hI
    simp only [skel_call.blocksP] at hstep
    cases hstep
    exact ⟨xs, ys, hI.hxs, hI.hys, hI.perm⟩
  | LBB26_10 =>
    obtain ⟨xs, ys, hI⟩ := hI
    simp only [skel_call.blocksP] at hstep
    cases hstep
    exact ⟨xs, ys, hI.go rfl rfl rfl rfl rfl (by simp)⟩

/-- The caller keeps the frame: a run of its blocks from a heap that is a permutation of the own
objects and the frame leaves a heap that still has the frame. -/
theorem outer_frame (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (a : skel_call.In2p) (q : UInt64 × Heap) (hpre : callPre frame b M a)
    (hq : skel_call.l2p.returns a q) : OuterRes a frame b q := by
  obtain ⟨hC, hrdi, hheap, hm0⟩ := hpre
  refine Lift.Sem.CallArm.Blocks.Returns.inv (I := OuterInv a frame b) (Q := OuterRes a frame b)
    (block := outer_block a frame b M hC hrdi hheap hm0) hq rfl

end callFrameAux
theorem call_frame : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre frame b M a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro frame b M a q hpre hq m hm
  obtain ⟨xs, ys, -, -, hperm⟩ := (callFrameAux.outer_frame frame b M a q hpre hq).perm
  have h1 : (callFrameAux.ownHeap b xs ys ++ frame).Holds a.policy m :=
    (Heap.Holds_perm hperm).mpr hm
  exact (Heap.Holds.append_iff.mp h1).2.1
end call_frame.skel_proof
theorem call_frame : call_frame.skel_statement := @call_frame.skel_proof.call_frame
def call_shape.skel_statement : Prop := ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.ShapeB a.heap r.2
namespace call_shape.skel_proof
skel_proof_aliases call_shape.skel_proof excluding [mapShapeB, shapeB_call, call_shape]
/-- The shape row of the callee `mappingBuilderMap` (byte mode): its two stores keep the
coverage, the ownership and the byte permissions of the input heap. -/
theorem mapShapeB : ∀ a r, mappingBuilderMap.l2p.returns a r → Lift.Sem.CallArm.ShapeB a.heap r.2 := by
  intro a r hret
  refine Lift.Sem.CallArm.Blocks.Returns.inv (fun _ x => Lift.Sem.CallArm.ShapeB a.heap x.mem)
    (fun r => Lift.Sem.CallArm.ShapeB a.heap r.2) ?_ hret (Lift.Sem.CallArm.ShapeB.refl _)
  rintro l x n hsh hstep
  cases l with
  | entry =>
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · rename_i v hl0
      split at hstep
      · rename_i v1 hl1
        simp only [Res.ok.injEq] at hstep
        subst hstep
        split <;> exact hsh
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o14 =>
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · rename_i v hl0
      split at hstep
      · rename_i v1 hl1
        simp only [Res.ok.injEq] at hstep
        subst hstep
        split <;> exact hsh
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o25 =>
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · rename_i v hl0
      simp only [Res.ok.injEq] at hstep
      subst hstep
      split <;> exact hsh
    · cases hstep
    · cases hstep
  | o36 =>
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · rename_i m0 hst0
      split at hstep
      · rename_i m1 hst1
        simp only [Res.ok.injEq] at hstep
        subst hstep
        exact Lift.Sem.CallArm.ShapeB.storeB (Lift.Sem.CallArm.ShapeB.storeB hsh hst0) hst1
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | LBB25_4 =>
    simp only [mappingBuilderMap.blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact hsh

/-- The call arm of the shape row: the callee's result up to one permutation of the heap keeps
the shape of the caller's heap. -/
theorem shapeB_call {a : skel_call.In2p} {c : mappingBuilderMap.In2p} {v : UInt64} {H' : Heap}
    (hH : Lift.Sem.CallArm.ShapeB a.heap c.heap)
    (hy : Lift.Sem.CallFrame.PermLift

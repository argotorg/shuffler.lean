    rw [show (dropObj b).addr = 0x5000 from rfl, show (posObj M).addr = 0x8000 from rfl]
    decide)

theorem destObj_ne_posObj (M M' : FlatShuffler.Flat.Mapping) : destObj M ≠ posObj M' :=
  Obj.ne_of_addr (by
    rw [show (destObj M).addr = 0x6000 from rfl, show (posObj M').addr = 0x8000 from rfl]
    decide)

theorem posObj_ne_destObj (M M' : FlatShuffler.Flat.Mapping) : posObj M ≠ destObj M' :=

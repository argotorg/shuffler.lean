theorem hdr_load {h : Heap} {m : DataMem} {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder}
    (hh : h.Holds policy m) (ho : hdrObj b ∈ h) {off : Nat} {w : Width} {v : w.type}
    (hx : (off, (⟨w, v⟩ : Cell)) ∈ offsets 0 (hdrObj b).cells) :
    h.load (BitVec.ofNat 64 off) w = .ok v := by
  have h1 := Heap.load_cell hh ho hx
  rw [hdrObj_addr] at h1
  simpa using h1

theorem hdr_load_16 {h : Heap} {m : DataMem} {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder}
    (hh : h.Holds policy m) (ho : hdrObj b ∈ h) :
    h.load (16 : BitVec 64) .W64 = .ok (0x3000 : BitVec 64) := by
  refine hdr_load hh ho ?_
  have h2 := mem_offsets_index (hdrObj b).cells 0 2 (by simp [hdrObj_cells])
  simpa [hdrObj_cells] using h2

theorem hdr_load_32 {h : Heap} {m : DataMem} {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder}
    (hh : h.Holds policy m) (ho : hdrObj b ∈ h) :
    h.load (32 : BitVec 64) .W64 = .ok (0x5000 : BitVec 64) := by
  refine hdr_load hh ho ?_
  have h2 := mem_offsets_index (hdrObj b).cells 0 4 (by simp [hdrObj_cells])
  simpa [hdrObj_cells] using h2

theorem hdr_load_48 {h : Heap} {m : DataMem} {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder}
    (hh : h.Holds policy m) (ho : hdrObj b ∈ h) :
    h.load (48 : BitVec 64) .W64 = .ok (0x6000 : BitVec 64) := by

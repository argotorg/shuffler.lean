theorem LBB26_1 : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : In2p) y (v_rax : BitVec 64), SimArr frame b M a → a.heap.loadB (a.rdi.toBitVec + 8) .W64 = .ok v_rax → Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.run b M = some y → ∃ r, blocksP.Returns (fun _ => (fun (x : mappingBuilderMap.In2p) (r : UInt64 × Heap) => Lift.Sem.CallFrame.PermLift (fun k k' => mappingBuilderMap.l2p.returns { x with heap := k } (r.1, k')) x.heap r.2)) .LBB26_1 ⟨a, (UInt64.ofBitVec v_rax), a.rdi, 0, 0, 0, a.rdi, 4294967296, 0, ((if (match a.heap.load (a.rdi.toBitVec + 24) .W64 with | .ok v => UInt64.ofBitVec v | _ => 0) ≤ (match a.heap.load (a.rdi.toBitVec + 8) .W64 with | .ok v => UInt64.ofBitVec v | _ => 0) then (match a.heap.load (a.rdi.toBitVec + 24) .W64 with | .ok v => UInt64.ofBitVec v | _ => 0) else (match a.heap.load (a.rdi.toBitVec + 8) .W64 with | .ok v => UInt64.ofBitVec v | _ => 0))), a.heap⟩ r ∧ Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.result b M y) y) = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP b M ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.post b M Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.envOf a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m := by
  intro frame b M a y v_rax hsim hload hrun
  obtain ⟨hC, hrdi, hheap, hholds⟩ := hsim
  obtain ⟨m, hm⟩ := hholds
  have hrun' : Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.run b M =
      some (FlatShuffler.Flat.keepFrom b M 0) := rfl
  have hy : y = FlatShuffler.Flat.keepFrom b M 0 := by
    rw [hrun'] at hrun

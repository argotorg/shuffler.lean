structure In2 where
  policy : CpuPolicy
  mem : DataMem
  sp : BitVec 64
  rax : UInt64
  rbx : UInt64
  rdi : UInt64
  r12 : UInt64
  r14 : UInt64
  r15 : UInt64

inductive Lbl where
  | entry
  | LBB26_1
  | o44
  | o63
  | o78
  | o89
  | o96
  | o110
  | LBB26_5
  | LBB26_2
  | LBB26_3
  | LBB26_10

structure St (I M : Type) where
  input : I
  rax : UInt64
  rbx : UInt64
  rcx : UInt64
  rdx : UInt64
  rsi : UInt64
  rdi : UInt64
  r12 : UInt64
  r14 : UInt64
  r15 : UInt64
  mem : M

def init (a : In2) : St In2 DataMem := ⟨a, a.rax, a.rbx, 0, 0, 0, a.rdi, a.r12, a.r14, a.r15, a.mem⟩

abbrev Private (sp b : BitVec 64) : Prop := (b - (sp - 48)).toNat < 56

abbrev Clear (sp a : BitVec 64) (n : Nat := 8) : Prop := ∀ i, i < n → ¬ Private sp (a + BitVec.ofNat 64 i)

def blocks : Blocks Lbl (St In2 DataMem) (UInt64 × DataMem) Unit (fun _ => mappingBuilderMap.In2) (fun _ => UInt64 × DataMem) where
  step
    | .entry, x =>

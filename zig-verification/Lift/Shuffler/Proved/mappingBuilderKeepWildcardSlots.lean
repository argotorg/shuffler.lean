theorem call_bridge_rev : Refines (fun a b => b = callInput a) (fun _ _ (q : (UInt64 × Heap)) (r : (UInt64 × Heap)) => r = q) skel_call.l2p.returns l2p.returns := by
  intro a b r hab hr
  subst b
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    (fun z x => callState x z) (fun (q : (UInt64 × Heap)) (r : (UInt64 × Heap)) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l z x n hs ht
      have hx := bridge_related_eq x z hs
      subst x
      rw [bridge_step_eq, ht]
      exact bridgeNext_related_rev n)
    hr (by simp [callState, initP, skel_call.initP, callInput])

theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : (UInt64 × Heap)) (q : (UInt64 × Heap)) => r = q) l2p.returns skel_call.l2p.returns := by
  have hblock : ∀ (l : Lbl) (x : St In2p Heap) (z : St skel_call.In2p Heap)
      (n : Lift.Sem.Next Lbl (St In2p Heap) (UInt64 × Heap) Unit (fun _ => mappingBuilderMap.In2p) (fun _ => UInt64 × Heap)),
      callState x z → blocksP.step l x = .ok n →
      Lift.Sem.Next.Sim (fun _ x y => x = y) (fun _ _ _ u v => u = v) callState
        (fun (r : UInt64 × Heap) (q : (UInt64 × Heap)) => r = q) n (skel_call.blocksP.step l z) := by
    intro l x z n hs ht
    rcases hs with ⟨hinput, h_rax, h_rbx, h_rcx, h_rdx, h_rsi, h_rdi, h_r12, h_r14, h_r15, h_mem, htrue⟩
    cases l <;> simp only [blocksP, callInput, hinput, h_rax, h_rbx, h_rcx, h_rdx, h_rsi, h_rdi, h_r12, h_r14, h_r15, h_mem] at ht
    · simp only [skel_call.blocksP, callInput, hinput, h_rax, h_rbx, h_rdi, h_mem] at ht ⊢
      cases h1 : z.mem.loadB (z.rdi.toBitVec + 8) .W64 with
      | ok v =>
        cases h2 : z.mem.loadB (z.rdi.toBitVec + 24) .W64 with
        | ok v1 =>
          simp only [h1, h2, Res.ok.injEq] at ht
          subst n
          simp only [Lift.Sem.Next.Sim]
          exact ⟨_, rfl, by simp [callState, callInput]⟩
        | stuck w => simp only [h1, h2] at ht; cases ht
        | noFuel => simp only [h1, h2] at ht; cases ht
      | stuck w => simp only [h1] at ht; cases ht
      | noFuel => simp only [h1] at ht; cases ht
    all_goals repeat' split at ht
    all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
    all_goals subst n
    all_goals simp_all [skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
    all_goals refine ⟨_, _, ⟨rfl, rfl⟩, rfl, ?_⟩
    all_goals intros; simp_all [callState, callInput]
  intro a b r hab hr
  subst a
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    callState (fun (r : UInt64 × Heap) (q : (UInt64 × Heap)) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    hblock
    hr (by simp [callState, initP, skel_call.initP, callInput])

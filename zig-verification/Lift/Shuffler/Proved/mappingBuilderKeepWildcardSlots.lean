  · rintro policy _ s ⟨hpol, hh, hperm, hC, he, hq0, harea, hbelow, hroom⟩
    exact ⟨⟨policy, objsP b M ++ frame, s.data.regs.rax, s.data.regs.rbx, s.data.regs.rdi, s.data.regs.r12, s.data.regs.r14, s.data.regs.r15, s.data.regs.rsp.toBitVec⟩, ⟨rfl, hh, hperm, he, rfl, rfl, rfl, rfl, rfl, rfl, harea, hbelow, hroom, rfl⟩, ⟨hC, hq0, rfl, ⟨_, hh⟩⟩⟩
  · rintro policy _ a s y r t ⟨hp, -⟩ ⟨hbp, -⟩ ⟨hv, hain, hm⟩ ⟨hex, hrax, hh, hfr⟩
    rw [hain] at hfr
    exact ⟨hex, by rw [hrax]; exact hv, by rw [hrax, ← hp, ← hbp]; exact hm _ hh, hfr⟩

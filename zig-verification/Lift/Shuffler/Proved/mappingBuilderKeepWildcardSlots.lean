theorem Vector.toList_setIfInBounds {α : Type} {n : Nat} (v : Vector α n) (i : Nat) (x : α) :
    (v.setIfInBounds i x).toList = v.toList.set i x := by
  simp [Vector.setIfInBounds, Array.toList_setIfInBounds, Vector.toList]

theorem bind_dest_toList (M : FlatShuffler.Flat.Mapping) (p t : BitVec 64) :
    (FlatShuffler.Flat.Mapping.bind M p t).dest.toList = M.dest.toList.set p.toNat t :=
  Vector.toList_setIfInBounds M.dest p.toNat t

theorem bind_pos_toList (M : FlatShuffler.Flat.Mapping) (p t : BitVec 64) :
    (FlatShuffler.Flat.Mapping.bind M p t).pos.toList = M.pos.toList.set t.toNat p :=
  Vector.toList_setIfInBounds M.pos t.toNat p

theorem Heap.Replaces.length {O O' : Obj} {t t' : Heap} (h : Heap.Replaces O O' t t') :
    List.length t = List.length t' := by
  induction h with
  | nil => rfl
  | here _ ih => simp [ih]
  | there _ _ ih => simp [ih]

theorem store_dest {policy : CpuPolicy} {h : Heap} {m : DataMem} {b : FlatShuffler.Flat.Builder}
    {M : FlatShuffler.Flat.Mapping} {p t : BitVec 64}
    (hh : h.Holds policy m) (hdr : hdrObj b ∈ h) (htgt : tgtObj b ∈ h) (hdrop : dropObj b ∈ h)
    (hdest : destObj M ∈ h) (hpos : posObj M ∈ h) (hp : p.toNat < FlatShuffler.maxStackSize) :
    ∃ h', h.store (0x6000 + 8 * p) .W64 t = .ok h' ∧
      hdrObj b ∈ h' ∧ tgtObj b ∈ h' ∧ dropObj b ∈ h' ∧
      destObj (FlatShuffler.Flat.Mapping.bind M p t) ∈ h' ∧ posObj M ∈ h' ∧
      (∃ m', h'.Holds policy m') ∧ List.length h' = List.length h := by
  obtain ⟨h', hs, hr⟩ := Heap.store_words64 (policy := policy) (h := h) (m := m)
    (base := 0x6000) (xs := M.dest.toList) (i := p) hh hdest (by simpa using hp) t
  have hr' : Heap.Replaces (destObj M) (destObj (FlatShuffler.Flat.Mapping.bind M p t)) h h' := by
    have e : Obj.words (0x6000 : BitVec 64) true .W64 (M.dest.toList.set p.toNat t)
        = destObj (FlatShuffler.Flat.Mapping.bind M p t) := by
      simp only [destObj, bind_dest_toList]
    rw [← e]; exact hr
  obtain ⟨m', -, hh', -⟩ := Heap.store_frame hh hs
  exact ⟨h', hs, Heap.Replaces.mem_of_ne hr' hdr (hdrObj_ne_destObj b M),
    Heap.Replaces.mem_of_ne hr' htgt (tgtObj_ne_destObj b M),
    Heap.Replaces.mem_of_ne hr' hdrop (dropObj_ne_destObj b M),
    Heap.Replaces.mem_new hr' hdest,
    Heap.Replaces.mem_of_ne hr' hpos (posObj_ne_destObj M M), ⟨m', hh'⟩,
    (Heap.Replaces.length hr').symm⟩

theorem store_pos {policy : CpuPolicy} {h : Heap} {m : DataMem} {b : FlatShuffler.Flat.Builder}
    {M0 M1 : FlatShuffler.Flat.Mapping} {p t : BitVec 64}
    (hh : h.Holds policy m) (hdr : hdrObj b ∈ h) (htgt : tgtObj b ∈ h) (hdrop : dropObj b ∈ h)
    (hdest : destObj M1 ∈ h) (hpos : posObj M0 ∈ h) (ht : t.toNat < FlatShuffler.maxStackSize) :
    ∃ h', h.store (0x8000 + 8 * t) .W64 p = .ok h' ∧
      hdrObj b ∈ h' ∧ tgtObj b ∈ h' ∧ dropObj b ∈ h' ∧
      destObj M1 ∈ h' ∧ posObj (FlatShuffler.Flat.Mapping.bind M0 p t) ∈ h' ∧
      (∃ m', h'.Holds policy m') ∧ List.length h' = List.length h := by
  obtain ⟨h', hs, hr⟩ := Heap.store_words64 (policy := policy) (h := h) (m := m)
    (base := 0x8000) (xs := M0.pos.toList) (i := t) hh hpos (by simpa using ht) p
  have hr' : Heap.Replaces (posObj M0) (posObj (FlatShuffler.Flat.Mapping.bind M0 p t)) h h' := by
    have e : Obj.words (0x8000 : BitVec 64) true .W64 (M0.pos.toList.set t.toNat p)
        = posObj (FlatShuffler.Flat.Mapping.bind M0 p t) := by
      simp only [posObj, bind_pos_toList]
    rw [← e]; exact hr
  obtain ⟨m', -, hh', -⟩ := Heap.store_frame hh hs
  exact ⟨h', hs, Heap.Replaces.mem_of_ne hr' hdr (hdrObj_ne_posObj b M0),
    Heap.Replaces.mem_of_ne hr' htgt (tgtObj_ne_posObj b M0),
    Heap.Replaces.mem_of_ne hr' hdrop (dropObj_ne_posObj b M0),
    Heap.Replaces.mem_of_ne hr' hdest (destObj_ne_posObj M1 M0),
    Heap.Replaces.mem_new hr' hpos, ⟨m', hh'⟩, (Heap.Replaces.length hr').symm⟩

def Inv (a : In2p) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (j : Nat)
    (x : St In2p Heap) : Prop :=
  x.input = a ∧ x.rbx = a.rdi ∧ x.r12 = 4294967296 ∧
  x.r14 = UInt64.ofNat j ∧ x.r15 = UInt64.ofNat (FlatShuffler.Flat.commonSize b).toNat ∧
  hdrObj b ∈ x.mem ∧ tgtObj b ∈ x.mem ∧ dropObj b ∈ x.mem ∧
  destObj M ∈ x.mem ∧ posObj M ∈ x.mem ∧ (∃ m, x.mem.Holds a.policy m)

def callee : Unit → mappingBuilderMap.In2p → UInt64 × Heap → Prop :=
  fun _ x r => Lift.Sem.CallFrame.PermLift
    (fun k k' => mappingBuilderMap.l2p.returns { x with heap := k } (r.1, k')) x.heap r.2

def stepM (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j : FlatShuffler.Word) : FlatShuffler.Flat.Mapping :=
  if (FlatShuffler.Flat.isWildcardTarget b j && !FlatShuffler.Flat.hasSourceAssigned M j &&
      FlatShuffler.Flat.mappable b M j) = true
  then FlatShuffler.Flat.Mapping.bind M j j else M

theorem mbMap_done {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping}
    {p : FlatShuffler.Word}
    (h : (FlatShuffler.Flat.isWildcardTarget b p && !FlatShuffler.Flat.hasSourceAssigned M p &&
      FlatShuffler.Flat.mappable b M p) = true) :
    FlatShuffler.Flat.mbMap b M p p = (.done, FlatShuffler.Flat.Mapping.bind M p p) := by
  have hmp : FlatShuffler.Flat.mappable b M p = true := by
    cases hm : FlatShuffler.Flat.mappable b M p with
    | false => rw [hm] at h; simp at h
    | true => rfl
  have hns : FlatShuffler.Flat.hasSourceAssigned M p = false := by
    cases hm : FlatShuffler.Flat.hasSourceAssigned M p with
    | true => rw [hm] at h; simp at h
    | false => rfl
  have hd : FlatShuffler.Flat.get M.dest p = FlatShuffler.Flat.NONE := by
    have h1 := hmp; simp only [FlatShuffler.Flat.mappable, Bool.and_eq_true] at h1
    simpa using h1.2
  have hp : FlatShuffler.Flat.get M.pos p = FlatShuffler.Flat.NONE := by
    have h1 := hns; simp only [FlatShuffler.Flat.hasSourceAssigned] at h1
    simpa using h1
  unfold FlatShuffler.Flat.mbMap
  rw [if_neg (by simp [hmp]), if_neg (by simp [hd]), if_neg (by simp [hp])]

theorem keepFrom_ge {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping}
    {j : FlatShuffler.Word} (hj : (FlatShuffler.Flat.commonSize b).toNat ≤ j.toNat) :
    FlatShuffler.Flat.keepFrom b M j = (.done, M) := by
  rw [FlatShuffler.Flat.keepFrom.eq_def]
  rw [dif_neg (by simp [BitVec.lt_def]; omega)]

theorem keepFrom_step {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping}
    {j : FlatShuffler.Word} (hj : j.toNat < (FlatShuffler.Flat.commonSize b).toNat) :
    FlatShuffler.Flat.keepFrom b M j = FlatShuffler.Flat.keepFrom b (stepM b M j) (j + 1) := by
  rw [FlatShuffler.Flat.keepFrom.eq_def]
  rw [dif_pos (by simp [BitVec.lt_def]; omega)]
  by_cases h : (FlatShuffler.Flat.isWildcardTarget b j && !FlatShuffler.Flat.hasSourceAssigned M j &&
      FlatShuffler.Flat.mappable b M j) = true
  · rw [if_pos h, mbMap_done h, stepM, if_pos h]
    simp
  · rw [if_neg h, stepM, if_neg h]

theorem eq_of_toNat_eq8 {a c : BitVec 8} (h : a.toNat = c.toNat) : a = c :=
  BitVec.eq_of_toNat_eq h

theorem isWildcardTarget_iff {b : FlatShuffler.Flat.Builder} {j : FlatShuffler.Word}
    {v : BitVec 8} (hv : v.toNat = (FlatShuffler.Flat.get b.target j).kind.toNat) :
    ((UInt64.ofBitVec (BitVec.zeroExtend 64 v) <<< (32 : UInt64) = 4294967296) ↔
      FlatShuffler.Flat.isWildcardTarget b j = true) := by
  have hk : v = (FlatShuffler.Flat.get b.target j).kind := eq_of_toNat_eq8 hv
  subst hk
  have key : ∀ k : BitVec 8,
      ((UInt64.ofBitVec (BitVec.zeroExtend 64 k) <<< (32 : UInt64) = 4294967296) ↔
        (k == (1 : BitVec 8)) = true) := by
    intro k
    bv_decide
  rw [show FlatShuffler.Flat.isWildcardTarget b j
      = ((FlatShuffler.Flat.get b.target j).kind == (1 : BitVec 8)) from rfl]
  exact key _

theorem get_dropped_eq (b : FlatShuffler.Flat.Builder) (J : FlatShuffler.Word)
    (hJ : J.toNat < FlatShuffler.maxStackSize) :
    FlatShuffler.Flat.get b.dropped J = b.dropped.toList[J.toNat]'(by simpa using hJ) :=
  get_eq_toList b.dropped J hJ

theorem get_dest_eq (M : FlatShuffler.Flat.Mapping) (J : FlatShuffler.Word)
    (hJ : J.toNat < FlatShuffler.maxStackSize) :
    FlatShuffler.Flat.get M.dest J = M.dest.toList[J.toNat]'(by simpa using hJ) :=
  get_eq_toList M.dest J hJ

theorem get_pos_eq (M : FlatShuffler.Flat.Mapping) (J : FlatShuffler.Word)
    (hJ : J.toNat < FlatShuffler.maxStackSize) :
    FlatShuffler.Flat.get M.pos J = M.pos.toList[J.toNat]'(by simpa using hJ) :=
  get_eq_toList M.pos J hJ

theorem NONE_eq : FlatShuffler.Flat.NONE = (18446744073709551615 : BitVec 64) := by decide

theorem mappable_iff {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping}
    {J : FlatShuffler.Word} (hJ : J.toNat < FlatShuffler.maxStackSize) :
    (FlatShuffler.Flat.mappable b M J = true ↔
      (b.dropped.toList[J.toNat]'(by simpa using hJ) = 0 ∧
        M.dest.toList[J.toNat]'(by simpa using hJ) = 18446744073709551615)) := by
  unfold FlatShuffler.Flat.mappable
  rw [get_dropped_eq b J hJ, get_dest_eq M J hJ, NONE_eq]
  constructor
  · intro h
    have := h
    simp only [Bool.and_eq_true] at this
    exact ⟨by simpa using this.1, by simpa using this.2⟩
  · rintro ⟨h1, h2⟩
    rw [h1, h2]
    rfl

theorem hasSource_iff {M : FlatShuffler.Flat.Mapping} {J : FlatShuffler.Word}
    (hJ : J.toNat < FlatShuffler.maxStackSize) :
    (FlatShuffler.Flat.hasSourceAssigned M J = false ↔
      M.pos.toList[J.toNat]'(by simpa using hJ) = 18446744073709551615) := by
  unfold FlatShuffler.Flat.hasSourceAssigned
  rw [get_pos_eq M J hJ, NONE_eq]
  constructor
  · intro h
    have := h
    simpa using this
  · intro h
    rw [h]
    rfl

def cIn (policy : CpuPolicy) (h : Heap) (p t sp : BitVec 64) : mappingBuilderMap.In2p :=
  ⟨policy, h, UInt64.ofBitVec 0x6000, UInt64.ofBitVec t, UInt64.ofBitVec p, 0, sp⟩

theorem from5 {b : FlatShuffler.Flat.Builder} {a : In2p} {j : Nat} {y : St In2p Heap}
    {M M' : FlatShuffler.Flat.Mapping}
    (hkeep : (FlatShuffler.Flat.keepFrom b M j) = FlatShuffler.Flat.keepFrom b M' (j + 1))
    (hrec : ∃ h, blocksP.Returns callee .LBB26_1 { y with r14 := y.r14 + 1 } (0, h) ∧
        destObj (FlatShuffler.Flat.keepFrom b M' (j + 1)).2 ∈ h ∧
        posObj (FlatShuffler.Flat.keepFrom b M' (j + 1)).2 ∈ h) :
    ∃ h, blocksP.Returns callee .LBB26_5 y (0, h) ∧
        destObj (FlatShuffler.Flat.keepFrom b M j).2 ∈ h ∧
        posObj (FlatShuffler.Flat.keepFrom b M j).2 ∈ h := by
  obtain ⟨h, hR, hd, hp⟩ := hrec
  have s5 : blocksP.step .LBB26_5 y = .ok (.goto .LBB26_1 { y with r14 := y.r14 + 1 }) := by
    simp only [blocksP]
  refine ⟨h, Blocks.Returns.goto s5 hR, ?_, ?_⟩
  · rw [hkeep]; exact hd
  · rw [hkeep]; exact hp

def cS0 (policy : CpuPolicy) (h : Heap) (p t sp : BitVec 64) :
    mappingBuilderMap.St mappingBuilderMap.In2p Heap :=
  ⟨cIn policy h p t sp, UInt64.ofBitVec 0x6000, 0, h⟩

def cS1 (policy : CpuPolicy) (h : Heap) (p t sp : BitVec 64) :
    mappingBuilderMap.St mappingBuilderMap.In2p Heap :=
  { cS0 policy h p t sp with
      rax := (UInt64.ofBitVec 0x6000 &&& 18446744073709486080) ||| (1 &&& 65535),
      rcx := UInt64.ofBitVec (0x5000 : BitVec 64) }

def cS2 (policy : CpuPolicy) (h : Heap) (p t sp : BitVec 64) :
    mappingBuilderMap.St mappingBuilderMap.In2p Heap :=
  { cS1 policy h p t sp with rcx := UInt64.ofBitVec (0x6000 : BitVec 64) }

def cS3 (policy : CpuPolicy) (h h2 : Heap) (p t sp : BitVec 64) :
    mappingBuilderMap.St mappingBuilderMap.In2p Heap :=
  { cS2 policy h p t sp with rax := 0, mem := h2 }

theorem mbMap_returns {policy : CpuPolicy} {h : Heap} {m : DataMem} {b : FlatShuffler.Flat.Builder}
    {M : FlatShuffler.Flat.Mapping} {p t sp : BitVec 64}
    (hh : h.Holds policy m) (hdr : hdrObj b ∈ h) (htgt : tgtObj b ∈ h) (hdrop : dropObj b ∈ h)
    (hdest : destObj M ∈ h) (hpos : posObj M ∈ h)
    (hp : p.toNat < FlatShuffler.maxStackSize) (ht : t.toNat < FlatShuffler.maxStackSize)
    (hdrop0 : b.dropped.toList[p.toNat]'(by simpa using hp) = 0)
    (hdestN : M.dest.toList[p.toNat]'(by simpa using hp) = 18446744073709551615)
    (hposN : M.pos.toList[t.toNat]'(by simpa using ht) = 18446744073709551615) :
    ∃ h', mappingBuilderMap.l2p.returns (cIn policy h p t sp) (0, h') ∧
      hdrObj b ∈ h' ∧ tgtObj b ∈ h' ∧ dropObj b ∈ h' ∧
      destObj (FlatShuffler.Flat.Mapping.bind M p t) ∈ h' ∧
      posObj (FlatShuffler.Flat.Mapping.bind M p t) ∈ h' ∧
      (∃ m', h'.Holds policy m') ∧ List.length h' = List.length h := by
  obtain ⟨h1, hs1, hdr1, htgt1, hdrop1, hdest1, hpos1, hm1, hlen1⟩ :=
    store_dest hh hdr htgt hdrop hdest hpos hp
  obtain ⟨m1, hm1'⟩ := hm1
  obtain ⟨h2, hs2, hdr2, htgt2, hdrop2, hdest2, hpos2, hm2, hlen2⟩ :=
    store_pos hm1' hdr1 htgt1 hdrop1 hdest1 hpos1 ht
  refine ⟨h2, ?_, hdr2, htgt2, hdrop2, hdest2, hpos2, hm2, hlen2.trans hlen1⟩
  have h32 : h.loadB (32 : BitVec 64) .W64 = .ok (0x5000 : BitVec 64) :=
    Heap.loadB_of_load (hdr_load_32 hh hdr)
  have hd0 : h.loadB ((0x5000 : BitVec 64) + p * 1) .W8
      = .ok (b.dropped.toList[p.toNat]'(by simpa using hp)) := by
    rw [show (0x5000 : BitVec 64) + p * 1 = 0x5000 + p from by bv_omega]
    exact Heap.loadB_of_load (drop_load hh hdrop hp)
  have h48 : h.loadB (48 : BitVec 64) .W64 = .ok (0x6000 : BitVec 64) :=
    Heap.loadB_of_load (hdr_load_48 hh hdr)
  have hdestL : h.loadB ((0x6000 : BitVec 64) + p * 8) .W64
      = .ok (M.dest.toList[p.toNat]'(by simpa using hp)) := by
    rw [show (0x6000 : BitVec 64) + p * 8 = 0x6000 + 8 * p from by bv_omega]
    exact Heap.loadB_of_load (dest_load hh hdest hp)
  have hposL : h.loadB ((0x6000 : BitVec 64) + t * 8 + 8192) .W64
      = .ok (M.pos.toList[t.toNat]'(by simpa using ht)) := by
    rw [show (0x6000 : BitVec 64) + t * 8 + 8192 = 0x8000 + 8 * t from by bv_omega]
    exact Heap.loadB_of_load (pos_load hh hpos ht)
  have hsb1 : h.storeB ((0x6000 : BitVec 64) + p * 8) .W64 t = .ok h1 := by
    rw [show (0x6000 : BitVec 64) + p * 8 = 0x6000 + 8 * p from by bv_omega]
    exact Heap.storeB_of_store hs1
  have hsb2 : h1.storeB ((0x6000 : BitVec 64) + t * 8 + 8192) .W64 p = .ok h2 := by
    rw [show (0x6000 : BitVec 64) + t * 8 + 8192 = 0x8000 + 8 * t from by bv_omega]
    exact Heap.storeB_of_store hs2
  have hc0 : UInt64.ofBitVec (BitVec.zeroExtend 64 (b.dropped.toList[p.toNat]'(by simpa using hp)))
      = 0 := by rw [hdrop0]; rfl
  have hc1 : UInt64.ofBitVec (M.dest.toList[p.toNat]'(by simpa using hp))
      = 18446744073709551615 := by rw [hdestN]; rfl
  have hc2 : UInt64.ofBitVec (M.pos.toList[t.toNat]'(by simpa using ht))
      = 18446744073709551615 := by rw [hposN]; rfl
  have e0 : mappingBuilderMap.blocksP.step .entry (cS0 policy h p t sp)
      = .ok (.goto .o14 (cS1 policy h p t sp)) := by
    simp only [mappingBuilderMap.blocksP, cS0, cS1, cIn, mappingBuilderMap.initP, h32, hd0, hc0,
      UInt64.toBitVec_zero, BitVec.zero_add, ↓reduceIte]
  refine Blocks.Returns.goto e0 ?_
  have e1 : mappingBuilderMap.blocksP.step .o14 (cS1 policy h p t sp)
      = .ok (.goto .o25 (cS2 policy h p t sp)) := by
    simp only [mappingBuilderMap.blocksP, cS1, cS2, cS0, cIn, mappingBuilderMap.initP,
      h48, hdestL, hc1, UInt64.toBitVec_zero, BitVec.zero_add, ↓reduceIte]
  refine Blocks.Returns.goto e1 ?_
  have e2 : mappingBuilderMap.blocksP.step .o25 (cS2 policy h p t sp)
      = .ok (.goto .o36 (cS2 policy h p t sp)) := by
    simp only [mappingBuilderMap.blocksP, cS1, cS2, cS0, cIn, mappingBuilderMap.initP,
      hposL, hc2, UInt64.toBitVec_zero, BitVec.zero_add, ↓reduceIte]
  refine Blocks.Returns.goto e2 ?_
  have e3 : mappingBuilderMap.blocksP.step .o36 (cS2 policy h p t sp)
      = .ok (.goto .LBB25_4 (cS3 policy h h2 p t sp)) := by
    simp only [mappingBuilderMap.blocksP, cS1, cS2, cS3, cS0, cIn, mappingBuilderMap.initP,
      hsb1, hsb2, UInt64.toBitVec_zero, BitVec.zero_add, ↓reduceIte]
  refine Blocks.Returns.goto e3 ?_
  exact Blocks.Returns.ret rfl

theorem tgt_byte_toNat {policy : CpuPolicy} {h : Heap} {m : DataMem} {b : FlatShuffler.Flat.Builder}
    {j : BitVec 64} (hh : h.Holds policy m) (ht : tgtObj b ∈ h)
    (hj : j.toNat < FlatShuffler.maxStackSize) (v1 : BitVec 8)
    (hl : h.loadB (0x3000 + 8 * j + 4) .W8 = .ok v1) :
    v1.toNat = (FlatShuffler.Flat.get b.target j).kind.toNat := by
  have hsub : ((0x3000 : BitVec 64) + 8 * j + 4 - 0x3000).toNat = 8 * j.toNat + 4 := by
    have := hj; simp only [FlatShuffler.maxStackSize] at this; bv_omega
  have hk : (((0x3000 : BitVec 64) + 8 * j + 4) - (tgtObj b).addr).toNat < (tgtObj b).bytes.length := by
    rw [show (tgtObj b).addr = 0x3000 from rfl, hsub, tgtObj_bytes_length]
    have := hj; simp only [FlatShuffler.maxStackSize] at this ⊢; omega
  have h1 := loadB_byte_toNat hh ht hk hl
  rw [show ((0x3000 : BitVec 64) + 8 * j + 4) - (tgtObj b).addr
      = (0x3000 : BitVec 64) + 8 * j + 4 - 0x3000 from rfl, hsub] at h1
  rw [h1, tgt_byte_eq hh ht hj, byte4_toNat, tgtWords_get b j hj, slotWord_kind_toNat]

theorem tgt_loadB {policy : CpuPolicy} {h : Heap} {m : DataMem} {b : FlatShuffler.Flat.Builder}
    {j : BitVec 64} (hh : h.Holds policy m) (ht : tgtObj b ∈ h)
    (hj : j.toNat < FlatShuffler.maxStackSize) :
    ∃ v1 : BitVec 8, h.loadB (0x3000 + 8 * j + 4) .W8 = .ok v1 ∧
      v1.toNat = (FlatShuffler.Flat.get b.target j).kind.toNat := by
  have hsp : (tgtObj b).Spans (0x3000 + 8 * j + 4) .W8 := by
    have hj' := hj
    simp only [FlatShuffler.maxStackSize] at hj'
    have h1 : ((0x3000 : BitVec 64)).toNat = 12288 := by decide
    have h2 : ((0x3000 : BitVec 64) + 8 * j + 4).toNat = 12288 + 8 * j.toNat + 4 := by
      rw [← h1]; bv_omega
    have hsize : (tgtObj b).size = 8192 := by rw [tgtObj_size]; rfl
    have hw8 : Width.W8.bytes = 1 := rfl
    unfold Obj.Spans
    rw [show (tgtObj b).addr = 0x3000 from rfl, h1, h2, hsize, hw8]
    constructor <;> omega
  obtain ⟨v1, hv⟩ := loadB_ok_of_spans ht hsp
  exact ⟨v1, hv, tgt_byte_toNat hh ht hj v1 hv⟩

end loop

namespace loop

theorem ofNat_inj_lt {a c : Nat} (h : UInt64.ofNat a = UInt64.ofNat c)
    (ha : a < 2 ^ 64) (hc : c < 2 ^ 64) : a = c := by
  have h2 : (BitVec.ofNat 64 a) = BitVec.ofNat 64 c := by
    have h3 := congrArg UInt64.toBitVec h
    simpa [UInt64.ofNat] using h3
  have h4 := congrArg BitVec.toNat h2
  simpa [BitVec.toNat_ofNat, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hc] using h4

theorem ofNat_add_one (j : Nat) (hj : j + 1 < 2 ^ 64) :
    UInt64.ofNat j + 1 = UInt64.ofNat (j + 1) := by
  apply UInt64.toBitVec_inj.mp
  simp [UInt64.ofNat]
  bv_omega

theorem cast_succ (j : Nat) (hj : j + 1 < 2 ^ 64) :
    ((↑j : BitVec 64) + 1) = (↑(j + 1) : BitVec 64) := by
  have e1 : ((↑j : BitVec 64) + 1).toNat = j + 1 := by
    rw [BitVec.toNat_add]
    have h2 : ((↑j : BitVec 64)).toNat = j := by
      simp [Nat.mod_eq_of_lt (by omega : j < 2 ^ 64)]
    have h3 : (1 : BitVec 64).toNat = 1 := by simp
    rw [h2, h3]
    exact Nat.mod_eq_of_lt hj
  have e2 : ((↑(j + 1) : BitVec 64)).toNat = j + 1 := by simp [Nat.mod_eq_of_lt hj]
  exact BitVec.eq_of_toNat_eq (e1.trans e2.symm)

theorem ofBitVec_zeroExtend_eq_zero (v : BitVec 8) :
    (UInt64.ofBitVec (BitVec.zeroExtend 64 v) = 0) ↔ v = 0 := by
  constructor
  · intro h
    have h2 : BitVec.zeroExtend 64 v = (0 : BitVec 64) := by
      have h3 := congrArg UInt64.toBitVec h
      simpa using h3
    have h3 := congrArg (fun x : BitVec 64 => BitVec.setWidth 8 x) h2
    simpa using h3
  · intro h; rw [h]; rfl

theorem ofBitVec_eq_top (v : BitVec 64) :
    (UInt64.ofBitVec v = 18446744073709551615) ↔ v = 18446744073709551615 := by
  constructor
  · intro h
    have h3 := congrArg UInt64.toBitVec h
    simpa using h3
  · intro h; rw [h]; rfl

theorem keepFrom_step_bind {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping}
    {j : BitVec 64}
    (hcond : (FlatShuffler.Flat.isWildcardTarget b j && !FlatShuffler.Flat.hasSourceAssigned M j &&
      FlatShuffler.Flat.mappable b M j) = true)
    (hj : j.toNat < (FlatShuffler.Flat.commonSize b).toNat) :
    FlatShuffler.Flat.keepFrom b M j =
      FlatShuffler.Flat.keepFrom b (FlatShuffler.Flat.Mapping.bind M j j) (j + 1) := by
  rw [keepFrom_step hj, stepM, if_pos hcond]

theorem inv_agree {a : In2p} {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping}
    {j : Nat} {x y : St In2p Heap} (hx : Inv a b M j x)
    (hin : y.input = x.input) (hb : y.rbx = x.rbx) (h12 : y.r12 = x.r12)
    (h14 : y.r14 = x.r14) (h15 : y.r15 = x.r15) (hmem : y.mem = x.mem) :
    Inv a b M j y := by
  obtain ⟨i1, i2, i3, i4, i5, m1, m2, m3, m4, m5, m6⟩ := hx
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hin, i1]
  · rw [hb, i2]
  · rw [h12, i3]
  · rw [h14, i4]
  · rw [h15, i5]
  · rw [hmem]; exact m1
  · rw [hmem]; exact m2
  · rw [hmem]; exact m3
  · rw [hmem]; exact m4
  · rw [hmem]; exact m5
  · obtain ⟨mm, hmm⟩ := m6
    exact ⟨mm, by rw [hmem]; exact hmm⟩

theorem mbMap_returns_l2p {policy : CpuPolicy} {h : Heap} {m : DataMem}
    {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping} {p t sp : BitVec 64}
    (hh : h.Holds policy m) (hdr : hdrObj b ∈ h) (htgt : tgtObj b ∈ h) (hdrop : dropObj b ∈ h)
    (hdest : destObj M ∈ h) (hpos : posObj M ∈ h)
    (hp : p.toNat < FlatShuffler.maxStackSize) (ht : t.toNat < FlatShuffler.maxStackSize)
    (hdrop0 : b.dropped.toList[p.toNat]'(by simpa using hp) = 0)
    (hdestN : M.dest.toList[p.toNat]'(by simpa using hp) = 18446744073709551615)
    (hposN : M.pos.toList[t.toNat]'(by simpa using ht) = 18446744073709551615) :
    ∃ h', mappingBuilderMap.l2p.returns (cIn policy h p t sp) (0, h') ∧
      hdrObj b ∈ h' ∧ tgtObj b ∈ h' ∧ dropObj b ∈ h' ∧
      destObj (FlatShuffler.Flat.Mapping.bind M p t) ∈ h' ∧
      posObj (FlatShuffler.Flat.Mapping.bind M p t) ∈ h' ∧
      (∃ m', h'.Holds policy m') ∧ List.length h' = List.length h :=
  mbMap_returns hh hdr htgt hdrop hdest hpos hp ht hdrop0 hdestN hposN

theorem step_finish {b : FlatShuffler.Flat.Builder} {a : In2p} {n j : Nat}
    {M M' : FlatShuffler.Flat.Mapping} {x y : St In2p Heap}
    (hj64 : j + 1 < 2 ^ 64)
    (hdn : (FlatShuffler.Flat.commonSize b).toNat - j = n + 1)
    (hjn : j ≤ (FlatShuffler.Flat.commonSize b).toNat)
    (ih : ∀ (j : Nat) (x : St In2p Heap) (M : FlatShuffler.Flat.Mapping),
      (FlatShuffler.Flat.commonSize b).toNat - j = n →
      j ≤ (FlatShuffler.Flat.commonSize b).toNat →
      Inv a b M j x →
      ∃ h, blocksP.Returns callee .LBB26_1 x (0, h) ∧
        destObj (FlatShuffler.Flat.keepFrom b M ↑j).2 ∈ h ∧
        posObj (FlatShuffler.Flat.keepFrom b M ↑j).2 ∈ h)
    (hy : Inv a b M' j y)
    (hchain : ∀ r, blocksP.Returns callee .LBB26_5 y r → blocksP.Returns callee .LBB26_1 x r)
    (hkeep : FlatShuffler.Flat.keepFrom b M (↑j) = FlatShuffler.Flat.keepFrom b M' (↑(j + 1))) :
    ∃ h, blocksP.Returns callee .LBB26_1 x (0, h) ∧
      destObj (FlatShuffler.Flat.keepFrom b M ↑j).2 ∈ h ∧
      posObj (FlatShuffler.Flat.keepFrom b M ↑j).2 ∈ h := by
  have hinv : Inv a b M' (j + 1) { y with r14 := y.r14 + 1 } := by
    obtain ⟨i1, i2, i3, i4, i5, m1, m2, m3, m4, m5, m6⟩ := hy
    refine ⟨i1, i2, i3, ?_, i5, m1, m2, m3, m4, m5, m6⟩
    show y.r14 + 1 = UInt64.ofNat (j + 1)
    rw [i4, ofNat_add_one j hj64]
  obtain ⟨h, hrec, hd, hp⟩ := ih (j + 1) { y with r14 := y.r14 + 1 } M' (by omega) (by omega) hinv
  have s5 : blocksP.step .LBB26_5 y = .ok (.goto .LBB26_1 { y with r14 := y.r14 + 1 }) := by
    simp only [blocksP]
  refine ⟨h, hchain _ (Blocks.Returns.goto s5 hrec), ?_, ?_⟩
  · rw [hkeep]; exact hd
  · rw [hkeep]; exact hp

theorem loop_returns {b : FlatShuffler.Flat.Builder} {a : In2p}
    (hC : (FlatShuffler.Flat.commonSize b).toNat ≤ FlatShuffler.maxStackSize)
    (hrdi : a.rdi.toBitVec = 0) :
    ∀ (n j : Nat) (x : St In2p Heap) (M : FlatShuffler.Flat.Mapping),
      (FlatShuffler.Flat.commonSize b).toNat - j = n →
      j ≤ (FlatShuffler.Flat.commonSize b).toNat →
      Inv a b M j x →
      ∃ h, blocksP.Returns callee .LBB26_1 x (0, h) ∧
        destObj (FlatShuffler.Flat.keepFrom b M j).2 ∈ h ∧
        posObj (FlatShuffler.Flat.keepFrom b M j).2 ∈ h := by
  intro n
  induction n with
  | zero =>
    intro j x M hd hj hx
    obtain ⟨hinput, hrbx, hr12, hr14, hr15, hhdr, htgt, hdrop, hdest, hpos, hm⟩ := hx

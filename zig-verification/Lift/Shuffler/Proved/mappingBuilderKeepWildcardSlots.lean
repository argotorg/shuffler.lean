def postP (a : In2p) (r : UInt64 × Heap) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ r.2.Holds a.policy t.data.dmem ∧ ∀ b, ¬ a.heap.Owned b → ¬ SysV.Below s.data.regs.rsp.toBitVec 48 b → t.data.dmem.get? b = s.data.dmem.get? b

def l2p : Model In2p (UInt64 × Heap) where
  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ Heap.Permits policy a.heap ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderKeepWildcardSlotsPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rbx = a.rbx ∧ s.data.regs.rdi = a.rdi ∧ s.data.regs.r12 = a.r12 ∧ s.data.regs.r14 = a.r14 ∧ s.data.regs.r15 = a.r15 ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ (∀ b, SysV.Below s.data.regs.rsp.toBitVec 48 b → ¬ Covered a.heap b) ∧ SysV.StackRoom policy s 48 ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocksP.Returns (fun _ => (fun (x : mappingBuilderMap.In2p) (r : UInt64 × Heap) => Lift.Sem.CallFrame.PermLift (fun k k' => mappingBuilderMap.l2p.returns { x with heap := k } (r.1, k')) x.heap r.2)) .entry (initP a) r
  post := postP


def objsP (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) : Heap := (Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.objects b M Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.envOf).map toObj

def SimIn (a : In2p) (b : In2) : Prop := a.policy = b.policy ∧ a.rax = b.rax ∧ a.rbx = b.rbx ∧ a.rdi = b.rdi ∧ a.r12 = b.r12 ∧ a.r14 = b.r14 ∧ a.r15 = b.r15 ∧ a.heap.Holds b.policy b.mem ∧ Heap.Permits b.policy a.heap ∧ (∀ c, Private b.sp c → ¬ Covered a.heap c) ∧ (∀ c, SysV.Below b.sp 48 c → ¬ Covered a.heap c) ∧ SysV.RoomAt b.policy b.mem b.sp 48 ∧ a.sp = b.sp

def SimSt (x : St In2p Heap) (y : St In2 DataMem) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rbx = y.rbx ∧ x.rcx = y.rcx ∧ x.rdx = y.rdx ∧ x.rsi = y.rsi ∧ x.rdi = y.rdi ∧ x.r12 = y.r12 ∧ x.r14 = y.r14 ∧ x.r15 = y.r15 ∧ x.mem.Holds y.input.policy y.mem ∧ (∀ b, ¬ x.input.heap.Owned b → ¬ SysV.Below y.input.sp 48 b → y.mem.get? b = y.input.mem.get? b) ∧ (∀ b, SysV.Below y.input.sp 48 b → ¬ Covered x.mem b) ∧ SysV.RoomAt y.input.policy y.mem y.input.sp 48

def SimOut (x : In2p) (y : In2) (r : UInt64 × Heap) (r' : UInt64 × DataMem) : Prop := r.1 = r'.1 ∧ r.2.Holds x.policy r'.2 ∧ ∀ b, ¬ x.heap.Owned b → ¬ SysV.Below y.sp 48 b → r'.2.get? b = y.mem.get? b

def SimArr (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : In2p) : Prop := (Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.C b M) ∧ a.rdi.toBitVec = 0 ∧ a.heap = objsP  b M ++ frame ∧ ∃ m, a.heap.Holds a.policy m

def l3 (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (pol : CpuPolicy) := show Model Unit _ from
  { rep policy _ s := policy = pol ∧ Heap.Holds policy (objsP  b M ++ frame) s.data.dmem ∧ Heap.Permits policy (objsP  b M ++ frame) ∧ (Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.C b M) ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderKeepWildcardSlotsPC s ∧ s.data.regs.rdi.toBitVec = 0 ∧ (∀ b', Private s.data.regs.rsp.toBitVec b' → ¬ Covered (objsP  b M ++ frame) b') ∧ (∀ b', SysV.Below s.data.regs.rsp.toBitVec 48 b' → ¬ Covered (objsP  b M ++ frame) b') ∧ SysV.StackRoom policy s 48
    returns _ y := Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.run b M = some y
    post _ y s t := SysV.Exit s t ∧ Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.result b M y) y) = [⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩] ∧ Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.post b M Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.envOf pol ⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩ t.data.dmem ∧ ∀ b', ¬ (objsP  b M ++ frame).Owned b' → ¬ SysV.Below s.data.regs.rsp.toBitVec 48 b' → t.data.dmem.get? b' = s.data.dmem.get? b' }


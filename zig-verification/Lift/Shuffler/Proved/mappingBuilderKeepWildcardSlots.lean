  have h2 := mem_offsets_index (hdrObj b).cells 0 9 (by simp [hdrObj_cells])
  simpa [hdrObj_cells] using h2

theorem hdr_load_8 {h : Heap} {m : DataMem} {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder}
    (hh : h.Holds policy m) (ho : hdrObj b ∈ h) :
    h.load (8 : BitVec 64) .W64 = .ok b.sourceSize := by
  refine hdr_load hh ho ?_
  have h2 := mem_offsets_index (hdrObj b).cells 0 1 (by simp [hdrObj_cells])

open FlatShuffler

/-- The words of the target array of the builder. -/
def tgtWords (b : FlatShuffler.Flat.Builder) : List (BitVec 64) :=
  b.target.toList.map (fun s => Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0)

/-- The record object: the sizes and the array pointers (read-only). -/
def hdrObj (b : FlatShuffler.Flat.Builder) : Obj :=
  Lift.Sem.Bridge.toObj ⟨0, [⟨.W64, 0x1000⟩, ⟨.W64, b.sourceSize⟩, ⟨.W64, 0x3000⟩,
    ⟨.W64, b.targetSize⟩, ⟨.W64, 0x5000⟩, ⟨.W8, if b.take then 1 else 0⟩, ⟨.W32, 0⟩,
    ⟨.W16, 0⟩, ⟨.W8, 0⟩, ⟨.W64, 0x6000⟩], false⟩

/-- The target array (read-only). -/
def tgtObj (b : FlatShuffler.Flat.Builder) : Obj := Obj.words 0x3000 false .W64 (tgtWords b)

/-- The dropped buffer (read-only). -/
def dropObj (b : FlatShuffler.Flat.Builder) : Obj := Obj.words 0x5000 false .W8 b.dropped.toList

/-- The destination array (writable). -/
def destObj (M : FlatShuffler.Flat.Mapping) : Obj := Obj.words 0x6000 true .W64 M.dest.toList

/-- The position array (writable). -/
def posObj (M : FlatShuffler.Flat.Mapping) : Obj := Obj.words 0x8000 true .W64 M.pos.toList

theorem hdrObj_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    hdrObj b ∈ objsP b M := by
  simp [objsP, hdrObj, Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.objects,
    List.mem_cons]

theorem tgtObj_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    tgtObj b ∈ objsP b M := by
  simp [objsP, tgtObj, tgtWords, Obj.words, Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell,
    Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.objects, List.mem_cons,
    List.map_map, Function.comp_def]

theorem dropObj_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    dropObj b ∈ objsP b M := by
  simp [objsP, dropObj, Obj.words, Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell,
    Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.objects, List.mem_cons,
    List.map_map, Function.comp_def]

theorem toObj_dest (M : FlatShuffler.Flat.Mapping) :
    Lift.Sem.Bridge.toObj ⟨0x6000, M.dest.toList.map (fun v => ⟨.W64, v⟩), true⟩ = destObj M := by
  simp [destObj, Obj.words, Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, List.map_map,
    Function.comp_def]

theorem toObj_pos (M : FlatShuffler.Flat.Mapping) :
    Lift.Sem.Bridge.toObj ⟨0x8000, M.pos.toList.map (fun v => ⟨.W64, v⟩), true⟩ = posObj M := by
  simp [posObj, Obj.words, Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, List.map_map,
    Function.comp_def]

theorem destObj_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    destObj M ∈ objsP b M := by
  refine List.mem_map.mpr ⟨⟨0x6000, M.dest.toList.map fun v => ⟨.W64, v⟩, true⟩, ?_,
    toObj_dest M⟩
  simp [Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.objects]

theorem posObj_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    posObj M ∈ objsP b M := by
  refine List.mem_map.mpr ⟨⟨0x8000, M.pos.toList.map fun v => ⟨.W64, v⟩, true⟩, ?_,
    toObj_pos M⟩
  simp [Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.objects]

theorem get_eq {α : Type} [Inhabited α] (v : Vector α FlatShuffler.maxStackSize)
    (i : FlatShuffler.Word) (hi : i.toNat < FlatShuffler.maxStackSize) :
    FlatShuffler.Flat.get v i = v[i.toNat] := by
  simp [FlatShuffler.Flat.get, dif_pos hi]

theorem get_eq_toList {α : Type} [Inhabited α] (v : Vector α FlatShuffler.maxStackSize)
    (i : FlatShuffler.Word) (hi : i.toNat < FlatShuffler.maxStackSize) :
    FlatShuffler.Flat.get v i = v.toList[i.toNat]'(by simpa using hi) := by
  rw [get_eq v i hi]
  exact (Vector.getElem_toList ..).symm

theorem commonSize_eq (b : FlatShuffler.Flat.Builder) :
    FlatShuffler.Flat.commonSize b =
      if b.targetSize ≤ b.sourceSize then b.targetSize else b.sourceSize := by
  unfold FlatShuffler.Flat.commonSize
  by_cases h : b.sourceSize < b.targetSize
  · rw [if_pos h, if_neg (by bv_omega)]
  · rw [if_neg h, if_pos (by bv_omega)]

theorem has_destObj {policy : CpuPolicy} {h : Heap} {m : DataMem}
    {M : FlatShuffler.Flat.Mapping} (hh : h.Holds policy m) (ho : destObj M ∈ h) :
    Lift.Trusted.Mem.has policy m ⟨0x6000, M.dest.toList.map (fun v => ⟨.W64, v⟩), true⟩ := by
  rw [Lift.Sem.Bridge.has_iff, toObj_dest]
  refine ⟨hh.noWrap _ ho, fun x hx => hh.read _ ho x hx, fun _ x hx => hh.write _ ho rfl x hx⟩

theorem has_posObj {policy : CpuPolicy} {h : Heap} {m : DataMem}
    {M : FlatShuffler.Flat.Mapping} (hh : h.Holds policy m) (ho : posObj M ∈ h) :
    Lift.Trusted.Mem.has policy m ⟨0x8000, M.pos.toList.map (fun v => ⟨.W64, v⟩), true⟩ := by
  rw [Lift.Sem.Bridge.has_iff, toObj_pos]
  refine ⟨hh.noWrap _ ho, fun x hx => hh.read _ ho x hx, fun _ x hx => hh.write _ ho rfl x hx⟩

/-- The byte at index `i` of a list held at `a` is the low byte of the load at `a + i`. -/
theorem contains_byte {m : DataMem} {a : BitVec 64} {bs : List UInt8} {i : Nat}
    (hc : Mem.Contains m a bs) (hi : i < bs.length) :
    m.loadInt (a + BitVec.ofNat 64 i) 1 = some (bs[i]!.toNat : Int) := by
  rw [Mem.loadInt_one, Mem.Contains.iff.mp hc i hi, getElem!_pos bs i hi]
  rfl

theorem ofInt_byte (b : UInt8) : BitVec.ofInt 8 (Int.ofBytes [b]) = b.toBitVec := by
  simp [Int.ofBytes]

theorem ofInt_nat_byte (b : UInt8) : BitVec.ofInt 8 (b.toNat : Int) = b.toBitVec := by
  simp [Int.ofBytes]

/-- The fourth byte of the bytes of a 64-bit word is the `kind` byte of its slot. -/
theorem kind_byte_of_word (w : BitVec 64) :
    BitVec.ofInt 8 (Int.ofBytes (((Int.toBytes 8 w.toInt).drop 4).take 1)) =
      w.extractLsb' 32 8 := by
  have := Lift.Sem.ByteLemmas.ofInt_slice_toBytes 8 w 4 1 (by omega)
  rwa [Nat.mul_one] at this

theorem drop_take_one {l : List UInt8} {k : Nat} (hk : k < l.length) :
    (l.drop k).take 1 = [l[k]!] := by
  rw [List.drop_eq_getElem_cons hk]
  simp only [List.take_succ_cons, List.take_zero, List.nil_append, List.cons.injEq, and_true]
  exact (getElem!_pos l k hk).symm

theorem loadB_cases {h : Heap} {a : BitVec 64} {w : Width} {v1 : w.type}
    (hl : h.loadB a w = .ok v1) : h.load a w = .ok v1 ∨ ∃ o ∈ h, o.loadBytes a w = some v1 := by
  unfold Heap.loadB at hl
  split at hl
  · rename_i v hv
    left
    rw [hv]
    cases hl
    rfl
  · split at hl
    · rename_i v hv
      cases hl
      obtain ⟨o, ho, hlb⟩ := List.exists_of_findSome?_eq_some hv
      exact Or.inr ⟨o, ho, hlb⟩
    · cases hl

/-- A `loadB` of one byte of an object gives the byte of the object's bytes at that offset. -/
theorem loadB_byte_toNat {policy : CpuPolicy} {h : Heap} {m : DataMem} {o : Obj} {a : BitVec 64}
    {v1 : BitVec 8} (hh : h.Holds policy m) (ho : o ∈ h)
    (hk : (a - o.addr).toNat < o.bytes.length)
    (hl : h.loadB a .W8 = .ok v1) :
    v1.toNat = o.bytes[(a - o.addr).toNat]!.toNat := by
  have hb : Mem.Contains m o.addr o.bytes := hh.contains ho
  have htgt := contains_byte hb hk
  have eadd : o.addr + BitVec.ofNat 64 (a - o.addr).toNat = a := by bv_omega
  rw [eadd] at htgt
  rcases loadB_cases hl with hload | ⟨o', ho', hlb⟩
  · obtain ⟨-, x, hx⟩ := readRam_ok (Heap.load_sound hh hload)
    rw [htgt] at hx
    have hx' : x = (o.bytes[(a - o.addr).toNat]!.toNat : Int) := (Option.some.inj hx).symm
    subst hx'
    have hv : v1 = BitVec.ofInt 8 (o.bytes[(a - o.addr).toNat]!.toNat : Int) := by
      have hr := Heap.load_sound hh hload
      unfold readRam at hr
      split at hr
      · split at hr
        · rename_i val hval
          rw [htgt] at hval
          cases hval
          cases hr
          rfl
        · cases hr
      · cases hr
    rw [hv, ofInt_nat_byte]
    simp
  · obtain ⟨k', ha, hks, hv⟩ := Obj.loadBytes_spec hlb
    rw [hv]
    have hb' : Mem.Contains m o'.addr o'.bytes := hh.contains ho'
    have hk' : k' < o'.bytes.length := by
      have := Obj.bytes_length o'
      have : Width.W8.bytes = 1 := rfl
      omega
    have h1 := contains_byte hb' hk'
    rw [← ha] at h1
    rw [htgt] at h1
    have ebyte : o'.bytes[k']! = o.bytes[(a - o.addr).toNat]! :=
      (UInt8.toNat_inj.mp (by exact_mod_cast (Option.some.inj h1))).symm
    rw [drop_take_one hk', ebyte, ofInt_byte]
    simp

theorem tgtWords_length (b : FlatShuffler.Flat.Builder) :
    (tgtWords b).length = FlatShuffler.maxStackSize := by
  simp [tgtWords]

theorem tgtObj_bytes_length (b : FlatShuffler.Flat.Builder) :
    (tgtObj b).bytes.length = 8 * FlatShuffler.maxStackSize := by
  rw [Obj.bytes_length]
  have h := words_bytes Width.W64 (tgtWords b)
  show ((List.map (Cell.mk Width.W64) (tgtWords b)).map fun c => c.w.bytes).sum = _
  rw [h, tgtWords_length]

/-- The source array (read-only). -/
def srcObj (b : FlatShuffler.Flat.Builder) : Obj :=
  Obj.words 0x1000 false .W64 (b.source.toList.map fun s =>
    Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0)

theorem objsP_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    objsP b M = [hdrObj b, srcObj b, tgtObj b, dropObj b, destObj M, posObj M] := by
  simp [objsP, hdrObj, srcObj, tgtObj, tgtWords, dropObj, destObj, posObj, Obj.words,
    Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell,
    Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.objects, List.map_map,
    Function.comp_def]

theorem hdrObj_cells (b : FlatShuffler.Flat.Builder) :
    (hdrObj b).cells =
      [⟨.W64, 0x1000⟩, ⟨.W64, b.sourceSize⟩, ⟨.W64, 0x3000⟩, ⟨.W64, b.targetSize⟩,
       ⟨.W64, 0x5000⟩, ⟨.W8, if b.take then 1 else 0⟩, ⟨.W32, 0⟩, ⟨.W16, 0⟩, ⟨.W8, 0⟩,
       ⟨.W64, 0x6000⟩] := rfl

theorem hdrObj_addr (b : FlatShuffler.Flat.Builder) : (hdrObj b).addr = 0 := rfl

theorem hdrObj_size (b : FlatShuffler.Flat.Builder) : (hdrObj b).size = 56 := rfl

theorem mem_hdr (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (rest : Heap) :
    hdrObj b ∈ objsP b M ++ rest := by
  rw [objsP_eq]; simp

theorem mem_src (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (rest : Heap) :
    srcObj b ∈ objsP b M ++ rest := by

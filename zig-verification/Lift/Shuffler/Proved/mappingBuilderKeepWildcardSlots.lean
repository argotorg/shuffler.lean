        (if UInt64.ofBitVec b.targetSize ≤ UInt64.ofBitVec b.sourceSize
          then UInt64.ofBitVec b.targetSize else UInt64.ofBitVec b.sourceSize),
        xl.heap⟩) := by
    simp only [blocksP, initP, hL8B, hL24B]
  refine ⟨r, ?_, hres, hheap, hpost⟩
  show blocksP.Returns loop.LBB26_1.skel_proof.loop.callee .entry (initP xl) r

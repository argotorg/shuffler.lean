theorem refines_l3 : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping), Refines (fun (_ : Unit) => SimArr frame b M) (fun _ a y r => Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.result b M y) y) = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP b M ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.post b M Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.envOf a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) (fun _ y => Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.run b M = some y) l2p.returns := by
  intro frame b M xh xl yh hsim hrun
  have hsim' : (Lift.Shuffler.Internal.Proposed.KeepWildcardSlotsStatement.C b M) ∧
      xl.rdi.toBitVec = 0 ∧ xl.heap = objsP b M ++ frame ∧
      ∃ m, xl.heap.Holds xl.policy m := hsim
  obtain ⟨hC, hrdi, hheap, m, hm⟩ := hsim'
  have hmem_hdr : loop.LBB26_1.skel_proof.loop.hdrObj b ∈ xl.heap := by
    rw [hheap]; exact loop.LBB26_1.skel_proof.loop.mem_hdr b M frame
  have hL8 : xl.heap.load (xl.rdi.toBitVec + 8) .W64 = .ok b.sourceSize := by
    have e : xl.rdi.toBitVec + 8 = (8 : BitVec 64) := by rw [hrdi]; decide
    rw [e]; exact loop.LBB26_1.skel_proof.loop.hdr_load_8 hm hmem_hdr
  have hL24 : xl.heap.load (xl.rdi.toBitVec + 24) .W64 = .ok b.targetSize := by
    have e : xl.rdi.toBitVec + 24 = (24 : BitVec 64) := by rw [hrdi]; decide
    rw [e]; exact loop.LBB26_1.skel_proof.loop.hdr_load_24 hm hmem_hdr
  have hL8B : xl.heap.loadB (xl.rdi.toBitVec + 8) .W64 = .ok b.sourceSize :=
    Heap.loadB_of_load hL8
  have hL24B : xl.heap.loadB (xl.rdi.toBitVec + 24) .W64 = .ok b.targetSize :=
    Heap.loadB_of_load hL24

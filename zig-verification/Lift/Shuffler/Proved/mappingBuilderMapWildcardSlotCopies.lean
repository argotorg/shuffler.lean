/-- A successful byte load covers each byte of the word. -/
theorem covered_bytes_of_loadB {policy : CpuPolicy} {h : Heap} {m : DataMem} {a : BitVec 64}
    {w : Width} {v : w.type} (hh : h.Holds policy m) (hl : h.loadB a w = .ok v) :
    ∀ i, i < w.bytes → Covered h (a + BitVec.ofNat 64 i) := by
  have key : ∀ (o : Obj), o ∈ h → o.addr.toNat ≤ a.toNat →
      a.toNat + w.bytes ≤ o.addr.toNat + o.size →
      ∀ i, i < w.bytes → Covered h (a + BitVec.ofNat 64 i) := by
    intro o ho h1 h2 i hi
    refine ⟨o, ho, ?_⟩
    have hw := hh.noWrap o ho
    have hb := width_bytes_pos w
    unfold Obj.Covers
    rw [toNat_add_ofNat a i (by omega)]
    omega
  unfold Heap.loadB at hl
  cases hload : h.load a w with
  | ok v' =>
    rw [hload] at hl
    cases hl
    unfold Heap.load at hload
    cases hf : List.findSome? (fun o => o.get a w) h with
    | none => rw [hf] at hload; cases hload
    | some v'' =>
      rw [hf] at hload
      cases hload
      obtain ⟨o, ho, hg⟩ := List.exists_of_findSome?_eq_some hf
      obtain ⟨x, hx, hax, hxc⟩ := Obj.get_some hg
      obtain ⟨e, b⟩ := Obj.toNat_cell (hh.noWrap o ho) hx
      have h1 : a.toNat = o.addr.toNat + x.1 := by rw [← hax]; exact e
      have h2 : x.1 + w.bytes ≤ o.size := by
        have := b
        rw [hxc] at this
        simpa using this
      exact key o ho (by omega) (by omega)
  | stuck why =>
    rw [hload] at hl
    cases hf : List.findSome? (fun o => o.loadBytes a w) h with
    | none => rw [hf] at hl; cases hl
    | some v' =>
      rw [hf] at hl
      cases hl
      obtain ⟨o, ho, hg⟩ := List.exists_of_findSome?_eq_some hf
      unfold Obj.loadBytes at hg
      split at hg
      · rename_i hsp
        exact key o ho hsp.1 hsp.2
      · cases hg
  | noFuel =>
    rw [hload] at hl
    cases hf : List.findSome? (fun o => o.loadBytes a w) h with
    | none => rw [hf] at hl; cases hl
    | some v' =>
      rw [hf] at hl
      cases hl
      obtain ⟨o, ho, hg⟩ := List.exists_of_findSome?_eq_some hf
      unfold Obj.loadBytes at hg
      split at hg
      · rename_i hsp
        exact key o ho hsp.1 hsp.2
      · cases hg

/-- A push to the room does not change a word whose bytes the heap covers. -/
theorem loadInt_push {h : Heap} {m : DataMem} {sp a b : BitVec 64} {k : Nat}
    {v : BitVec 64} (hcov : ∀ c, SysV.Below sp 96 c → ¬ Covered h c)
    (hb : ∀ i, i < 8 → Covered h (b + BitVec.ofNat 64 i))
    (ha : a = sp - BitVec.ofNat 64 k) (hk8 : 8 ≤ k) (hk96 : k ≤ 96) :
    Mem.loadInt (Mem.storeInt m a 8 v.toInt) b 8 = Mem.loadInt m b 8 := by
  subst ha
  apply Mem.loadInt_congr
  intro j hj
  apply Mem.get?_storeInt_of_ne
  intro i hi e
  exact hcov _ (by unfold SysV.Below; bv_omega) (e ▸ hb j hj)

/-- A permitted read of a mapped word gives some value. -/
theorem readRam_ok_of_mapped {policy : CpuPolicy} {m : DataMem} {a : BitVec 64}
    (hp : policy.permits (.read a .W64) = true) (hm : Mem.loadInt m a 8 ≠ none) :
    ∃ v : BitVec 64, readRam policy m a .W64 = .ok v := by
  obtain ⟨x, hx⟩ := Option.ne_none_iff_exists'.mp hm
  exact ⟨BitVec.ofInt 64 x, by simp [Lift.P2.Total.readRam, hp, Width.bytes, hx]⟩

/-- A read of a word of the room gives some value. -/
theorem room_readRam {policy : CpuPolicy} {m : DataMem} {sp a : BitVec 64} {n k : Nat}
    (h : SysV.RoomAt policy m sp n) (hk8 : 8 ≤ k) (hkn : k ≤ n) (hd : 8 ∣ k)
    (ha : a = sp - BitVec.ofNat 64 k) :
    ∃ v : BitVec 64, readRam policy m a .W64 = .ok v := by
  subst ha
  exact readRam_ok_of_mapped (h k hk8 hkn hd).2.1 (h k hk8 hkn hd).2.2

/-- Four pushes of the room keep each byte outside the room and the room. -/
theorem writeRam_chain_frame {policy : CpuPolicy} {sp : BitVec 64} {m m1 m2 m3 m4 : DataMem}
    {v1 v2 v3 v4 : BitVec 64}
    (h1 : writeRam policy m (sp - 8) .W64 v1 = .ok m1)
    (h2 : writeRam policy m1 (sp - 16) .W64 v2 = .ok m2)
    (h3 : writeRam policy m2 (sp - 24) .W64 v3 = .ok m3)
    (h4 : writeRam policy m3 (sp - 32) .W64 v4 = .ok m4) :
    (∀ b, ¬ SysV.Below sp 32 b → m4.get? b = m.get? b) ∧
    (SysV.RoomAt policy m sp 32 → SysV.RoomAt policy m4 sp 32) := by
  have e1 := SysV.writeRam_ok_eq h1
  have e2 := SysV.writeRam_ok_eq h2
  have e3 := SysV.writeRam_ok_eq h3
  have e4 := SysV.writeRam_ok_eq h4
  refine ⟨?_, ?_⟩
  · intro b hb
    rw [e4, e3, e2, e1]
    rw [Mem.get?_storeInt_of_ne _ _ _ _ _ (fun i hi e => hb (by subst e; unfold SysV.Below; bv_omega))]
    rw [Mem.get?_storeInt_of_ne _ _ _ _ _ (fun i hi e => hb (by subst e; unfold SysV.Below; bv_omega))]
    rw [Mem.get?_storeInt_of_ne _ _ _ _ _ (fun i hi e => hb (by subst e; unfold SysV.Below; bv_omega))]
    rw [Mem.get?_storeInt_of_ne _ _ _ _ _ (fun i hi e => hb (by subst e; unfold SysV.Below; bv_omega))]
  · intro hr
    have st : ∀ (m m' : DataMem) (k : Nat) (v : BitVec 64), 8 ≤ k → k ≤ 32 → 8 ∣ k →
        SysV.RoomAt policy m sp 32 → writeRam policy m (sp - BitVec.ofNat 64 k) .W64 v = .ok m' →
        SysV.RoomAt policy m' sp 32 := by
      intro m m' k v hk8 hkn hd hr' hw
      obtain ⟨m'', hw', hr'', -⟩ :=
        SysV.RoomAt.push (a := sp - BitVec.ofNat 64 k) hr' hk8 hkn hd (by decide) rfl v
      rw [hw] at hw'
      cases hw'
      exact hr''
    exact st _ _ 32 _ (by decide) (by decide) (by decide)
      (st _ _ 24 _ (by decide) (by decide) (by decide)
        (st _ _ 16 _ (by decide) (by decide) (by decide)
          (st _ _ 8 _ (by decide) (by decide) (by decide) hr h1) h2) h3) h4


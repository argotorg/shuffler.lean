/-- `toCell` of the fields of a word array is the list of cells. -/
theorem map_toCell_single64 (l : List (BitVec 64)) :
    List.map toCell (l.flatMap fun a => [({ w := Width.W64, v := a } : Field)]) =
      l.map (fun a => ({ w := Width.W64, v := a } : Cell)) := by
  induction l with
  | nil => rfl
  | cons a t ih => simp [List.flatMap_cons, toCell, ih]

/-- `toCell` of the fields of a byte array is the list of cells. -/
theorem map_toCell_single8 (l : List (BitVec 8)) :
    List.map toCell (l.flatMap fun a => [({ w := Width.W8, v := a } : Field)]) =
      l.map (fun a => ({ w := Width.W8, v := a } : Cell)) := by
  induction l with
  | nil => rfl
  | cons a t ih => simp [List.flatMap_cons, toCell, ih]

/-- The 64-bit array of the statement, as `Obj.words`. -/
theorem toObj_words64 (addr : BitVec 64) (wr : Bool) (v : Vector (BitVec 64) FlatShuffler.maxStackSize) :
    toObj (⟨addr, Encode.encode v, wr⟩ : Object) = Obj.words addr wr .W64 v.toList := by
  simp only [toObj, Obj.words, Encode.encode]
  rw [map_toCell_single64]

/-- The byte array of the statement, as `Obj.words`. -/
theorem toObj_words8 (addr : BitVec 64) (wr : Bool) (v : Vector (BitVec 8) FlatShuffler.maxStackSize) :
    toObj (⟨addr, Encode.encode v, wr⟩ : Object) = Obj.words addr wr .W8 v.toList := by
  simp only [toObj, Obj.words, Encode.encode]
  rw [map_toCell_single8]

/-- A single word field. -/
theorem toObj_word64 (addr : BitVec 64) (wr : Bool) (x : BitVec 64) :
    toObj (⟨addr, [⟨.W64, x⟩], wr⟩ : Object) = Obj.words addr wr .W64 [x] := by
  simp [toObj, toCell, Obj.words]

/-- A single byte field. -/
theorem toObj_word8 (addr : BitVec 64) (wr : Bool) (x : BitVec 8) :
    toObj (⟨addr, [⟨.W8, x⟩], wr⟩ : Object) = Obj.words addr wr .W8 [x] := by

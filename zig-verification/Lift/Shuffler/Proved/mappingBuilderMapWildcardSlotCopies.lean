structure In2p where
  policy : CpuPolicy
  heap : Heap
  rax : UInt64
  rbx : UInt64
  rdi : UInt64
  rbp : UInt64
  r12 : UInt64
  r13 : UInt64
  r14 : UInt64
  r15 : UInt64
  sp : BitVec 64 := 0

def initP (a : In2p) : St In2p Heap := ⟨a, a.rax, a.rbx, 0, 0, 0, a.rdi, a.rbp, a.r12, a.r13, a.r14, a.r15, a.heap⟩

def CalP.In : Cal → Type
  | .c0 => mappingBuilderClosestCopy.In2p
  | .c1 => mappingBuilderMap.In2p

def CalP.Out : Cal → Type
  | .c0 => UInt64
  | .c1 => UInt64 × Heap

def CalP.rel : (c : Cal) → CalP.In c → CalP.Out c → Prop
  | .c0 => (fun (x : mappingBuilderClosestCopy.In2p) (r : UInt64) => mappingBuilderClosestCopy.l2p.returns x r)
  | .c1 => (fun (x : mappingBuilderMap.In2p) (r : UInt64 × Heap) => Lift.Sem.CallFrame.PermLift (fun k k' => mappingBuilderMap.l2p.returns { x with heap := k } (r.1, k')) x.heap r.2)


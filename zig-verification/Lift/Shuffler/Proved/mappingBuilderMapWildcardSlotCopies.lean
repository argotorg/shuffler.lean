    toObj o ∈ objsP b M saw := List.mem_map.mpr ⟨o, ho, rfl⟩

/-- A cell of an object of the heap that the memory holds: the byte load gives the value. -/
theorem loadB_of_mem {pol : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds pol m)
    {o : Obj} (ho : o ∈ h) {off : Nat} {c : Cell} (hc : (off, c) ∈ offsets 0 o.cells) :
    h.loadB (o.addr + BitVec.ofNat 64 off) c.w = .ok c.v := by
  have hl := Heap.load_cell hh ho hc
  simp only [Heap.loadB, hl]


/-- The objects of the statement are the words of the statement. -/
theorem toObj_array64 (addr : BitVec 64) (wr : Bool) (f : Nat → BitVec 64) :
    toObj (⟨addr, (List.range 1024).map fun k => (⟨.W64, f k⟩ : Field), wr⟩ : Object) =
      Obj.words addr wr .W64 ((List.range 1024).map f) := by

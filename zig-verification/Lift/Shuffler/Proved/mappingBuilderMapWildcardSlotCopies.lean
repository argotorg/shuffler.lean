theorem ownHeap_mem_own {b : FlatShuffler.Flat.Builder} {xs ys : List (BitVec 64)} {z : BitVec 8} :
    ∀ O ∈ ownHeap b xs ys z, O = hdr64 0 0x1000 ∨ O = hdr64 8 b.sourceSize ∨
      O = hdr64 16 0x3000 ∨ O = hdr64 24 b.targetSize ∨ O = hdr64 32 0x5000 ∨
      O = hdr8 40 (if b.take then 1 else 0) ∨ O = hdr64 48 0x6000 ∨ O = sawObj z ∨
      O = srcObj b ∨ O = tgtObj b ∨ O = dropObj b ∨ O = destObj xs ∨ O = posObj ys := by
  intro O hO
  simpa [ownHeap] using hO

theorem ownHeap_ne_dest_of {b : FlatShuffler.Flat.Builder} {xs ys : List (BitVec 64)} {z : BitVec 8}
    {O : Obj} (hO : O ∈ ownHeap b xs ys z) (hne : O ≠ destObj xs) :
    O = hdr64 0 0x1000 ∨ O = hdr64 8 b.sourceSize ∨
      O = hdr64 16 0x3000 ∨ O = hdr64 24 b.targetSize ∨ O = hdr64 32 0x5000 ∨
      O = hdr8 40 (if b.take then 1 else 0) ∨ O = hdr64 48 0x6000 ∨ O = sawObj z ∨
      O = srcObj b ∨ O = tgtObj b ∨ O = dropObj b ∨ O = posObj ys := by
  have h := ownHeap_mem_own O hO
  grind

abbrev CCIn := Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.In2p
abbrev CCSt := Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.St CCIn Heap
abbrev CCLbl := Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.Lbl
abbrev CCInit := Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.initP

theorem u64_add_one_toNat (a : UInt64) (h : a.toNat + 1 < 2 ^ 64) : (a + 1).toNat = a.toNat + 1 := by
  have e : (a + 1).toBitVec = a.toBitVec + (1 : BitVec 64) := rfl
  show (a + 1).toBitVec.toNat = _
  rw [e, BitVec.toNat_add]
  simp
  omega

theorem u64_lt_of_le_ne (a b : UInt64) (h1 : a.toNat ≤ b.toNat) (h2 : a ≠ b) : a.toNat < b.toNat := by
  rcases Nat.lt_or_ge a.toNat b.toNat with h | h
  · exact h
  · exfalso
    apply h2
    have h3 : a.toNat = b.toNat := by omega
    have h4 : a.toBitVec = b.toBitVec := BitVec.toNat_inj.mp h3
    cases a; cases b; simp_all

def ccA (x : CCSt) : Prop :=
  x.rcx.toNat ≤ 1024 ∧ x.r9.toNat ≤ x.rcx.toNat ∧ (x.rax = 18446744073709551615 ∨ x.rax.toNat < 1024)

def ccP (x : CCSt) : Prop :=
  x.rcx.toNat ≤ 1024 ∧ x.r9.toNat < x.rcx.toNat ∧ (x.rax = 18446744073709551615 ∨ x.rax.toNat < 1024)

def ccR (x : CCSt) : Prop :=
  x.rcx.toNat ≤ 1024 ∧ x.r9.toNat < x.rcx.toNat ∧ (x.rbx = 18446744073709551615 ∨ x.rbx.toNat < 1024)

def ccInv (k : CCIn) : CCLbl → CCSt → Prop
  | .entry, x => x = CCInit k
  | .LBB29_1, x => ccA x
  | .LBB29_13, x => ccA x
  | .LBB29_4, x => ccR x
  | _, x => ccP x

def ccQ (r : UInt64) : Prop := r = 18446744073709551615 ∨ r.toNat < 1024

theorem closestCopy_bound {policy : CpuPolicy} {m : DataMem}
    {k : Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.In2p} {r : UInt64} {s : BitVec 64}
    (hh : k.heap.Holds policy m)
    (h8 : hdr64 8 s ∈ k.heap) (hs : s.toNat ≤ 1024)
    (hrdi : k.rdi.toBitVec = 0)
    (hr : Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.l2p.returns k r) :
    r = 18446744073709551615 ∨ r.toNat < 1024 := by
  have hstep : ∀ l x n, ccInv k l x →
      Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP.step l x = .ok n →
      Lift.Sem.CallArm.Next.Inv (ccInv k) ccQ Lift.Sem.noCall n := by
    intro l x n hI hst
    cases l with
    | entry =>
      simp only [ccInv] at hI
      subst hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      split at hst
      · rename_i v hload
        cases hst
        have hload' : k.heap.loadB (k.rdi.toBitVec + 8) .W64 = .ok v := hload
        rw [hrdi] at hload'
        have h08 : (0 : BitVec 64) + 8 = 8 := by bv_omega
        rw [h08] at hload'
        have hld : k.heap.loadB 8 .W64 = .ok s := Heap.loadB_of_load (hdr64_load hh h8)
        rw [hld] at hload'
        have hv : v = s := (Res.ok.inj hload').symm
        simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccA]
        refine ⟨?_, ?_, ?_⟩
        · show (UInt64.ofBitVec v).toNat ≤ 1024
          rw [hv]
          exact hs
        · show (0 : UInt64).toNat ≤ (UInt64.ofBitVec v).toNat
          exact Nat.zero_le _
        · trivial
      · cases hst
      · cases hst
    | LBB29_1 =>
      simp only [ccInv] at hI
      obtain ⟨h1, h2, h3⟩ := hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      split at hst
      · rename_i heq
        cases hst
        simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccA]
        exact ⟨h1, h2, h3⟩
      · rename_i hne
        cases hst
        simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccP]
        exact ⟨h1, u64_lt_of_le_ne x.r9 x.rcx h2 (fun h => hne h.symm), h3⟩
    | o51 =>
      simp only [ccInv] at hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccP]; exact hI)
    | o72 =>
      simp only [ccInv] at hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccP]; exact hI)
    | o83 =>
      simp only [ccInv] at hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccP]; exact hI)
    | LBB29_3 =>
      simp only [ccInv] at hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccP]
      exact hI
    | LBB29_4 =>
      simp only [ccInv] at hI
      obtain ⟨h1, h2, h3⟩ := hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccA]
      refine ⟨h1, ?_, h3⟩
      rw [u64_add_one_toNat x.r9 (by omega)]
      omega
    | LBB29_7 =>
      simp only [ccInv] at hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccP]; exact hI)
    | o114 =>
      simp only [ccInv] at hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccP]; exact hI)
    | o141 =>
      simp only [ccInv] at hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccP]
      exact hI
    | LBB29_8 =>
      simp only [ccInv] at hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccP]; exact hI)
    | LBB29_10 =>
      simp only [ccInv] at hI
      obtain ⟨h1, h2, h3⟩ := hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccR, ccP]
                 first
                 | (refine ⟨h1, h2, ?_⟩
                    show x.r9 = 18446744073709551615 ∨ x.r9.toNat < 1024
                    exact Or.inr (by omega))
                 | (refine ⟨h1, h2, ?_⟩
                    show x.rax = 18446744073709551615 ∨ x.rax.toNat < 1024
                    exact h3))
    | o156 =>
      simp only [ccInv] at hI
      obtain ⟨h1, h2, h3⟩ := hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccR, ccP]
                 refine ⟨h1, h2, ?_⟩
                 show x.rax = 18446744073709551615 ∨ x.rax.toNat < 1024
                 exact h3)
    | o191 =>
      simp only [ccInv] at hI
      obtain ⟨h1, h2, h3⟩ := hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccR]
      refine ⟨h1, h2, ?_⟩
      show x.r9 = 18446744073709551615 ∨ x.r9.toNat < 1024
      exact Or.inr (by omega)
    | LBB29_13 =>
      simp only [ccInv] at hI
      obtain ⟨h1, h2, h3⟩ := hI
      simp only [Skel.Gen.Level3.Shuffler.mappingBuilderClosestCopy.skel_semantic.skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, ccInv, ccQ]; exact h3)
  exact Lift.Sem.CallArm.Blocks.Returns.inv (ccInv k) ccQ hstep hr rfl

theorem replaces_eq_map {O O' : Obj} {h h' : Heap} (hr : Heap.Replaces O O' h h') :
    h' = h.map (fun p => if p = O then O' else p) := by
  classical
  induction hr with
  | nil => rfl
  | here _ ih => simp only [List.map_cons, if_pos rfl, ↓reduceIte, ih]
  | there hne _ ih => simp only [List.map_cons, if_neg hne, ih]

theorem map_eq_self_of {α : Type} {f : α → α} {l : List α} (h : ∀ a ∈ l, f a = a) :
    l.map f = l := by
  induction l with
  | nil => rfl
  | cons a t ih =>
    simp only [List.map_cons, h a (List.mem_cons_self ..),
      ih (fun b hb => h b (List.mem_cons_of_mem _ hb))]

theorem HInv.store_dest {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder} {frame hc h : Heap}
    (hinv : HInv policy b frame hc h)
    {ds : List (BitVec 64)} (hO : destObj ds ∈ hc) (hlen : ds.length = 1024)
    {i : BitVec 64} (hi : i.toNat < ds.length) (v : BitVec 64) {h' : Heap}
    (hs : h.storeB (0x6000 + 8 * i) .W64 v = .ok h') :
    ∃ hc', HInv policy b frame hc' h' := by
  classical
  obtain ⟨m, hm⟩ := hinv.holds
  have hh : (hc ++ frame).Holds policy m := (Heap.Holds_perm hinv.eq).mp hm
  have hOh : destObj ds ∈ h := hinv.eq.symm.subset (List.mem_append_left _ hO)
  obtain ⟨h1, hst, hrep⟩ := Heap.store_words64 hm hOh hi v
  have h1eq : h1 = h' := by
    have hb := Heap.storeB_of_store hst
    rw [hs] at hb
    exact (Res.ok.inj hb).symm
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hm hs
  have hsize : 0 < (destObj ds).size := by simp [destObj, size_words64, hlen]
  let f : Obj → Obj := fun p => if p = destObj ds then destObj (ds.set i.toNat v) else p
  have hfix : ∀ p ∈ frame, f p = p := by
    intro p hp
    have hne := frame_ne_of_holds_append hh hO rfl hsize hp
    simp only [f, if_neg hne]
  have hmapf : h1 = h.map f := replaces_eq_map hrep
  have hmapapp : (hc ++ frame).map f = hc.map f ++ frame := by
    rw [List.map_append, map_eq_self_of hfix]
  refine ⟨hc.map f, ?_⟩
  refine ⟨?_, ⟨m', hm'⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← h1eq, hmapf, ← hmapapp]
    exact hinv.eq.map f
  · have hfe : f (hdr64 8 b.sourceSize) = hdr64 8 b.sourceSize :=
      by simp only [f, if_neg (hdr64_ne_destObj 8 b.sourceSize ds)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h8
  · have hfe : f (hdr64 24 b.targetSize) = hdr64 24 b.targetSize :=
      by simp only [f, if_neg (hdr64_ne_destObj 24 b.targetSize ds)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h24
  · have hfe : f (hdr64 16 0x3000) = hdr64 16 0x3000 :=
      by simp only [f, if_neg (hdr64_ne_destObj 16 0x3000 ds)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h16
  · have hfe : f (hdr64 32 0x5000) = hdr64 32 0x5000 :=
      by simp only [f, if_neg (hdr64_ne_destObj 32 0x5000 ds)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h32
  · have hfe : f (hdr64 48 0x6000) = hdr64 48 0x6000 :=
      by simp only [f, if_neg (hdr64_ne_destObj 48 0x6000 ds)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h48
  · have hfe : f (hdr8 40 (if b.take then 1 else 0)) = hdr8 40 (if b.take then 1 else 0) :=
      by simp only [f, if_neg (hdr8_ne_destObj 40 (if b.take then 1 else 0) ds)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.take40
  · obtain ⟨z, hz⟩ := hinv.saw
    refine ⟨z, ?_⟩
    have hfe : f (sawObj z) = sawObj z := by simp only [f, if_neg (sawObj_ne_destObj z ds)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hz
  · refine ⟨ds.set i.toNat v, ?_, by rw [List.length_set]; exact hlen⟩
    have hfe : f (destObj ds) = destObj (ds.set i.toNat v) := by simp [f]
    rw [← hfe]
    exact List.mem_map_of_mem (f := f) hO
  · obtain ⟨ps, hps, hpsl⟩ := hinv.pos
    refine ⟨ps, ?_, hpsl⟩
    have hne : destObj ds ≠ posObj ps := destObj_ne_posObj ds ps
    have hfe : f (posObj ps) = posObj ps := by simp only [f, if_neg (Ne.symm hne)]
    rw [← hfe]
    exact List.mem_map_of_mem (f := f) hps

theorem HInv.store_pos {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder} {frame hc h : Heap}
    (hinv : HInv policy b frame hc h)
    {ps : List (BitVec 64)} (hO : posObj ps ∈ hc) (hlen : ps.length = 1024)
    {i : BitVec 64} (hi : i.toNat < ps.length) (v : BitVec 64) {h' : Heap}
    (hs : h.storeB (0x8000 + 8 * i) .W64 v = .ok h') :
    ∃ hc', HInv policy b frame hc' h' := by
  classical
  obtain ⟨m, hm⟩ := hinv.holds
  have hh : (hc ++ frame).Holds policy m := (Heap.Holds_perm hinv.eq).mp hm
  have hOh : posObj ps ∈ h := hinv.eq.symm.subset (List.mem_append_left _ hO)
  obtain ⟨h1, hst, hrep⟩ := Heap.store_words64 hm hOh hi v
  have h1eq : h1 = h' := by
    have hb := Heap.storeB_of_store hst
    rw [hs] at hb
    exact (Res.ok.inj hb).symm
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hm hs
  have hsize : 0 < (posObj ps).size := by simp [posObj, size_words64, hlen]
  let f : Obj → Obj := fun p => if p = posObj ps then posObj (ps.set i.toNat v) else p
  have hfix : ∀ p ∈ frame, f p = p := by
    intro p hp
    have hne := frame_ne_of_holds_append hh hO rfl hsize hp
    simp only [f, if_neg hne]
  have hmapf : h1 = h.map f := replaces_eq_map hrep
  have hmapapp : (hc ++ frame).map f = hc.map f ++ frame := by
    rw [List.map_append, map_eq_self_of hfix]
  refine ⟨hc.map f, ?_⟩
  refine ⟨?_, ⟨m', hm'⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← h1eq, hmapf, ← hmapapp]
    exact hinv.eq.map f
  · have hfe : f (hdr64 8 b.sourceSize) = hdr64 8 b.sourceSize :=
      by simp only [f, if_neg (hdr64_ne_posObj 8 b.sourceSize ps)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h8
  · have hfe : f (hdr64 24 b.targetSize) = hdr64 24 b.targetSize :=
      by simp only [f, if_neg (hdr64_ne_posObj 24 b.targetSize ps)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h24
  · have hfe : f (hdr64 16 0x3000) = hdr64 16 0x3000 :=
      by simp only [f, if_neg (hdr64_ne_posObj 16 0x3000 ps)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h16
  · have hfe : f (hdr64 32 0x5000) = hdr64 32 0x5000 :=
      by simp only [f, if_neg (hdr64_ne_posObj 32 0x5000 ps)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h32
  · have hfe : f (hdr64 48 0x6000) = hdr64 48 0x6000 :=
      by simp only [f, if_neg (hdr64_ne_posObj 48 0x6000 ps)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h48
  · have hfe : f (hdr8 40 (if b.take then 1 else 0)) = hdr8 40 (if b.take then 1 else 0) :=
      by simp only [f, if_neg (hdr8_ne_posObj 40 (if b.take then 1 else 0) ps)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.take40
  · obtain ⟨z, hz⟩ := hinv.saw
    refine ⟨z, ?_⟩
    have hfe : f (sawObj z) = sawObj z := by simp only [f, if_neg (sawObj_ne_posObj z ps)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hz
  · obtain ⟨ds, hds, hdsl⟩ := hinv.dest
    refine ⟨ds, ?_, hdsl⟩
    have hne : posObj ps ≠ destObj ds := (destObj_ne_posObj ds ps).symm
    have hfe : f (destObj ds) = destObj ds := by simp only [f, if_neg (Ne.symm hne)]
    rw [← hfe]
    exact List.mem_map_of_mem (f := f) hds
  · refine ⟨ps.set i.toNat v, ?_, by rw [List.length_set]; exact hlen⟩
    have hfe : f (posObj ps) = posObj (ps.set i.toNat v) := by simp [f]
    rw [← hfe]
    exact List.mem_map_of_mem (f := f) hO

theorem HInv.init {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping}
    {saw : Bool} {frame : Heap} (hm : ∃ m, (objsP b M saw ++ frame).Holds policy m) :
    HInv policy b frame (objsP b M saw) (objsP b M saw ++ frame) where
  eq := List.Perm.refl _
  holds := hm
  h8 := by rw [objsP_eq]; simp [ownHeap]
  h24 := by rw [objsP_eq]; simp [ownHeap]
  h16 := by rw [objsP_eq]; simp [ownHeap]
  h32 := by rw [objsP_eq]; simp [ownHeap]
  h48 := by rw [objsP_eq]; simp [ownHeap]
  take40 := by rw [objsP_eq]; simp [ownHeap]
  saw := ⟨(if saw then 1 else 0), by rw [objsP_eq]; simp [ownHeap]⟩
  dest := ⟨M.dest.toList, by rw [objsP_eq]; simp [ownHeap], Vector.length_toList⟩
  pos := ⟨M.pos.toList, by rw [objsP_eq]; simp [ownHeap], Vector.length_toList⟩

theorem HInv.store_saw {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder} {frame hc h : Heap}
    (hinv : HInv policy b frame hc h)
    {z : BitVec 8} (hO : sawObj z ∈ hc) (v : BitVec 8) {h' : Heap}
    (hs : h.storeB 56 .W8 v = .ok h') :
    ∃ hc', HInv policy b frame hc' h' := by
  classical
  obtain ⟨m, hm⟩ := hinv.holds
  have hh : (hc ++ frame).Holds policy m := (Heap.Holds_perm hinv.eq).mp hm
  have hOh : sawObj z ∈ h := hinv.eq.symm.subset (List.mem_append_left _ hO)
  have hOw : Obj.words 56 true .W8 [z] = sawObj z := by simp [sawObj, Obj.words]
  obtain ⟨h1, hst, hrep⟩ := Heap.store_words8 (xs := [z]) hm (by rw [hOw]; exact hOh) (i := 0) (by simp) v
  have hst' : h.store 56 .W8 v = .ok h1 := by simpa using hst
  have h1eq : h1 = h' := by
    have hb := Heap.storeB_of_store hst'
    rw [hs] at hb
    exact (Res.ok.inj hb).symm
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hm hs
  have hsize : 0 < (sawObj z).size := sawObj_size z
  let f : Obj → Obj := fun p => if p = sawObj z then sawObj v else p
  have hfix : ∀ p ∈ frame, f p = p := by
    intro p hp
    have hne := frame_ne_of_holds_append hh hO rfl hsize hp
    simp only [f, if_neg hne]
  have hmapf : h1 = h.map f := by
    rw [replaces_eq_map hrep]
    rfl
  have hmapapp : (hc ++ frame).map f = hc.map f ++ frame := by
    rw [List.map_append, map_eq_self_of hfix]
  refine ⟨hc.map f, ?_⟩
  refine ⟨?_, ⟨m', hm'⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← h1eq, hmapf, ← hmapapp]
    exact hinv.eq.map f
  · have hfe : f (hdr64 8 b.sourceSize) = hdr64 8 b.sourceSize :=
      by simp only [f, if_neg (hdr64_ne_sawObj 8 b.sourceSize z)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h8
  · have hfe : f (hdr64 24 b.targetSize) = hdr64 24 b.targetSize :=
      by simp only [f, if_neg (hdr64_ne_sawObj 24 b.targetSize z)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h24
  · have hfe : f (hdr64 16 0x3000) = hdr64 16 0x3000 :=
      by simp only [f, if_neg (hdr64_ne_sawObj 16 0x3000 z)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h16
  · have hfe : f (hdr64 32 0x5000) = hdr64 32 0x5000 :=
      by simp only [f, if_neg (hdr64_ne_sawObj 32 0x5000 z)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h32
  · have hfe : f (hdr64 48 0x6000) = hdr64 48 0x6000 :=
      by simp only [f, if_neg (hdr64_ne_sawObj 48 0x6000 z)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.h48
  · have hfe : f (hdr8 40 (if b.take then 1 else 0)) = hdr8 40 (if b.take then 1 else 0) :=
      by simp only [f, if_neg (hdr8_ne_sawObj 40 (if b.take then 1 else 0) z)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hinv.take40
  · refine ⟨v, ?_⟩
    have hfe : f (sawObj z) = sawObj v := by simp [f]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hO
  · obtain ⟨ds, hds, hdsl⟩ := hinv.dest
    refine ⟨ds, ?_, hdsl⟩
    have hfe : f (destObj ds) = destObj ds := by simp only [f, if_neg (destObj_ne_sawObj ds z)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hds
  · obtain ⟨ps, hps, hpsl⟩ := hinv.pos
    refine ⟨ps, ?_, hpsl⟩
    have hfe : f (posObj ps) = posObj ps := by simp only [f, if_neg (posObj_ne_sawObj ps z)]
    rw [← hfe]; exact List.mem_map_of_mem (f := f) hps

theorem HInv.permOf {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder} {frame hc h h' : Heap}
    (hinv : HInv policy b frame hc h) (hp : h.Perm h') : HInv policy b frame hc h' where
  eq := hp.symm.trans hinv.eq
  holds := by
    obtain ⟨m, hm⟩ := hinv.holds
    exact ⟨m, (Heap.Holds_perm hp).mp hm⟩
  h8 := hinv.h8
  h24 := hinv.h24
  h16 := hinv.h16
  h32 := hinv.h32
  h48 := hinv.h48
  take40 := hinv.take40
  saw := hinv.saw
  dest := hinv.dest
  pos := hinv.pos

theorem h48_load {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder} {frame hc h : Heap} {m : DataMem}
    (hinv : HInv policy b frame hc h) (hh : h.Holds policy m) :
    h.load 48 .W64 = .ok 0x6000 :=
  hdr64_load hh (hinv.eq.symm.subset (List.mem_append_left _ hinv.h48))

abbrev MMIn := mappingBuilderMap.In2p
abbrev MMSt := mappingBuilderMap.St MMIn Heap
abbrev MMLbl := mappingBuilderMap.Lbl
abbrev MMInit := mappingBuilderMap.initP

def mmInv (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap) (k : MMIn) :
    MMLbl → MMSt → Prop
  | .entry, x => x = MMInit k
  | .o25, x => x.input = k ∧ x.rcx.toBitVec = 0x6000 ∧ (∃ hc, HInv policy b frame hc x.mem)
  | .o36, x => x.input = k ∧ x.rcx.toBitVec = 0x6000 ∧ (∃ hc, HInv policy b frame hc x.mem)
  | _, x => x.input = k ∧ (∃ hc, HInv policy b frame hc x.mem)

def mmQ (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap) (r : UInt64 × Heap) : Prop :=
  ∃ hc, HInv policy b frame hc r.2

theorem inner_frame (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (k : mappingBuilderMap.In2p) (r : UInt64 × Heap)
    (hrdi : k.rdi.toBitVec = 0) (hrsi : k.rsi.toNat < 1024) (hrdx : k.rdx.toNat < 1024)
    (hinv : ∃ hc, HInv policy b frame hc k.heap)
    (hr : mappingBuilderMap.l2p.returns k r) :
    ∃ hc', HInv policy b frame hc' r.2 := by
  have hstep : ∀ l x n, mmInv policy b frame k l x →
      mappingBuilderMap.blocksP.step l x = .ok n →
      Lift.Sem.CallArm.Next.Inv (mmInv policy b frame k) (mmQ policy b frame) Lift.Sem.noCall n := by
    intro l x n hI hst
    cases l with
    | entry =>
      simp only [mmInv] at hI
      subst hI
      simp only [mappingBuilderMap.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, mmInv]; exact ⟨rfl, hinv⟩)
    | o14 =>
      simp only [mmInv] at hI
      obtain ⟨hin, hex⟩ := hI
      simp only [mappingBuilderMap.blocksP] at hst
      split at hst
      · rename_i v hload
        split at hst
        · rename_i v1 hload1
          split at hst
          · cases hst
            obtain ⟨hc, hinv1⟩ := hex
            obtain ⟨m, hm⟩ := hinv1.holds
            have hb : x.mem.loadB 48 .W64 = .ok 0x6000 := Heap.loadB_of_load (h48_load hinv1 hm)
            have hl : x.mem.loadB (x.input.rdi.toBitVec + 48) .W64 = .ok 0x6000 := by
              have e : x.input.rdi.toBitVec + 48 = (48 : BitVec 64) := by
                rw [hin, hrdi]; bv_omega
              rw [e]; exact hb
            rw [hl] at hload
            have hv : v = 0x6000 := (Res.ok.inj hload).symm
            simp only [Lift.Sem.CallArm.Next.Inv, mmInv]
            exact ⟨hin, by rw [hv], hc, hinv1⟩
          · cases hst
            simp only [Lift.Sem.CallArm.Next.Inv, mmInv]
            exact ⟨hin, hex⟩
        · cases hst
        · cases hst
      · cases hst
      · cases hst
    | o25 =>
      simp only [mmInv] at hI
      obtain ⟨hin, hrc, hex⟩ := hI
      simp only [mappingBuilderMap.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, mmInv]
                 first
                 | exact ⟨hin, hrc, hex⟩
                 | exact ⟨hin, hex⟩)
    | o36 =>
      simp only [mmInv] at hI
      obtain ⟨hin, hrc, hex⟩ := hI
      obtain ⟨hc, hinv1⟩ := hex
      simp only [mappingBuilderMap.blocksP] at hst
      split at hst
      · rename_i h1 hst1
        split at hst
        · rename_i h2 hst2
          cases hst
          obtain ⟨ds, hds, hdsl⟩ := hinv1.dest
          have hi1 : x.input.rsi.toBitVec.toNat < ds.length := by
            rw [hdsl, hin]; exact hrsi
          have haddr1 : (0x6000 : BitVec 64) + 8 * x.input.rsi.toBitVec = x.rcx.toBitVec + x.input.rsi.toBitVec * 8 := by
            rw [hrc]; bv_omega
          have hs1 : x.mem.storeB (0x6000 + 8 * x.input.rsi.toBitVec) .W64 x.input.rdx.toBitVec = .ok h1 := by
            rw [haddr1]; exact hst1
          obtain ⟨hc1, hinv2⟩ := HInv.store_dest hinv1 hds hdsl hi1 x.input.rdx.toBitVec hs1
          obtain ⟨ps2, hps2, hpsl2⟩ := hinv2.pos
          have hi2 : x.input.rdx.toBitVec.toNat < ps2.length := by
            rw [hpsl2, hin]; exact hrdx
          have haddr2 : (0x8000 : BitVec 64) + 8 * x.input.rdx.toBitVec = x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192 := by
            rw [hrc]; bv_omega
          have hs2 : h1.storeB (0x8000 + 8 * x.input.rdx.toBitVec) .W64 x.input.rsi.toBitVec = .ok h2 := by
            rw [haddr2]; exact hst2
          obtain ⟨hc2, hinv3⟩ := HInv.store_pos hinv2 hps2 hpsl2 hi2 x.input.rsi.toBitVec hs2
          simp only [Lift.Sem.CallArm.Next.Inv, mmInv]
          exact ⟨hin, hc2, hinv3⟩
        · cases hst
        · cases hst
      · cases hst
      · cases hst
    | LBB25_4 =>
      simp only [mmInv] at hI
      obtain ⟨hin, hex⟩ := hI
      simp only [mappingBuilderMap.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv, mmQ]
      exact hex
  exact Lift.Sem.CallArm.Blocks.Returns.inv (mmInv policy b frame k) (mmQ policy b frame) hstep hr rfl

theorem hinv_mem_of_hc {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder} {frame hc h : Heap}
    (hinv : HInv policy b frame hc h) {O : Obj} (hO : O ∈ hc) : O ∈ h :=
  hinv.eq.symm.subset (List.mem_append_left _ hO)

theorem hinv_loadB_hdr {policy : CpuPolicy} {b : FlatShuffler.Flat.Builder} {frame hc h : Heap}
    (hinv : HInv policy b frame hc h) {addr v : BitVec 64} (hO : hdr64 addr v ∈ hc) :
    h.loadB addr .W64 = .ok v := by
  obtain ⟨m, hm⟩ := hinv.holds
  exact Heap.loadB_of_load (hdr64_load hm (hinv_mem_of_hc hinv hO))

def skBase (a : skel_call.In2p) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (x : St skel_call.In2p Heap) : Prop :=
  x.input = a ∧ (∃ hc, HInv a.policy b frame hc x.mem) ∧ x.rbx.toBitVec = 0 ∧ x.r15.toNat ≤ 1024

def skInv (a : skel_call.In2p) (b : FlatShuffler.Flat.Builder) (frame : Heap) :
    Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x = skel_call.initP a
  | .LBB27_1, x => skBase a b frame x ∧ x.r14.toNat ≤ x.r15.toNat
  | .LBB27_2, x => skBase a b frame x ∧ x.r14.toNat ≤ x.r15.toNat
  | .LBB27_3, x => skBase a b frame x
  | .LBB27_5, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat
  | .o39, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat
  | .o54, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat
  | .o73, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat
  | .o86, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat ∧ (x.rax = 18446744073709551615 ∨ x.rax.toNat < 1024)
  | .o92, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat ∧ x.rax.toNat < 1024
  | .o107, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat ∧ x.rax.toNat < 1024
  | .LBB27_9, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat ∧ x.rax.toNat < 1024
  | .o131, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat
  | .LBB27_10, x => skBase a b frame x ∧ x.r14.toNat < x.r15.toNat

def skQ (a : skel_call.In2p) (b : FlatShuffler.Flat.Builder) (frame : Heap) (r : UInt64 × Heap) : Prop :=
  ∃ hc, HInv a.policy b frame hc r.2

theorem outer_inv (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (saw : Bool) (a : skel_call.In2p) (q : UInt64 × Heap)
    (hpre : callPre frame b M saw a) (hq : skel_call.l2p.returns a q) :
    ∃ hc, HInv a.policy b frame hc q.2 := by
  obtain ⟨hC, hrdi0, hheap0, hm00⟩ := hpre
  have hrdi : a.rdi.toBitVec = 0 := hrdi0
  have hheap : a.heap = objsP b M saw ++ frame := hheap0
  have hm0 : ∃ m, (objsP b M saw ++ frame).Holds a.policy m := by
    rw [← hheap]; exact hm00
  have hinit : ∃ hc, HInv a.policy b frame hc a.heap := by
    refine ⟨objsP b M saw, ?_⟩
    rw [hheap]
    exact HInv.init hm0
  obtain ⟨hc0, hinv0⟩ := hinit
  have hstep : ∀ l x n, skInv a b frame l x →
      skel_call.blocksP.step l x = .ok n →
      Lift.Sem.CallArm.Next.Inv (skInv a b frame) (skQ a b frame) skel_call.CalP.rel n := by
    intro l x n hI hst
    cases l with
    | entry =>
      simp only [skInv] at hI
      subst hI
      simp only [skel_call.blocksP] at hst
      split at hst
      · rename_i v hload
        cases hst
        have hld : a.heap.loadB 24 .W64 = .ok b.targetSize := hinv_loadB_hdr hinv0 hinv0.h24
        have hv : v = b.targetSize := by
          have hload' : a.heap.loadB (a.rdi.toBitVec + 24) .W64 = .ok v := hload
          have e : a.rdi.toBitVec + 24 = (24 : BitVec 64) := by rw [hrdi]; bv_omega
          rw [e] at hload'
          rw [hld] at hload'
          exact (Res.ok.inj hload').symm
        simp only [Lift.Sem.CallArm.Next.Inv, skInv, skBase]
        refine ⟨⟨rfl, ⟨hc0, hinv0⟩, hrdi, ?_⟩, ?_⟩
        · rw [hv]; exact hC.2
        · exact Nat.zero_le _
      · cases hst
      · cases hst
    | LBB27_1 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr⟩ := hI
      simp only [skel_call.blocksP] at hst
      split at hst
      · rename_i heq
        cases hst
        simp only [Lift.Sem.CallArm.Next.Inv, skInv]
        exact ⟨hb, hr⟩
      · rename_i hne
        cases hst
        obtain ⟨hin, hex, hrbx, hr15⟩ := hb
        simp only [Lift.Sem.CallArm.Next.Inv, skInv, skBase]
        exact ⟨⟨hin, hex, hrbx, hr15⟩, u64_lt_of_le_ne x.r14 x.r15 hr (fun h => hne h.symm)⟩
    | o39 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr⟩ := hI
      simp only [skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, skInv]; exact ⟨hb, hr⟩)
    | o54 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr⟩ := hI
      simp only [skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, skInv]; exact ⟨hb, hr⟩)
    | LBB27_5 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr⟩ := hI
      obtain ⟨hin, hex, hrbx, hr15⟩ := hb
      simp only [skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv, skInv, skBase]
      refine ⟨⟨hin, hex, hrbx, hr15⟩, ?_⟩
      rw [u64_add_one_toNat x.r14 (by omega)]
      omega
    | LBB27_2 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr⟩ := hI
      simp only [skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv, skInv]
      exact hb
    | LBB27_3 =>
      simp only [skInv] at hI
      obtain ⟨hin, hex, hrbx, hr15⟩ := hI
      simp only [skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv, skQ]
      exact hex
    | LBB27_10 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr⟩ := hI
      simp only [skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv, skInv]
      exact hb
    | o86 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr, hbnd⟩ := hI
      simp only [skel_call.blocksP] at hst
      split at hst
      · rename_i heq
        cases hst
        simp only [Lift.Sem.CallArm.Next.Inv, skInv]
        exact ⟨hb, hr⟩
      · rename_i hne
        cases hst
        simp only [Lift.Sem.CallArm.Next.Inv, skInv, skBase]
        obtain ⟨hin, hex, hrbx, hr15⟩ := hb
        refine ⟨⟨hin, hex, hrbx, hr15⟩, hr, ?_⟩
        rcases hbnd with h | h
        · exact absurd h hne
        · exact h
    | o92 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr, hbnd⟩ := hI
      simp only [skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, skInv]; exact ⟨hb, hr, hbnd⟩)
    | o131 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr⟩ := hI
      simp only [skel_call.blocksP] at hst
      repeat' (first | split at hst | cases hst)
      all_goals (simp only [Lift.Sem.CallArm.Next.Inv, skInv]; exact ⟨hb, hr⟩)
    | o107 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr, hbnd⟩ := hI
      obtain ⟨hin, hex, hrbx, hr15⟩ := hb
      obtain ⟨hc1, hinv1⟩ := hex
      simp only [skel_call.blocksP] at hst
      split at hst
      · rename_i h1 hst1
        have hs : x.mem.storeB 56 .W8 (BitVec.truncate 8 (1 : BitVec 64)) = .ok h1 := by
          have e : x.rbx.toBitVec + 56 = (56 : BitVec 64) := by rw [hrbx]; bv_omega
          rw [e] at hst1
          exact hst1
        obtain ⟨z, hz⟩ := hinv1.saw
        obtain ⟨hc2, hinv2⟩ := HInv.store_saw hinv1 hz (BitVec.truncate 8 (1 : BitVec 64)) hs
        split at hst
        · rename_i v hload
          split at hst
          · rename_i hv1
            cases hst
            simp only [Lift.Sem.CallArm.Next.Inv, skInv, skBase]
            exact ⟨⟨hin, ⟨hc2, hinv2⟩, hrbx, hr15⟩, hr, hbnd⟩
          · cases hst
            simp only [Lift.Sem.CallArm.Next.Inv, skInv, skBase]
            exact ⟨⟨hin, ⟨hc2, hinv2⟩, hrbx, hr15⟩, hr⟩
        · cases hst
        · cases hst
      · cases hst
      · cases hst
    | o73 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr⟩ := hI
      obtain ⟨hin, hex, hrbx, hr15⟩ := hb
      obtain ⟨hc1, hinv1⟩ := hex
      simp only [skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv]
      intro y hy
      simp only [skel_call.CalP.rel] at hy
      have hbound : y = (18446744073709551615 : UInt64) ∨ y.toNat < 1024 := by
        obtain ⟨m, hm⟩ := hinv1.holds
        exact closestCopy_bound (m := m) (s := b.sourceSize) hm
          (hinv_mem_of_hc hinv1 hinv1.h8) hC.1 hrbx hy
      simp only [skInv, skBase]
      exact ⟨⟨hin, ⟨hc1, hinv1⟩, hrbx, hr15⟩, hr, hbound⟩
    | LBB27_9 =>
      simp only [skInv] at hI
      obtain ⟨hb, hr, hbnd⟩ := hI
      obtain ⟨hin, hex, hrbx, hr15⟩ := hb
      obtain ⟨hc1, hinv1⟩ := hex
      simp only [skel_call.blocksP] at hst
      cases hst
      simp only [Lift.Sem.CallArm.Next.Inv]
      intro y hy
      simp only [skel_call.CalP.rel] at hy
      obtain ⟨h, h', hR, hsp⟩ := hy
      rw [hin] at hR
      have hin2 : x.mem.Perm h := hsp.perm_in
      have hout : y.2.Perm h' := hsp.perm_out
      have hrdx : x.r14.toNat < 1024 := by omega
      have hIF := inner_frame a.policy b frame
        { policy := a.policy, heap := h, rax := x.rax, rdx := x.r14, rsi := x.rax, rdi := x.rbx,
          sp := a.sp - 56 - 8 }
        (y.1, h') hrbx hbnd hrdx ⟨hc1, HInv.permOf hinv1 hin2⟩ hR
      obtain ⟨hc2, hinv2⟩ := hIF
      simp only [skInv, skBase]
      exact ⟨⟨hin, ⟨hc2, HInv.permOf hinv2 hout.symm⟩, hrbx, hr15⟩, hr⟩
  exact Lift.Sem.CallArm.Blocks.Returns.inv (skInv a b frame) (skQ a b frame) hstep hq rfl

end callFrameAux
theorem call_frame : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre frame b M saw a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro frame b M saw a q hpre hq m hm
  obtain ⟨hC, hrdi, hheap, hm0⟩ := hpre
  obtain ⟨hc, hinv⟩ := callFrameAux.outer_inv frame b M saw a q ⟨hC, hrdi, hheap, hm0⟩ hq
  have h1 : (hc ++ frame).Holds a.policy m := (Heap.Holds_perm hinv.eq).mp hm
  exact h1.sublist (List.sublist_append_right hc frame)
end call_frame.skel_proof
theorem call_frame : call_frame.skel_statement := @call_frame.skel_proof.call_frame
def call_shape.skel_statement : Prop := ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.ShapeB a.heap r.2
namespace call_shape.skel_proof
skel_proof_aliases call_shape.skel_proof excluding [shapeB_of_permLift, map_shape, call_shape]
/-- The shape of a heap that is a `PermLift` of a callee result: the caller's heap `H` has the
shape of the callee's input heap `K`, the callee result `h'` has the shape of `h`, and `H'` is `h'`
up to a permutation. -/
theorem shapeB_of_permLift {H K H' : Heap} {R : Heap → Heap → Prop}
    (hsh : Lift.Sem.CallArm.ShapeB H K) (hshape : ∀ k k', R k k' → Lift.Sem.CallArm.ShapeB k k')
    (hy : Lift.Sem.CallFrame.PermLift R K H') : Lift.Sem.CallArm.ShapeB H H' := by
  obtain ⟨h, h', hR, hs⟩ := hy
  exact (Lift.Sem.CallArm.ShapeB.perm hsh (List.Perm.refl H) hs.perm_in.symm).trans
    (Lift.Sem.CallArm.ShapeB.perm (hshape h h' hR) (List.Perm.refl h) hs.perm_out)

/-- The shape row of `mappingBuilderMap`: the heap of each result covers, owns and permits the
bytes of the input heap. -/
theorem map_shape : ∀ (a : mappingBuilderMap.In2p) (r : UInt64 × Heap),
    mappingBuilderMap.l2p.returns a r → Lift.Sem.CallArm.ShapeB a.heap r.2 := by
  intro a r h
  refine Lift.Sem.CallArm.Blocks.Returns.inv (fun _ x => Lift.Sem.CallArm.ShapeB a.heap x.mem)
    (fun r => Lift.Sem.CallArm.ShapeB a.heap r.2) ?_ h (Lift.Sem.CallArm.ShapeB.refl _)
  rintro l x n hsh hstep
  cases l with
  | entry =>
    simp only [mappingBuilderMap.blocksP] at hstep
    repeat' split at hstep
    all_goals (try cases hstep)
    all_goals (try exact hsh)
  | o14 =>
    simp only [mappingBuilderMap.blocksP] at hstep
    repeat' split at hstep
    all_goals (try cases hstep)
    all_goals (try exact hsh)
  | o25 =>
    simp only [mappingBuilderMap.blocksP] at hstep
    repeat' split at hstep
    all_goals (try cases hstep)
    all_goals (try exact hsh)
  | o36 =>
    simp only [mappingBuilderMap.blocksP] at hstep
    repeat' split at hstep
    all_goals (try cases hstep)
    all_goals (first
      | exact hsh
      | exact Lift.Sem.CallArm.ShapeB.storeB
          (Lift.Sem.CallArm.ShapeB.storeB hsh (by assumption)) (by assumption))
  | LBB25_4 =>
    simp only [mappingBuilderMap.blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact hsh
theorem call_shape : ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.ShapeB a.heap r.2 := by
  intro a r h
  refine Lift.Sem.CallArm.Blocks.Returns.inv (fun _ x => Lift.Sem.CallArm.ShapeB a.heap x.mem)
    (fun r => Lift.Sem.CallArm.ShapeB a.heap r.2) ?_ h (Lift.Sem.CallArm.ShapeB.refl _)
  rintro l x n hsh hstep

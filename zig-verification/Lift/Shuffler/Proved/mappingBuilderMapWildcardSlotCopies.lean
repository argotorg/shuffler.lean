/-- A single-cell object of the heap that the memory holds: the load gives the value. -/
theorem loadB_single {pol : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds pol m)
    {addr : BitVec 64} {wr : Bool} {w : Width} {v : w.type}
    (ho : Obj.words addr wr w [v] ∈ h) : h.loadB addr w = .ok v := by
  have hc : (0, (⟨w, v⟩ : Cell)) ∈ Lift.Sem.offsets 0 (Obj.words addr wr w [v]).cells := by
    simp [Obj.words, Lift.Sem.offsets]
  have hl := Heap.load_cell hh ho hc
  have hl' : h.load addr w = .ok v := by simpa [Obj.words] using hl
  simp only [Heap.loadB]
  rw [hl']

/-- An array of words in the heap that the memory holds: a word load gives the element. -/
theorem loadB_words {pol : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds pol m)
    {base : BitVec 64} {wr : Bool} {w : Width} {xs : List w.type}
    (ho : Obj.words base wr w xs ∈ h) {k : Nat} (hk : k < xs.length) :
    h.loadB (base + BitVec.ofNat 64 (w.bytes * k)) w = .ok xs[k] := by
  have hk' : k < (Obj.words base wr w xs).cells.length := by simpa [Obj.words] using hk
  have hx := mem_offsets_index (Obj.words base wr w xs).cells 0 k hk'
  rw [Nat.zero_add] at hx
  have e : ((List.map (fun c => c.w.bytes) (List.take k (Obj.words base wr w xs).cells)).sum)
      = w.bytes * k := by simpa [Obj.words] using words_fieldOff w xs k (Nat.le_of_lt hk)
  rw [e] at hx
  have hc : (Obj.words base wr w xs).cells[k] = (⟨w, xs[k]⟩ : Cell) := by simp [Obj.words]
  rw [hc] at hx
  simpa [Obj.words] using loadB_of_mem hh ho hx

/-- The address of the word at index `i` of an array. -/
theorem addr_word (base i : BitVec 64) (hi : i.toNat < FlatShuffler.maxStackSize) :
    base + BitVec.ofNat 64 (8 * i.toNat) = base + 8 * i := by
  have e : BitVec.ofNat 64 (8 * i.toNat) = 8 * i := by
    apply BitVec.eq_of_toNat_eq
    rw [BitVec.toNat_ofNat, BitVec.toNat_mul]
    rfl
  rw [e]

/-- The address of the byte at index `i` of an array. -/
theorem addr_byte (base i : BitVec 64) :
    base + BitVec.ofNat 64 (1 * i.toNat) = base + i := by
  congr 1
  simp


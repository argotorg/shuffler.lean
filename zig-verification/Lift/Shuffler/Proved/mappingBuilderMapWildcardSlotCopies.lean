theorem map_toCell_range64 (b : FlatShuffler.Flat.Builder) :
    List.map (Lift.Sem.Bridge.toCell ∘ fun i => (⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0⟩ : Lift.Trusted.Field)) (List.range 1024)
      = List.map (Cell.mk .W64 ∘ fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0) (List.range 1024) := by

/-- After the push of the return address, the room below `sp - 64` is the room of 32 bytes. -/
theorem roomAt_shift {policy : CpuPolicy} {m m' : DataMem} {sp : BitVec 64} {v : BitVec 64}
    (h : SysV.RoomAt policy m sp 96) (hw : writeRam policy m (sp - 64) .W64 v = .ok m') :
    SysV.RoomAt policy m' (sp - 64) 32 := by
  intro k hk8 hkn hd
  obtain ⟨c, rfl⟩ := hd
  obtain ⟨h1, h2, h3⟩ := h (8 * c + 64) (by omega) (by omega) (⟨c + 8, by omega⟩ : 8 ∣ 8 * c + 64)
  have e : (sp - 64) - BitVec.ofNat 64 (8 * c) = sp - BitVec.ofNat 64 (8 * c + 64) := by bv_omega
  rw [e]
  refine ⟨h1, h2, ?_⟩
  rw [SysV.writeRam_ok_eq hw]
  exact SysV.mapped_storeInt_of_disjoint
    (SysV.slot_disjoint sp (j := 64) (k := 8 * c + 64) (by omega) (by omega)).symm h3


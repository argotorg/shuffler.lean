namespace aux

open Lift.Sem Lift.P2.Total Lift.Trusted Lift.Shuffler.Internal.Proposed

/-- A store that succeeds is the same through `storeB`. -/
theorem storeB_eq_store {h h' : Heap} {a : BitVec 64} {w : Width} {v : w.type}
    (hs : h.store a w v = .ok h') : h.storeB a w v = .ok h' := by
  have hsome : (List.any h fun o => (o.get a w).isSome) = true := by
    unfold Heap.store at hs
    split at hs
    · rename_i hc
      obtain ⟨o, ho, hcc⟩ := List.any_eq_true.mp hc
      rw [Bool.and_eq_true] at hcc
      exact List.any_eq_true.mpr ⟨o, ho, hcc.2⟩
    · split at hs <;> cases hs
  unfold Heap.storeB
  rw [hsome]
  exact hs

end aux

namespace aux

open Lift.Sem Lift.P2.Total Lift.Trusted Lift.Shuffler.Internal.Proposed
open MapWildcardSlotCopiesStatement (objects envOf)

/-- The objects of the statement, as arrays of the heap. -/
theorem objsP_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool) :
    objsP b M saw =
      [ Obj.words 0 false .W64 [4096], Obj.words 8 false .W64 [b.sourceSize],
        Obj.words 16 false .W64 [12288], Obj.words 24 false .W64 [b.targetSize],
        Obj.words 32 false .W64 [20480], Obj.words 40 false .W8 [if b.take then 1 else 0],
        Obj.words 48 false .W64 [24576], Obj.words 56 true .W8 [if saw then 1 else 0],
        Obj.words 4096 false .W64 ((List.range 1024).map fun i =>
          Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0),
        Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
          Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i default) 0),
        Obj.words 20480 false .W8 b.dropped.toList,
        Obj.words 24576 true .W64 M.dest.toList,
        Obj.words 32768 true .W64 M.pos.toList ] := by
  simp only [objsP, objects, envOf, toObj, toCell, Obj.words, Encode.encode, List.map_map,
    Function.comp_def, List.map_cons, List.map_nil]
  rw [map_toCell_single8, map_toCell_single64, map_toCell_single64]

/-- A writable object of the first part is not an object of the second. -/
theorem ne_of_mem_append {policy : CpuPolicy} {m : DataMem} {pre post : Heap}
    (hh : (pre ++ post).Holds policy m) {O : Obj} (hO : O ∈ pre) (hw : O.writable)
    (hpos : 0 < O.size) {p : Obj} (hp : p ∈ post) : p ≠ O := by
  intro e
  have hap : O.Apart p :=
    (List.pairwise_append.mp hh.apart).2.2 O hO p hp (Or.inl hw)
  rw [e] at hap
  unfold Obj.Apart at hap
  omega

/-- The cells of an array of words, read back. -/
theorem mem_offsets_words_inv {w : Width} {xs : List w.type} {n : Nat} {x : Nat × Cell}
    (hx : x ∈ Lift.Sem.offsets n (xs.map (Cell.mk w))) :
    ∃ k, k < xs.length ∧ x.1 = n + w.bytes * k ∧ x.2.w = w := by
  induction xs generalizing n with
  | nil =>
    simp only [List.map_nil] at hx
    have h0 : Lift.Sem.offsets n ([] : List Cell) = [] := rfl
    rw [h0] at hx
    cases hx
  | cons a t ih =>
    rw [List.map_cons, Lift.Sem.offsets, List.mem_cons] at hx
    rcases hx with h | h
    · rw [h]
      exact ⟨0, by simp, by simp, by simp⟩
    · obtain ⟨k, hk, h1, h2⟩ := ih h
      refine ⟨k + 1, by simpa using hk, ?_, h2⟩
      have hbytes : ({ w := w, v := a } : Cell).w.bytes = w.bytes := rfl
      rw [h1, hbytes, Nat.mul_succ]
      omega

/-- A store of another width does not change an array. -/
theorem Obj.set_words_of_width_ne {base a : BitVec 64} {wr : Bool} {w w' : Width}
    {xs : List w.type} {v : w'.type} (hw : w' ≠ w) :
    (Obj.words base wr w xs).set a w' v = Obj.words base wr w xs := by
  cases wr with
  | false => rfl
  | true =>
    simp only [Obj.set, Obj.words, ↓reduceIte]
    rw [setCells_of_no_match]
    intro x hx
    obtain ⟨k, hk, h1, h2⟩ := mem_offsets_words_inv hx
    intro ⟨e, e2⟩
    rw [h2] at e2
    exact hw e2.symm

/-- A store at another address does not change an array of words. -/
theorem Obj.set_words64_of_ne {base a : BitVec 64} {wr : Bool} {xs : List (BitVec 64)}
    {t : BitVec 64} (h : ∀ k, k < xs.length → base + BitVec.ofNat 64 (8 * k) ≠ a) :
    (Obj.words base wr .W64 xs).set a .W64 t = Obj.words base wr .W64 xs := by
  cases wr with
  | false => rfl
  | true =>
    simp only [Obj.set, Obj.words, ↓reduceIte]
    rw [setCells_of_no_match]
    intro x hx
    obtain ⟨k, hk, h1, h2⟩ := mem_offsets_words_inv (w := .W64) hx
    intro ⟨e, _⟩
    rw [h1] at e
    simp only [Nat.zero_add, Width.bytes] at e
    exact h k hk e

/-- A store at another address does not change an array of bytes. -/
theorem Obj.set_words8_of_ne {base a : BitVec 64} {wr : Bool} {xs : List (BitVec 8)}
    {t : BitVec 8} (h : ∀ k, k < xs.length → base + BitVec.ofNat 64 k ≠ a) :
    (Obj.words base wr .W8 xs).set a .W8 t = Obj.words base wr .W8 xs := by
  cases wr with
  | false => rfl
  | true =>
    simp only [Obj.set, Obj.words, ↓reduceIte]
    rw [setCells_of_no_match]
    intro x hx
    obtain ⟨k, hk, h1, h2⟩ := mem_offsets_words_inv (w := .W8) hx
    intro ⟨e, _⟩
    rw [h1] at e
    simp only [Nat.zero_add, Width.bytes, Nat.one_mul] at e
    exact h k hk e

/-- The writable array of the destinations, with the element `p` set to `t`. -/
theorem Obj.set_dest (base : BitVec 64) (xs : List (BitVec 64)) (p : BitVec 64)
    (hp : p.toNat < xs.length) (t : BitVec 64)
    (hn : base.toNat + 8 * xs.length ≤ 2 ^ 64) :
    (Obj.words base true .W64 xs).set (base + 8 * p) .W64 t
      = Obj.words base true .W64 (xs.set p.toNat t) := by
  have hx₀ : (8 * p.toNat, (⟨.W64, xs[p.toNat]⟩ : Cell)) ∈
      Lift.Sem.offsets 0 (Obj.words base true .W64 xs).cells := by
    have := mem_offsets_words .W64 xs 0 p.toNat hp
    simpa [Obj.words, Nat.zero_add] using this
  have eoff : (Obj.words base true .W64 xs).fieldOff p.toNat = 8 * p.toNat := by
    simp only [Obj.fieldOff, Obj.words]
    rw [words_fieldOff .W64 xs p.toNat (Nat.le_of_lt hp), Width.bytes]
  have eaddr : (Obj.words base true .W64 xs).addr + BitVec.ofNat 64 (8 * p.toNat)
      = base + 8 * p := by
    have hb : (Obj.words base true .W64 xs).addr = base := rfl
    rw [hb, show BitVec.ofNat 64 (8 * p.toNat) = 8 * p from by
      apply BitVec.eq_of_toNat_eq
      rw [BitVec.toNat_ofNat, BitVec.toNat_mul]
      rfl]
  have hsize : (Obj.words base true .W64 xs).size = 8 * xs.length := by
    show ((xs.map (Cell.mk .W64)).map fun c => c.w.bytes).sum = 8 * xs.length
    rw [words_bytes, Width.bytes]
  have hn' : base.toNat + (Obj.words base true .W64 xs).size ≤ 2 ^ 64 := by
    rw [hsize]; exact hn
  have h := Obj.set_field (o := Obj.words base true .W64 xs) rfl hn'
    p.toNat (by simpa [Obj.words] using hp) .W64 (by simp [Obj.words]) t
  rw [eoff] at h
  rw [eaddr] at h
  rw [h]
  simp only [Obj.words]
  rw [List.map_set]

/-- The writable array of the destinations, with the element `p` set to `t`. -/
theorem Obj.set_saw (saw : Bool) :
    (Obj.words 56 true .W8 [if saw then 1 else 0]).set 56 .W8 1
      = Obj.words 56 true .W8 [1] := by
  have e : (Obj.words 56 true .W8 [if saw then 1 else 0]).addr
      + BitVec.ofNat 64 ((Obj.words 56 true .W8 [if saw then 1 else 0]).fieldOff 0) = 56 := by
    simp [Obj.words, Obj.fieldOff]
  have h := Obj.set_field (o := Obj.words 56 true .W8 [if saw then 1 else 0]) rfl
    (by simp [Obj.words, Obj.size, words_bytes, Width.bytes])
    0 (by simp [Obj.words]) .W8 (by simp [Obj.words]) (1 : BitVec 8)
  rw [e] at h
  rw [h]
  simp only [Obj.words, List.set_cons_zero, List.map_cons, List.map_nil]

end aux

namespace aux

open Lift.Sem Lift.P2.Total Lift.Trusted Lift.Shuffler.Internal.Proposed
open MapWildcardSlotCopiesStatement (objects envOf)

/-- A store of the byte `saw` at `56`. -/
theorem objsP_store_saw (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (saw : Bool) (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) :
    (objsP b M saw ++ frame).store 56 .W8 (1 : BitVec 8) = .ok (objsP b M true ++ frame) := by
  have hO : Obj.words 56 true .W8 [if saw then 1 else 0] ∈ objsP b M saw := by
    rw [objsP_eq]; simp
  have hx₀ : (0, (⟨.W8, if saw then 1 else 0⟩ : Cell)) ∈
      Lift.Sem.offsets 0 (Obj.words 56 true .W8 [if saw then 1 else 0]).cells := by
    simp [Obj.words, Lift.Sem.offsets]
  have h0 : (Obj.words 56 true .W8 [if saw then 1 else 0]).addr + BitVec.ofNat 64 0 = 56 := by
    simp [Obj.words]
  have hsrc : (Obj.words 4096 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0)).set 56 .W8 1
      = Obj.words 4096 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0) :=
    Obj.set_words_of_width_ne (by decide)
  have htgt : (Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i default) 0)).set 56 .W8 1
      = Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i default) 0) :=
    Obj.set_words_of_width_ne (by decide)
  have hdrop : (Obj.words 20480 false .W8 b.dropped.toList).set 56 .W8 1
      = Obj.words 20480 false .W8 b.dropped.toList :=
    Obj.set_words8_of_ne (fun k hk => by
      rw [Vector.length_toList] at hk
      have hk' : k < 1024 := hk
      bv_omega)
  have hdest : (Obj.words 24576 true .W64 M.dest.toList).set 56 .W8 1
      = Obj.words 24576 true .W64 M.dest.toList :=
    Obj.set_words_of_width_ne (by decide)
  have hpos : (Obj.words 32768 true .W64 M.pos.toList).set 56 .W8 1
      = Obj.words 32768 true .W64 M.pos.toList :=
    Obj.set_words_of_width_ne (by decide)
  have hs : (objsP b M saw).store 56 .W8 (1 : BitVec 8) = .ok (objsP b M true) := by
    have h := Heap.store_cell hO rfl hx₀ (1 : BitVec 8)
    rw [h0] at h
    rw [h]
    rw [objsP_eq, objsP_eq]
    simp only [List.map_cons, List.map_nil, ↓reduceIte]
    rw [hsrc, htgt, hdrop, hdest, hpos, Obj.set_saw]
    rfl
  exact Heap.store_append_frame hh hs

/-- A store of `t` at the destination of `p`. -/
theorem objsP_store_dest (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (saw : Bool) (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (p : BitVec 64)
    (hp : p.toNat < FlatShuffler.maxStackSize) (t : BitVec 64) :
    (objsP b M saw ++ frame).store (24576 + 8 * p) .W64 t
      = .ok (objsP b { M with dest := FlatShuffler.Flat.put M.dest p t } saw ++ frame) := by
  have hplen : p.toNat < M.dest.toList.length := by
    rw [Vector.length_toList]
    exact hp
  have hO : Obj.words 24576 true .W64 M.dest.toList ∈ objsP b M saw := by
    rw [objsP_eq]; simp
  have hx₀ : (8 * p.toNat, (⟨.W64, M.dest.toList[p.toNat]⟩ : Cell)) ∈
      Lift.Sem.offsets 0 (Obj.words 24576 true .W64 M.dest.toList).cells := by
    have h := mem_offsets_words .W64 M.dest.toList 0 p.toNat hplen
    simpa [Obj.words, Nat.zero_add] using h
  have h0 : (Obj.words 24576 true .W64 M.dest.toList).addr + BitVec.ofNat 64 (8 * p.toNat)
      = 24576 + 8 * p := by
    have hb : (Obj.words 24576 true .W64 M.dest.toList).addr = 24576 := rfl
    rw [hb, show BitVec.ofNat 64 (8 * p.toNat) = 8 * p from by
      apply BitVec.eq_of_toNat_eq
      rw [BitVec.toNat_ofNat, BitVec.toNat_mul]; rfl]
  have hsaw : (Obj.words 56 true .W8 [if saw then 1 else 0]).set (24576 + 8 * p) .W64 t
      = Obj.words 56 true .W8 [if saw then 1 else 0] :=
    Obj.set_words_of_width_ne (by decide)
  have hsrc : (Obj.words 4096 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0)).set
        (24576 + 8 * p) .W64 t
      = Obj.words 4096 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0) :=
    Obj.set_words64_of_ne (fun k hk => by
      rw [List.length_map, List.length_range] at hk
      have hp' : p.toNat < 1024 := hp
      bv_omega)
  have htgt : (Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i default) 0)).set
        (24576 + 8 * p) .W64 t
      = Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i default) 0) :=
    Obj.set_words64_of_ne (fun k hk => by
      rw [List.length_map, List.length_range] at hk
      have hp' : p.toNat < 1024 := hp
      bv_omega)
  have hdrop : (Obj.words 20480 false .W8 b.dropped.toList).set (24576 + 8 * p) .W64 t
      = Obj.words 20480 false .W8 b.dropped.toList :=
    Obj.set_words_of_width_ne (by decide)
  have hpos : (Obj.words 32768 true .W64 M.pos.toList).set (24576 + 8 * p) .W64 t
      = Obj.words 32768 true .W64 M.pos.toList :=
    Obj.set_words64_of_ne (fun k hk => by
      rw [Vector.length_toList] at hk
      have hk' : k < 1024 := hk
      have hp' : p.toNat < 1024 := hp
      bv_omega)
  have hdest : (Obj.words 24576 true .W64 M.dest.toList).set (24576 + 8 * p) .W64 t
      = Obj.words 24576 true .W64 (FlatShuffler.Flat.put M.dest p t).toList := by
    have hlen : M.dest.toList.length = 1024 := by
      rw [Vector.length_toList]
      rfl
    have hn : 24576 + 8 * M.dest.toList.length ≤ 2 ^ 64 := by
      rw [hlen]; decide
    have h := Obj.set_dest 24576 M.dest.toList p hplen t hn
    rw [h]
    congr 1
    exact Vector.toList_setIfInBounds.symm
  have hs : (objsP b M saw).store (24576 + 8 * p) .W64 t
      = .ok (objsP b { M with dest := FlatShuffler.Flat.put M.dest p t } saw) := by
    have h := Heap.store_cell hO rfl hx₀ t
    rw [h0] at h
    rw [h]
    rw [objsP_eq, objsP_eq]
    simp only [List.map_cons, List.map_nil, ↓reduceIte]
    rw [hsaw, hsrc, htgt, hdrop, hdest, hpos]
    rfl
  exact Heap.store_append_frame hh hs

/-- A store of `p` at the position of `t`. -/
theorem objsP_store_pos (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (saw : Bool) (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (p : BitVec 64) (t : BitVec 64)
    (ht : t.toNat < FlatShuffler.maxStackSize) :
    (objsP b { M with dest := FlatShuffler.Flat.put M.dest p t } saw ++ frame).store
        (32768 + 8 * t) .W64 p
      = .ok (objsP b (M.bind p t) saw ++ frame) := by
  have htlen : t.toNat < M.pos.toList.length := by
    rw [Vector.length_toList]
    exact ht
  have hposz : 0 < (Obj.words 32768 true .W64 M.pos.toList).size := by
    have h1 : (Obj.words 32768 true .W64 M.pos.toList).size = 8 * M.pos.toList.length := by
      rw [Obj.size, Obj.words, words_bytes, Width.bytes]
    have h2 : M.pos.toList.length = 1024 := by rw [Vector.length_toList]; rfl
    rw [h1, h2]; decide
  have hO : Obj.words 32768 true .W64 M.pos.toList ∈ objsP b M saw := by
    rw [objsP_eq]; simp
  have hx₀ : (8 * t.toNat, (⟨.W64, M.pos.toList[t.toNat]⟩ : Cell)) ∈
      Lift.Sem.offsets 0 (Obj.words 32768 true .W64 M.pos.toList).cells := by
    have h := mem_offsets_words .W64 M.pos.toList 0 t.toNat htlen
    simpa [Obj.words, Nat.zero_add] using h
  have h0 : (Obj.words 32768 true .W64 M.pos.toList).addr + BitVec.ofNat 64 (8 * t.toNat)
      = 32768 + 8 * t := by
    have hb : (Obj.words 32768 true .W64 M.pos.toList).addr = 32768 := rfl
    rw [hb, show BitVec.ofNat 64 (8 * t.toNat) = 8 * t from by
      apply BitVec.eq_of_toNat_eq
      rw [BitVec.toNat_ofNat, BitVec.toNat_mul]; rfl]
  have hsaw : (Obj.words 56 true .W8 [if saw then 1 else 0]).set (32768 + 8 * t) .W64 p
      = Obj.words 56 true .W8 [if saw then 1 else 0] :=
    Obj.set_words_of_width_ne (by decide)
  have hsrc : (Obj.words 4096 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0)).set
        (32768 + 8 * t) .W64 p
      = Obj.words 4096 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0) :=
    Obj.set_words64_of_ne (fun k hk => by
      rw [List.length_map, List.length_range] at hk
      have ht' : t.toNat < 1024 := ht
      bv_omega)
  have htgt : (Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i default) 0)).set
        (32768 + 8 * t) .W64 p
      = Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i default) 0) :=
    Obj.set_words64_of_ne (fun k hk => by
      rw [List.length_map, List.length_range] at hk
      have ht' : t.toNat < 1024 := ht
      bv_omega)
  have hdrop : (Obj.words 20480 false .W8 b.dropped.toList).set (32768 + 8 * t) .W64 p
      = Obj.words 20480 false .W8 b.dropped.toList :=
    Obj.set_words_of_width_ne (by decide)
  have hdest : (Obj.words 24576 true .W64 (FlatShuffler.Flat.put M.dest p t).toList).set
        (32768 + 8 * t) .W64 p
      = Obj.words 24576 true .W64 (FlatShuffler.Flat.put M.dest p t).toList :=
    Obj.set_words64_of_ne (fun k hk => by
      rw [Vector.length_toList] at hk
      have hk' : k < 1024 := hk
      have ht' : t.toNat < 1024 := ht
      bv_omega)
  have hpos : (Obj.words 32768 true .W64 M.pos.toList).set (32768 + 8 * t) .W64 p
      = Obj.words 32768 true .W64 (FlatShuffler.Flat.put M.pos t p).toList := by
    have hlen : M.pos.toList.length = 1024 := by
      rw [Vector.length_toList]
      rfl
    have hn : 32768 + 8 * M.pos.toList.length ≤ 2 ^ 64 := by
      rw [hlen]; decide
    have h := Obj.set_dest 32768 M.pos.toList t htlen p hn
    rw [h]
    congr 1
    exact Vector.toList_setIfInBounds.symm
  have hs : (objsP b { M with dest := FlatShuffler.Flat.put M.dest p t } saw ++ frame).store
        (32768 + 8 * t) .W64 p = .ok (objsP b (M.bind p t) saw ++ frame) := by
    have hO' : Obj.words 32768 true .W64 M.pos.toList ∈
        objsP b { M with dest := FlatShuffler.Flat.put M.dest p t } saw := by
      rw [objsP_eq]; simp
    have h := Heap.store_cell (List.mem_append_left frame hO') rfl hx₀ p
    rw [h0] at h
    rw [h]
    rw [List.map_append]
    have hframe : List.map (Obj.set (32768 + 8 * t) .W64 p) frame = frame := by
      have hm : List.map (Obj.set (32768 + 8 * t) .W64 p) frame = List.map id frame :=
        List.map_congr_left (fun x hx => by
          rw [← h0]
          exact Heap.Holds.set_other hh (List.mem_append_left frame hO) rfl hx₀
            (List.mem_append_right _ hx)
            (ne_of_mem_append hh hO rfl hposz hx) p)
      rw [hm, List.map_id]
    rw [hframe, objsP_eq, objsP_eq]
    simp only [List.map_cons, List.map_nil, ↓reduceIte]
    rw [hsaw, hsrc, htgt, hdrop, hdest, hpos]
    rfl
  exact hs

end aux

namespace aux

open Lift.Sem Lift.P2.Total Lift.Trusted Lift.Shuffler.Internal.Proposed

/-- A byte is zero exactly when its zero extension is zero. -/
theorem beq_zero_iff (v : BitVec 8) :
    (v == 0) = true ↔ UInt64.ofBitVec (BitVec.zeroExtend 64 v) = 0 := by
  rw [beq_iff_eq]
  constructor
  · intro h; rw [h]; rfl
  · intro h
    have h2 := congrArg UInt64.toBitVec h
    simp only [UInt64.toBitVec_ofBitVec, UInt64.toBitVec_ofNat] at h2
    have h4 : v.toNat = 0 := by
      have h5 := congrArg BitVec.toNat h2
      simp only [BitVec.toNat_ofNat] at h5
      bv_omega
    exact BitVec.eq_of_toNat_eq (by simpa using h4)

/-- A word is `NONE` exactly when its `UInt64` value is the all-ones word. -/
theorem beq_none_iff (w : BitVec 64) :
    (w == FlatShuffler.Flat.NONE) = true ↔ UInt64.ofBitVec w = 18446744073709551615 := by
  rw [beq_iff_eq, FlatShuffler.Flat.NONE]
  constructor
  · intro h; rw [h]; decide
  · intro h
    have h2 := congrArg UInt64.toBitVec h
    rw [UInt64.toBitVec_ofBitVec] at h2
    rw [h2]
    decide

/-- A byte is zero exactly when its 64-bit value is zero. -/
theorem eq_zero_iff_setWidth (v : BitVec 8) : (v = 0) ↔ BitVec.setWidth 64 v = 0 := by
  constructor
  · intro h; rw [h]; rfl
  · intro h
    have h2 := congrArg BitVec.toNat h
    simp only [BitVec.toNat_setWidth, BitVec.toNat_ofNat] at h2
    have h3 : v.toNat = 0 := by bv_omega
    exact BitVec.eq_of_toNat_eq (by simpa using h3)

/-- A zero-extended byte is zero exactly when the byte is zero. -/
theorem zeroExtend_eq_zero_iff (v : BitVec 8) : BitVec.zeroExtend 64 v = 0 ↔ v = 0 := by
  rw [BitVec.zeroExtend_eq_setWidth]
  exact (eq_zero_iff_setWidth v).symm

/-- A word is `NONE` exactly when its `UInt64` value is the all-ones word. -/
theorem eq_NONE_iff (v : BitVec 64) :
    (v = FlatShuffler.Flat.NONE) ↔ UInt64.ofBitVec v = 18446744073709551615 := by
  rw [FlatShuffler.Flat.NONE]
  constructor
  · intro h; rw [h]; decide
  · intro h
    have h2 := congrArg UInt64.toBitVec h
    rw [UInt64.toBitVec_ofBitVec] at h2
    rw [h2]
    decide

/-- The all-ones word. -/
theorem NONE_val : UInt64.ofBitVec FlatShuffler.Flat.NONE = 18446744073709551615 := by
  decide

/-- A word whose `UInt64` value is zero is zero. -/
theorem ofBitVec_eq_zero (w : BitVec 64) : UInt64.ofBitVec w = 0 ↔ w = 0 := by
  constructor
  · intro h
    have h2 := congrArg UInt64.toBitVec h
    simpa using h2
  · intro h; rw [h]; rfl

/-- A word whose `UInt64` value is all ones is `NONE`. -/
theorem ofBitVec_eq_allOnes (w : BitVec 64) :
    UInt64.ofBitVec w = 18446744073709551615 ↔ w = FlatShuffler.Flat.NONE := by
  rw [FlatShuffler.Flat.NONE]
  constructor
  · intro h
    have h2 := congrArg UInt64.toBitVec h
    rw [UInt64.toBitVec_ofBitVec] at h2
    rw [h2]; decide
  · intro h; rw [h]; decide

/-- A read of a vector at a valid index. -/
theorem get_eq_toList {α : Type} [Inhabited α] (v : Vector α FlatShuffler.maxStackSize)
    (i : FlatShuffler.Word) (hi : i.toNat < FlatShuffler.maxStackSize) :
    FlatShuffler.Flat.get v i = v.toList[i.toNat]'(by rw [Vector.length_toList]; exact hi) := by
  simp only [FlatShuffler.Flat.get]
  rw [dif_pos hi]
  rfl

/-- The padding of a slot is zero, so the mask of the compared bits keeps the word. -/
theorem slotWord_and (s : FlatShuffler.StackSlot) :
    Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0 &&& 281474976710655
      = Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0 := by
  obtain ⟨p, k, o⟩ := s
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word]
  bv_decide

/-- Two slots of padding zero are equal when their words are. -/
theorem slotWord_inj {s s' : FlatShuffler.StackSlot}
    (h : Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0
        = Lift.Shuffler.Internal.Proposed.Layout.slotWord s' 0) : s = s' := by
  obtain ⟨p, k, o⟩ := s
  obtain ⟨p', k', o'⟩ := s'
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word] at h
  have hp : ∀ (o k : BitVec 8) (p : BitVec 32),
      BitVec.setWidth 32 ((0 : BitVec 16) ++ o ++ k ++ p : BitVec 64) = p := by
    intro o k p; bv_decide
  have hk : ∀ (o : BitVec 8) (k : BitVec 8) (p : BitVec 32),
      BitVec.setWidth 8 (((0 : BitVec 16) ++ o ++ k ++ p : BitVec 64) >>> 32) = k := by
    intro o k p; bv_decide
  have ho : ∀ (o : BitVec 8) (k : BitVec 8) (p : BitVec 32),
      BitVec.setWidth 8 (((0 : BitVec 16) ++ o ++ k ++ p : BitVec 64) >>> 40) = o := by
    intro o k p; bv_decide
  have e1 : p = p' := by
    have hh := congrArg (fun w : BitVec 64 => BitVec.setWidth 32 w) h
    rw [hp, hp] at hh
    exact hh
  have e2 : k = k' := by
    have hh := congrArg (fun w : BitVec 64 => BitVec.setWidth 8 (w >>> 32)) h
    rw [hk, hk] at hh
    exact hh
  have e3 : o = o' := by
    have hh := congrArg (fun w : BitVec 64 => BitVec.setWidth 8 (w >>> 40)) h
    rw [ho, ho] at hh
    exact hh
  subst e1; subst e2; subst e3; rfl

/-- The `kind` byte of a slot is byte `4` of its word. -/
theorem slotWord_kind (s : FlatShuffler.StackSlot) :
    (Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0 >>> 32).setWidth 8 = s.kind := by
  obtain ⟨p, k, o⟩ := s
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word]
  bv_decide

/-- The comparison of the words of two slots of padding zero is the equality of the slots. -/
theorem slotWord_eq_iff (s s' : FlatShuffler.StackSlot) :
    (Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0 &&& 281474976710655
      = Lift.Shuffler.Internal.Proposed.Layout.slotWord s' 0 &&& 281474976710655) ↔ s = s' := by
  rw [slotWord_and, slotWord_and]
  exact ⟨slotWord_inj, fun h => by rw [h]⟩

/-- `UInt64` masks of packed words: the comparison of two masked words. -/
theorem ofBitVec_mask_eq_iff (x y : BitVec 64) :
    (UInt64.ofBitVec x &&& UInt64.ofBitVec 281474976710655
      = UInt64.ofBitVec y &&& UInt64.ofBitVec 281474976710655) ↔
      x &&& 281474976710655 = y &&& 281474976710655 := by
  constructor
  · intro h
    exact congrArg UInt64.toBitVec h
  · intro h
    have h2 : UInt64.ofBitVec (x &&& 281474976710655) = UInt64.ofBitVec (y &&& 281474976710655) := by
      rw [h]
    exact h2

end aux

namespace aux

open Lift.Sem Lift.P2.Total Lift.Trusted Lift.Shuffler.Internal.Proposed

/-- The bytes of a flattened array of words: the drop of `8 * j` bytes is the bytes of the word `j`. -/
theorem flatMap_drop_bytes (xs : List (BitVec 64)) (j : Nat) (hj : j < xs.length) :
    ((xs.flatMap fun v => Int.toBytes 8 v.toInt)).drop (8 * j)
      = Int.toBytes 8 (xs[j]).toInt ++ (xs.drop (j + 1)).flatMap (fun v => Int.toBytes 8 v.toInt) := by
  induction xs generalizing j with
  | nil => exact absurd hj (by simp)
  | cons a t ih =>
    cases j with
    | zero => simp
    | succ k =>
      have hk : k < t.length := by simpa using hj
      rw [List.flatMap_cons, show 8 * (k + 1) = 8 + 8 * k from by omega, List.drop_append,
        Int.toBytes_length, show 8 + 8 * k - 8 = 8 * k from by omega,
        List.drop_eq_nil_of_le (by rw [Int.toBytes_length]; omega), List.nil_append, ih k hk]
      simp

/-- The byte `4` of a word, as a value of 8 bits. -/
theorem ofInt_byte4 (v : BitVec 64) :
    BitVec.ofInt 8 (Int.ofBytes (List.take 1 (List.drop 4 (Int.toBytes 8 v.toInt))))
      = (v >>> 32).setWidth 8 := by
  have h := Lift.Sem.ByteLemmas.ofInt_slice_toBytes 8 v 4 1 (by omega)
  exact h

/-- The size of an array of values of one width. -/
theorem size_words (base : BitVec 64) (wr : Bool) (w : Width) (xs : List w.type) :
    (Obj.words base wr w xs).size = w.bytes * xs.length := by
  simp only [Obj.size, Obj.words]
  exact words_bytes w xs

/-- `getD` at a valid index is the element. -/
theorem getD_eq_getElem {α : Type} [Inhabited α] (l : List α) (i : Nat) (h : i < l.length) :
    l.getD i default = l[i] := by
  simp [List.getD, List.getElem?_eq_getElem h]

/-- The target array is an object of the heap of the statement. -/
theorem mem_tgt_obj (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool) :
    Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Layout.slotWord (b.target.toList.getD i default) 0) ∈ objsP b M saw := by
  rw [objsP_eq]; simp

/-- The bytes of the target array at the offset `8 * j + 4` are the byte `4` of the slot `j`. -/
theorem tgt_bytes (b : FlatShuffler.Flat.Builder) (j : Nat) (hj : j < 1024) :
    (List.take 1 (List.drop (8 * j + 4)
        (Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
          Layout.slotWord (b.target.toList.getD i default) 0)).bytes))
      = List.take 1 (List.drop 4 (Int.toBytes 8
          (Layout.slotWord (b.target.toList.getD j default) 0).toInt)) := by
  have hb : (Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Layout.slotWord (b.target.toList.getD i default) 0)).bytes
      = ((List.range 1024).map fun i =>
        Layout.slotWord (b.target.toList.getD i default) 0).flatMap
        (fun v => Int.toBytes 8 v.toInt) := by
    rw [Obj.bytes_eq, Obj.words, List.flatMap_map]
    rfl
  rw [hb, ← List.drop_drop (i := 4) (j := 8 * j),
    flatMap_drop_bytes _ j (by simpa using hj), List.drop_append,
    Int.toBytes_length, show 4 - 8 = 0 from rfl, List.drop_zero,
    List.take_append_of_le_length (by simp [Int.toBytes_length])]
  simp only [List.getElem_map, List.getElem_range]

/-- The memory's byte at the offset `8 * j + 4` of the target array. -/
theorem tgt_loadInt (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (j : Nat) (hj : j < 1024) :
    Mem.loadInt m (12288 + BitVec.ofNat 64 (8 * j + 4)) 1
      = some (Int.ofBytes (List.take 1 (List.drop 4 (Int.toBytes 8
          (Layout.slotWord (b.target.toList.getD j default) 0).toInt)))) := by
  have ho : Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Layout.slotWord (b.target.toList.getD i default) 0) ∈ objsP b M saw ++ frame :=
    List.mem_append_left frame (mem_tgt_obj b M saw)
  have hsz : (Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Layout.slotWord (b.target.toList.getD i default) 0)).size = 8192 := by
    rw [size_words, List.length_map, List.length_range]
    rfl
  have hcont := hh.contains ho
  have hsl := Lift.Sem.ByteLemmas.Contains.slice hcont (8 * j + 4) 1
  have hlen : (List.take 1 (List.drop (8 * j + 4)
      (Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
        Layout.slotWord (b.target.toList.getD i default) 0)).bytes)).length = 1 := by
    rw [List.length_take, List.length_drop, Obj.bytes_length, hsz]
    omega
  have hli := hsl.loadInt_eq hlen
  rw [tgt_bytes b j hj] at hli
  exact hli

/-- The byte `4` of the target slot `j`, as the model's byte load of the target array gives it. -/
theorem loadB_byte4 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (j : BitVec 64) (hj : j.toNat < 1024) :
    (objsP b M saw ++ frame).loadB (12288 + 8 * j + 4) .W8
      = .ok ((Layout.slotWord (b.target.toList.getD j.toNat default) 0 >>> 32).setWidth 8) := by
  have hlt : j.toNat < 1024 := hj
  let w0 : BitVec 64 := Layout.slotWord (b.target.toList.getD j.toNat default) 0
  let bs0 : List UInt8 := List.take 1 (List.drop 4 (Int.toBytes 8 w0.toInt))
  have hbyte : BitVec.ofInt 8 (Int.ofBytes bs0) = (w0 >>> 32).setWidth 8 := ofInt_byte4 w0
  have hmem0 : Mem.loadInt m (12288 + BitVec.ofNat 64 (8 * j.toNat + 4)) 1
      = some (Int.ofBytes bs0) := tgt_loadInt b M saw frame pol m hh j.toNat hlt
  have haddr : 12288 + BitVec.ofNat 64 (8 * j.toNat + 4) = 12288 + 8 * j + 4 := by
    have e1 : BitVec.ofNat 64 (8 * j.toNat) = 8 * j := by
      apply BitVec.eq_of_toNat_eq
      bv_omega
    have e2 : BitVec.ofNat 64 (8 * j.toNat + 4) = BitVec.ofNat 64 (8 * j.toNat) + 4 := by
      rw [BitVec.ofNat_add]
      rfl
    rw [e2, e1]
    simp only [BitVec.add_assoc]
  have hmem : Mem.loadInt m (12288 + 8 * j + 4) 1 = some (Int.ofBytes bs0) := by
    rw [← haddr]; exact hmem0
  have claim : ∀ (bs : List UInt8), Mem.Contains m (12288 + 8 * j + 4) bs → bs.length = 1 →
      BitVec.ofInt 8 (Int.ofBytes bs) = (w0 >>> 32).setWidth 8 := by
    intro bs hc hbl
    have h1 := hc.loadInt_eq hbl
    rw [hmem] at h1
    have e : Int.ofBytes bs = Int.ofBytes bs0 := (Option.some.inj h1).symm
    rw [e]; exact hbyte
  have hspan : (Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Layout.slotWord (b.target.toList.getD i default) 0)).Spans (12288 + 8 * j + 4) .W8 := by
    have hsz : (Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
        Layout.slotWord (b.target.toList.getD i default) 0)).size = 8192 := by
      rw [size_words, List.length_map, List.length_range]
      rfl
    unfold Obj.Spans
    rw [hsz]
    show 12288 ≤ (12288 + 8 * j + 4).toNat ∧ (12288 + 8 * j + 4).toNat + 1 ≤ 12288 + 8192
    constructor <;> bv_omega
  have ho : Obj.words 12288 false .W64 ((List.range 1024).map fun i =>
      Layout.slotWord (b.target.toList.getD i default) 0) ∈ objsP b M saw ++ frame :=
    List.mem_append_left frame (mem_tgt_obj b M saw)
  rcases hl : (objsP b M saw ++ frame).load (12288 + 8 * j + 4) .W8 with v | why | _
  · have hL : (objsP b M saw ++ frame).loadB (12288 + 8 * j + 4) .W8 = .ok v := by
      simp only [Heap.loadB, hl]
    rw [hL]
    congr 1
    have hr := Heap.load_sound hh hl
    obtain ⟨-, x, hx⟩ := readRam_ok hr
    have hv : v = BitVec.ofInt 8 x := by
      unfold readRam at hr
      split at hr
      · rename_i hp
        rw [hx] at hr
        exact (Except.ok.inj hr).symm
      · cases hr
    have hx2 : x = Int.ofBytes bs0 := by
      rw [hmem] at hx
      exact (Option.some.inj hx).symm
    rw [hv, hx2]
    exact hbyte
  · rcases hf : (objsP b M saw ++ frame).findSome? (fun o => o.loadBytes (12288 + 8 * j + 4) .W8)
        with _ | v
    · have hnone := List.findSome?_eq_none_iff.mp hf _ ho
      simp only [Obj.loadBytes, if_pos hspan] at hnone
      cases hnone
    · have hL : (objsP b M saw ++ frame).loadB (12288 + 8 * j + 4) .W8 = .ok v := by
        simp only [Heap.loadB, hl, hf]
      rw [hL]
      congr 1
      obtain ⟨o, hoo, hlb⟩ := List.exists_of_findSome?_eq_some hf
      obtain ⟨k, hae, hkb, rfl⟩ := Obj.loadBytes_spec hlb
      have hc : Mem.Contains m (12288 + 8 * j + 4) (List.take 1 (List.drop k o.bytes)) := by
        have h := Lift.Sem.ByteLemmas.Contains.slice (hh.contains hoo) k 1
        rwa [← hae] at h
      exact claim _ hc (by
        have hk1 : k + 1 ≤ o.size := hkb
        rw [List.length_take, List.length_drop, Obj.bytes_length, Nat.min_eq_left (by omega)])
  · simp only [Heap.load] at hl
    split at hl <;> cases hl

end aux

namespace aux

open Lift.Sem Lift.P2.Total Lift.Trusted Lift.Shuffler.Internal.Proposed
open FlatShuffler FlatShuffler.Flat

/-- The kind byte read back from the packed word. -/
theorem kind_shift_junk (k : BitVec 8) :
    (UInt64.ofBitVec (BitVec.zeroExtend 64 k) <<< (32 : UInt64) = 4294967296) ↔ k = 1 := by
  constructor
  · intro h
    have h2 := congrArg (fun w : UInt64 => ((w.toBitVec >>> (32 : BitVec 64)).setWidth 8)) h
    simp only [UInt64.toBitVec_shiftLeft, UInt64.toBitVec_ofNat] at h2
    rw [show ((BitVec.zeroExtend 64 k <<< (BitVec.ofNat 64 32 % 64)) >>> (32 : BitVec 64)).setWidth 8 = k
      from by bv_decide] at h2
    simpa using h2
  · intro h; rw [h]; decide

/-- The kind byte of a `FunctionReturnLabel` slot, read back from the packed word. -/
theorem kind_shift_ret (k : BitVec 8) :
    (UInt64.ofBitVec (BitVec.zeroExtend 64 k) <<< (32 : UInt64) = 12884901888) ↔ k = 3 := by
  constructor
  · intro h
    have h2 := congrArg (fun w : UInt64 => ((w.toBitVec >>> (32 : BitVec 64)).setWidth 8)) h
    simp only [UInt64.toBitVec_shiftLeft, UInt64.toBitVec_ofNat] at h2
    rw [show ((BitVec.zeroExtend 64 k <<< (BitVec.ofNat 64 32 % 64)) >>> (32 : BitVec 64)).setWidth 8 = k
      from by bv_decide] at h2
    simpa using h2
  · intro h; rw [h]; decide

/-- The word of a failed map: `1`. -/
theorem map_exit_rax (p : UInt64) (hp : p.toBitVec.toNat < 65536) :
    ((((p &&& 18446744073709486080) ||| 1) &&& 18446744073709486080) ||| (1 &&& 65535)) = 1 := by
  have hp' : p.toBitVec < (65536 : BitVec 64) := by rw [BitVec.lt_def]; simpa using hp
  have key : (((p.toBitVec &&& 18446744073709486080) ||| 1) &&& 18446744073709486080)
      ||| (1 &&& 65535) = 1 := by
    bv_decide
  exact UInt64.toBitVec_inj.mp (by simpa using key)

/-- `absDiff` with the comparison of the assembly. -/
theorem absDiff_eq_asm1 (a c : BitVec 64) :
    absDiff a c = if c ≤ a then a - c else c - a := by
  rw [absDiff]
  by_cases h : a > c
  · have h1 : c ≤ a := by
      have h2 : c < a := h
      rw [BitVec.lt_def] at h2
      rw [BitVec.le_def]; omega
    rw [if_pos h, if_pos h1]
  · have h2 : ¬ (c < a) := h
    rw [if_neg h]
    by_cases h3 : c ≤ a
    · have h4 : c.toNat = a.toNat := by
        rw [BitVec.le_def] at h3
        rw [BitVec.lt_def] at h2
        omega
      rw [if_pos h3, BitVec.eq_of_toNat_eq h4]
    · rw [if_neg h3]

/-- `absDiff` with the other comparison of the assembly. -/
theorem absDiff_eq_asm2 (a c : BitVec 64) :
    absDiff a c = if a ≤ c then c - a else a - c := by
  rw [absDiff]
  by_cases h : a > c
  · have h1 : ¬ (a ≤ c) := by
      have h2 : c < a := h
      rw [BitVec.lt_def] at h2
      rw [BitVec.le_def]; omega
    rw [if_pos h, if_neg h1]
  · have h1 : a ≤ c := by
      have h2 : ¬ (c < a) := h
      rw [BitVec.lt_def] at h2
      rw [BitVec.le_def]; omega
    rw [if_neg h, if_pos h1]

/-- A step of the loop of `closestCopy`. -/
theorem closestFrom_succ (b : Builder) (M : Mapping) (t : Word) (inW : Bool) (i best : Word)
    (h : i < b.sourceSize) :
    closestFrom b M t inW i best =
      closestFrom b M t inW (i + 1)
        (if (decide (get b.source i = get b.target t) && mappable b M i
            && inWildcardSlot b i == inW) = true then
          if (decide (best = NONE) || decide (absDiff i t ≤ absDiff best t)) = true then i else best
        else best) := by
  rw [closestFrom.eq_1, dif_pos h]

/-- The result of the loop of `closestCopy` is the best or an index in range. -/
theorem closestFrom_spec_aux (b : Builder) (M : Mapping) (t : Word) (inW : Bool) (n : Nat) :
    ∀ (i best : Word), (b.sourceSize - i).toNat ≤ n →
      (closestFrom b M t inW i best = best ∨
        ∃ k, closestFrom b M t inW i best = k ∧ i.toNat ≤ k.toNat
          ∧ k.toNat < b.sourceSize.toNat) := by
  induction n with
  | zero =>
    intro i best h
    by_cases hlt : i < b.sourceSize
    · exfalso
      rw [BitVec.lt_def] at hlt
      bv_omega
    · rw [closestFrom.eq_1, dif_neg hlt]
      exact Or.inl rfl
  | succ n ih =>
    intro i best h
    by_cases hlt : i < b.sourceSize
    · rw [closestFrom_succ b M t inW i best hlt]
      have hle : (b.sourceSize - (i + 1)).toNat ≤ n := by
        rw [BitVec.lt_def] at hlt
        bv_omega
      by_cases hc : (decide (get b.source i = get b.target t) && mappable b M i
          && inWildcardSlot b i == inW) = true
      · rw [if_pos hc]
        by_cases hb : (decide (best = NONE) || decide (absDiff i t ≤ absDiff best t)) = true
        · rw [if_pos hb]
          rcases ih (i + 1) i hle with h' | ⟨k, hk, h1, h2⟩
          · exact Or.inr ⟨i, h', by omega, by bv_omega⟩
          · exact Or.inr ⟨k, hk, by bv_omega, h2⟩
        · rw [if_neg hb]
          rcases ih (i + 1) best hle with h' | ⟨k, hk, h1, h2⟩
          · exact Or.inl h'
          · exact Or.inr ⟨k, hk, by bv_omega, h2⟩
      · rw [if_neg hc]
        rcases ih (i + 1) best hle with h' | ⟨k, hk, h1, h2⟩
        · exact Or.inl h'
        · exact Or.inr ⟨k, hk, by bv_omega, h2⟩
    · rw [closestFrom.eq_1, dif_neg hlt]
      exact Or.inl rfl

/-- The result of the loop of `closestCopy` is the best or an index in range. -/
theorem closestFrom_spec (b : Builder) (M : Mapping) (t : Word) (inW : Bool) (i best : Word) :
    closestFrom b M t inW i best = best ∨
      ∃ k, closestFrom b M t inW i best = k ∧ i.toNat ≤ k.toNat
        ∧ k.toNat < b.sourceSize.toNat :=
  closestFrom_spec_aux b M t inW (b.sourceSize - i).toNat i best (by omega)

/-- The index of a copy is in range. -/
theorem closestCopy_bound (b : Builder) (M : Mapping) (t : Word) (inW : Bool)
    (h : closestCopy b M t inW ≠ NONE) (hs : b.sourceSize.toNat ≤ 1024) :
    (closestCopy b M t inW).toNat < 1024 := by
  have hsp := closestFrom_spec b M t inW 0 NONE
  rcases hsp with h' | ⟨k, hk, -, h2⟩
  · exact absurd h' h
  · have e : closestCopy b M t inW = k := hk
    rw [e]; omega

/-- The map of the statement returns `done` or an assertion failure. -/
theorem mbMap_cases (b : Builder) (M : Mapping) (p t : Word) :
    (mbMap b M p t).1 = .done ∨ (mbMap b M p t).1 = .assertionExit := by
  rw [mbMap]
  by_cases h1 : !mappable b M p
  · rw [if_pos h1]; exact Or.inr rfl
  · rw [if_neg h1]
    by_cases h2 : get M.dest p ≠ NONE
    · rw [if_pos h2]; exact Or.inr rfl
    · rw [if_neg h2]
      by_cases h3 : get M.pos t ≠ NONE
      · rw [if_pos h3]; exact Or.inr rfl
      · rw [if_neg h3]; exact Or.inl rfl

/-- A successful map is `M.bind p t`. -/
theorem mbMap_done (b : Builder) (M : Mapping) (p t : Word)
    (h : (mbMap b M p t).1 = .done) : mbMap b M p t = (.done, M.bind p t) := by
  have h' := h
  rw [mbMap] at h'
  rw [mbMap]
  by_cases h1 : !mappable b M p
  · rw [if_pos h1] at h'
    simp at h'
  · rw [if_neg h1]
    by_cases h2 : get M.dest p ≠ NONE
    · rw [if_pos h2] at h'
      simp at h'
    · rw [if_neg h2]
      by_cases h3 : get M.pos t ≠ NONE
      · rw [if_pos h3] at h'
        simp at h'
      · rw [if_neg h3]

/-- The loop of the statement skips an index. -/
theorem wildcardFrom_skip (b : Builder) (M : Mapping) (saw : Bool) (j : Word)
    (hj : j < b.targetSize)
    (hc : ¬ ((!hasSourceAssigned M j && !isWildcardTarget b j
      && decide (closestCopy b M j true ≠ NONE)) = true)) :
    wildcardFrom b M saw j = wildcardFrom b M saw (j + 1) := by
  rw [wildcardFrom.eq_1, dif_pos hj, if_neg hc]

/-- The loop of the statement maps the closest copy of a `FunctionReturnLabel` slot. -/
theorem wildcardFrom_ret (b : Builder) (M : Mapping) (saw : Bool) (j : Word)
    (hj : j < b.targetSize)
    (hc : (!hasSourceAssigned M j && !isWildcardTarget b j
      && decide (closestCopy b M j true ≠ NONE)) = true)
    (hk : (get b.target j).kind = FunctionReturnLabel) :
    wildcardFrom b M saw j =
      (if (mbMap b M (closestCopy b M j true) j).1 ≠ .done then
        ((mbMap b M (closestCopy b M j true) j).1, (mbMap b M (closestCopy b M j true) j).2, saw)
      else wildcardFrom b (mbMap b M (closestCopy b M j true) j).2 saw (j + 1)) := by
  rw [wildcardFrom.eq_1, dif_pos hj, if_pos hc, if_pos hk]

/-- The loop of the statement maps the closest copy of another slot, with `take`. -/
theorem wildcardFrom_take (b : Builder) (M : Mapping) (saw : Bool) (j : Word)
    (hj : j < b.targetSize)
    (hc : (!hasSourceAssigned M j && !isWildcardTarget b j
      && decide (closestCopy b M j true ≠ NONE)) = true)
    (hk : ¬ (get b.target j).kind = FunctionReturnLabel) (ht : b.take = true) :
    wildcardFrom b M saw j =
      (if (mbMap b M (closestCopy b M j true) j).1 ≠ .done then
        ((mbMap b M (closestCopy b M j true) j).1, (mbMap b M (closestCopy b M j true) j).2, true)
      else wildcardFrom b (mbMap b M (closestCopy b M j true) j).2 true (j + 1)) := by
  rw [wildcardFrom.eq_1, dif_pos hj, if_pos hc, if_neg hk, if_pos ht]

/-- The loop of the statement records `saw` and goes on, without `take`. -/
theorem wildcardFrom_notake (b : Builder) (M : Mapping) (saw : Bool) (j : Word)
    (hj : j < b.targetSize)
    (hc : (!hasSourceAssigned M j && !isWildcardTarget b j
      && decide (closestCopy b M j true ≠ NONE)) = true)
    (hk : ¬ (get b.target j).kind = FunctionReturnLabel) (ht : ¬ (b.take = true)) :
    wildcardFrom b M saw j = wildcardFrom b M true (j + 1) := by
  rw [wildcardFrom.eq_1, dif_pos hj, if_pos hc, if_neg hk, if_neg ht]

/-- The low word of `(a &&& ~0xffff) ||| 1` is `1`. -/
theorem or_one_low16 (a : UInt64) :
    ((a &&& 18446744073709486080) ||| 1).toUInt16.toUInt64 = 1 := by
  have key : (((a.toBitVec &&& 18446744073709486080) ||| 1) &&& 65535) = 1 := by bv_decide
  exact UInt64.toBitVec_inj.mp (by simpa using key)

/-- The heap of the statement has a fixed length. -/
theorem objsP_length (b : Builder) (M : Mapping) (saw : Bool) : (objsP b M saw).length = 13 := by
  rw [objsP_eq]; rfl

/-- The heap after recording `saw` is held by some memory. -/
theorem holds_store_saw (b : Builder) (M : Mapping) (saw : Bool) (frame : Heap) (pol : CpuPolicy)
    (m : DataMem) (hh : Heap.Holds pol (objsP b M saw ++ frame) m) :
    ∃ m', Heap.Holds pol (objsP b M true ++ frame) m' := by
  obtain ⟨m', -, h2, -⟩ := Heap.store_sound hh (objsP_store_saw b M saw frame pol m hh)
  exact ⟨m', h2⟩

/-- The heap after a map is held by some memory. -/
theorem holds_map (b : Builder) (M : Mapping) (saw : Bool) (frame : Heap) (pol : CpuPolicy)
    (m : DataMem) (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (p t : Word)
    (hp : p.toNat < maxStackSize) (ht : t.toNat < maxStackSize) :
    ∃ m', Heap.Holds pol (objsP b (M.bind p t) saw ++ frame) m' := by
  obtain ⟨m1, -, h1, -⟩ := Heap.store_sound hh (objsP_store_dest b M saw frame pol m hh p hp t)
  obtain ⟨m2, -, h2, -⟩ := Heap.store_sound h1 (objsP_store_pos b M saw frame pol m hh p t ht)
  exact ⟨m2, h2⟩

end aux

namespace loop

open FlatShuffler.Flat
open Lift.Shuffler.Internal.Proposed

/-- The word of the result of the statement. -/
def outWord (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool) : UInt64 :=
  match wildcardFrom b M saw 0 with
  | (ExecutionControl.returned _, _) => 0
  | (ExecutionControl.assertionExit, _) => 1

/-- The heap of the result of the statement. -/
def outHeap (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (saw : Bool) : Heap :=
  match wildcardFrom b M saw 0 with
  | (_, (M', saw')) => objsP b M' saw' ++ frame

/-- The invariant of the loop at `.LBB27_1`. -/
def Inv (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool)
    (a : In2p) (x : St In2p Heap) : Prop :=
  x.input = a ∧ x.rbx = a.rdi ∧ x.rbp.toUInt32.toUInt64 = 1 ∧ x.r12 = 4294967296 ∧
  x.r15 = UInt64.ofBitVec b.targetSize ∧
  ∃ (M' : FlatShuffler.Flat.Mapping) (saw' : Bool),
    x.mem = objsP b M' saw' ++ frame ∧
    x.r14.toBitVec.toNat ≤ b.targetSize.toNat ∧
    wildcardFrom b M' saw' x.r14.toBitVec = wildcardFrom b M saw 0 ∧
    (∃ m, x.mem.Holds a.policy m)

/-- The loop of the statement, from the head label. -/
theorem loop_returns (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (saw : Bool) (a : In2p) (hrdi : a.rdi.toBitVec = 0) (hsrc : b.sourceSize.toNat ≤ 1024)
    (htgt : b.targetSize.toNat ≤ 1024)
    (hcloseR : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
      (saw : Bool) (pol : CpuPolicy) (m : DataMem),
      Heap.Holds pol (objsP b M saw ++ frame) m → ∀ (t : BitVec 64),
      t.toNat < FlatShuffler.maxStackSize → b.sourceSize.toNat ≤ 1024 →
      ∀ (x : mappingBuilderClosestCopy.In2p), x.rdi.toBitVec = 0 → x.rsi.toBitVec = t →
      x.heap = objsP b M saw ++ frame → x.rdx.toUInt8.toUInt64 ≠ 0 →
      mappingBuilderClosestCopy.blocksP.Returns noCall .entry
        ⟨x, 0, x.rbx, 0, x.rbp, 0, 0, 0, 0, x.r14, x.r15, x.heap⟩
        (UInt64.ofBitVec (closestCopy b M t true)))
    (hmapR : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
      (saw : Bool) (pol : CpuPolicy) (m : DataMem),
      Heap.Holds pol (objsP b M saw ++ frame) m → ∀ (p t : BitVec 64),
      p.toNat < FlatShuffler.maxStackSize → t.toNat < FlatShuffler.maxStackSize →
      ∀ (x : mappingBuilderMap.In2p), x.policy = pol → x.rdi.toBitVec = 0 → x.rsi.toBitVec = p →
      x.rdx.toBitVec = t → x.heap = objsP b M saw ++ frame →
      mappingBuilderMap.blocksP.Returns noCall .entry ⟨x, x.rax, 0, x.heap⟩
        (if (mbMap b M p t).1 = .done then 0 else (x.rax &&& 18446744073709486080) ||| 1,
         objsP b (mbMap b M p t).2 saw ++ frame)) :
    ∀ x, Inv frame b M saw a x →
      blocksP.Returns CalP.rel .LBB27_1 x (outWord b M saw, outHeap frame b M saw) := by
  refine Blocks.Returns.loop (Inv frame b M saw a) (fun x => (b.targetSize - x.r14.toBitVec).toNat)
    (fun _ => (outWord b M saw, outHeap frame b M saw)) ?_
  intro x hx ih
  simp only [Inv] at hx
  obtain ⟨hin, hrbx, hrbp, hr12, hr15, M', saw', hmem, hbound, hwf, m, hm⟩ := hx
  have hrbx0 : x.rbx.toBitVec = 0 := by rw [hrbx, hrdi]
  have hm' : (objsP b M' saw' ++ frame).Holds a.policy m := hmem ▸ hm
  have hst1 : blocksP.step .LBB27_1 x
      = .ok (if x.r15 = x.r14 then .goto .LBB27_2 x else .goto .o39 x) := rfl
  by_cases heq : x.r15 = x.r14
  · have e1 : UInt64.ofBitVec b.targetSize = x.r14 := by rw [← hr15]; exact heq
    have hj : x.r14.toBitVec = b.targetSize := by
      have h := congrArg UInt64.toBitVec e1.symm
      simpa using h
    have hwf0 : wildcardFrom b M saw 0 = (.done, (M', saw')) := by
      rw [← hwf, hj, FlatShuffler.Flat.wildcardFrom.eq_1]
      rw [dif_neg (by rw [BitVec.lt_def]; omega)]
    have hout : (outWord b M saw, outHeap frame b M saw) = ((0 : UInt64), x.mem) := by
      simp only [outWord, outHeap, hwf0, hmem]
    rw [hout]
    have hst1' : blocksP.step .LBB27_1 x = .ok (.goto .LBB27_2 x) := by rw [hst1, if_pos heq]
    have hst2 : blocksP.step .LBB27_2 x = .ok (.goto .LBB27_3 { x with rax := 0 }) := rfl
    have hst3 : blocksP.step .LBB27_3 { x with rax := 0 } = .ok (.ret ((0 : UInt64), x.mem)) := by
      simp only [blocksP]
    exact Blocks.Returns.goto hst1' (Blocks.Returns.goto hst2 (Blocks.Returns.ret hst3))
  · have hjne : x.r14.toBitVec ≠ b.targetSize := by
      intro e
      apply heq
      rw [hr15]
      have e2 : x.r14 = UInt64.ofBitVec b.targetSize := by
        have h := congrArg UInt64.ofBitVec e
        simpa using h
      exact e2.symm
    have hjlt : x.r14.toBitVec.toNat < b.targetSize.toNat := by
      by_cases h : x.r14.toBitVec.toNat < b.targetSize.toNat
      · exact h
      · exact absurd (BitVec.eq_of_toNat_eq (by omega)) hjne
    have hjlt' : x.r14.toBitVec < b.targetSize := by rw [BitVec.lt_def]; exact hjlt
    have hI1024 : x.r14.toBitVec.toNat < FlatShuffler.maxStackSize := by
      have h : FlatShuffler.maxStackSize = 1024 := rfl
      omega
    have cont : ∀ (T : St In2p Heap) (M'' : FlatShuffler.Flat.Mapping) (saw'' : Bool),
        T.input = a → T.rbx = a.rdi → T.rbp.toUInt32.toUInt64 = 1 → T.r12 = 4294967296 →

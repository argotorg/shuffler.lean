theorem map_toCell_range64t (b : FlatShuffler.Flat.Builder) :
    List.map (Lift.Sem.Bridge.toCell ∘ fun i => (⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i default) 0⟩ : Lift.Trusted.Field)) (List.range 1024)

  have hm : Obj.words 40 false .W8 [(if b.take then (1 : BitVec 8) else 0)] ∈ objsP b M saw := by
    simpa [toObj_word8] using
      mem_objsP b M saw (⟨40, [⟨.W8, if b.take then (1 : BitVec 8) else 0⟩], false⟩ : Object) ho
  exact loadB_single hh (List.mem_append_left _ hm)

/-- The pointer `destination_of`. -/
theorem objsP_load_48 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) :
    (objsP b M saw ++ frame).loadB 48 .W64 = .ok 24576 := by
  have ho : (⟨48, [⟨.W64, (24576 : BitVec 64)⟩], false⟩ : Object) ∈ objects b M saw envOf := by
    simp [objects, envOf]
  have hm : Obj.words 48 false .W64 [(24576 : BitVec 64)] ∈ objsP b M saw := by
    simpa [toObj_word64] using mem_objsP b M saw (⟨48, [⟨.W64, (24576 : BitVec 64)⟩], false⟩ : Object) ho
  exact loadB_single hh (List.mem_append_left _ hm)

/-- The byte `saw`. -/
theorem objsP_load_56 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) :
    (objsP b M saw ++ frame).loadB 56 .W8 = .ok (if saw then 1 else 0) := by
  have ho : (⟨56, [⟨.W8, if saw then (1 : BitVec 8) else 0⟩], true⟩ : Object) ∈ objects b M saw envOf := by
    simp [objects, envOf]
  have hm : Obj.words 56 true .W8 [(if saw then (1 : BitVec 8) else 0)] ∈ objsP b M saw := by
    simpa [toObj_word8] using
      mem_objsP b M saw (⟨56, [⟨.W8, if saw then (1 : BitVec 8) else 0⟩], true⟩ : Object) ho
  exact loadB_single hh (List.mem_append_left _ hm)

/-- A word array of the heap that the memory holds: the load at a bit index gives the element. -/
theorem loadB_words64 {pol : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds pol m)
    {base : BitVec 64} {wr : Bool} {xs : List (BitVec 64)}
    (ho : Obj.words base wr .W64 xs ∈ h) {i : BitVec 64} (hi : i.toNat < xs.length) :
    h.loadB (base + 8 * i) .W64 = .ok xs[i.toNat] := by
  have hl := Heap.load_words64 hh ho hi
  simp only [Heap.loadB]
  rw [hl]

/-- A byte array of the heap that the memory holds: the load at a bit index gives the element. -/
theorem loadB_words8 {pol : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds pol m)
    {base : BitVec 64} {wr : Bool} {xs : List (BitVec 8)}
    (ho : Obj.words base wr .W8 xs ∈ h) {i : BitVec 64} (hi : i.toNat < xs.length) :
    h.loadB (base + i) .W8 = .ok xs[i.toNat] := by
  have hl := loadB_words hh ho hi
  simpa [Obj.words, addr_byte] using hl

/-- `getD` of a valid index. -/
theorem list_getD_eq (l : List (BitVec 8)) (i : Nat) (hi : i < l.length) : l.getD i 0 = l[i] := by
  simp [List.getD, List.getElem?_eq_getElem hi]

end aux


  show v.toList.flatMap (fun b => [(⟨.W64, b⟩ : Lift.Trusted.Field)]) = _
  rw [flatMap_singleton']

theorem map_toCell_encode_words {n : Nat} (v : Vector (BitVec 64) n) :
    (Lift.Trusted.Encode.encode v).map Lift.Sem.Bridge.toCell =
      v.toList.map (Cell.mk .W64) := by
  rw [encode_words_eq, List.map_map]
  apply List.map_congr_left
  intro i _
  rfl


theorem roomAt_sp96 {policy : CpuPolicy} {m m' : DataMem} {sp : BitVec 64}
    (h : SysV.RoomAt policy m sp 96)
    (hframe : ∀ b, ¬ SysV.Below (sp - 64) 32 b → m'.get? b = m.get? b)
    (hroom : SysV.RoomAt policy m' (sp - 64) 32) :
    SysV.RoomAt policy m' sp 96 := by
  intro k hk8 hkn hd
  obtain ⟨c, rfl⟩ := hd
  obtain ⟨h1, h2, h3⟩ := h (8 * c) (by omega) (by omega) (⟨c, rfl⟩ : 8 ∣ 8 * c)

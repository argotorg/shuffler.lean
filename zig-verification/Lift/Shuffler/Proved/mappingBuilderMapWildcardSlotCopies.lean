              have hst107' : blocksP.step .o107 { S6 with rcx := 12884901888 } = .ok (.goto .LBB27_9 U7) := by
                rw [hst107, if_pos hif]
              have hwf9 := aux.wildcardFrom_take b M' saw' x.r14.toBitVec hjlt' hcpos hkindne' ht
              refine Blocks.Returns.goto hst1' (Blocks.Returns.goto hst39' (Blocks.Returns.goto hst54'
                (Blocks.Returns.call hst73 hrel (Blocks.Returns.goto hst86' (Blocks.Returns.goto hst92'
                (Blocks.Returns.goto hst107' ?_))))))
              exact maploop U7 M' saw' true hin hrbx hrbp hr12 hr15 rfl rfl rfl hNONE hwf hwf9 ⟨m1, hm1⟩
            · have hif : ¬ (UInt64.ofBitVec (BitVec.zeroExtend 64 (if b.take then (1 : BitVec 8) else 0)) = 1) := by
                rw [if_neg ht]; decide
              have hst107' : blocksP.step .o107 { S6 with rcx := 12884901888 } = .ok (.goto .LBB27_5 U7) := by
                rw [hst107, if_neg hif]
              have hwf' : wildcardFrom b M' true (U7.r14.toBitVec + 1) = wildcardFrom b M saw 0 := by
                rw [← aux.wildcardFrom_notake b M' saw' x.r14.toBitVec hjlt' hcpos hkindne' ht, hwf]
              refine Blocks.Returns.goto hst1' (Blocks.Returns.goto hst39' (Blocks.Returns.goto hst54'
                (Blocks.Returns.call hst73 hrel (Blocks.Returns.goto hst86' (Blocks.Returns.goto hst92'
                (Blocks.Returns.goto hst107' ?_))))))
              exact cont U7 M' true hin hrbx hrbp hr12 hr15 rfl rfl hwf' ⟨m1, hm1⟩
    · -- the position is assigned: skip
      have hne : UInt64.ofBitVec (get M'.pos x.r14.toBitVec) ≠ 18446744073709551615 := by
        intro e
        exact hposn ((aux.ofBitVec_eq_allOnes _).mp e)
      have hst39' : blocksP.step .o39 x = .ok (.goto .LBB27_5 S3) := by
        rw [hst39, if_neg hne]
      have hsa : (!hasSourceAssigned M' x.r14.toBitVec) = false := by
        have h0 : hasSourceAssigned M' x.r14.toBitVec = true := by
          rw [hasSourceAssigned]
          exact bne_iff_ne.mpr hposn
        rw [h0]
        rfl
      have hc : ¬ ((!hasSourceAssigned M' x.r14.toBitVec && !isWildcardTarget b x.r14.toBitVec
          && decide (closestCopy b M' x.r14.toBitVec true ≠ NONE)) = true) := by
        intro h
        rw [Bool.and_eq_true, Bool.and_eq_true] at h
        obtain ⟨⟨h1, -⟩, -⟩ := h
        rw [hsa] at h1
        exact Bool.false_ne_true h1
      have hwf' : wildcardFrom b M' saw' (x.r14.toBitVec + 1) = wildcardFrom b M saw 0 := by
        rw [← aux.wildcardFrom_skip b M' saw' x.r14.toBitVec hjlt' hc, hwf]
      refine Blocks.Returns.goto hst1' (Blocks.Returns.goto hst39' ?_)
      exact cont S3 M' saw' hin hrbx hrbp hr12 hr15 rfl hmem hwf' ⟨m, hm⟩

/-- The map leaf of the statement: `mbMap` of the inputs. -/
theorem map_returns (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (saw : Bool) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (p t : BitVec 64)
    (hp : p.toNat < FlatShuffler.maxStackSize) (ht : t.toNat < FlatShuffler.maxStackSize)
    (x : mappingBuilderMap.In2p) (hpol : x.policy = pol) (hrdi : x.rdi.toBitVec = 0)
    (hrsi : x.rsi.toBitVec = p) (hrdx : x.rdx.toBitVec = t)
    (hheap : x.heap = objsP b M saw ++ frame) :
    mappingBuilderMap.blocksP.Returns noCall .entry ⟨x, x.rax, 0, x.heap⟩
      (if (mbMap b M p t).1 = .done then 0 else (x.rax &&& 18446744073709486080) ||| 1,
       objsP b (mbMap b M p t).2 saw ++ frame) := by
  rw [hheap]
  -- the loads of the leaf
  have hplen : p.toNat < b.dropped.toList.length := by rw [Vector.length_toList]; exact hp
  have hpdest : p.toNat < M.dest.toList.length := by rw [Vector.length_toList]; exact hp
  have htpos : t.toNat < M.pos.toList.length := by rw [Vector.length_toList]; exact ht
  have h32 : (objsP b M saw ++ frame).loadB 32 .W64 = .ok 20480 :=
    aux.objsP_load_32 b M saw frame pol m hh
  have h48 : (objsP b M saw ++ frame).loadB 48 .W64 = .ok 24576 :=
    aux.objsP_load_48 b M saw frame pol m hh
  have h16 : (objsP b M saw ++ frame).loadB 16 .W64 = .ok 12288 :=
    aux.objsP_load_16 b M saw frame pol m hh
  have hdp : (objsP b M saw ++ frame).loadB (20480 + p) .W8 = .ok (b.dropped.toList[p.toNat]) := by
    have := aux.objsP_load_dropped b M saw frame pol m hh p hp
    simpa using this
  have hdst : (objsP b M saw ++ frame).loadB (24576 + 8 * p) .W64 = .ok (M.dest.toList[p.toNat]) := by
    have := aux.objsP_load_dest b M saw frame pol m hh p hp
    simpa using this
  have hps : (objsP b M saw ++ frame).loadB (32768 + 8 * t) .W64 = .ok (M.pos.toList[t.toNat]) := by
    have := aux.objsP_load_pos b M saw frame pol m hh t ht
    simpa using this
  -- the conditions of the abstract map
  have hgd : FlatShuffler.Flat.get b.dropped p = b.dropped.toList[p.toNat] := aux.get_eq_toList _ _ hp
  have hgs : FlatShuffler.Flat.get M.dest p = M.dest.toList[p.toNat] := aux.get_eq_toList _ _ hp
  have hgp : FlatShuffler.Flat.get M.pos t = M.pos.toList[t.toNat] := aux.get_eq_toList _ _ ht
  have hmask : (1 : UInt64) &&& 65535 = 1 := by decide
  have hret : ∀ s : mappingBuilderMap.St mappingBuilderMap.In2p Heap,
      mappingBuilderMap.blocksP.step .LBB25_4 s = .ok (.ret (s.rax, s.mem)) := by
    intro s; simp only [mappingBuilderMap.blocksP]
  let H : Heap := objsP b M saw ++ frame
  let s1 : mappingBuilderMap.St mappingBuilderMap.In2p Heap :=
    { input := x, rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535),
      rcx := UInt64.ofBitVec 20480, mem := H }
  let s2 : mappingBuilderMap.St mappingBuilderMap.In2p Heap := { s1 with rcx := UInt64.ofBitVec 24576 }
  let s3 : mappingBuilderMap.St mappingBuilderMap.In2p Heap :=
    { s2 with rax := 0, mem := objsP b (M.bind p t) saw ++ frame }
  have ea1 : x.rdi.toBitVec + 32 = (32 : BitVec 64) := by rw [hrdi]; decide
  have ea2 : x.rdi.toBitVec + 48 = (48 : BitVec 64) := by rw [hrdi]; decide
  have eb1 : (20480 : BitVec 64) + x.rsi.toBitVec * 1 = 20480 + p := by rw [hrsi]; bv_omega
  have eb2 : (24576 : BitVec 64) + x.rsi.toBitVec * 8 = 24576 + 8 * p := by rw [hrsi]; bv_omega
  have eb3 : (24576 : BitVec 64) + x.rdx.toBitVec * 8 + 8192 = 32768 + 8 * t := by
    rw [hrdx]; bv_omega
  by_cases hA : UInt64.ofBitVec (BitVec.zeroExtend 64 (b.dropped.toList[p.toNat])) = 0
  · have hst1 : mappingBuilderMap.blocksP.step .entry ⟨x, x.rax, 0, H⟩
        = .ok (.goto .o14 s1) := by
      simp only [mappingBuilderMap.blocksP, s1, H]
      rw [ea1, h32]
      simp only
      rw [eb1, hdp]
      simp only
      rw [if_pos hA]
    by_cases hB : UInt64.ofBitVec (M.dest.toList[p.toNat]) = 18446744073709551615
    · have hst2 : mappingBuilderMap.blocksP.step .o14 s1 = .ok (.goto .o25 s2) := by
        simp only [mappingBuilderMap.blocksP, s1, s2, H]
        rw [ea2, h48]
        simp only
        rw [eb2, hdst]
        simp only
        rw [if_pos hB]
      by_cases hC : UInt64.ofBitVec (M.pos.toList[t.toNat]) = 18446744073709551615
      · -- the map succeeds
        have hA' : b.dropped.toList[p.toNat] = 0 :=
          (aux.zeroExtend_eq_zero_iff _).mp ((aux.ofBitVec_eq_zero _).mp hA)
        have hB' : M.dest.toList[p.toNat] = NONE := (aux.ofBitVec_eq_allOnes _).mp hB
        have hC' : M.pos.toList[t.toNat] = NONE := (aux.ofBitVec_eq_allOnes _).mp hC
        have hAg : get b.dropped p = 0 := by rw [hgd]; exact hA'
        have hBg : get M.dest p = NONE := by rw [hgs]; exact hB'
        have hCg : get M.pos t = NONE := by rw [hgp]; exact hC'
        have hmap : mbMap b M p t = (.done, M.bind p t) := by
          simp [mbMap, mappable, hAg, hBg, hCg]
        have hstore1 : (objsP b M saw ++ frame).storeB
            ((UInt64.ofBitVec (24576 : BitVec 64)).toBitVec + x.rsi.toBitVec * 8) .W64
            x.rdx.toBitVec
            = .ok (objsP b { M with dest := put M.dest p t } saw ++ frame) := by
          have e : (UInt64.ofBitVec (24576 : BitVec 64)).toBitVec + x.rsi.toBitVec * 8
              = 24576 + 8 * p := by
            show (24576 : BitVec 64) + x.rsi.toBitVec * 8 = 24576 + 8 * p
            rw [hrsi]; bv_omega
          rw [e, hrdx]
          exact aux.storeB_eq_store (aux.objsP_store_dest b M saw frame pol m hh p hp t)
        have hstore2 : (objsP b { M with dest := put M.dest p t } saw ++ frame).storeB
            ((UInt64.ofBitVec (24576 : BitVec 64)).toBitVec + x.rdx.toBitVec * 8 + 8192) .W64
            x.rsi.toBitVec
            = .ok (objsP b (M.bind p t) saw ++ frame) := by
          have e : (UInt64.ofBitVec (24576 : BitVec 64)).toBitVec + x.rdx.toBitVec * 8 + 8192
              = 32768 + 8 * t := by
            show (24576 : BitVec 64) + x.rdx.toBitVec * 8 + 8192 = 32768 + 8 * t
            rw [hrdx]; bv_omega
          rw [e, hrsi]
          exact aux.storeB_eq_store (aux.objsP_store_pos b M saw frame pol m hh p t ht)
        have hst3 : mappingBuilderMap.blocksP.step .o25 s2 = .ok (.goto .o36 s2) := by
          simp only [mappingBuilderMap.blocksP, s1, s2, H]
          rw [eb3, hps]
          simp only
          rw [if_pos hC]
        have hst4 : mappingBuilderMap.blocksP.step .o36 s2 = .ok (.goto .LBB25_4 s3) := by
          simp only [mappingBuilderMap.blocksP, s1, s2, s3, H]
          rw [hstore1]
          simp only
          rw [hstore2]
        refine Blocks.Returns.goto hst1 (Blocks.Returns.goto hst2
          (Blocks.Returns.goto hst3 (Blocks.Returns.goto hst4 ?_)))
        refine Blocks.Returns.ret ?_
        rw [hret, hmap]
        simp [s3, s2, s1, H]
      · -- the position is taken: exit at `.o25`
        have hA' : b.dropped.toList[p.toNat] = 0 :=
          (aux.zeroExtend_eq_zero_iff _).mp ((aux.ofBitVec_eq_zero _).mp hA)
        have hB' : M.dest.toList[p.toNat] = NONE := (aux.ofBitVec_eq_allOnes _).mp hB
        have hC' : M.pos.toList[t.toNat] ≠ NONE := fun h => hC ((aux.ofBitVec_eq_allOnes _).mpr h)
        have hAg : get b.dropped p = 0 := by rw [hgd]; exact hA'
        have hBg : get M.dest p = NONE := by rw [hgs]; exact hB'
        have hCg : get M.pos t ≠ NONE := by rw [hgp]; exact hC'
        have hmap : mbMap b M p t = (.assertionExit, M) := by
          simp [mbMap, mappable, hAg, hBg, hCg]
        have hst3 : mappingBuilderMap.blocksP.step .o25 s2 = .ok (.goto .LBB25_4 s2) := by
          simp only [mappingBuilderMap.blocksP, s1, s2, H]
          rw [eb3, hps]
          simp only
          rw [if_neg hC]
        refine Blocks.Returns.goto hst1 (Blocks.Returns.goto hst2 (Blocks.Returns.goto hst3 ?_))
        refine Blocks.Returns.ret ?_
        rw [hret, hmap]
        simp [s2, s1, H, hmask]
    · -- the destination is taken: exit at `.o14`
      have hA' : b.dropped.toList[p.toNat] = 0 :=
        (aux.zeroExtend_eq_zero_iff _).mp ((aux.ofBitVec_eq_zero _).mp hA)
      have hB' : M.dest.toList[p.toNat] ≠ NONE := fun h => hB ((aux.ofBitVec_eq_allOnes _).mpr h)
      have hAg : get b.dropped p = 0 := by rw [hgd]; exact hA'
      have hBg : get M.dest p ≠ NONE := by rw [hgs]; exact hB'
      have hmap : mbMap b M p t = (.assertionExit, M) := by
        simp [mbMap, mappable, hAg, hBg]
      have hst2 : mappingBuilderMap.blocksP.step .o14 s1 = .ok (.goto .LBB25_4 s2) := by
        simp only [mappingBuilderMap.blocksP, s1, s2, H]
        rw [ea2, h48]
        simp only
        rw [eb2, hdst]
        simp only
        rw [if_neg hB]
      refine Blocks.Returns.goto hst1 (Blocks.Returns.goto hst2 ?_)
      refine Blocks.Returns.ret ?_
      rw [hret, hmap]
      simp [s2, s1, H, hmask]
  · -- the byte is not zero: exit at `.entry`
    have hA' : b.dropped.toList[p.toNat] ≠ 0 :=
      fun h => hA ((aux.ofBitVec_eq_zero _).mpr ((aux.zeroExtend_eq_zero_iff _).mpr h))
    have hAg : get b.dropped p ≠ 0 := by rw [hgd]; exact hA'
    have hb : (get b.dropped p == (0 : BitVec 8)) = false := beq_eq_false_iff_ne.mpr hAg
    have hmapp : mappable b M p = false := by
      rw [mappable, hb]; rfl
    have hmap : mbMap b M p t = (.assertionExit, M) := by
      simp [mbMap, hmapp]
    have hst1 : mappingBuilderMap.blocksP.step .entry ⟨x, x.rax, 0, H⟩
        = .ok (.goto .LBB25_4 s1) := by
      simp only [mappingBuilderMap.blocksP, s1, H]
      rw [ea1, h32]
      simp only
      rw [eb1, hdp]
      simp only
      rw [if_neg hA]
    refine Blocks.Returns.goto hst1 ?_
    refine Blocks.Returns.ret ?_
    rw [hret, hmap]
    simp [s1, H, hmask]

/-- The closest-copy leaf of the statement: `closestCopy` of the inputs. -/
theorem closest_returns (frame : Heap) (b : FlatShuffler.Flat.Builder)
    (M : FlatShuffler.Flat.Mapping) (saw : Bool) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (t : BitVec 64)
    (ht : t.toNat < FlatShuffler.maxStackSize)
    (hsrc : b.sourceSize.toNat ≤ 1024)
    (x : mappingBuilderClosestCopy.In2p) (hrdi : x.rdi.toBitVec = 0)
    (hrsi : x.rsi.toBitVec = t) (hheap : x.heap = objsP b M saw ++ frame)
    (hrdx : x.rdx.toUInt8.toUInt64 ≠ 0) :
    mappingBuilderClosestCopy.blocksP.Returns noCall .entry ⟨x, 0, x.rbx, 0, x.rbp, 0, 0, 0, 0, x.r14, x.r15, x.heap⟩
      (UInt64.ofBitVec (closestCopy b M t true)) := by
  rw [hheap]
  have hload8 : (objsP b M saw ++ frame).loadB 8 .W64 = .ok b.sourceSize :=
    aux.objsP_load_8 b M saw frame pol m hh
  let S1 : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap :=
    { input := x, rax := 18446744073709551615, rbx := x.rbx,
      rcx := UInt64.ofBitVec b.sourceSize, rbp := x.rbp, r8 := 0 - x.rsi, r9 := 0,
      r10 := 4294967296, r11 := x.rsi, r14 := x.r14, r15 := x.r15,
      mem := objsP b M saw ++ frame }
  have e0 : x.rdi.toBitVec + 8 = (8 : BitVec 64) := by rw [hrdi]; decide
  have hst1 : mappingBuilderClosestCopy.blocksP.step .entry
      ⟨x, 0, x.rbx, 0, x.rbp, 0, 0, 0, 0, x.r14, x.r15, objsP b M saw ++ frame⟩
      = .ok (.goto .LBB29_1 S1) := by
    simp only [mappingBuilderClosestCopy.blocksP, S1]
    rw [e0, hload8]
  refine Blocks.Returns.goto hst1 ?_
  let I : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap → Prop :=
    fun s => s.input = x ∧ s.rcx = UInt64.ofBitVec b.sourceSize ∧ s.r8 = 0 - x.rsi ∧
      s.r10 = 4294967296 ∧ s.r11 = x.rsi - s.r9 ∧ s.mem = objsP b M saw ++ frame ∧
      s.r9.toBitVec.toNat ≤ b.sourceSize.toNat ∧
      closestFrom b M t true s.r9.toBitVec s.rax.toBitVec = closestCopy b M t true
  refine Blocks.Returns.loop I (fun s => b.sourceSize.toNat - s.r9.toNat)
    (fun _ => UInt64.ofBitVec (closestCopy b M t true)) ?_ S1 ?_
  · intro y hy ih
    simp only [I] at hy
    obtain ⟨hin, hrcx, hr8, hr10, hr11, hmem, hbound, hcf⟩ := hy
    by_cases hlt : y.r9.toBitVec.toNat < b.sourceSize.toNat
    · -- one iteration of the loop: `i < sourceSize`
      have hi1024 : y.r9.toBitVec.toNat < 1024 := by omega
      have hlt' : y.r9.toBitVec < b.sourceSize := by rw [BitVec.lt_def]; exact hlt
      have h0 : (objsP b M saw ++ frame).loadB 0 .W64 = .ok 4096 :=
        aux.objsP_load_0 b M saw frame pol m hh
      have h16 : (objsP b M saw ++ frame).loadB ((0 : BitVec 64) + 16) .W64 = .ok 12288 := by
        have e : (0 : BitVec 64) + 16 = 16 := by decide
        rw [e]
        exact aux.objsP_load_16 b M saw frame pol m hh
      have h32 : (objsP b M saw ++ frame).loadB ((0 : BitVec 64) + 32) .W64 = .ok 20480 := by
        have e : (0 : BitVec 64) + 32 = 32 := by decide
        rw [e]
        exact aux.objsP_load_32 b M saw frame pol m hh
      have h48 : (objsP b M saw ++ frame).loadB ((0 : BitVec 64) + 48) .W64 = .ok 24576 := by
        have e : (0 : BitVec 64) + 48 = 48 := by decide
        rw [e]
        exact aux.objsP_load_48 b M saw frame pol m hh
      have h24 : (objsP b M saw ++ frame).loadB ((0 : BitVec 64) + 24) .W64 = .ok b.targetSize := by
        have e : (0 : BitVec 64) + 24 = 24 := by decide
        rw [e]
        exact aux.objsP_load_24 b M saw frame pol m hh
      have htw : (objsP b M saw ++ frame).loadB (12288 + t * 8) .W64
          = .ok (Layout.slotWord (b.target.toList.getD t.toNat default) 0) := by
        have h := aux.objsP_load_tgt b M saw frame pol m hh t ht
        rw [show 12288 + t * 8 = 12288 + 8 * t from by rw [BitVec.mul_comm]]
        exact h
      have hsw : (objsP b M saw ++ frame).loadB (4096 + y.r9.toBitVec * 8) .W64
          = .ok (Layout.slotWord (b.source.toList.getD y.r9.toBitVec.toNat default) 0) := by
        have h := aux.objsP_load_src b M saw frame pol m hh y.r9.toBitVec hi1024
        rw [show 4096 + y.r9.toBitVec * 8 = 4096 + 8 * y.r9.toBitVec from by rw [BitVec.mul_comm]]
        exact h
      have hdb : (objsP b M saw ++ frame).loadB (20480 + y.r9.toBitVec * 1) .W8
          = .ok (b.dropped.toList[y.r9.toBitVec.toNat]'(by rw [Vector.length_toList]; exact hi1024)) := by
        have e : 20480 + y.r9.toBitVec * 1 = 20480 + y.r9.toBitVec := by bv_omega
        rw [e]
        exact aux.objsP_load_dropped b M saw frame pol m hh y.r9.toBitVec hi1024
      have hdw : (objsP b M saw ++ frame).loadB (24576 + y.r9.toBitVec * 8) .W64
          = .ok (M.dest.toList[y.r9.toBitVec.toNat]'(by rw [Vector.length_toList]; exact hi1024)) := by
        have e : 24576 + y.r9.toBitVec * 8 = 24576 + 8 * y.r9.toBitVec := by rw [BitVec.mul_comm]
        rw [e]
        exact aux.objsP_load_dest b M saw frame pol m hh y.r9.toBitVec hi1024
      have hkb : (objsP b M saw ++ frame).loadB (12288 + y.r9.toBitVec * 8 + 4) .W8
          = .ok ((Layout.slotWord (b.target.toList.getD y.r9.toBitVec.toNat default) 0 >>> 32).setWidth 8) := by
        have e : 12288 + y.r9.toBitVec * 8 + 4 = 12288 + 8 * y.r9.toBitVec + 4 := by
          rw [BitVec.mul_comm]
        rw [e]
        exact aux.loadB_byte4 b M saw frame pol m hh y.r9.toBitVec hi1024
      have hne : y.rcx ≠ y.r9 := by
        intro he
        rw [hrcx] at he
        have h1 : y.r9.toBitVec = b.sourceSize := by rw [← he]
        rw [h1] at hlt
        omega
      have hst1 : mappingBuilderClosestCopy.blocksP.step .LBB29_1 y
          = .ok (.goto .o51 y) := by
        simp only [mappingBuilderClosestCopy.blocksP]
        rw [if_neg hne]
      -- the load of the source and the target slot words
      let T1 : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap :=
        { y with rbx := UInt64.ofBitVec 12288, r14 := UInt64.ofBitVec 4096, r15 := (UInt64.ofBitVec (Layout.slotWord (b.target.toList.getD t.toNat default) 0) ^^^ UInt64.ofBitVec (Layout.slotWord (b.source.toList.getD y.r9.toBitVec.toNat default) 0)) <<< (16 : UInt64) }
      have hltlen : t.toNat < b.target.toList.length := by
        rw [Vector.length_toList]; exact ht
      have hslen : y.r9.toBitVec.toNat < b.source.toList.length := by
        rw [Vector.length_toList]; exact hi1024
      have hgt : get b.target t = b.target.toList.getD t.toNat default := by
        rw [aux.get_eq_toList b.target t ht,
          aux.getD_eq_getElem b.target.toList t.toNat hltlen]
      have hgs : get b.source y.r9.toBitVec
          = b.source.toList.getD y.r9.toBitVec.toNat default := by
        rw [aux.get_eq_toList b.source y.r9.toBitVec hi1024,
          aux.getD_eq_getElem b.source.toList y.r9.toBitVec.toNat hslen]
      -- the finishing step: `.LBB29_4` and the induction hypothesis
      have finish : ∀ (Z : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap),
          Z.input = x → Z.rcx = UInt64.ofBitVec b.sourceSize → Z.r8 = 0 - x.rsi →

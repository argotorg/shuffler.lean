/-- The closest copy's L2 run keeps each byte outside its 32-byte room and keeps the room. -/
theorem closest_l2_frame {l : mappingBuilderClosestCopy.Lbl}
    {s : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2 DataMem}
    {r : UInt64 × DataMem}
    (h : mappingBuilderClosestCopy.blocks.Returns noCall l s r) :
    (∀ b, ¬ SysV.Below s.input.sp 32 b → r.2.get? b = s.mem.get? b) ∧
    (SysV.RoomAt s.input.policy s.mem s.input.sp 32 →
      SysV.RoomAt s.input.policy r.2 s.input.sp 32) := by
  induction h with
  | ret hstep => exact closest_step_ret hstep
  | goto hstep _ ih =>
    obtain ⟨hin, hf, hroom⟩ := closest_step_goto hstep
    obtain ⟨ihf, ihroom⟩ := ih
    refine ⟨fun b hb => ?_, fun hr => ?_⟩
    · rw [ihf b (by rw [hin]; exact hb), hf b hb]
    · have h4 := hroom hr
      have h3 := ihroom (by rw [hin]; exact h4)
      rw [hin] at h3
      exact h3
  | call hstep hc _ => exact Empty.elim (by assumption)

/-- The relation of the states of the two block models, with the input states and the
permission of the L2⁺ heap. -/
def SimR (a : In2p) (b : In2) (x : St In2p Heap) (y : St In2 DataMem) : Prop :=
  SimSt x y ∧ x.input = a ∧ y.input = b ∧ Heap.Permits y.input.policy x.mem ∧
    (∀ c, x.mem.Owned c → x.input.heap.Owned c)

/-- The relation of the inputs of each callee. -/

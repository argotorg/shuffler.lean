def hdr64 (a : BitVec 64) (v : BitVec 64) : Obj := ⟨a, false, [⟨.W64, v⟩]⟩

def hdr8 (a : BitVec 64) (v : BitVec 8) : Obj := ⟨a, false, [⟨.W8, v⟩]⟩

def sawObj (z : BitVec 8) : Obj := ⟨56, true, [⟨.W8, z⟩]⟩

def srcObj (b : FlatShuffler.Flat.Builder) : Obj :=
  Obj.words 0x1000 false .W64
    ((List.range 1024).map fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i default) 0)

def tgtObj (b : FlatShuffler.Flat.Builder) : Obj :=
  Obj.words 0x3000 false .W64
    ((List.range 1024).map fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i default) 0)

def dropObj (b : FlatShuffler.Flat.Builder) : Obj := Obj.words 0x5000 false .W8 b.dropped.toList

def destObj (xs : List (BitVec 64)) : Obj := Obj.words 0x6000 true .W64 xs

def posObj (ys : List (BitVec 64)) : Obj := Obj.words 0x8000 true .W64 ys

def ownHeap (b : FlatShuffler.Flat.Builder) (xs ys : List (BitVec 64)) (z : BitVec 8) : Heap :=
  [hdr64 0 0x1000, hdr64 8 b.sourceSize, hdr64 16 0x3000, hdr64 24 b.targetSize,
   hdr64 32 0x5000, hdr8 40 (if b.take then 1 else 0), hdr64 48 0x6000,
   sawObj z, srcObj b, tgtObj b, dropObj b, destObj xs, posObj ys]

theorem toObj_encode64 (p : BitVec 64) (v : BitVec 64) :
    Lift.Sem.Bridge.toObj (⟨p, Lift.Trusted.Encode.encode v, false⟩ : Lift.Trusted.Object) =
      hdr64 p v := by
  simp [Lift.Trusted.Encode.encode, hdr64, Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell]

theorem toObj_encode_bytes {n : Nat} (p : BitVec 64) (v : Vector (BitVec 8) n) (wr : Bool) :
    Lift.Sem.Bridge.toObj (⟨p, Lift.Trusted.Encode.encode v, wr⟩ : Lift.Trusted.Object) =
      Obj.words p wr .W8 v.toList := by
  show (⟨p, wr, (Lift.Trusted.Encode.encode v).map Lift.Sem.Bridge.toCell⟩ : Obj)
      = Obj.words p wr .W8 v.toList
  rw [map_toCell_encode_bytes]
  rfl

theorem toObj_encode_words {n : Nat} (p : BitVec 64) (v : Vector (BitVec 64) n) (wr : Bool) :
    Lift.Sem.Bridge.toObj (⟨p, Lift.Trusted.Encode.encode v, wr⟩ : Lift.Trusted.Object) =
      Obj.words p wr .W64 v.toList := by
  show (⟨p, wr, (Lift.Trusted.Encode.encode v).map Lift.Sem.Bridge.toCell⟩ : Obj)

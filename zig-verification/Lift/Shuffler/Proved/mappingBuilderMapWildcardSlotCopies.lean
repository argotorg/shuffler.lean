end call_shape.skel_proof
theorem call_shape : call_shape.skel_statement := @call_shape.skel_proof.call_shape
theorem call_summary : callSummary := by
  intro frame b M saw a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 frame b M saw () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨⟨r, hrel, hmap⟩, call_shape a q hq, call_frame frame b M saw a q hs hq⟩⟩

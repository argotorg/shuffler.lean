/-- The dropped byte at the offset `i`. -/
theorem objsP_load_dropped (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (i : BitVec 64) (hi : i.toNat < FlatShuffler.maxStackSize) :
    (objsP b M saw ++ frame).loadB (20480 + i) .W8 = .ok (b.dropped.toList[i.toNat]'(by simpa using hi)) := by
  have ho : (⟨0x5000, Lift.Trusted.Encode.encode b.dropped, false⟩ : Object) ∈ objects b M saw envOf := by
    simp [objects, envOf]
  have hm : Obj.words 20480 false .W8 b.dropped.toList ∈ objsP b M saw := by
    rw [← toObj_words8]
    exact mem_objsP b M saw _ ho
  have hl := loadB_words8 hh (List.mem_append_left _ hm) (by simpa using hi)

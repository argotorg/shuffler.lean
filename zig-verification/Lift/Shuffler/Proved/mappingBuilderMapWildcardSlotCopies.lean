/-- The source slot at the offset `i`. -/
theorem objsP_load_src (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (i : BitVec 64) (hi : i.toNat < 1024) :
    (objsP b M saw ++ frame).loadB (4096 + 8 * i) .W64 =
      .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD i.toNat default) 0) := by
  have ho : (⟨0x1000, (List.range 1024).map fun k =>
      (⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD k default) 0⟩ : Field),
      false⟩ : Object) ∈ objects b M saw envOf := by simp [objects, envOf]
  have hm : Obj.words 4096 false .W64 ((List.range 1024).map fun k =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD k default) 0) ∈ objsP b M saw := by
    simpa [toObj_array64] using mem_objsP b M saw _ ho
  have hl := loadB_words64 hh (List.mem_append_left _ hm) (by simpa using hi)
  simpa [List.getElem_map, List.getElem_range] using hl

/-- The target slot at the offset `i`. -/

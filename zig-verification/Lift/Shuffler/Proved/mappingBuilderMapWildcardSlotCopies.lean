    (hh : Heap.Holds pol (objsP b M saw ++ frame) m) (i : BitVec 64) (hi : i.toNat < 1024) :
    (objsP b M saw ++ frame).loadB (12288 + 8 * i) .W64 =
      .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD i.toNat default) 0) := by
  have ho : (⟨0x3000, (List.range 1024).map fun k =>
      (⟨.W64, Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD k default) 0⟩ : Field),
      false⟩ : Object) ∈ objects b M saw envOf := by simp [objects, envOf]
  have hm : Obj.words 12288 false .W64 ((List.range 1024).map fun k =>
      Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD k default) 0) ∈ objsP b M saw := by
    simpa [toObj_array64] using mem_objsP b M saw _ ho
  have hl := loadB_words64 hh (List.mem_append_left _ hm) (by simpa using hi)

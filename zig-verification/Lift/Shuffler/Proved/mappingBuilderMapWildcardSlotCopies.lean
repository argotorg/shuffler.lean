  · have e' : (sp - 64) - BitVec.ofNat 64 32 = sp - BitVec.ofNat 64 96 := by bv_omega
    rw [Mem.loadInt_congr (fun i hi => hframe _ (by
      unfold SysV.Below
      rw [e']
      have hc8 : 8 * c ≤ 64 := by omega
      bv_omega))]

def postP (a : In2p) (r : UInt64 × Heap) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ r.2.Holds a.policy t.data.dmem ∧ ∀ b, ¬ a.heap.Owned b → ¬ SysV.Below s.data.regs.rsp.toBitVec 96 b → t.data.dmem.get? b = s.data.dmem.get? b

def l2p : Model In2p (UInt64 × Heap) where
  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderMapWildcardSlotCopiesPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rbx = a.rbx ∧ s.data.regs.rdi = a.rdi ∧ s.data.regs.rbp = a.rbp ∧ s.data.regs.r12 = a.r12 ∧ s.data.regs.r13 = a.r13 ∧ s.data.regs.r14 = a.r14 ∧ s.data.regs.r15 = a.r15 ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ (∀ b, SysV.Below s.data.regs.rsp.toBitVec 96 b → ¬ Covered a.heap b) ∧ SysV.StackRoom policy s 96 ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocksP.Returns CalP.rel .entry (initP a) r
  post := postP


def SimIn (a : In2p) (b : In2) : Prop := a.policy = b.policy ∧ a.rax = b.rax ∧ a.rbx = b.rbx ∧ a.rdi = b.rdi ∧ a.rbp = b.rbp ∧ a.r12 = b.r12 ∧ a.r13 = b.r13 ∧ a.r14 = b.r14 ∧ a.r15 = b.r15 ∧ a.heap.Holds b.policy b.mem ∧ (∀ c, Private b.sp c → ¬ Covered a.heap c) ∧ (∀ c, SysV.Below b.sp 96 c → ¬ Covered a.heap c) ∧ SysV.RoomAt b.policy b.mem b.sp 96 ∧ a.sp = b.sp

def SimSt (x : St In2p Heap) (y : St In2 DataMem) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rbx = y.rbx ∧ x.rcx = y.rcx ∧ x.rdx = y.rdx ∧ x.rsi = y.rsi ∧ x.rdi = y.rdi ∧ x.rbp = y.rbp ∧ x.r12 = y.r12 ∧ x.r13 = y.r13 ∧ x.r14 = y.r14 ∧ x.r15 = y.r15 ∧ x.mem.Holds y.input.policy y.mem ∧ (∀ b, ¬ x.input.heap.Owned b → ¬ SysV.Below y.input.sp 96 b → y.mem.get? b = y.input.mem.get? b) ∧ (∀ b, SysV.Below y.input.sp 96 b → ¬ Covered x.mem b) ∧ SysV.RoomAt y.input.policy y.mem y.input.sp 96

def SimOut (x : In2p) (y : In2) (r : UInt64 × Heap) (r' : UInt64 × DataMem) : Prop := r.1 = r'.1 ∧ r.2.Holds x.policy r'.2 ∧ ∀ b, ¬ x.heap.Owned b → ¬ SysV.Below y.sp 96 b → r'.2.get? b = y.mem.get? b

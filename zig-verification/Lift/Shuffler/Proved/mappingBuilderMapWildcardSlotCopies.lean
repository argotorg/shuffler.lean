theorem objsP_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (saw : Bool) :
    objsP b M saw = ownHeap b M.dest.toList M.pos.toList (if saw then 1 else 0) := by
  unfold objsP ownHeap hdr64 hdr8 sawObj srcObj tgtObj dropObj destObj posObj
  simp only [Lift.Shuffler.Internal.Proposed.MapWildcardSlotCopiesStatement.objects,
    List.map_cons, List.map_nil, toObj_encode64, toObj_encode_bytes, toObj_encode_words,
    Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, Obj.words, List.map_map,
    map_toCell_range64, map_toCell_range64t, map_toCell_encode_words, map_toCell_encode_bytes]

theorem Obj.not_apart_self {O : Obj} (h : 0 < O.size) : ¬ O.Apart O := by
  unfold Obj.Apart; omega

theorem frame_ne_of_holds_append {policy : CpuPolicy} {m : DataMem} {own frame : Heap}
    (hholds : (own ++ frame).Holds policy m) {O : Obj} (hO : O ∈ own) (hOw : O.writable)
    (hOsize : 0 < O.size) {p : Obj} (hp : p ∈ frame) : p ≠ O := by
  intro hpo
  subst hpo
  obtain ⟨i, hi, hie⟩ := List.getElem_of_mem hO
  obtain ⟨j, hj, hje⟩ := List.getElem_of_mem hp
  have hlen : i < (own ++ frame).length := by simp; omega
  have hlen2 : own.length + j < (own ++ frame).length := by simp; omega
  have hR := List.pairwise_iff_getElem.mp hholds.apart i (own.length + j) hlen hlen2 (by omega)
  rw [List.getElem_append_left hi] at hR
  rw [List.getElem_append_right (by omega)] at hR
  simp only [Nat.add_sub_cancel_left] at hR
  rw [hie, hje] at hR
  exact absurd (hR (Or.inl hOw)) (Obj.not_apart_self hOsize)

theorem hdr64_load {policy : CpuPolicy} {m : DataMem} {h : Heap} {a v : BitVec 64}
    (hh : h.Holds policy m) (ho : hdr64 a v ∈ h) : h.load a .W64 = .ok v := by
  have hx : (0, (⟨.W64, v⟩ : Cell)) ∈ Lift.Sem.offsets 0 (hdr64 a v).cells := by simp [hdr64, Lift.Sem.offsets]
  have := Heap.load_of_mem hh ho hx
  simpa [hdr64] using this

theorem hdr8_load {policy : CpuPolicy} {m : DataMem} {h : Heap} {a : BitVec 64} {v : BitVec 8}
    (hh : h.Holds policy m) (ho : hdr8 a v ∈ h) : h.load a .W8 = .ok v := by
  have hx : (0, (⟨.W8, v⟩ : Cell)) ∈ Lift.Sem.offsets 0 (hdr8 a v).cells := by simp [hdr8, Lift.Sem.offsets]
  have := Heap.load_of_mem hh ho hx
  simpa [hdr8] using this

theorem size_words64 (p : BitVec 64) (wr : Bool) (xs : List (BitVec 64)) :
    (Obj.words p wr .W64 xs).size = 8 * xs.length := by
  have h1 : (xs.map (Cell.mk .W64)).map (fun c => c.w.bytes) = xs.map (fun _ => 8) := by
    rw [List.map_map]; rfl
  have h2 : ∀ l : List (BitVec 64), (l.map (fun _ => 8)).sum = 8 * l.length := by
    intro l
    induction l with
    | nil => rfl
    | cons a t ih => simp only [List.map_cons, List.sum_cons, List.length_cons, ih]; omega
  simp only [Obj.words, Obj.size, h1, h2]

/-- The invariant of the caller's heap: a heap `hc` of the caller's objects, then the frame. -/
structure HInv (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (hc h : Heap) : Prop where
  eq : h.Perm (hc ++ frame)
  holds : ∃ m, h.Holds policy m
  h8 : hdr64 8 b.sourceSize ∈ hc
  h24 : hdr64 24 b.targetSize ∈ hc
  h16 : hdr64 16 0x3000 ∈ hc
  h32 : hdr64 32 0x5000 ∈ hc
  h48 : hdr64 48 0x6000 ∈ hc
  take40 : hdr8 40 (if b.take then 1 else 0) ∈ hc
  saw : ∃ z : BitVec 8, sawObj z ∈ hc
  dest : ∃ ds : List (BitVec 64), destObj ds ∈ hc ∧ ds.length = 1024
  pos : ∃ ps : List (BitVec 64), posObj ps ∈ hc ∧ ps.length = 1024

theorem hdr64_ne_sawObj (a v : BitVec 64) (z : BitVec 8) : hdr64 a v ≠ sawObj z := by

theorem total : ∀ (dest : Vector (BitVec 64) 1024) (i : Nat) (p : BitVec 64), Lift.Pilot.IsRetainedSpec.C dest i → ∃ y, Lift.Pilot.IsRetainedSpec.run dest i = some y := by intros; apply Lift.Pilot.IsRetainedSpec.total; assumption
theorem decompiles : ∀ (p : BitVec 64) (frame : Heap) (dest : Vector (BitVec 64) 1024) (i : Nat), Decompiles Lift.Shuffler.L1.step (l3 p frame dest i) := by intros; apply Decompiles.above (decompiles_l2.above above_l2p); apply above_l3
theorem decompiles_code : ∀ (p : BitVec 64) (frame : Heap) (dest : Vector (BitVec 64) 1024) (i : Nat), Decompiles (fun s => Lift.Shuffler.Code.code.step s .done) (l3 p frame dest i) := by intros; exact (Sites.decompiles_l1Spec_iff Lift.Shuffler.Code.code Lift.Shuffler.L1.step Lift.Shuffler.L1.spec _).mp (by apply decompiles)
theorem contract : ∀ (p : BitVec 64) (frame : Heap) (dest : Vector (BitVec 64) 1024) (i : Nat) (policy : CpuPolicy) (s : MachineState), (l3 p frame dest i).rep policy () s → Lift.Pilot.IsRetainedSpec.C dest i → Reaches (fun s => Lift.Shuffler.Code.code.step s .done) policy (fun t => ∃ y, (l3 p frame dest i).post () y s t ∧ Lift.Pilot.IsRetainedSpec.run dest i = some y) s := by intro p; intros; rename_i dest i _ _ _ _; apply Decompiles.transfer _ (fun (_ : Unit) => Lift.Pilot.IsRetainedSpec.C dest i) (fun _ y => Lift.Pilot.IsRetainedSpec.run dest i = some y) (fun _ h => total dest i p h) (fun _ _ _ h => h) <;> first | assumption | apply decompiles_code
theorem final : Lift.Shuffler.Internal.IsRetainedStatement.IsRetainedStatement := by
  intro dest i hC p policy ra s he
  revert i
  refine Lift.Sem.Final.of_bounded ?bounded ?cases
  case cases =>
    intro i hC he
    have hsz := Lift.Sem.Final.sizes he.has
    try simp only [Lift.Shuffler.Internal.IsRetainedStatement.objects, List.forall_mem_cons, Lift.Sem.Final.size_words, List.length_map] at hsz
    clear he
    try simp only [Lift.Pilot.IsRetainedSpec.C] at hC
    split_cases
    all_goals first
      | (left; omega)
      | (right; subst_vars; refine ⟨?_, ?_, ?_⟩
         · first | assumption | (simp [Lift.Pilot.IsRetainedSpec.C]; done)
         · intro hh; rw [Lift.Sem.Final.ofNat_mod]; exact hh
         · intro hh; refine Lift.Sem.Final.congr_post ?_ hh; funext _ _ _; simp [Lift.Pilot.IsRetainedSpec.C, Lift.Shuffler.Internal.IsRetainedStatement.post, Lift.Pilot.IsRetainedSpec.run, Lift.Sem.Final.ofNat_mod_lit])
  case bounded =>
    intro i hlt_i hC he
    have hrep : (l3 p [] dest i).rep policy () s :=
      ⟨Lift.Sem.Final.holds he, hC, Lift.Sem.Bridge.Fn.Entry.sysV (lo := Lift.Shuffler.shufflePC) (hi := Lift.Shuffler.shufflerEndPC) he (by decide +kernel) (by decide +kernel), Lift.Sem.Final.bv64 he.inRegs 0 rfl, Lift.Sem.Final.nat64 he.inRegs 1 rfl (by first | omega | (simp only [Lift.Pilot.IsRetainedSpec.C] at hC; omega) | (apply Lift.Sem.Final.length_lt_of_has_words; apply he.has; simp only [Lift.Shuffler.Internal.IsRetainedStatement.objects]; exact List.mem_cons_self; done) | (apply Lift.Sem.Final.length_lt_of_has_words; apply he.has; simp only [Lift.Shuffler.Internal.IsRetainedStatement.objects]; exact List.mem_cons_of_mem _ List.mem_cons_self; done))⟩
    refine (contract p [] dest i policy s hrep hC).mono ?_
    rintro t ⟨y, ⟨hexit, hmem, hrel⟩, hrun⟩
    refine Lift.Sem.Final.ret he 0 rfl hexit (fun _ _ _ => by rw [hmem]) ?_
    simp only [Lift.Shuffler.Internal.IsRetainedStatement.post, Lift.Shuffler.Internal.IsRetainedStatement.isRetained]
    first | exact ⟨y, hrun, hrel⟩ | (refine ⟨y, hrun, ?_⟩; simp [Lift.Trusted.Encode.encode, Width.bits, hrel]; done) | (refine ⟨y, hrun, ?_⟩; simpa [Width.bits] using hrel; done)
theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : UInt64) (q : UInt64) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    callState (fun (r : UInt64) (q : UInt64) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l x z n hs ht
      rcases hs with ⟨hinput, h_rax, htrue⟩
      cases l <;> simp only [blocksP, callInput, hinput, h_rax] at ht
      all_goals repeat' split at ht
      all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
      all_goals subst n
      all_goals simp_all [skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
      all_goals refine ⟨_, _, ⟨rfl, rfl⟩, rfl, ?_⟩
      all_goals intros; simp_all [callState, callInput])
    hr (by simp [callState, initP, skel_call.initP, callInput])
def call_bridge_rev.skel_statement : Prop := Refines (fun a b => b = callInput a) (fun _ _ (q : UInt64) (r : UInt64) => r = q) skel_call.l2p.returns l2p.returns
namespace call_bridge_rev.skel_proof
skel_proof_aliases call_bridge_rev.skel_proof excluding [bridgeState, BridgeHiNext, BridgeLoNext, bridgeNext, bridgeRes, bridgeState_related, bridge_related_eq, bridgeNext_related, bridgeNext_related_rev, bridge_goto, bridge_step_eq_entry, bridge_step_eq, call_bridge_rev]
def bridgeState (z : St skel_call.In2p) : St In2p := { input := callInput z.input, rax := z.rax }

abbrev BridgeHiNext := Next Lbl (St In2p) UInt64 Empty Empty.elim Empty.elim
abbrev BridgeLoNext := Next Lbl (St skel_call.In2p) UInt64 Empty Empty.elim Empty.elim

def bridgeNext : BridgeLoNext → BridgeHiNext
  | .goto l z => .goto l (bridgeState z)
  | .ret r => .ret r
  | .call f x k => .call f x (fun r => ((k r).1, bridgeState (k r).2))

def bridgeRes : Res BridgeLoNext → Res BridgeHiNext
  | .ok n => .ok (bridgeNext n)
  | .stuck why => .stuck why
  | .noFuel => .noFuel

theorem bridgeState_related (z : St skel_call.In2p) : callState (bridgeState z) z := by
  simp [callState, bridgeState]

theorem bridge_related_eq (x : St In2p) (z : St skel_call.In2p)
    (h : callState x z) : x = bridgeState z := by
  cases x
  cases z
  simp_all [callState, bridgeState, callInput]

theorem bridgeNext_related (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      callState (fun (r : UInt64) (q : UInt64) => r = q) (bridgeNext n) (.ok n) := by
  cases n with
  | goto l z => exact ⟨z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, k, rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridgeNext_related_rev (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q) n (.ok (bridgeNext n)) := by
  cases n with
  | goto l z => exact ⟨bridgeState z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, (fun r => ((k r).1, bridgeState (k r).2)), rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridge_goto {l : Lbl} {input : skel_call.In2p} {rax : UInt64} :
    (Res.ok (Next.goto l { input := callInput input, rax := rax }) : Res BridgeHiNext) =
      bridgeRes (.ok (.goto l { input := input, rax := rax })) := rfl

set_option maxHeartbeats 400000 in
theorem bridge_step_eq_entry (z : St skel_call.In2p) :
    blocksP.step .entry (bridgeState z) = bridgeRes (skel_call.blocksP.step .entry z) := by
  simp only [blocksP, skel_call.blocksP, bridgeState, callInput]
  all_goals repeat' split
  all_goals first | exact bridge_goto | rfl

theorem bridge_step_eq (l : Lbl) (z : St skel_call.In2p) :
    blocksP.step l (bridgeState z) = bridgeRes (skel_call.blocksP.step l z) := by
  cases l with
  | entry => exact bridge_step_eq_entry z
theorem call_bridge_rev : Refines (fun a b => b = callInput a) (fun _ _ (q : UInt64) (r : UInt64) => r = q) skel_call.l2p.returns l2p.returns := by
  intro a b r hab hr
  subst b
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l z x n hs ht
      have hx := bridge_related_eq x z hs
      subst x
      rw [bridge_step_eq, ht]
      exact bridgeNext_related_rev n)
    hr (by simp [callState, initP, skel_call.initP, callInput])
end call_bridge_rev.skel_proof
theorem call_bridge_rev : call_bridge_rev.skel_statement := @call_bridge_rev.skel_proof.call_bridge_rev
theorem call_summary : callSummary := by
  intro p frame dest i a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 p frame dest i () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨r, hrel, hmap⟩⟩
end skel_semantic
end Skel.Gen.Level3.Shuffler.plannerIsRetained

    (⟨self + 48, false, [⟨Width.W64, mp⟩]⟩ : Obj) from rfl] at hm
  exact hm

/-- The table `destination_of` is an object of the heap of the callee. -/
theorem mem_dest (self sp tp dp mp : BitVec 64) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024) :
    Obj.words mp true .W64 dest.toList ∈ objsP self sp tp dp mp src tgt dropped dest pos := by
  unfold objsP
  have h : Lift.Shuffler.Internal.MapStatement.destArr dest mp ∈
      Lift.Shuffler.Internal.MapInPlaceStatement.objects src tgt dropped dest pos self sp tp dp mp := by
    simp [Lift.Shuffler.Internal.MapInPlaceStatement.objects]
  have hm := List.mem_map_of_mem (f := Lift.Sem.Bridge.toObj) h
  rw [show Lift.Sem.Bridge.toObj (Lift.Shuffler.Internal.MapStatement.destArr dest mp) =
    Obj.words mp true .W64 dest.toList from toObj_words64' mp dest true] at hm
  exact hm

/-- The table `position_of` is an object of the heap of the callee. -/
theorem mem_pos (self sp tp dp mp : BitVec 64) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024) :
    Obj.words (mp + 8192) true .W64 pos.toList ∈ objsP self sp tp dp mp src tgt dropped dest pos := by
  unfold objsP
  have h : Lift.Shuffler.Internal.MapStatement.posArr pos mp ∈
      Lift.Shuffler.Internal.MapInPlaceStatement.objects src tgt dropped dest pos self sp tp dp mp := by
    simp [Lift.Shuffler.Internal.MapInPlaceStatement.objects]
  have hm := List.mem_map_of_mem (f := Lift.Sem.Bridge.toObj) h
  rw [show Lift.Sem.Bridge.toObj (Lift.Shuffler.Internal.MapStatement.posArr pos mp) =
    Obj.words (mp + 8192) true .W64 pos.toList from toObj_words64' (mp + 8192) pos true] at hm
  exact hm

/-- The field `source_size` of the record. -/
theorem mem_source_size (self sp tp dp mp : BitVec 64) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024) :
    (⟨self + 8, false, [⟨.W64, BitVec.ofNat 64 src.length⟩]⟩ : Obj) ∈
      objsP self sp tp dp mp src tgt dropped dest pos := by
  unfold objsP
  have h : (⟨self + 8, Lift.Trusted.Encode.encode (BitVec.ofNat 64 src.length), false⟩ :
      Lift.Trusted.Object) ∈
      Lift.Shuffler.Internal.MapInPlaceStatement.objects src tgt dropped dest pos self sp tp dp mp := by
    simp [Lift.Shuffler.Internal.MapInPlaceStatement.objects]
  have hm := List.mem_map_of_mem (f := Lift.Sem.Bridge.toObj) h
  rw [show Lift.Sem.Bridge.toObj (⟨self + 8, Lift.Trusted.Encode.encode (BitVec.ofNat 64 src.length),
    false⟩ : Lift.Trusted.Object) =
    (⟨self + 8, false, [⟨Width.W64, BitVec.ofNat 64 src.length⟩]⟩ : Obj) from rfl] at hm
  exact hm

/-- The field `target_size` of the record. -/
theorem mem_target_size (self sp tp dp mp : BitVec 64) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024) :
    (⟨self + 24, false, [⟨.W64, BitVec.ofNat 64 tgt.length⟩]⟩ : Obj) ∈
      objsP self sp tp dp mp src tgt dropped dest pos := by
  unfold objsP
  have h : (⟨self + 24, Lift.Trusted.Encode.encode (BitVec.ofNat 64 tgt.length), false⟩ :
      Lift.Trusted.Object) ∈
      Lift.Shuffler.Internal.MapInPlaceStatement.objects src tgt dropped dest pos self sp tp dp mp := by
    simp [Lift.Shuffler.Internal.MapInPlaceStatement.objects]
  have hm := List.mem_map_of_mem (f := Lift.Sem.Bridge.toObj) h
  rw [show Lift.Sem.Bridge.toObj (⟨self + 24, Lift.Trusted.Encode.encode (BitVec.ofNat 64 tgt.length),
    false⟩ : Lift.Trusted.Object) =
    (⟨self + 24, false, [⟨Width.W64, BitVec.ofNat 64 tgt.length⟩]⟩ : Obj) from rfl] at hm
  exact hm

/-- The load of a record field from a heap that a memory holds. -/
theorem load_field_of_holds {policy : CpuPolicy} {m : DataMem} {h : Heap} {base : BitVec 64}
    {v : BitVec 64} (hh : h.Holds policy m)
    (ho : (⟨base, false, [⟨.W64, v⟩]⟩ : Obj) ∈ h) :
    h.load base .W64 = .ok v := by
  have hc : (0, (⟨.W64, v⟩ : Cell)) ∈ offsets 0 (⟨base, false, [⟨.W64, v⟩]⟩ : Obj).cells := by
    simp [offsets]
  have := Heap.load_cell hh ho hc
  simpa using this

/-- The size of an array object. -/
theorem size_words64 (p : BitVec 64) (wr : Bool) (xs : List (BitVec 64)) :
    (Obj.words p wr .W64 xs).size = 8 * xs.length := by
  have h1 : (xs.map (Cell.mk .W64)).map (fun c => c.w.bytes) = xs.map (fun _ => 8) := by
    rw [List.map_map]; rfl
  have h2 : ∀ l : List (BitVec 64), (l.map (fun _ => 8)).sum = 8 * l.length := by
    intro l
    induction l with
    | nil => rfl
    | cons a t ih => simp only [List.map_cons, List.sum_cons, List.length_cons, ih]; omega
  simp only [Obj.words, Obj.size, h1, h2]

/-- The facts of the callee's heap that the frame needs: the caller's heap is a permutation of
the callee's objects `hc` followed by the frame, the two tables are in `hc`, the record field
`mapping` is in `hc`, and a memory holds the heap. -/
structure HeapInv (policy : CpuPolicy) (self mp : BitVec 64) (frame : Heap) (hc h : Heap) : Prop where
  eq : h.Perm (hc ++ frame)
  holds : ∃ m, h.Holds policy m
  dest : ∃ ds : List (BitVec 64), Obj.words mp true .W64 ds ∈ hc ∧ ds.length = 1024
  pos : ∃ ps : List (BitVec 64), Obj.words (mp + 8192) true .W64 ps ∈ hc ∧ ps.length = 1024
  recfield : (⟨self + 48, false, [⟨.W64, mp⟩]⟩ : Obj) ∈ hc

theorem inner_inv (policy : CpuPolicy) (self mp : BitVec 64) (frame : Heap) (i : UInt64)
    (hc : Heap) (ci : mappingBuilderMap.In2p) (v : UInt64) (h' : Heap)
    (hrdi : ci.rdi.toBitVec = self) (hrsi : ci.rsi = i) (hrdx : ci.rdx = i)
    (hi : i.toNat < 1024)
    (hinv : HeapInv policy self mp frame hc ci.heap)
    (hr : mappingBuilderMap.l2p.returns ci (v, h')) :
    ∃ hc', HeapInv policy self mp frame hc' h' := by
  obtain ⟨heq, ⟨m₀, hm₀⟩, ⟨ds, hds, hdsl⟩, ⟨ps, hps, hpsl⟩, hrec⟩ := hinv
  have hmc : (hc ++ frame).Holds policy m₀ := (Heap.Holds_perm heq).mp hm₀
  have hsub : hc ⊆ ci.heap := fun p hp => heq.symm.subset (List.mem_append_left _ hp)
  have hload : ci.heap.load (ci.rdi.toBitVec + 48) .W64 = .ok mp := by
    have h1 : (hc ++ frame).load (self + 48) .W64 = .ok mp :=
      load_field_of_holds hmc (List.mem_append_left _ hrec)
    have h2 : ci.heap.load (self + 48) .W64 = (hc ++ frame).load (self + 48) .W64 :=
      Heap.load_perm_of_holds hm₀ heq (self + 48) .W64
    rw [hrdi]
    exact h2.trans h1
  have hhi : i.toNat < ds.length := by rw [hdsl]; exact hi
  have hhi2 : i.toNat < ps.length := by rw [hpsl]; exact hi
  -- the object of a store is not an object of the frame
  have hne1 : ∀ p ∈ frame, p ≠ Obj.words mp true .W64 ds := by
    intro p hp hpe
    have hpap := (List.pairwise_append.mp hmc.apart).2.2 (Obj.words mp true .W64 ds)
      hds p hp (Or.inl rfl)
    rw [hpe] at hpap
    unfold Obj.Apart at hpap
    have hsz : (Obj.words mp true .W64 ds).size = 8192 := by
      rw [size_words64, hdsl]
    omega
  have hne2 : ∀ p ∈ frame, p ≠ Obj.words (mp + 8192) true .W64 ps := by
    intro p hp hpe
    have hpap := (List.pairwise_append.mp hmc.apart).2.2 (Obj.words (mp + 8192) true .W64 ps)
      hps p hp (Or.inl rfl)
    rw [hpe] at hpap
    unfold Obj.Apart at hpap
    have hsz : (Obj.words (mp + 8192) true .W64 ps).size = 8192 := by
      rw [size_words64, hpsl]
    omega
  have hO2O1 : Obj.words (mp + 8192) true .W64 ps ≠ Obj.words mp true .W64 ds := by
    intro e
    have h := congrArg Obj.addr e
    simp only [Obj.words] at h
    bv_omega
  have hO1'O2 : Obj.words mp true .W64 (ds.set i.toNat i.toBitVec)
      ≠ Obj.words (mp + 8192) true .W64 ps := by
    intro e
    have h := congrArg Obj.addr e
    simp only [Obj.words] at h
    bv_omega
  have hrecO1 : (⟨self + 48, false, [⟨.W64, mp⟩]⟩ : Obj) ≠ Obj.words mp true .W64 ds := by
    intro e
    have h := congrArg Obj.writable e
    rw [show (Obj.words mp true .W64 ds).writable = true from rfl] at h
    exact Bool.noConfusion h
  have hrecO2 : (⟨self + 48, false, [⟨.W64, mp⟩]⟩ : Obj)
      ≠ Obj.words (mp + 8192) true .W64 ps := by
    intro e
    have h := congrArg Obj.writable e
    rw [show (Obj.words (mp + 8192) true .W64 ps).writable = true from rfl] at h
    exact Bool.noConfusion h
  have hfix1 : ∀ p ∈ frame, Obj.set (mp + 8 * i.toBitVec) .W64 i.toBitVec p = p := by
    intro p hp
    have hx₀ : (0 + 8 * i.toNat, (⟨.W64, ds[i.toNat]⟩ : Cell))
        ∈ offsets 0 (Obj.words mp true .W64 ds).cells := by
      simpa [Obj.words] using mem_offsets_words .W64 ds 0 i.toNat hhi
    have hset := Heap.Holds.set_other hmc (List.mem_append_left _ hds) rfl hx₀
      (List.mem_append_right _ hp) (hne1 p hp) i.toBitVec
    rwa [show (Obj.words mp true .W64 ds).addr + BitVec.ofNat 64 (0 + 8 * i.toNat)
      = mp + 8 * i.toBitVec by
        rw [Obj.words, Nat.zero_add, mul8, BitVec.mul_comm]] at hset
  have hfix2 : ∀ p ∈ frame, Obj.set ((mp + 8192) + 8 * i.toBitVec) .W64 i.toBitVec p = p := by
    intro p hp
    have hx₀ : (0 + 8 * i.toNat, (⟨.W64, ps[i.toNat]⟩ : Cell))
        ∈ offsets 0 (Obj.words (mp + 8192) true .W64 ps).cells := by
      simpa [Obj.words] using mem_offsets_words .W64 ps 0 i.toNat hhi2
    have hset := Heap.Holds.set_other hmc (List.mem_append_left _ hps) rfl hx₀
      (List.mem_append_right _ hp) (hne2 p hp) i.toBitVec
    rwa [show (Obj.words (mp + 8192) true .W64 ps).addr + BitVec.ofNat 64 (0 + 8 * i.toNat)
      = (mp + 8192) + 8 * i.toBitVec by
        rw [Obj.words, Nat.zero_add, mul8, BitVec.mul_comm]] at hset
  let O1 : Obj := Obj.words mp true .W64 ds
  let O1' : Obj := Obj.words mp true .W64 (ds.set i.toNat i.toBitVec)
  let O2 : Obj := Obj.words (mp + 8192) true .W64 ps
  let O2' : Obj := Obj.words (mp + 8192) true .W64 (ps.set i.toNat i.toBitVec)
  let g1 : Obj → Obj := fun p => if p = O1 then O1' else p
  let g2 : Obj → Obj := fun p => if p = O2 then O2' else p
  let f : Obj → Obj := fun p => g2 (g1 p)
  let hc2 : Heap := hc.map f
  have hfixf : ∀ p ∈ frame, f p = p := by
    intro p hp
    show (if (if p = O1 then O1' else p) = O2 then O2' else (if p = O1 then O1' else p)) = p
    rw [if_neg (hne1 p hp), if_neg (hne2 p hp)]
  have hinv' : HeapInv policy self mp frame hc ci.heap :=
    ⟨heq, ⟨m₀, hm₀⟩, ⟨ds, hds, hdsl⟩, ⟨ps, hps, hpsl⟩, hrec⟩
  have hback : ∀ (y : mappingBuilderMap.St mappingBuilderMap.In2p Heap), y.mem = ci.heap →
      ∃ hc', HeapInv policy self mp frame hc' y.mem :=
    fun y hy => ⟨hc, by rw [hy]; exact hinv'⟩
  let I : mappingBuilderMap.Lbl → mappingBuilderMap.St mappingBuilderMap.In2p Heap → Prop := fun l x => match l with
    | .entry => x.input = ci ∧ x.mem = ci.heap
    | .o14 => x.input = ci ∧ x.mem = ci.heap
    | .o25 => x.input = ci ∧ x.mem = ci.heap ∧ x.rcx.toBitVec = mp
    | .o36 => x.input = ci ∧ x.mem = ci.heap ∧ x.rcx.toBitVec = mp
    | .LBB25_4 => ∃ hc', HeapInv policy self mp frame hc' x.mem
  let Q : UInt64 × Heap → Prop := fun r => ∃ hc', HeapInv policy self mp frame hc' r.2
  have hstart : I .entry (mappingBuilderMap.initP ci) := ⟨rfl, rfl⟩
  have hmain : Q (v, h') := by
    refine Lift.Sem.CallArm.Blocks.Returns.inv (b := mappingBuilderMap.blocksP)
      (callee := Lift.Sem.noCall) I Q ?_ hr hstart
    intro l x n hx hstep
    cases l with
    | entry =>
      obtain ⟨hin, hmem⟩ := hx
      simp only [mappingBuilderMap.blocksP] at hstep
      split at hstep
      · split at hstep
        · split at hstep
          · cases hstep; exact ⟨hin, hmem⟩
          · cases hstep; exact hback _ hmem
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    | o14 =>
      obtain ⟨hin, hmem⟩ := hx
      simp only [mappingBuilderMap.blocksP] at hstep
      split at hstep
      · rename_i v0 hv0
        split at hstep
        · split at hstep
          · cases hstep
            refine ⟨hin, hmem, ?_⟩
            have hv0' : ci.heap.load (ci.rdi.toBitVec + 48) .W64 = .ok v0 := by
              rw [← hmem, ← hin]; exact hv0
            have hv : v0 = mp := Res.ok.inj (hv0'.symm.trans hload)
            show (UInt64.ofBitVec v0).toBitVec = mp
            rw [UInt64.toBitVec_ofBitVec, hv]
          · cases hstep; exact hback _ hmem
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    | o25 =>
      obtain ⟨hin, hmem, hrcx⟩ := hx
      simp only [mappingBuilderMap.blocksP] at hstep
      split at hstep
      · split at hstep
        · cases hstep; exact ⟨hin, hmem, hrcx⟩
        · cases hstep; exact hback _ hmem
      · cases hstep
      · cases hstep
    | o36 =>
      obtain ⟨hin, hmem, hrcx⟩ := hx
      simp only [mappingBuilderMap.blocksP] at hstep
      split at hstep
      · rename_i h1 hs1
        split at hstep
        · rename_i h2 hs2
          cases hstep
          have hrsi' : x.input.rsi = i := by rw [hin]; exact hrsi
          have hrdx' : x.input.rdx = i := by rw [hin]; exact hrdx
          have hs1c : ci.heap.store (mp + 8 * i.toBitVec) .W64 i.toBitVec = .ok h1 := by
            have e1 : mp + 8 * i.toBitVec = x.rcx.toBitVec + x.input.rsi.toBitVec * 8 := by
              rw [hrcx, hrsi', BitVec.mul_comm]
            rw [e1, ← hmem, ← hrdx']
            exact hs1
          obtain ⟨h1s, hs1s, hr1s⟩ := Heap.store_words64 (base := mp) (xs := ds)
            (i := i.toBitVec) hm₀ (hsub hds) hhi i.toBitVec
          have h1eq : h1s = h1 := Res.ok.inj (hs1s.symm.trans hs1c)
          subst h1s
          obtain ⟨m1, -, hm1, -⟩ := Heap.store_frame hm₀ hs1c
          have hs2c : Heap.store h1 ((mp + 8192) + 8 * i.toBitVec) .W64 i.toBitVec = Res.ok h2 := by
            have e2 : (mp + 8192) + 8 * i.toBitVec
                = x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192 := by
              rw [hrcx, hrdx']; bv_omega
            rw [e2, ← hrsi']
            exact hs2
          have hO2h1 : Obj.words (mp + 8192) true .W64 ps ∈ h1 :=
            Heap.Replaces.mem_of_ne hr1s (hsub hps) hO2O1
          obtain ⟨h2s, hs2s, hr2s⟩ := Heap.store_words64 (base := mp + 8192) (xs := ps)
            (i := i.toBitVec) hm1 hO2h1 hhi2 i.toBitVec
          have h2eq : h2s = h2 := Res.ok.inj (hs2s.symm.trans hs2c)
          subst h2s
          obtain ⟨m2, -, hm2, -⟩ := Heap.store_frame hm1 hs2c
          have hr1' : h1 = ci.heap.map g1 := replaces_eq_map hr1s
          have hr2' : h2 = h1.map g2 := replaces_eq_map hr2s
          have hmapf : h2 = ci.heap.map f := by
            rw [hr2', hr1', List.map_map]
            rfl
          refine ⟨hc2, ?_, ?_, ?_, ?_, ?_⟩
          · rw [hmapf]
            have hmap : (hc ++ frame).map f = hc2 ++ frame := by
              rw [List.map_append, map_eq_self_of hfixf]
            rw [← hmap]
            exact heq.map f
          · exact ⟨m2, hm2⟩
          · refine ⟨ds.set i.toNat i.toBitVec, ?_, by rw [List.length_set]; exact hdsl⟩
            have hO1'f : f O1 = O1' := by
              show (if (if O1 = O1 then O1' else O1) = O2 then O2' else (if O1 = O1 then O1' else O1))
                = O1'
              rw [if_pos rfl, if_neg hO1'O2]
            rw [show Obj.words mp true .W64 (ds.set i.toNat i.toBitVec) = O1' from rfl, ← hO1'f]
            exact List.mem_map_of_mem (f := f) hds
          · refine ⟨ps.set i.toNat i.toBitVec, ?_, by rw [List.length_set]; exact hpsl⟩
            have hO2'f : f O2 = O2' := by
              show (if (if O2 = O1 then O1' else O2) = O2 then O2' else (if O2 = O1 then O1' else O2))
                = O2'
              rw [if_neg hO2O1, if_pos rfl]
            rw [show Obj.words (mp + 8192) true .W64 (ps.set i.toNat i.toBitVec) = O2' from rfl,
              ← hO2'f]
            exact List.mem_map_of_mem (f := f) hps
          · have hrecf : f (⟨self + 48, false, [⟨.W64, mp⟩]⟩ : Obj)
                = (⟨self + 48, false, [⟨.W64, mp⟩]⟩ : Obj) := by
              show (if (if (⟨self + 48, false, [⟨.W64, mp⟩]⟩ : Obj) = O1 then O1' else _) = O2
                then O2' else (if (⟨self + 48, false, [⟨.W64, mp⟩]⟩ : Obj) = O1 then O1' else _)) = _
              rw [if_neg hrecO1, if_neg hrecO2]
            rw [← hrecf]
            exact List.mem_map_of_mem (f := f) hrec
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    | LBB25_4 =>
      simp only [mappingBuilderMap.blocksP] at hstep
      cases hstep
      exact hx
  obtain ⟨hc', hinv''⟩ := hmain
  exact ⟨hc', hinv''⟩

/-- The bound of the loop counter of the caller: the smaller of the two sizes. -/
theorem toNat_le_of_le (src tgt : List Lift.Pilot.Slot) (hC : Lift.Pilot.MapInPlaceSpec.C src tgt)
    (v v1 : BitVec 64) (hv : v = BitVec.ofNat 64 src.length) (hv1 : v1 = BitVec.ofNat 64 tgt.length)
    (h : UInt64.ofBitVec v1 ≤ UInt64.ofBitVec v) : (UInt64.ofBitVec v1).toNat ≤ 1024 := by
  subst hv; subst hv1
  rw [UInt64.toNat_ofBitVec, BitVec.toNat_ofNat]
  rw [UInt64.le_iff_toNat_le, UInt64.toNat_ofBitVec, UInt64.toNat_ofBitVec,
    BitVec.toNat_ofNat, BitVec.toNat_ofNat] at h
  have h1 : tgt.length % 2 ^ 64 ≤ tgt.length := Nat.mod_le _ _
  have h2 : src.length % 2 ^ 64 ≤ src.length := Nat.mod_le _ _
  exact Nat.le_trans (Nat.le_min.mpr ⟨Nat.le_trans h h2, h1⟩) hC

theorem toNat_le_of_not_le (src tgt : List Lift.Pilot.Slot) (hC : Lift.Pilot.MapInPlaceSpec.C src tgt)
    (v v1 : BitVec 64) (hv : v = BitVec.ofNat 64 src.length) (hv1 : v1 = BitVec.ofNat 64 tgt.length)
    (h : ¬ UInt64.ofBitVec v1 ≤ UInt64.ofBitVec v) : (UInt64.ofBitVec v).toNat ≤ 1024 := by
  subst hv; subst hv1
  rw [UInt64.toNat_ofBitVec, BitVec.toNat_ofNat]
  rw [UInt64.le_iff_toNat_le, UInt64.toNat_ofBitVec, UInt64.toNat_ofBitVec,
    BitVec.toNat_ofNat, BitVec.toNat_ofNat] at h
  have h1 : tgt.length % 2 ^ 64 ≤ tgt.length := Nat.mod_le _ _
  have h2 : src.length % 2 ^ 64 ≤ src.length := Nat.mod_le _ _
  have hle : src.length % 2 ^ 64 ≤ tgt.length % 2 ^ 64 := by omega
  exact Nat.le_trans (Nat.le_min.mpr ⟨h2, Nat.le_trans hle h1⟩) hC

/-- The frame facts of the caller's result. -/
theorem outer_inv (self sp tp dp mp : BitVec 64) (frame : Heap) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024) (a : skel_call.In2p)
    (hC : Lift.Pilot.MapInPlaceSpec.C src tgt) (hrdi : a.rdi.toBitVec = self)
    (hheap : a.heap = objsP self sp tp dp mp src tgt dropped dest pos ++ frame)
    (hm0 : ∃ m, a.heap.Holds a.policy m)
    (q : UInt64 × Heap) (hr : skel_call.l2p.returns a q) :
    ∃ hc, HeapInv a.policy self mp frame hc q.2 := by
  obtain ⟨m0, hm0'⟩ := hm0
  have hmc0 : (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).Holds a.policy m0 := by
    rw [← hheap]; exact hm0'
  have hinv0 : HeapInv a.policy self mp frame (objsP self sp tp dp mp src tgt dropped dest pos) a.heap :=
    { eq := by rw [hheap]
      holds := ⟨m0, hm0'⟩
      dest := ⟨dest.toList, mem_dest self sp tp dp mp src tgt dropped dest pos, by simp⟩
      pos := ⟨pos.toList, mem_pos self sp tp dp mp src tgt dropped dest pos, by simp⟩
      recfield := mem_mapping self sp tp dp mp src tgt dropped dest pos }
  have hload8 : a.heap.load (self + 8) .W64 = .ok (BitVec.ofNat 64 src.length) := by
    rw [hheap]
    exact load_field_of_holds hmc0
      (List.mem_append_left _ (mem_source_size self sp tp dp mp src tgt dropped dest pos))
  have hload24 : a.heap.load (self + 24) .W64 = .ok (BitVec.ofNat 64 tgt.length) := by
    rw [hheap]
    exact load_field_of_holds hmc0
      (List.mem_append_left _ (mem_target_size self sp tp dp mp src tgt dropped dest pos))
  let P : St skel_call.In2p Heap → Prop := fun x =>
    x.input = a ∧ x.rbx = a.rdi ∧ x.r14.toNat ≤ x.r15.toNat ∧ x.r15.toNat ≤ 1024 ∧
      ∃ hc, HeapInv a.policy self mp frame hc x.mem
  let I : Lbl → St skel_call.In2p Heap → Prop := fun l x => match l with
    | .entry => x = skel_call.initP a
    | .LBB30_1 => P x
    | .LBB30_2 => P x
    | .LBB30_3 => P x
    | _ => P x ∧ x.r14.toNat < x.r15.toNat
  let Q : UInt64 × Heap → Prop := fun r => ∃ hc, HeapInv a.policy self mp frame hc r.2
  have hstart : I .entry (skel_call.initP a) := rfl
  have hmain : Q q := by
    refine Lift.Sem.CallArm.Blocks.Returns.inv (b := skel_call.blocksP) (callee := _) I Q ?_ hr hstart
    intro l x n hx hstep
    cases l with
    | entry =>
      subst hx
      simp only [skel_call.blocksP] at hstep
      split at hstep
      · rename_i v hv
        split at hstep
        · rename_i v1 hv1
          split at hstep
          · rename_i hle1
            cases hstep
            have hv' : a.heap.load (self + 8) .W64 = .ok v := by rw [← hrdi]; exact hv
            have hv1' : a.heap.load (self + 24) .W64 = .ok v1 := by rw [← hrdi]; exact hv1
            have ev : v = BitVec.ofNat 64 src.length := Res.ok.inj (hv'.symm.trans hload8)
            have ev1 : v1 = BitVec.ofNat 64 tgt.length := Res.ok.inj (hv1'.symm.trans hload24)
            subst ev; subst ev1
            refine ⟨rfl, rfl, ?_, ?_, ⟨_, hinv0⟩⟩
            · show (0 : UInt64).toNat ≤ _
              simp
            · exact toNat_le_of_le src tgt hC _ _ rfl rfl hle1
          · rename_i hle1
            cases hstep
            have hv' : a.heap.load (self + 8) .W64 = .ok v := by rw [← hrdi]; exact hv
            have hv1' : a.heap.load (self + 24) .W64 = .ok v1 := by rw [← hrdi]; exact hv1
            have ev : v = BitVec.ofNat 64 src.length := Res.ok.inj (hv'.symm.trans hload8)
            have ev1 : v1 = BitVec.ofNat 64 tgt.length := Res.ok.inj (hv1'.symm.trans hload24)
            subst ev; subst ev1
            refine ⟨rfl, rfl, ?_, ?_, ⟨_, hinv0⟩⟩
            · show (0 : UInt64).toNat ≤ _
              simp
            · exact toNat_le_of_not_le src tgt hC _ _ rfl rfl hle1
        all_goals cases hstep
      all_goals cases hstep
    | LBB30_1 =>
      obtain ⟨hin, hrbx, hle, hr15, hhi⟩ := hx
      simp only [skel_call.blocksP] at hstep
      repeat' split at hstep
      · cases hstep
        exact ⟨hin, hrbx, hle, hr15, hhi⟩
      · rename_i hne
        cases hstep
        refine ⟨⟨hin, hrbx, hle, hr15, hhi⟩, ?_⟩
        rcases Nat.lt_or_ge x.r14.toNat x.r15.toNat with h | h
        · exact h
        · exfalso
          exact hne (UInt64.toNat_inj.mp (by omega))
      all_goals cases hstep
    | o31 =>
      obtain ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩ := hx
      simp only [skel_call.blocksP] at hstep
      repeat' split at hstep
      · cases hstep
        exact ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩
      · cases hstep
        exact ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩
      all_goals cases hstep
    | o52 =>
      obtain ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩ := hx
      simp only [skel_call.blocksP] at hstep
      repeat' split at hstep
      · cases hstep
        exact ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩
      · cases hstep
        exact ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩
      all_goals cases hstep
    | o63 =>
      obtain ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩ := hx
      simp only [skel_call.blocksP] at hstep
      repeat' split at hstep
      · cases hstep
        exact ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩
      · cases hstep
        exact ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩
      all_goals cases hstep
    | o74 =>
      obtain ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩ := hx
      simp only [skel_call.blocksP] at hstep
      cases hstep
      intro y hy
      obtain ⟨h, h', hR, hsame⟩ := hy
      obtain ⟨hc, heq, hholds, hdest, hpos, hrec⟩ := hhi
      have hinvh' : HeapInv a.policy self mp frame hc h :=
        { eq := hsame.perm_in.symm.trans heq
          holds := ⟨hholds.choose, (Heap.Holds_perm hsame.perm_in).mp hholds.choose_spec⟩
          dest := hdest
          pos := hpos
          recfield := hrec }
      have hi : x.r14.toNat < 1024 := by omega
      obtain ⟨hc', hres⟩ := inner_inv a.policy self mp frame x.r14 hc
        { policy := x.input.policy, heap := h, rax := x.rax, rdx := x.r14, rsi := x.r14,
          rdi := x.rbx, sp := x.input.sp - 24 - 8 } y.1 h'
        (by show x.rbx.toBitVec = self; rw [hrbx]; exact hrdi) rfl rfl hi hinvh' hR
      obtain ⟨heq', hholds', hdest', hpos', hrec'⟩ := hres
      refine ⟨⟨hin, hrbx, ?_, hr15, ⟨hc', ?_⟩⟩, hlt⟩
      · omega
      · exact ⟨hsame.perm_out.trans heq',
          ⟨_, (Heap.Holds_perm hsame.perm_out).mpr hholds'.choose_spec⟩, hdest', hpos', hrec'⟩
    | o88 =>
      obtain ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩ := hx
      simp only [skel_call.blocksP] at hstep
      repeat' split at hstep
      · cases hstep
        exact ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩
      · cases hstep
        exact ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩
      all_goals cases hstep
    | LBB30_5 =>
      obtain ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩ := hx
      simp only [skel_call.blocksP] at hstep
      cases hstep
      refine ⟨hin, hrbx, ?_, hr15, hhi⟩
      show (x.r14 + 1).toNat ≤ x.r15.toNat
      have e2 : (x.r14 + 1).toNat = x.r14.toNat + 1 := by
        rw [UInt64.toNat_add, show (1 : UInt64).toNat = 1 from rfl,
          Nat.mod_eq_of_lt (by have := x.r14.toBitVec.isLt; omega)]
      omega
    | LBB30_2 =>
      obtain ⟨hin, hrbx, hle, hr15, hhi⟩ := hx
      simp only [skel_call.blocksP] at hstep
      cases hstep
      exact ⟨hin, hrbx, hle, hr15, hhi⟩
    | LBB30_3 =>
      obtain ⟨hin, hrbx, hle, hr15, hhi⟩ := hx
      simp only [skel_call.blocksP] at hstep
      repeat' split at hstep
      · cases hstep
        exact hhi
      all_goals cases hstep
    | LBB30_9 =>
      obtain ⟨⟨hin, hrbx, hle, hr15, hhi⟩, hlt⟩ := hx
      simp only [skel_call.blocksP] at hstep
      cases hstep
      exact ⟨hin, hrbx, hle, hr15, hhi⟩
  exact hmain
theorem call_frame : ∀ (self : BitVec 64) (sp : BitVec 64) (tp : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre self sp tp dp mp frame src tgt dropped dest pos a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro self sp tp dp mp frame src tgt dropped dest pos a q hpre hret m hm
  obtain ⟨hC, hrdi, hheap, hm0⟩ := hpre
  simp only [callInput] at hrdi hheap hm0
  obtain ⟨hc, heq, -, -, -, -⟩ :=
    outer_inv self sp tp dp mp frame src tgt dropped dest pos a hC hrdi hheap hm0 q hret
  have h1 : (hc ++ frame).Holds a.policy m := (Heap.Holds_perm heq).mp hm
  exact h1.sublist (List.sublist_append_right hc frame)
end call_frame.skel_proof
theorem call_frame : call_frame.skel_statement := @call_frame.skel_proof.call_frame
theorem call_shape : ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2 := by
  intro a r h
  refine Lift.Sem.CallArm.Blocks.Returns.inv (fun _ x => Lift.Sem.CallArm.Shape a.heap x.mem)
    (fun r => Lift.Sem.CallArm.Shape a.heap r.2) ?_ h (Lift.Sem.CallArm.Shape.refl _)
  rintro l x n hsh hstep
  cases l with
  | entry =>
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · split at hstep
      · simp only [Res.ok.injEq] at hstep
        subst hstep
        split <;> exact hsh
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | LBB30_1 =>
    simp only [skel_call.blocksP, Res.ok.injEq] at hstep
    subst hstep
    split <;> exact hsh
  | o31 =>
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · split at hstep
      · split at hstep
        · split at hstep
          · simp only [Res.ok.injEq] at hstep
            subst hstep
            split <;> exact hsh
          · cases hstep
          · cases hstep
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o52 =>
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · split at hstep
      · simp only [Res.ok.injEq] at hstep
        subst hstep
        split <;> exact hsh
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o63 =>
    simp only [skel_call.blocksP] at hstep
    split at hstep
    · split at hstep
      · simp only [Res.ok.injEq] at hstep
        subst hstep
        split <;> exact hsh
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o74 =>
    simp only [skel_call.blocksP, Res.ok.injEq] at hstep
    subst hstep
    simp only [Lift.Sem.CallArm.Next.Inv]
    rintro y ⟨h, h', hret, hsp⟩
    exact Lift.Sem.CallArm.Shape.trans hsh
      (Lift.Sem.CallArm.Shape.perm
        (Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.call_shape _ _ hret)
        hsp.perm_in hsp.perm_out)
  | o88 =>
    simp only [skel_call.blocksP, Res.ok.injEq] at hstep
    subst hstep
    split <;> exact hsh
  | LBB30_5 =>
    simp only [skel_call.blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact hsh
  | LBB30_2 =>
    simp only [skel_call.blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact hsh
  | LBB30_3 =>
    simp only [skel_call.blocksP] at hstep
    simp only [Res.ok.injEq] at hstep
    subst hstep
    exact hsh
  | LBB30_9 =>
    simp only [skel_call.blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact hsh
theorem call_summary : callSummary := by
  intro self sp tp dp mp frame src tgt dropped dest pos a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 self sp tp dp mp frame src tgt dropped dest pos () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨⟨r, hrel, hmap⟩, call_shape a q hq, call_frame self sp tp dp mp frame src tgt dropped dest pos a q hs hq⟩⟩
end skel_semantic
end Skel.Gen.Level3.Shuffler.mappingBuilderMapInPlace

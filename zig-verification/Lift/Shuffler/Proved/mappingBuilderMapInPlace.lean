def callState (x : St In2p Heap) (z : St skel_call.In2p Heap) : Prop := x.input = callInput z.input ∧ x.rax = z.rax ∧ x.rbx = z.rbx ∧ x.rcx = z.rcx ∧ x.rdx = z.rdx ∧ x.rsi = z.rsi ∧ x.rdi = z.rdi ∧ x.r14 = z.r14 ∧ x.r15 = z.r15 ∧ x.mem = z.mem ∧ True


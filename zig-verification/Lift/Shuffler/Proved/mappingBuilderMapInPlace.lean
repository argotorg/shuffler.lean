def init (a : In2) : St In2 DataMem := ⟨a, 0, a.rbx, 0, 0, 0, a.rdi, a.r14, a.r15, a.mem⟩

abbrev Private (sp b : BitVec 64) : Prop := (b - (sp - 32)).toNat < 40

abbrev Clear (sp a : BitVec 64) (n : Nat := 8) : Prop := ∀ i, i < n → ¬ Private sp (a + BitVec.ofNat 64 i)


namespace MapReplay

open Lift.P2.Total Lift.Sem Lift.Sem.CallArm
open Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic

def StatePerm (x y : Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.St Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.In2p Heap) : Prop :=
  ∃ (inputHeap heap : Heap),
    y = { x with input := { x.input with heap := inputHeap }, mem := heap } ∧
    x.mem.Perm heap ∧ ∃ m, x.mem.Holds x.input.policy m

def OutputPerm (q r : UInt64 × Heap) : Prop := q.1 = r.1 ∧ q.2.Perm r.2

theorem block_replay (l : Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.Lbl) (x y : Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.St Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.In2p Heap)
    (n : Next Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.Lbl (Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.St Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.In2p Heap) (UInt64 × Heap) Empty Empty.elim Empty.elim)
    (hp : StatePerm x y) (hs : Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.blocksP.step l x = .ok n) :
    Next.Sim (fun f => f.elim) (fun f => f.elim) StatePerm OutputPerm n
      (Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.blocksP.step l y) := by
  obtain ⟨inputHeap, heap, rfl, hp, m, hh⟩ := hp
  cases l <;> simp only [Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.blocksP] at hs ⊢
  all_goals repeat' heap_perm_step_typed hs
  all_goals first
    | (res_step hs
       exact ⟨_, rfl, inputHeap, _, rfl, by assumption, _, by assumption⟩)
    | (res_step hs
       exact ⟨_, rfl, rfl, by assumption⟩)
    | (split at hs <;> res_step hs <;> simp only [Next.Sim, *] <;>
       exact ⟨_, rfl, inputHeap, _, rfl, by assumption, _, by assumption⟩)

theorem replay (a : Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.In2p) (q : UInt64 × Heap) {heap : Heap}
    (hh : ∃ m, a.heap.Holds a.policy m) (hp : a.heap.Perm heap)
    (hr : Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.l2p.returns a q) :
    ∃ q', Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.l2p.returns {a with heap := heap} q' ∧ OutputPerm q q' := by
  obtain ⟨m, hm⟩ := hh
  exact Blocks.Returns.sim (fun f => f.elim) (fun f => f.elim) StatePerm OutputPerm
    (fun f => f.elim) block_replay hr
    (y := Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.initP {a with heap := heap})
    ⟨heap, heap, rfl, hp, m, hm⟩

end MapReplay

namespace MapInPlaceCall

open Lift.P2.Total Lift.Sem Lift.Sem.CallArm Lift.Sem.Bridge

abbrev CallerObjs := Skel.Gen.Level3.Shuffler.mappingBuilderMapInPlace.skel_semantic.objsP
abbrev CalleeObjs := Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.objsP
abbrev CalleeInput := Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.In2p
abbrev CalleeModel := Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.skel_call.l2p

def Extra (self sp tp : BitVec 64) (src tgt : List Lift.Pilot.Slot) : Heap :=
  ([⟨self, Lift.Trusted.Encode.encode sp, false⟩,
    ⟨self + 8, Lift.Trusted.Encode.encode (BitVec.ofNat 64 src.length), false⟩,
    ⟨self + 16, Lift.Trusted.Encode.encode tp, false⟩,
    ⟨self + 24, Lift.Trusted.Encode.encode (BitVec.ofNat 64 tgt.length), false⟩,
    ⟨sp, Lift.Trusted.Encode.encode (src.map Lift.Pilot.Slot.word), false⟩,
    ⟨tp, Lift.Trusted.Encode.encode (tgt.map Lift.Pilot.Slot.word), false⟩] : List Lift.Trusted.Object).map toObj

theorem perm_of_full_partition {h k : Heap}
    (hp : ∃ rest, h.Perm (k ++ rest)) (hlen : h.length = k.length) : h.Perm k := by
  obtain ⟨rest, hp⟩ := hp
  have hl := hp.length_eq
  simp only [List.length_append] at hl
  have hz : rest.length = 0 := by omega
  have he : rest = [] := List.eq_nil_iff_length_eq_zero.mpr hz
  simpa only [he, List.append_nil] using hp

theorem partition (self sp tp dp mp : BitVec 64) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024) (j : Nat) :
    (CallerObjs self sp tp dp mp src tgt dropped dest pos).Perm
      (CalleeObjs self dp mp dropped dest pos j j ++ Extra self sp tp src tgt) := by
  apply perm_of_full_partition
  · simp only [CallerObjs, CalleeObjs, Extra,
      Skel.Gen.Level3.Shuffler.mappingBuilderMapInPlace.skel_semantic.objsP,
      Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.objsP,
      Lift.Shuffler.Internal.MapInPlaceStatement.objects, Lift.Shuffler.Internal.MapStatement.objects,
      List.map_cons, List.map_nil]
    heap_partition_exact
  · simp only [CallerObjs, CalleeObjs, Extra,
      Skel.Gen.Level3.Shuffler.mappingBuilderMapInPlace.skel_semantic.objsP,
      Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.objsP,
      Lift.Shuffler.Internal.MapInPlaceStatement.objects, Lift.Shuffler.Internal.MapStatement.objects,
      List.length_append, List.length_map, List.length_cons, List.length_nil]

theorem objects_same_shape (self sp tp dp mp : BitVec 64) (frame : Heap)
    (src tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest pos dest' pos' : Vector (BitVec 64) 1024) :
    (CallerObjs self sp tp dp mp src tgt dropped dest pos ++ frame).SameShape
      (CallerObjs self sp tp dp mp src tgt dropped dest' pos' ++ frame) := by
  -- The actual lists differ only in their last two vector values.
  simp only [CallerObjs, Skel.Gen.Level3.Shuffler.mappingBuilderMapInPlace.skel_semantic.objsP,
    Lift.Shuffler.Internal.MapInPlaceStatement.objects, List.map_cons, List.map_nil,
    Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.refines_l3.skel_proof.toObj_destArr,
    Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.refines_l3.skel_proof.toObj_posArr,
    Heap.SameShape, List.map_append, Obj.shape, Obj.words, List.map_map, Function.comp_def,
    List.map_const', Vector.length_toList]

theorem call_in_place (self sp tp dp mp : BitVec 64) (frame : Heap)
    (src tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest pos : Vector (BitVec 64) 1024) (j : Fin 1024) (a : CalleeInput)
    (y : BitVec 16 × Vector (BitVec 64) 1024 × Vector (BitVec 64) 1024)
    (hdi : a.rdi.toBitVec = self) (hsi : a.rsi.toNat = j.val) (hdx : a.rdx.toNat = j.val)
    (ha : a.heap = CallerObjs self sp tp dp mp src tgt dropped dest pos ++ frame)
    (hh : ∃ m, a.heap.Holds a.policy m)
    (hy : Lift.Pilot.MapSpec.run dropped dest pos j j = some y) :
    ∃ v : UInt64,
      CallFrame.PermLift
        (fun h h' => CalleeModel.returns {a with heap := h} (v, h')) a.heap
        (CallerObjs self sp tp dp mp src tgt dropped y.2.1 y.2.2 ++ frame) ∧
      Lift.Trusted.Encode.encode y.1 = [⟨.W16, v.toBitVec.setWidth 16⟩] ∧
      ∃ m, (CallerObjs self sp tp dp mp src tgt dropped y.2.1 y.2.2 ++ frame).Holds a.policy m := by
  let canonical : CalleeInput := { a with heap := (
      CalleeObjs self dp mp dropped dest pos j j ++ (Extra self sp tp src tgt ++ frame)) }
  have hi : a.heap.Perm canonical.heap := by
    rw [ha]
    simpa only [canonical, List.append_assoc] using
      (partition self sp tp dp mp src tgt dropped dest pos j).append_right frame
  obtain ⟨m0, hh0⟩ := hh
  have hp : Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.callPre
      self dp mp (Extra self sp tp src tgt ++ frame) dropped dest pos j j canonical :=
    ⟨⟨j.isLt, j.isLt⟩, hdi, hsi, hdx, rfl, m0, (Heap.Holds_perm hi).mp hh0⟩
  obtain ⟨q, hr, hcode, hq, m, hheld⟩ := MapExact.call_exact self dp mp
    (Extra self sp tp src tgt ++ frame) dropped dest pos j j canonical y hp hy
  obtain ⟨r, hr', hv, hpout⟩ := MapReplay.replay canonical q
    ⟨m0, (Heap.Holds_perm hi).mp hh0⟩ hi.symm hr
  change CalleeModel.returns a r at hr'
  have hhr : r.2.Holds a.policy m := (Heap.Holds_perm hpout).mp hheld
  have htarget : (CallerObjs self sp tp dp mp src tgt dropped y.2.1 y.2.2 ++ frame).Holds a.policy m := by
    have hp' := (partition self sp tp dp mp src tgt dropped y.2.1 y.2.2 j).append_right frame
    have hc : (CalleeObjs self dp mp dropped y.2.1 y.2.2 j j ++
        (Extra self sp tp src tgt ++ frame)).Holds a.policy m := hq ▸ hheld
    exact (Heap.Holds_perm (by simpa only [List.append_assoc] using hp')).mpr hc
  have hview := MapExact.return_view a r ⟨m0, hh0⟩ hr'
  have hs : r.2.SameShape (CallerObjs self sp tp dp mp src tgt dropped y.2.1 y.2.2 ++ frame) :=
    hview.1.symm.trans (ha.symm ▸ objects_same_shape self sp tp dp mp frame src tgt dropped dest pos y.2.1 y.2.2)
  have heq := Heap.Holds.eq_of_sameShape hhr htarget hs
  refine ⟨r.1, ?_, ?_, m, htarget⟩
  · refine ⟨a.heap, r.2, ?_, ?_⟩
    · simpa only [CalleeModel] using hr'
    · rw [← heq]
      exact ⟨hview.1.length, hview.1.length, List.Perm.refl _⟩
  · rw [← hv]
    exact hcode

end MapInPlaceCall

namespace MapInPlaceHeap

open Lift.P2.Total Lift.Sem Lift.Sem.Bridge

abbrev Result := BitVec 16 × Vector (BitVec 64) 1024 × Vector (BitVec 64) 1024

theorem toObj_words (base : BitVec 64) (xs : List (BitVec 64)) (wr : Bool) :
    toObj (⟨base, Lift.Trusted.Encode.encode xs, wr⟩ : Lift.Trusted.Object) =
      Obj.words base wr .W64 xs := by
  simp only [toObj, Lift.Trusted.Encode.encode, List.map_map]
  rfl

theorem objects (self sp tp dp mp : BitVec 64) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024) :
    objsP self sp tp dp mp src tgt dropped dest pos =
      [⟨self, false, [⟨.W64, sp⟩]⟩,
       ⟨self + 8, false, [⟨.W64, BitVec.ofNat 64 src.length⟩]⟩,
       ⟨self + 16, false, [⟨.W64, tp⟩]⟩,
       ⟨self + 24, false, [⟨.W64, BitVec.ofNat 64 tgt.length⟩]⟩,
       ⟨self + 32, false, [⟨.W64, dp⟩]⟩,
       ⟨self + 48, false, [⟨.W64, mp⟩]⟩,
       Obj.words sp false .W64 (src.map Lift.Pilot.Slot.word),
       Obj.words tp false .W64 (tgt.map Lift.Pilot.Slot.word),
       Obj.words dp false .W8 dropped.toList,
       Obj.words mp true .W64 dest.toList,
       Obj.words (mp + 8192) true .W64 pos.toList] := by
  simp only [objsP, Lift.Shuffler.Internal.MapInPlaceStatement.objects, List.map_cons, List.map_nil,
    Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.refines_l3.skel_proof.toObj_droppedField,
    Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.refines_l3.skel_proof.toObj_mappingField,
    Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.refines_l3.skel_proof.toObj_droppedArr,
    Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.refines_l3.skel_proof.toObj_destArr,
    Skel.Gen.Level3.Shuffler.mappingBuilderMap.skel_semantic.refines_l3.skel_proof.toObj_posArr,
    MapPrimitives.toObj_word, toObj_words]
  rfl

theorem size_bounds (self sp tp dp mp : BitVec 64) (frame : Heap)
    (src tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest pos : Vector (BitVec 64) 1024) (policy : CpuPolicy) (m : DataMem)
    (hh : (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).Holds policy m) :
    src.length < 2^64 ∧ tgt.length < 2^64 := by
  rw [objects] at hh
  have hs := hh.noWrap (Obj.words sp false .W64 (src.map Lift.Pilot.Slot.word)) (by simp)
  have ht := hh.noWrap (Obj.words tp false .W64 (tgt.map Lift.Pilot.Slot.word)) (by simp)
  rw [MapPrimitives.size_words64, List.length_map] at hs ht
  constructor <;> omega

theorem lengths (src tgt : List Lift.Pilot.Slot) (hc : Lift.Pilot.MapInPlaceSpec.C src tgt) :
    ((List.finRange 1024).zip (src.zip tgt)).length = min src.length tgt.length := by
  simp only [List.length_zip, List.length_finRange]
  exact Nat.min_eq_right hc

theorem rest_cons (src tgt : List Lift.Pilot.Slot) (n : Nat)
    (hc : Lift.Pilot.MapInPlaceSpec.C src tgt) (hn : n < min src.length tgt.length) :
    List.drop n ((List.finRange 1024).zip (src.zip tgt)) =
      (⟨n, by unfold Lift.Pilot.MapInPlaceSpec.C at hc; omega⟩,
        src[n]'(by omega), tgt[n]'(by omega)) ::
        List.drop (n + 1) ((List.finRange 1024).zip (src.zip tgt)) := by
  rw [List.drop_eq_getElem_cons (by rw [lengths src tgt hc]; exact hn)]
  simp only [List.getElem_zip, List.getElem_finRange, Fin.cast_mk]

theorem eq_slots (a b : Lift.Pilot.Slot) :
    (UInt64.ofBitVec b.word &&& 281474976710655 =
      UInt64.ofBitVec a.word &&& 281474976710655) ↔
      Lift.Pilot.ShallowestSpec.eql a b = true := by
  obtain ⟨p, k, o, d⟩ := a
  obtain ⟨p', k', o', d'⟩ := b
  simp only [Lift.Pilot.Slot.word, Lift.Pilot.ShallowestSpec.eql, Bool.and_eq_true,
    decide_eq_true_eq]
  bv_decide

theorem code_cases (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024)
    (j : Fin 1024) (y : Result) (hy : Lift.Pilot.MapSpec.run dropped dest pos j j = some y) :
    y.1 = 0 ∨ y.1 = 1 := by
  simp only [Lift.Pilot.MapSpec.run, j.isLt, and_self, ↓reduceDIte] at hy
  split at hy <;> cases Option.some.inj hy <;> simp

theorem fields (self sp tp dp mp : BitVec 64) (frame : Heap)
    (src tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest pos : Vector (BitVec 64) 1024) (policy : CpuPolicy) (m : DataMem)
    (hh : (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).Holds policy m) :
    (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).load self .W64 = .ok sp ∧
    (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).load (self + 8) .W64 =
      .ok (BitVec.ofNat 64 src.length) ∧
    (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).load (self + 16) .W64 = .ok tp ∧
    (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).load (self + 24) .W64 =
      .ok (BitVec.ofNat 64 tgt.length) ∧
    (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).load (self + 32) .W64 = .ok dp ∧
    (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).load (self + 48) .W64 = .ok mp := by
  repeat' constructor
  all_goals apply MapPrimitives.load_field_of_holds hh
  all_goals rw [objects]; simp

theorem load_slot {policy : CpuPolicy} {m : DataMem} {heap : Heap}
    (hh : heap.Holds policy m) (base : BitVec 64) (slots : List Lift.Pilot.Slot)
    (ho : Obj.words base false .W64 (slots.map Lift.Pilot.Slot.word) ∈ heap)
    (n : Nat) (hn : n < slots.length) :
    heap.load (base + BitVec.ofNat 64 n * 8) .W64 = .ok slots[n].word := by
  have h := Heap.load_words hh ho (k := n) (by simpa only [List.length_map] using hn)
  simpa only [Width.bytes, Nat.mul_comm 8 n, BitVec.ofNat_mul,
    List.getElem_map, BitVec.ofNat_eq_ofNat] using h

theorem load_vector {policy : CpuPolicy} {m : DataMem} {heap : Heap}
    (hh : heap.Holds policy m) (base : BitVec 64) (wr : Bool) (w : Width)
    (xs : Vector w.type 1024) (ho : Obj.words base wr w xs.toList ∈ heap) (j : Fin 1024) :
    heap.load (base + BitVec.ofNat 64 (w.bytes * j.val)) w = .ok xs[j.val] := by
  have h := Heap.load_words hh ho (k := j.val) (by simpa only [Vector.length_toList] using j.isLt)
  simpa only [Vector.getElem_toList] using h

end MapInPlaceHeap

namespace MapInPlaceLoop

open Lift.P2.Total Lift.Sem Lift.Sem.Bridge
open MapInPlaceHeap

abbrev Calls := fun (_ : Unit) (x : mappingBuilderMap.In2p) (r : UInt64 × Heap) =>
  CallFrame.PermLift (fun k k' => mappingBuilderMap.l2p.returns {x with heap := k} (r.1, k'))
    x.heap r.2

abbrev H (self sp tp dp mp : BitVec 64) (frame : Heap) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024) :=
  objsP self sp tp dp mp src tgt dropped dest pos ++ frame

abbrev Rest (src tgt : List Lift.Pilot.Slot) (n : Nat) :=
  List.drop n ((List.finRange 1024).zip (src.zip tgt))

structure Inv (self sp tp dp mp : BitVec 64) (frame : Heap) (src tgt : List Lift.Pilot.Slot)
    (dropped : Vector (BitVec 8) 1024) (dest pos : Vector (BitVec 64) 1024)
    (n : Nat) (x : St In2p Heap) : Prop where
  ptr : x.rbx.toBitVec = self
  index : x.r14.toNat = n
  limit : x.r15.toNat = min src.length tgt.length
  heap : x.mem = H self sp tp dp mp frame src tgt dropped dest pos
  held : ∃ m, x.mem.Holds x.input.policy m

theorem byte_zero (b : BitVec 8) :
    (UInt64.ofBitVec (BitVec.zeroExtend 64 b) = 0) ↔ b = 0 := by bv_decide

theorem word_none (b : BitVec 64) :
    (UInt64.ofBitVec b = 18446744073709551615) ↔ b = Lift.Pilot.IsRetainedSpec.none64 := by
  unfold Lift.Pilot.IsRetainedSpec.none64
  bv_decide

theorem code_eq (y : BitVec 16) (v : UInt64)
    (h : Lift.Trusted.Encode.encode y = [⟨.W16, v.toBitVec.setWidth 16⟩]) :
    y = v.toBitVec.setWidth 16 := by
  simpa only [Lift.Trusted.Encode.encode, List.cons.injEq, and_true, true_and,
    Lift.Trusted.Field.mk.injEq, heq_eq_eq] using h

theorem code_zero (y : BitVec 16) (v : UInt64)
    (h : Lift.Trusted.Encode.encode y = [⟨.W16, v.toBitVec.setWidth 16⟩]) :
    (v.toUInt16.toUInt64 = 0) ↔ y = 0 := by
  rw [code_eq y v h]
  bv_decide

theorem error_code (v : UInt64) :
    (((v &&& 18446744073709486080) ||| (1 &&& 65535))).toBitVec.setWidth 16 = 1 := by
  bv_decide

theorem exit (x : St In2p Heap) :
    blocksP.Returns Calls .LBB30_2 x (0, x.mem) := by
  exact .goto rfl (.ret rfl)

theorem fail (x : St In2p Heap) :
    blocksP.Returns Calls .LBB30_9 x
      ((x.rax &&& 18446744073709486080) ||| (1 &&& 65535), x.mem) := by
  exact .goto rfl (.ret rfl)

theorem run_loop (self sp tp dp mp : BitVec 64) (frame : Heap)
    (src tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (hc : Lift.Pilot.MapInPlaceSpec.C src tgt) (k : Nat) :
    ∀ (n : Nat) (dest pos : Vector (BitVec 64) 1024) (x : St In2p Heap) (y : Result),
    n + k = min src.length tgt.length →
    Inv self sp tp dp mp frame src tgt dropped dest pos n x →
    Lift.Pilot.MapInPlaceSpec.loop dropped (Rest src tgt n) dest pos = some y →
    ∃ v : UInt64, blocksP.Returns Calls .LBB30_1 x
        (v, H self sp tp dp mp frame src tgt dropped y.2.1 y.2.2) ∧
      Lift.Trusted.Encode.encode y.1 = [⟨.W16, v.toBitVec.setWidth 16⟩] ∧
      ∃ m, (H self sp tp dp mp frame src tgt dropped y.2.1 y.2.2).Holds x.input.policy m := by
  induction k with
  | zero =>
    intro n dest pos x y hn hi hy
    obtain ⟨hptr, hidx, hlim, hheap, hheld⟩ := hi
    have he : x.r15 = x.r14 := UInt64.toNat_inj.mp (by omega)
    have hr : Rest src tgt n = [] := by
      apply List.drop_eq_nil_iff.mpr
      rw [lengths src tgt hc]
      omega
    rw [hr, Lift.Pilot.MapInPlaceSpec.loop] at hy
    cases Option.some.inj hy
    refine ⟨0, ?_, rfl, ?_⟩
    · rw [← hheap]
      exact .goto (by simp only [blocksP, he, ↓reduceIte]) (exit x)
    · rw [← hheap]
      exact hheld
  | succ k ih =>
    intro n dest pos x y hn hi hy
    have hnlt : n < min src.length tgt.length := by omega
    have hn1024 : n < 1024 := by unfold Lift.Pilot.MapInPlaceSpec.C at hc; omega
    let j : Fin 1024 := ⟨n, hn1024⟩
    obtain ⟨hptr, hidx, hlim, hheap, hheld⟩ := hi
    have hne : x.r15 ≠ x.r14 := by intro he; have h := congrArg UInt64.toNat he; omega
    have hindex : x.r14.toBitVec = BitVec.ofNat 64 n := by
      rw [← MapPrimitives.ofNat_toNat_eq x.r14, hidx]
    have hrest := rest_cons src tgt n hc hnlt
    simp only [Rest] at hy
    rw [hrest, Lift.Pilot.MapInPlaceSpec.loop] at hy
    change (if Lift.Pilot.ShallowestSpec.eql src[n] tgt[n] = true ∧
          dropped[j] = 0 ∧ dest[j] = Lift.Pilot.IsRetainedSpec.none64 then
        (Lift.Pilot.MapSpec.run dropped dest pos n n).bind fun q =>
          if q.1 = 0 then Lift.Pilot.MapInPlaceSpec.loop dropped (Rest src tgt (n+1)) q.2.1 q.2.2
          else some q
        else Lift.Pilot.MapInPlaceSpec.loop dropped (Rest src tgt (n+1)) dest pos) = some y at hy
    have cont (dest' pos' : Vector (BitVec 64) 1024) (z : St In2p Heap)
        (hz : Inv self sp tp dp mp frame src tgt dropped dest' pos' n z)
        (hy' : Lift.Pilot.MapInPlaceSpec.loop dropped (Rest src tgt (n+1)) dest' pos' = some y) :
        ∃ v : UInt64, blocksP.Returns Calls .LBB30_5 z
            (v, H self sp tp dp mp frame src tgt dropped y.2.1 y.2.2) ∧
          Lift.Trusted.Encode.encode y.1 = [⟨.W16, v.toBitVec.setWidth 16⟩] ∧
          ∃ m, (H self sp tp dp mp frame src tgt dropped y.2.1 y.2.2).Holds z.input.policy m := by
      obtain ⟨hzptr, hzidx, hzlim, hzheap, hzheld⟩ := hz
      have hz' : Inv self sp tp dp mp frame src tgt dropped dest' pos' (n+1)
          {z with r14 := z.r14 + 1} := by
        refine ⟨hzptr, ?_, hzlim, hzheap, hzheld⟩
        change (z.r14 + 1).toNat = n+1
        rw [UInt64.toNat_add, hzidx]
        simp only [UInt64.toNat_ofNat, Nat.reduceMod]
        exact Nat.mod_eq_of_lt (by omega)
      obtain ⟨v, hr, hv, hm⟩ := ih (n+1) dest' pos' {z with r14 := z.r14 + 1} y
        (by omega) hz' hy'
      exact ⟨v, .goto rfl hr, hv, hm⟩
    obtain ⟨m, hm⟩ := hheld
    have hh : (H self sp tp dp mp frame src tgt dropped dest pos).Holds x.input.policy m :=
      hheap ▸ hm
    obtain ⟨hsp, hslen, htp, htlen, hdp, hmp⟩ := fields self sp tp dp mp frame src tgt dropped dest pos _ _ hh
    have hs : (H self sp tp dp mp frame src tgt dropped dest pos).load
        (sp + BitVec.ofNat 64 n * 8) .W64 = .ok src[n].word :=
      load_slot hh sp src (by rw [H, objects]; simp) n (by omega)
    have ht : (H self sp tp dp mp frame src tgt dropped dest pos).load
        (tp + BitVec.ofNat 64 n * 8) .W64 = .ok tgt[n].word :=
      load_slot hh tp tgt (by rw [H, objects]; simp) n (by omega)
    let slotState : St In2p Heap := {x with
      rax := UInt64.ofBitVec sp
      rcx := (UInt64.ofBitVec tgt[n].word ^^^ UInt64.ofBitVec src[n].word) <<< (16 : UInt64)}
    have hslot : Inv self sp tp dp mp frame src tgt dropped dest pos n slotState :=
      ⟨hptr, hidx, hlim, hheap, m, hm⟩
    by_cases heq : Lift.Pilot.ShallowestSpec.eql src[n] tgt[n] = true
    · have fromSlot (r : UInt64 × Heap) (hr : blocksP.Returns Calls .o52 slotState r) :
          blocksP.Returns Calls .LBB30_1 x r := by
        refine .goto (l' := .o31) (s' := x) ?_ (.goto ?_ hr)
        · simp only [blocksP, hne, ↓reduceIte]
        · simp only [blocksP, slotState, hptr, hheap, hindex, hsp, htp, ht, hs]
          rw [if_pos ((eq_slots src[n] tgt[n]).mpr heq)]
      have hdload : (H self sp tp dp mp frame src tgt dropped dest pos).load
          (dp + BitVec.ofNat 64 n * 1) .W8 = .ok dropped[j] := by
        have h := load_vector hh dp false .W8 dropped (by rw [H, objects]; simp) j
        have he : dp + BitVec.ofNat 64 n * 1 = dp + BitVec.ofNat 64 n := by bv_decide
        rw [he]
        simpa only [Fin.getElem_fin, j, Width.bytes, Nat.one_mul] using h
      let dropState : St In2p Heap := {slotState with rax := UInt64.ofBitVec dp}
      have hdrop : Inv self sp tp dp mp frame src tgt dropped dest pos n dropState :=
        ⟨hptr, hidx, hlim, hheap, m, hm⟩
      by_cases hd : dropped[j] = 0
      · have fromDrop (r : UInt64 × Heap) (hr : blocksP.Returns Calls .o63 dropState r) :
            blocksP.Returns Calls .LBB30_1 x r := by
          apply fromSlot
          refine .goto ?_ hr
          simp only [blocksP, dropState, slotState, hptr, hheap, hindex, hdp,
            UInt64.toBitVec_ofBitVec, BitVec.mul_one, hdload]
          rw [if_pos ((byte_zero dropped[j]).mpr hd)]
        have hvload : (H self sp tp dp mp frame src tgt dropped dest pos).load
            (mp + BitVec.ofNat 64 n * 8) .W64 = .ok dest[j] := by
          have h := load_vector hh mp true .W64 dest (by rw [H, objects]; simp) j
          simpa only [Fin.getElem_fin, j, Width.bytes, Nat.mul_comm 8 n,
            BitVec.ofNat_mul, BitVec.ofNat_eq_ofNat] using h
        let mapState : St In2p Heap := {dropState with rax := UInt64.ofBitVec mp}
        by_cases hv : dest[j] = Lift.Pilot.IsRetainedSpec.none64
        · have fromMap (r : UInt64 × Heap) (hr : blocksP.Returns Calls .o74 mapState r) :
              blocksP.Returns Calls .LBB30_1 x r := by
            apply fromDrop
            refine .goto ?_ hr
            simp only [blocksP, mapState, dropState, slotState, hptr, hheap, hindex, hmp,
              UInt64.toBitVec_ofBitVec, hvload]
            rw [if_pos ((word_none dest[j]).mpr hv)]
          obtain ⟨q, hq⟩ := Lift.Pilot.MapSpec.total dropped dest pos n n ⟨hn1024, hn1024⟩
          rw [if_pos ⟨heq, hd, hv⟩, hq, Option.bind_some] at hy
          let ci : MapInPlaceCall.CalleeInput :=
            ⟨x.input.policy, x.mem, UInt64.ofBitVec mp, x.r14, x.r14, x.rbx, x.input.sp-24-8⟩
          obtain ⟨vc, hcRet, hcCode, hcHeld⟩ := MapInPlaceCall.call_in_place
            self sp tp dp mp frame src tgt dropped dest pos j ci q
            hptr hidx hidx hheap ⟨m, hm⟩ hq
          let afterCall : St In2p Heap := {mapState with
            rdi := x.rbx
            rsi := x.r14
            rdx := x.r14
            rax := vc
            mem := H self sp tp dp mp frame src tgt dropped q.2.1 q.2.2}
          have fromCall (r : UInt64 × Heap) (hr : blocksP.Returns Calls .o88 afterCall r) :
              blocksP.Returns Calls .LBB30_1 x r := by
            apply fromMap
            exact .call (y := (vc, H self sp tp dp mp frame src tgt dropped q.2.1 q.2.2)) rfl hcRet hr
          by_cases hz : q.1 = 0
          · rw [if_pos hz] at hy
            have hafter : Inv self sp tp dp mp frame src tgt dropped q.2.1 q.2.2 n afterCall :=
              ⟨hptr, hidx, hlim, rfl, hcHeld⟩
            obtain ⟨v, hr, henc, hheld'⟩ := cont q.2.1 q.2.2 afterCall hafter hy
            refine ⟨v, fromCall _ (.goto ?_ hr), henc, hheld'⟩
            simp only [blocksP, afterCall]
            rw [if_pos ((code_zero q.1 vc hcCode).mpr hz)]
          · rw [if_neg hz] at hy
            have hone : q.1 = 1 := (code_cases dropped dest pos j q hq).resolve_left hz
            have hyq : y = q := (Option.some.inj hy).symm
            subst y
            let out := (vc &&& 18446744073709486080) ||| (1 &&& 65535)
            refine ⟨out, fromCall _ (.goto ?_ (fail afterCall)), ?_, hcHeld⟩
            · simp only [blocksP, afterCall]
              rw [if_neg (fun h => hz ((code_zero q.1 vc hcCode).mp h))]
            · rw [hone, show out.toBitVec.setWidth 16 = 1 from error_code vc]
              rfl
        · have hskip : ¬ (Lift.Pilot.ShallowestSpec.eql src[n] tgt[n] ∧
              dropped[j] = 0 ∧ dest[j] = Lift.Pilot.IsRetainedSpec.none64) := fun h => hv h.2.2
          rw [if_neg hskip] at hy
          have hmap : Inv self sp tp dp mp frame src tgt dropped dest pos n mapState :=
            ⟨hptr, hidx, hlim, hheap, m, hm⟩
          obtain ⟨v, hr, henc, hheld'⟩ := cont dest pos mapState hmap hy
          refine ⟨v, fromDrop _ (.goto ?_ hr), henc, hheld'⟩
          simp only [blocksP, mapState, dropState, slotState, hptr, hheap, hindex, hmp,
            UInt64.toBitVec_ofBitVec, hvload]
          rw [if_neg (fun h => hv ((word_none dest[j]).mp h))]
      · have hskip : ¬ (Lift.Pilot.ShallowestSpec.eql src[n] tgt[n] ∧
            dropped[j] = 0 ∧ dest[j] = Lift.Pilot.IsRetainedSpec.none64) := fun h => hd h.2.1
        rw [if_neg hskip] at hy
        obtain ⟨v, hr, henc, hheld'⟩ := cont dest pos dropState hdrop hy
        refine ⟨v, fromSlot _ (.goto ?_ hr), henc, hheld'⟩
        simp only [blocksP, dropState, slotState, hptr, hheap, hindex, hdp,
          UInt64.toBitVec_ofBitVec, BitVec.mul_one, hdload]
        rw [if_neg (fun h => hd ((byte_zero dropped[j]).mp h))]
    · have hskip : ¬ (Lift.Pilot.ShallowestSpec.eql src[n] tgt[n] ∧
          dropped[j] = 0 ∧ dest[j] = Lift.Pilot.IsRetainedSpec.none64) := fun h => heq h.1
      rw [if_neg hskip] at hy
      obtain ⟨v, hr, hv, hm'⟩ := cont dest pos slotState hslot hy
      refine ⟨v, .goto (l' := .o31) (s' := x) ?_ (.goto ?_ hr), hv, hm'⟩
      · simp only [blocksP, hne, ↓reduceIte]
      · simp only [blocksP, slotState, hptr, hheap, hindex, hsp, htp, ht, hs]
        rw [if_neg (fun h => heq ((eq_slots src[n] tgt[n]).mp h))]

end MapInPlaceLoop


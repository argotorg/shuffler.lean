theorem toObj_word (p v : BitVec 64) (wr : Bool) :
    Lift.Sem.Bridge.toObj (⟨p, Lift.Trusted.Encode.encode v, wr⟩ : Lift.Trusted.Object) =
      (⟨p, wr, [⟨.W64, v⟩]⟩ : Obj) := rfl

theorem load_field_of_holds {policy : CpuPolicy} {m : DataMem} {h : Heap} {base : BitVec 64}
    {v : BitVec 64} (hh : h.Holds policy m)
    (ho : (⟨base, false, [⟨.W64, v⟩]⟩ : Obj) ∈ h) :
    h.load base .W64 = .ok v := by
  have hc : (0, (⟨.W64, v⟩ : Cell)) ∈ offsets 0 (⟨base, false, [⟨.W64, v⟩]⟩ : Obj).cells := by
    simp [offsets]
  have := Heap.load_cell hh ho hc
  simpa using this

theorem size_words64 (p : BitVec 64) (wr : Bool) (xs : List (BitVec 64)) :
    (Obj.words p wr .W64 xs).size = 8 * xs.length := by
  have h1 : (xs.map (Cell.mk .W64)).map (fun c => c.w.bytes) = xs.map (fun _ => 8) := by
    rw [List.map_map]; rfl
  have h2 : ∀ l : List (BitVec 64), (l.map (fun _ => 8)).sum = 8 * l.length := by
    intro l
    induction l with
    | nil => rfl
    | cons a t ih => simp only [List.map_cons, List.sum_cons, List.length_cons, ih]; omega
  simp only [Obj.words, Obj.size, h1, h2]

theorem ofNat_toNat_eq (i : UInt64) : BitVec.ofNat 64 i.toNat = i.toBitVec := by
  conv => lhs; rw [show i.toNat = i.toBitVec.toNat from rfl]
  rw [BitVec.ofNat_toNat, BitVec.setWidth_eq]

end MapPrimitives


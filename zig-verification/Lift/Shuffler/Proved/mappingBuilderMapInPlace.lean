def objsP (self : BitVec 64) (sp : BitVec 64) (tp : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) : Heap := (Lift.Shuffler.Internal.MapInPlaceStatement.objects src tgt dropped dest pos self sp tp dp mp).map toObj

def SimIn (a : In2p) (b : In2) : Prop := a.policy = b.policy ∧ a.rbx = b.rbx ∧ a.rdi = b.rdi ∧ a.r14 = b.r14 ∧ a.r15 = b.r15 ∧ a.heap.Holds b.policy b.mem ∧ (∀ c, Private b.sp c → ¬ Covered a.heap c) ∧ (∀ c, SysV.Below b.sp 32 c → ¬ Covered a.heap c) ∧ SysV.RoomAt b.policy b.mem b.sp 32 ∧ a.sp = b.sp

def SimSt (x : St In2p Heap) (y : St In2 DataMem) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rbx = y.rbx ∧ x.rcx = y.rcx ∧ x.rdx = y.rdx ∧ x.rsi = y.rsi ∧ x.rdi = y.rdi ∧ x.r14 = y.r14 ∧ x.r15 = y.r15 ∧ x.mem.Holds y.input.policy y.mem ∧ (∀ b, ¬ x.input.heap.Owned b → ¬ SysV.Below y.input.sp 32 b → y.mem.get? b = y.input.mem.get? b) ∧ (∀ b, SysV.Below y.input.sp 32 b → ¬ Covered x.mem b) ∧ SysV.RoomAt y.input.policy y.mem y.input.sp 32

def SimOut (x : In2p) (y : In2) (r : UInt64 × Heap) (r' : UInt64 × DataMem) : Prop := r.1 = r'.1 ∧ r.2.Holds x.policy r'.2 ∧ ∀ b, ¬ x.heap.Owned b → ¬ SysV.Below y.sp 32 b → r'.2.get? b = y.mem.get? b

def SimArr (self : BitVec 64) (sp : BitVec 64) (tp : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (a : In2p) : Prop := (Lift.Pilot.MapInPlaceSpec.C src tgt) ∧ a.rdi.toBitVec = self ∧ a.heap = objsP self sp tp dp mp src tgt dropped dest pos ++ frame ∧ ∃ m, a.heap.Holds a.policy m

def l3 (self : BitVec 64) (sp : BitVec 64) (tp : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (pol : CpuPolicy) := show Model Unit _ from
  { rep policy _ s := policy = pol ∧ Heap.Holds policy (objsP self sp tp dp mp src tgt dropped dest pos ++ frame) s.data.dmem ∧ (Lift.Pilot.MapInPlaceSpec.C src tgt) ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderMapInPlacePC s ∧ s.data.regs.rdi.toBitVec = self ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered (objsP self sp tp dp mp src tgt dropped dest pos ++ frame) b) ∧ (∀ b, SysV.Below s.data.regs.rsp.toBitVec 32 b → ¬ Covered (objsP self sp tp dp mp src tgt dropped dest pos ++ frame) b) ∧ SysV.StackRoom policy s 32
    returns _ y := Lift.Pilot.MapInPlaceSpec.run src tgt dropped dest pos = some y
    post _ y s t := SysV.Exit s t ∧ Lift.Trusted.Encode.encode y.1 = [⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩] ∧ Lift.Shuffler.Internal.MapInPlaceStatement.post src tgt dropped dest pos mp pol ⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩ t.data.dmem ∧ ∀ b, ¬ (objsP self sp tp dp mp src tgt dropped dest pos ++ frame).Owned b → ¬ SysV.Below s.data.regs.rsp.toBitVec 32 b → t.data.dmem.get? b = s.data.dmem.get? b }


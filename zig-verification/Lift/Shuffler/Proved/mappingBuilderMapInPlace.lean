/-! ### Auxiliary lemmas for the frame row -/

/-- `List.flatMap` of singletons is `List.map`. -/
theorem flatMap_singleton' {α β : Type} (f : α → β) (l : List α) :
    l.flatMap (fun a => [f a]) = l.map f := by
  induction l with
  | nil => rfl
  | cons a t ih => simp [ih]

/-- A map that fixes each element of a list. -/
theorem map_eq_self_of {α : Type} {f : α → α} {l : List α} (h : ∀ a ∈ l, f a = a) :
    l.map f = l := by
  induction l with
  | nil => rfl
  | cons a t ih =>
    simp only [List.map_cons, h a (List.mem_cons_self ..),
      ih (fun b hb => h b (List.mem_cons_of_mem _ hb))]

/-- A sublist is a sublist after a map that fixes its elements. -/
theorem sublist_map_self {l h : List Obj} (hs : l.Sublist h) (f : Obj → Obj)
    (hf : ∀ p ∈ l, f p = p) : l.Sublist (h.map f) := by
  rw [← map_eq_self_of hf]
  exact hs.map f

/-- The replaced heap is the old heap with the replaced object. -/
theorem replaces_eq_map {O O' : Obj} {h h' : Heap} (hr : Heap.Replaces O O' h h') :
    h' = h.map (fun p => if p = O then O' else p) := by
  induction hr with
  | nil => rfl
  | here _ ih => simp only [List.map_cons, if_pos rfl, ↓reduceIte, ih]
  | there hne _ ih => simp only [List.map_cons, if_neg hne, ih]

/-- A sublist of a heap is a sublist after the replacement of an object that is not in it. -/
theorem replaces_sublist_fix {O O' : Obj} {h h' : Heap} (hr : Heap.Replaces O O' h h')
    {l : Heap} (hs : l.Sublist h) (hne : ∀ p ∈ l, p ≠ O) : l.Sublist h' := by
  rw [replaces_eq_map hr]
  exact sublist_map_self hs _ fun p hp => by simp [hne p hp]

/-- The bit vector of a `UInt64` value. -/
theorem ofNat_toNat_eq (i : UInt64) : BitVec.ofNat 64 i.toNat = i.toBitVec := by
  conv => lhs; rw [show i.toNat = i.toBitVec.toNat from rfl]
  rw [BitVec.ofNat_toNat, BitVec.setWidth_eq]

/-- The 8-byte offset of an index. -/
theorem mul8 (i : UInt64) : BitVec.ofNat 64 (8 * i.toNat) = i.toBitVec * 8 := by
  rw [show i.toBitVec = BitVec.ofNat 64 i.toNat from (ofNat_toNat_eq i).symm,
    show (8 : BitVec 64) = BitVec.ofNat 64 8 from BitVec.ofNat_eq_ofNat]
  rw [← BitVec.ofNat_mul]
  rw [Nat.mul_comm]

/-- The encoding of a `u64` word is one 64-bit field. -/
theorem toObj_word (p v : BitVec 64) (wr : Bool) :
    Lift.Sem.Bridge.toObj (⟨p, Lift.Trusted.Encode.encode v, wr⟩ : Lift.Trusted.Object) =
      (⟨p, wr, [⟨.W64, v⟩]⟩ : Obj) := rfl

/-- The encoding of an array of words. -/
theorem toObj_words64' (p : BitVec 64) (dest : Vector (BitVec 64) 1024) (wr : Bool) :
    Lift.Sem.Bridge.toObj (⟨p, Lift.Trusted.Encode.encode dest, wr⟩ : Lift.Trusted.Object) =
      Obj.words p wr .W64 dest.toList := by
  have hcell : (Lift.Trusted.Encode.encode dest).map Lift.Sem.Bridge.toCell
      = dest.toList.map (fun v => (⟨Width.W64, v⟩ : Cell)) := by
    rw [show Lift.Trusted.Encode.encode dest
        = dest.toList.flatMap (fun v => [(⟨Width.W64, v⟩ : Lift.Trusted.Field)]) from rfl]
    rw [show dest.toList.flatMap (fun v => [(⟨Width.W64, v⟩ : Lift.Trusted.Field)])
        = dest.toList.map (fun v => (⟨Width.W64, v⟩ : Lift.Trusted.Field)) from flatMap_singleton' _ _]
    simp [Lift.Sem.Bridge.toCell]
  show (⟨p, wr, (Lift.Trusted.Encode.encode dest).map Lift.Sem.Bridge.toCell⟩ : Obj)
      = Obj.words p wr .W64 dest.toList
  rw [hcell]

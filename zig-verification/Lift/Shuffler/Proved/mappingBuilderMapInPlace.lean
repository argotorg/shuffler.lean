def callPost (self : BitVec 64) (sp : BitVec 64) (tp : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Pilot.MapInPlaceSpec.run src tgt dropped dest pos)) (q : (UInt64 × Heap)) : Prop := (∃ (r : (UInt64 × Heap)), (Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ (callInput a).heap = objsP self sp tp dp mp src tgt dropped dest pos ++ frame ∧ ∀ m, r.2.Holds (callInput a).policy m → Lift.Shuffler.Internal.MapInPlaceStatement.post src tgt dropped dest pos mp (callInput a).policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) ∧ r = q) ∧ Lift.Sem.CallArm.Shape a.heap q.2 ∧ (∀ m, q.2.Holds a.policy m → frame.Holds a.policy m)

abbrev callSummary : Prop := ∀ (self : BitVec 64) (sp : BitVec 64) (tp : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Pilot.MapInPlaceSpec.run src tgt dropped dest pos)), callPre self sp tp dp mp frame src tgt dropped dest pos a → Lift.Pilot.MapInPlaceSpec.run src tgt dropped dest pos = some y → ∃ q, skel_call.l2p.returns a q ∧ callPost self sp tp dp mp frame src tgt dropped dest pos a y q

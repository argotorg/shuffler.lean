def bridgeState (z : St skel_call.In2p Heap) : St In2p Heap := { input := callInput z.input, rax := z.rax, rbx := z.rbx, rcx := z.rcx, rdx := z.rdx, rsi := z.rsi, rdi := z.rdi, r14 := z.r14, r15 := z.r15, mem := z.mem }


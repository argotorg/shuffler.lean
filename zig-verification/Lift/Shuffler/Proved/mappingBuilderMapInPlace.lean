theorem refines_l3 : ∀ (self : BitVec 64) (sp : BitVec 64) (tp : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024), Refines (fun (_ : Unit) => SimArr self sp tp dp mp frame src tgt dropped dest pos) (fun _ a y r => Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP self sp tp dp mp src tgt dropped dest pos ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.MapInPlaceStatement.post src tgt dropped dest pos mp a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) (fun _ y => Lift.Pilot.MapInPlaceSpec.run src tgt dropped dest pos = some y) l2p.returns := by

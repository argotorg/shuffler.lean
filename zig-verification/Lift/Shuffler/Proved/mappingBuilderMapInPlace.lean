def header (a : In2p) (src tgt : List Lift.Pilot.Slot) : St In2p Heap :=
  {initP a with
    rax := UInt64.ofBitVec (BitVec.ofNat 64 src.length)
    rbx := a.rdi
    r14 := 0
    r15 := if UInt64.ofBitVec (BitVec.ofNat 64 tgt.length) ≤
        UInt64.ofBitVec (BitVec.ofNat 64 src.length) then
      UInt64.ofBitVec (BitVec.ofNat 64 tgt.length) else
      UInt64.ofBitVec (BitVec.ofNat 64 src.length)}

theorem header_invariant (self sp tp dp mp : BitVec 64) (frame : Heap)
    (src tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest pos : Vector (BitVec 64) 1024) (a : In2p)
    (hs : SimArr self sp tp dp mp frame src tgt dropped dest pos a) :
    Inv self sp tp dp mp frame src tgt dropped dest pos 0 (header a src tgt) := by
  obtain ⟨hc, hdi, ha, m, hh⟩ := hs
  have hh' := hh
  rw [ha] at hh'
  obtain ⟨hslt, htlt⟩ := size_bounds self sp tp dp mp frame src tgt dropped dest pos _ _ hh'
  have hsrc : (UInt64.ofBitVec (BitVec.ofNat 64 src.length)).toNat = src.length := by
    simp only [UInt64.toNat_ofBitVec, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hslt]
  have htgt : (UInt64.ofBitVec (BitVec.ofNat 64 tgt.length)).toNat = tgt.length := by
    simp only [UInt64.toNat_ofBitVec, BitVec.toNat_ofNat, Nat.mod_eq_of_lt htlt]
  refine ⟨hdi, rfl, ?_, ha, m, hh⟩
  change UInt64.toNat (if _ then _ else _) = min src.length tgt.length
  split
  · rename_i hle
    have hle' : tgt.length ≤ src.length := by
      simpa only [UInt64.le_iff_toNat_le, hsrc, htgt] using hle
    simp only [htgt, Nat.min_eq_right hle']
  · rename_i hgt
    have hgt' : src.length ≤ tgt.length := by
      have hne : ¬ tgt.length ≤ src.length := by
        intro hle
        exact hgt (by simpa only [UInt64.le_iff_toNat_le, hsrc, htgt] using hle)
      omega
    simp only [hsrc, Nat.min_eq_left hgt']

theorem result_post (self sp tp dp mp : BitVec 64) (frame : Heap)
    (src tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest pos : Vector (BitVec 64) 1024) (a : In2p) (y : Result) (v : UInt64)
    (hy : Lift.Pilot.MapInPlaceSpec.run src tgt dropped dest pos = some y)
    (hv : Lift.Trusted.Encode.encode y.1 = [⟨.W16, v.toBitVec.setWidth 16⟩]) :
    ∀ m, (H self sp tp dp mp frame src tgt dropped y.2.1 y.2.2).Holds a.policy m →
      Lift.Shuffler.Internal.MapInPlaceStatement.post src tgt dropped dest pos mp a.policy
        ⟨.W16, v.toBitVec.setWidth 16⟩ m := by
  intro m hm
  have hsub := hm.sublist (List.sublist_append_left
    (objsP self sp tp dp mp src tgt dropped y.2.1 y.2.2) frame)
  have h := (holds_iff a.policy
    (Lift.Shuffler.Internal.MapInPlaceStatement.objects src tgt dropped y.2.1 y.2.2 self sp tp dp mp) m).mp hsub
  refine ⟨y, hy, hv, h.1 _ ?_, h.1 _ ?_⟩
  all_goals simp only [Lift.Shuffler.Internal.MapInPlaceStatement.objects,
    List.mem_cons, List.not_mem_nil, or_false]
  all_goals simp

theorem from_header (self sp tp dp mp : BitVec 64) (frame : Heap)
    (src tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest pos : Vector (BitVec 64) 1024) (a : In2p) (y : Result)
    (hs : SimArr self sp tp dp mp frame src tgt dropped dest pos a)
    (hy : Lift.Pilot.MapInPlaceSpec.run src tgt dropped dest pos = some y) :
    ∃ r, blocksP.Returns Calls .LBB30_1 (header a src tgt) r ∧
      Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧
      a.heap = objsP self sp tp dp mp src tgt dropped dest pos ++ frame ∧
      ∀ m, r.2.Holds a.policy m →
        Lift.Shuffler.Internal.MapInPlaceStatement.post src tgt dropped dest pos mp a.policy
          ⟨.W16, r.1.toBitVec.setWidth 16⟩ m := by
  have hi := header_invariant self sp tp dp mp frame src tgt dropped dest pos a hs
  obtain ⟨hc, hdi, ha, hh⟩ := hs
  have hlo := hy
  rw [Lift.Pilot.MapInPlaceSpec.run, if_pos hc] at hlo
  obtain ⟨v, hr, hv, hm⟩ := run_loop self sp tp dp mp frame src tgt dropped hc
    (min src.length tgt.length) 0 dest pos (header a src tgt) y (by omega) hi
    (by simpa only [Rest, List.drop_zero] using hlo)
  exact ⟨(v, H self sp tp dp mp frame src tgt dropped y.2.1 y.2.2), hr, hv, ha,
    result_post self sp tp dp mp frame src tgt dropped dest pos a y v hy hv⟩

theorem refines_l3 (self sp tp dp mp : BitVec 64) (frame : Heap)
    (src tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024)
    (dest pos : Vector (BitVec 64) 1024) :
    Refines (fun (_ : Unit) => SimArr self sp tp dp mp frame src tgt dropped dest pos)
      (fun _ a y r => Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧
        a.heap = objsP self sp tp dp mp src tgt dropped dest pos ++ frame ∧
        ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.MapInPlaceStatement.post
          src tgt dropped dest pos mp a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m)
      (fun _ y => Lift.Pilot.MapInPlaceSpec.run src tgt dropped dest pos = some y) l2p.returns := by
  intro _ a y hs hy
  obtain ⟨r, hr, hp⟩ := from_header self sp tp dp mp frame src tgt dropped dest pos a y hs hy
  obtain ⟨hc, hdi, ha, m, hh⟩ := hs
  rw [ha] at hh
  obtain ⟨hsp, hslen, htp, htlen, hdp, hmp⟩ := fields self sp tp dp mp frame src tgt dropped dest pos _ _ hh
  refine ⟨r, .goto ?_ hr, hp⟩
  simp only [blocksP, initP, hdi, ha, hslen, htlen, header]

theorem loop_LBB30_1 : ∀ (self : BitVec 64) (sp : BitVec 64) (tp : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (src : List Lift.Pilot.Slot) (tgt : List Lift.Pilot.Slot) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (a : In2p) y (v_rax : BitVec 64), SimArr self sp tp dp mp frame src tgt dropped dest pos a → a.heap.load (a.rdi.toBitVec + 8) .W64 = .ok v_rax → Lift.Pilot.MapInPlaceSpec.run src tgt dropped dest pos = some y → ∃ r, blocksP.Returns (fun _ => (fun (x : mappingBuilderMap.In2p) (r : UInt64 × Heap) => Lift.Sem.CallFrame.PermLift (fun k k' => mappingBuilderMap.l2p.returns { x with heap := k } (r.1, k')) x.heap r.2)) .LBB30_1 ⟨a, (UInt64.ofBitVec v_rax), a.rdi, 0, 0, 0, a.rdi, 0, ((if (match a.heap.load (a.rdi.toBitVec + 24) .W64 with | .ok v => UInt64.ofBitVec v | _ => 0) ≤ (match a.heap.load (a.rdi.toBitVec + 8) .W64 with | .ok v => UInt64.ofBitVec v | _ => 0) then (match a.heap.load (a.rdi.toBitVec + 24) .W64 with | .ok v => UInt64.ofBitVec v | _ => 0) else (match a.heap.load (a.rdi.toBitVec + 8) .W64 with | .ok v => UInt64.ofBitVec v | _ => 0))), a.heap⟩ r ∧ Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP self sp tp dp mp src tgt dropped dest pos ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.MapInPlaceStatement.post src tgt dropped dest pos mp a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m := by
  intro self sp tp dp mp frame src tgt dropped dest pos a y v_rax hs hv hy
  have hs' := hs
  obtain ⟨hc, hdi, ha, m, hh⟩ := hs'
  rw [ha] at hh
  obtain ⟨hsp, hslen, htp, htlen, hdp, hmp⟩ := fields self sp tp dp mp frame src tgt dropped dest pos _ _ hh
  have h8 : a.heap.load (a.rdi.toBitVec + 8) .W64 = .ok (BitVec.ofNat 64 src.length) := by
    simpa only [hdi, ha] using hslen
  have h24 : a.heap.load (a.rdi.toBitVec + 24) .W64 = .ok (BitVec.ofNat 64 tgt.length) := by
    simpa only [hdi, ha] using htlen
  have he : v_rax = BitVec.ofNat 64 src.length := Res.ok.inj (hv.symm.trans h8)
  subst v_rax
  simp only [h8, h24]
  simpa only [header, initP] using from_header self sp tp dp mp frame src tgt dropped dest pos a y hs hy


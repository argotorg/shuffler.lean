def initP (a : In2p) : St In2p Heap := ⟨a, a.rax, a.rbx, 0, 0, a.rdi, a.r12, a.r14, a.r15, a.heap⟩

def CalP.In : Cal → Type
  | .c0 => mappingBuilderClosestCopy.In2p
  | .c1 => mappingBuilderMap.In2p

def CalP.Out : Cal → Type
  | .c0 => UInt64

                    = (FlatShuffler.Flat.ExecutionControl.assertionExit, Mj) := by
                  rw [hmbmap, if_pos (by rw [hmapp]; rfl)]
                have hrel : CalP.rel .c1 ⟨x.input.policy, x.mem, UInt64.ofBitVec p, x.r14, UInt64.ofBitVec p, x.rbx, x.input.sp - 40 - 8⟩ ((UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535), x.mem) := by
                  refine ⟨x.mem, x.mem, ?_, ?_, ?_, List.Perm.refl _⟩
                  · exact map_exit_dest b Mj frame a.policy ⟨x.input.policy, x.mem, UInt64.ofBitVec p, x.r14, UInt64.ofBitVec p, x.rbx, x.input.sp - 40 - 8⟩ hmemj (by rw [hx.rbx]; exact hrdi0) (by simpa using hpbound) ⟨m, hholds⟩ hd hD
                  · rw [hmemj]
                  · rw [hmemj]
                exact hEx hmbv hrel
            · have hmapp : FlatShuffler.Flat.mappable b Mj p = false := by
                rw [FlatShuffler.Flat.mappable, show (FlatShuffler.Flat.get b.dropped p == 0) = false from by simpa using hd]
                rfl
              have hmbv : FlatShuffler.Flat.mbMap b Mj p x.r14.toBitVec
                  = (FlatShuffler.Flat.ExecutionControl.assertionExit, Mj) := by
                rw [hmbmap, if_pos (by rw [hmapp]; rfl)]
              have hrel : CalP.rel .c1 ⟨x.input.policy, x.mem, UInt64.ofBitVec p, x.r14, UInt64.ofBitVec p, x.rbx, x.input.sp - 40 - 8⟩ ((UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535), x.mem) := by
                refine ⟨x.mem, x.mem, ?_, ?_, ?_, List.Perm.refl _⟩
                · exact map_exit_dropped b Mj frame a.policy ⟨x.input.policy, x.mem, UInt64.ofBitVec p, x.r14, UInt64.ofBitVec p, x.rbx, x.input.sp - 40 - 8⟩ hmemj (by rw [hx.rbx]; exact hrdi0) (by simpa using hpbound) ⟨m, hholds⟩ hd
                · rw [hmemj]
                · rw [hmemj]
              exact hEx hmbv hrel

/-! ### The remaining plan

The heap after the two stores is `(objsP b M ++ frame).map (Obj.set a2 .W64 p ∘ Obj.set a1 .W64 t)`
(`Heap.store_ok`), with `a1 = 17472 + p*8`, `a2 = 25664 + t*8`; it is a permutation of
`objsP b (M.bind p t) ++ frame` (`perm_objsP_head`, `Obj.set_words64`, `Vector.toList_setIfInBounds`,
`List.perm_middle`). The *frame* part is the only delicate point: its objects must be shown unchanged
by `Obj.set`, which `Heap.store_words64_head` does through `Heap.store_words` (`Replaces`) +
`replaces_eq_of_not_mem` + `not_mem_of_holds`, not through a "not covering" lemma for `Obj.set`. -/

/-! ## Where the proof of `LBB28_1` stands

Proved and in the file (all `sorry`-free):

* The heap layer: `drop_flatMap_eq`, the membership lemmas `mem_*` and the word loads
  `load_targetSize/sourceSize/targetPtr/droppedPtr/mappingPtr/sourcePtr/pos/dest/source/target`,
  the byte loads `loadB_dropped`, `loadB_kind`, `slotWord_mask`, `slotWord_inj`, `slotWord_extract`,
  the `Vector` accessors `get_source/target/dropped/dest/pos`, `loadBytes_agree`,
  `loadB_eq_of_loadBytes`, `cf_pos`/`cf_neg`.
* `absDiff_eq`, `absDiff_code_i`/`absDiff_code_best` (the code's `r14`/`r15` are the `absDiff`s),
  `absDiff_not_le`/`absDiff_le`, `shift32_eq`/`shift32_eq'` (the code's `kind` test is `kind = Junk`),
  `toBitVec_eq_none_iff`, `c0_kind_eq`, `c0_inWildcardSlot_eq`, `c0_cond_true`/`c0_cond_false`.
* **`c0_loop` is complete**: `mappingBuilderClosestCopy` from `.LBB29_1` returns
  `c0Out = ofBitVec (closestFrom b M t inW i best)`; the walk over the 15 blocks of
  `mappingBuilderClosestCopy.blocksP` closes every `hout` with `c0Out_cand`/`c0Out_skip`.
* **`c0_entry`**: `mappingBuilderClosestCopy.blocksP.Returns noCall .entry (initP a0) (c0Out b M (c0E b a0))`,
  and `c0Out_c0E : c0Out b M (c0E b a0) = ofBitVec (closestCopy b M a0.rsi a0.rdx-inW)`
  (`closestCopy b M t inW = closestFrom b M t inW 0 NONE` definitionally).
* **`map_exit_dropped`**: the `mappingBuilderMap` entry exit when `dropped[p] ≠ 0`.

Remaining for the target theorem (in order):

1. `mappingBuilderMap`: the store path (`.o36`), the only missing piece of the map spec. The stores are
   `storeB (17472 + 8p) .W64 t` then `storeB (25664 + 8t) .W64 p` (`17472 + t*8 + 8192 = 25664 + 8*t`
   by `bv_omega`, using `t.toNat < maxStackSize`). The library pieces found for it:
   * `Heap.store h a w v = .ok (List.map (Obj.set a w v) h)` (definition of `Heap.store`), and
     `Obj.set a w v o = if o.writable then {o with cells := setCells …} else o`, so the ten
     read-only objects are untouched;
   * `Obj.set_words64 (hn) (hi) v :
       (Obj.words base true .W64 ys).set (base + i * 8) .W64 v = Obj.words base true .W64 (ys.set i.toNat v)`
     (`Lift/Tactic/LoopSimp.lean`) for the two writable arrays;
   * **`Heap.store_words64_head (hh : Holds policy (Obj.words base true .W64 xs :: frame) m) (hl : ys.length = xs.length)
     (hi) v : Heap.store (Obj.words base true .W64 ys :: frame) (base + i*8) .W64 v
       = .ok (Obj.words base true .W64 (ys.set i.toNat v) :: frame)`** — the store on a heap whose *head*
     is the array, which also proves the frame unchanged. This suggests stating the loop invariant with
     the two arrays at the *head* of the heap list (`heap_norm`/`heap_load`/`list_step` of
     `Lift/Tactic/LoopSimp.lean` are the simp sets for that style: they put the heap of a statement in
     the form `Obj.words … :: frame`);
   * `Heap.store_sound (hh) (hs : h.store a w v = .ok h')` gives
     `∃ m', writeRam pol m a w v = .ok m' ∧ Holds pol h' m' ∧ …`, and `Heap.storeB_of_store` converts
     `store` to `storeB`; `Heap.load_sound` is the load counterpart;
   * **`Heap.store_ok (hs : h.store a w v = .ok h') : h' = List.map (Obj.set a w v) h ∧ …`** computes
     the resulting heap, and **`Heap.Holds_perm (hp : List.Perm h h') : Holds pol h m ↔ Holds pol h' m`**
     lets the heap be reordered: put the array that a store touches at the *head* of the list, apply
     `Heap.store_words64_head`, and reorder back. The same trick applies to the two stores of `.o36`
     (`dest` first, then `pos` after one permutation); the loads only need `o ∈ h`
     (`Heap.load_words64_mul`), so they are insensitive to the order;
   * `FlatShuffler.Flat.Mapping.bind M p t = { dest := put M.dest p t, pos := put M.pos t p }` with
     `put v i x = v.setIfInBounds i.toNat x`, and `objects` has the two mapping objects at positions 11
     and 12 (`⟨17472, M.dest.toList.map …⟩`, `⟨25664, M.pos.toList.map …⟩`), so the resulting heap is
     `objsP b (M.bind p t) ++ frame`.
2. `CalP.rel .c1` needs `PermLift R H H'`; take `h := H`, `h' := H'`: then
   `SamePerm H H' H H'` is `List.Perm.refl` of `List.zip H H'`.
3. The main loop: `Blocks.Returns.loop` at `.LBB28_1` with the measure `b.targetSize.toNat - j.toNat`
   and the invariant: `x.r15 = ofBitVec b.targetSize`, `x.rbx = a.rdi` (`= 0`), `x.r12 = 2^32`,
   `x.r14 = j`, `j.toNat ≤ b.targetSize.toNat`, `x.input = a`,
   `∃ Mj m, x.mem = objsP b Mj ++ frame ∧ x.mem.Holds pol m ∧ closestCopiesFrom b M 0 = closestCopiesFrom b Mj j`,
   plus `∃ m, x.mem.Holds a.policy m` for the callees. `closestCopiesFrom b Mj j` unfolds (with
   `j < b.targetSize`) to the `hasSourceAssigned`/`isWildcardTarget`/`closestCopy`/`mbMap` branches
   that `.o33`/`.o48`/`.o67`/`.o86`/`.o100` test. `mbMap`'s status is
   `.returned _` (code: low 16 bits `0`) or `.assertionExit` (code: `1`), cf. `MapClosestCopiesStatement.result`.
4. The postcondition: `Holds` implies `Mem.has` for the objects of `written b M envOf y`
   (`Bridge.has_iff` + the `Holds.read`/`write`/`noWrap` fields), with `y = mapClosestCopies b M`
   from `run b M = some y`.
-/

theorem mbMap_fst (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (p t : FlatShuffler.Word) :
    (FlatShuffler.Flat.mbMap b M p t).1 = FlatShuffler.Flat.ExecutionControl.done ∨
      (FlatShuffler.Flat.mbMap b M p t).1 = FlatShuffler.Flat.ExecutionControl.assertionExit := by
  rw [FlatShuffler.Flat.mbMap]
  repeat' split
  all_goals simp

theorem closestCopiesFrom_exit (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j : FlatShuffler.Word) :
    (FlatShuffler.Flat.closestCopiesFrom b M j).1 = FlatShuffler.Flat.ExecutionControl.done ∨
      (FlatShuffler.Flat.closestCopiesFrom b M j).1
        = FlatShuffler.Flat.ExecutionControl.assertionExit := by
  refine FlatShuffler.Flat.closestCopiesFrom.induct b (motive := fun M j =>
    (FlatShuffler.Flat.closestCopiesFrom b M j).1 = FlatShuffler.Flat.ExecutionControl.done ∨
      (FlatShuffler.Flat.closestCopiesFrom b M j).1
        = FlatShuffler.Flat.ExecutionControl.assertionExit) ?_ ?_ ?_ ?_ M j
  · intro M j hj hc
    dsimp only
    intro hne
    rw [FlatShuffler.Flat.closestCopiesFrom, dif_pos hj, if_pos hc, if_pos hne]
    rcases mbMap_fst b M (FlatShuffler.Flat.closestCopy b M j false) j with h | h
    · exact absurd h hne
    · exact Or.inr h
  · intro M j hj hc
    dsimp only
    intro hne ih
    rw [FlatShuffler.Flat.closestCopiesFrom, dif_pos hj, if_pos hc, if_neg hne]
    exact ih
  · intro M j hj hc ih
    rw [FlatShuffler.Flat.closestCopiesFrom, dif_pos hj, if_neg hc]
    exact ih
  · intro M j hj
    rw [FlatShuffler.Flat.closestCopiesFrom, dif_neg hj]
    exact Or.inl rfl
end loop

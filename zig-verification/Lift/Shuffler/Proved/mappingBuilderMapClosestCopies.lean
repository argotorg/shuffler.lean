/-! ## The heap of the statement: its objects and the loads of the code -/

/-- The drop of a concatenation of blocks of `n` bytes: the tail of the block at the index `j`. -/
theorem drop_flatMap_eq {α : Type} (f : α → List UInt8) (n : Nat) (h : ∀ a, (f a).length = n)
    (xs : List α) (j k : Nat) (hj : j < xs.length) (hk : k < n) :
    (xs.flatMap f).drop (n * j + k) = (f (xs[j]'hj)).drop k ++ (xs.drop (j + 1)).flatMap f := by
  induction xs generalizing j with
  | nil => simp at hj
  | cons a xs ih =>
    cases j with
    | zero =>
      simp only [List.flatMap_cons, Nat.mul_zero, Nat.zero_add]
      rw [List.drop_append_of_le_length (by rw [h]; omega)]
      rfl
    | succ j =>
      have hj' : j < xs.length := by simpa using hj
      simp only [List.flatMap_cons, Nat.mul_succ, List.getElem_cons_succ]
      rw [List.drop_append, List.drop_eq_nil_of_le (by rw [h]; omega), List.nil_append, h a,
        show n * j + n + k - n = n * j + k by omega]
      exact ih j hj'


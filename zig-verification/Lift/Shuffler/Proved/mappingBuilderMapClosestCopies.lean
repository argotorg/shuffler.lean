    have hlen : M.pos.toList.length = FlatShuffler.maxStackSize := by simp
    have hi : a0.rdx.toBitVec.toNat < M.pos.toList.length := by rw [hlen]; simpa using hrdx
    have hi' : a0.rdx.toNat < M.pos.toList.length := by
      rw [← UInt64.toNat_toBitVec]; exact hi
    have hgd : M.pos.toList.getD a0.rdx.toNat default = M.pos.toList[a0.rdx.toBitVec.toNat]'hi := by
      simp [List.getD, List.getElem?_eq_getElem hi']
    have haddr : 17472 + a0.rdx.toBitVec * 8 + 8192 = 25664 + a0.rdx.toBitVec * 8 := by
      have h1024 : a0.rdx.toBitVec.toNat < 1024 := by
        rw [UInt64.toNat_toBitVec]
        simpa [FlatShuffler.maxStackSize] using hrdx
      bv_omega
    rw [hgd, haddr, hheap]
    exact Heap.loadB_of_load (load_pos b M frame pol m hm' a0.rdx.toBitVec hi)
  have hzero : UInt64.ofBitVec
      (BitVec.zeroExtend 64 (b.dropped.toList.getD a0.rsi.toNat default)) = 0 := by
    have h0 : b.dropped.toList.getD a0.rsi.toNat default = 0 := by
      simpa [get_dropped] using hd
    rw [h0]
    decide
  have hDeq : UInt64.ofBitVec (M.dest.toList.getD a0.rsi.toNat default)
      = 18446744073709551615 := by
    have h1 : M.dest.toList.getD a0.rsi.toNat default = FlatShuffler.Flat.NONE := by
      simpa [get_dest] using hD
    rw [h1]
    decide
  have hPne : UInt64.ofBitVec (M.pos.toList.getD a0.rdx.toNat default) ≠ 18446744073709551615 := by
    intro h
    apply hP
    have h2 : (UInt64.toBitVec 18446744073709551615 : BitVec 64) = FlatShuffler.Flat.NONE := by
      decide
    have h1 := congrArg UInt64.toBitVec h
    rw [h2] at h1
    simpa [get_pos] using h1
  have hstep1 : mappingBuilderMap.blocksP.step .entry (mappingBuilderMap.initP a0)
      = .ok (.goto .o14 (mapE b a0)) := by
    simp only [mappingBuilderMap.blocksP, mappingBuilderMap.initP, mapE, hL1, hL2, if_pos hzero]
  have hstep2 : mappingBuilderMap.blocksP.step .o14 (mapE b a0)
      = .ok (.goto .o25 (mapE2 b a0)) := by
    simp only [mappingBuilderMap.blocksP, mapE, mapE2, hL3, hL4, if_pos hDeq]
  have hstep3 : mappingBuilderMap.blocksP.step .o25 (mapE2 b a0)
      = .ok (.goto .LBB25_4 (mapE2 b a0)) := by
    simp only [mappingBuilderMap.blocksP, mapE2, hL5, if_neg hPne]
  exact Blocks.Returns.goto hstep1
    (Blocks.Returns.goto hstep2
      (Blocks.Returns.goto hstep3
        (Blocks.Returns.ret (by simp only [mappingBuilderMap.blocksP, mapE2]))))

/-- The two writable arrays are the last two objects of `objsP`. -/
theorem objsP_split (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    objsP b M
      = ((List.take 10 (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects b M
            Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf)).map toObj)
        ++ [Obj.words 17472 true .W64 M.dest.toList, Obj.words 25664 true .W64 M.pos.toList] := by
  simp only [objsP]
  rw [← List.take_append_drop 10 (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects
    b M Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf), List.map_append]
  congr 1
  simp [Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects,
    Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf, Lift.Sem.Bridge.toObj,
    Lift.Sem.Bridge.toCell, Obj.words, FlatShuffler.Flat.Mapping.dest, FlatShuffler.Flat.Mapping.pos]

/-- The two writable arrays are the last two objects of `objsP`; the heap with them at the head. -/
theorem perm_objsP_head (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (frame : Heap) :
    List.Perm (objsP b M ++ frame)
      (Obj.words 17472 true .W64 M.dest.toList :: Obj.words 25664 true .W64 M.pos.toList
        :: (List.map toObj (List.take 10
              (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects b M
                Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf)) ++ frame)) := by
  rw [objsP_split b M]
  have h : ((List.map toObj (List.take 10
        (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects b M
          Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf))
      ++ [Obj.words 17472 true .W64 M.dest.toList, Obj.words 25664 true .W64 M.pos.toList]) ++ frame)
      = (List.map toObj (List.take 10
          (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects b M
            Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf))
        ++ Obj.words 17472 true .W64 M.dest.toList :: Obj.words 25664 true .W64 M.pos.toList :: frame) := by
    simp
  rw [h]
  exact List.perm_middle.trans (List.Perm.cons _ List.perm_middle)

/-! ### The bound of `closestCopy` -/

theorem closestFrom_bound (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (t : FlatShuffler.Word) (inW : Bool) :
    ∀ (i best : FlatShuffler.Word),
      (best = FlatShuffler.Flat.NONE ∨ best.toNat < b.sourceSize.toNat) →
      FlatShuffler.Flat.closestFrom b M t inW i best = FlatShuffler.Flat.NONE ∨
        (FlatShuffler.Flat.closestFrom b M t inW i best).toNat < b.sourceSize.toNat := by
  intro i best
  refine FlatShuffler.Flat.closestFrom.induct b M t inW
    (motive := fun i best =>
      (best = FlatShuffler.Flat.NONE ∨ best.toNat < b.sourceSize.toNat) →
      FlatShuffler.Flat.closestFrom b M t inW i best = FlatShuffler.Flat.NONE ∨
        (FlatShuffler.Flat.closestFrom b M t inW i best).toNat < b.sourceSize.toNat) ?_ ?_ i best
  · intro i best hi
    dsimp only
    intro ih hb
    have hi' : i.toNat < b.sourceSize.toNat := hi
    rw [cf_pos hi']
    refine ih ?_
    split
    · split
      · exact Or.inr hi'
      · exact hb
    · exact hb
  · intro i best hi hb
    rw [cf_neg (M := M) (t := t) (inW := inW) (best := best) hi]
    exact hb

theorem closestCopy_bound (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (t : FlatShuffler.Word) (inW : Bool) :
    FlatShuffler.Flat.closestCopy b M t inW = FlatShuffler.Flat.NONE ∨
      (FlatShuffler.Flat.closestCopy b M t inW).toNat < b.sourceSize.toNat :=
  closestFrom_bound b M t inW 0 FlatShuffler.Flat.NONE (Or.inl rfl)

/-! ### The store of one word of the two writable arrays -/

theorem front_all (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    ((List.take 10 (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects b M
      Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf)).map toObj).all
        (fun o => !o.writable) = true := by
  simp only [Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects,
    Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf, List.take_succ_cons,
    List.take_zero, List.map_cons, List.map_nil, List.all_cons, List.all_nil, Bool.not_false,
    Bool.and_true, Bool.true_and, Lift.Sem.Bridge.toObj]

theorem mem_front_writable (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    {o : Obj} (ho : o ∈ (List.take 10 (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects
      b M Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf)).map toObj) :
    o.writable = false := by
  have := (List.all_eq_true.mp (front_all b M)) o ho
  simpa using this

theorem Obj.set_of_not_writable {o : Obj} (hw : o.writable = false) (a : BitVec 64)
    (w : Width) (v : w.type) : o.set a w v = o := by
  unfold Obj.set
  rw [hw]
  rfl

theorem Obj.set_eq_self_of_no_match {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (h : ∀ x ∈ offsets 0 o.cells, ¬ (o.addr + BitVec.ofNat 64 x.1 = a ∧ x.2.w = w)) :
    o.set a w v = o := by
  unfold Obj.set
  split
  · show ({ o with cells := _ } : Obj) = o
    rw [setCells_of_no_match]
    exact h
  · rfl

theorem words_ne_of_addr_ne {base base' : BitVec 64} (h : base ≠ base') (wr : Bool) (w : Width)
    (xs : List w.type) : Obj.words base wr w xs ≠ Obj.words base' wr w xs := by
  intro e
  exact h (congrArg Obj.addr e)

/-! ### The two arrays of `objsP` -/

abbrev destObj (M : FlatShuffler.Flat.Mapping) : Obj := Obj.words 17472 true .W64 M.dest.toList

abbrev posObj (M : FlatShuffler.Flat.Mapping) : Obj := Obj.words 25664 true .W64 M.pos.toList

abbrev frontObj (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) : Heap :=
  (List.take 10 (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects b M
    Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf)).map toObj

theorem objsP_split' (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    objsP b M = frontObj b M ++ [destObj M, posObj M] := objsP_split b M

theorem frontObj_congr (b : FlatShuffler.Flat.Builder) (M M' : FlatShuffler.Flat.Mapping) :
    frontObj b M = frontObj b M' := by
  simp [frontObj, Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects,
    Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf]

theorem destObj_size (M : FlatShuffler.Flat.Mapping) :
    (destObj M).size = 8 * FlatShuffler.maxStackSize := by
  rw [destObj, Obj.size, Obj.words, words_bytes, Vector.length_toList]

theorem posObj_size (M : FlatShuffler.Flat.Mapping) :
    (posObj M).size = 8 * FlatShuffler.maxStackSize := by
  rw [posObj, Obj.size, Obj.words, words_bytes, Vector.length_toList]

theorem destObj_ne_posObj (M : FlatShuffler.Flat.Mapping) : destObj M ≠ posObj M := by
  intro e
  have h : (destObj M).addr = (posObj M).addr := congrArg Obj.addr e
  have h' : (17472 : BitVec 64) = 25664 := h
  exact absurd h' (by decide)

theorem destObj_off (M : FlatShuffler.Flat.Mapping) {p : BitVec 64}
    (hp : p.toNat < FlatShuffler.maxStackSize) :
    (destObj M).addr + BitVec.ofNat 64 (8 * p.toNat) = 17472 + p * 8 := by
  show (17472 : BitVec 64) + BitVec.ofNat 64 (8 * p.toNat) = 17472 + p * 8
  congr 1
  apply BitVec.eq_of_toNat_eq
  simp [BitVec.toNat_mul, Nat.mul_comm]

theorem posObj_off (M : FlatShuffler.Flat.Mapping) {t : BitVec 64}
    (ht : t.toNat < FlatShuffler.maxStackSize) :
    (posObj M).addr + BitVec.ofNat 64 (8 * t.toNat) = 25664 + t * 8 := by
  show (25664 : BitVec 64) + BitVec.ofNat 64 (8 * t.toNat) = 25664 + t * 8
  congr 1
  apply BitVec.eq_of_toNat_eq
  simp [BitVec.toNat_mul, Nat.mul_comm]

theorem destObj_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap) :
    destObj M ∈ objsP b M ++ frame := by
  rw [objsP_split']; simp

theorem posObj_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap) :
    posObj M ∈ objsP b M ++ frame := by
  rw [objsP_split']; simp

theorem frontObj_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    {o : Obj} (ho : o ∈ frontObj b M) : o ∈ objsP b M ++ frame := by
  rw [objsP_split']
  exact List.mem_append_left _ (List.mem_append_left _ ho)

theorem destObj_not_mem_frame (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : (objsP b M ++ frame).Holds pol m) : destObj M ∉ frame := by
  have hperm : List.Perm (objsP b M ++ frame) (destObj M :: posObj M :: (frontObj b M ++ frame)) := by
    rw [objsP_split']
    have : (frontObj b M ++ [destObj M, posObj M]) ++ frame
        = frontObj b M ++ destObj M :: posObj M :: frame := by simp
    rw [this]
    exact List.perm_middle.trans (List.Perm.cons _ List.perm_middle)
  have hnm : destObj M ∉ (posObj M :: (frontObj b M ++ frame)) :=
    not_mem_of_holds ((Heap.Holds_perm hperm).mp hh) rfl (by rw [destObj_size]; decide)
  intro h
  exact hnm (List.mem_cons_of_mem _ (List.mem_append_right _ h))

theorem posObj_not_mem_frame (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : (objsP b M ++ frame).Holds pol m) : posObj M ∉ frame := by
  have hperm : List.Perm (objsP b M ++ frame) (posObj M :: destObj M :: (frontObj b M ++ frame)) := by
    rw [objsP_split']
    have h1 : (frontObj b M ++ [destObj M, posObj M]) ++ frame
        = frontObj b M ++ destObj M :: posObj M :: frame := by simp
    rw [h1]
    exact (List.perm_middle.trans (List.Perm.cons _ List.perm_middle)).trans
      (List.Perm.swap (posObj M) (destObj M) (frontObj b M ++ frame))
  have hnm : posObj M ∉ (destObj M :: (frontObj b M ++ frame)) :=
    not_mem_of_holds ((Heap.Holds_perm hperm).mp hh) rfl (by rw [posObj_size]; decide)
  intro h
  exact hnm (List.mem_cons_of_mem _ (List.mem_append_right _ h))

/-! ### The store of one word of `dest` and of `pos` -/

theorem objsP_store_dest (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : (objsP b M ++ frame).Holds pol m)
    (p : BitVec 64) (hp : p.toNat < FlatShuffler.maxStackSize) (v : BitVec 64) :
    (objsP b M ++ frame).store (17472 + p * 8) .W64 v =
      .ok (objsP b { M with dest := M.dest.setIfInBounds p.toNat v } ++ frame) := by
  have hnotmem := destObj_not_mem_frame b M frame pol m hh
  have hp' : p.toNat < M.dest.toList.length := by simpa [Vector.length_toList] using hp
  have hx0 : (8 * p.toNat, (⟨.W64, M.dest.toList[p.toNat]'hp'⟩ : Cell)) ∈ offsets 0 (destObj M).cells := by
    have := mem_offsets_words .W64 M.dest.toList 0 p.toNat hp'
    simpa [destObj, Obj.words] using this
  have hoff := destObj_off M hp
  have hset : ∀ o ∈ objsP b M ++ frame, o ≠ destObj M →
      Obj.set (17472 + p * 8) .W64 v o = o := by
    intro o ho hne
    rw [← hoff]
    exact Heap.Holds.set_other hh (destObj_mem b M frame) rfl hx0 ho hne v
  obtain ⟨h', hst, -⟩ := Heap.store_words64 (h := objsP b M ++ frame) (m := m)
    (base := 17472) (xs := M.dest.toList) hh (destObj_mem b M frame) hp' v
  rw [BitVec.mul_comm (8 : BitVec 64) p] at hst
  have hmap := (Heap.store_ok hst).1
  have hfr : ∀ o ∈ frontObj b M, Obj.set (17472 + p * 8) .W64 v o = o :=
    fun o ho => Obj.set_of_not_writable (mem_front_writable b M ho) _ _ _
  have hframe : ∀ o ∈ frame, Obj.set (17472 + p * 8) .W64 v o = o := by
    intro o ho
    exact hset o (List.mem_append_right _ ho) (fun e => hnotmem (e ▸ ho))
  have hdest : Obj.set (17472 + p * 8) .W64 v (destObj M)
      = Obj.words 17472 true .W64 (M.dest.toList.set p.toNat v) :=
    Obj.set_words64 (by rw [Vector.length_toList, FlatShuffler.maxStackSize]; decide) hp' v
  have hpos : Obj.set (17472 + p * 8) .W64 v (posObj M) = posObj M := by
    refine hset (posObj M) (posObj_mem b M frame) ?_
    exact fun e => destObj_ne_posObj M e.symm
  rw [hst, hmap, objsP_split' (b := b) (M := M),
    objsP_split' (b := b) (M := { M with dest := M.dest.setIfInBounds p.toNat v })]
  rw [show frontObj b { M with dest := M.dest.setIfInBounds p.toNat v } = frontObj b M from
    (frontObj_congr b M { M with dest := M.dest.setIfInBounds p.toNat v }).symm]
  simp only [List.map_append, List.map_cons, List.map_nil]
  rw [List.map_congr_left hfr, List.map_id', List.map_congr_left hframe, List.map_id',
    hdest, hpos]
  simp [destObj, posObj, Vector.toList_setIfInBounds]

theorem objsP_store_pos (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : (objsP b M ++ frame).Holds pol m)
    (t : BitVec 64) (ht : t.toNat < FlatShuffler.maxStackSize) (v : BitVec 64) :
    (objsP b M ++ frame).store (25664 + t * 8) .W64 v =
      .ok (objsP b { M with pos := M.pos.setIfInBounds t.toNat v } ++ frame) := by
  have hnotmem := posObj_not_mem_frame b M frame pol m hh
  have ht' : t.toNat < M.pos.toList.length := by simpa [Vector.length_toList] using ht
  have hx0 : (8 * t.toNat, (⟨.W64, M.pos.toList[t.toNat]'ht'⟩ : Cell)) ∈ offsets 0 (posObj M).cells := by
    have := mem_offsets_words .W64 M.pos.toList 0 t.toNat ht'
    simpa [posObj, Obj.words] using this
  have hoff := posObj_off M ht
  have hset : ∀ o ∈ objsP b M ++ frame, o ≠ posObj M →
      Obj.set (25664 + t * 8) .W64 v o = o := by
    intro o ho hne
    rw [← hoff]
    exact Heap.Holds.set_other hh (posObj_mem b M frame) rfl hx0 ho hne v
  obtain ⟨h', hst, -⟩ := Heap.store_words64 (h := objsP b M ++ frame) (m := m)
    (base := 25664) (xs := M.pos.toList) hh (posObj_mem b M frame) ht' v
  rw [BitVec.mul_comm (8 : BitVec 64) t] at hst
  have hmap := (Heap.store_ok hst).1
  have hfr : ∀ o ∈ frontObj b M, Obj.set (25664 + t * 8) .W64 v o = o :=
    fun o ho => Obj.set_of_not_writable (mem_front_writable b M ho) _ _ _
  have hframe : ∀ o ∈ frame, Obj.set (25664 + t * 8) .W64 v o = o := by
    intro o ho
    exact hset o (List.mem_append_right _ ho) (fun e => hnotmem (e ▸ ho))
  have hdest : Obj.set (25664 + t * 8) .W64 v (destObj M) = destObj M := by
    refine hset (destObj M) (destObj_mem b M frame) ?_
    exact fun e => destObj_ne_posObj M e
  have hpos : Obj.set (25664 + t * 8) .W64 v (posObj M)
      = Obj.words 25664 true .W64 (M.pos.toList.set t.toNat v) :=
    Obj.set_words64 (by rw [Vector.length_toList, FlatShuffler.maxStackSize]; decide) ht' v
  rw [hst, hmap, objsP_split' (b := b) (M := M),
    objsP_split' (b := b) (M := { M with pos := M.pos.setIfInBounds t.toNat v })]
  rw [show frontObj b { M with pos := M.pos.setIfInBounds t.toNat v } = frontObj b M from
    (frontObj_congr b M { M with pos := M.pos.setIfInBounds t.toNat v }).symm]
  simp only [List.map_append, List.map_cons, List.map_nil]
  rw [List.map_congr_left hfr, List.map_id', List.map_congr_left hframe, List.map_id',
    hdest, hpos]
  simp [destObj, posObj, Vector.toList_setIfInBounds]

/-! ### The two stores of `.o36` of `mappingBuilderMap` -/

/-- `mappingBuilderMap` when `dropped[p] = 0`, `dest[p] = NONE`, `pos[t] = NONE`: the two stores. -/
theorem map_store (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (frame : Heap) (pol : CpuPolicy) (a0 : mappingBuilderMap.In2p)
    (hheap : a0.heap = objsP b M ++ frame) (hrdi : a0.rdi.toBitVec = 0)
    (hrsi : a0.rsi.toNat < FlatShuffler.maxStackSize)
    (hrdx : a0.rdx.toNat < FlatShuffler.maxStackSize)
    (hholds : ∃ m, a0.heap.Holds pol m)
    (hd : FlatShuffler.Flat.get b.dropped a0.rsi.toBitVec = 0)
    (hD : FlatShuffler.Flat.get M.dest a0.rsi.toBitVec = FlatShuffler.Flat.NONE)
    (hP : FlatShuffler.Flat.get M.pos a0.rdx.toBitVec = FlatShuffler.Flat.NONE) :
    mappingBuilderMap.blocksP.Returns noCall .entry (mappingBuilderMap.initP a0)
      (0, objsP b (M.bind a0.rsi.toBitVec a0.rdx.toBitVec) ++ frame) := by
  obtain ⟨m, hm⟩ := hholds
  have hm' : (objsP b M ++ frame).Holds pol m := by rw [← hheap]; exact hm
  have hL1 : a0.heap.loadB (a0.rdi.toBitVec + 32) .W64 = .ok 16448 := by
    rw [hrdi, hheap]
    simpa using Heap.loadB_of_load (load_droppedPtr b M frame pol m hm')
  have hL2 : a0.heap.loadB (16448 + a0.rsi.toBitVec * 1) .W8
      = .ok (b.dropped.toList.getD a0.rsi.toNat default) := by
    rw [hheap]
    simpa using loadB_dropped b M frame pol m hm' a0.rsi.toBitVec (by simpa using hrsi)
  have hL3 : a0.heap.loadB (a0.rdi.toBitVec + 48) .W64 = .ok 17472 := by
    rw [hrdi, hheap]
    simpa using Heap.loadB_of_load (load_mappingPtr b M frame pol m hm')
  have hL4 : a0.heap.loadB (17472 + a0.rsi.toBitVec * 8) .W64
      = .ok (M.dest.toList.getD a0.rsi.toNat default) := by
    have hlen : M.dest.toList.length = FlatShuffler.maxStackSize := by simp
    have hi : a0.rsi.toBitVec.toNat < M.dest.toList.length := by rw [hlen]; simpa using hrsi
    have hi' : a0.rsi.toNat < M.dest.toList.length := by
      rw [← UInt64.toNat_toBitVec]; exact hi
    have hgd : M.dest.toList.getD a0.rsi.toNat default = M.dest.toList[a0.rsi.toBitVec.toNat]'hi := by
      simp [List.getD, List.getElem?_eq_getElem hi']
    rw [hgd, hheap]
    exact Heap.loadB_of_load (load_dest b M frame pol m hm' a0.rsi.toBitVec hi)
  have hL5 : a0.heap.loadB (17472 + a0.rdx.toBitVec * 8 + 8192) .W64
      = .ok (M.pos.toList.getD a0.rdx.toNat default) := by
    have hlen : M.pos.toList.length = FlatShuffler.maxStackSize := by simp
    have hi : a0.rdx.toBitVec.toNat < M.pos.toList.length := by rw [hlen]; simpa using hrdx
    have hi' : a0.rdx.toNat < M.pos.toList.length := by
      rw [← UInt64.toNat_toBitVec]; exact hi
    have hgd : M.pos.toList.getD a0.rdx.toNat default = M.pos.toList[a0.rdx.toBitVec.toNat]'hi := by
      simp [List.getD, List.getElem?_eq_getElem hi']
    have haddr : 17472 + a0.rdx.toBitVec * 8 + 8192 = 25664 + a0.rdx.toBitVec * 8 := by
      have h1024 : a0.rdx.toBitVec.toNat < 1024 := by
        rw [UInt64.toNat_toBitVec]
        simpa [FlatShuffler.maxStackSize] using hrdx
      bv_omega
    rw [hgd, haddr, hheap]
    exact Heap.loadB_of_load (load_pos b M frame pol m hm' a0.rdx.toBitVec hi)
  have hzero : UInt64.ofBitVec
      (BitVec.zeroExtend 64 (b.dropped.toList.getD a0.rsi.toNat default)) = 0 := by
    have h0 : b.dropped.toList.getD a0.rsi.toNat default = 0 := by
      simpa [get_dropped] using hd
    rw [h0]
    decide
  have hDeq : UInt64.ofBitVec (M.dest.toList.getD a0.rsi.toNat default)
      = 18446744073709551615 := by
    have h1 : M.dest.toList.getD a0.rsi.toNat default = FlatShuffler.Flat.NONE := by
      simpa [get_dest] using hD
    rw [h1]
    decide
  have hPeq : UInt64.ofBitVec (M.pos.toList.getD a0.rdx.toNat default)
      = 18446744073709551615 := by
    have h1 : M.pos.toList.getD a0.rdx.toNat default = FlatShuffler.Flat.NONE := by
      simpa [get_pos] using hP
    rw [h1]
    decide
  have hstep1 : mappingBuilderMap.blocksP.step .entry (mappingBuilderMap.initP a0)
      = .ok (.goto .o14 (mapE b a0)) := by
    simp only [mappingBuilderMap.blocksP, mappingBuilderMap.initP, mapE, hL1, hL2, if_pos hzero]
  have hstep2 : mappingBuilderMap.blocksP.step .o14 (mapE b a0)
      = .ok (.goto .o25 (mapE2 b a0)) := by
    simp only [mappingBuilderMap.blocksP, mapE, mapE2, hL3, hL4, if_pos hDeq]
  have hstep3 : mappingBuilderMap.blocksP.step .o25 (mapE2 b a0)
      = .ok (.goto .o36 (mapE2 b a0)) := by
    simp only [mappingBuilderMap.blocksP, mapE2, hL5, if_pos hPeq]
  have hst1 : a0.heap.storeB (17472 + a0.rsi.toBitVec * 8) .W64 a0.rdx.toBitVec
      = .ok (objsP b { M with dest := M.dest.setIfInBounds a0.rsi.toBitVec.toNat a0.rdx.toBitVec }
          ++ frame) := by
    rw [hheap]
    exact Heap.storeB_of_store
      (objsP_store_dest b M frame pol m hm' a0.rsi.toBitVec hrsi a0.rdx.toBitVec)
  obtain ⟨m1, -, hm1, -⟩ := Heap.store_sound hm'
    (objsP_store_dest b M frame pol m hm' a0.rsi.toBitVec hrsi a0.rdx.toBitVec)
  have hst2 : (objsP b { M with dest := M.dest.setIfInBounds a0.rsi.toBitVec.toNat a0.rdx.toBitVec }
        ++ frame).storeB (17472 + a0.rdx.toBitVec * 8 + 8192) .W64 a0.rsi.toBitVec
      = .ok (objsP b (M.bind a0.rsi.toBitVec a0.rdx.toBitVec) ++ frame) := by
    have haddr : 17472 + a0.rdx.toBitVec * 8 + 8192 = 25664 + a0.rdx.toBitVec * 8 := by
      have h1024 : a0.rdx.toBitVec.toNat < 1024 := by
        rw [UInt64.toNat_toBitVec]
        simpa [FlatShuffler.maxStackSize] using hrdx
      bv_omega
    rw [haddr]
    refine Heap.storeB_of_store ?_
    have h := objsP_store_pos b { M with dest := M.dest.setIfInBounds a0.rsi.toBitVec.toNat a0.rdx.toBitVec }
      frame pol m1 hm1 a0.rdx.toBitVec hrdx a0.rsi.toBitVec
    simpa [FlatShuffler.Flat.Mapping.bind, FlatShuffler.Flat.put] using h
  have hstep4 : mappingBuilderMap.blocksP.step .o36 (mapE2 b a0) = .ok (.goto .LBB25_4 { mapE2 b a0 with rax := 0, mem := objsP b (M.bind a0.rsi.toBitVec a0.rdx.toBitVec) ++ frame }) := by
    simp only [mappingBuilderMap.blocksP, mapE2, hst1, hst2, UInt64.toBitVec_ofBitVec]
  have hstep5 : mappingBuilderMap.blocksP.step .LBB25_4 { mapE2 b a0 with rax := 0, mem := objsP b (M.bind a0.rsi.toBitVec a0.rdx.toBitVec) ++ frame } = .ok (.ret (0, objsP b (M.bind a0.rsi.toBitVec a0.rdx.toBitVec) ++ frame)) := by
    simp only [mappingBuilderMap.blocksP]
  exact Blocks.Returns.goto hstep1 (Blocks.Returns.goto hstep2 (Blocks.Returns.goto hstep3
    (Blocks.Returns.goto hstep4 (Blocks.Returns.ret hstep5))))

/-! ### The main loop of `mapClosestCopies` -/

theorem ofBitVec_ne_none {v : BitVec 64} (h : v ≠ FlatShuffler.Flat.NONE) :
    UInt64.ofBitVec v ≠ 18446744073709551615 := by
  intro e
  exact h ((ofBitVec_eq_ones v).mp e)

theorem load_pos_at (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (m : DataMem) (hh : (objsP b M ++ frame).Holds pol m)
    (rdi : BitVec 64) (hrdi : rdi = 0) (j : BitVec 64)
    (hj : j.toNat < FlatShuffler.maxStackSize) :
    (objsP b M ++ frame).loadB (rdi + 48) .W64 = .ok 17472 ∧
      (objsP b M ++ frame).loadB (17472 + j * 8 + 8192) .W64
        = .ok (M.pos.toList.getD j.toNat default) := by
  constructor
  · rw [hrdi]
    simpa using Heap.loadB_of_load (load_mappingPtr b M frame pol m hh)
  · have hj' : j.toNat < M.pos.toList.length := by simpa using hj
    have h1024 : j.toNat < 1024 := by simpa [FlatShuffler.maxStackSize] using hj
    have haddr : 17472 + j * 8 + 8192 = 25664 + j * 8 := by bv_omega
    rw [haddr]
    have hgd : M.pos.toList.getD j.toNat default = M.pos.toList[j.toNat]'hj' := by
      simp [List.getD, List.getElem?_eq_getElem hj']
    rw [hgd]
    exact Heap.loadB_of_load (load_pos b M frame pol m hh j hj')

theorem load_kind_at (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (m : DataMem) (hh : (objsP b M ++ frame).Holds pol m)
    (rdi : BitVec 64) (hrdi : rdi = 0) (j : BitVec 64)
    (hj : j.toNat < FlatShuffler.maxStackSize) :
    (objsP b M ++ frame).loadB (rdi + 16) .W64 = .ok 8256 ∧
      (objsP b M ++ frame).loadB (8256 + j * 8 + 4) .W8
        = .ok (b.target.toList.getD j.toNat default).kind := by
  constructor
  · rw [hrdi]
    simpa using Heap.loadB_of_load (load_targetPtr b M frame pol m hh)
  · have hj' : j.toNat < FlatShuffler.maxStackSize := hj
    exact loadB_kind b M frame pol m hh j hj'

/-! ### The invariant of the main loop -/

structure LoopInv (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (a : In2p) (x : St In2p Heap) : Prop where
  input : x.input = a
  rbx : x.rbx = a.rdi
  r12 : x.r12 = 4294967296
  r15 : x.r15 = UInt64.ofBitVec b.targetSize
  r14 : x.r14.toBitVec.toNat ≤ b.targetSize.toNat
  mem : ∃ Mj m, x.mem = objsP b Mj ++ frame ∧ x.mem.Holds a.policy m ∧
    FlatShuffler.Flat.closestCopiesFrom b M 0 = FlatShuffler.Flat.closestCopiesFrom b Mj x.r14.toBitVec

theorem objsP_len (b : FlatShuffler.Flat.Builder) (M M' : FlatShuffler.Flat.Mapping) :
    (objsP b M).length = (objsP b M').length := by
  simp [objsP, Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects,
    Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf]

def loopMu (b : FlatShuffler.Flat.Builder) (x : St In2p Heap) : Nat :=
  b.targetSize.toNat - x.r14.toBitVec.toNat

def loopRax (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) : BitVec 16 :=
  if (FlatShuffler.Flat.closestCopiesFrom b M 0).1 = FlatShuffler.Flat.ExecutionControl.done
    then 0 else 1

def loopHeap (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap) : Heap :=
  objsP b (FlatShuffler.Flat.closestCopiesFrom b M 0).2 ++ frame

theorem loop_step_r14 (s : St In2p Heap) :
    ({ s with r14 := s.r14 + 1 } : St In2p Heap).r14.toBitVec = s.r14.toBitVec + 1 := by
  show (s.r14 + 1).toBitVec = s.r14.toBitVec + 1
  rw [UInt64.toBitVec_add]
  rfl

theorem loop_main (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (a : In2p) (hC : Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.C b M)
    (hrdi0 : a.rdi.toBitVec = 0) :
    ∀ (n : Nat) (x : St In2p Heap), LoopInv b M frame a x → loopMu b x = n →
      ∃ r, blocksP.Returns CalP.rel .LBB28_1 x r ∧ r.2 = loopHeap b M frame ∧
        r.1.toBitVec.setWidth 16 = loopRax b M := by
  intro n
  induction n using Nat.strongRecOn with
  | ind n ih =>
    intro x hx hμ
    obtain ⟨Mj, m, hmemj, hholds, habs⟩ := hx.mem
    have hCj : Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.C b Mj := hC
    by_cases hcase : x.r15 = x.r14
    · -- `j = targetSize`
      have hj : x.r14.toBitVec = b.targetSize := by
        rw [← hcase, hx.r15, UInt64.toBitVec_ofBitVec]
      have hdone : FlatShuffler.Flat.closestCopiesFrom b Mj x.r14.toBitVec
          = (FlatShuffler.Flat.ExecutionControl.done, Mj) := by
        rw [FlatShuffler.Flat.closestCopiesFrom, dif_neg]
        rw [hj]; exact Nat.lt_irrefl _
      have habs' : FlatShuffler.Flat.closestCopiesFrom b M 0
          = (FlatShuffler.Flat.ExecutionControl.done, Mj) := by rw [habs, hdone]
      have hs1 : blocksP.step .LBB28_1 x = .ok (.goto .LBB28_2 x) := by
        simp only [blocksP, if_pos hcase]
      have hs2 : blocksP.step .LBB28_2 x = .ok (.goto .LBB28_3 { x with rax := 0 }) := by
        simp only [blocksP]
      have hs3 : blocksP.step .LBB28_3 { x with rax := 0 } = .ok (.ret (0, x.mem)) := by
        simp only [blocksP]
      refine ⟨(0, x.mem), Blocks.Returns.goto hs1 (Blocks.Returns.goto hs2 (Blocks.Returns.ret hs3)),
        ?_, ?_⟩
      · have hh : loopHeap b M frame = objsP b Mj ++ frame := by rw [loopHeap, habs']
        rw [hh]
        show x.mem = objsP b Mj ++ frame
        exact hmemj
      · have hh : loopRax b M = 0 := by rw [loopRax, habs']; simp
        rw [hh]
        simp
    · -- `j < targetSize`
      have hne : x.r15 ≠ x.r14 := hcase
      have h2 : x.r14.toBitVec ≠ b.targetSize := by
        intro e
        exact hne (by rw [hx.r15]; exact (UInt64.ofBitVec_eq_iff_eq_toBitVec).mpr e.symm)
      have hjlt : x.r14.toBitVec.toNat < b.targetSize.toNat := by
        have h1 := hx.r14
        have h2' : x.r14.toBitVec.toNat ≠ b.targetSize.toNat :=
          fun he => h2 (BitVec.eq_of_toNat_eq he)
        omega
      have hjmax : x.r14.toBitVec.toNat < FlatShuffler.maxStackSize := by
        have h1 := hx.r14
        have h3 := hC.2
        omega
      have hj1024 : x.r14.toBitVec.toNat < 1024 := by
        simpa [FlatShuffler.maxStackSize] using hjmax
      have hjbv : x.r14.toBitVec < b.targetSize := by bv_omega
      have hs1o : blocksP.step .LBB28_1 x = .ok (.goto .o33 x) := by
        simp only [blocksP, if_neg hcase]
      have hlt' : x.r14.toBitVec.toNat < b.sourceSize.toNat ∨ x.r14.toBitVec.toNat < 1024 :=
        Or.inr hj1024
      have hback : ∀ (y : St In2p Heap) (Mj' : FlatShuffler.Flat.Mapping) (m' : DataMem),
          y.input = x.input → y.rbx = x.rbx → y.r12 = x.r12 → y.r15 = x.r15 → y.r14 = x.r14 →
          y.mem = objsP b Mj' ++ frame → y.mem.Holds a.policy m' →
          FlatShuffler.Flat.closestCopiesFrom b M 0
            = FlatShuffler.Flat.closestCopiesFrom b Mj' (x.r14.toBitVec + 1) →
          ∃ r, blocksP.Returns CalP.rel .LBB28_5 y r ∧ r.2 = loopHeap b M frame ∧
            r.1.toBitVec.setWidth 16 = loopRax b M := by
        intro y Mj' m' hin hrbx hr12 hr15 hr14 hmem hholds' hcont
        have hs5 : blocksP.step .LBB28_5 y = .ok (.goto .LBB28_1 { y with r14 := y.r14 + 1 }) := by
          simp only [blocksP]
        have hy : LoopInv b M frame a { y with r14 := y.r14 + 1 } := by
          refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
          · rw [hin]; exact hx.input
          · rw [hrbx]; exact hx.rbx
          · rw [hr12]; exact hx.r12
          · rw [hr15]; exact hx.r15
          · rw [loop_step_r14, hr14]
            have h1 := hx.r14
            have e10 : (x.r14.toBitVec + 1).toNat = x.r14.toBitVec.toNat + 1 := by bv_omega
            rw [e10]; omega
          · exact ⟨Mj', m', hmem, hholds', by rw [loop_step_r14, hr14]; exact hcont⟩
        have hlt : loopMu b { y with r14 := y.r14 + 1 } < loopMu b x := by
          unfold loopMu
          rw [loop_step_r14, hr14]
          have h1 := hx.r14
          have h2' : x.r14.toBitVec.toNat ≠ b.targetSize.toNat :=
            fun he => h2 (BitVec.eq_of_toNat_eq he)
          have e10 : (x.r14.toBitVec + 1).toNat = x.r14.toBitVec.toNat + 1 := by bv_omega
          rw [e10]; omega
        obtain ⟨r, hr, h1', h2''⟩ := ih _ (hμ ▸ hlt) _ hy rfl
        exact ⟨r, Blocks.Returns.goto hs5 hr, h1', h2''⟩
      -- the loads of the two branches
      obtain ⟨hL33a, hL33b⟩ := load_pos_at b Mj frame a.policy m (hmemj ▸ hholds) x.rbx.toBitVec
        (by rw [hx.rbx, hrdi0]) x.r14.toBitVec hjmax
      obtain ⟨hL48a, hL48b⟩ := load_kind_at b Mj frame a.policy m (hmemj ▸ hholds) x.rbx.toBitVec
        (by rw [hx.rbx, hrdi0]) x.r14.toBitVec hjmax
      have hL33a' : x.mem.loadB (x.rbx.toBitVec + 48) .W64 = .ok 17472 := by
        rw [hmemj]; exact hL33a
      have hL33b' : x.mem.loadB (17472 + x.r14.toBitVec * 8 + 8192) .W64
          = .ok (Mj.pos.toList.getD x.r14.toBitVec.toNat default) := by
        rw [hmemj]; exact hL33b
      have hL48a' : x.mem.loadB (x.rbx.toBitVec + 16) .W64 = .ok 8256 := by
        rw [hmemj]; exact hL48a
      have hL48b' : x.mem.loadB (8256 + x.r14.toBitVec * 8 + 4) .W8
          = .ok (b.target.toList.getD x.r14.toBitVec.toNat default).kind := by
        rw [hmemj]; exact hL48b
      have hkindget : FlatShuffler.Flat.get b.target x.r14.toBitVec
          = b.target.toList.getD x.r14.toBitVec.toNat default := get_target b x.r14.toBitVec
      have hgetpos : FlatShuffler.Flat.get Mj.pos x.r14.toBitVec
          = Mj.pos.toList.getD x.r14.toBitVec.toNat default := get_pos Mj x.r14.toBitVec
      by_cases h1 : FlatShuffler.Flat.hasSourceAssigned Mj x.r14.toBitVec = true
      · have hposne : UInt64.ofBitVec (Mj.pos.toList.getD x.r14.toBitVec.toNat default)
            ≠ 18446744073709551615 := by
          apply ofBitVec_ne_none
          rw [← hgetpos]
          unfold FlatShuffler.Flat.hasSourceAssigned at h1
          rwa [bne_iff_ne] at h1
        have hs33 : blocksP.step .o33 x
            = .ok (.goto .LBB28_5 { x with rax := UInt64.ofBitVec 17472 }) := by
          simp only [blocksP, hL33a', hL33b', if_neg hposne]
        have hcont : FlatShuffler.Flat.closestCopiesFrom b M 0
            = FlatShuffler.Flat.closestCopiesFrom b Mj (x.r14.toBitVec + 1) := by
          rw [habs, FlatShuffler.Flat.closestCopiesFrom, dif_pos hjbv, if_neg (by simp [h1])]
        obtain ⟨r, hr, h2'', h3''⟩ := hback { x with rax := UInt64.ofBitVec 17472 } Mj m
          rfl rfl rfl rfl rfl hmemj hholds hcont
        exact ⟨r, Blocks.Returns.goto hs1o (Blocks.Returns.goto hs33 hr), h2'', h3''⟩
      · by_cases h2 : FlatShuffler.Flat.isWildcardTarget b x.r14.toBitVec = true
        · have hposeq : UInt64.ofBitVec (Mj.pos.toList.getD x.r14.toBitVec.toNat default)
              = 18446744073709551615 := by
            apply (ofBitVec_eq_ones _).mpr
            apply Classical.byContradiction
            intro hc
            apply h1
            unfold FlatShuffler.Flat.hasSourceAssigned
            rw [hgetpos, bne_iff_ne]
            exact hc
          have hk : (b.target.toList.getD x.r14.toBitVec.toNat default).kind = 1 := by
            unfold FlatShuffler.Flat.isWildcardTarget FlatShuffler.isJunk at h2
            rw [hkindget] at h2
            simpa [FlatShuffler.Junk] using h2
          have hshift : UInt64.ofBitVec (BitVec.zeroExtend 64
                (b.target.toList.getD x.r14.toBitVec.toNat default).kind) <<< (32 : UInt64)
              = x.r12 := by
            rw [hk, hx.r12]
            exact (shift32_eq 1).mpr rfl
          have hs33 : blocksP.step .o33 x
              = .ok (.goto .o48 { x with rax := UInt64.ofBitVec 17472 }) := by
            simp only [blocksP, hL33a', hL33b', if_pos hposeq]
          have hs48 : blocksP.step .o48 { x with rax := UInt64.ofBitVec 17472 }
              = .ok (.goto .LBB28_5 { x with rax := UInt64.ofBitVec (BitVec.zeroExtend 64
                  (b.target.toList.getD x.r14.toBitVec.toNat default).kind) <<< (32 : UInt64) }) := by
            simp only [blocksP, hL48a', hL48b', if_pos hshift]
          have hcont : FlatShuffler.Flat.closestCopiesFrom b M 0
              = FlatShuffler.Flat.closestCopiesFrom b Mj (x.r14.toBitVec + 1) := by
            rw [habs, FlatShuffler.Flat.closestCopiesFrom, dif_pos hjbv, if_neg (by simp [h2])]
          obtain ⟨r, hr, h2'', h3''⟩ := hback { x with rax := UInt64.ofBitVec (BitVec.zeroExtend 64
              (b.target.toList.getD x.r14.toBitVec.toNat default).kind) <<< (32 : UInt64) } Mj m
            rfl rfl rfl rfl rfl hmemj hholds hcont
          exact ⟨r, Blocks.Returns.goto hs1o (Blocks.Returns.goto hs33 (Blocks.Returns.goto hs48 hr)),
            h2'', h3''⟩
        · -- the candidate path: `.o33` -> `.o48` -> `.o67` -> `.o86`
          let p : BitVec 64 := FlatShuffler.Flat.closestCopy b Mj x.r14.toBitVec false
          let kv : UInt64 := UInt64.ofBitVec (BitVec.zeroExtend 64 (b.target.toList.getD x.r14.toBitVec.toNat default).kind) <<< (32 : UInt64)
          let xC : St In2p Heap := { x with rax := UInt64.ofBitVec p, rdx := 0, rsi := x.r14, rdi := x.rbx }
          let xD : St In2p Heap := { x with rax := 0, rdx := x.r14, rsi := UInt64.ofBitVec p, rdi := x.rbx, mem := objsP b (Mj.bind p x.r14.toBitVec) ++ frame }
          let xE : St In2p Heap := { x with rax := (UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535), rdx := x.r14, rsi := UInt64.ofBitVec p, rdi := x.rbx }
          let xF : St In2p Heap := { x with rax := (((UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535)) &&& 18446744073709486080) ||| (1 &&& 65535), rdx := x.r14, rsi := UInt64.ofBitVec p, rdi := x.rbx }
          have hpv : p = FlatShuffler.Flat.closestCopy b Mj x.r14.toBitVec false := rfl
          have hposj : FlatShuffler.Flat.get Mj.pos x.r14.toBitVec = FlatShuffler.Flat.NONE := by
            by_cases h : FlatShuffler.Flat.get Mj.pos x.r14.toBitVec = FlatShuffler.Flat.NONE
            · exact h
            · exfalso
              apply h1
              unfold FlatShuffler.Flat.hasSourceAssigned
              rwa [bne_iff_ne]
          have hkne : (b.target.toList.getD x.r14.toBitVec.toNat default).kind ≠ 1 := by
            intro hk
            apply h2
            unfold FlatShuffler.Flat.isWildcardTarget FlatShuffler.isJunk
            rw [hkindget, show FlatShuffler.Junk = (1 : BitVec 8) from rfl, hk]
            rfl
          have hposeq : UInt64.ofBitVec (Mj.pos.toList.getD x.r14.toBitVec.toNat default)
              = 18446744073709551615 := by
            apply (ofBitVec_eq_ones _).mpr
            rw [← hgetpos]
            exact hposj
          have hs33 : blocksP.step .o33 x

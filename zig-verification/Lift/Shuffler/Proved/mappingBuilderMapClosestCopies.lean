          · -- `p = NONE`: `.o80` -> `.LBB28_5`
            have hnone : UInt64.ofBitVec p = 18446744073709551615 := (ofBitVec_eq_ones p).mpr h3
            have hs80 : blocksP.step .o80 xC = .ok (.goto .LBB28_5 xC) := by
              simp only [blocksP]
              rw [show xC.rax = 18446744073709551615 from hnone]
              simp
            have hcond : ¬((!FlatShuffler.Flat.hasSourceAssigned Mj x.r14.toBitVec && !FlatShuffler.Flat.isWildcardTarget b x.r14.toBitVec && decide (p ≠ FlatShuffler.Flat.NONE)) = true) := by
              have hd : decide (p ≠ FlatShuffler.Flat.NONE) = false := by simp [h3]
              rw [hd]; simp
            have hcont : FlatShuffler.Flat.closestCopiesFrom b M 0
                = FlatShuffler.Flat.closestCopiesFrom b Mj (x.r14.toBitVec + 1) := by
              rw [habs, FlatShuffler.Flat.closestCopiesFrom, dif_pos hjbv, if_neg hcond]
            obtain ⟨r, hr, h2'', h3''⟩ := hback xC Mj m rfl rfl rfl rfl rfl hmemj hholds hcont
            exact ⟨r, Blocks.Returns.goto hs1o (Blocks.Returns.goto hs33 (Blocks.Returns.goto hs48
              (Blocks.Returns.call hs67 hc0rel (Blocks.Returns.goto hs80 hr)))), h2'', h3''⟩
          · -- the map call
            have hpne : p ≠ FlatShuffler.Flat.NONE := h3
            have hpbound : p.toNat < FlatShuffler.maxStackSize := by
              rw [hpv]
              rcases closestCopy_bound b Mj x.r14.toBitVec false with h | h
              · rw [← hpv] at h; exact absurd h hpne
              · have h1' := hC.1; omega
            have hnone : UInt64.ofBitVec p ≠ 18446744073709551615 := by
              intro e
              exact hpne ((ofBitVec_eq_ones p).mp e)
            have hs80 : blocksP.step .o80 xC = .ok (.goto .o86 xC) := by
              simp only [blocksP]
              rw [show xC.rax = UInt64.ofBitVec p from rfl]
              simp [hnone]
            have hs86 : blocksP.step .o86 xC
                = .ok (.call .c1 ⟨x.input.policy, x.mem, UInt64.ofBitVec p, x.r14, UInt64.ofBitVec p, x.rbx, x.input.sp - 40 - 8⟩ fun r => (.o100, { x with rax := r.1, rdx := x.r14, rsi := UInt64.ofBitVec p, rdi := x.rbx, mem := r.2 })) := by
              simp only [blocksP]
              rfl
            have hcont0 : FlatShuffler.Flat.closestCopiesFrom b M 0
                = (if (FlatShuffler.Flat.mbMap b Mj p x.r14.toBitVec).1
                      ≠ FlatShuffler.Flat.ExecutionControl.done
                  then FlatShuffler.Flat.mbMap b Mj p x.r14.toBitVec
                  else FlatShuffler.Flat.closestCopiesFrom b (FlatShuffler.Flat.mbMap b Mj p x.r14.toBitVec).2
                    (x.r14.toBitVec + 1)) := by
              have hcond : (!FlatShuffler.Flat.hasSourceAssigned Mj x.r14.toBitVec && !FlatShuffler.Flat.isWildcardTarget b x.r14.toBitVec && decide (p ≠ FlatShuffler.Flat.NONE)) = true := by
                rw [show FlatShuffler.Flat.hasSourceAssigned Mj x.r14.toBitVec = false from by
                  by_cases h : FlatShuffler.Flat.hasSourceAssigned Mj x.r14.toBitVec = true
                  · exact absurd h h1
                  · simpa using h]
                rw [show FlatShuffler.Flat.isWildcardTarget b x.r14.toBitVec = false from by
                  by_cases h : FlatShuffler.Flat.isWildcardTarget b x.r14.toBitVec = true
                  · exact absurd h h2
                  · simpa using h]
                rw [show decide (p ≠ FlatShuffler.Flat.NONE) = true from by simp [hpne]]
                rfl
              rw [habs, FlatShuffler.Flat.closestCopiesFrom, dif_pos hjbv, if_pos hcond]
            have hmbmap : FlatShuffler.Flat.mbMap b Mj p x.r14.toBitVec
                = if (!FlatShuffler.Flat.mappable b Mj p) = true
                  then (FlatShuffler.Flat.ExecutionControl.assertionExit, Mj)
                  else if FlatShuffler.Flat.get Mj.dest p ≠ FlatShuffler.Flat.NONE
                    then (FlatShuffler.Flat.ExecutionControl.assertionExit, Mj)
                    else if FlatShuffler.Flat.get Mj.pos x.r14.toBitVec ≠ FlatShuffler.Flat.NONE
                      then (FlatShuffler.Flat.ExecutionControl.assertionExit, Mj)
                      else (FlatShuffler.Flat.ExecutionControl.done, Mj.bind p x.r14.toBitVec) := rfl
            have hEx : ∀ (hmbv : FlatShuffler.Flat.mbMap b Mj p x.r14.toBitVec = (FlatShuffler.Flat.ExecutionControl.assertionExit, Mj)),
                CalP.rel .c1 ⟨x.input.policy, x.mem, UInt64.ofBitVec p, x.r14, UInt64.ofBitVec p, x.rbx, x.input.sp - 40 - 8⟩ ((UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535), x.mem) →
                  ∃ r, blocksP.Returns CalP.rel .LBB28_1 x r ∧ r.2 = loopHeap b M frame ∧ r.1.toBitVec.setWidth 16 = loopRax b M := by
              intro hmbv hrel
              have hcont : FlatShuffler.Flat.closestCopiesFrom b M 0
                  = (FlatShuffler.Flat.ExecutionControl.assertionExit, Mj) := by
                rw [hcont0, hmbv]; simp
              have hne0 : ((UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535) : UInt64).toUInt16.toUInt64 ≠ 0 := by
                rw [show ((UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535) : UInt64) = UInt64.ofBitVec ((p &&& 18446744073709486080) ||| 1) from by bv_decide]
                exact or_one_ne_zero p
              have hs100 : blocksP.step .o100 xE = .ok (.goto .LBB28_9 xE) := by
                simp only [blocksP]
                rw [show xE.rax = ((UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535) : UInt64) from rfl]
                simp [hne0]
              have hs9 : blocksP.step .LBB28_9 xE = .ok (.goto .LBB28_3 xF) := by
                simp only [blocksP]
                rfl
              have hs3 : blocksP.step .LBB28_3 xF = .ok (.ret (xF.rax, xF.mem)) := by
                simp only [blocksP]
              refine ⟨_, Blocks.Returns.goto hs1o (Blocks.Returns.goto hs33 (Blocks.Returns.goto hs48
                (Blocks.Returns.call hs67 hc0rel (Blocks.Returns.goto hs80 (Blocks.Returns.call hs86 hrel
                  (Blocks.Returns.goto hs100 (Blocks.Returns.goto hs9 (Blocks.Returns.ret hs3)))))))), ?_, ?_⟩
              · rw [loopHeap, hcont]
                exact hmemj
              · have h16 : xF.rax.toBitVec.setWidth 16 = 1 := by
                  show ((((UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535)) &&& 18446744073709486080) ||| (1 &&& 65535) : UInt64).toBitVec.setWidth 16 = 1
                  rw [show ((((UInt64.ofBitVec p &&& 18446744073709486080) ||| (1 &&& 65535)) &&& 18446744073709486080) ||| (1 &&& 65535) : UInt64) = UInt64.ofBitVec ((p &&& 18446744073709486080) ||| 1) from by bv_decide]
                  exact setWidth16_or_one p
                rw [h16, loopRax, hcont]
                simp
            by_cases hd : FlatShuffler.Flat.get b.dropped p = 0
            · by_cases hD : FlatShuffler.Flat.get Mj.dest p = FlatShuffler.Flat.NONE
              · -- the stores
                have hmapp : FlatShuffler.Flat.mappable b Mj p = true := by
                  rw [FlatShuffler.Flat.mappable, hd, hD]; rfl
                have hmb : FlatShuffler.Flat.mbMap b Mj p x.r14.toBitVec
                    = (FlatShuffler.Flat.ExecutionControl.done, Mj.bind p x.r14.toBitVec) := by
                  rw [hmbmap, if_neg (by rw [hmapp]; simp), if_neg (by rw [hD]; simp), if_neg (by rw [hposj]; simp)]
                have hst1 := objsP_store_dest b Mj frame a.policy m (hmemj ▸ hholds) p hpbound x.r14.toBitVec
                obtain ⟨m1, -, hm1, -⟩ := Heap.store_sound (hmemj ▸ hholds) hst1
                have hst2 := objsP_store_pos b { Mj with dest := Mj.dest.setIfInBounds p.toNat x.r14.toBitVec } frame a.policy m1 hm1 x.r14.toBitVec hjmax p
                obtain ⟨m2, -, hm2, -⟩ := Heap.store_sound hm1 hst2
                have hrel : CalP.rel .c1 ⟨x.input.policy, x.mem, UInt64.ofBitVec p, x.r14, UInt64.ofBitVec p, x.rbx, x.input.sp - 40 - 8⟩ (0, objsP b (Mj.bind p x.r14.toBitVec) ++ frame) := by
                  refine ⟨x.mem, objsP b (Mj.bind p x.r14.toBitVec) ++ frame, ?_, ?_, ?_, List.Perm.refl _⟩
                  · exact map_store b Mj frame a.policy ⟨x.input.policy, x.mem, UInt64.ofBitVec p, x.r14, UInt64.ofBitVec p, x.rbx, x.input.sp - 40 - 8⟩ hmemj (by rw [hx.rbx]; exact hrdi0) (by simpa using hpbound) (by simpa using hjmax) ⟨m, hholds⟩ hd hD hposj
                  · show List.length x.mem = List.length (objsP b (Mj.bind p x.r14.toBitVec) ++ frame)
                    rw [hmemj]; simp only [List.length_append, objsP_len b Mj (Mj.bind p x.r14.toBitVec)]
                  · show List.length x.mem = List.length (objsP b (Mj.bind p x.r14.toBitVec) ++ frame)
                    rw [hmemj]; simp only [List.length_append, objsP_len b Mj (Mj.bind p x.r14.toBitVec)]
                have hs100 : blocksP.step .o100 xD = .ok (.goto .LBB28_5 xD) := by
                  simp only [blocksP]
                  rfl
                have hcont : FlatShuffler.Flat.closestCopiesFrom b M 0
                    = FlatShuffler.Flat.closestCopiesFrom b (Mj.bind p x.r14.toBitVec) (x.r14.toBitVec + 1) := by
                  rw [hcont0, hmb]
                  rfl
                obtain ⟨r, hr, h2'', h3''⟩ := hback xD (Mj.bind p x.r14.toBitVec) m2 rfl rfl rfl rfl rfl rfl hm2 hcont
                exact ⟨r, Blocks.Returns.goto hs1o (Blocks.Returns.goto hs33 (Blocks.Returns.goto hs48
                  (Blocks.Returns.call hs67 hc0rel (Blocks.Returns.goto hs80 (Blocks.Returns.call hs86 hrel
                    (Blocks.Returns.goto hs100 hr)))))), h2'', h3''⟩
              · have hmapp : FlatShuffler.Flat.mappable b Mj p = false := by
                  rw [FlatShuffler.Flat.mappable, hd, show (FlatShuffler.Flat.get Mj.dest p == FlatShuffler.Flat.NONE) = false from by simpa using hD]
                  rfl

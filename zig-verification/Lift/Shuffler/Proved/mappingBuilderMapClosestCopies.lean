abbrev callSummary : Prop := ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.run b M)), callPre frame b M a → Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.run b M = some y → ∃ q, skel_call.l2p.returns a q ∧ callPost frame b M a y q

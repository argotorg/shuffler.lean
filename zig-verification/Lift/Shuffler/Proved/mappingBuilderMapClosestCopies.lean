theorem or_one_ne_zero (p : BitVec 64) :
    (UInt64.ofBitVec ((p &&& 18446744073709486080) ||| 1)).toUInt16.toUInt64 ≠ 0 := by
  have hw : ((p &&& 18446744073709486080) ||| 1).setWidth 16 = 1 := setWidth16_or_one p
  have h1 : (UInt64.ofBitVec ((p &&& 18446744073709486080) ||| 1)).toUInt16

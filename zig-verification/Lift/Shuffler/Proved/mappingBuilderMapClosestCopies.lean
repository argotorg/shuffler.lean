open FlatShuffler.Flat Lift.Trusted Lift.Shuffler.Internal.Proposed

/-- The header object at the address `0`. -/
def w0 : Obj := toObj ⟨0, Layout.word 64, false⟩

def w8 (b : FlatShuffler.Flat.Builder) : Obj := toObj ⟨8, Layout.word b.sourceSize, false⟩

def w16 : Obj := toObj ⟨16, Layout.word 8256, false⟩

def w24 (b : FlatShuffler.Flat.Builder) : Obj := toObj ⟨24, Layout.word b.targetSize, false⟩

def w32 : Obj := toObj ⟨32, Layout.word 16448, false⟩

def w40 (b : FlatShuffler.Flat.Builder) : Obj :=
  toObj ⟨40, [⟨.W8, if b.take then (1 : BitVec 8) else 0⟩], false⟩

def w48 : Obj := toObj ⟨48, Layout.word 17472, false⟩

def srcObj (b : FlatShuffler.Flat.Builder) : Obj :=
  toObj ⟨64, (List.range FlatShuffler.maxStackSize).map
    fun i => ⟨.W64, Layout.slotWord (b.source.toList.getD i default) 0⟩, false⟩

def tgtObj (b : FlatShuffler.Flat.Builder) : Obj :=
  toObj ⟨8256, (List.range FlatShuffler.maxStackSize).map
    fun i => ⟨.W64, Layout.slotWord (b.target.toList.getD i default) 0⟩, false⟩

def dropObj (b : FlatShuffler.Flat.Builder) : Obj :=
  toObj ⟨16448, b.dropped.toList.map fun v => ⟨.W8, v⟩, false⟩

def destObj (xs : List (BitVec 64)) : Obj := Obj.words 17472 true .W64 xs

def posObj (ys : List (BitVec 64)) : Obj := Obj.words 25664 true .W64 ys

/-- The own heap of the callee: the statement's objects, with the contents of the two written
arrays as parameters. -/
def ownHeap (b : FlatShuffler.Flat.Builder) (xs ys : List (BitVec 64)) : Heap :=
  [w0, w8 b, w16, w24 b, w32, w40 b, w48, srcObj b, tgtObj b, dropObj b, destObj xs, posObj ys]

theorem objsP_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    objsP b M = ownHeap b M.dest.toList M.pos.toList := by
  simp [objsP, Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects,
    Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf, ownHeap, w0, w8, w16, w24,
    w32, w40, w48, srcObj, tgtObj, dropObj, destObj, posObj, Obj.words, toObj, toCell]

theorem w8_get (b : FlatShuffler.Flat.Builder) : (w8 b).get 8 .W64 = some b.sourceSize := by
  simp [w8, Layout.word, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem w24_get (b : FlatShuffler.Flat.Builder) : (w24 b).get 24 .W64 = some b.targetSize := by
  simp [w24, Layout.word, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem w16_get : w16.get 16 .W64 = some 8256 := by
  simp [w16, Layout.word, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem w32_get : w32.get 32 .W64 = some 16448 := by
  simp [w32, Layout.word, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem w48_get : w48.get 48 .W64 = some 17472 := by
  simp [w48, Layout.word, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem w0_get : w0.get 0 .W64 = some 64 := by
  simp [w0, Layout.word, toObj, toCell, Obj.get, Lift.Sem.offsets, Cell.get]

theorem w0_not_writable : w0.writable = false := rfl

theorem w8_not_writable (b : FlatShuffler.Flat.Builder) : (w8 b).writable = false := rfl

theorem w16_not_writable : w16.writable = false := rfl

theorem w24_not_writable (b : FlatShuffler.Flat.Builder) : (w24 b).writable = false := rfl

theorem w32_not_writable : w32.writable = false := rfl

theorem w40_not_writable (b : FlatShuffler.Flat.Builder) : (w40 b).writable = false := rfl

theorem w48_not_writable : w48.writable = false := rfl

theorem srcObj_not_writable (b : FlatShuffler.Flat.Builder) : (srcObj b).writable = false := rfl

theorem tgtObj_not_writable (b : FlatShuffler.Flat.Builder) : (tgtObj b).writable = false := rfl

theorem dropObj_not_writable (b : FlatShuffler.Flat.Builder) : (dropObj b).writable = false := rfl

theorem destObj_writable (xs : List (BitVec 64)) : (destObj xs).writable = true := rfl

theorem posObj_writable (ys : List (BitVec 64)) : (posObj ys).writable = true := rfl

theorem destObj_size (xs : List (BitVec 64)) : (destObj xs).size = 8 * xs.length := by
  have := words_bytes .W64 xs
  simpa [destObj, Obj.words, Obj.size, Width.bytes] using this

theorem posObj_size (ys : List (BitVec 64)) : (posObj ys).size = 8 * ys.length := by
  have := words_bytes .W64 ys
  simpa [posObj, Obj.words, Obj.size, Width.bytes] using this

/-- A load of a cell of an object of a heap that a memory holds. -/
theorem loadB_of_get {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds policy m)
    {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width} {v : w.type} (hg : o.get a w = some v) :
    h.loadB a w = .ok v := by
  obtain ⟨x, hx, ha, hc⟩ := Obj.get_some hg
  have hl := Heap.load_of_mem hh ho hx
  rw [ha, hc] at hl
  exact Heap.loadB_of_load hl

theorem Obj.not_apart_self {O : Obj} (h : 0 < O.size) : ¬ O.Apart O := by
  unfold Obj.Apart; omega

/-- An object of the frame is not the writable object of the own heap, when a memory holds the
concatenation of the two. -/
theorem Obj.ne_of_holds_append {policy : CpuPolicy} {m : DataMem} {own frame : Heap}
    (hholds : (own ++ frame).Holds policy m) {O : Obj} (hO : O ∈ own) (hOw : O.writable)
    (hOsize : 0 < O.size) {p : Obj} (hp : p ∈ frame) : p ≠ O := by
  intro hpo
  subst hpo
  obtain ⟨i, hi, hie⟩ := List.getElem_of_mem hO
  obtain ⟨j, hj, hje⟩ := List.getElem_of_mem hp
  have hlen : i < (own ++ frame).length := by simp; omega
  have hlen2 : own.length + j < (own ++ frame).length := by simp; omega
  have hR := List.pairwise_iff_getElem.mp hholds.apart i (own.length + j) hlen hlen2 (by omega)
  rw [List.getElem_append_left hi] at hR
  rw [List.getElem_append_right (by omega)] at hR
  simp only [Nat.add_sub_cancel_left] at hR
  rw [hie, hje] at hR
  exact absurd (hR (Or.inl hOw)) (Obj.not_apart_self hOsize)

theorem set_of_not_writable {a : BitVec 64} {w : Width} {v : w.type} {o : Obj}
    (h : o.writable = false) : Obj.set a w v o = o := by
  unfold Obj.set; rw [h]; rfl

/-- The address `17472 + 8 * i` of the cell at index `i` of an array of words. -/
theorem ofNat_mul_eight (i : BitVec 64) (hi : i.toNat < 2 ^ 61) :
    BitVec.ofNat 64 (8 * i.toNat) = 8 * i := by
  rw [BitVec.ofNat_mul, BitVec.ofNat_toNat]
  simp

theorem destObj_set_self {xs : List (BitVec 64)} (hlen : xs.length = 1024) {i : BitVec 64}
    (hi : i.toNat < xs.length) (v : BitVec 64) :
    Obj.set (17472 + 8 * i) .W64 v (destObj xs) = destObj (xs.set i.toNat v) := by
  have hi' : i.toNat < (destObj xs).cells.length := by simpa [destObj, Obj.words] using hi
  have hno : (destObj xs).addr.toNat + (destObj xs).size ≤ 2 ^ 64 := by
    have h1 : (destObj xs).addr = 17472 := rfl
    have h2 := destObj_size xs
    rw [h1, h2, hlen]
    decide
  have h := Obj.set_field (o := destObj xs) rfl hno i.toNat hi' .W64 (by simp [destObj, Obj.words]) v
  have hfo : (destObj xs).fieldOff i.toNat = 8 * i.toNat := by
    have := words_fieldOff .W64 xs i.toNat (Nat.le_of_lt hi)
    simpa [destObj, Obj.words, Obj.fieldOff, Width.bytes] using this
  have haddr : (destObj xs).addr + BitVec.ofNat 64 ((destObj xs).fieldOff i.toNat) =
      17472 + 8 * i := by
    rw [hfo]
    show (17472 : BitVec 64) + BitVec.ofNat 64 (8 * i.toNat) = 17472 + 8 * i
    rw [ofNat_mul_eight i (by omega)]
  rw [haddr] at h
  rw [h]
  simp only [destObj, Obj.words]
  rw [← List.map_set]

theorem destObj_ne_posObj (xs ys : List (BitVec 64)) : destObj xs ≠ posObj ys := by
  intro h
  have := congrArg Obj.addr h
  simp [destObj, posObj, Obj.words] at this

theorem posObj_set_self {ys : List (BitVec 64)} (hlen : ys.length = 1024) {j : BitVec 64}
    (hj : j.toNat < ys.length) (v : BitVec 64) :
    Obj.set (25664 + 8 * j) .W64 v (posObj ys) = posObj (ys.set j.toNat v) := by
  have hi' : j.toNat < (posObj ys).cells.length := by simpa [posObj, Obj.words] using hj
  have hno : (posObj ys).addr.toNat + (posObj ys).size ≤ 2 ^ 64 := by
    have h1 : (posObj ys).addr = 25664 := rfl
    have h2 := posObj_size ys
    rw [h1, h2, hlen]
    decide
  have h := Obj.set_field (o := posObj ys) rfl hno j.toNat hi' .W64 (by simp [posObj, Obj.words]) v
  have hfo : (posObj ys).fieldOff j.toNat = 8 * j.toNat := by
    have := words_fieldOff .W64 ys j.toNat (Nat.le_of_lt hj)
    simpa [posObj, Obj.words, Obj.fieldOff, Width.bytes] using this
  have haddr : (posObj ys).addr + BitVec.ofNat 64 ((posObj ys).fieldOff j.toNat) =
      25664 + 8 * j := by
    rw [hfo]
    show (25664 : BitVec 64) + BitVec.ofNat 64 (8 * j.toNat) = 25664 + 8 * j
    rw [ofNat_mul_eight j (by omega)]
  rw [haddr] at h
  rw [h]
  simp only [posObj, Obj.words]
  rw [← List.map_set]

theorem destObj_cell_mem {xs : List (BitVec 64)} {i : BitVec 64} (hi : i.toNat < xs.length) :
    ((8 * i.toNat : Nat), (⟨.W64, xs[i.toNat]⟩ : Cell)) ∈ offsets 0 (destObj xs).cells := by
  have := mem_offsets_words .W64 xs 0 i.toNat hi
  simpa [destObj, Obj.words] using this

theorem posObj_cell_mem {ys : List (BitVec 64)} {j : BitVec 64} (hj : j.toNat < ys.length) :
    ((8 * j.toNat : Nat), (⟨.W64, ys[j.toNat]⟩ : Cell)) ∈ offsets 0 (posObj ys).cells := by
  have := mem_offsets_words .W64 ys 0 j.toNat hj
  simpa [posObj, Obj.words] using this

/-- A store into the destination array, as a map of the own heap and the frame. -/
theorem map_ownHeap_dest (b : FlatShuffler.Flat.Builder) (xs ys : List (BitVec 64))
    (frame : Heap) {policy : CpuPolicy} {m : DataMem} {xmem : Heap}
    (hperm : (ownHeap b xs ys ++ frame).Perm xmem) (hm : xmem.Holds policy m)
    (hlenx : xs.length = 1024) (hleny : ys.length = 1024) {i : BitVec 64}
    (hi : i.toNat < xs.length) (v : BitVec 64) :
    (ownHeap b xs ys ++ frame).map (Obj.set (17472 + 8 * i) .W64 v) =
      ownHeap b (xs.set i.toNat v) ys ++ frame := by
  have hh : (ownHeap b xs ys ++ frame).Holds policy m := (Heap.Holds_perm hperm).mpr hm
  have hD : destObj xs ∈ ownHeap b xs ys := by simp [ownHeap]
  have hD' : destObj xs ∈ ownHeap b xs ys ++ frame := List.mem_append_left _ hD
  have hsizeD : 0 < (destObj xs).size := by rw [destObj_size, hlenx]; omega
  have haddri : (destObj xs).addr + BitVec.ofNat 64 (8 * i.toNat) = 17472 + 8 * i := by
    show (17472 : BitVec 64) + BitVec.ofNat 64 (8 * i.toNat) = 17472 + 8 * i
    rw [ofNat_mul_eight i (by omega)]
  have hset : ∀ p ∈ ownHeap b xs ys ++ frame, p ≠ destObj xs →
      Obj.set (17472 + 8 * i) .W64 v p = p := by
    intro p hp hne
    have := Heap.Holds.set_other hh hD' rfl (destObj_cell_mem hi) hp hne v
    rwa [haddri] at this
  have hframe : frame.map (Obj.set (17472 + 8 * i) .W64 v) = frame := by
    have hg : ∀ p ∈ frame, Obj.set (17472 + 8 * i) .W64 v p = p :=
      fun p hp => hset p (List.mem_append_right _ hp)
        (Obj.ne_of_holds_append hh hD rfl hsizeD hp)
    calc frame.map (Obj.set (17472 + 8 * i) .W64 v) = frame.map id := List.map_congr_left hg
      _ = frame := List.map_id frame
  have hown : (ownHeap b xs ys).map (Obj.set (17472 + 8 * i) .W64 v) =
      ownHeap b (xs.set i.toNat v) ys := by
    simp only [ownHeap, List.map_cons, List.map_nil]
    rw [set_of_not_writable (o := w0) w0_not_writable,
      set_of_not_writable (o := w8 b) (w8_not_writable b),
      set_of_not_writable (o := w16) w16_not_writable,
      set_of_not_writable (o := w24 b) (w24_not_writable b),
      set_of_not_writable (o := w32) w32_not_writable,
      set_of_not_writable (o := w40 b) (w40_not_writable b),
      set_of_not_writable (o := w48) w48_not_writable,
      set_of_not_writable (o := srcObj b) (srcObj_not_writable b),
      set_of_not_writable (o := tgtObj b) (tgtObj_not_writable b),
      set_of_not_writable (o := dropObj b) (dropObj_not_writable b),
      destObj_set_self hlenx hi v,
      hset (posObj ys) (by simp [ownHeap]) (destObj_ne_posObj xs ys).symm]
  rw [List.map_append, hown, hframe]

/-- A store into the position array, as a map of the own heap and the frame. -/
theorem map_ownHeap_pos (b : FlatShuffler.Flat.Builder) (xs ys : List (BitVec 64))
    (frame : Heap) {policy : CpuPolicy} {m : DataMem} {xmem : Heap}
    (hperm : (ownHeap b xs ys ++ frame).Perm xmem) (hm : xmem.Holds policy m)
    (hlenx : xs.length = 1024) (hleny : ys.length = 1024) {j : BitVec 64}
    (hj : j.toNat < ys.length) (v : BitVec 64) :
    (ownHeap b xs ys ++ frame).map (Obj.set (25664 + 8 * j) .W64 v) =
      ownHeap b xs (ys.set j.toNat v) ++ frame := by
  have hh : (ownHeap b xs ys ++ frame).Holds policy m := (Heap.Holds_perm hperm).mpr hm
  have hP : posObj ys ∈ ownHeap b xs ys := by simp [ownHeap]
  have hP' : posObj ys ∈ ownHeap b xs ys ++ frame := List.mem_append_left _ hP
  have hsizeP : 0 < (posObj ys).size := by rw [posObj_size, hleny]; omega
  have haddrj : (posObj ys).addr + BitVec.ofNat 64 (8 * j.toNat) = 25664 + 8 * j := by
    show (25664 : BitVec 64) + BitVec.ofNat 64 (8 * j.toNat) = 25664 + 8 * j
    rw [ofNat_mul_eight j (by omega)]
  have hset : ∀ p ∈ ownHeap b xs ys ++ frame, p ≠ posObj ys →
      Obj.set (25664 + 8 * j) .W64 v p = p := by
    intro p hp hne
    have := Heap.Holds.set_other hh hP' rfl (posObj_cell_mem hj) hp hne v
    rwa [haddrj] at this
  have hframe : frame.map (Obj.set (25664 + 8 * j) .W64 v) = frame := by
    have hg : ∀ p ∈ frame, Obj.set (25664 + 8 * j) .W64 v p = p :=
      fun p hp => hset p (List.mem_append_right _ hp)
        (Obj.ne_of_holds_append hh hP rfl hsizeP hp)
    calc frame.map (Obj.set (25664 + 8 * j) .W64 v) = frame.map id := List.map_congr_left hg
      _ = frame := List.map_id frame
  have hown : (ownHeap b xs ys).map (Obj.set (25664 + 8 * j) .W64 v) =
      ownHeap b xs (ys.set j.toNat v) := by
    simp only [ownHeap, List.map_cons, List.map_nil]
    rw [set_of_not_writable (o := w0) w0_not_writable,
      set_of_not_writable (o := w8 b) (w8_not_writable b),
      set_of_not_writable (o := w16) w16_not_writable,
      set_of_not_writable (o := w24 b) (w24_not_writable b),
      set_of_not_writable (o := w32) w32_not_writable,
      set_of_not_writable (o := w40 b) (w40_not_writable b),
      set_of_not_writable (o := w48) w48_not_writable,
      set_of_not_writable (o := srcObj b) (srcObj_not_writable b),
      set_of_not_writable (o := tgtObj b) (tgtObj_not_writable b),
      set_of_not_writable (o := dropObj b) (dropObj_not_writable b),
      hset (destObj xs) (by simp [ownHeap]) (destObj_ne_posObj xs ys),
      posObj_set_self hleny hj v]
  rw [List.map_append, hown, hframe]

/-- The data of the invariant of the callee's run. -/
structure InnerData (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (xs ys : List (BitVec 64)) (l : mappingBuilderMap.Lbl)
    (x : mappingBuilderMap.St mappingBuilderMap.In2p Heap) : Prop where
  hxs : xs.length = 1024
  hys : ys.length = 1024
  perm : (ownHeap b xs ys ++ frame).Perm x.mem
  holds : ∃ m, x.mem.Holds policy m
  rdi : x.input.rdi.toBitVec = 0
  rsi : x.input.rsi.toNat < 1024
  rdx : x.input.rdx.toNat < 1024
  rcx : (l = .o25 ∨ l = .o36) → x.rcx.toBitVec = 17472

def InnerInv (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (l : mappingBuilderMap.Lbl) (x : mappingBuilderMap.St mappingBuilderMap.In2p Heap) : Prop :=
  ∃ xs ys, InnerData policy b frame xs ys l x

/-- The result of the callee's run. -/
structure InnerRes (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (r : UInt64 × Heap) : Prop where
  perm : ∃ xs ys, xs.length = 1024 ∧ ys.length = 1024 ∧ (ownHeap b xs ys ++ frame).Perm r.2
  holds : ∃ m, r.2.Holds policy m

theorem inner_block (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap) :
    ∀ (l : mappingBuilderMap.Lbl) (x : mappingBuilderMap.St mappingBuilderMap.In2p Heap)
      (n : Next mappingBuilderMap.Lbl (mappingBuilderMap.St mappingBuilderMap.In2p Heap)
        (UInt64 × Heap) Empty Empty.elim Empty.elim),
      InnerInv policy b frame l x → mappingBuilderMap.blocksP.step l x = .ok n →
      Lift.Sem.CallArm.Next.Inv (InnerInv policy b frame) (InnerRes policy b frame) noCall n := by
  intro l x n hI hstep
  obtain ⟨xs, ys, hI⟩ := hI
  cases l with
  | entry =>
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · split at hstep
      · split at hstep
        · cases hstep
          exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, hI.holds, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
        · cases hstep
          exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, hI.holds, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o14 =>
    obtain ⟨m, hm⟩ := hI.holds
    have hhdr : w48 ∈ x.mem := hI.perm.subset (by simp [ownHeap])
    have hload : x.mem.loadB (x.input.rdi.toBitVec + 48) .W64 = .ok 17472 := by
      rw [hI.rdi]
      exact loadB_of_get hm hhdr (by simpa using w48_get)
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · rename_i v hv
      have hv0 : v = 17472 := by
        rw [hload] at hv
        exact (Res.ok.inj hv).symm
      subst hv0
      split at hstep
      · split at hstep
        · cases hstep
          exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, ⟨m, hm⟩, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
        · cases hstep
          exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, ⟨m, hm⟩, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o25 =>
    have hrcx : x.rcx.toBitVec = 17472 := hI.rcx (Or.inl rfl)
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · split at hstep
      · cases hstep
        exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, hI.holds, hI.rdi, hI.rsi, hI.rdx, fun _ => hrcx⟩⟩
      · cases hstep
        exact ⟨xs, ys, ⟨hI.hxs, hI.hys, hI.perm, hI.holds, hI.rdi, hI.rsi, hI.rdx, by simp⟩⟩
    · cases hstep
    · cases hstep
  | o36 =>
    obtain ⟨m, hm⟩ := hI.holds
    have hrsi : x.input.rsi.toNat < xs.length := by rw [hI.hxs]; exact hI.rsi
    have hrdx : x.input.rdx.toNat < ys.length := by rw [hI.hys]; exact hI.rdx
    have hrcx : x.rcx.toBitVec = 17472 := hI.rcx (Or.inr rfl)
    have hD : destObj xs ∈ x.mem := hI.perm.subset (by simp [ownHeap])
    have hP : posObj ys ∈ x.mem := hI.perm.subset (by simp [ownHeap])
    obtain ⟨h1, hstore1, -⟩ := Heap.store_words64 hm hD hrsi x.input.rdx.toBitVec
    have hsb1 : x.mem.storeB (17472 + 8 * x.input.rsi.toBitVec) .W64 x.input.rdx.toBitVec
        = .ok h1 := Heap.storeB_of_store hstore1
    obtain ⟨m1, hm1⟩ := Heap.storeB_holds hm hsb1
    have e1 : h1 = x.mem.map (Obj.set (17472 + 8 * x.input.rsi.toBitVec) .W64
        x.input.rdx.toBitVec) := (Heap.store_ok hstore1).1
    have hperm1 : (ownHeap b (xs.set x.input.rsi.toNat x.input.rdx.toBitVec) ys ++ frame).Perm h1 := by
      have hm1' := (hI.perm.map (Obj.set (17472 + 8 * x.input.rsi.toBitVec) .W64
        x.input.rdx.toBitVec)).symm
      rw [map_ownHeap_dest (i := x.input.rsi.toBitVec) b xs ys frame hI.perm hm hI.hxs hI.hys
        hrsi x.input.rdx.toBitVec] at hm1'
      rw [← e1] at hm1'
      exact hm1'.symm
    have hP1 : posObj ys ∈ h1 := hperm1.subset (by simp [ownHeap])
    obtain ⟨h2, hstore2, -⟩ := Heap.store_words64 hm1 hP1 hrdx x.input.rsi.toBitVec
    have hsb2 : h1.storeB (25664 + 8 * x.input.rdx.toBitVec) .W64 x.input.rsi.toBitVec
        = .ok h2 := Heap.storeB_of_store hstore2
    obtain ⟨m2, hm2⟩ := Heap.storeB_holds hm1 hsb2
    have e2 : h2 = h1.map (Obj.set (25664 + 8 * x.input.rdx.toBitVec) .W64
        x.input.rsi.toBitVec) := (Heap.store_ok hstore2).1
    have hperm2 : (ownHeap b (xs.set x.input.rsi.toNat x.input.rdx.toBitVec)
        (ys.set x.input.rdx.toNat x.input.rsi.toBitVec) ++ frame).Perm h2 := by
      have hm2' := (hperm1.map (Obj.set (25664 + 8 * x.input.rdx.toBitVec) .W64
        x.input.rsi.toBitVec)).symm
      rw [map_ownHeap_pos (j := x.input.rdx.toBitVec) b (xs.set x.input.rsi.toNat x.input.rdx.toBitVec)
        ys frame hperm1 hm1 (by rw [List.length_set]; exact hI.hxs) hI.hys hrdx x.input.rsi.toBitVec] at hm2'
      rw [← e2] at hm2'
      exact hm2'.symm
    simp only [mappingBuilderMap.blocksP] at hstep
    split at hstep
    · rename_i h1' hs1
      rw [show x.rcx.toBitVec + x.input.rsi.toBitVec * 8 =
          17472 + 8 * x.input.rsi.toBitVec from by rw [hrcx, BitVec.mul_comm]] at hs1
      rw [hsb1] at hs1
      have h1e : h1' = h1 := (Res.ok.inj hs1).symm
      subst h1e
      split at hstep
      · rename_i h2' hs2
        rw [show x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192 =
            25664 + 8 * x.input.rdx.toBitVec from by rw [hrcx, BitVec.mul_comm]; bv_decide] at hs2
        rw [hsb2] at hs2
        have h2e : h2' = h2 := (Res.ok.inj hs2).symm
        subst h2e
        cases hstep
        exact ⟨_, _, ⟨by rw [List.length_set]; exact hI.hxs,
          by rw [List.length_set]; exact hI.hys, hperm2, ⟨m2, hm2⟩, hI.rdi, hI.rsi, hI.rdx,
          by simp⟩⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | LBB25_4 =>
    simp only [mappingBuilderMap.blocksP] at hstep
    cases hstep
    exact ⟨⟨xs, ys, hI.hxs, hI.hys, hI.perm⟩, hI.holds⟩

/-- The callee keeps the frame: a run of its blocks from a heap that is a permutation of the own
objects and the frame leaves a heap that still has the frame. -/
theorem inner_frame (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (k : mappingBuilderMap.In2p) (r : UInt64 × Heap)
    (hrdi : k.rdi.toBitVec = 0) (hrsi : k.rsi.toNat < 1024) (hrdx : k.rdx.toNat < 1024)
    (xs ys : List (BitVec 64)) (hlenx : xs.length = 1024) (hleny : ys.length = 1024)
    (hperm : (ownHeap b xs ys ++ frame).Perm k.heap)
    (hm : ∃ m, k.heap.Holds policy m)
    (hr : mappingBuilderMap.l2p.returns k r) :
    InnerRes policy b frame r := by
  refine Lift.Sem.CallArm.Blocks.Returns.inv (I := InnerInv policy b frame) (Q := InnerRes policy b frame)
    (block := inner_block policy b frame) hr ?_
  exact ⟨xs, ys, ⟨hlenx, hleny, hperm, hm, hrdi, hrsi, hrdx, by simp⟩⟩

/-- The data of the invariant of the closest-copy search: the loop counter stays below the
source size, and the returned index (in `rax`) stays below the loop counter. -/
structure CCData (b : FlatShuffler.Flat.Builder) (l : mappingBuilderClosestCopy.Lbl)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) : Prop where
  rcx : x.rcx = UInt64.ofBitVec b.sourceSize
  r9le : x.r9.toNat ≤ x.rcx.toNat
  rax : x.rax = 18446744073709551615 ∨ x.rax.toNat < x.r9.toNat
  rbx : l = .LBB29_4 → (x.rbx = 18446744073709551615 ∨ x.rbx.toNat ≤ x.r9.toNat)
  strict : x.r9.toNat < x.rcx.toNat ∨ l = .LBB29_1 ∨ l = .LBB29_13

theorem CCData.lt {b : FlatShuffler.Flat.Builder} {l : mappingBuilderClosestCopy.Lbl}
    {x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap} (h : CCData b l x)
    (h1 : l ≠ .LBB29_1) (h2 : l ≠ .LBB29_13) : x.r9.toNat < x.rcx.toNat := by
  rcases h.strict with h | h | h
  · exact h
  · exact absurd h h1
  · exact absurd h h2

def CCInv (b : FlatShuffler.Flat.Builder) (k : mappingBuilderClosestCopy.In2p) :
    mappingBuilderClosestCopy.Lbl →
      mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap → Prop
  | .entry, x => x = mappingBuilderClosestCopy.initP k
  | l, x => CCData b l x

/-- The result of the closest-copy search: no match, or an index below the array size. -/
def CCRes (_ : FlatShuffler.Flat.Builder) (r : UInt64) : Prop :=
  r = 18446744073709551615 ∨ r.toNat < 1024

theorem cc_block (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (xs ys : List (BitVec 64)) (k : mappingBuilderClosestCopy.In2p)
    (hC : b.sourceSize.toNat ≤ FlatShuffler.maxStackSize) (hrdi : k.rdi.toBitVec = 0)
    (hperm : (ownHeap b xs ys ++ frame).Perm k.heap)
    (hm : ∃ m, k.heap.Holds policy m) :
    ∀ (l : mappingBuilderClosestCopy.Lbl)
      (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
      (n : Next mappingBuilderClosestCopy.Lbl
        (mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) UInt64 Empty Empty.elim
        Empty.elim),
      CCInv b k l x → mappingBuilderClosestCopy.blocksP.step l x = .ok n →
      Lift.Sem.CallArm.Next.Inv (CCInv b k) (CCRes b) noCall n := by
  intro l x n hI hstep
  cases l with
  | entry =>
    obtain rfl : x = mappingBuilderClosestCopy.initP k := hI
    obtain ⟨m, hm⟩ := hm
    have hmem : k.heap.loadB (k.rdi.toBitVec + 8) .W64 = .ok b.sourceSize := by
      rw [hrdi]
      exact loadB_of_get hm (hperm.subset (by simp [ownHeap])) (w8_get b)
    simp only [mappingBuilderClosestCopy.blocksP, mappingBuilderClosestCopy.initP] at hstep
    rw [hmem] at hstep
    cases hstep
    exact ⟨rfl, by simp, Or.inl rfl, by simp, Or.inr (Or.inl rfl)⟩
  | LBB29_1 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    split at hstep
    · cases hstep
      exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inr (Or.inr rfl)⟩
    · rename_i hc
      cases hstep
      refine ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl ?_⟩
      have h2 : x.r9.toNat ≠ x.rcx.toNat := fun e => hc (UInt64.toNat_inj.mp e.symm)
      exact Nat.lt_of_le_of_ne hI.r9le h2
  | o51 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    split at hstep
    · split at hstep
      · split at hstep
        · split at hstep
          · split at hstep
            · cases hstep
              exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
            · cases hstep
              exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
          · cases hstep
          · cases hstep
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o72 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    split at hstep
    · split at hstep
      · split at hstep
        · cases hstep
          exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
        · cases hstep
          exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o83 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    split at hstep
    · split at hstep
      · split at hstep
        · cases hstep
          exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
        · cases hstep
          exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | LBB29_3 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    cases hstep
    refine ⟨hI.rcx, hI.r9le, hI.rax, ?_, Or.inl (hI.lt (by simp) (by simp))⟩
    intro _
    rcases hI.rax with h | h
    · exact Or.inl h
    · exact Or.inr (Nat.le_of_lt h)
  | LBB29_4 =>
    have hrbx := hI.rbx rfl
    have hlt : x.r9.toNat < x.rcx.toNat := hI.lt (by simp) (by simp)
    have hlt2 : x.r9.toNat + 1 < 2 ^ 64 := by
      have := UInt64.toNat_lt x.rcx
      omega
    have hadd : (x.r9 + 1).toNat = x.r9.toNat + 1 := by
      have h1 := UInt64.toNat_add x.r9 1
      have h2 : (1 : UInt64).toNat = 1 := by decide
      rw [h1, h2, Nat.mod_eq_of_lt hlt2]
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    cases hstep
    refine ⟨hI.rcx, ?_, ?_, by simp, Or.inr (Or.inl rfl)⟩
    · show (x.r9 + 1).toNat ≤ x.rcx.toNat
      rw [hadd]
      exact Nat.succ_le_of_lt hlt
    · rcases hrbx with h | h
      · exact Or.inl h
      · refine Or.inr ?_
        show x.rbx.toNat < (x.r9 + 1).toNat
        rw [hadd]
        exact Nat.lt_of_le_of_lt h (Nat.lt_succ_self _)
  | LBB29_7 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    split at hstep
    · split at hstep
      · cases hstep
        exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
      · cases hstep
        exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
    · cases hstep
    · cases hstep
  | o114 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    split at hstep
    · split at hstep
      · cases hstep
        exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
      · cases hstep
        exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
    · cases hstep
    · cases hstep
  | o141 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    cases hstep
    exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
  | LBB29_8 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    split at hstep
    · cases hstep
      exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
    · cases hstep
      exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
  | LBB29_10 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    split at hstep
    · cases hstep
      exact ⟨hI.rcx, hI.r9le, hI.rax, fun _ => Or.inr (Nat.le_refl _),
        Or.inl (hI.lt (by simp) (by simp))⟩
    · cases hstep
      exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
  | o156 =>
    by_cases hc : (if x.input.rsi ≤ x.rax then x.rax - x.input.rsi else x.input.rsi - x.rax) <
        (if x.r9 ≤ x.input.rsi then x.r11 else x.r8 + x.r9)
    · simp only [mappingBuilderClosestCopy.blocksP] at hstep
      rw [if_pos hc] at hstep
      cases hstep
      refine ⟨hI.rcx, hI.r9le, hI.rax, ?_, Or.inl (hI.lt (by simp) (by simp))⟩
      intro _
      rcases hI.rax with h | h
      · exact Or.inl h
      · exact Or.inr (Nat.le_of_lt h)
    · simp only [mappingBuilderClosestCopy.blocksP] at hstep
      rw [if_neg hc] at hstep
      cases hstep
      exact ⟨hI.rcx, hI.r9le, hI.rax, by simp, Or.inl (hI.lt (by simp) (by simp))⟩
  | o191 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    cases hstep
    exact ⟨hI.rcx, hI.r9le, hI.rax, fun _ => Or.inr (Nat.le_refl _),
      Or.inl (hI.lt (by simp) (by simp))⟩
  | LBB29_13 =>
    simp only [mappingBuilderClosestCopy.blocksP] at hstep
    cases hstep
    rcases hI.rax with h | h
    · exact Or.inl h
    · refine Or.inr ?_
      have h1 : x.r9.toNat ≤ b.sourceSize.toNat := by
        have hh := hI.r9le
        rw [hI.rcx] at hh
        rw [UInt64.toNat_ofBitVec] at hh
        exact hh
      have h2 : b.sourceSize.toNat ≤ 1024 := hC
      exact Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le h h1) h2

/-- The closest-copy search returns no match or an index below the array size. -/
theorem cc_bound (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (xs ys : List (BitVec 64)) (k : mappingBuilderClosestCopy.In2p) (r : UInt64)
    (hC : b.sourceSize.toNat ≤ FlatShuffler.maxStackSize) (hrdi : k.rdi.toBitVec = 0)
    (hperm : (ownHeap b xs ys ++ frame).Perm k.heap)
    (hm : ∃ m, k.heap.Holds policy m)
    (hr : mappingBuilderClosestCopy.l2p.returns k r) : CCRes b r :=
  Lift.Sem.CallArm.Blocks.Returns.inv (I := CCInv b k) (Q := CCRes b)
    (block := cc_block policy b frame xs ys k hC hrdi hperm hm) hr rfl

/-- The labels of the caller at which the loop counter is known to be below its bound. -/
def OuterStrict (l : Lbl) : Prop :=
  l = .o33 ∨ l = .o48 ∨ l = .o67 ∨ l = .o80 ∨ l = .o86 ∨ l = .o100 ∨ l = .LBB28_5

/-- The data of the invariant of the caller's run. -/
structure OuterData (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder)
    (xs ys : List (BitVec 64)) (l : Lbl) (x : St skel_call.In2p Heap) : Prop where
  hxs : xs.length = 1024
  hys : ys.length = 1024
  perm : (ownHeap b xs ys ++ frame).Perm x.mem
  holds : ∃ m, x.mem.Holds a.policy m
  inp : x.input = a
  rbx : x.rbx.toBitVec = 0
  r14 : x.r14.toNat ≤ x.r15.toNat
  r15 : x.r15.toNat ≤ 1024
  rax80 : l = .o80 → (x.rax = 18446744073709551615 ∨ x.rax.toNat < 1024)
  rax86 : l = .o86 → x.rax.toNat < 1024
  strict : OuterStrict l → x.r14.toNat < x.r15.toNat

theorem OuterData.lt {a : skel_call.In2p} {frame : Heap} {b : FlatShuffler.Flat.Builder}
    {xs ys : List (BitVec 64)} {l : Lbl} {x : St skel_call.In2p Heap}
    (h : OuterData a frame b xs ys l x) (hl : OuterStrict l) : x.r14.toNat < x.r15.toNat :=
  h.strict hl

def OuterInv (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder) :
    Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x = skel_call.initP a
  | l, x => ∃ xs ys, OuterData a frame b xs ys l x

/-- The result of the caller's run. -/
structure OuterRes (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder)
    (r : UInt64 × Heap) : Prop where
  perm : ∃ xs ys, xs.length = 1024 ∧ ys.length = 1024 ∧ (ownHeap b xs ys ++ frame).Perm r.2

theorem outer_block (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder)
    (M : FlatShuffler.Flat.Mapping)
    (hC : Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.C b M)
    (hrdi : a.rdi.toBitVec = 0) (hheap : a.heap = objsP b M ++ frame)
    (hm0 : ∃ m, a.heap.Holds a.policy m) :
    ∀ (l : Lbl) (x : St skel_call.In2p Heap)
      (n : Next Lbl (St skel_call.In2p Heap) (UInt64 × Heap) Cal CalP.In CalP.Out),
      OuterInv a frame b l x → skel_call.blocksP.step l x = .ok n →
      Lift.Sem.CallArm.Next.Inv (OuterInv a frame b) (OuterRes a frame b) CalP.rel n := by
  intro l x n hI hstep
  cases l with
  | entry =>
    obtain rfl : x = skel_call.initP a := hI
    obtain ⟨m0, hm0⟩ := hm0
    have hmem : a.heap.loadB (a.rdi.toBitVec + 24) .W64 = .ok b.targetSize := by
      rw [hrdi]
      exact loadB_of_get hm0 (by rw [hheap, objsP_eq]; simp [ownHeap]) (w24_get b)
    simp only [skel_call.blocksP, skel_call.initP] at hstep
    rw [hmem] at hstep
    cases hstep
    refine ⟨M.dest.toList, M.pos.toList, ⟨by rw [Vector.length_toList]; decide,

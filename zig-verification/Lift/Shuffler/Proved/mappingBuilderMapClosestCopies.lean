def callInput (a : skel_call.In2p) : In2p := { policy := a.policy, heap := a.heap, rax := a.rax, rbx := a.rbx, rdi := a.rdi, rbp := a.rbp, r12 := a.r12, r14 := a.r14, r15 := a.r15, sp := a.sp }


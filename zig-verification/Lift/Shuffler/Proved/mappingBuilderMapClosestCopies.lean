theorem slotWord_mask (s : FlatShuffler.StackSlot) :
    Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0 &&& 281474976710655
      = Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0 := by
  obtain ⟨p, k, v⟩ := s
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word]
  bv_decide

theorem slotWord_inj {s s' : FlatShuffler.StackSlot}
    (h : Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0
      = Lift.Shuffler.Internal.Proposed.Layout.slotWord s' 0) : s = s' := by
  obtain ⟨p, k, v⟩ := s
  obtain ⟨p', k', v'⟩ := s'
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word] at h
  have h' : p = p' ∧ k = k' ∧ v = v' := by bv_decide
  obtain ⟨rfl, rfl, rfl⟩ := h'
  rfl

theorem get_source (b : FlatShuffler.Flat.Builder) (i : BitVec 64) :
    FlatShuffler.Flat.get b.source i = b.source.toList.getD i.toNat default := by
  rw [FlatShuffler.Flat.get]
  by_cases h : i.toNat < FlatShuffler.maxStackSize
  · rw [dif_pos h]
    simp only [List.getD, Vector.length_toList]
    rw [List.getElem?_eq_getElem (by simpa [Vector.length_toList] using h), Option.getD_some]
    exact (Vector.getElem_toList (by simpa [Vector.length_toList] using h)).symm
  · rw [dif_neg h]
    simp only [List.getD, Vector.length_toList]
    rw [List.getElem?_eq_none (by simpa [Vector.length_toList] using Nat.le_of_not_lt h)]
    rfl


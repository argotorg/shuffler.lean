  rw [h1, hw]
  intro h
  exact absurd h (by decide)

/-! ### The byte loads -/

/-- Two objects of a held heap that have bytes at the same address agree there. -/
theorem loadBytes_agree {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds policy m)
    {o₁ o₂ : Obj} (h₁ : o₁ ∈ h) (h₂ : o₂ ∈ h) {a : BitVec 64} {w : Width}
    {v₁ v₂ : w.type} (e₁ : o₁.loadBytes a w = some v₁) (e₂ : o₂.loadBytes a w = some v₂) :
    v₁ = v₂ := by
  obtain ⟨k₁, ha₁, hk₁, hv₁⟩ := Obj.loadBytes_spec e₁
  obtain ⟨k₂, ha₂, hk₂, hv₂⟩ := Obj.loadBytes_spec e₂
  have c₁ := Lift.Sem.ByteLemmas.Contains.slice (hh.contains h₁) k₁ w.bytes
  have c₂ := Lift.Sem.ByteLemmas.Contains.slice (hh.contains h₂) k₂ w.bytes
  rw [← ha₁] at c₁
  rw [← ha₂] at c₂
  have hlen₁ : (List.take w.bytes (List.drop k₁ o₁.bytes)).length = w.bytes := by
    simp only [List.length_take, List.length_drop, Obj.bytes_length]
    omega
  have hlen₂ : (List.take w.bytes (List.drop k₂ o₂.bytes)).length = w.bytes := by
    simp only [List.length_take, List.length_drop, Obj.bytes_length]
    omega
  simp only [Mem.Contains, hlen₁, hlen₂] at c₁ c₂
  rw [c₁] at c₂
  simp only [Option.some.injEq] at c₂
  rw [hv₁, hv₂, c₂]

/-- The byte fallback of a heap load: an object with those bytes gives the value. -/
theorem loadB_eq_of_loadBytes {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds policy m)
    {o : Obj} (ho : o ∈ h) {a : BitVec 64} {w : Width} {v : w.type}
    (hv : o.loadBytes a w = some v) : h.loadB a w = .ok v := by
  obtain ⟨k, ha, hk, hvk⟩ := Obj.loadBytes_spec hv
  unfold Heap.loadB
  split
  · rename_i v' hl'
    have hr := Heap.load_sound hh hl'
    have hp : policy.permits (.read a w) = true := by
      unfold readRam at hr
      split at hr
      · assumption
      · cases hr
    rw [readRam_slice hh ho ha hk hp] at hr
    simp only [Except.ok.injEq] at hr
    rw [← hr, ← hvk]
  · split
    · rename_i v'' hf
      obtain ⟨o', ho', hlb⟩ := List.exists_of_findSome?_eq_some hf
      rw [loadBytes_agree hh ho' ho hlb hv]
    · rename_i hf
      rw [List.findSome?_eq_none_iff] at hf
      rw [hf o ho] at hv
      cases hv

/-! ### The byte loads -/

/-- The kind byte of a slot word. -/
theorem slotWord_extract (s : FlatShuffler.StackSlot) :
    (Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0).extractLsb' 32 8 = s.kind := by
  obtain ⟨p, k, v⟩ := s
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word]
  bv_decide

/-- A byte read inside a word read: the byte `[4]` of the word. -/
theorem byte_eq_extract {m : Mem 64} {b : BitVec 64} {v : BitVec 64} {w : BitVec 8}
    (h1 : m.Contains b (Int.toBytes 8 v.toInt)) (h2 : m.Contains (b + 4) (Int.toBytes 1 w.toInt)) :
    w = v.extractLsb' 32 8 := by
  have h2' : m.Contains (b + BitVec.ofNat 64 4) (((Int.toBytes 8 v.toInt).drop 4).take 1) :=
    Lift.Sem.ByteLemmas.Contains.slice h1 4 1
  have l1 : (Int.toBytes 1 w.toInt).length = 1 := Int.toBytes_length 1 w.toInt
  have l2 : (((Int.toBytes 8 v.toInt).drop 4).take 1).length = 1 := by
    rw [List.length_take, List.length_drop, Int.toBytes_length]
    omega
  have e1 : m.loadBytes (b + 4) 1 = some (Int.toBytes 1 w.toInt) := by
    have hh := h2
    unfold Mem.Contains at hh
    rwa [l1] at hh
  have e2 : m.loadBytes (b + 4) 1 = some (((Int.toBytes 8 v.toInt).drop 4).take 1) := by
    have hh := h2'
    unfold Mem.Contains at hh
    rwa [l2] at hh
  have he : Int.toBytes 1 w.toInt = ((Int.toBytes 8 v.toInt).drop 4).take 1 := by
    rw [e1] at e2
    exact (Option.some.injEq _ _).mp e2
  have step1 : w = BitVec.ofInt 8 (Int.ofBytes (Int.toBytes 1 w.toInt)) := by
    rw [BitVec.ofInt_ofBytes_toBytes 8 1 rfl, BitVec.ofInt_toInt]
  rw [step1, he]
  exact Lift.Sem.ByteLemmas.ofInt_slice_toBytes 8 v 4 1 (by decide)

/-- The kind byte of `b.target[i]`, read from the bytes of the target array. -/
theorem target_loadBytes (b : FlatShuffler.Flat.Builder) (i : BitVec 64)
    (hi : i.toNat < FlatShuffler.maxStackSize) :
    (Obj.words 8256 false .W64 ((List.range FlatShuffler.maxStackSize).map
      (fun j => Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD j default) 0))).loadBytes
      (8256 + i * 8 + 4) .W8 = some (b.target.toList.getD i.toNat default).kind := by
  have hsize : (Obj.words 8256 false .W64 ((List.range FlatShuffler.maxStackSize).map
      (fun j => Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD j default) 0))).size
      = 8 * FlatShuffler.maxStackSize := by
    unfold Obj.words Obj.size
    rw [words_bytes, List.length_map, List.length_range]
  have hbytes : (Obj.words 8256 false .W64 ((List.range FlatShuffler.maxStackSize).map
      (fun j => Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD j default) 0))).bytes
      = (List.range FlatShuffler.maxStackSize).flatMap
        (fun j => Int.toBytes 8 (Lift.Shuffler.Internal.Proposed.Layout.slotWord
          (b.target.toList.getD j default) 0).toInt) := by
    simp only [Obj.bytes, Obj.words, Cell.bytes, List.flatMap_map, List.map_map, Function.comp_def]
  have hi' : i.toNat < 1024 := hi
  have h1 : (8256 + i * 8 + 4).toNat = 8256 + 8 * i.toNat + 4 := by bv_omega
  have hspan : (Obj.words 8256 false .W64 ((List.range FlatShuffler.maxStackSize).map
      (fun j => Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD j default) 0))).Spans
      (8256 + i * 8 + 4) .W8 := by
    unfold Obj.Spans
    rw [hsize]
    show (8256 : Nat) ≤ (8256 + i * 8 + 4).toNat ∧
      (8256 + i * 8 + 4).toNat + 1 ≤ (8256 : Nat) + 8 * FlatShuffler.maxStackSize
    rw [h1]
    constructor <;> omega
  unfold Obj.loadBytes
  rw [if_pos hspan]
  have haddr : (Obj.words 8256 false .W64 ((List.range FlatShuffler.maxStackSize).map
      (fun j => Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD j default) 0))).addr
      = 8256 := rfl
  have hoff : (8256 + i * 8 + 4).toNat - (Obj.words 8256 false .W64 ((List.range FlatShuffler.maxStackSize).map
      (fun j => Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD j default) 0))).addr.toNat
      = 8 * i.toNat + 4 := by
    rw [haddr]
    bv_omega
  rw [hoff, hbytes, drop_flatMap_eq _ 8 (fun _ => Int.toBytes_length _ _)
    (List.range FlatShuffler.maxStackSize) i.toNat 4 (by simpa using hi) (by decide)]
  rw [List.take_append_of_le_length (by simp [Int.toBytes_length])]
  refine congrArg some ?_
  simp only [List.getElem_range]
  rw [Lift.Sem.ByteLemmas.ofInt_slice_toBytes 8 _ 4 1 (by decide), slotWord_extract]

/-- The byte `b.dropped[i]`. -/
theorem loadB_dropped (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (m : DataMem) (hh : (objsP b M ++ frame).Holds pol m) (i : BitVec 64)
    (hi : i.toNat < FlatShuffler.maxStackSize) :
    (objsP b M ++ frame).loadB (16448 + i) .W8 = .ok (b.dropped.toList.getD i.toNat default) := by
  have hk : i.toNat < b.dropped.toList.length := by simpa using hi
  have hl : (objsP b M ++ frame).load (16448 + i) .W8
      = .ok (b.dropped.toList.getD i.toNat default) := by
    have h := Heap.load_words (w := .W8) (base := 16448) (wr := false)
      (xs := b.dropped.toList) hh (mem_dropped b M frame) hk
    simpa [List.getD, List.getElem?_eq_getElem hk] using h
  rw [Heap.loadB_of_load hl]

/-- The kind byte of `b.target[i]`, read from the heap. -/
theorem loadB_kind (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (m : DataMem) (hh : (objsP b M ++ frame).Holds pol m) (i : BitVec 64)
    (hi : i.toNat < FlatShuffler.maxStackSize) :
    (objsP b M ++ frame).loadB (8256 + i * 8 + 4) .W8
      = .ok (b.target.toList.getD i.toNat default).kind := by
  have hkind := target_loadBytes b i hi
  have ho := mem_target b M frame
  unfold Heap.loadB
  split
  · rename_i v' hl'
    have h1 := readRam_contains (Heap.load_sound hh hl')
    have h2 := readRam_contains (Heap.load_sound hh (load_target b M frame pol m hh i hi))
    rw [byte_eq_extract h2 h1, slotWord_extract]
  · split
    · rename_i v hf
      obtain ⟨o', ho', hlb⟩ := List.exists_of_findSome?_eq_some hf
      rw [loadBytes_agree hh ho' ho hlb hkind]
    · rename_i hf
      rw [List.findSome?_eq_none_iff] at hf
      rw [hf _ ho] at hkind
      cases hkind

/-! ### The callee `mappingBuilderClosestCopy`: the scan of `closestFrom` -/

theorem cf_pos {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping} {t : BitVec 64}
    {inW : Bool} {i best : BitVec 64} (h : i.toNat < b.sourceSize.toNat) :
    FlatShuffler.Flat.closestFrom b M t inW i best =
      FlatShuffler.Flat.closestFrom b M t inW (i + 1)
        (if (FlatShuffler.Flat.get b.source i = FlatShuffler.Flat.get b.target t &&
            FlatShuffler.Flat.mappable b M i &&
            FlatShuffler.Flat.inWildcardSlot b i == inW) then
          (if best = FlatShuffler.Flat.NONE ||
              FlatShuffler.Flat.absDiff i t ≤ FlatShuffler.Flat.absDiff best t then i else best)
        else best) := by
  rw [FlatShuffler.Flat.closestFrom]
  exact dif_pos h

theorem cf_neg {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping} {t : BitVec 64}
    {inW : Bool} {i best : BitVec 64} (h : ¬ i.toNat < b.sourceSize.toNat) :
    FlatShuffler.Flat.closestFrom b M t inW i best = best := by
  rw [FlatShuffler.Flat.closestFrom]
  exact dif_neg h

/-- The values the loop of `closestFrom` reads. -/
def c0T (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) : BitVec 64 :=
  Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.target.toList.getD x.input.rsi.toNat default) 0

def c0S (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) : BitVec 64 :=
  Lift.Shuffler.Internal.Proposed.Layout.slotWord (b.source.toList.getD x.r9.toNat default) 0

def c0D (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) : BitVec 8 :=
  b.dropped.toList.getD x.r9.toNat default

def c0Dst (M : FlatShuffler.Flat.Mapping)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) : BitVec 64 :=
  M.dest.toList.getD x.r9.toNat default

def c0K (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) : BitVec 8 :=
  (b.target.toList.getD x.r9.toNat default).kind

structure C0Inv (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) : Prop where
  input : x.input = a0
  rdi : x.input.rdi.toBitVec = 0
  mem : x.mem = objsP b M ++ frame
  rcx : x.rcx = UInt64.ofBitVec b.sourceSize
  r9 : x.r9.toBitVec.toNat ≤ b.sourceSize.toNat
  r10 : x.r10 = 4294967296
  r8 : x.r8.toBitVec = 0 - x.input.rsi.toBitVec
  r11 : x.r11.toBitVec = x.input.rsi.toBitVec - x.r9.toBitVec
  rsi : x.input.rsi.toNat < FlatShuffler.maxStackSize
  size : b.sourceSize.toNat ≤ FlatShuffler.maxStackSize
  holds : ∃ m, x.mem.Holds pol m

def c0Out (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) : UInt64 :=
  UInt64.ofBitVec (FlatShuffler.Flat.closestFrom b M x.input.rsi.toBitVec
    (x.input.rdx.toUInt8.toUInt64 != 0) x.r9.toBitVec x.rax.toBitVec)

theorem c0_load1 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) : x.mem.loadB x.input.rdi.toBitVec .W64 = .ok 64 := by
  obtain ⟨m, hm⟩ := h.holds
  rw [h.mem] at hm
  rw [h.mem, h.rdi]
  exact Heap.loadB_of_load (load_sourcePtr b M frame pol m hm)

theorem c0_load2 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) :
    x.mem.loadB (x.input.rdi.toBitVec + 16) .W64 = .ok 8256 := by
  obtain ⟨m, hm⟩ := h.holds
  rw [h.mem] at hm
  rw [h.mem, h.rdi]
  simpa using Heap.loadB_of_load (load_targetPtr b M frame pol m hm)

theorem c0_load3 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) :
    x.mem.loadB (8256 + x.input.rsi.toBitVec * 8) .W64 = .ok (c0T b x) := by
  obtain ⟨m, hm⟩ := h.holds
  have hrsi : x.input.rsi.toBitVec.toNat < FlatShuffler.maxStackSize := by simpa using h.rsi
  rw [h.mem] at hm
  rw [h.mem]
  simpa [c0T, UInt64.toNat_toBitVec] using
    Heap.loadB_of_load (load_target b M frame pol m hm x.input.rsi.toBitVec hrsi)

theorem c0_load4 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) (hi : x.r9.toBitVec.toNat < FlatShuffler.maxStackSize) :
    x.mem.loadB (64 + x.r9.toBitVec * 8) .W64 = .ok (c0S b x) := by
  obtain ⟨m, hm⟩ := h.holds
  rw [h.mem] at hm
  rw [h.mem]
  simpa [c0S, UInt64.toNat_toBitVec] using
    Heap.loadB_of_load (load_source b M frame pol m hm x.r9.toBitVec hi)

theorem c0_load5 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) :
    x.mem.loadB (x.input.rdi.toBitVec + 32) .W64 = .ok 16448 := by
  obtain ⟨m, hm⟩ := h.holds
  rw [h.mem] at hm
  rw [h.mem, h.rdi]
  simpa using Heap.loadB_of_load (load_droppedPtr b M frame pol m hm)

theorem c0_load6 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) (hi : x.r9.toBitVec.toNat < FlatShuffler.maxStackSize) :
    x.mem.loadB (16448 + x.r9.toBitVec * 1) .W8 = .ok (c0D b x) := by
  obtain ⟨m, hm⟩ := h.holds
  rw [h.mem] at hm
  rw [h.mem]
  simpa [c0D, UInt64.toNat_toBitVec, BitVec.mul_one] using
    loadB_dropped b M frame pol m hm x.r9.toBitVec hi

theorem c0_load7 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) :
    x.mem.loadB (x.input.rdi.toBitVec + 48) .W64 = .ok 17472 := by
  obtain ⟨m, hm⟩ := h.holds
  rw [h.mem] at hm
  rw [h.mem, h.rdi]
  simpa using Heap.loadB_of_load (load_mappingPtr b M frame pol m hm)

theorem c0_load8 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) (hi : x.r9.toBitVec.toNat < FlatShuffler.maxStackSize) :
    x.mem.loadB (17472 + x.r9.toBitVec * 8) .W64 = .ok (c0Dst M x) := by
  obtain ⟨m, hm⟩ := h.holds
  have hlen : M.dest.toList.length = FlatShuffler.maxStackSize := by simp
  have hk : x.r9.toBitVec.toNat < M.dest.toList.length := by rw [hlen]; exact hi
  rw [h.mem] at hm
  rw [h.mem]
  show (objsP b M ++ frame).loadB (17472 + x.r9.toBitVec * 8) .W64
    = .ok (M.dest.toList.getD x.r9.toNat default)
  have hgd : M.dest.toList.getD x.r9.toNat default = M.dest.toList[x.r9.toNat]'hk := by
    have hk' : x.r9.toNat < M.dest.toList.length := by
      rw [← UInt64.toNat_toBitVec]; exact hk
    simp [List.getD, List.getElem?_eq_getElem hk']
  rw [hgd]
  exact Heap.loadB_of_load (load_dest b M frame pol m hm x.r9.toBitVec hk)

theorem c0_load9 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) :
    x.mem.loadB (x.input.rdi.toBitVec + 24) .W64 = .ok b.targetSize := by
  obtain ⟨m, hm⟩ := h.holds
  rw [h.mem] at hm
  rw [h.mem, h.rdi]
  simpa using Heap.loadB_of_load (load_targetSize b M frame pol m hm)

theorem c0_load10 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) (hi : x.r9.toBitVec.toNat < FlatShuffler.maxStackSize) :
    x.mem.loadB (8256 + x.r9.toBitVec * 8 + 4) .W8 = .ok (c0K b x) := by
  obtain ⟨m, hm⟩ := h.holds
  rw [h.mem] at hm
  rw [h.mem]
  simpa [c0K, UInt64.toNat_toBitVec] using loadB_kind b M frame pol m hm x.r9.toBitVec hi

/-- The state after the loads of `.o51`. -/
def c0X1 (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) :
    mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap :=
  { x with rbx := UInt64.ofBitVec 8256, r14 := UInt64.ofBitVec 64, r15 := (UInt64.ofBitVec (c0T b x) ^^^ UInt64.ofBitVec (c0S b x)) <<< 16 }

/-- The state after the loads of `.o72`. -/
def c0X2 (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) :
    mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap :=
  { c0X1 b x with r14 := UInt64.ofBitVec 16448 }

/-- The state after the loads of `.o83`. -/
def c0X3 (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) :
    mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap :=
  { c0X2 b x with r14 := UInt64.ofBitVec 17472 }

/-- The state after the flag write of `.o114`. -/
def c0F (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) :
    mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap :=
  { c0X3 b x with rbx := (((UInt64.ofBitVec (BitVec.zeroExtend 64 (c0K b x)) <<< 32 &&& 18446744073709551360) ||| ((if UInt64.ofBitVec (BitVec.zeroExtend 64 (c0K b x)) <<< 32 = x.r10 then 1 else 0) &&& 255)) &&& 18446744073709551360) ||| (((if UInt64.ofBitVec (BitVec.zeroExtend 64 (c0K b x)) <<< 32 = x.r10 then 1 else 0) ^^^ (if ¬(x.input.rdx.toUInt8.toUInt64 = 0) then 1 else 0)) &&& 255), rbp := (x.rbp &&& 18446744073709551360) ||| ((if ¬(x.input.rdx.toUInt8.toUInt64 = 0) then 1 else 0) &&& 255) }

/-- The state at `.LBB29_4` after `.LBB29_3`. -/
def c0Z (s : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) :
    mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap := { s with rbx := s.rax }

/-- The state at `.LBB29_4` after `.LBB29_10` or `.o191`. -/
def c0W (s : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) :
    mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap := { s with rbx := s.r9 }

/-- The state at `.LBB29_4` after `.o156`. -/
def c0V (s : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) :
    mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap :=
  { s with rbx := s.rax, r14 := (if s.r9 ≤ s.input.rsi then s.r11 else s.r8 + s.r9), r15 := (if s.input.rsi ≤ s.rax then s.rax - s.input.rsi else s.input.rsi - s.rax) }

/-- The state at the head after `.LBB29_4`. -/
def c0Y (s : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) :
    mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap :=
  { s with rax := s.rbx, r9 := s.r9 + 1, r11 := s.r11 - 1 }

theorem c0_r9_ne (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 x) (hne : x.r9.toBitVec ≠ b.sourceSize) :
    x.r9.toBitVec.toNat < b.sourceSize.toNat := by
  have h1 : x.r9.toBitVec.toNat ≤ b.sourceSize.toNat := h.r9
  have h2 : x.r9.toBitVec.toNat ≠ b.sourceSize.toNat := by
    intro he
    exact hne (BitVec.eq_of_toNat_eq he)
  omega

theorem c0Inv_step (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (s : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : C0Inv b M frame pol a0 s) (hne : s.r9.toBitVec ≠ b.sourceSize) :
    C0Inv b M frame pol a0 (c0Y s) := by
  have hlt := c0_r9_ne b M frame pol a0 s h hne
  have e9 : (c0Y s).r9.toBitVec = s.r9.toBitVec + 1 := by
    show (s.r9 + 1).toBitVec = s.r9.toBitVec + 1
    rw [UInt64.toBitVec_add]; rfl
  have h9 : (c0Y s).r9.toBitVec.toNat ≤ b.sourceSize.toNat := by
    rw [e9]; bv_omega
  have h11 : (c0Y s).r11.toBitVec = (c0Y s).input.rsi.toBitVec - (c0Y s).r9.toBitVec := by
    show (s.r11 - 1).toBitVec = s.input.rsi.toBitVec - (s.r9 + 1).toBitVec
    rw [UInt64.toBitVec_sub, UInt64.toBitVec_add, h.r11, UInt64.toBitVec_ofNat]
    bv_omega
  exact ⟨h.input, h.rdi, h.mem, h.rcx, h9, h.r10, h.r8, h11, h.rsi, h.size, h.holds⟩

theorem c0Inv_congr {b : FlatShuffler.Flat.Builder} {M : FlatShuffler.Flat.Mapping} {frame : Heap}
    {pol : CpuPolicy} {a0 : mappingBuilderClosestCopy.In2p}
    {s x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap}
    (hin : s.input = x.input) (hmem : s.mem = x.mem) (hrcx : s.rcx = x.rcx) (hr9 : s.r9 = x.r9)
    (hr10 : s.r10 = x.r10) (hr8 : s.r8 = x.r8) (hr11 : s.r11 = x.r11)
    (h : C0Inv b M frame pol a0 x) : C0Inv b M frame pol a0 s :=
  ⟨by rw [hin]; exact h.input, by rw [hin]; exact h.rdi, by rw [hmem]; exact h.mem,
   by rw [hrcx]; exact h.rcx, by rw [hr9]; exact h.r9, by rw [hr10]; exact h.r10,
   by rw [hr8, hin]; exact h.r8, by rw [hr11, hin, hr9]; exact h.r11, by rw [hin]; exact h.rsi, h.size,
   by rw [hmem]; exact h.holds⟩

theorem c0_dec (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p)
    (s x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (hs : s.r9 = x.r9) (h : C0Inv b M frame pol a0 s) (hne : s.r9.toBitVec ≠ b.sourceSize) :
    b.sourceSize.toNat - (c0Y s).r9.toBitVec.toNat < b.sourceSize.toNat - x.r9.toBitVec.toNat := by
  have h1 : s.r9.toBitVec.toNat ≤ b.sourceSize.toNat := h.r9
  have h2 : s.r9.toBitVec.toNat ≠ b.sourceSize.toNat := by
    intro he
    exact hne (BitVec.eq_of_toNat_eq he)
  have hlt : s.r9.toBitVec.toNat < b.sourceSize.toNat := by omega
  rw [hs] at hlt
  have e9 : (c0Y s).r9.toBitVec.toNat = s.r9.toBitVec.toNat + 1 := by
    have e : (c0Y s).r9.toBitVec = s.r9.toBitVec + 1 := by
      show (s.r9 + 1).toBitVec = s.r9.toBitVec + 1
      rw [UInt64.toBitVec_add]; rfl
    rw [e]
    bv_omega
  rw [e9, hs]
  omega

theorem c0_mask_eq_of_get (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : FlatShuffler.Flat.get b.source x.r9.toBitVec
      = FlatShuffler.Flat.get b.target x.input.rsi.toBitVec) :
    UInt64.ofBitVec (c0T b x) &&& 281474976710655
      = UInt64.ofBitVec (c0S b x) &&& 281474976710655 := by
  have h1 : c0S b x = c0T b x := by
    rw [c0S, c0T]
    simp only [← UInt64.toNat_toBitVec]
    rw [← get_source b x.r9.toBitVec, ← get_target b x.input.rsi.toBitVec]
    exact congrArg (fun s => Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0) h
  rw [h1]

theorem c0_get_of_mask_eq (b : FlatShuffler.Flat.Builder)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (h : UInt64.ofBitVec (c0T b x) &&& 281474976710655
      = UInt64.ofBitVec (c0S b x) &&& 281474976710655) :
    FlatShuffler.Flat.get b.source x.r9.toBitVec
      = FlatShuffler.Flat.get b.target x.input.rsi.toBitVec := by
  have h2 : c0T b x = c0S b x := by
    have h3 := congrArg UInt64.toBitVec h
    simp only [UInt64.toBitVec_and, UInt64.toBitVec_ofBitVec, UInt64.toBitVec_ofNat, c0T, c0S] at h3
    rw [c0T, c0S, ← slotWord_mask (b.target.toList.getD x.input.rsi.toNat default),
      ← slotWord_mask (b.source.toList.getD x.r9.toNat default)]
    exact h3
  rw [get_source, get_target]
  exact (slotWord_inj h2).symm

/-! ### The arithmetic of `absDiff` and the `if` conditions of the code -/

theorem absDiff_eq (i t : BitVec 64) :
    FlatShuffler.Flat.absDiff i t = if i ≤ t then t - i else i - t := by
  rw [FlatShuffler.Flat.absDiff]
  by_cases h : i ≤ t
  · rw [if_neg (by bv_omega), if_pos h]
  · rw [if_pos (by bv_omega), if_neg h]

/-- The code's `r14` at `.o156`: `|i - t|`. -/
theorem absDiff_code_i (i t r8 r11 : UInt64)
    (h8 : r8.toBitVec = 0 - t.toBitVec) (h11 : r11.toBitVec = t.toBitVec - i.toBitVec) :
    (if i ≤ t then r11 else r8 + i)
      = UInt64.ofBitVec (FlatShuffler.Flat.absDiff i.toBitVec t.toBitVec) := by
  rw [← UInt64.toBitVec_inj, UInt64.toBitVec_ofBitVec, apply_ite UInt64.toBitVec,
    FlatShuffler.Flat.absDiff]
  by_cases h : i ≤ t
  · have h' : i.toBitVec ≤ t.toBitVec := h
    rw [if_pos h, if_neg (by bv_omega), h11]
  · have h' : ¬ (i.toBitVec ≤ t.toBitVec) := h
    rw [if_neg h, if_pos (by bv_omega), UInt64.toBitVec_add, h8]
    bv_omega

/-- The code's `r15` at `.o156`: `|best - t|`. -/
theorem absDiff_code_best (t best : UInt64) :
    (if t ≤ best then best - t else t - best)
      = UInt64.ofBitVec (FlatShuffler.Flat.absDiff best.toBitVec t.toBitVec) := by
  rw [← UInt64.toBitVec_inj, UInt64.toBitVec_ofBitVec, apply_ite UInt64.toBitVec,
    FlatShuffler.Flat.absDiff]
  by_cases h : t ≤ best
  · have h' : t.toBitVec ≤ best.toBitVec := h
    rw [if_pos h]
    by_cases h2 : best ≤ t
    · have h2' : best.toBitVec ≤ t.toBitVec := h2
      have he : best = t := UInt64.toBitVec_inj.mp (by bv_omega)
      subst he
      rw [if_neg (by bv_omega), UInt64.toBitVec_sub]
    · have h2' : ¬ (best.toBitVec ≤ t.toBitVec) := h2
      rw [if_pos (by bv_omega), UInt64.toBitVec_sub]
  · have h' : ¬ (t.toBitVec ≤ best.toBitVec) := h
    rw [if_neg h, if_neg (by bv_omega), UInt64.toBitVec_sub]

/-- The `kind` test of the code: `kind <<< 32 = 2 ^ 32` is `kind = Junk`. -/
theorem shift32_eq (v : BitVec 8) :
    (UInt64.ofBitVec (BitVec.zeroExtend 64 v) <<< (32 : UInt64) = 4294967296) ↔ v = 1 := by
  rw [← UInt64.toBitVec_inj]
  rw [UInt64.toBitVec_shiftLeft, UInt64.toBitVec_ofBitVec, UInt64.toBitVec_ofNat]
  constructor
  · intro h
    bv_decide
  · intro h
    subst h
    rfl

theorem shift32_eq' (v : BitVec 8) (u : UInt64) (hu : u = 4294967296) :
    (UInt64.ofBitVec (BitVec.zeroExtend 64 v) <<< (32 : UInt64) = u) ↔ v = 1 := by
  subst hu
  exact shift32_eq v

theorem absDiff_not_le (i t best : UInt64)
    (h : FlatShuffler.Flat.absDiff best.toBitVec t.toBitVec
      < FlatShuffler.Flat.absDiff i.toBitVec t.toBitVec) :
    ¬ (FlatShuffler.Flat.absDiff i.toBitVec t.toBitVec
      ≤ FlatShuffler.Flat.absDiff best.toBitVec t.toBitVec) := by
  intro hh
  bv_omega

theorem absDiff_le (i t best : UInt64)
    (h : ¬ (FlatShuffler.Flat.absDiff best.toBitVec t.toBitVec
      < FlatShuffler.Flat.absDiff i.toBitVec t.toBitVec)) :
    FlatShuffler.Flat.absDiff i.toBitVec t.toBitVec
      ≤ FlatShuffler.Flat.absDiff best.toBitVec t.toBitVec := by
  apply Classical.byContradiction
  intro hh
  exact h (by bv_omega)

theorem toBitVec_eq_none_iff (u : UInt64) :
    (u.toBitVec = FlatShuffler.Flat.NONE) ↔ u = 18446744073709551615 := by
  have hW : (18446744073709551615 : UInt64).toBitVec = FlatShuffler.Flat.NONE := by decide
  rw [← hW]
  exact UInt64.toBitVec_inj

theorem c0Y_r9 (s : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap) :
    (c0Y s).r9.toBitVec = s.r9.toBitVec + 1 := by
  show (s.r9 + 1).toBitVec = s.r9.toBitVec + 1
  rw [UInt64.toBitVec_add]
  rfl

theorem c0_get_dropped_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (hc2 : UInt64.ofBitVec (BitVec.zeroExtend 64 (c0D b x)) = 0) :
    FlatShuffler.Flat.get b.dropped x.r9.toBitVec = 0 := by
  have hz : BitVec.zeroExtend 64 (c0D b x) = 0 := by
    have h := congrArg UInt64.toBitVec hc2
    simpa using h
  have h0 : c0D b x = 0 := by bv_decide
  rw [get_dropped]
  exact h0

theorem c0_get_dest_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (hc3 : UInt64.ofBitVec (c0Dst M x) = 18446744073709551615) :
    FlatShuffler.Flat.get M.dest x.r9.toBitVec = FlatShuffler.Flat.NONE := by
  have h1 : c0Dst M x = (18446744073709551615 : BitVec 64) :=
    (ofBitVec_eq_ones (c0Dst M x)).mp hc3
  rw [get_dest]
  show M.dest.toList.getD x.r9.toNat default = FlatShuffler.Flat.NONE
  rw [show M.dest.toList.getD x.r9.toNat default = c0Dst M x from rfl, h1,
    FlatShuffler.Flat.NONE]
  decide

theorem c0_kind_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (hc5 : (UInt64.ofBitVec (BitVec.zeroExtend 64 (c0K b x)) <<< (32 : UInt64) = x.r10)
      ↔ (¬ (x.input.rdx.toUInt8.toUInt64 = 0)))
    (hr10 : x.r10 = 4294967296) :
    (c0K b x == (1 : BitVec 8)) = (x.input.rdx.toUInt8.toUInt64 != 0) := by
  have hiff : (c0K b x = 1) ↔ (x.input.rdx.toUInt8.toUInt64 ≠ 0) := by
    rw [← shift32_eq' (c0K b x) x.r10 hr10]
    exact hc5
  by_cases h : c0K b x = 1
  · have hu : (x.input.rdx.toUInt8.toUInt64 != 0) = true := by
      rw [bne_iff_ne]
      exact hiff.mp h
    rw [hu, show (c0K b x == (1 : BitVec 8)) = true from by simpa using h]
  · have hu : (x.input.rdx.toUInt8.toUInt64 != 0) = false := by
      have hne : ¬ (x.input.rdx.toUInt8.toUInt64 ≠ 0) := fun hh => h (hiff.mpr hh)
      simpa using hne
    rw [hu, show (c0K b x == (1 : BitVec 8)) = false from by simpa using h]

/-- Below `targetSize`, `inWildcardSlot` is the `kind` test of the code. -/
theorem c0_inWildcardSlot_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (hc4 : ¬ (UInt64.ofBitVec b.targetSize ≤ x.r9)) :
    FlatShuffler.Flat.inWildcardSlot b x.r9.toBitVec = (c0K b x == (1 : BitVec 8)) := by
  have hlt_t : x.r9.toBitVec < b.targetSize := by
    have h4 : ¬ (b.targetSize ≤ x.r9.toBitVec) := hc4
    bv_omega
  rw [FlatShuffler.Flat.inWildcardSlot, FlatShuffler.Flat.isWildcardTarget, FlatShuffler.isJunk,
    get_target]
  simp [hlt_t, c0K, FlatShuffler.Junk]

/-- The `Bool` condition of `closestFrom`, decided true. -/
theorem c0_cond_true (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (hsrctgt : FlatShuffler.Flat.get b.source x.r9.toBitVec
      = FlatShuffler.Flat.get b.target x.input.rsi.toBitVec)
    (hmap : FlatShuffler.Flat.mappable b M x.r9.toBitVec = true)
    (hinw : (FlatShuffler.Flat.inWildcardSlot b x.r9.toBitVec
      == (x.input.rdx.toUInt8.toUInt64 != 0)) = true) :
    (FlatShuffler.Flat.get b.source x.r9.toBitVec
        = FlatShuffler.Flat.get b.target x.input.rsi.toBitVec
      && FlatShuffler.Flat.mappable b M x.r9.toBitVec
      && FlatShuffler.Flat.inWildcardSlot b x.r9.toBitVec
        == (x.input.rdx.toUInt8.toUInt64 != 0)) = true := by
  rw [hsrctgt, hmap, hinw]; simp

/-- The `Bool` condition of `closestFrom`, decided false. -/
theorem c0_cond_false (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (x : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (hsrctgt : FlatShuffler.Flat.get b.source x.r9.toBitVec
      = FlatShuffler.Flat.get b.target x.input.rsi.toBitVec)
    (hmap : FlatShuffler.Flat.mappable b M x.r9.toBitVec = true)
    (hinw : (FlatShuffler.Flat.inWildcardSlot b x.r9.toBitVec
      == (x.input.rdx.toUInt8.toUInt64 != 0)) = false) :
    (FlatShuffler.Flat.get b.source x.r9.toBitVec
        = FlatShuffler.Flat.get b.target x.input.rsi.toBitVec
      && FlatShuffler.Flat.mappable b M x.r9.toBitVec
      && FlatShuffler.Flat.inWildcardSlot b x.r9.toBitVec
        == (x.input.rdx.toUInt8.toUInt64 != 0)) = false := by
  rw [hsrctgt, hmap, hinw]; simp

/-- The step of `c0Out` on a back edge of the scan that does not take the candidate. -/
theorem c0Out_skip (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (x s : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (hin : s.input = x.input) (hr9 : s.r9.toBitVec = x.r9.toBitVec + 1)
    (hax : s.rax.toBitVec = x.rax.toBitVec)
    (hlt : x.r9.toBitVec.toNat < b.sourceSize.toNat)
    (hcond : (FlatShuffler.Flat.get b.source x.r9.toBitVec
        = FlatShuffler.Flat.get b.target x.input.rsi.toBitVec
      && FlatShuffler.Flat.mappable b M x.r9.toBitVec
      && FlatShuffler.Flat.inWildcardSlot b x.r9.toBitVec
        == (x.input.rdx.toUInt8.toUInt64 != 0)) = false) :
    c0Out b M s = c0Out b M x := by
  unfold c0Out
  rw [hin, hr9, hax]
  conv => rhs; rw [cf_pos hlt, hcond]
  simp

/-- The step of `c0Out` on a back edge of the scan that takes the candidate. -/
theorem c0Out_cand (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (x s : mappingBuilderClosestCopy.St mappingBuilderClosestCopy.In2p Heap)
    (hin : s.input = x.input) (hr9 : s.r9.toBitVec = x.r9.toBitVec + 1)
    (hlt : x.r9.toBitVec.toNat < b.sourceSize.toNat)
    (hcond : (FlatShuffler.Flat.get b.source x.r9.toBitVec
        = FlatShuffler.Flat.get b.target x.input.rsi.toBitVec
      && FlatShuffler.Flat.mappable b M x.r9.toBitVec
      && FlatShuffler.Flat.inWildcardSlot b x.r9.toBitVec
        == (x.input.rdx.toUInt8.toUInt64 != 0)) = true)
    (hax : s.rax.toBitVec = (if (x.rax.toBitVec = FlatShuffler.Flat.NONE
        || FlatShuffler.Flat.absDiff x.r9.toBitVec x.input.rsi.toBitVec
          ≤ FlatShuffler.Flat.absDiff x.rax.toBitVec x.input.rsi.toBitVec)
      then x.r9.toBitVec else x.rax.toBitVec)) :
    c0Out b M s = c0Out b M x := by
  unfold c0Out
  rw [hin, hr9, hax]
  conv => rhs; rw [cf_pos hlt, hcond]
  simp

set_option maxHeartbeats 400000 in
theorem c0_loop (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (pol : CpuPolicy) (a0 : mappingBuilderClosestCopy.In2p) :
    ∀ x, C0Inv b M frame pol a0 x →
      mappingBuilderClosestCopy.blocksP.Returns noCall .LBB29_1 x (c0Out b M x) := by
  refine Blocks.Returns.loop (C0Inv b M frame pol a0)
    (fun x => b.sourceSize.toNat - x.r9.toBitVec.toNat) (c0Out b M) ?_
  intro x hx ih
  have hs4 : ∀ s, mappingBuilderClosestCopy.blocksP.step .LBB29_4 s
      = .ok (.goto .LBB29_1 (c0Y s)) := fun s => by
    simp only [mappingBuilderClosestCopy.blocksP, c0Y]
  have hs3 : ∀ s, mappingBuilderClosestCopy.blocksP.step .LBB29_3 s
      = .ok (.goto .LBB29_4 (c0Z s)) := fun s => by
    simp only [mappingBuilderClosestCopy.blocksP, c0Z]
  have hs191 : ∀ s, mappingBuilderClosestCopy.blocksP.step .o191 s
      = .ok (.goto .LBB29_4 (c0W s)) := fun s => by
    simp only [mappingBuilderClosestCopy.blocksP, c0W]
  have hs141 : ∀ s, mappingBuilderClosestCopy.blocksP.step .o141 s
      = .ok (.goto .LBB29_10 s) := fun s => by
    simp only [mappingBuilderClosestCopy.blocksP]
  have hs10 : ∀ s, mappingBuilderClosestCopy.blocksP.step .LBB29_10 s = .ok (if
      s.rax = 18446744073709551615
      then .goto .LBB29_4 (c0W s) else .goto .o156 (c0W s)) := fun s => by
    simp only [mappingBuilderClosestCopy.blocksP, c0W]
  have hs156 : ∀ s, mappingBuilderClosestCopy.blocksP.step .o156 s = .ok (if
      (if s.input.rsi ≤ s.rax then s.rax - s.input.rsi else s.input.rsi - s.rax) <
        (if s.r9 ≤ s.input.rsi then s.r11 else s.r8 + s.r9)
      then .goto .LBB29_4 (c0V s) else .goto .o191 (c0V s)) := fun s => by
    simp only [mappingBuilderClosestCopy.blocksP, c0V]
  by_cases hc0 : x.rcx = x.r9
  · have hsrc : x.r9.toBitVec = b.sourceSize := by
      have h1 : x.r9 = UInt64.ofBitVec b.sourceSize := by rw [← hc0, hx.rcx]
      rw [h1]
    have hge : ¬ x.r9.toBitVec.toNat < b.sourceSize.toNat := by
      rw [hsrc]; exact Nat.lt_irrefl _
    have hout : x.rax = c0Out b M x := by
      unfold c0Out
      rw [cf_neg hge, UInt64.ofBitVec_toBitVec]
    rw [← hout]
    refine Blocks.Returns.goto (l' := .LBB29_13) (s' := x) ?_ ?_
    · simp only [mappingBuilderClosestCopy.blocksP, if_pos hc0]
    · exact Blocks.Returns.ret (by simp only [mappingBuilderClosestCopy.blocksP])
  · have hne : x.r9.toBitVec ≠ b.sourceSize := by
      intro h
      have h' : x.r9.toBitVec = (UInt64.ofBitVec b.sourceSize).toBitVec := h
      apply hc0
      rw [hx.rcx]
      exact (UInt64.toBitVec_inj.mp h').symm
    have hr9lt : x.r9.toBitVec.toNat < FlatShuffler.maxStackSize := by
      have h1 : x.r9.toBitVec.toNat ≤ b.sourceSize.toNat := hx.r9

  | .c1 => (fun (x : mappingBuilderMap.In2p) (r : UInt64 × Heap) => Lift.Sem.CallFrame.PermLift (fun k k' => mappingBuilderMap.l2p.returns { x with heap := k } (r.1, k')) x.heap r.2)


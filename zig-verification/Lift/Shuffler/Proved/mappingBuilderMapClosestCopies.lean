def SimIn (a : In2p) (b : In2) : Prop := a.rbx = b.rbx ∧ a.rdx = b.rdx ∧ a.rsi = b.rsi ∧ a.rdi = b.rdi ∧ a.rbp = b.rbp ∧ a.r14 = b.r14 ∧ a.r15 = b.r15 ∧ a.heap.Holds b.policy b.mem ∧ Heap.Permits b.policy a.heap ∧ (∀ c, Private b.sp c → ¬ Covered a.heap c) ∧ (∀ c, SysV.Below b.sp 32 c → ¬ Covered a.heap c) ∧ SysV.RoomAt b.policy b.mem b.sp 32 ∧ a.sp = b.sp

def SimSt (x : St In2p Heap) (y : St In2 DataMem) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rbx = y.rbx ∧ x.rcx = y.rcx ∧ x.rbp = y.rbp ∧ x.r8 = y.r8 ∧ x.r9 = y.r9 ∧ x.r10 = y.r10 ∧ x.r11 = y.r11 ∧ x.r14 = y.r14 ∧ x.r15 = y.r15 ∧ x.mem.Holds y.input.policy y.mem ∧ (∀ b, ¬ SysV.Below y.input.sp 32 b → y.mem.get? b = y.input.mem.get? b) ∧ (∀ b, SysV.Below y.input.sp 32 b → ¬ Covered x.mem b) ∧ SysV.RoomAt y.input.policy y.mem y.input.sp 32

def SimOut (_ : In2p) (y : In2) (r : UInt64) (r' : UInt64 × DataMem) : Prop := r = r'.1 ∧ ∀ b, ¬ SysV.Below y.sp 32 b → r'.2.get? b = y.mem.get? b


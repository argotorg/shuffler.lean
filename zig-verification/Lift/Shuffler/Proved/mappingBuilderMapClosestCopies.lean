theorem final : Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.MapClosestCopiesStatement := by
  intro b M hC policy ra s heB
  have he := heB.1
  have hrep : (l3 [] b M policy).rep policy () s :=
    ⟨rfl, Lift.Sem.Final.holds he, Lift.Sem.Final.permits heB, hC, Lift.Sem.Bridge.Fn.Entry.sysV (lo := Lift.Shuffler.shufflePC) (hi := Lift.Shuffler.shufflerEndPC) he (by decide +kernel) (by decide +kernel), Lift.Sem.Final.bv64 he.inRegs 0 rfl, Lift.Sem.Final.not_covered he 80 rfl, Lift.Sem.Final.hidden he 80 rfl, Lift.Sem.Final.room he 80 rfl⟩
  refine (contract [] b M policy policy s hrep hC).mono ?_
  rintro t ⟨y, ⟨hexit, hrel, hpp, hmem⟩, hrun⟩
  refine Lift.Sem.Final.ret he 80 rfl hexit (fun b ho hb => hmem b ho hb) ?_
  exact hpp
theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : (UInt64 × Heap)) (q : (UInt64 × Heap)) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  obtain ⟨r', hr', hrq⟩ := Lift.Sem.Blocks.Returns.sim
    (Xh := CalP.In) (Yh := CalP.Out) (Xl := CalP.In) (Yl := CalP.Out)
    (hi := blocksP) (lo := skel_call.blocksP)
    (calleeHi := CalP.rel) (calleeLo := CalP.rel)
    (simX := fun _ x y => x = y) (simY := fun _ _ _ u v => u = v)
    (sim := callState) (simR := fun (r : UInt64 × Heap) (q : (UInt64 × Heap)) => r = q)
    (callee := fun f => by intro x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (block := by
      intro l x z n hs ht
      rcases hs with ⟨hinput, h_rax, h_rbx, h_rdx, h_rsi, h_rdi, h_r12, h_r14, h_r15, h_mem, htrue⟩
      cases l <;> simp only [blocksP, callInput, hinput, h_rax, h_rbx, h_rdx, h_rsi, h_rdi, h_r12, h_r14, h_r15, h_mem] at ht
      all_goals repeat' split at ht
      all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
      all_goals subst n
      all_goals simp_all [skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
      all_goals first
        | rfl
        | exact ⟨_, rfl, by simp_all⟩
        | exact ⟨_, _, rfl, rfl, by intro y; repeat' constructor⟩)
    (y := skel_call.initP b) (h := hr) (hs := by simp [callState, initP, skel_call.initP, callInput])
  exact ⟨r', hr', hrq⟩

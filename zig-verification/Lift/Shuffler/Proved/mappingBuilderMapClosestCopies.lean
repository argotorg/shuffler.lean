              = .ok (.call .c0 ⟨x.mem, x.rbx, 0, x.r14, x.rbx, x.input.rbp, x.r14, x.r15,
                  x.input.sp - 40 - 8⟩ fun r => (.o80, { x with rax := r, rdx := 0, rsi := x.r14, rdi := x.rbx })) := by
            simp only [blocksP]

theorem LBB28_1 : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : In2p) y (v_r15 : BitVec 64), SimArr frame b M a → a.heap.loadB (a.rdi.toBitVec + 24) .W64 = .ok v_r15 → Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.run b M = some y → ∃ r, blocksP.Returns CalP.rel .LBB28_1 ⟨a, a.rax, a.rdi, 0, 0, a.rdi, 4294967296, 0, (UInt64.ofBitVec v_r15), a.heap⟩ r ∧ Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.result b M y) y) = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP b M ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.post b M Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m := by
  intro frame b M a y v_r15 hsim hload hrun
  obtain ⟨hC, hrdi0, hheap, hholds⟩ := hsim
  obtain ⟨m, hm⟩ := hholds
  have hv : v_r15 = b.targetSize := by
    have h1 : a.heap.loadB (a.rdi.toBitVec + 24) .W64 = .ok b.targetSize := by
      rw [hrdi0, hheap]
      simpa using Heap.loadB_of_load (load_targetSize b M frame a.policy m (hheap ▸ hm))
    rw [hload] at h1
    simpa using h1
  have hy : y = FlatShuffler.Flat.closestCopiesFrom b M 0 := by
    have h := hrun
    simp only [Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.run,
      FlatShuffler.Flat.mapClosestCopies, Option.some.injEq] at h
    exact h.symm
  have hinv : LoopInv b M frame a ⟨a, a.rax, a.rdi, 0, 0, a.rdi, 4294967296, 0,
      UInt64.ofBitVec v_r15, a.heap⟩ := by
    refine ⟨rfl, rfl, rfl, ?_, ?_, ?_⟩
    · rw [hv]
    · simp
    · exact ⟨M, m, hheap, hm, rfl⟩
  obtain ⟨r, hret, hheap', hrax⟩ := loop_main b M frame a hC hrdi0 _ _ hinv rfl
  have henc : Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.result b M y) y)
      = [⟨.W16, r.1.toBitVec.setWidth 16⟩] := by
    show Lift.Trusted.Encode.encode
      (Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.result b M y)
      = [⟨.W16, r.1.toBitVec.setWidth 16⟩]
    rw [hrax, loopRax, hy]
    split
    · rename_i hs
      simp only [Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.result, hs]
      simp [Lift.Trusted.Encode.encode]
    · rename_i hne
      have hh : (FlatShuffler.Flat.closestCopiesFrom b M 0).fst = FlatShuffler.Flat.ExecutionControl.assertionExit := by
        rcases closestCopiesFrom_exit b M 0 with h | h
        · exact absurd h hne
        · exact h
      simp only [Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.result, hh]
      simp [Lift.Trusted.Encode.encode]
  refine ⟨r, hret, henc, hheap, ?_⟩
  intro m' hm'
  have hm2 : (objsP b y.2 ++ frame).Holds a.policy m' := by
    have hy2 : y.2 = (FlatShuffler.Flat.closestCopiesFrom b M 0).2 := by rw [hy]
    rw [hy2]
    rw [show objsP b (FlatShuffler.Flat.closestCopiesFrom b M 0).2 ++ frame = loopHeap b M frame from rfl]
    rw [← hheap']
    exact hm'
  refine ⟨y, hrun, henc, ?_⟩
  intro o ho
  simp only [Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.written, List.mem_cons,
    List.not_mem_nil, or_false] at ho
  rcases ho with rfl | rfl
  · have hto : toObj (⟨17472, y.2.dest.toList.map fun v => ⟨.W64, v⟩, true⟩) = destObj y.2 := by
      simp [toObj, toCell, destObj, Obj.words]
    refine (Bridge.has_iff a.policy m' _).mpr ?_
    rw [hto]
    refine ⟨?_, ?_, ?_⟩
    · simpa using hm2.noWrap (destObj y.2) (destObj_mem b y.2 frame)
    · intro x hx
      simpa using hm2.read (destObj y.2) (destObj_mem b y.2 frame) x hx
    · intro _ x hx
      simpa using hm2.write (destObj y.2) (destObj_mem b y.2 frame) rfl x hx
  · have hto : toObj (⟨25664, y.2.pos.toList.map fun v => ⟨.W64, v⟩, true⟩) = posObj y.2 := by
      simp [toObj, toCell, posObj, Obj.words]
    refine (Bridge.has_iff a.policy m' _).mpr ?_
    rw [hto]
    refine ⟨?_, ?_, ?_⟩
    · simpa using hm2.noWrap (posObj y.2) (posObj_mem b y.2 frame)
    · intro x hx
      simpa using hm2.read (posObj y.2) (posObj_mem b y.2 frame) x hx
    · intro _ x hx
      simpa using hm2.write (posObj y.2) (posObj_mem b y.2 frame) rfl x hx
end loop

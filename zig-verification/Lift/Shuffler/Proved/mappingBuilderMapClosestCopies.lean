/-! ## The caller's proof: the relations of the callees and their facts

The caller calls `mappingBuilderClosestCopy` (a value result, its state has a heap) and `mappingBuilderMap`
(a heap result). The callee fact of `Blocks.Returns.simAt` for the second is `CallArm.calleeB` (the caller
carries the byte-range permission `Heap.Permits`); the first needs the mapping of the memory (`MappedMemory`),
since the caller's stack room is passed to the callee and must survive it. -/

/-- The relation of the callee inputs: the callee's `SimIn`, and the fact that the callee's heap owns none
of the 56 kept bytes from its return word (`Kept`, the restriction of the L2 callee model). -/
def SimX : (c : Cal) → CalP.In c → Cal.In c → Prop
  | .c0 => fun (x : mappingBuilderClosestCopy.In2p) (xl : mappingBuilderClosestCopy.In2) =>
      mappingBuilderClosestCopy.SimIn x xl ∧ ∀ i, i < 56 → ¬ x.heap.Owned (xl.sp + BitVec.ofNat 64 i)
  | .c1 => fun (x : mappingBuilderMap.In2p) (xl : mappingBuilderMap.In2) =>
      mappingBuilderMap.SimIn x xl ∧ ∀ i, i < 56 → ¬ x.heap.Owned (xl.sp + BitVec.ofNat 64 i)

/-- The relation of the callee results: the callee's `SimOut`; for the heap result, the shape of the heap
(the callee keeps the coverage, the ownership and the byte-range permissions); for the value result, the
memory of the result maps each word that the memory of the call maps. -/
def SimY : (c : Cal) → CalP.In c → Cal.In c → CalP.Out c → Cal.Out c → Prop
  | .c0 => fun (x : mappingBuilderClosestCopy.In2p) (xl : mappingBuilderClosestCopy.In2) (y : UInt64)
      (yl : UInt64 × DataMem) => mappingBuilderClosestCopy.SimOut x xl y yl ∧ SysV.MappedMemory xl.mem yl.2
  | .c1 => fun (x : mappingBuilderMap.In2p) (xl : mappingBuilderMap.In2) (y : UInt64 × Heap)
      (yl : UInt64 × DataMem) => mappingBuilderMap.SimOut x xl y yl ∧ Lift.Sem.CallArm.ShapeB x.heap y.2

/-- A byte of the 32 bytes below `sp - 40 - 8` (the room of the callee) is one of the 80 bytes below
`sp`. -/
theorem below48_80 {sp b : BitVec 64} (h : SysV.Below (sp - 40 - 8) 32 b) : SysV.Below sp 80 b := by
  unfold SysV.Below at *
  bv_omega

/-- A byte outside the 80 bytes below `sp` is outside the 32 bytes below `sp - 40 - 8`. -/
theorem not_below48 {sp b : BitVec 64} (h : ¬ SysV.Below sp 80 b) :
    ¬ SysV.Below (sp - 40 - 8) 32 b :=
  fun hc => h (below48_80 hc)

/-- A word at `sp - k` with `k + 8 ≤ 48` reads the same after the call: the store of the return word is
at `sp - 40 - 8`, and the callee keeps the bytes outside its room. -/
theorem readRam_after_call {policy : CpuPolicy} {m₀ m m' : DataMem} {sp a v val : BitVec 64} {k : Nat}
    (hk : k + 8 ≤ 48) (hstore : m = Mem.storeInt m₀ (sp - 40 - 8) 8 val.toInt)
    (ha : a = sp - BitVec.ofNat 64 k)
    (hframe : ∀ i, i < 8 → m'.get? (a + BitVec.ofNat 64 i) = m.get? (a + BitVec.ofNat 64 i))
    (hr : readRam policy m₀ a .W64 = .ok v) : readRam policy m' a .W64 = .ok v := by
  have h1 : readRam policy m a .W64 = .ok v := by
    refine SysV.readRam_of_loadInt (Mem.loadInt_congr fun i hi => ?_) hr
    subst hstore
    rw [ha]
    exact Mem.get?_storeInt_of_ne _ _ _ _ _ (by intro j hj; bv_omega)
  exact SysV.readRam_of_loadInt (Mem.loadInt_congr fun i hi => hframe i hi) h1

/-- The room of 80 bytes below `sp` is the room of 32 bytes below `sp - 48`, over the words that both
have. -/
theorem room_callee {policy : CpuPolicy} {m : DataMem} {sp : BitVec 64}
    (h : SysV.RoomAt policy m sp 80) : SysV.RoomAt policy m (sp - 48) 32 := by
  intro k hk8 hkn hd
  obtain ⟨h1, h2, h3⟩ := h (k + 48) (by omega) (by omega) (by omega)
  have e : sp - 48 - BitVec.ofNat 64 k = sp - BitVec.ofNat 64 (k + 48) := by bv_omega
  rw [e]
  exact ⟨h1, h2, h3⟩

/-- The L2 model of `mappingBuilderClosestCopy` only pushes, so its result memory maps each word that the
memory of the call maps. -/
theorem closestCopy_mapped {xl : mappingBuilderClosestCopy.In2} {r : UInt64 × DataMem}
    (h : mappingBuilderClosestCopy.l2.returns xl r) : SysV.MappedMemory xl.mem r.2 := by
  refine Lift.Sem.CallArm.Blocks.Returns.inv (b := mappingBuilderClosestCopy.blocks)
    (callee := noCall) (fun _ x => SysV.MappedMemory xl.mem x.mem) (fun r => SysV.MappedMemory xl.mem r.2)
    ?_ h (SysV.MappedMemory.refl _)
  rintro l x n hm hstep
  cases l with
  | entry =>
    simp only [mappingBuilderClosestCopy.blocks] at hstep
    split at hstep
    · rename_i m1 hw0
      split at hstep
      · rename_i m2 hw1
        split at hstep
        · rename_i m3 hw2
          split at hstep
          · rename_i m4 hw3
            split at hstep
            · rename_i v hl0
              simp only [Res.ok.injEq] at hstep
              subst hstep
              exact SysV.MappedMemory.trans (SysV.MappedMemory.trans
                (SysV.MappedMemory.trans (SysV.MappedMemory.trans hm (SysV.MappedMemory.writeRam hw0))
                  (SysV.MappedMemory.writeRam hw1)) (SysV.MappedMemory.writeRam hw2))
                (SysV.MappedMemory.writeRam hw3)
            · cases hstep
          · cases hstep
        · cases hstep
      · cases hstep
    · cases hstep
  | _ =>
    simp only [mappingBuilderClosestCopy.blocks] at hstep
    repeat' split at hstep
    all_goals first
      | (simp only [Res.ok.injEq] at hstep; subst hstep; exact hm)
      | cases hstep

/-- The callee fact of the value callee `mappingBuilderClosestCopy`: its `refines_l2p`, the kept bytes of
the restricted L2 model (`Kept`), and the mapping of its result memory. -/
theorem callee0 : Refines (SimX .c0) (SimY .c0) (CalP.rel .c0) ((Cal.model .c0).returns) := by
  rintro x xl y ⟨hx, hfree⟩ hp
  obtain ⟨yl, hlo, hy⟩ := mappingBuilderClosestCopy.refines_l2p x xl y hx hp
  refine ⟨yl, ⟨⟨hlo, ?_⟩, hy, closestCopy_mapped hlo⟩⟩
  intro i hi
  exact hy.2 _ (by unfold SysV.Below; bv_omega)

/-- The callee fact of the heap callee `mappingBuilderMap`: `CallArm.calleeB` with its `refines_l2p`, its
`shape` row, and the two order facts of its `SimIn` and `SimOut` under a permutation of the heap. -/
theorem callee1 : Refines (SimX .c1) (SimY .c1) (CalP.rel .c1) ((Cal.model .c1).returns) := by
  refine Lift.Sem.CallArm.calleeB (X := mappingBuilderMap.In2p) (Xl := mappingBuilderMap.In2)
    (fun x => x.heap) (fun x k => { x with heap := k }) (fun x => x.sp) (fun x => x.mem) 56
    (fun _ _ => rfl) mappingBuilderMap.refines_l2p ?_ ?_ ?_ mappingBuilderMap.shape
  · rintro x xl k hp ⟨h0, hrax, hrdx, hrsi, hrdi, hh, hperm, ha, hsp⟩
    exact ⟨h0, hrax, hrdx, hrsi, hrdi, (Heap.Holds_perm hp).mp hh, (Heap.Permits_perm hp).mp hperm,
      fun c hc hv => ha c hc ((covered_perm hp c).mpr hv), hsp⟩
  · rintro x xl y yl k k' hp hp' ⟨h1, hh, hf⟩
    exact ⟨h1, (Heap.Holds_perm hp').mpr hh, fun c hc => hf c fun ho => hc ((Heap.owned_perm hp c).mpr ho)⟩
  · rintro x xl y yl ⟨-, -, hf⟩
    exact hf

/-- The five words that the entry block saves on the stack, as the memory at each later label has them. -/
def Words (y : St In2 DataMem) : Prop :=
  readRam y.input.policy y.mem (y.input.sp - 8) .W64 = .ok y.input.r15.toBitVec ∧
  readRam y.input.policy y.mem (y.input.sp - 16) .W64 = .ok y.input.r14.toBitVec ∧
  readRam y.input.policy y.mem (y.input.sp - 24) .W64 = .ok y.input.r12.toBitVec ∧
  readRam y.input.policy y.mem (y.input.sp - 32) .W64 = .ok y.input.rbx.toBitVec ∧
  readRam y.input.policy y.mem (y.input.sp - 40) .W64 = .ok y.input.rax.toBitVec

/-- The registers that the entry block saves are those of the input (the pushes write the state
registers before any other block reads them). -/
def Ent (y : St In2 DataMem) : Prop :=
  y.r15 = y.input.r15 ∧ y.r14 = y.input.r14 ∧ y.r12 = y.input.r12 ∧ y.rbx = y.input.rbx ∧
    y.rax = y.input.rax

/-- The facts of the labels: the saved registers at the entry, the saved words at each other label. -/
def LFacts (l : Lbl) (y : St In2 DataMem) : Prop :=
  match l with
  | .entry => Ent y
  | _ => Words y
theorem refines_l2p : Refines SimIn (fun a b r r' => SimOut a b r r') l2p.returns l2.returns := by

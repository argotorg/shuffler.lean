theorem refines_l3 : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping), Refines (fun (_ : Unit) => SimArr frame b M) (fun _ a y r => Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.result b M y) y) = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP b M ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.post b M Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) (fun _ y => Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.run b M = some y) l2p.returns := by
  intro frame b M x a y hs hy
  have hs' : SimArr frame b M a := hs
  simp only [SimArr] at hs
  obtain ⟨_, hrdi, hheap, m, hm⟩ := hs
  have hload : a.heap.loadB (a.rdi.toBitVec + 24) .W64 = .ok b.targetSize := by
    have hmem0 : (⟨24, Lift.Shuffler.Internal.Proposed.Layout.word b.targetSize, false⟩ : Lift.Trusted.Object) ∈
        Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects b M
          Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.envOf := by
      simp [Lift.Shuffler.Internal.Proposed.MapClosestCopiesStatement.objects]
    have hmem : Bridge.toObj (⟨24, Lift.Shuffler.Internal.Proposed.Layout.word b.targetSize, false⟩ : Lift.Trusted.Object) ∈ a.heap := by
      rw [hheap, objsP]
      exact List.mem_append_left _ (List.mem_map.mpr ⟨_, hmem0, rfl⟩)
    have hcell : (0, Bridge.toCell ⟨.W64, b.targetSize⟩) ∈ Lift.Sem.offsets 0
        (Bridge.toObj (⟨24, Lift.Shuffler.Internal.Proposed.Layout.word b.targetSize, false⟩ : Lift.Trusted.Object)).cells := by
      simp [Bridge.toObj, Bridge.toCell, Lift.Shuffler.Internal.Proposed.Layout.word, Lift.Sem.offsets]
    have hl := Heap.load_of_mem hm hmem hcell
    simp only [Bridge.toObj, Bridge.toCell, Lift.Shuffler.Internal.Proposed.Layout.word, List.map_cons, List.map_nil] at hl
    have hb := Heap.loadB_of_load hl
    simpa [hrdi] using hb
  have hstep : blocksP.step .entry (initP a) =
      .ok (.goto .LBB28_1 ⟨a, a.rax, a.rdi, 0, 0, a.rdi, 4294967296, 0, UInt64.ofBitVec b.targetSize, a.heap⟩) := by
    simp only [blocksP, initP, hload]
  obtain ⟨r, hret, h1, h2, h3⟩ := loop.LBB28_1 frame b M a y b.targetSize hs' hload hy
  exact ⟨r, .goto hstep hret, h1, h2, h3⟩
theorem above_l3 : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (pol : CpuPolicy), Above l2p (l3 frame b M pol) := by
  intro frame b M pol
  refine Above.ofRefines (fun _ _ _ => SimArr frame b M) _ (fun _ _ => refines_l3 frame b M) ?_ ?_
  · rintro policy _ s ⟨hpol, hh, hperm, hC, he, hq0, harea, hbelow, hroom⟩
    exact ⟨⟨policy, objsP b M ++ frame, s.data.regs.rax, s.data.regs.rbx, s.data.regs.rdi, s.data.regs.rbp, s.data.regs.r12, s.data.regs.r14, s.data.regs.r15, s.data.regs.rsp.toBitVec⟩, ⟨rfl, hh, hperm, he, rfl, rfl, rfl, rfl, rfl, rfl, rfl, harea, hbelow, hroom, rfl⟩, ⟨hC, hq0, rfl, ⟨_, hh⟩⟩⟩
  · rintro policy _ a s y r t ⟨hp, -⟩ ⟨hbp, -⟩ ⟨hv, hain, hm⟩ ⟨hex, hrax, hh, hfr⟩
    rw [hain] at hfr
    exact ⟨hex, by rw [hrax]; exact hv, by rw [hrax, ← hp, ← hbp]; exact hm _ hh, hfr⟩

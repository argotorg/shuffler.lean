theorem decompiles : ∀ (self : BitVec 64) (dp : BitVec 64) (frame : Heap), Decompiles Lift.Shuffler.L1.step (l3 self dp frame) := by intros; apply Decompiles.above (decompiles_l2.above above_l2p); apply above_l3
theorem decompiles_code : ∀ (self : BitVec 64) (dp : BitVec 64) (frame : Heap), Decompiles (fun s => Lift.Shuffler.Code.code.step s .done) (l3 self dp frame) := by intros; exact (Sites.decompiles_l1Spec_iff Lift.Shuffler.Code.code Lift.Shuffler.L1.step Lift.Shuffler.L1.spec _).mp (by apply decompiles)
theorem contract : ∀ (self : BitVec 64) (dp : BitVec 64) (frame : Heap) (policy : CpuPolicy) (x : Lift.Pilot.ShallowestSpec.In) (s : MachineState), (l3 self dp frame).rep policy x s → Lift.Pilot.ShallowestSpec.C x → Reaches (fun s => Lift.Shuffler.Code.code.step s .done) policy (fun t => ∃ y, (l3 self dp frame).post x y s t ∧ Lift.Pilot.ShallowestSpec.run x = some y) s := by intro self dp; intros; apply Decompiles.transfer _ Lift.Pilot.ShallowestSpec.C (fun x y => Lift.Pilot.ShallowestSpec.run x = some y) (fun x h => total x self dp h) (fun _ _ _ h => h) <;> first | assumption | apply decompiles_code
theorem final : Lift.Shuffler.Internal.ShallowestStatement.ShallowestStatement := by
  intro x hC self dp policy ra s he
  have hrep : (l3 self dp []).rep policy x s :=
    ⟨Lift.Sem.Final.holds he, hC, Lift.Sem.Bridge.Fn.Entry.sysV (lo := Lift.Shuffler.shufflePC) (hi := Lift.Shuffler.shufflerEndPC) he (by decide +kernel) (by decide +kernel), Lift.Sem.Final.bv64 he.inRegs 0 rfl, Lift.Sem.Final.bv64 he.inRegs 1 rfl, Lift.Sem.Final.not_covered he 8 rfl, Lift.Sem.Final.hidden he 8 rfl, Lift.Sem.Final.room he 8 rfl⟩
  refine (contract self dp [] policy x s hrep hC).mono ?_
  rintro t ⟨y, ⟨hexit, hmem, hrel⟩, hrun⟩
  refine Lift.Sem.Final.ret he 8 rfl hexit (fun b _ hb => hmem b hb) ?_
  simp only [Lift.Shuffler.Internal.ShallowestStatement.post, Lift.Shuffler.Internal.ShallowestStatement.shallowestCopyPosition]
  first | exact ⟨y, hrun, hrel⟩ | (refine ⟨y, hrun, ?_⟩; simp [Lift.Trusted.Encode.encode, Width.bits, hrel]; done) | (refine ⟨y, hrun, ?_⟩; simpa [Width.bits] using hrel; done)
theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : UInt64) (q : UInt64) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    callState (fun (r : UInt64) (q : UInt64) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l x z n hs ht
      rcases hs with ⟨hinput, h_rax, h_rcx, h_rdx, h_mem, htrue⟩
      cases l <;> simp only [blocksP, callInput, hinput, h_rax, h_rcx, h_rdx, h_mem] at ht
      all_goals repeat' split at ht
      all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
      all_goals subst n
      all_goals simp_all [skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
      all_goals refine ⟨_, _, ⟨rfl, rfl⟩, rfl, ?_⟩
      all_goals intros; simp_all [callState, callInput])
    hr (by simp [callState, initP, skel_call.initP, callInput])
def call_bridge_rev.skel_statement : Prop := Refines (fun a b => b = callInput a) (fun _ _ (q : UInt64) (r : UInt64) => r = q) skel_call.l2p.returns l2p.returns
namespace call_bridge_rev.skel_proof
skel_proof_aliases call_bridge_rev.skel_proof excluding [bridgeState, BridgeHiNext, BridgeLoNext, bridgeNext, bridgeRes, bridgeState_related, bridge_related_eq, bridgeNext_related, bridgeNext_related_rev, bridge_goto, bridge_step_eq_entry, bridge_step_eq_LBB11_1, bridge_step_eq_o12, bridge_step_eq_o33, bridge_step_eq_LBB11_2, bridge_step_eq, call_bridge_rev]
def bridgeState (z : St skel_call.In2p Heap) : St In2p Heap := { input := callInput z.input, rax := z.rax, rcx := z.rcx, rdx := z.rdx, mem := z.mem }

abbrev BridgeHiNext := Next Lbl (St In2p Heap) UInt64 Empty Empty.elim Empty.elim
abbrev BridgeLoNext := Next Lbl (St skel_call.In2p Heap) UInt64 Empty Empty.elim Empty.elim

def bridgeNext : BridgeLoNext → BridgeHiNext
  | .goto l z => .goto l (bridgeState z)
  | .ret r => .ret r
  | .call f x k => .call f x (fun r => ((k r).1, bridgeState (k r).2))

def bridgeRes : Res BridgeLoNext → Res BridgeHiNext
  | .ok n => .ok (bridgeNext n)
  | .stuck why => .stuck why
  | .noFuel => .noFuel

theorem bridgeState_related (z : St skel_call.In2p Heap) : callState (bridgeState z) z := by
  simp [callState, bridgeState]

theorem bridge_related_eq (x : St In2p Heap) (z : St skel_call.In2p Heap)
    (h : callState x z) : x = bridgeState z := by
  cases x
  cases z
  simp_all [callState, bridgeState, callInput]

theorem bridgeNext_related (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      callState (fun (r : UInt64) (q : UInt64) => r = q) (bridgeNext n) (.ok n) := by
  cases n with
  | goto l z => exact ⟨z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, k, rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridgeNext_related_rev (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q) n (.ok (bridgeNext n)) := by
  cases n with
  | goto l z => exact ⟨bridgeState z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, (fun r => ((k r).1, bridgeState (k r).2)), rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridge_goto {l : Lbl} {input : skel_call.In2p} {rax : UInt64} {rcx : UInt64} {rdx : UInt64} {mem : Heap} :
    (Res.ok (Next.goto l { input := callInput input, rax := rax, rcx := rcx, rdx := rdx, mem := mem }) : Res BridgeHiNext) =
      bridgeRes (.ok (.goto l { input := input, rax := rax, rcx := rcx, rdx := rdx, mem := mem })) := rfl


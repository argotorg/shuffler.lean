/-- The cells of the array of slots of the pilot input. -/
theorem map_toCell_flatMap_slots (l : List Lift.Pilot.Slot) :
    (l.flatMap (fun s => [(⟨.W64, s.word⟩ : Lift.Trusted.Field)])).map toCell =
      l.map (fun s => (⟨.W64, s.word⟩ : Lift.Sem.Cell)) := by
  induction l with
  | nil => rfl
  | cons s l ih => simp [toCell, ih]

/-- The trusted object of the array of slots is the chain's array of the words. -/
theorem toObj_encode_slots {n : Nat} (p : BitVec 64) (v : Vector Lift.Pilot.Slot n) (wr : Bool) :
    toObj ⟨p, Lift.Trusted.Encode.encode v, wr⟩ =
      Obj.words p wr .W64 (v.toList.map Lift.Pilot.Slot.word) := by
  simp only [toObj, Obj.words, Lift.Trusted.Encode.encode]
  rw [map_toCell_flatMap_slots, List.map_map]
  rfl

/-- The two loads of the loop body give the array pointer and the word of the slot below the counter. -/
theorem load_slot_facts (self dp : BitVec 64) (frame : Heap) (xs : Lift.Pilot.ShallowestSpec.In) (a : In2p)
    (policy : CpuPolicy) (m : DataMem) (x : St In2p Heap)
    (hinput : x.input = a) (hmem : x.mem = objsP self dp xs ++ frame) (hH : Heap.Holds policy x.mem m)
    (hrdi : a.rdi.toBitVec = self)
    (hle : x.rax.toNat ≤ 1024) (hpos : 0 < x.rax.toNat)
    (hsub : (x.rax - 1).toNat = x.rax.toNat - 1)
    (hb : ((x.rax - 1).toBitVec).toNat < 1024)
    (v1 v2 : BitVec 64) (hp2 : x.mem.load (x.input.rdi.toBitVec + 40) .W64 = .ok v1)
    (hp3 : x.mem.load (v1 + x.rax.toBitVec * 8 + 18446744073709551608) .W64 = .ok v2) :
    v1 = dp ∧ v2 = (xs.data[x.rax.toNat - 1]'(by omega)).word := by
  have hmem' : x.mem = Obj.words (self + 40) false .W64 [dp] :: Obj.words (self + 48) false .W64 [xs.size] ::
      Obj.words dp false .W64 (xs.data.toList.map Lift.Pilot.Slot.word) :: frame := by
    rw [hmem]
    simp [objsP, Lift.Shuffler.Internal.ShallowestStatement.objects, toObj_encode_slots,
      Lift.Sem.Bridge.toObj_encode_words64, Obj.words, Lift.Trusted.Encode.encode, Lift.Sem.Bridge.toObj,
      Lift.Sem.Bridge.toCell, map_toCell_flatMap_slots, List.map_map]
  have hH' : Heap.Holds policy (Obj.words (self + 40) false .W64 [dp] :: Obj.words (self + 48) false .W64 [xs.size] ::
      Obj.words dp false .W64 (xs.data.toList.map Lift.Pilot.Slot.word) :: frame) m := by
    rw [← hmem']; exact hH
  have hv1 : v1 = dp := by
    have h2 := hp2
    rw [hinput, hmem', hrdi] at h2
    have hl : Heap.load (Obj.words (self + 40) false .W64 [dp] :: Obj.words (self + 48) false .W64 [xs.size] ::
        Obj.words dp false .W64 (xs.data.toList.map Lift.Pilot.Slot.word) :: frame) (self + 40) .W64 = .ok dp := by
      simpa using Heap.load_words64_head (frame := Obj.words (self + 48) false .W64 [xs.size] ::
        Obj.words dp false .W64 (xs.data.toList.map Lift.Pilot.Slot.word) :: frame) hH' (i := 0) (by simp)
    rw [hl] at h2
    simpa [Lift.Sem.Res.ok.injEq] using h2.symm
  refine ⟨hv1, ?_⟩
  have h3 := hp3
  rw [hv1, hmem'] at h3
  have haddr : dp + x.rax.toBitVec * 8 + 18446744073709551608 = dp + (x.rax - 1).toBitVec * 8 := by
    rw [UInt64.toBitVec_sub, UInt64.toBitVec_one]
    bv_omega
  have hi : ((x.rax - 1).toBitVec).toNat < (xs.data.toList.map Lift.Pilot.Slot.word).length := by
    rw [List.length_map, Vector.length_toList]
    exact hb
  have hl := Heap.load_words64_mul (h := Obj.words (self + 40) false .W64 [dp] ::
      Obj.words (self + 48) false .W64 [xs.size] ::
      Obj.words dp false .W64 (xs.data.toList.map Lift.Pilot.Slot.word) :: frame) hH'
    (ho := List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_self ..)))
    (i := (x.rax - 1).toBitVec) hi
  rw [haddr, hl] at h3
  simp only [Lift.Sem.Res.ok.injEq, List.getElem_map] at h3
  rw [← h3]
  simp only [Vector.getElem_toList, UInt64.toNat_toBitVec, hsub]

/-- The search step of the loop that counts down: the slot below the counter is the searched one. -/
theorem search_step (v : Vector Lift.Pilot.Slot 1024) (k : Lift.Pilot.Slot) (i : UInt64) (hi0 : ¬ i = 0)
    (hi : i.toNat ≤ 1024)
    (hp : ({ toBitVec := (v[i.toNat - 1]'(by omega)).word } : UInt64) &&& 281474976710655 =
      ({ toBitVec := k.word } : UInt64) &&& 281474976710655) :
    i - (1 : UInt64) = UInt64.ofBitVec (match List.find? (fun p => Lift.Pilot.ShallowestSpec.eql p.1 k)
        (v.toList.take i.toNat).zipIdx.reverse with
      | some (_, p) => BitVec.ofNat 64 p
      | none => BitVec.allOnes 64) := by
  loop_close [Lift.Pilot.ShallowestSpec.eql, Lift.Pilot.Slot.word]

/-- The search step of the loop that counts down: the slot below the counter is another one. -/
theorem search_skip (v : Vector Lift.Pilot.Slot 1024) (k : Lift.Pilot.Slot) (i : UInt64) (hi0 : ¬ i = 0)
    (hi : i.toNat ≤ 1024)
    (hp : ¬ (({ toBitVec := (v[i.toNat - 1]'(by omega)).word } : UInt64) &&& 281474976710655 =
      ({ toBitVec := k.word } : UInt64) &&& 281474976710655)) :
    UInt64.ofBitVec (match List.find? (fun p => Lift.Pilot.ShallowestSpec.eql p.1 k)
        (v.toList.take (i - (1 : UInt64)).toNat).zipIdx.reverse with
      | some (_, p) => BitVec.ofNat 64 p
      | none => BitVec.allOnes 64) =
    UInt64.ofBitVec (match List.find? (fun p => Lift.Pilot.ShallowestSpec.eql p.1 k)
        (v.toList.take i.toNat).zipIdx.reverse with
      | some (_, p) => BitVec.ofNat 64 p
      | none => BitVec.allOnes 64) := by
  loop_close [Lift.Pilot.ShallowestSpec.eql, Lift.Pilot.Slot.word]

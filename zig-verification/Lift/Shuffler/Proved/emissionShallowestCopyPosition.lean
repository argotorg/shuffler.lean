namespace skel_semantic
structure In2 where
  policy : CpuPolicy
  mem : DataMem
  sp : BitVec 64
  rsi : UInt64
  rdi : UInt64

inductive Lbl where
  | entry
  | LBB11_1
  | o12
  | o33
  | LBB11_2

structure St (I M : Type) where
  input : I
  rax : UInt64
  rcx : UInt64
  rdx : UInt64
  mem : M

def init (a : In2) : St In2 DataMem := ⟨a, 0, 0, 0, a.mem⟩

abbrev Private (sp b : BitVec 64) : Prop := (b - (sp - 8)).toNat < 16

abbrev Clear (sp a : BitVec 64) (n : Nat := 8) : Prop := ∀ i, i < n → ¬ Private sp (a + BitVec.ofNat 64 i)


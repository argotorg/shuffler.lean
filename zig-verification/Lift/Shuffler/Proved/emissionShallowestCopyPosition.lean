    (fun s => s.rax.toNat)
    (fun s => UInt64.ofBitVec (match (xs.data.toList.take s.rax.toNat).zipIdx.reverse.find? (fun p => Lift.Pilot.ShallowestSpec.eql p.1 xs.slot) with | some (_, k) => BitVec.ofNat 64 k | none => BitVec.allOnes 64))

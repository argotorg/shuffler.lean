  case back_1.out =>
    have hpos : 0 < x.rax.toNat := by
      rcases Nat.eq_zero_or_pos x.rax.toNat with h | h
      · exfalso; apply hp1
        apply UInt64.toNat_inj.mp
        rw [h]; rfl
      · exact h
    have hsub : (x.rax - 1).toNat = x.rax.toNat - 1 := by
      rw [UInt64.toNat_sub_of_toNat_le (a := x.rax) (b := 1) (by rw [UInt64.toNat_one]; omega),
        UInt64.toNat_one]
    have hb : ((x.rax - 1).toBitVec).toNat < 1024 := by
      rw [UInt64.toNat_toBitVec, hsub]; omega
    obtain ⟨hv1, hv2⟩ := load_slot_facts self dp frame xs a policy m x hx.1 hx.2.1 hx.2.2.1 hrdi
      hx.2.2.2.1 hpos hsub hb v1 v2 hp2 hp3
    subst hv1
    have hle : x.rax.toNat ≤ 1024 := hx.2.2.2.1

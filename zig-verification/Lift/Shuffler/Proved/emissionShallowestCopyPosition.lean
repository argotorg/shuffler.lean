theorem LBB11_1 : ∀ (self : BitVec 64) (dp : BitVec 64) (frame : Heap) (x : Lift.Pilot.ShallowestSpec.In) (a : In2p) (y : (BitVec 64)) (v_rax : BitVec 64), SimArr self dp frame x a → a.heap.load (a.rdi.toBitVec + 48) .W64 = .ok v_rax → Lift.Pilot.ShallowestSpec.run x = some y → blocksP.Returns noCall .LBB11_1 ⟨a, (UInt64.ofBitVec v_rax), 18446744073709551615, 0, a.heap⟩ (UInt64.ofBitVec y) := by
  intro self dp frame x a y v_rax
  generalize hxs : x = xs
  rintro hsim hload hrun
  obtain ⟨hC, hrdi, hrsi, hheap, policy, m, hh⟩ := hsim

theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : UInt64) (q : UInt64) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  let hblocks : Blocks Lbl skel_call.StP UInt64 Cal CalP.In CalP.Out := skel_call.blocksP
  have main : ∃ q, hblocks.Returns CalP.rel .entry (skel_call.initP b) q ∧ r = q := by
    refine Lift.Sem.Blocks.Returns.sim (hi := blocksP) (lo := hblocks)
      (fun _ x y => x = y) (fun _ _ _ u v => u = v) callState (fun (r : UInt64) (q : UInt64) => r = q)
      ?_ ?_ hr ?_
    · intro f
      cases f with
      | c0 => intro x y v h hc; cases h; exact ⟨v, hc, rfl⟩
      | c1 => intro x y v h hc; cases h; exact ⟨v, hc, rfl⟩
    · intro l x z n hs ht
      rcases hs with ⟨hinput, h_rax, h_rbx, h_rcx, h_rdx, h_rsi, h_rdi, h_rbp, h_r12, h_r13, h_r14, h_r15, h_mem, h_stack, htrue⟩
      cases l <;> simp only [blocksP, callInput, hinput, h_rax, h_rbx, h_rcx, h_rdx, h_rsi, h_rdi, h_rbp, h_r12, h_r13, h_r14, h_r15, h_mem, h_stack] at ht
      all_goals repeat' split at ht
      all_goals first
        | (simp only [Res.ok.injEq] at ht; subst n)
        | (cases ht)
      all_goals simp_all only [hblocks, skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
      all_goals simp_all
      all_goals first
        | exact ⟨_, rfl, by simp_all [callState, callInput]⟩
        | rfl
        | (refine ⟨_, _, rfl, rfl, ?_⟩; intro y; repeat' first | rfl | trivial | constructor)
    · simp [callState, initP, skel_call.initP, callInput]
  exact main

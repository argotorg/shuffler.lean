            have h4 : plannerHasOtherRetainedCopy.blocksP.step .o58 y58 = .ok (.call () ⟨y58.mem, y58.rax, y58.r13, y58.r15⟩ fun r => (.o69, { y58 with rsi := y58.r13, rdi := y58.r15, rax := r })) := rfl

open Lift.Shuffler.Internal.Proposed
open Lift.Shuffler.Internal.Proposed in
/-- The payload of a slot word. -/
theorem slotWord_payload (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    BitVec.truncate 32 (Layout.slotWord s pad) = s.payload := by
  simp only [Layout.slotWord, Lift.Shuffler.Zig.Slot.join, Lift.Pilot.Slot.word]
  bv_decide

open Lift.Shuffler.Internal.Proposed in
/-- The test `kind = 1` (`isJunk`) of a slot word. -/
theorem slotWord_isJunk (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    ((Layout.slotWord s pad) &&& 1095216660480 = 4294967296) ↔ s.kind = 1 := by
  simp only [Layout.slotWord, Lift.Shuffler.Zig.Slot.join, Lift.Pilot.Slot.word]
  bv_decide

/-- The low 48 bits of a slot word are the payload, the kind and the opcode. -/
theorem low48_eq {p1 p2 : BitVec 32} {k1 k2 : BitVec 8} {o1 o2 : BitVec 8} {pd pd' : BitVec 16}
    (h : (pd ++ o1 ++ k1 ++ p1) &&& 281474976710655 = (pd' ++ o2 ++ k2 ++ p2) &&& 281474976710655) :
    p1 = p2 ∧ k1 = k2 ∧ o1 = o2 := by
  have key : ∀ (p1 p2 : BitVec 32) (k1 k2 : BitVec 8) (o1 o2 : BitVec 8) (pd pd' : BitVec 16),
      ((pd ++ o1 ++ k1 ++ p1) &&& 281474976710655 = (pd' ++ o2 ++ k2 ++ p2) &&& 281474976710655) →
        (p1 = p2 ∧ k1 = k2 ∧ o1 = o2) := by bv_decide
  exact key p1 p2 k1 k2 o1 o2 pd pd' h

open Lift.Shuffler.Internal.Proposed in
/-- Two slot words with the same padding and the same low 48 bits are the same slot. -/
theorem slotWord_low48 {s s' : FlatShuffler.StackSlot} {pad pad' : BitVec 16}
    (h : (Layout.slotWord s pad) &&& 281474976710655 =
      (Layout.slotWord s' pad') &&& 281474976710655) : s = s' := by
  simp only [Layout.slotWord, Lift.Shuffler.Zig.Slot.join, Lift.Pilot.Slot.word] at h
  obtain ⟨h1, h2, h3⟩ := low48_eq h
  cases s; cases s'; simp_all

/-! ## The private stack -/

/-- The byte at `p` is initialized by a store of 8 bytes at `o` when it is in the range. -/
theorem byte_store_self (s : Lift.Sem.PrivateStack) (o : Int) (v : BitVec 64) (p : Int)
    (h0 : 0 ≤ p - o) (h1 : p - o < (8 : Int)) :
    ∃ b, Lift.Sem.PrivateStack.store s .W64 o v p = some b := by
  simp only [Lift.Sem.PrivateStack.store, Width.bytes, Width.bits]
  split
  · exact ⟨_, rfl⟩
  · rename_i hneg
    exact absurd ⟨h0, h1⟩ hneg

/-- A store of 8 bytes at `o` keeps a byte outside its range. -/
theorem byte_store_other (s : Lift.Sem.PrivateStack) (o : Int) (v : BitVec 64) (p : Int)
    (hp : ∃ b, s p = some b) (h : ¬ (0 ≤ p - o ∧ p - o < (8 : Int))) :
    ∃ b, Lift.Sem.PrivateStack.store s .W64 o v p = some b := by
  simp only [Lift.Sem.PrivateStack.store, Width.bytes, Width.bits]
  split
  · exact ⟨_, rfl⟩
  · exact hp

/-- A chain of 8-byte stores initializes the byte at `p` when `p` is in the range of one of
them (or of the stack it starts from). -/
theorem byte_foldl (s : Lift.Sem.PrivateStack) (l : List (Int × BitVec 64)) (p : Int)
    (h : (∃ b, s p = some b) ∨ ∃ o v, (o, v) ∈ l ∧ 0 ≤ p - o ∧ p - o < (8 : Int)) :
    ∃ b, l.foldl (fun acc (ov : Int × BitVec 64) => Lift.Sem.PrivateStack.store acc .W64 ov.1 ov.2) s p
      = some b := by
  induction l generalizing s with
  | nil =>
    obtain h1 | ⟨o, v, hm, -⟩ := h
    · simpa using h1
    · simp at hm
  | cons x l ih =>
    obtain ⟨o, v⟩ := x
    simp only [List.foldl_cons]
    refine ih (Lift.Sem.PrivateStack.store s .W64 o v) ?_
    by_cases hr : 0 ≤ p - o ∧ p - o < (8 : Int)
    · exact Or.inl (byte_store_self s o v p hr.1 hr.2)
    · obtain h1 | ⟨o', v', hm, hin⟩ := h
      · exact Or.inl (byte_store_other s o v p h1 hr)
      · refine Or.inr ⟨o', v', ?_, hin⟩
        rcases List.mem_cons.mp hm with heq | hl
        · obtain ⟨rfl, rfl⟩ := heq
          exact absurd hin hr
        · exact hl

/-- Every byte of the read is initialized: the read succeeds. -/
theorem loadBytes_isSome (s : Lift.Sem.PrivateStack) (off : Int) (n : Nat)
    (h : ∀ i : Int, 0 ≤ i → i < (n : Int) → ∃ b, s (off + i) = some b) :
    ∃ x, Lift.Sem.PrivateStack.loadBytes s off n = some x := by
  induction n generalizing off with
  | zero => exact ⟨0, rfl⟩
  | succ n ih =>
    obtain ⟨b, hb⟩ := h 0 (by omega) (by omega)
    obtain ⟨x, hx⟩ := ih (off + 1) (fun i hi hin => by
      obtain ⟨c, hc⟩ := h (i + 1) (by omega) (by omega)
      exact ⟨c, by rw [show off + 1 + i = off + (i + 1) by omega]; exact hc⟩)
    have hb' : s off = some b := by simpa using hb
    exact ⟨b.toNat + 256 * x, by simp [Lift.Sem.PrivateStack.loadBytes, hb', hx]⟩

/-- A read of the private stack succeeds when every byte is initialized. -/
theorem exists_load (s : Lift.Sem.PrivateStack) (w : Width) (off : Int)
    (h : ∀ i : Int, 0 ≤ i → i < (w.bytes : Int) → ∃ b, s (off + i) = some b) :
    ∃ v, Lift.Sem.PrivateStack.load s w off = .ok v := by
  obtain ⟨x, hx⟩ := loadBytes_isSome s off w.bytes h
  refine ⟨BitVec.ofNat w.bits x, ?_⟩
  rw [Lift.Sem.PrivateStack.load, hx]

/-- A load of a cell of the `self` object of `classify`. -/
theorem loadB_self_cell (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a)
    (o : Nat) (w : Width) (v : w.type)
    (hx : (o, Cell.mk w v) ∈ offsets 0 [Cell.mk .W64 data, Cell.mk .W64 pl.sourceSize,
      Cell.mk .W64 target, Cell.mk .W64 pl.targetSize, Cell.mk .W64 spills,
      Cell.mk .W8 (if pl.allowed then 1 else 0)]) :
    a.heap.loadB (self + BitVec.ofNat 64 o) w = .ok v := by
  obtain ⟨hC, hrdi, hrsi, hrdx, hrcx, hheap, policy, m, hh⟩ := hs
  rw [hheap] at hh ⊢
  have ho : toObj ⟨self, Layout.word data ++ Layout.word pl.sourceSize ++ Layout.word target ++
      Layout.word pl.targetSize ++ Layout.word spills ++ [⟨.W8, if pl.allowed then 1 else 0⟩],
      false⟩ ∈ objsP self target spills data trace mapping pad pl sp M dn offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf]
  have hx' : (o, Cell.mk w v) ∈ offsets 0 (toObj ⟨self, Layout.word data ++
      Layout.word pl.sourceSize ++ Layout.word target ++ Layout.word pl.targetSize ++
      Layout.word spills ++ [⟨.W8, if pl.allowed then 1 else 0⟩], false⟩).cells := by
    rw [show toObj ⟨self, Layout.word data ++ Layout.word pl.sourceSize ++ Layout.word target ++
        Layout.word pl.targetSize ++ Layout.word spills ++ [⟨.W8, if pl.allowed then 1 else 0⟩],
        false⟩ = Obj.mk self false [Cell.mk .W64 data, Cell.mk .W64 pl.sourceSize,
          Cell.mk .W64 target, Cell.mk .W64 pl.targetSize, Cell.mk .W64 spills,
          Cell.mk .W8 (if pl.allowed then 1 else 0)] from by
      simp [toObj, toCell, Layout.word]]
    exact hx
  exact Heap.loadB_of_load (Heap.load_of_mem hh ho hx')

/-- A load of a word of an array object of `classify`. -/
theorem loadB_words (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a)
    (base : BitVec 64) (wr : Bool) (xs : List (BitVec 64))
    (ho : Obj.words base wr .W64 xs ∈
      objsP self target spills data trace mapping pad pl sp M dn offset ++ frame)
    (i : BitVec 64) (hi : i.toNat < xs.length) :
    a.heap.loadB (base + i * 8) .W64 = .ok xs[i.toNat] := by
  obtain ⟨hC, hrdi, hrsi, hrdx, hrcx, hheap, policy, m, hh⟩ := hs
  rw [hheap] at hh ⊢
  exact Heap.loadB_of_load (Heap.load_words64_mul hh ho hi)

theorem loadB_self_data (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB self .W64 = .ok data := by
  simpa using loadB_self_cell self target spills data trace mapping pad frame pl sp M dn offset a hs
    0 .W64 data (by simp [offsets])

theorem loadB_self_target (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (self + 16) .W64 = .ok target := by
  simpa using loadB_self_cell self target spills data trace mapping pad frame pl sp M dn offset a hs
    16 .W64 target (by simp [offsets])

theorem loadB_self_spills (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (self + 32) .W64 = .ok spills := by
  simpa using loadB_self_cell self target spills data trace mapping pad frame pl sp M dn offset a hs
    32 .W64 spills (by simp [offsets])

theorem loadB_self_allowed (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (self + 40) .W8 = .ok (if pl.allowed then 1 else 0) := by
  simpa using loadB_self_cell self target spills data trace mapping pad frame pl sp M dn offset a hs
    40 .W8 (if pl.allowed then 1 else 0) (by simp [offsets])

theorem loadB_data (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (data + a.rcx.toBitVec * 8) .W64 =
      .ok (Layout.slotWord (FlatShuffler.Flat.get pl.source offset) (pad.setWidth 16)) := by
  have hs' := hs
  obtain ⟨hC, -, -, -, hrcx, -, -⟩ := hs
  obtain ⟨-, -, hOff, -, -⟩ := hC
  have hi : a.rcx.toBitVec.toNat <
      (pl.source.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad))).length := by
    rw [hrcx, List.length_map, Vector.length_toList]; exact hOff
  have ho : Obj.words data false .W64
      (pl.source.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad))) ∈
      objsP self target spills data trace mapping pad pl sp M dn offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf, toObj, toCell, Layout.word,
      Function.comp_def, List.map_map, Obj.words]
  have h := loadB_words self target spills data trace mapping pad frame pl sp M dn offset a hs'
    data false _ ho a.rcx.toBitVec hi
  rw [h]
  simp only [hrcx]
  simp [FlatShuffler.Flat.get, hOff]

theorem loadB_mapping (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (mapping + a.rcx.toBitVec * 8) .W64 = .ok (FlatShuffler.Flat.get M.dest offset) := by
  have hs' := hs
  obtain ⟨hC, -, -, -, hrcx, -, -⟩ := hs
  obtain ⟨-, -, hOff, -, -⟩ := hC
  have hi : a.rcx.toBitVec.toNat < M.dest.toList.length := by
    rw [hrcx, Vector.length_toList]; exact hOff
  have ho : Obj.words mapping false .W64 M.dest.toList ∈
      objsP self target spills data trace mapping pad pl sp M dn offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf, toObj, toCell, Layout.word,
      Function.comp_def, List.map_map, Obj.words]
  have h := loadB_words self target spills data trace mapping pad frame pl sp M dn offset a hs'
    mapping false _ ho a.rcx.toBitVec hi
  rw [h]
  simp only [hrcx]
  simp [FlatShuffler.Flat.get, hOff]

theorem loadB_spill (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (spills + (FlatShuffler.Flat.get pl.source offset).payload.setWidth 64) .W8 =
      .ok (sp (FlatShuffler.Flat.get pl.source offset).payload) := by
  obtain ⟨hC, hrdi, hrsi, hrdx, hrcx, hheap, policy, m, hh⟩ := hs
  rw [hheap] at hh ⊢
  have ho : toObj ⟨spills + (FlatShuffler.Flat.get pl.source offset).payload.setWidth 64,
      [⟨.W8, sp (FlatShuffler.Flat.get pl.source offset).payload⟩], false⟩ ∈
      objsP self target spills data trace mapping pad pl sp M dn offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf]
  have hx : (0, Cell.mk .W8 (sp (FlatShuffler.Flat.get pl.source offset).payload)) ∈
      offsets 0 (toObj ⟨spills + (FlatShuffler.Flat.get pl.source offset).payload.setWidth 64,
        [⟨.W8, sp (FlatShuffler.Flat.get pl.source offset).payload⟩], false⟩).cells := by
    simp [toObj, toCell, offsets]
  simpa [toObj] using Heap.loadB_of_load (Heap.load_of_mem hh ho hx)

theorem loadB_self_16 (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (a.rdi.toBitVec + 16) .W64 = .ok target := by
  obtain ⟨hC, hrdi, hrsi, hrdx, hrcx, hheap, policy, m, hh⟩ := hs
  rw [hheap] at hh ⊢
  rw [hrdi]
  have ho : Obj.mk self false [Cell.mk .W64 data, Cell.mk .W64 pl.sourceSize, Cell.mk .W64 target,
      Cell.mk .W64 pl.targetSize, Cell.mk .W64 spills, Cell.mk .W8 (if pl.allowed then 1 else 0)] ∈
      objsP self target spills data trace mapping pad pl sp M dn offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf,
      Lift.Shuffler.Internal.Proposed.Layout.word, toObj, toCell]
  have hx : (16, Cell.mk .W64 target) ∈
      offsets 0 [Cell.mk .W64 data, Cell.mk .W64 pl.sourceSize, Cell.mk .W64 target,
        Cell.mk .W64 pl.targetSize, Cell.mk .W64 spills, Cell.mk .W8 (if pl.allowed then 1 else 0)] := by
    simp [offsets]
  have h := Heap.load_cell hh ho hx
  rw [show self + BitVec.ofNat 64 16 = self + 16 from by bv_omega] at h
  exact Heap.loadB_of_load h

/-- The word of the target array at the destination of `offset`. -/
theorem loadB_target (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (target + FlatShuffler.Flat.get M.dest offset * 8) .W64 =
      .ok (Layout.slotWord (FlatShuffler.Flat.get pl.target (FlatShuffler.Flat.get M.dest offset))
        (pad.setWidth 16)) := by
  have hs' := hs
  obtain ⟨hC, -, -, -, hrcx, -, -⟩ := hs
  obtain ⟨-, hTgt, hOff, hDest, -⟩ := hC
  have hi : (FlatShuffler.Flat.get M.dest offset).toNat <
      (pl.target.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad))).length := by
    rw [List.length_map, Vector.length_toList]; exact hDest
  have ho : Obj.words target false .W64
      (pl.target.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad))) ∈
      objsP self target spills data trace mapping pad pl sp M dn offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf, toObj, toCell, Layout.word,
      Function.comp_def, List.map_map, Obj.words]
  have h := loadB_words self target spills data trace mapping pad frame pl sp M dn offset a hs'
    target false _ ho (FlatShuffler.Flat.get M.dest offset) hi
  rw [h]
  have hDest' : (M.dest[offset.toNat]).toNat < FlatShuffler.maxStackSize := by
    simpa [FlatShuffler.Flat.get, hOff] using hDest
  simp [FlatShuffler.Flat.get, hDest', hOff]

/-! ## Small facts about words -/

theorem flag_cond_iff (r : UInt64) (b : Bool)
    (h : r.toBitVec.setWidth 8 = (if b then 1 else 0)) :
    ((1 : UInt64) &&& r.toUInt8.toUInt64 = 0) ↔ b = false := by
  cases b <;> simp <;> bv_decide

theorem flag_true_of_cond_ne (r : UInt64) (b : Bool)
    (h : r.toBitVec.setWidth 8 = (if b then 1 else 0))
    (hc : ¬ ((1 : UInt64) &&& r.toUInt8.toUInt64 = 0)) : b = true := by
  cases b
  · exact absurd ((flag_cond_iff r false h).mpr rfl) hc
  · rfl

theorem flag_false_of_cond (r : UInt64) (b : Bool)
    (h : r.toBitVec.setWidth 8 = (if b then 1 else 0))
    (hc : ((1 : UInt64) &&& r.toUInt8.toUInt64 = 0)) : b = false :=
  (flag_cond_iff r b h).mp hc

/-- The low byte of the mask and a constant. -/
theorem low_byte_or (x : UInt64) (c : UInt64) :
    (((x &&& 18446744073709551360) ||| (c &&& 255)).toBitVec.setWidth 8) =
      c.toBitVec.setWidth 8 := by
  bv_decide

/-- The low byte of the mask and a boolean. -/
theorem low_byte_mask_or (x : UInt64) (b : Bool) :
    (((x &&& 18446744073709551360) ||| ((if b then 1 else 0) &&& 255)).toBitVec.setWidth 8) =
      (if b then 1 else 0) := by
  cases b <;> bv_decide

/-- The low byte of the mask and a condition. -/
theorem low_byte_mask_or' (x : UInt64) (c : Prop) [Decidable c] :
    (((x &&& 18446744073709551360) ||| ((if c then 1 else 0) &&& 255)).toBitVec.setWidth 8) =
      (if c then 1 else 0) := by
  split <;> bv_decide

/-- The low byte of `1`, `2`, `3`, `4`, `255` in the mask form. -/
theorem low_byte_const (x : UInt64) (c : UInt64) (hc : c ≤ 255) :
    (((x &&& 18446744073709551360) ||| c).toBitVec.setWidth 8) = c.toBitVec.setWidth 8 := by
  bv_decide

theorem ofBytes_single (c : UInt8) : BitVec.ofInt 8 (Int.ofBytes [c]) = BitVec.ofNat 8 c.toNat := by
  have h : Int.ofBytes [c] = (c.toNat : Int) := by simp [Int.ofBytes]
  rw [h, BitVec.ofInt_natCast]

/-- The fourth byte of a slot word is the kind. -/
theorem slotWord_byte4 (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    BitVec.ofInt 8 (Int.ofBytes (((Int.toBytes 8 ((Layout.slotWord s pad).toInt)).drop 4).take 1)) =
      s.kind := by
  have e : Int.toBytes 8 ((Layout.slotWord s pad).toInt) =
      Int.toBytes 8 (((Layout.slotWord s pad).toNat : Int)) := toBytes_toInt .W64 _
  rw [e, ofInt_ofBytes_slice 8 4 1 8 _ (by omega) (by omega)]
  rw [ofNat_div_eq_extractLsb' (Layout.slotWord s pad) 4 8]
  simp only [Layout.slotWord, Lift.Shuffler.Zig.Slot.join, Lift.Pilot.Slot.word]
  bv_decide

/-! ## The private stack of the entry -/

/-- The seven stores of the entry of `classify`. -/
def entryStack (s : Lift.Sem.PrivateStack) (v0 v1 v2 v3 v4 v5 v6 : BitVec 64) :
    Lift.Sem.PrivateStack :=
  [(-8, v0), (-16, v1), (-24, v2), (-32, v3), (-40, v4), (-48, v5), (-56, v6)].foldl
    (fun acc (ov : Int × BitVec 64) => Lift.Sem.PrivateStack.store acc .W64 ov.1 ov.2) s

/-- A store keeps an initialized byte. -/
theorem exists_byte_store (s : Lift.Sem.PrivateStack) (w : Width) (o : Int) (v : w.type) (p : Int)
    (h : ∃ b, s p = some b) : ∃ b, Lift.Sem.PrivateStack.store s w o v p = some b := by
  obtain ⟨b, hb⟩ := h
  simp only [Lift.Sem.PrivateStack.store]
  split
  · exact ⟨_, rfl⟩
  · exact ⟨b, hb⟩

/-- The bytes at `-48 … -8` are initialized. -/
def Saved (s : Lift.Sem.PrivateStack) : Prop :=
  ∀ (o : Int), (o = -8 ∨ o = -16 ∨ o = -24 ∨ o = -32 ∨ o = -40 ∨ o = -48) →
    ∀ i : Int, 0 ≤ i → i < 8 → ∃ b, s (o + i) = some b

theorem Saved.store {s : Lift.Sem.PrivateStack} (h : Saved s) (w : Width) (o : Int) (v : w.type) :
    Saved (Lift.Sem.PrivateStack.store s w o v) := by
  intro p hp i hi1 hi2
  obtain ⟨b, hb⟩ := h p hp i hi1 hi2
  exact exists_byte_store s w o v (p + i) ⟨b, hb⟩

theorem Saved.load {s : Lift.Sem.PrivateStack} (h : Saved s) {o : Int}
    (ho : o = -8 ∨ o = -16 ∨ o = -24 ∨ o = -32 ∨ o = -40 ∨ o = -48) :
    ∃ v, Lift.Sem.PrivateStack.load s .W64 o = .ok v :=
  exists_load s .W64 o (fun i hi1 hi2 => h o ho i hi1 (by simpa using hi2))

theorem entryStack_saved (s : Lift.Sem.PrivateStack) (v0 v1 v2 v3 v4 v5 v6 : BitVec 64) :
    Saved (entryStack s v0 v1 v2 v3 v4 v5 v6) := by
  intro o ho i hi1 hi2
  simp only [entryStack]
  rcases ho with rfl | rfl | rfl | rfl | rfl | rfl
  · exact byte_foldl s _ _ (Or.inr ⟨-8, v0, by simp, by omega, by omega⟩)
  · exact byte_foldl s _ _ (Or.inr ⟨-16, v1, by simp, by omega, by omega⟩)
  · exact byte_foldl s _ _ (Or.inr ⟨-24, v2, by simp, by omega, by omega⟩)
  · exact byte_foldl s _ _ (Or.inr ⟨-32, v3, by simp, by omega, by omega⟩)
  · exact byte_foldl s _ _ (Or.inr ⟨-40, v4, by simp, by omega, by omega⟩)
  · exact byte_foldl s _ _ (Or.inr ⟨-48, v5, by simp, by omega, by omega⟩)

/-! ## The callee `plannerIsRetained` -/

theorem plannerIsRetained_returns (mapping : BitVec 64) (M : FlatShuffler.Flat.Mapping)
    (i : BitVec 64) (rax : UInt64) (heap : Heap) (rsi rdi : UInt64)
    (hrsi : rsi.toBitVec = i) (hrdi : rdi.toBitVec = mapping)
    (hi : i.toNat < M.dest.toList.length)
    (ho : Obj.words mapping false .W64 M.dest.toList ∈ heap)
    (hh : ∃ policy m, heap.Holds policy m) :
    ∃ r, Skel.Gen.Level3.Shuffler.plannerHasOtherRetainedCopy.skel_semantic.plannerIsRetained.l2p.returns
        ⟨heap, rax, rsi, rdi⟩ r ∧
      r.toBitVec.setWidth 8 = (if FlatShuffler.Flat.isRetained M i then 1 else 0) := by
  obtain ⟨policy, m, hH⟩ := hh
  have hilen : i.toNat < M.dest.toList.length := hi
  have hi' : i.toNat < FlatShuffler.maxStackSize := by simpa using hilen
  have hload : heap.load (mapping + i * 8) .W64 = .ok (M.dest[i.toNat]) := by
    have h := Heap.load_words64_mul hH ho (i := i) (by simpa using hilen)
    simpa using h
  have hloadB : heap.loadB (mapping + i * 8) .W64 = .ok (M.dest[i.toNat]) := Heap.loadB_of_load hload
  have heq : (UInt64.ofBitVec (M.dest[i.toNat]) = 18446744073709551615) ↔
      (M.dest[i.toNat] = FlatShuffler.Flat.NONE) := by
    rw [UInt64.eq_iff_toBitVec_eq, FlatShuffler.Flat.NONE]
    simp
  have hb : (¬ (UInt64.ofBitVec (M.dest[i.toNat]) = 18446744073709551615)) ↔
      (FlatShuffler.Flat.isRetained M i = true) := by
    have hgi : FlatShuffler.Flat.get M.dest i = M.dest[i.toNat] := by
      simp only [FlatShuffler.Flat.get, hi', dif_pos]
    rw [FlatShuffler.Flat.isRetained, hgi]
    simp only [bne_iff_ne]
    exact not_congr heq
  refine ⟨((rax &&& 18446744073709551360) |||
      ((if ¬ (UInt64.ofBitVec (M.dest[i.toNat]) = 18446744073709551615) then 1 else 0) &&& 255)),
    .ret ?_, ?_⟩
  · simp only [Skel.Gen.Level3.Shuffler.plannerHasOtherRetainedCopy.skel_semantic.plannerIsRetained.blocksP,
      Skel.Gen.Level3.Shuffler.plannerHasOtherRetainedCopy.skel_semantic.plannerIsRetained.initP,
      hrsi, hrdi, hloadB]
  · rw [low_byte_mask_or']
    by_cases hp : ¬ (UInt64.ofBitVec (M.dest[i.toNat]) = 18446744073709551615)
    · have hb2 : FlatShuffler.Flat.isRetained M i = true := hb.mp hp
      rw [if_pos hp, hb2]
      simp
    · have hb2 : FlatShuffler.Flat.isRetained M i = false := by
        cases h : FlatShuffler.Flat.isRetained M i
        · rfl
        · exact absurd (hb.mpr h) hp
      rw [if_neg hp, hb2]
      simp

/-! ## Facts about the loops of the callees -/

theorem slotWord_isJunk_u64 (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    (UInt64.ofBitVec (Layout.slotWord s pad) &&& 1095216660480 = 4294967296) ↔ s.kind = 1 := by
  rw [UInt64.eq_iff_toBitVec_eq]
  simp only [UInt64.toBitVec_and, UInt64.toBitVec_ofNat]
  exact slotWord_isJunk s pad

theorem isJunk_u64_iff (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    FlatShuffler.isJunk s = true ↔
      (UInt64.ofBitVec (Layout.slotWord s pad) &&& 1095216660480 = 4294967296) := by
  rw [FlatShuffler.isJunk, FlatShuffler.Junk, beq_iff_eq, slotWord_isJunk_u64]

theorem demandedFrom_ge (pl : FlatShuffler.Flat.Planner) (slot : FlatShuffler.StackSlot)
    (j : FlatShuffler.Word) (hj : ¬ (j < pl.targetSize)) :
    FlatShuffler.Flat.demandedFrom pl slot j = false := by
  rw [FlatShuffler.Flat.demandedFrom, dif_neg hj]

theorem demandedFrom_lt (pl : FlatShuffler.Flat.Planner) (slot : FlatShuffler.StackSlot)
    (j : FlatShuffler.Word) (hj : j < pl.targetSize) :
    FlatShuffler.Flat.demandedFrom pl slot j =
      (if !FlatShuffler.isJunk (FlatShuffler.Flat.get pl.target j) &&
        FlatShuffler.Flat.get pl.target j = slot then true
       else FlatShuffler.Flat.demandedFrom pl slot (j + 1)) := by
  rw [FlatShuffler.Flat.demandedFrom, dif_pos hj]

theorem demandedFrom_true_lt (pl : FlatShuffler.Flat.Planner) (slot : FlatShuffler.StackSlot)
    (j : FlatShuffler.Word) (h : FlatShuffler.Flat.demandedFrom pl slot j = true) :
    j < pl.targetSize := by
  apply Classical.byContradiction
  intro hj
  rw [demandedFrom_ge pl slot j hj] at h
  cases h

/-- The successor of a word, in `toNat`. -/
theorem toNat_add_one_of_le (x : UInt64) (n : Nat) (h : x.toNat ≤ n) (hn : n < 2 ^ 64 - 1) :
    (x + 1).toNat = x.toNat + 1 := by
  rw [UInt64.toNat_add]
  have h1 : (1 : UInt64).toNat = 1 := rfl
  rw [h1, Nat.mod_eq_of_lt]
  omega

/-- The low 48 bits of a word, as a bit vector. -/
theorem u64_low48 {a b : UInt64} (h : a &&& 281474976710655 = b &&& 281474976710655) :
    a.toBitVec &&& 281474976710655 = b.toBitVec &&& 281474976710655 := by
  have hh := congrArg UInt64.toBitVec h
  simpa [UInt64.toBitVec_and, UInt64.toBitVec_ofNat] using hh

/-- The low 48 bits of a word, from the bit vector form. -/
theorem low48_u64 {a b : UInt64}
    (h : a.toBitVec &&& 281474976710655 = b.toBitVec &&& 281474976710655) :
    a &&& 281474976710655 = b &&& 281474976710655 := by
  rw [UInt64.eq_iff_toBitVec_eq]
  simpa [UInt64.toBitVec_and, UInt64.toBitVec_ofNat] using h

/-- The invariant of the loop of `plannerIsDemanded`. -/
def demI (heap : Heap) (rsi rdi : UInt64) (pl : FlatShuffler.Flat.Planner)
    (slot : FlatShuffler.StackSlot) (targetSize : UInt64)
    (x : plannerIsDemanded.St plannerIsDemanded.In2p) : Prop :=
  x.input = ⟨heap, rsi, rdi⟩ ∧ x.rax = UInt64.ofBitVec targetSize.toBitVec ∧
    x.rdx = 1095216660480 ∧ x.r8 = 4294967296 ∧
    x.rcx.toBitVec.toNat ≤ pl.targetSize.toNat ∧
    FlatShuffler.Flat.demandedFrom pl slot x.rcx.toBitVec = FlatShuffler.Flat.isDemanded pl slot

/-- The output of the loop of `plannerIsDemanded`. -/
def demOut (pl : FlatShuffler.Flat.Planner) (slot : FlatShuffler.StackSlot) (targetSize : UInt64)
    (_ : plannerIsDemanded.St plannerIsDemanded.In2p) : UInt64 :=
  (UInt64.ofBitVec targetSize.toBitVec &&& 18446744073709551360) |||
    ((if FlatShuffler.Flat.isDemanded pl slot then 1 else 0) &&& 255)

/-- The measure of the loop of `plannerIsDemanded`. -/
def demMu (pl : FlatShuffler.Flat.Planner) (x : plannerIsDemanded.St plannerIsDemanded.In2p) : Nat :=
  pl.targetSize.toNat - x.rcx.toBitVec.toNat

open Lift.Shuffler.Internal.Proposed in
/-- The code of `plannerIsDemanded` returns `1` in the low byte exactly when the slot is demanded. -/
theorem plannerIsDemanded_returns (pl : FlatShuffler.Flat.Planner) (pad : BitVec 16)
    (heap : Heap) (rsi rdi : UInt64) (self target : BitVec 64) (targetSize : UInt64)
    (slot : FlatShuffler.StackSlot)
    (hrdi : rdi.toBitVec = self)
    (hrsi : rsi.toBitVec = Layout.slotWord slot pad)
    (hsize : heap.loadB (self + 24) .W64 = .ok targetSize.toBitVec)
    (hsizeNat : targetSize.toNat = pl.targetSize.toNat)
    (hmax : pl.targetSize.toNat ≤ FlatShuffler.maxStackSize)
    (htgt : heap.loadB (self + 16) .W64 = .ok target)
    (harr : ∀ j : FlatShuffler.Word, j < pl.targetSize →
      heap.loadB (target + j * 8) .W64 = .ok (Layout.slotWord (FlatShuffler.Flat.get pl.target j) pad)) :
    ∃ r, plannerIsDemanded.l2p.returns ⟨heap, rsi, rdi⟩ r ∧
      r.toBitVec.setWidth 8 = (if FlatShuffler.Flat.isDemanded pl slot then 1 else 0) := by
  have hmax' : pl.targetSize.toNat ≤ 1024 := by
    simpa [FlatShuffler.maxStackSize] using hmax
  have hstep : ∀ x, demI heap rsi rdi pl slot targetSize x →
      (∀ y, demI heap rsi rdi pl slot targetSize y → demMu pl y < demMu pl x →
        plannerIsDemanded.blocksP.Returns noCall .LBB21_1 y (demOut pl slot targetSize y)) →
      plannerIsDemanded.blocksP.Returns noCall .LBB21_1 x (demOut pl slot targetSize x) := by
    intro x hx ih
    obtain ⟨hinp, hrax, hrdx, hr8, hbound, hdem⟩ := hx
    have hload1 : x.input.heap.loadB (x.input.rdi.toBitVec + 16) .W64 = .ok target := by
      rw [hinp, hrdi]; exact htgt
    by_cases heq : x.rax = x.rcx
    · -- the loop ends: not demanded
      have hrcx : x.rcx.toBitVec = targetSize.toBitVec := by rw [← heq, hrax]
      have hlt : ¬ (x.rcx.toBitVec < pl.targetSize) := by
        rw [hrcx, BitVec.lt_def]
        show ¬ (targetSize.toNat < pl.targetSize.toNat)
        omega
      have hdf : FlatShuffler.Flat.demandedFrom pl slot x.rcx.toBitVec = false :=
        demandedFrom_ge pl slot _ hlt
      have hisd : FlatShuffler.Flat.isDemanded pl slot = false := by
        rw [← hdem]; exact hdf
      have hif : (if ¬ (UInt64.ofBitVec targetSize.toBitVec ≤ x.rcx) then (1 : UInt64) else 0) =
          (if FlatShuffler.Flat.isDemanded pl slot then 1 else 0) := by
        rw [hisd]; simp [← hrax, heq]
      have h1 : plannerIsDemanded.blocksP.step .LBB21_1 x = .ok (.goto .LBB21_5 x) := by
        simp only [plannerIsDemanded.blocksP]; rw [if_pos heq]
      refine .goto h1 (.ret ?_)
      show plannerIsDemanded.blocksP.step .LBB21_5 x = .ok (.ret (demOut pl slot targetSize x))
      simp only [plannerIsDemanded.blocksP, demOut, hrax, hif]
    · -- the loop goes on
      have hj : x.rcx < pl.targetSize := by
        rw [BitVec.lt_def]
        have h2 : x.rcx.toBitVec.toNat ≠ pl.targetSize.toNat := by
          intro hc
          apply heq
          rw [hrax]
          exact UInt64.eq_iff_toBitVec_eq.mpr (BitVec.eq_of_toNat_eq (by
            show targetSize.toNat = x.rcx.toBitVec.toNat
            omega))
        omega
      have hj2 : x.rcx.toBitVec.toNat < pl.targetSize.toNat := hj
      have hload2 : x.input.heap.loadB (target + x.rcx.toBitVec * 8) .W64 =
          .ok (Layout.slotWord (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) pad) := by
        rw [hinp]; exact harr _ hj
      have h1 : plannerIsDemanded.blocksP.step .LBB21_1 x = .ok (.goto .o31 x) := by
        simp only [plannerIsDemanded.blocksP]; rw [if_neg heq]
      let x2 : plannerIsDemanded.St plannerIsDemanded.In2p := { x with
        r9 := UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) pad),
        r10 := UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) pad)
          &&& x.rdx }
      have h2 : plannerIsDemanded.blocksP.step .o31 x = .ok
          (if UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) pad)
                &&& x.rdx = x.r8 then .goto .LBB21_4 x2 else .goto .o50 x2) := by
        simp only [plannerIsDemanded.blocksP, x2, hload1, hload2]
      have hsucc : (x.rcx + 1).toBitVec.toNat = x.rcx.toBitVec.toNat + 1 :=
        toNat_add_one_of_le x.rcx pl.targetSize.toNat hbound (by omega)
      by_cases hjk : (UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) pad)
          &&& x.rdx = x.r8)
      · -- the target slot is junk: continue
        have h2' : plannerIsDemanded.blocksP.step .o31 x = .ok (.goto .LBB21_4 x2) := by
          rw [h2, if_pos hjk]
        have hisj : FlatShuffler.isJunk (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) = true := by
          rw [isJunk_u64_iff, ← hrdx, ← hr8]
          exact hjk
        have hstepF : FlatShuffler.Flat.demandedFrom pl slot x.rcx.toBitVec =
            FlatShuffler.Flat.demandedFrom pl slot (x.rcx.toBitVec + 1) := by
          rw [demandedFrom_lt pl slot _ hj, hisj]
          simp
        have hx2I : demI heap rsi rdi pl slot targetSize { x2 with rcx := x2.rcx + 1 } := by
          refine ⟨by simp [x2, hinp], by simp [x2, hrax], by simp [x2, hrdx], by simp [x2, hr8],
            by simp only [x2]; rw [hsucc]; omega, ?_⟩
          show FlatShuffler.Flat.demandedFrom pl slot (x2.rcx + 1).toBitVec = _
          rw [show x2.rcx = x.rcx from rfl, show (x.rcx + 1).toBitVec = x.rcx.toBitVec + 1 from rfl,
            ← hstepF]
          exact hdem
        have hx2μ : demMu pl { x2 with rcx := x2.rcx + 1 } < demMu pl x := by
          simp only [demMu, x2]
          rw [hsucc]
          omega
        have h3 : plannerIsDemanded.blocksP.step .LBB21_4 x2 =
            .ok (.goto .LBB21_1 { x2 with rcx := x2.rcx + 1 }) := by
          simp only [plannerIsDemanded.blocksP]
        exact .goto h1 (.goto h2' (.goto h3 (ih _ hx2I hx2μ)))
      · -- the target slot is not junk: compare with the slot
        have h2' : plannerIsDemanded.blocksP.step .o31 x = .ok (.goto .o50 x2) := by
          rw [h2, if_neg hjk]
        have hisj : FlatShuffler.isJunk (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) = false := by
          cases h : FlatShuffler.isJunk (FlatShuffler.Flat.get pl.target x.rcx.toBitVec)
          · rfl
          · rw [isJunk_u64_iff, ← hrdx, ← hr8] at h
            exact absurd h hjk
        by_cases hslot : (UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) pad)
            &&& 281474976710655 = x.input.rsi &&& 281474976710655)
        · -- the slot is demanded
          have heqs : FlatShuffler.Flat.get pl.target x.rcx.toBitVec = slot := by
            have h1' : Layout.slotWord (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) pad
                &&& 281474976710655 = Layout.slotWord slot pad &&& 281474976710655 := by
              have hh : (UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) pad)).toBitVec
                  &&& 281474976710655 = rsi.toBitVec &&& 281474976710655 := by
                have h2'' := hslot
                rw [hinp] at h2''
                exact u64_low48 h2''
              simpa [hrsi] using hh
            exact slotWord_low48 h1'
          have hdemT : FlatShuffler.Flat.demandedFrom pl slot x.rcx.toBitVec = true := by
            rw [demandedFrom_lt pl slot _ hj, hisj, heqs]
            simp
          have hisd : FlatShuffler.Flat.isDemanded pl slot = true := by
            rw [← hdem]; exact hdemT
          have hrcxle : ¬ (UInt64.ofBitVec targetSize.toBitVec ≤ x.rcx) := by
            rw [UInt64.le_iff_toBitVec_le, BitVec.le_def]
            show ¬ (targetSize.toNat ≤ x.rcx.toBitVec.toNat)
            omega
          have hif : (if ¬ (UInt64.ofBitVec targetSize.toBitVec ≤ x.rcx) then (1 : UInt64) else 0) =
              (if FlatShuffler.Flat.isDemanded pl slot then 1 else 0) := by
            rw [hisd, if_pos hrcxle]
            simp
          have h3 : plannerIsDemanded.blocksP.step .o50 x2 = .ok
              (.goto .LBB21_5 { x2 with r9 := (x2.r9 ^^^ x.input.rsi) <<< (16 : UInt64) }) := by
            simp only [plannerIsDemanded.blocksP, x2]; rw [if_pos hslot]
          have h4 : plannerIsDemanded.blocksP.step .LBB21_5
              { x2 with r9 := (x2.r9 ^^^ x.input.rsi) <<< (16 : UInt64) } = .ok
              (.ret (demOut pl slot targetSize x)) := by
            simp only [plannerIsDemanded.blocksP, demOut, hrax, hif, x2]
          exact .goto h1 (.goto h2' (.goto h3 (.ret h4)))
        · -- not demanded: continue
          have heqs : FlatShuffler.Flat.get pl.target x.rcx.toBitVec ≠ slot := by
            intro hc
            apply hslot
            rw [hinp]
            apply low48_u64
            show Layout.slotWord (FlatShuffler.Flat.get pl.target x.rcx.toBitVec) pad
                &&& 281474976710655 = rsi.toBitVec &&& 281474976710655
            rw [hc, hrsi]
          have hdemF : FlatShuffler.Flat.demandedFrom pl slot x.rcx.toBitVec =
              FlatShuffler.Flat.demandedFrom pl slot (x.rcx.toBitVec + 1) := by
            rw [demandedFrom_lt pl slot _ hj, hisj]
            simp [heqs]
          have h3 : plannerIsDemanded.blocksP.step .o50 x2 = .ok
              (.goto .LBB21_4 { x2 with r9 := (x2.r9 ^^^ x.input.rsi) <<< (16 : UInt64) }) := by
            simp only [plannerIsDemanded.blocksP, x2]; rw [if_neg hslot]
          have h4 : plannerIsDemanded.blocksP.step .LBB21_4
              { x2 with r9 := (x2.r9 ^^^ x.input.rsi) <<< (16 : UInt64) } = .ok
              (.goto .LBB21_1 { x2 with r9 := (x2.r9 ^^^ x.input.rsi) <<< (16 : UInt64), rcx := x2.rcx + 1 }) := by
            simp only [plannerIsDemanded.blocksP]
          have hx2I : demI heap rsi rdi pl slot targetSize
              { x2 with r9 := (x2.r9 ^^^ x.input.rsi) <<< (16 : UInt64), rcx := x2.rcx + 1 } := by
            refine ⟨by simp [x2, hinp], by simp [x2, hrax], by simp [x2, hrdx],
              by simp [x2, hr8], by simp only [x2]; rw [hsucc]; omega, ?_⟩
            show FlatShuffler.Flat.demandedFrom pl slot (x2.rcx + 1).toBitVec = _
            rw [show x2.rcx = x.rcx from rfl,
              show (x.rcx + 1).toBitVec = x.rcx.toBitVec + 1 from rfl, ← hdemF]
            exact hdem
          have hx2μ : demMu pl { x2 with r9 := (x2.r9 ^^^ x.input.rsi) <<< (16 : UInt64), rcx := x2.rcx + 1 } < demMu pl x := by
            simp only [demMu, x2]
            rw [hsucc]
            omega
          exact .goto h1 (.goto h2' (.goto h3 (.goto h4 (ih _ hx2I hx2μ))))
  -- the entry
  let x0 : plannerIsDemanded.St plannerIsDemanded.In2p :=
    { plannerIsDemanded.initP ⟨heap, rsi, rdi⟩ with rax := UInt64.ofBitVec targetSize.toBitVec, rcx := 0, rdx := 1095216660480, r8 := 4294967296 }
  have hentry : plannerIsDemanded.blocksP.step .entry (plannerIsDemanded.initP ⟨heap, rsi, rdi⟩)
      = .ok (.goto .LBB21_1 x0) := by
    simp only [plannerIsDemanded.blocksP, plannerIsDemanded.initP, x0, hrdi, hsize]
  have hx0 : demI heap rsi rdi pl slot targetSize x0 := by
    refine ⟨rfl, rfl, rfl, rfl, by simp [x0, hmax'], ?_⟩
    show FlatShuffler.Flat.demandedFrom pl slot (0 : UInt64).toBitVec = _
    rfl
  have hloop := Blocks.Returns.loop (demI heap rsi rdi pl slot targetSize) (demMu pl)
    (demOut pl slot targetSize) hstep x0 hx0
  refine ⟨demOut pl slot targetSize x0, .goto hentry hloop, ?_⟩
  simp only [demOut, low_byte_mask_or]

theorem otherFrom_ge (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : ¬ (o < pl.sourceSize)) : FlatShuffler.Flat.otherFrom pl M dn offset o = false := by
  rw [FlatShuffler.Flat.otherFrom, dif_neg h]

theorem otherFrom_lt (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : o < pl.sourceSize) :
    FlatShuffler.Flat.otherFrom pl M dn offset o =
      (if o ≠ offset && FlatShuffler.Flat.get pl.source o = FlatShuffler.Flat.get pl.source offset &&
        FlatShuffler.Flat.isRetained M o && FlatShuffler.Flat.get dn o = 0 then true
       else FlatShuffler.Flat.otherFrom pl M dn offset (o + 1)) := by
  rw [FlatShuffler.Flat.otherFrom, dif_pos h]

theorem otherFrom_true_lt (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : FlatShuffler.Flat.otherFrom pl M dn offset o = true) : o < pl.sourceSize := by
  apply Classical.byContradiction
  intro hj
  rw [otherFrom_ge pl M dn offset o hj] at h
  cases h

theorem otherFrom_step (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : o < pl.sourceSize)
    (hf : (o ≠ offset && FlatShuffler.Flat.get pl.source o = FlatShuffler.Flat.get pl.source offset &&
      FlatShuffler.Flat.isRetained M o && FlatShuffler.Flat.get dn o = 0) = false) :
    FlatShuffler.Flat.otherFrom pl M dn offset o =
      FlatShuffler.Flat.otherFrom pl M dn offset (o + 1) := by
  rw [otherFrom_lt pl M dn offset o h, hf]
  simp

theorem otherFrom_true_of (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : o < pl.sourceSize)
    (hok : (o ≠ offset && FlatShuffler.Flat.get pl.source o = FlatShuffler.Flat.get pl.source offset &&
      FlatShuffler.Flat.isRetained M o && FlatShuffler.Flat.get dn o = 0) = true) :
    FlatShuffler.Flat.otherFrom pl M dn offset o = true := by
  rw [otherFrom_lt pl M dn offset o h, hok]
  simp

/-- The bytes `[k, k + n)` of the bytes at `a`, at the address `a + k`. -/
theorem Contains_slice {w : Nat} {m : Mem w} {a : BitVec w} {bs : List UInt8}
    (h : m.Contains a bs) (k n : Nat) :
    m.Contains (a + BitVec.ofNat w k) ((bs.drop k).take n) := by
  rw [Mem.Contains.iff] at h ⊢
  intro i hi
  have hik : k + i < bs.length := by
    simp only [List.length_take, List.length_drop] at hi; omega
  rw [BitVec.add_assoc, ← BitVec.ofNat_add, h (k + i) hik]
  congr 1
  simp only [List.getElem_take, List.getElem_drop]

/-- All objects of a heap that span a byte give the value of the memory there. -/
theorem byte_of_spanning {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds policy m)
    {o : Obj} (ho : o ∈ h) {addr : BitVec 64} {v : BitVec 8}
    (hl : o.loadBytes addr .W8 = some v) {c : UInt8} (hc : m.loadBytes addr 1 = some [c]) :
    v = BitVec.ofNat 8 c.toNat := by
  obtain ⟨k, ha, hk, hv⟩ := Obj.loadBytes_spec hl
  have hcont := hh.contains ho
  have hs := Contains_slice hcont k 1
  rw [← ha] at hs
  have hk' : k + 1 ≤ o.bytes.length := by
    rw [Obj.bytes_length]; simpa using hk
  have hlen : ((o.bytes.drop k).take 1).length = 1 := by
    simp only [List.length_take, List.length_drop]
    omega
  unfold Mem.Contains at hs
  rw [hlen] at hs
  rw [hc] at hs
  simp only [Option.some.injEq] at hs
  rw [hv, ← hs, ofBytes_single]
theorem loadB_self_sourceSize (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (self + 8) .W64 = .ok pl.sourceSize := by
  simpa using loadB_self_cell self target spills data trace mapping pad frame pl sp M dn offset a hs
    8 .W64 pl.sourceSize (by simp [offsets])

theorem loadB_source (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a)
    (i : FlatShuffler.Word) (hi : i.toNat < FlatShuffler.maxStackSize) :
    a.heap.loadB (data + i * 8) .W64 =
      .ok (Layout.slotWord (FlatShuffler.Flat.get pl.source i) (pad.setWidth 16)) := by
  have hs' := hs
  obtain ⟨-, -, -, -, -, -, -⟩ := hs
  have hi' : i.toNat < (pl.source.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad))).length := by
    rw [List.length_map, Vector.length_toList]
    exact hi
  have ho : Obj.words data false .W64
      (pl.source.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad))) ∈
      objsP self target spills data trace mapping pad pl sp M dn offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf, toObj, toCell, Layout.word,
      Function.comp_def, List.map_map, Obj.words]
  have h := loadB_words self target spills data trace mapping pad frame pl sp M dn offset a hs'
    data false _ ho i hi'
  rw [h]
  simp [FlatShuffler.Flat.get, hi]

theorem loadB_target_gen (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a)
    (j : FlatShuffler.Word) (hj : j.toNat < FlatShuffler.maxStackSize) :
    a.heap.loadB (target + j * 8) .W64 =
      .ok (Layout.slotWord (FlatShuffler.Flat.get pl.target j) (pad.setWidth 16)) := by
  have hs' := hs
  obtain ⟨-, -, -, -, -, -, -⟩ := hs
  have hi' : j.toNat < (pl.target.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad))).length := by
    rw [List.length_map, Vector.length_toList]
    exact hj
  have ho : Obj.words target false .W64
      (pl.target.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad))) ∈
      objsP self target spills data trace mapping pad pl sp M dn offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf, toObj, toCell, Layout.word,
      Function.comp_def, List.map_map, Obj.words]
  have h := loadB_words self target spills data trace mapping pad frame pl sp M dn offset a hs'
    target false _ ho j hi'
  rw [h]
  simp [FlatShuffler.Flat.get, hj]

theorem loadB_dn (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a)
    (i : FlatShuffler.Word) (hi : i.toNat < FlatShuffler.maxStackSize) :
    a.heap.loadB (trace + i * 1) .W8 = .ok (FlatShuffler.Flat.get dn i) := by
  have hs' := hs
  obtain ⟨-, -, -, -, -, hheap, policy, m, hh⟩ := hs
  rw [hheap] at hh ⊢
  have ho : Obj.words trace false .W8 dn.toList ∈
      objsP self target spills data trace mapping pad pl sp M dn offset ++ frame := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf, toObj, toCell, Layout.word,
      Function.comp_def, List.map_map, Obj.words]
  have h := Heap.load_words (w := .W8) hh ho (k := i.toNat) (by simpa using hi)
  have haddr : trace + i * 1 = trace + BitVec.ofNat 64 (Width.W8.bytes * i.toNat) := by
    rw [show Width.W8.bytes = 1 from rfl, Nat.one_mul]
    congr 1
    simp
  rw [haddr, Heap.loadB_of_load h]
  simp [FlatShuffler.Flat.get, hi]

/-- The bytes of the block `k` of a list of blocks of `s` bytes. -/
theorem drop_take_flatMap {α : Type} {l : List α} {g : α → List UInt8} {s k r n : Nat}
    (hs : ∀ x, (g x).length = s) {a : α} (hk : l[k]? = some a) (hrn : r + n ≤ s) :
    ((l.flatMap g).drop (k * s + r)).take n = ((g a).drop r).take n := by
  induction l generalizing k with
  | nil => simp at hk
  | cons x xs ih =>
    rw [List.flatMap_cons]
    cases k with
    | zero =>
      rw [List.getElem?_cons_zero, Option.some.injEq] at hk
      subst hk
      have hlen : (g x).length = s := hs x
      rw [Nat.zero_mul, Nat.zero_add, List.drop_append,
        Nat.sub_eq_zero_of_le (show r ≤ (g x).length by rw [hlen]; omega), List.drop_zero]
      rw [List.take_append, Nat.sub_eq_zero_of_le
        (show n ≤ (List.drop r (g x)).length by rw [List.length_drop, hlen]; omega),
        List.take_zero, List.append_nil]
    | succ k =>
      rw [List.getElem?_cons_succ] at hk
      simp only [List.drop_append]
      rw [List.drop_eq_nil_of_le
        (show (g x).length ≤ (k + 1) * s + r by rw [hs, Nat.succ_mul]; omega), List.nil_append,
        show (k + 1) * s + r - (g x).length = k * s + r by rw [hs, Nat.succ_mul]; omega]
      exact ih hk

/-- The byte 4 of the block `i` of an array of words. -/
theorem Obj.words_loadBytes_W8 (base : BitVec 64) (xs : List (BitVec 64)) (i : BitVec 64)
    (hi : i.toNat < xs.length) (hnw : base.toNat + 8 * xs.length ≤ 2 ^ 64) :
    (Obj.words base false .W64 xs).loadBytes (base + i * 8 + 4) .W8
      = some (BitVec.ofInt 8 (Int.ofBytes (((Int.toBytes 8 (xs[i.toNat]).toInt).drop 4).take 1))) := by
  have hsize : (Obj.words base false .W64 xs).size = 8 * xs.length := by
    show ((xs.map (Cell.mk .W64)).map fun c => c.w.bytes).sum = 8 * xs.length
    rw [words_bytes (w := .W64)]
  have hi8 : i.toNat * 8 < 2 ^ 64 := by
    have h1 : i.toNat * 8 < xs.length * 8 := by omega
    have h2 : xs.length * 8 = 8 * xs.length := Nat.mul_comm _ _
    omega
  have h8 : (8 : BitVec 64).toNat = 8 := by decide
  have h4 : (4 : BitVec 64).toNat = 4 := by decide
  have hmul : (i * 8).toNat = i.toNat * 8 := by
    rw [BitVec.toNat_mul, h8, Nat.mod_eq_of_lt hi8]
  have h1 : (base + i * 8).toNat = base.toNat + i.toNat * 8 := by
    rw [BitVec.toNat_add_of_lt (show base.toNat + (i * 8).toNat < 2 ^ 64 by rw [hmul]; omega), hmul]
  have haddr : (base + i * 8 + 4).toNat = base.toNat + (i.toNat * 8 + 4) := by
    rw [BitVec.toNat_add_of_lt
      (show (base + i * 8).toNat + (4 : BitVec 64).toNat < 2 ^ 64 by rw [h1, h4]; omega), h1, h4]
    omega
  unfold Obj.loadBytes
  have hsp : (Obj.words base false .W64 xs).Spans (base + i * 8 + 4) .W8 := by
    unfold Obj.Spans
    constructor
    · show base.toNat ≤ (base + i * 8 + 4).toNat
      omega
    · show (base + i * 8 + 4).toNat + 1 ≤ base.toNat + (Obj.words base false .W64 xs).size
      rw [haddr, hsize]
      omega
  rw [if_pos hsp]
  rw [show (Width.W8).bytes = 1 from rfl]
  have hoff : (base + i * 8 + 4).toNat - (Obj.words base false .W64 xs).addr.toNat
      = i.toNat * 8 + 4 := by
    show (base + i * 8 + 4).toNat - base.toNat = i.toNat * 8 + 4
    rw [haddr]; omega
  rw [hoff]
  have hbytes : (Obj.words base false .W64 xs).bytes = xs.flatMap (fun x => Int.toBytes 8 x.toInt) := by
    show List.flatMap Cell.bytes (xs.map (Cell.mk .W64)) = xs.flatMap (fun x => Int.toBytes 8 x.toInt)
    rw [List.flatMap_map]
    rfl
  rw [hbytes]
  rw [drop_take_flatMap (g := fun x => Int.toBytes 8 x.toInt) (s := 8)
    (fun x => Int.toBytes_length 8 _) (List.getElem?_eq_getElem hi) (by omega)]
theorem loadBytes_byte {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds policy m)
    {o : Obj} (ho : o ∈ h) {addr : BitVec 64} {v : BitVec 8}
    (hl : o.loadBytes addr .W8 = some v) :
    ∃ c : UInt8, m.loadBytes addr 1 = some [c] ∧ v = BitVec.ofNat 8 c.toNat := by
  obtain ⟨k, ha, hk, hv⟩ := Obj.loadBytes_spec hl
  have hb : (Width.W8).bytes = 1 := rfl
  have hbits : (Width.W8).bits = 8 := rfl
  rw [hb] at hk
  have hcont := Contains_slice (hh.contains ho) k 1
  rw [← ha] at hcont
  have hlen : ((o.bytes.drop k).take 1).length = 1 := by
    simp only [List.length_take, List.length_drop, Obj.bytes_length]
    omega
  unfold Mem.Contains at hcont
  rw [hlen] at hcont
  obtain ⟨c, hc⟩ := List.length_eq_one_iff.mp hlen
  rw [hc] at hcont
  refine ⟨c, hcont, ?_⟩
  rw [hv, hc, ofBytes_single]

theorem loadB_byte_eq {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds policy m)
    {addr : BitVec 64} {v : BitVec 8} (hl : h.loadB addr .W8 = .ok v)
    {o : Obj} (ho : o ∈ h) {v' : BitVec 8} (hl' : o.loadBytes addr .W8 = some v') :
    v = v' := by
  obtain ⟨c, hc, hvc⟩ := loadBytes_byte hh ho hl'
  have key : v = BitVec.ofNat 8 c.toNat := by
    unfold Heap.loadB at hl
    split at hl
    · rename_i hl1
      cases hl
      have hr := Heap.load_sound hh hl1
      unfold readRam at hr
      simp only [Mem.loadInt, hc] at hr
      split at hr
      · have h2 : BitVec.ofInt 8 (Int.ofBytes [c]) = v := by simpa using hr
        rw [← h2, ofBytes_single]
      · cases hr
    · split at hl
      · rename_i hf
        cases hl
        obtain ⟨o1, ho1, hl1⟩ := List.exists_of_findSome?_eq_some hf
        obtain ⟨c1, hc1, hv1⟩ := loadBytes_byte hh ho1 hl1
        have hcc : c1 = c := by
          rw [hc1] at hc
          simpa using hc
        rw [hv1, hcc]
      · cases hl
  rw [key, hvc]

theorem loadB_isSome_of_loadBytes {h : Heap} {addr : BitVec 64} {v : BitVec 8} {o : Obj}
    (ho : o ∈ h) (hl : o.loadBytes addr .W8 = some v) :
    ∃ v', h.loadB addr .W8 = .ok v' := by
  unfold Heap.loadB
  split
  · exact ⟨_, rfl⟩
  · split
    · exact ⟨_, rfl⟩
    · rename_i hf
      rw [List.findSome?_eq_none_iff] at hf
      rw [hf o ho] at hl
      cases hl

theorem loadB_target_kind (self target spills data trace mapping pad : BitVec 64) (frame : Heap)
    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    a.heap.loadB (target + FlatShuffler.Flat.get M.dest offset * 8 + 4) .W8 =
      .ok (FlatShuffler.Flat.get pl.target (FlatShuffler.Flat.get M.dest offset)).kind := by
  obtain ⟨hC, -, -, -, -, hheap, policy, m, hh⟩ := hs
  obtain ⟨-, -, -, hDest, hAll⟩ := hC
  let xs : List (BitVec 64) :=
    pl.target.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad))
  have hxsdef : xs = pl.target.toList.map (fun s => Layout.slotWord s (BitVec.setWidth 16 pad)) := rfl
  have hlen : xs.length = FlatShuffler.maxStackSize := by
    rw [hxsdef, List.length_map, Vector.length_toList]
  have ho : Obj.words target false .W64 xs ∈ a.heap := by
    rw [hheap, hxsdef]
    simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
      Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf, toObj, toCell, Layout.word,
      Function.comp_def, List.map_map, Obj.words]
  have hsz : (Obj.words target false .W64 xs).size = 8 * xs.length := by
    show ((xs.map (Cell.mk .W64)).map fun c => c.w.bytes).sum = 8 * xs.length
    rw [words_bytes (w := .W64)]
  have hnw : target.toNat + 8 * xs.length ≤ 2 ^ 64 := by
    have h := hh.noWrap _ ho
    have h2 : (Obj.words target false .W64 xs).addr = target := rfl
    rw [h2, hsz] at h
    exact h
  have hl : (Obj.words target false .W64 xs).loadBytes
        (target + FlatShuffler.Flat.get M.dest offset * 8 + 4) .W8 =
      some (FlatShuffler.Flat.get pl.target (FlatShuffler.Flat.get M.dest offset)).kind := by
    rw [Obj.words_loadBytes_W8 target xs (FlatShuffler.Flat.get M.dest offset)
      (by rw [hlen]; exact hDest) hnw]
    have hget : xs[(FlatShuffler.Flat.get M.dest offset).toNat]
        = Layout.slotWord (FlatShuffler.Flat.get pl.target (FlatShuffler.Flat.get M.dest offset))
            (pad.setWidth 16) := by
      have hi2 : (FlatShuffler.Flat.get M.dest offset).toNat < xs.length := by
        rw [hlen]; exact hDest
      have h1 : xs[(FlatShuffler.Flat.get M.dest offset).toNat]?
          = some (Layout.slotWord
              (FlatShuffler.Flat.get pl.target (FlatShuffler.Flat.get M.dest offset))
              (pad.setWidth 16)) := by
        rw [hxsdef, List.getElem?_map]
        rw [List.getElem?_eq_getElem (show (FlatShuffler.Flat.get M.dest offset).toNat
          < pl.target.toList.length by rw [Vector.length_toList]; exact hDest)]
        have hd : BitVec.toNat
            (if h : BitVec.toNat offset < FlatShuffler.maxStackSize then
              M.dest[BitVec.toNat offset] else default) < FlatShuffler.maxStackSize := hDest
        simp [FlatShuffler.Flat.get, hd]
      rw [List.getElem?_eq_getElem hi2] at h1
      exact (Option.some.injEq _ _).mp h1
    rw [hget, slotWord_byte4]
  obtain ⟨v, hv⟩ := loadB_isSome_of_loadBytes ho hl
  rw [hv, loadB_byte_eq hh hv ho hl]

def othRel : Unit →
    Skel.Gen.Level3.Shuffler.plannerHasOtherRetainedCopy.skel_semantic.plannerIsRetained.In2p →
    UInt64 → Prop :=
  fun _ x r =>
    Skel.Gen.Level3.Shuffler.plannerHasOtherRetainedCopy.skel_semantic.plannerIsRetained.l2p.returns x r

def othI (pl : FlatShuffler.Flat.Planner) (offset : FlatShuffler.Word) (heap : Heap)
    (self mapping dnPtr : BitVec 64) (x : plannerHasOtherRetainedCopy.St plannerHasOtherRetainedCopy.In2p Heap) : Prop :=
  x.mem = heap ∧ x.rbp = UInt64.ofBitVec pl.sourceSize ∧ x.r12 = UInt64.ofBitVec self ∧
  x.r14 = UInt64.ofBitVec dnPtr ∧ x.r15 = UInt64.ofBitVec mapping ∧ x.rbx = UInt64.ofBitVec offset ∧
  x.r13.toBitVec.toNat ≤ pl.sourceSize.toNat

def othMu (pl : FlatShuffler.Flat.Planner) (x : plannerHasOtherRetainedCopy.St plannerHasOtherRetainedCopy.In2p Heap) : Nat :=
  pl.sourceSize.toNat - x.r13.toBitVec.toNat

theorem byte_eq_zero (v : BitVec 8) : (UInt64.ofBitVec (BitVec.zeroExtend 64 v) = 0) ↔ v = 0 := by
  rw [UInt64.ofBitVec_eq_iff_eq_toBitVec, show (0 : UInt64).toBitVec = (0 : BitVec 64) from rfl]
  constructor
  · intro h
    have h2 : BitVec.zeroExtend 64 v = (0 : BitVec 64) := h
    have h3 : (BitVec.zeroExtend 64 v).toNat = v.toNat := by
      show (BitVec.setWidth 64 v).toNat = v.toNat
      simp
      omega
    have h4 : v.toNat = 0 := by
      have hh := congrArg (fun x : BitVec 64 => x.toNat) h2
      rw [h3] at hh
      simpa using hh
    exact BitVec.eq_of_toNat_eq (by simpa using h4)
  · intro h; rw [h]; rfl

theorem other_lowbyte (pl : FlatShuffler.Flat.Planner) (pad : BitVec 64) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (heap : Heap) (self data mapping dnPtr : BitVec 64) (a : plannerHasOtherRetainedCopy.In2p)
    (hheap : a.heap = heap) (hrcx : a.rcx.toBitVec = offset) (hrdx : a.rdx.toBitVec = dnPtr)
    (hrsi : a.rsi.toBitVec = mapping) (hrdi : a.rdi.toBitVec = self)
    (hholds : ∃ policy m, heap.Holds policy m)
    (hsize : heap.loadB (self + 8) .W64 = .ok pl.sourceSize)
    (hmax : pl.sourceSize.toNat ≤ FlatShuffler.maxStackSize)
    (hdata : heap.loadB self .W64 = .ok data)
    (hsrc : ∀ i : FlatShuffler.Word, i.toNat < FlatShuffler.maxStackSize →
      heap.loadB (data + i * 8) .W64 = .ok (Layout.slotWord (FlatShuffler.Flat.get pl.source i) (pad.setWidth 16)))
    (hmap : Obj.words mapping false .W64 M.dest.toList ∈ heap)
    (hdn : ∀ i : FlatShuffler.Word, i.toNat < FlatShuffler.maxStackSize →
      heap.loadB (dnPtr + i * 1) .W8 = .ok (FlatShuffler.Flat.get dn i))
    (hoff : offset.toNat < FlatShuffler.maxStackSize) :
    ∃ r, plannerHasOtherRetainedCopy.l2p.returns a r ∧
      r.toBitVec.setWidth 8 = (if FlatShuffler.Flat.hasOtherRetainedCopy pl M dn offset then 1 else 0) := by
  have hms : FlatShuffler.maxStackSize = 1024 := rfl
  have hmax' : pl.sourceSize.toNat ≤ 1024 := by simpa [hms] using hmax
  have hmain : ∀ n, ∀ x : plannerHasOtherRetainedCopy.St plannerHasOtherRetainedCopy.In2p Heap,
      othI pl offset heap self mapping dnPtr x → othMu pl x = n →
      ∃ r, plannerHasOtherRetainedCopy.blocksP.Returns othRel .LBB22_1 x r ∧
        r.toBitVec.setWidth 8 =
          (if FlatShuffler.Flat.otherFrom pl M dn offset x.r13.toBitVec then 1 else 0) := by
    intro n
    induction n using Nat.strongRecOn with
    | ind n ih =>
      intro x hx hmu
      obtain ⟨hmem, hrbp, hr12, hr14, hr15, hrbx, hbound⟩ := hx
      have hrbpb : x.rbp.toBitVec = pl.sourceSize := by rw [hrbp, UInt64.toBitVec_ofBitVec]
      have hr12b : x.r12.toBitVec = self := by rw [hr12, UInt64.toBitVec_ofBitVec]
      have hr14b : x.r14.toBitVec = dnPtr := by rw [hr14, UInt64.toBitVec_ofBitVec]
      have hr15b : x.r15.toBitVec = mapping := by rw [hr15, UInt64.toBitVec_ofBitVec]
      have hrbxb : x.rbx.toBitVec = offset := by rw [hrbx, UInt64.toBitVec_ofBitVec]
      have hsucc : (x.r13 + 1).toBitVec.toNat = x.r13.toBitVec.toNat + 1 :=
        toNat_add_one_of_le x.r13 pl.sourceSize.toNat hbound (by omega)
      have hsuccb : (x.r13 + 1).toBitVec = x.r13.toBitVec + 1 := by
        rw [UInt64.toBitVec_add]; rfl
      by_cases heq : x.rbp = x.r13
      · -- the loop ends: not retained elsewhere
        have hsrc_eq : x.r13.toBitVec = pl.sourceSize := by
          have h := congrArg UInt64.toBitVec heq
          rw [hrbpb] at h
          exact h.symm
        have hof : FlatShuffler.Flat.otherFrom pl M dn offset x.r13.toBitVec = false := by
          refine otherFrom_ge pl M dn offset _ ?_
          rw [hsrc_eq]
          exact BitVec.lt_irrefl _
        have h1 : plannerHasOtherRetainedCopy.blocksP.step .LBB22_1 x = .ok (.goto .LBB22_7 x) := by
          simp only [plannerHasOtherRetainedCopy.blocksP]
          rw [if_pos heq]
        have h2 : plannerHasOtherRetainedCopy.blocksP.step .LBB22_7 x =
            .ok (.ret ((x.rax &&& 18446744073709551360) |||
              ((if ¬ (x.rbp ≤ x.r13) then 1 else 0) &&& 255))) := by
          simp only [plannerHasOtherRetainedCopy.blocksP]
        refine ⟨_, .goto h1 (.ret h2), ?_⟩
        rw [low_byte_mask_or', hof]
        simp [heq]
      · -- the loop goes on
        have hltn : x.r13.toBitVec.toNat < pl.sourceSize.toNat := by
          have hne : x.r13.toBitVec.toNat ≠ pl.sourceSize.toNat := by
            intro hc
            apply heq
            rw [hrbp, ← BitVec.eq_of_toNat_eq hc]
          omega
        have hlt : x.r13.toBitVec < pl.sourceSize := by
          rw [BitVec.lt_def]
          exact hltn
        have h1 : plannerHasOtherRetainedCopy.blocksP.step .LBB22_1 x = .ok (.goto .o35 x) := by
          simp only [plannerHasOtherRetainedCopy.blocksP]
          rw [if_neg heq]
        by_cases hoffeq : x.rbx = x.r13
        · -- o = offset: continue
          have hoffs : x.r13.toBitVec = offset := by
            have h := congrArg UInt64.toBitVec hoffeq
            rw [hrbxb] at h
            exact h.symm
          have hof : FlatShuffler.Flat.otherFrom pl M dn offset x.r13.toBitVec =
              FlatShuffler.Flat.otherFrom pl M dn offset (x.r13.toBitVec + 1) := by
            refine otherFrom_step pl M dn offset _ hlt ?_
            simp [hoffs]
          have h2 : plannerHasOtherRetainedCopy.blocksP.step .o35 x = .ok (.goto .LBB22_6 x) := by
            simp only [plannerHasOtherRetainedCopy.blocksP]
            rw [if_pos hoffeq]
          have h3 : plannerHasOtherRetainedCopy.blocksP.step .LBB22_6 x =
              .ok (.goto .LBB22_1 { x with r13 := x.r13 + 1 }) := by
            simp only [plannerHasOtherRetainedCopy.blocksP]
          have hy : othI pl offset heap self mapping dnPtr { x with r13 := x.r13 + 1 } :=
            ⟨hmem, hrbp, hr12, hr14, hr15, hrbx, by
              show (x.r13 + 1).toBitVec.toNat ≤ pl.sourceSize.toNat
              rw [hsucc]
              exact Nat.succ_le_of_lt hlt⟩
          have hlt2 : othMu pl { x with r13 := x.r13 + 1 } < othMu pl x := by
            show pl.sourceSize.toNat - (x.r13 + 1).toBitVec.toNat < pl.sourceSize.toNat - x.r13.toBitVec.toNat
            rw [hsucc]
            have hf : x.r13.toBitVec.toNat < pl.sourceSize.toNat := hlt
            omega
          obtain ⟨r, hr, hlow⟩ := ih _ (hmu ▸ hlt2) _ hy rfl
          refine ⟨r, .goto h1 (.goto h2 (.goto h3 hr)), ?_⟩
          rw [hlow, hsuccb, hof]
        · -- o ≠ offset: compare the source words
          have hltnat : x.r13.toBitVec.toNat < FlatShuffler.maxStackSize := by
            rw [hms]; omega
          have hload1 : x.mem.loadB x.r12.toBitVec .W64 = .ok data := by
            rw [hmem, hr12b]; exact hdata
          have hload2 : x.mem.loadB (data + x.rbx.toBitVec * 8) .W64 =
              .ok (Layout.slotWord (FlatShuffler.Flat.get pl.source offset) (pad.setWidth 16)) := by
            rw [hmem, hrbxb]
            exact hsrc offset hoff
          have hload3 : x.mem.loadB (data + x.r13.toBitVec * 8) .W64 =
              .ok (Layout.slotWord (FlatShuffler.Flat.get pl.source x.r13.toBitVec) (pad.setWidth 16)) := by
            rw [hmem]
            exact hsrc x.r13.toBitVec hltnat
          have h2 : plannerHasOtherRetainedCopy.blocksP.step .o35 x = .ok (.goto .o40 x) := by
            simp only [plannerHasOtherRetainedCopy.blocksP]
            rw [if_neg hoffeq]
          have hoffs : x.r13.toBitVec ≠ offset := by
            intro hc
            apply hoffeq
            rw [hrbx, ← hc]
          let y58 : plannerHasOtherRetainedCopy.St plannerHasOtherRetainedCopy.In2p Heap := { x with rax := UInt64.ofBitVec data, rcx := (UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.source offset) (pad.setWidth 16)) ^^^ UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.source x.r13.toBitVec) (pad.setWidth 16))) <<< (16 : UInt64) }
          by_cases hcmp : UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.source offset) (pad.setWidth 16)) &&& 281474976710655 =
              UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.source x.r13.toBitVec) (pad.setWidth 16)) &&& 281474976710655
          · -- the words are the same: ask whether the copy is retained
            have hslot : FlatShuffler.Flat.get pl.source x.r13.toBitVec = FlatShuffler.Flat.get pl.source offset := by
              have h := u64_low48 hcmp
              simp only [UInt64.toBitVec_ofBitVec, UInt64.toBitVec_and, UInt64.toBitVec_ofNat] at h
              exact (slotWord_low48 h).symm
            have h3 : plannerHasOtherRetainedCopy.blocksP.step .o40 x = .ok (.goto .o58 y58) := by

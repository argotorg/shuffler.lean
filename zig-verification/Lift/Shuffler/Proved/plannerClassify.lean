    ∀ (n : Nat), n ≤ 8 →
      Lift.Sem.PrivateStack.loadBytes (Lift.Sem.PrivateStack.store s .W64 o v) (o + ((8 - n : Nat) : Int)) n
        = some (v.toNat / 2 ^ (8 * (8 - n))) := by
  intro n
  induction n with
  | zero =>
    intro _
    simp only [Lift.Sem.PrivateStack.loadBytes]
    have h : 8 * (8 - 0) = 64 := by omega
    rw [h, Nat.div_eq_of_lt v.isLt]
  | succ n ih =>
    intro hn
    have hn8 : n < 8 := by omega
    have hstep : Lift.Sem.PrivateStack.loadBytes (Lift.Sem.PrivateStack.store s .W64 o v) (o + ((8 - (n + 1) : Nat) : Int)) (n + 1)
        = (do
            let b ← (Lift.Sem.PrivateStack.store s .W64 o v) (o + ((8 - (n + 1) : Nat) : Int))
            let r ← Lift.Sem.PrivateStack.loadBytes (Lift.Sem.PrivateStack.store s .W64 o v) ((o + ((8 - (n + 1) : Nat) : Int)) + 1) n
            pure (b.toNat + 256 * r)) := rfl
    rw [hstep]
    have hb : (Lift.Sem.PrivateStack.store s .W64 o v) (o + ((8 - (n + 1) : Nat) : Int))
        = some (BitVec.ofNat 8 (v.toNat / 2 ^ (8 * (8 - (n + 1))))) := by
      simp only [Lift.Sem.PrivateStack.store]
      rw [if_pos]
      · rw [show ((o + ((8 - (n + 1) : Nat) : Int)) - o) = ((8 - (n + 1) : Nat) : Int) from by omega]
        simp
      · constructor
        · omega
        · simp [Width.bytes]
          omega
    rw [hb]
    rw [show ((o + ((8 - (n + 1) : Nat) : Int)) + 1) = o + ((8 - n : Nat) : Int) by push_cast; omega]
    rw [ih (by omega)]
    simp only [Option.pure_def, Option.bind_eq_bind, Option.bind_some, Option.some.injEq]
    rw [BitVec.toNat_ofNat]
    have hd : v.toNat / 2 ^ (8 * (8 - n)) = v.toNat / 2 ^ (8 * (8 - (n + 1))) / 256 := by
      rw [show 8 * (8 - n) = 8 * (8 - (n + 1)) + 8 from by omega, Nat.pow_add,
        show 2 ^ 8 = 256 from by decide, ← Nat.div_div_eq_div_mul]
    rw [hd, arith256]

theorem loadBytes_store_shift (s : Lift.Sem.PrivateStack) (o : Int) (v : BitVec 64) :
    ∀ (o' : Int), o + 8 ≤ o' → ∀ (n : Nat),
      Lift.Sem.PrivateStack.loadBytes (Lift.Sem.PrivateStack.store s .W64 o v) o' n =
        Lift.Sem.PrivateStack.loadBytes s o' n := by
  intro o' h n
  induction n generalizing o' with
  | zero => rfl
  | succ n ih =>
    rw [Lift.Sem.PrivateStack.loadBytes, Lift.Sem.PrivateStack.loadBytes]
    have hb : (Lift.Sem.PrivateStack.store s .W64 o v) o' = s o' := by
      simp only [Lift.Sem.PrivateStack.store]
      rw [if_neg]
      intro hc
      simp [Width.bytes] at hc
      omega
    rw [hb, ih (o' + 1) (by omega)]

theorem load_store_W64_self (s : Lift.Sem.PrivateStack) (o : Int) (v : BitVec 64) :
    Lift.Sem.PrivateStack.load (Lift.Sem.PrivateStack.store s .W64 o v) .W64 o = .ok v := by
  have h := loadBytes_store_W64 s o v 8 (by omega)
  rw [show (8 - 8 : Nat) = 0 from rfl, show o + ((0 : Nat) : Int) = o from by simp] at h
  rw [show 8 * (8 - 8) = 0 from rfl, Nat.pow_zero, Nat.div_one] at h
  simp only [Lift.Sem.PrivateStack.load, Width.bytes, Width.bits, h]
  simp

theorem load_store_W64_shift (s : Lift.Sem.PrivateStack) (o : Int) (v : BitVec 64) (o' : Int)
    (h : o + 8 ≤ o') :
    Lift.Sem.PrivateStack.load (Lift.Sem.PrivateStack.store s .W64 o v) .W64 o' =
      Lift.Sem.PrivateStack.load s .W64 o' := by
  simp only [Lift.Sem.PrivateStack.load]
  rw [loadBytes_store_shift s o v o' h 8]
/-- The code of `classify` returns the byte of `Flat.classify`. -/

def bridgeState (z : skel_call.StP) : StP := { input := callInput z.input, rax := z.rax, rbx := z.rbx, rcx := z.rcx, rdx := z.rdx, rsi := z.rsi, rdi := z.rdi, rbp := z.rbp, r12 := z.r12, r13 := z.r13, r14 := z.r14, r15 := z.r15, mem := z.mem, stack := z.stack }

abbrev BridgeHiNext := Next Lbl (StP) UInt64 Cal CalP.In CalP.Out
abbrev BridgeLoNext := Next Lbl (skel_call.StP) UInt64 Cal CalP.In CalP.Out

def bridgeNext : BridgeLoNext → BridgeHiNext
  | .goto l z => .goto l (bridgeState z)
  | .ret r => .ret r
  | .call f x k => .call f x (fun r => ((k r).1, bridgeState (k r).2))

def bridgeRes : Res BridgeLoNext → Res BridgeHiNext
  | .ok n => .ok (bridgeNext n)
  | .stuck why => .stuck why
  | .noFuel => .noFuel

theorem bridgeState_related (z : skel_call.StP) : callState (bridgeState z) z := by
  simp [callState, bridgeState]

theorem bridge_related_eq (x : StP) (z : skel_call.StP)
    (h : callState x z) : x = bridgeState z := by
  cases x with
  | mk xp xs =>
    cases z with
    | mk zp zs =>
      cases xp
      cases zp
      simp_all [callState, bridgeState, callInput]

theorem bridgeNext_related (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      callState (fun (r : UInt64) (q : UInt64) => r = q) (bridgeNext n) (.ok n) := by
  cases n with
  | goto l z => exact ⟨z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, k, rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridgeNext_related_rev (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q) n (.ok (bridgeNext n)) := by
  cases n with
  | goto l z => exact ⟨bridgeState z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, (fun r => ((k r).1, bridgeState (k r).2)), rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridge_goto {l : Lbl} {input : skel_call.In2p} {rax : UInt64} {rbx : UInt64} {rcx : UInt64} {rdx : UInt64} {rsi : UInt64} {rdi : UInt64} {rbp : UInt64} {r12 : UInt64} {r13 : UInt64} {r14 : UInt64} {r15 : UInt64} {mem : Heap} {stack : Lift.Sem.PrivateStack} :
    (Res.ok (Next.goto l { input := callInput input, rax := rax, rbx := rbx, rcx := rcx, rdx := rdx, rsi := rsi, rdi := rdi, rbp := rbp, r12 := r12, r13 := r13, r14 := r14, r15 := r15, mem := mem, stack := stack }) : Res BridgeHiNext) =
      bridgeRes (.ok (.goto l { input := input, rax := rax, rbx := rbx, rcx := rcx, rdx := rdx, rsi := rsi, rdi := rdi, rbp := rbp, r12 := r12, r13 := r13, r14 := r14, r15 := r15, mem := mem, stack := stack })) := rfl


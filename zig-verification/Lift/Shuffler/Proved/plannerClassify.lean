/-- The stack cells written by the prologue are readable. -/
theorem load_store_self (s : Lift.Sem.PrivateStack) (o : Int) (v : BitVec 64) :
    ∃ w, Lift.Sem.PrivateStack.load (Lift.Sem.PrivateStack.store s .W64 o v) .W64 o = .ok w := by
  refine exists_load _ .W64 o ?_
  intro i hi1 hi2
  have h8 : (Width.W64.bytes : Int) = 8 := rfl
  exact byte_store_self s o v (o + i) (by omega) (by omega)


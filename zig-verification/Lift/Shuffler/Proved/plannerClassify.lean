theorem call_bridge_rev : Refines (fun a b => b = callInput a) (fun _ _ (q : UInt64) (r : UInt64) => r = q) skel_call.l2p.returns l2p.returns := by
  intro a b r hab hr
  subst b
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l z x n hs ht
      have hx := bridge_related_eq x z hs
      subst x
      rw [bridge_step_eq, ht]
      exact bridgeNext_related_rev n)
    hr (by simp [callState, initP, skel_call.initP, callInput])
end call_bridge_rev.skel_proof
theorem call_bridge_rev : call_bridge_rev.skel_statement := @call_bridge_rev.skel_proof.call_bridge_rev
theorem call_summary : callSummary := by
  intro self target spills data trace mapping pad frame pl sp M dn offset a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 self target spills data trace mapping pad frame pl sp M dn offset () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨r, hrel, hmap⟩⟩
end skel_semantic

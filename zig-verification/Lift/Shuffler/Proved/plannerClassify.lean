  split at hl
  · rename_i v' hl'
    cases hl
    exact Heap.load_covered hh hl'
  · split at hl
    · rename_i v' hf
      cases hl
      obtain ⟨o, ho, hlb⟩ := List.exists_of_findSome?_eq_some hf
      obtain ⟨k, ha, hk, rfl⟩ := Obj.loadBytes_spec hlb
      intro i hi
      refine ⟨o, ho, ?_⟩
      have hn := hh.noWrap o ho
      have hlt : o.addr.toNat + (k + i) < 2 ^ 64 := by omega
      unfold Obj.Covers
      rw [ha, BitVec.add_assoc, ← BitVec.ofNat_add, toNat_add_ofNat _ _ hlt]
      constructor <;> omega
    · cases hl

/-- A word read is the same in a memory with the same bytes at the address. -/
theorem readRam_congr {policy : CpuPolicy} {m m' : DataMem} {a v : BitVec 64}
    (h : ∀ i, i < 8 → m'.get? (a + BitVec.ofNat 64 i) = m.get? (a + BitVec.ofNat 64 i))
    (hr : readRam policy m a .W64 = .ok v) : readRam policy m' a .W64 = .ok v :=
  SysV.readRam_of_loadInt (Mem.loadInt_congr h) hr

/-- A read outside the room is the same in a memory that is the same outside the room. -/
theorem readRam_of_outside {policy : CpuPolicy} {m m' : DataMem} {sp a v : BitVec 64} {n : Nat}
    (hout : ∀ c, ¬ SysV.Below sp n c → m'.get? c = m.get? c)
    (hav : ∀ i, i < 8 → ¬ SysV.Below sp n (a + BitVec.ofNat 64 i))
    (hr : readRam policy m a .W64 = .ok v) : readRam policy m' a .W64 = .ok v :=
  readRam_congr (fun i hi => hout _ (hav i hi)) hr

/-! ### The callee `plannerHasOtherRetainedCopy` only stores into memory

Its L2 blocks change the memory only by `writeRam`, i.e. by `Mem.storeInt`, so a word that is
mapped stays mapped. -/

namespace plannerHasOtherRetainedCopy

theorem step_goto_mapped {l : Lbl} {x x' : St In2 DataMem} {l' : Lbl}
    (hs : blocks.step l x = .ok (.goto l' x')) {j m : Nat} (hm : SysV.Mapped x.input.sp j m x.mem) :
    x'.input = x.input ∧ SysV.Mapped x.input.sp j m x'.mem := by
  cases l with
  | entry =>
    simp only [blocks] at hs
    split at hs
    · rename_i m1 hw1
      split at hs
      · rename_i m2 hw2
        split at hs
        · rename_i m3 hw3
          split at hs
          · rename_i m4 hw4
            split at hs
            · rename_i m5 hw5
              split at hs
              · rename_i m6 hw6
                split at hs
                · rename_i m7 hw7
                  split at hs
                  · rename_i v hr
                    cases hs
                    rw [SysV.writeRam_ok_eq hw7, SysV.writeRam_ok_eq hw6, SysV.writeRam_ok_eq hw5,
                      SysV.writeRam_ok_eq hw4, SysV.writeRam_ok_eq hw3, SysV.writeRam_ok_eq hw2,
                      SysV.writeRam_ok_eq hw1]
                    exact ⟨rfl, SysV.Mapped.storeInt (SysV.Mapped.storeInt (SysV.Mapped.storeInt
                      (SysV.Mapped.storeInt (SysV.Mapped.storeInt (SysV.Mapped.storeInt
                        (SysV.Mapped.storeInt hm _ _ _) _ _ _) _ _ _) _ _ _) _ _ _) _ _ _) _ _ _⟩
                  · cases hs
                · cases hs
              · cases hs
            · cases hs
          · cases hs
        · cases hs
      · cases hs
    · cases hs
  | LBB22_1 =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs
    all_goals exact ⟨rfl, hm⟩
  | o35 =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs
    all_goals exact ⟨rfl, hm⟩
  | o40 =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs
    all_goals exact ⟨rfl, hm⟩
  | o58 =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs
    all_goals exact ⟨rfl, hm⟩
  | o69 =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs
    all_goals exact ⟨rfl, hm⟩
  | o73 =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs
    all_goals exact ⟨rfl, hm⟩
  | LBB22_6 =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs
    all_goals exact ⟨rfl, hm⟩
  | LBB22_7 =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs
    all_goals exact ⟨rfl, hm⟩


theorem low_byte_r15 (v rbp r13 : UInt64) (s : FlatShuffler.StackSlot) (pad : BitVec 16)
    (h1 : rbp = UInt64.ofBitVec (Layout.slotWord s pad) >>> (32 : UInt64))

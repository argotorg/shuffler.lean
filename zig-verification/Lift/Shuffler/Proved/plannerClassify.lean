theorem returns_mapped {l : Lbl} {x : St In2 DataMem} {r : UInt64 × DataMem}
    (h : blocks.Returns (fun _ => plannerIsRetained.l2.returns) l x r) :
    ∀ (sp : BitVec 64), x.input.sp = sp → ∀ (j m : Nat), SysV.Mapped sp j m x.mem →
      SysV.Mapped sp j m r.2 := by
  induction h with
  | ret hs =>
    intro sp hin j m hm
    exact hin ▸ step_ret_mapped hs (by rw [hin]; exact hm)
  | goto hs _ ih =>
    intro sp hin j m hm
    obtain ⟨e, hm2⟩ := step_goto_mapped hs (by rw [hin]; exact hm)
    rw [hin] at hm2
    exact ih sp (by rw [e, hin]) j m hm2
  | call hs hy _ ih =>
    intro sp hin j m hm
    refine ih sp ?_ j m ?_
    · obtain ⟨e, -⟩ := step_call_mapped hs (by rw [hin]; exact hm) _
      rw [e, hin]
    · obtain ⟨-, hm2⟩ := step_call_mapped hs (by rw [hin]; exact hm) _
      rw [hin] at hm2
      exact hm2

end plannerHasOtherRetainedCopy

/-- The mappedness of the callee's result memory, from its L2 run. -/
theorem plannerHasOtherRetainedCopy.l2_returns_mapped {a : In2} {r : UInt64 × DataMem}
    (h : plannerHasOtherRetainedCopy.l2.returns a r) {j n : Nat}
    (hm : SysV.Mapped a.sp j n a.mem) : SysV.Mapped a.sp j n r.2 :=
  plannerHasOtherRetainedCopy.returns_mapped h a.sp rfl j n hm

/-- The room of the caller after a callee whose own room is the `64` bytes below `sp - 64`
returned: the words above `sp - 64` are outside its room, the others are mapped by `hin`. -/
theorem SysV.RoomAt.after {policy : CpuPolicy} {m m' : DataMem} {sp : BitVec 64}
    (h : SysV.RoomAt policy m sp 128)
    (hout : ∀ c, ¬ SysV.Below (sp - BitVec.ofNat 64 64) 64 c → m'.get? c = m.get? c)
    (hin : SysV.Mapped (sp - BitVec.ofNat 64 64) 8 64 m') : SysV.RoomAt policy m' sp 128 := by
  intro k hk8 hkn hd
  obtain ⟨p1, p2, p3⟩ := h k hk8 hkn hd
  refine ⟨p1, p2, ?_⟩
  rcases Nat.lt_or_ge k 65 with hk | hk
  · rw [Mem.loadInt_congr (fun i hi => hout _ (by unfold SysV.Below; bv_omega))]
    exact p3
  · have h64 : 64 ≤ k := by omega
    obtain ⟨j, hj⟩ := hd
    have hd' : 8 ∣ k - 64 := ⟨j - 8, by omega⟩
    have e : sp - BitVec.ofNat 64 64 - BitVec.ofNat 64 (k - 64) = sp - BitVec.ofNat 64 k := by
      bv_omega
    have h' := hin (k - 64) (by omega) (by omega) hd'
    rwa [e] at h'

/-- A byte of the room of a callee `64` bytes below `sp` is below `sp` (`128` bytes). -/
theorem SysV.Below.sub {sp c : BitVec 64} (h : SysV.Below (sp - BitVec.ofNat 64 64) 64 c) :
    SysV.Below sp 128 c := by
  unfold SysV.Below at h ⊢
  have e : sp - BitVec.ofNat 64 64 - BitVec.ofNat 64 64 = sp - BitVec.ofNat 64 128 := by
    bv_omega
  rw [e] at h
  omega
theorem refines_l2p : Refines SimIn (fun a b r r' => SimOut a b r r') l2p.returns l2.returns := by
  have plannerHasOtherRetainedCopy_refines_l2p : plannerHasOtherRetainedCopy.skel_row_types.refines_l2p :=
    plannerHasOtherRetainedCopy.refines_l2p
  intro a b r hrep h
  have hc0 : Refines (fun x xl => plannerHasOtherRetainedCopy.SimIn x xl)
      (fun x xl y yl => plannerHasOtherRetainedCopy.SimOut x xl y yl ∧ SysV.Mapped xl.sp 8 64 yl.2)
      (CalP.rel .c0) ((Cal.model .c0).returns) := by
    rintro x xl y hx hy
    obtain ⟨yl, hyl, hso⟩ := plannerHasOtherRetainedCopy_refines_l2p x xl y hx hy
    refine ⟨yl, ⟨hyl, fun i hi => hso.2 _ (by unfold SysV.Below; bv_omega)⟩, hso, ?_⟩
    exact plannerHasOtherRetainedCopy.l2_returns_mapped hyl
      (fun k h1 h2 h3 => (hx.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 k h1 h2 h3).2.2)
  have hc1 : Refines (fun x xl => plannerIsDemanded.SimIn x xl)
      (fun x xl y yl => y = yl)
      (CalP.rel .c1) ((Cal.model .c1).returns) :=
    plannerIsDemanded.refines_l2p
  refine Blocks.Returns.simAt (hi := blocksP) (lo := blocks)
    (calleeHi := CalP.rel) (calleeLo := fun c => (Cal.model c).returns)
    (simX := fun c => match c with
      | .c0 => fun x xl => plannerHasOtherRetainedCopy.SimIn x xl
      | .c1 => fun x xl => plannerIsDemanded.SimIn x xl)
    (simY := fun c => match c with
      | .c0 => fun x xl y yl => plannerHasOtherRetainedCopy.SimOut x xl y yl ∧ SysV.Mapped xl.sp 8 64 yl.2
      | .c1 => fun x xl y yl => y = yl)
    (sim := ClsSim b) (simR := fun r r' => SimOut a b r r')
    (callee := fun c => match c with | .c0 => hc0 | .c1 => hc1) ?_ h ?_
  · rintro l x y n hs hstep
    cases l with
    | entry =>
      have hperm := ClsRel.permits hs
      unfold ClsSim ClsRel at hs
      obtain ⟨hr, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, hh, hfr, hcov, hroom, hheap, hstk, hyin⟩ := hs
      simp only [blocksP] at hstep
      split at hstep
      · rename_i v hl0
        split at hstep
        · rename_i v1 hl1
          obtain ⟨m1, hw1, hR1, -, hout1⟩ := SysV.RoomAt.push hroom (k := 8)
            (by decide) (by decide) (by decide) (by decide) (a := y.input.sp - 8) rfl y.rbp.toBitVec
          obtain ⟨m2, hw2, hR2, -, hout2⟩ := SysV.RoomAt.push hR1 (k := 16)
            (by decide) (by decide) (by decide) (by decide) (a := y.input.sp - 16) rfl y.r15.toBitVec
          obtain ⟨m3, hw3, hR3, -, hout3⟩ := SysV.RoomAt.push hR2 (k := 24)
            (by decide) (by decide) (by decide) (by decide) (a := y.input.sp - 24) rfl y.r14.toBitVec
          obtain ⟨m4, hw4, hR4, -, hout4⟩ := SysV.RoomAt.push hR3 (k := 32)
            (by decide) (by decide) (by decide) (by decide) (a := y.input.sp - 32) rfl y.r13.toBitVec
          obtain ⟨m5, hw5, hR5, -, hout5⟩ := SysV.RoomAt.push hR4 (k := 40)
            (by decide) (by decide) (by decide) (by decide) (a := y.input.sp - 40) rfl y.r12.toBitVec
          obtain ⟨m6, hw6, hR6, -, hout6⟩ := SysV.RoomAt.push hR5 (k := 48)
            (by decide) (by decide) (by decide) (by decide) (a := y.input.sp - 48) rfl y.rbx.toBitVec
          obtain ⟨m7, hw7, hR7, -, hout7⟩ := SysV.RoomAt.push hR6 (k := 56)
            (by decide) (by decide) (by decide) (by decide) (a := y.input.sp - 56) rfl y.rax.toBitVec
          have hout : ∀ c, ¬ SysV.Below y.input.sp 128 c → m7.get? c = y.mem.get? c := by
            intro c hc
            rw [hout7 c hc, hout6 c hc, hout5 c hc, hout4 c hc, hout3 c hc, hout2 c hc, hout1 c hc]
          have hr0 := Heap.loadB_sound hh hperm hl0
          rw [h6] at hr0
          have hcv0 : ∀ i, i < 8 → Covered x.mem (y.rdi.toBitVec + BitVec.ofNat 64 i) := by
            intro i hi
            have h := Heap.loadB_covered hh hl0 i hi
            rwa [h6] at h
          have hq0 := readRam_of_outside hout (a := y.rdi.toBitVec) (n := 128)
            (fun i hi hb => hcov _ hb (hcv0 i hi)) hr0
          have hr1 := Heap.loadB_sound hh hperm hl1
          rw [h3] at hr1
          have hcv1 : ∀ i, i < 8 → Covered x.mem ((v + y.rcx.toBitVec * 8) + BitVec.ofNat 64 i) := by
            intro i hi
            have h := Heap.loadB_covered hh hl1 i hi
            rwa [h3] at h
          have hq1 := readRam_of_outside hout (a := v + y.rcx.toBitVec * 8) (n := 128)
            (fun i hi hb => hcov _ hb (hcv1 i hi)) hr1
          have hL2 : blocks.step .entry y = .ok (if (UInt64.ofBitVec v1 >>> (32 : UInt64)).toUInt8.toUInt64 = 3 then
              .goto .LBB19_13 { y with mem := m7, r13 := UInt64.ofBitVec v1, rbp := UInt64.ofBitVec v1 >>> (32 : UInt64), rax := (UInt64.ofBitVec v &&& 18446744073709551360) ||| (255 &&& 255) }
              else .goto .LBB19_1 { y with mem := m7, r13 := UInt64.ofBitVec v1, rbp := UInt64.ofBitVec v1 >>> (32 : UInt64), rax := (UInt64.ofBitVec v &&& 18446744073709551360) ||| (255 &&& 255) }) := by
            simp only [blocks, hw1, hw2, hw3, hw4, hw5, hw6, hw7, hq0, hq1]
          split at hstep
          · rename_i hc
            simp only [Res.ok.injEq] at hstep
            subst hstep
            rw [hL2, if_pos hc]
            refine ⟨_, rfl, hr, rfl, h2, h3, h4, h5, h6, rfl, h8, rfl, h10, h11, ?_, ?_, hcov, hR7, hheap, ?_, hyin⟩
            · exact Heap.Holds.push hh hcov hout
            · intro c hc'
              rw [hout c hc']
              exact hfr c hc'
            · intro u hl
              rw [PrivateStack.load_store64_self] at hl
              cases hl
              rw [SysV.writeRam_ok_eq hw7, h1]
              exact SysV.readRam_storeInt (hroom 56 (by decide) (by decide) (by decide)).2.1
          · rename_i hc
            simp only [Res.ok.injEq] at hstep
            subst hstep
            rw [hL2, if_neg hc]
            refine ⟨_, rfl, hr, rfl, h2, h3, h4, h5, h6, rfl, h8, rfl, h10, h11, ?_, ?_, hcov, hR7, hheap, ?_, hyin⟩
            · exact Heap.Holds.push hh hcov hout
            · intro c hc'
              rw [hout c hc']
              exact hfr c hc'
            · intro u hl
              rw [PrivateStack.load_store64_self] at hl
              cases hl
              rw [SysV.writeRam_ok_eq hw7, h1]
              exact SysV.readRam_storeInt (hroom 56 (by decide) (by decide) (by decide)).2.1
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    | LBB19_13 =>
      unfold ClsSim ClsRel at hs
      obtain ⟨hr, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, hh, hfr, hcov, hroom, hheap, hstk, hyin⟩ := hs
      simp only [blocksP] at hstep
      repeat' split at hstep
      all_goals try cases hstep
      obtain ⟨w1, hq1⟩ := SysV.RoomAt.readRam_ok hroom (a := y.input.sp - 56 + 8) (k := 48)
        (by bv_omega) (by decide) (by decide) (by decide)
      obtain ⟨w2, hq2⟩ := SysV.RoomAt.readRam_ok hroom (a := y.input.sp - 56 + 16) (k := 40)
        (by bv_omega) (by decide) (by decide) (by decide)
      obtain ⟨w3, hq3⟩ := SysV.RoomAt.readRam_ok hroom (a := y.input.sp - 56 + 24) (k := 32)
        (by bv_omega) (by decide) (by decide) (by decide)
      obtain ⟨w4, hq4⟩ := SysV.RoomAt.readRam_ok hroom (a := y.input.sp - 56 + 32) (k := 24)
        (by bv_omega) (by decide) (by decide) (by decide)
      obtain ⟨w5, hq5⟩ := SysV.RoomAt.readRam_ok hroom (a := y.input.sp - 56 + 40) (k := 16)
        (by bv_omega) (by decide) (by decide) (by decide)
      obtain ⟨w6, hq6⟩ := SysV.RoomAt.readRam_ok hroom (a := y.input.sp - 56 + 48) (k := 8)
        (by bv_omega) (by decide) (by decide) (by decide)
      refine ⟨(y.rax, y.mem), ?_, h1, ?_⟩
      · simp only [blocks, hq1, hq2, hq3, hq4, hq5, hq6]
      · intro c hc
        rw [hfr c (by rw [hyin]; exact hc), hyin]
    | LBB19_1 =>
      unfold ClsSim ClsRel at hs
      obtain ⟨hr, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, hh, hfr, hcov, hroom, hheap, hstk, hyin⟩ := hs
      simp only [blocksP] at hstep
      by_cases hc : (((if ¬ (254 ≤ (x.rbp + 18446744073709551613).toUInt8.toUInt64) then 1 else 0) &&& (if ¬ ((x.r13 >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) : UInt64)).toUInt8.toUInt64 = 1
      · rw [if_pos hc] at hstep
        simp only [Res.ok.injEq] at hstep
        subst hstep
        have hst : ∃ y', blocks.step .LBB19_1 y = .ok (.goto .o90 y') := by
          simp only [blocks, ← h7, ← h9]
          rw [if_pos hc]
          exact ⟨_, rfl⟩
        obtain ⟨y', hy'⟩ := hst
        refine ⟨y', hy', ?_⟩

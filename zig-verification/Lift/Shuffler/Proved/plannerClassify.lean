        unfold ClsSim ClsRel
        refine ⟨hr, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hh, hfr, hcov, hroom, hheap, hstk, hyin⟩
        all_goals simp only [h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11]
      · rw [if_neg hc] at hstep
        simp only [Res.ok.injEq] at hstep
        subst hstep
        have hst : ∃ y', blocks.step .LBB19_1 y = .ok (.goto .LBB19_4 y') := by
          simp only [blocks, ← h7, ← h9]
          rw [if_neg hc]
          exact ⟨_, rfl⟩
        obtain ⟨y', hy'⟩ := hst
        refine ⟨y', hy', ?_⟩
        simp only [blocks, ← h7, ← h9] at hy'
        rw [if_neg hc] at hy'
        cases hy'
        unfold ClsSim ClsRel
        refine ⟨hr, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hh, hfr, hcov, hroom, hheap, hstk, hyin⟩
        all_goals simp only [h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11]
    | o90 =>
      unfold ClsSim ClsRel at hs
      obtain ⟨hr, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, hh, hfr, hcov, hroom, hheap, hstk, hyin⟩ := hs
      simp only [blocksP, Res.ok.injEq] at hstep
      subst hstep

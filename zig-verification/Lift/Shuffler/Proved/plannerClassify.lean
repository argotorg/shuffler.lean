/-! ### Helpers for the caller refinement -/

/-- The relation of an L2⁺ state and an L2 state of the caller. -/
def ClsRel (b : In2) (x : StP) (y : St In2 DataMem) : Prop :=
  SimIn x.input y.input ∧
  x.rax = y.rax ∧ x.rbx = y.rbx ∧ x.rcx = y.rcx ∧ x.rdx = y.rdx ∧ x.rsi = y.rsi ∧
  x.rdi = y.rdi ∧ x.rbp = y.rbp ∧ x.r12 = y.r12 ∧ x.r13 = y.r13 ∧ x.r14 = y.r14 ∧
  x.r15 = y.r15 ∧
  x.mem.Holds y.input.policy y.mem ∧
  (∀ c, ¬ SysV.Below y.input.sp 128 c → y.mem.get? c = y.input.mem.get? c) ∧
  (∀ c, SysV.Below y.input.sp 128 c → ¬ Covered x.mem c) ∧
  SysV.RoomAt y.input.policy y.mem y.input.sp 128 ∧
  x.mem = x.input.heap ∧
  (∀ (v : BitVec 64), PrivateStack.load x.stack .W64 (-56) = .ok v →
    readRam y.input.policy y.mem (y.input.sp - 56) .W64 = .ok v) ∧
  y.input = b

/-- The relation at a label (the L2 blocks keep their input, so the same relation holds at each). -/
def ClsSim (b : In2) (l : Lbl) (x : StP) (y : St In2 DataMem) : Prop := ClsRel b x y

theorem ClsRel.permits {b : In2} {x : StP} {y : St In2 DataMem} (h : ClsRel b x y) :
    Heap.Permits y.input.policy x.mem := by
  obtain ⟨hr, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hmem, -, -⟩ := h
  rw [hmem]
  exact hr.2.2.2.2.2.2.2.2.2.2.2.2.1

theorem Nat.toUInt8_toNat (n : Nat) : (n.toUInt8).toNat = n % 256 := by
  simp [Nat.toUInt8, Nat.mod_mod]

/-- The bytes of a stored word, read back at the same offset. -/
theorem PrivateStack.loadBytes_store64_add (st : PrivateStack) (off : Int) (v : BitVec 64)
    (j n : Nat) (h : j + n ≤ 8) :
    PrivateStack.loadBytes (PrivateStack.store st .W64 off v) (off + (j : Int)) n =
      some (Nat.ofBytes (Nat.toBytes n (v.toNat / 256 ^ j))) := by
  induction n generalizing j with
  | zero => rfl
  | succ n ih =>
    have hj8 : j < 8 := by omega
    have hrec : j + 1 + n ≤ 8 := by omega
    have hst : PrivateStack.store st .W64 off v (off + (j : Int)) =
        some (BitVec.ofNat 8 (v.toNat / 2 ^ (8 * j))) := by
      have h1 : 0 ≤ off + (j : Int) - off := by omega
      have h2 : off + (j : Int) - off < (8 : Int) := by omega
      have h3 : (off + (j : Int) - off).toNat = j := by omega
      simp only [PrivateStack.store, Width.bytes, h3]
      rw [ite_eq_left ⟨h1, h2⟩]
    simp only [PrivateStack.loadBytes]
    rw [hst]
    rw [show off + (j : Int) + 1 = off + ((j + 1 : Nat) : Int) by omega]
    rw [ih (j + 1) hrec]
    have hb : (BitVec.ofNat 8 (v.toNat / 2 ^ (8 * j))).toNat = (v.toNat / 256 ^ j) % 256 := by
      rw [BitVec.toNat_ofNat, show (2 : Nat) ^ 8 = 256 from rfl]
      congr 1
      rw [show (256 : Nat) ^ j = 2 ^ (8 * j) by
        rw [show (256 : Nat) = 2 ^ 8 by decide, ← Nat.pow_mul]]
    have hd : (v.toNat / 256 ^ j) / 256 = v.toNat / 256 ^ (j + 1) := by
      rw [Nat.div_div_eq_div_mul, ← Nat.pow_succ]
    show some ((BitVec.ofNat 8 (v.toNat / 2 ^ (8 * j))).toNat + 256 * Nat.ofBytes (Nat.toBytes n (v.toNat / 256 ^ (j + 1)))) =
      some (Nat.ofBytes (Nat.toBytes (n + 1) (v.toNat / 256 ^ j)))
    rw [hb]
    simp only [Nat.toBytes, Nat.ofBytes_cons, Nat.take, Nat.toUInt8_toNat,
      show (2 : Nat) ^ 8 = 256 from rfl, Nat.mod_mod]
    rw [hd]
    congr 1
    rw [Nat.mul_comm]
    omega

/-- A stored word reads back at the same offset. -/
theorem PrivateStack.load_store64_self (st : PrivateStack) (off : Int) (v : BitVec 64) :
    PrivateStack.load (PrivateStack.store st .W64 off v) .W64 off = .ok v := by
  have e : PrivateStack.loadBytes (PrivateStack.store st .W64 off v) off 8 = some v.toNat := by
    have h := PrivateStack.loadBytes_store64_add st off v 0 8 (by omega)
    have h0 : off + ((0 : Nat) : Int) = off := by simp
    rw [h0] at h
    rw [h, Nat.pow_zero, Nat.div_one, Nat.ofBytes_toBytes, Nat.take,
      show 8 * 8 = 64 from rfl, Nat.mod_eq_of_lt v.isLt]
  simp only [PrivateStack.load, Width.bytes, e]
  congr 1
  apply BitVec.eq_of_toNat_eq
  simp

/-- A load at bytes that a store does not meet is unchanged. -/
theorem PrivateStack.loadBytes_store64_ne (st : PrivateStack) (off : Int) (v : BitVec 64)
    (off' : Int) (n : Nat)
    (h : ∀ i : Nat, i < n → ¬ (0 ≤ off' + (i : Int) - off ∧ off' + (i : Int) - off < (8 : Int))) :
    PrivateStack.loadBytes (PrivateStack.store st .W64 off v) off' n =
      PrivateStack.loadBytes st off' n := by
  induction n generalizing off' with
  | zero => rfl
  | succ n ih =>
    have h0 : PrivateStack.store st .W64 off v off' = st off' := by
      have hc := h 0 (by omega)
      simp only [PrivateStack.store, Width.bytes]
      rw [ite_eq_right (by simpa using hc)]
    simp only [PrivateStack.loadBytes]
    rw [h0]
    rw [ih (off' + 1) (fun i hi => by
      have hi' := h (i + 1) (by omega)
      have e : off' + 1 + (i : Int) = off' + ((i + 1 : Nat) : Int) := by omega
      rwa [e])]

/-- A load of a word at an offset that a store does not meet is unchanged. -/
theorem PrivateStack.load_store64_ne (st : PrivateStack) (off off' : Int) (v : BitVec 64)
    (h : off' + 8 ≤ off ∨ off + 8 ≤ off') :
    PrivateStack.load (PrivateStack.store st .W64 off v) .W64 off' =
      PrivateStack.load st .W64 off' := by
  have e : PrivateStack.loadBytes (PrivateStack.store st .W64 off v) off' 8 =
      PrivateStack.loadBytes st off' 8 :=
    PrivateStack.loadBytes_store64_ne st off v off' 8 (fun i hi => by
      rintro ⟨h1, h2⟩
      rcases h with h | h <;> omega)
  simp only [PrivateStack.load, Width.bytes, e]

/-- The bytes a heap load reads are covered by the heap. -/
theorem Heap.load_covered {policy : CpuPolicy} {h : Heap} {m : DataMem} {a : BitVec 64}
    {w : Width} {v : w.type} (hh : h.Holds policy m) (hl : h.load a w = .ok v) :
    ∀ i, i < w.bytes → Covered h (a + BitVec.ofNat 64 i) := by
  unfold Heap.load at hl
  split at hl
  · rename_i v' hf
    obtain ⟨o, ho, hg⟩ := List.exists_of_findSome?_eq_some hf
    obtain ⟨x, hx, hax, hxc⟩ := Obj.get_some hg
    intro i hi
    refine ⟨o, ho, ?_⟩
    have hn := hh.noWrap o ho
    obtain ⟨e, hb⟩ := Obj.toNat_cell hn hx
    rw [hxc] at hb
    have hb' : x.fst + w.bytes ≤ o.size := by simpa using hb
    have hlt : o.addr.toNat + (x.fst + i) < 2 ^ 64 := by omega
    unfold Obj.Covers
    rw [← hax, BitVec.add_assoc, ← BitVec.ofNat_add, toNat_add_ofNat _ _ hlt]
    constructor <;> omega
  · cases hl

/-- A permitted read of a mapped word succeeds. -/
theorem readRam_isOk {policy : CpuPolicy} {m : DataMem} {a : BitVec 64} {w : Width}
    (hp : policy.permits (.read a w) = true) (hm : Mem.loadInt m a w.bytes ≠ none) :
    ∃ v, readRam policy m a w = .ok v := by
  simp only [readRam, hp, ↓reduceIte]
  cases hl : Mem.loadInt m a w.bytes with
  | none => exact absurd hl hm
  | some value => exact ⟨_, rfl⟩

/-- A word of the room reads as some value. -/
theorem SysV.RoomAt.readRam_ok {policy : CpuPolicy} {m : DataMem} {sp a : BitVec 64} {n k : Nat}
    (h : SysV.RoomAt policy m sp n) (ha : a = sp - BitVec.ofNat 64 k) (hk8 : 8 ≤ k) (hkn : k ≤ n)
    (hd : 8 ∣ k) : ∃ v, readRam policy m a .W64 = .ok v := by
  subst ha
  exact readRam_isOk (h k hk8 hkn hd).2.1 (h k hk8 hkn hd).2.2

/-- The bytes that `loadB` reads are covered by the heap. -/
theorem Heap.loadB_covered {policy : CpuPolicy} {h : Heap} {m : DataMem} {a : BitVec 64}
    {w : Width} {v : w.type} (hh : h.Holds policy m) (hl : h.loadB a w = .ok v) :
    ∀ i, i < w.bytes → Covered h (a + BitVec.ofNat 64 i) := by

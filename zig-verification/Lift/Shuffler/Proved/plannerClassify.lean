theorem isVariable_of_not_cfg (s : FlatShuffler.StackSlot)
    (h : FlatShuffler.canBeFreelyGenerated s = false) :
    FlatShuffler.Flat.isVariable s = (s.kind == FlatShuffler.Value) := by
  have h1 : FlatShuffler.isLiteralValue s = false := by
    simp only [FlatShuffler.canBeFreelyGenerated, Bool.or_eq_false_iff] at h
    exact h.1.1
  simp only [FlatShuffler.Flat.isVariable, h1, Bool.not_false, Bool.and_true]


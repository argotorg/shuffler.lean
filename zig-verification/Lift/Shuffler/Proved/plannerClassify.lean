theorem bridge_step_eq (l : Lbl) (z : skel_call.StP) :
    blocksP.step l (bridgeState z) = bridgeRes (skel_call.blocksP.step l z) := by
  cases l with
  | entry => exact bridge_step_eq_entry z
  | LBB19_13 => exact bridge_step_eq_LBB19_13 z
  | LBB19_1 => exact bridge_step_eq_LBB19_1 z
  | o90 => exact bridge_step_eq_o90 z
  | LBB19_14 => exact bridge_step_eq_LBB19_14 z
  | o113 => exact bridge_step_eq_o113 z
  | LBB19_3 => exact bridge_step_eq_LBB19_3 z
  | LBB19_4 => exact bridge_step_eq_LBB19_4 z
  | o164 => exact bridge_step_eq_o164 z
  | o168 => exact bridge_step_eq_o168 z
  | LBB19_8 => exact bridge_step_eq_LBB19_8 z
  | o186 => exact bridge_step_eq_o186 z
  | LBB19_7 => exact bridge_step_eq_LBB19_7 z
  | o203 => exact bridge_step_eq_o203 z
  | LBB19_9 => exact bridge_step_eq_LBB19_9 z
  | LBB19_11 => exact bridge_step_eq_LBB19_11 z
  | o237 => exact bridge_step_eq_o237 z

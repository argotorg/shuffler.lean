/-! ## The conditions of `classify`, in bit form -/

theorem kind_three (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    ((UInt64.ofBitVec (Layout.slotWord s pad) >>> (32 : UInt64)).toUInt8.toUInt64 = 3) ↔ s.kind = 3 := by
  obtain ⟨p, k, o⟩ := s
  simp only [Layout.slotWord, Lift.Shuffler.Zig.Slot.join, Lift.Pilot.Slot.word]
  bv_decide

theorem kind_zero (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    ((UInt64.ofBitVec (Layout.slotWord s pad) >>> (32 : UInt64)).toUInt8.toUInt64 = 0) ↔ s.kind = 0 := by
  obtain ⟨p, k, o⟩ := s
  simp only [Layout.slotWord, Lift.Shuffler.Zig.Slot.join, Lift.Pilot.Slot.word]
  bv_decide

theorem cond_cfg (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    ((((if ¬ (254 ≤ ((UInt64.ofBitVec (Layout.slotWord s pad) >>> (32 : UInt64)) + 18446744073709551613).toUInt8.toUInt64) then 1 else 0) &&& (if ¬ ((UInt64.ofBitVec (Layout.slotWord s pad) >>> (40 : UInt64)).toUInt8.toUInt64 = 0) then 1 else 0) : UInt64)).toUInt8.toUInt64 = 1)
      ↔ FlatShuffler.canBeFreelyGenerated s = false := by
  obtain ⟨p, k, o⟩ := s
  simp only [Layout.slotWord, Lift.Shuffler.Zig.Slot.join, Lift.Pilot.Slot.word,
    FlatShuffler.canBeFreelyGenerated, FlatShuffler.isLiteralValue, FlatShuffler.Const,
    FlatShuffler.Junk, FlatShuffler.FunctionCallReturnLabel]
  bv_decide

theorem payload_ext (s : FlatShuffler.StackSlot) (pad : BitVec 16) :
    BitVec.zeroExtend 64 (BitVec.truncate 32 (Layout.slotWord s pad)) = s.payload.setWidth 64 := by

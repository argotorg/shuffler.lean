    (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hs : SimArr self target spills data trace mapping pad frame pl sp M dn offset a) :
    Obj.words mapping false .W64 M.dest.toList ∈ a.heap := by
  obtain ⟨-, -, -, -, -, hheap, -, -, -⟩ := hs
  rw [hheap]
  simp [objsP, Lift.Shuffler.Internal.Proposed.ClassifyStatement.objects,
    Lift.Shuffler.Internal.Proposed.ClassifyStatement.envOf, toObj, toCell, Layout.word,
    Function.comp_def, List.map_map, Obj.words]
/-- The state of the code at the labels `.LBB19_4`, `.LBB19_9` and `.LBB19_11`. -/
structure At4 (pl : FlatShuffler.Flat.Planner) (sp : BitVec 32 → BitVec 8) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (heap : Heap) (self mapping trace : BitVec 64) (pad : BitVec 64) (x : StP) : Prop where
  mem : x.mem = heap
  rbx : x.rbx = UInt64.ofBitVec self
  r12 : x.r12 = UInt64.ofBitVec mapping
  r14 : x.r14 = UInt64.ofBitVec offset
  rdx : x.rdx.toBitVec = trace
  r13 : x.r13 = UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.source offset) (pad.setWidth 16))
  rbp : x.rbp = UInt64.ofBitVec (Layout.slotWord (FlatShuffler.Flat.get pl.source offset) (pad.setWidth 16)) >>> (32 : UInt64)
  stk : Saved x.stack


theorem step_call_mapped {l : Lbl} {x : St In2 DataMem} {a : plannerIsRetained.In2}
    {k : UInt64 → Lbl × St In2 DataMem}
    (hs : blocks.step l x = .ok (.call () a k)) {j m : Nat}
    (hm : SysV.Mapped x.input.sp j m x.mem) :
    ∀ y : UInt64, (k y).2.input = x.input ∧ SysV.Mapped x.input.sp j m (k y).2.mem := by
  cases l with
  | o58 =>
    simp only [blocks] at hs
    split at hs
    · rename_i m1 hw1
      cases hs
      intro y
      refine ⟨rfl, ?_⟩
      rw [SysV.writeRam_ok_eq hw1]
      exact SysV.Mapped.storeInt hm _ _ _
    · cases hs
  | entry =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs
  | LBB22_1 =>
    simp only [blocks] at hs
    repeat' split at hs
    all_goals try cases hs

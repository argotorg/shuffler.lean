  Heap.loadB_word_addr hh (mem_objs_tracePtr self data trace mapping frame st pos trace0)

/-- A load of the trace size word of the statement. -/
theorem loadB_traceSize (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP self data trace mapping st pos trace0 ++ frame) m) :
    (objsP self data trace mapping st pos trace0 ++ frame).loadB (self + 64) .W64 =
      .ok (BitVec.ofNat 64 st.trace.length) :=
  Heap.loadB_word_addr hh (mem_objs_traceSize self data trace mapping frame st pos trace0)

/-- A load of the maximum swap depth word of the statement. -/
theorem loadB_maxSwapDepth (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP self data trace mapping st pos trace0 ++ frame) m) :
    (objsP self data trace mapping st pos trace0 ++ frame).loadB (self + 24) .W64 = .ok st.maxSwapDepth :=
  Heap.loadB_word_addr hh (mem_objs_maxSwapDepth self data trace mapping frame st pos trace0)

/-- A load of a destination word of the statement. -/
theorem loadB_dest (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (pol : CpuPolicy) (m : DataMem) (i : BitVec 64) (hi : i.toNat < FlatShuffler.maxStackSize)
    (hh : Heap.Holds pol (objsP self data trace mapping st pos trace0 ++ frame) m) :
    (objsP self data trace mapping st pos trace0 ++ frame).loadB (mapping + i * 8) .W64 =
      .ok (st.dest.toList.getD i.toNat default) := by
  have h1 := Heap.loadB_words64 hh (mem_objs_dest self data trace mapping frame st pos trace0)
    (i := i) (by simpa using hi)
  have hlen : i.toNat < st.dest.toList.length := by simpa using hi
  have h2 : st.dest.toList.getD i.toNat default = st.dest.toList[i.toNat] := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlen]
    rfl
  rw [h2]
  exact h1

/-- A load of a position word of the statement. -/
theorem loadB_pos (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (pol : CpuPolicy) (m : DataMem) (i : BitVec 64) (hi : i.toNat < FlatShuffler.maxStackSize)
    (hh : Heap.Holds pol (objsP self data trace mapping st pos trace0 ++ frame) m) :
    (objsP self data trace mapping st pos trace0 ++ frame).loadB (mapping + 8192 + i * 8) .W64 =
      .ok (st.pos.toList.getD i.toNat default) := by
  have h1 := Heap.loadB_words64 (base := mapping + 8192) hh
    (mem_objs_pos self data trace mapping frame st pos trace0) (i := i) (by simpa using hi)
  have hlen : i.toNat < st.pos.toList.length := by simpa using hi
  have h2 : st.pos.toList.getD i.toNat default = st.pos.toList[i.toNat] := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlen]
    rfl
  rw [h2]
  exact h1

/-- At an exit that leaves the state unchanged, the written objects are the objects of the statement. -/
theorem written_exit (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    Lift.Shuffler.Internal.Proposed.SwapWithStatement.written st pos trace0
        (Lift.Shuffler.Internal.Proposed.SwapWithStatement.envOf self data trace mapping)
        (Lift.Shuffler.Zig.Exit.assertionExit, st) =
      (Lift.Shuffler.Internal.Proposed.SwapWithStatement.objects st pos trace0
        (Lift.Shuffler.Internal.Proposed.SwapWithStatement.envOf self data trace mapping)).take 5 := by
  have htf : (Vector.ofFn fun i : Fin 10240 =>
      if st.trace.length ≤ i.val ∧ i.val < st.trace.length then
        ((st.trace.getD i.val { op := { kind := 0, depth := 0, slot := default }, pad := 0 }).op.kind,
         (st.trace.getD i.val { op := { kind := 0, depth := 0, slot := default }, pad := 0 }).op.depth,
         trace0[i].snd.snd.fst,
         Lift.Shuffler.Internal.Proposed.Layout.slotWord
           (st.trace.getD i.val { op := { kind := 0, depth := 0, slot := default }, pad := 0 }).op.slot
           (st.trace.getD i.val { op := { kind := 0, depth := 0, slot := default }, pad := 0 }).pad)
      else trace0[i]) = trace0 := by
    apply Vector.ext
    intro i hi
    rw [Vector.getElem_ofFn]
    rw [if_neg (by omega)]
    rfl
  simp only [Lift.Shuffler.Internal.Proposed.SwapWithStatement.written,
    Lift.Shuffler.Internal.Proposed.SwapWithStatement.objects, htf, List.take]

set_option maxRecDepth 4000 in
/-- The postcondition at an exit that leaves the state unchanged: the result field is `1` and the written
objects are the objects of the statement. -/
theorem post_exit (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (pol : CpuPolicy) (m : DataMem)
    (hex : Lift.Shuffler.Zig.swapWith st pos = (Lift.Shuffler.Zig.Exit.assertionExit, st))
    (hh : Heap.Holds pol (objsP self data trace mapping st pos trace0 ++ frame) m) :
    Lift.Shuffler.Internal.Proposed.SwapWithStatement.post st pos trace0
      (Lift.Shuffler.Internal.Proposed.SwapWithStatement.envOf self data trace mapping) pol
      ⟨.W16, 1⟩ m := by
  refine ⟨(Lift.Shuffler.Zig.Exit.assertionExit, st), ?_, rfl, ?_⟩
  · simp [Lift.Shuffler.Internal.Proposed.SwapWithStatement.run, hex]
  · intro o ho
    rw [written_exit] at ho
    have hL : Heap.Holds pol
        ((Lift.Shuffler.Internal.Proposed.SwapWithStatement.objects st pos trace0
          (Lift.Shuffler.Internal.Proposed.SwapWithStatement.envOf self data trace mapping)).map
          Lift.Sem.Bridge.toObj) m :=
      Heap.holds_append_left hh
    exact ((Lift.Sem.Bridge.holds_iff pol _ m).mp hL).1 o
      (List.Sublist.subset (List.take_sublist ..) ho)

/-- The postcondition of `refines_l3` for the result `r`. -/
abbrev Qrel (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (a : In2p) (y : Lift.Shuffler.Zig.Outcome FlatShuffler.Flat.Status) (r : UInt64 × Heap) : Prop :=
  Lift.Trusted.Encode.encode (Lift.Shuffler.Internal.Proposed.SwapWithStatement.result st pos trace0 y) =
      [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧
    a.heap = objsP self data trace mapping st pos trace0 ++ frame ∧
    ∀ m, r.2.Holds a.policy m →
      Lift.Shuffler.Internal.Proposed.SwapWithStatement.post st pos trace0
        (Lift.Shuffler.Internal.Proposed.SwapWithStatement.envOf self data trace mapping) a.policy
        ⟨.W16, r.1.toBitVec.setWidth 16⟩ m

/-- `swapWith` at the `done` branch. -/
theorem swapWith_done (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word)
    (hlt : pos < st.size) (hfin : Lift.Shuffler.Zig.isFinal st pos = false)
    (hdepth : 1 ≤ Lift.Shuffler.Zig.depthOf st pos ∧
      Lift.Shuffler.Zig.depthOf st pos ≤ st.maxSwapDepth)
    (htr : st.trace.length < Lift.Shuffler.Zig.maxTraceSize) :
    Lift.Shuffler.Zig.swapWith st pos =
      (Lift.Shuffler.Zig.Exit.done,
        Lift.Shuffler.Zig.swapDestinations (Lift.Shuffler.Zig.stackSwap st pos).2 pos
          ((Lift.Shuffler.Zig.stackSwap st pos).2.size - 1)) := by
  have hrec : (Lift.Shuffler.Zig.stackSwap st pos).1 = Lift.Shuffler.Zig.Exit.done := by
    simp only [Lift.Shuffler.Zig.stackSwap, Lift.Shuffler.Zig.record, htr, if_true]
  simp only [Lift.Shuffler.Zig.swapWith, hlt, hfin, hdepth, hrec, ne_eq, eq_self_iff_true,
    not_true, true_and, Bool.false_eq_true, reduceIte]

/-- The result field at the `done` exit. -/
theorem encode_result_done (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (s : Lift.Shuffler.Zig.St) :
    Lift.Trusted.Encode.encode
        (Lift.Shuffler.Internal.Proposed.SwapWithStatement.result st pos trace0
          (Lift.Shuffler.Zig.Exit.done, s)) = [⟨.W16, 0⟩] := by
  simp only [Lift.Shuffler.Internal.Proposed.SwapWithStatement.result, Lift.Shuffler.Zig.Exit.done,
    reduceIte, Lift.Trusted.Encode.encode]

/-- The result field at an assertion exit. -/
theorem encode_result_assertion (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (s : Lift.Shuffler.Zig.St) :
    Lift.Trusted.Encode.encode
        (Lift.Shuffler.Internal.Proposed.SwapWithStatement.result st pos trace0
          (Lift.Shuffler.Zig.Exit.assertionExit, s)) = [⟨.W16, 1⟩] := by
  simp only [Lift.Shuffler.Internal.Proposed.SwapWithStatement.result, Lift.Shuffler.Zig.Exit.done,
    Lift.Shuffler.Zig.Exit.assertionExit, reduceCtorEq, reduceIte, Lift.Trusted.Encode.encode]


def traceAfter {n : Nat} (T : Vector Entry n) (old current : List Zig.OpP) : Vector Entry n :=
  Vector.ofFn fun i =>
    let t := T[i]
    if old.length ≤ i.val ∧ i.val < current.length then
      let op := current.getD i.val ⟨⟨0, 0, default⟩, 0⟩
      (op.op.kind, op.op.depth, t.2.2.1, Internal.Proposed.Layout.slotWord op.op.slot op.pad)
    else t

theorem traceAfter_append {n : Nat} (T : Vector Entry n) (old : List Zig.OpP)
    (op : Zig.OpP) (h : old.length < n) :
    traceAfter T old (old ++ [op]) = T.set old.length
      (op.op.kind, op.op.depth, T[old.length].2.2.1,
        Internal.Proposed.Layout.slotWord op.op.slot op.pad) := by
  array_update [traceAfter]

theorem done_out (self data trace mapping : BitVec 64) (frame : Heap) (st out : Zig.St)
    (pos : BitVec 64) (T T' : Vector Entry 10240) (a : In2p) (y : Zig.Outcome FlatShuffler.Flat.Status)
    (hy : Internal.Proposed.SwapWithStatement.run st pos = some y)
    (hheap : a.heap = objsP self data trace mapping st pos T ++ frame)
    (hex : Zig.swapWith st pos = (Zig.Exit.done, out))
    (heq : traceAfter T st.trace out.trace = T') :
    Qrel self data trace mapping frame st pos T a y
      (0, objsP self data trace mapping out pos T' ++ frame) := by
  have hy' : y = (Zig.Exit.done, out) := by
    simpa only [Internal.Proposed.SwapWithStatement.run, hex, Option.some.injEq] using hy.symm
  subst y
  refine ⟨rfl, hheap, ?_⟩
  intro m hm
  refine ⟨(Zig.Exit.done, out), ?_, rfl, ?_⟩
  · simp only [Internal.Proposed.SwapWithStatement.run, hex]
  · intro o ho
    simp only [Internal.Proposed.SwapWithStatement.written] at ho
    unfold traceAfter at heq
    rw [heq] at ho
    have hin : o ∈ Internal.Proposed.SwapWithStatement.objects out pos T'
        (Internal.Proposed.SwapWithStatement.envOf self data trace mapping) := by
      simp only [Internal.Proposed.SwapWithStatement.objects, List.mem_cons,
        List.not_mem_nil, or_false] at ho ⊢
      rcases ho with rfl | rfl | rfl | rfl | rfl <;> simp
    exact Bridge.has_of_holds_mem hm (List.mem_append_left frame
      (List.mem_map.mpr ⟨o, hin, rfl⟩))

theorem finish (self data trace mapping : BitVec 64) (frame : Heap) (st out : Zig.St)
    (pos : BitVec 64) (T T' : Vector Entry 10240) (a : In2p) (y : Zig.Outcome FlatShuffler.Flat.Status)
    (hy : Internal.Proposed.SwapWithStatement.run st pos = some y)
    (hheap : a.heap = objsP self data trace mapping st pos T ++ frame)
    (hex : Zig.swapWith st pos = (Zig.Exit.done, out))
    (heq : traceAfter T st.trace out.trace = T')
    (head : Lbl) (x : St In2p Heap)
    (hmem : x.mem = objsP self data trace mapping out pos T' ++ frame) :
    Visits blocksP head (fun _ => False) (Qrel self data trace mapping frame st pos T a y)
      .LBB9_8 x := by
  refine .goto (by rfl) (.ret (by rfl) ?_)
  change Qrel self data trace mapping frame st pos T a y (0, x.mem)
  rw [hmem]
  exact done_out self data trace mapping frame st out pos T T' a y hy hheap hex heq


    rw [SwapRepair.dw_read st pos hsmall] at hs
    exact hs
  have topRead : H0.loadB (data + st.size * 8 + 18446744073709551608) .W64 = .ok topWord := by
    rw [htopAddress]
    have hs := SwapRepair.load_data (st.size - 1).toNat

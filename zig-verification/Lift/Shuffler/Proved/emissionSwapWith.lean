/-- A load that gives `v` gives `v` in `loadB`. -/
theorem Heap.loadB_eq_of_load {h : Heap} {a : BitVec 64} {w : Width} {v : w.type}
    (h1 : h.load a w = .ok v) : h.loadB a w = .ok v := by
  simp only [Heap.loadB, h1]

/-- A load of each cell of each object of a heap that the memory holds, in `loadB`. -/
theorem Heap.loadB_of_mem {policy : CpuPolicy} {h : Heap} {m : DataMem} {o : Obj}
    {x : Nat × Cell} (hh : h.Holds policy m) (ho : o ∈ h) (hx : x ∈ offsets 0 o.cells) :
    h.loadB (o.addr + BitVec.ofNat 64 x.1) x.2.w = .ok x.2.v :=
  Heap.loadB_eq_of_load (Heap.load_of_mem hh ho hx)

/-- A `loadB` of the word at index `i` of an array of words of the heap. -/
theorem Heap.loadB_words64 {policy : CpuPolicy} {h : Heap} {m : DataMem} {base : BitVec 64}
    {wr : Bool} {xs : List (BitVec 64)} {i : BitVec 64} (hh : h.Holds policy m)
    (ho : Obj.words base wr .W64 xs ∈ h) (hi : i.toNat < xs.length) :
    h.loadB (base + i * 8) .W64 = .ok xs[i.toNat] :=
  Heap.loadB_eq_of_load (Heap.load_words64_mul hh ho hi)

/-- A `loadB` of the single word of an object of one word at `base`. -/
theorem Heap.loadB_word {policy : CpuPolicy} {h : Heap} {m : DataMem} {base : BitVec 64}
    {wr : Bool} {v : BitVec 64} (hh : h.Holds policy m) (ho : Obj.words base wr .W64 [v] ∈ h) :
    h.loadB base .W64 = .ok v := by
  have h1 := Heap.loadB_words64 (i := 0) hh ho (by simp)
  simpa using h1

/-- A `loadB` of the single word of an object of one word, at any address. -/
theorem Heap.loadB_word_addr {policy : CpuPolicy} {h : Heap} {m : DataMem} {addr : BitVec 64}
    {wr : Bool} {v : BitVec 64} (hh : h.Holds policy m) (ho : Obj.words addr wr .W64 [v] ∈ h) :
    h.loadB addr .W64 = .ok v :=
  Heap.loadB_word hh ho

/-- The left part of a heap that the memory holds is held. -/
theorem Heap.holds_append_left {policy : CpuPolicy} {h₁ h₂ : Heap} {m : DataMem}
    (hh : Heap.Holds policy (h₁ ++ h₂) m) : Heap.Holds policy h₁ m :=
  ⟨fun o ho x hx => hh.read o (List.mem_append_left _ ho) x hx,
   fun o ho hw x hx => hh.write o (List.mem_append_left _ ho) hw x hx,
   fun o ho => hh.noWrap o (List.mem_append_left _ ho),
   (List.pairwise_append.mp hh.apart).1⟩

/-- `Mem.has` of each object of a heap that the memory holds, with a frame. -/
theorem has_of_holds_append {policy : CpuPolicy} {objs : List Lift.Trusted.Object} {frame : Heap}
    {m : DataMem} (hh : Heap.Holds policy (objs.map Lift.Sem.Bridge.toObj ++ frame) m) :
    ∀ o ∈ objs, Lift.Trusted.Mem.has policy m o := by
  have h1 := Heap.holds_append_left hh
  exact fun o ho => ((Lift.Sem.Bridge.holds_iff policy objs m).mp h1).1 o ho

/-- The value of a `loadB` of the single word of an object of one word. -/
theorem loadB_word_eq {policy : CpuPolicy} {h : Heap} {m : DataMem} {addr : BitVec 64} {wr : Bool}
    {v w : BitVec 64} (hh : h.Holds policy m) (ho : Obj.words addr wr .W64 [w] ∈ h)
    (hv : h.loadB addr .W64 = .ok v) : v = w := by
  rw [Heap.loadB_word_addr hh ho] at hv
  exact (Lift.Sem.Res.ok.injEq .. ▸ hv).symm

/-- The value of a `loadB` of the word at index `i` of an array of words. -/
theorem loadB_words64_eq {policy : CpuPolicy} {h : Heap} {m : DataMem} {base : BitVec 64} {wr : Bool}
    {xs : List (BitVec 64)} {i : BitVec 64} {v : BitVec 64} (hh : h.Holds policy m)
    (ho : Obj.words base wr .W64 xs ∈ h) (hi : i.toNat < xs.length)
    (hv : h.loadB (base + i * 8) .W64 = .ok v) : v = xs[i.toNat] := by
  rw [Heap.loadB_words64 hh ho hi] at hv
  exact (Lift.Sem.Res.ok.injEq .. ▸ hv).symm

/-- The trace of the statement does not change when the trace length is the same. -/
theorem Vector.ofFn_ite_of_empty {α : Type} {n : Nat} (v : Vector α n) (t : Nat) (f : Nat → α) :
    Vector.ofFn (fun i => if t ≤ i.val ∧ i.val < t then f i.val else v[i]) = v := by
  have h : (fun i : Fin n => if t ≤ i.val ∧ i.val < t then f i.val else v[i]) = (fun i => v[i]) := by
    funext i
    rw [if_neg (by omega)]
  rw [h]
  simp


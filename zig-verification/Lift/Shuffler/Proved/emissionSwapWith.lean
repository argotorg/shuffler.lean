    (a : In2p) (y : Lift.Shuffler.Zig.Outcome FlatShuffler.Flat.Status)
    (hy : Lift.Shuffler.Internal.Proposed.SwapWithStatement.run st pos = some y)
    (hheap : a.heap = objsP self data trace mapping st pos trace0 ++ frame)
    {w : DataMem} (hw : Heap.Holds a.policy a.heap w)
    (hrdi : a.rdi.toBitVec =
      (Lift.Shuffler.Internal.Proposed.SwapWithStatement.envOf self data trace mapping).self)
    (hrsi : a.rsi.toBitVec = pos)
    (hC1 : st.size.toNat ≤ FlatShuffler.maxStackSize)
    (hC2 : st.trace.length ≤ Lift.Shuffler.Zig.maxTraceSize)
    (hC3 : (st.dest.toList.take st.size.toNat).all
      (fun v => decide (v = FlatShuffler.Flat.NONE ∨ v < FlatShuffler.maxStackSize)) = true)
    (hC4 : (st.trace.zipIdx.all (fun (op, i) =>
      let t := trace0.toList.getD i default
      t.1 == op.op.kind && t.2.1 == op.op.depth &&
        t.2.2.2 == Lift.Shuffler.Internal.Proposed.Layout.slotWord op.op.slot op.pad)) = true)
    {v1 v2 v3 v4 : BitVec 64}

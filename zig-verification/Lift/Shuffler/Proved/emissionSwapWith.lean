  have hrsiCode : a.rsi = UInt64.ofBitVec pos := congrArg UInt64.ofBitVec hrsi
  have hh : Heap.Holds a.policy (objsP self data trace mapping st pos trace0 ++ frame) w := hheap ▸ hw
  have hsizeRead := loadB_size self data trace mapping frame st pos trace0 a.policy w hh

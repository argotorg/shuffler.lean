/-! ### Helpers for the frame row of the call summary -/

/-- A store to an address that an object does not cover leaves the object unchanged. -/
theorem obj_set_eq_self {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (hn : o.addr.toNat + o.size ≤ 2 ^ 64) (hc : ¬ o.Covers a) : o.set a w v = o := by
  unfold Obj.set
  by_cases hw : o.writable = true
  · rw [if_pos hw]
    have hcs : setCells o.addr a w v 0 o.cells = o.cells := by
      apply setCells_of_no_match
      rintro x hx ⟨e, -⟩
      have ht := Obj.toNat_cell hn hx
      have hwb := width_bytes_pos x.2.w
      have ht2 : a.toNat = o.addr.toNat + x.fst := by rw [← e]; exact ht.1
      refine hc ⟨by omega, by omega⟩
    rw [hcs]
  · rw [if_neg hw]

/-- A byte store to an object that does not span the access leaves it unchanged. -/
theorem obj_setBytes_eq_self {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (h : ¬ (o.writable = true ∧ o.Spans a w)) : o.setBytes a w v = o := by
  unfold Obj.setBytes
  rw [if_neg h]

/-- An access inside an object covers its first byte. -/
theorem covers_of_spans {o : Obj} {a : BitVec 64} {w : Width} (h : o.Spans a w) :
    o.Covers a := by
  unfold Obj.Spans at h
  unfold Obj.Covers
  exact ⟨h.1, by have := width_bytes_pos w; omega⟩

/-- Two apart objects do not cover the same byte. -/
theorem not_covers_of_apart {o o' : Obj} {a : BitVec 64} (hap : o'.Apart o) (hc : o'.Covers a) :
    ¬ o.Covers a := by
  intro h
  unfold Obj.Apart at hap
  unfold Obj.Covers at hc h
  omega

/-- A load of the left part of a heap. -/
theorem load_append_left {p F : Heap} {a : BitVec 64} {w : Width} {v : w.type}
    (h : p.load a w = .ok v) : (p ++ F).load a w = .ok v := by
  have hf : p.findSome? (fun o => o.get a w) = some v := by
    unfold Heap.load at h
    split at h
    · rename_i hv
      cases h
      exact hv
    · cases h
  unfold Heap.load
  rw [List.findSome?_append, hf]
  rfl

/-- A store in the left part of a heap leaves the right part unchanged. -/
theorem storeB_frame {policy : CpuPolicy} {p F h' : Heap} {m : DataMem} {a : BitVec 64}
    {w : Width} {v : w.type} (hh : (p ++ F).Holds policy m)
    (hst : (p ++ F).storeB a w v = .ok h') (hcov : Covered p a) :
    h' = p.map (Obj.set a w v) ++ F ∨ h' = p.map (Obj.setBytes a w v) ++ F := by
  obtain ⟨O', hO', hO'c⟩ := hcov
  have hsep := hh.separated
  have hnw : ∀ o ∈ F, o.addr.toNat + o.size ≤ 2 ^ 64 := fun o ho =>
    hh.noWrap o (List.mem_append_right _ ho)
  have hfix : ∀ o ∈ F, Obj.set a w v o = o := by
    intro o ho
    by_cases hw : o.writable = true
    · exact obj_set_eq_self (hnw o ho) (not_covers_of_apart (hsep O' hO' o ho (Or.inr hw)) hO'c)
    · unfold Obj.set
      rw [if_neg hw]
  have hfixB : ∀ o ∈ F, Obj.setBytes a w v o = o := by
    intro o ho
    apply obj_setBytes_eq_self
    rintro ⟨hw, hsp⟩
    exact not_covers_of_apart (hsep O' hO' o ho (Or.inr hw)) hO'c (covers_of_spans hsp)
  have hmap : ∀ (f : Obj → Obj), (∀ o ∈ F, f o = o) → (p ++ F).map f = p.map f ++ F := by
    intro f hf
    rw [List.map_append, List.map_congr_left hf]
    simp
  unfold Heap.storeB at hst
  by_cases h1 : ((p ++ F).any fun o => (o.get a w).isSome) = true
  · rw [if_pos h1] at hst
    left
    obtain ⟨he, -⟩ := Heap.store_ok hst
    rw [he]
    exact hmap _ hfix
  · rw [if_neg h1] at hst
    by_cases h2 : ((p ++ F).any fun o => o.writable && decide (o.Spans a w)) = true
    · rw [if_pos h2] at hst
      cases hst
      right
      exact hmap _ hfixB
    · rw [if_neg h2] at hst
      split at hst <;> cases hst

/-- The object after a store in an array of words. -/
theorem words_set (base : BitVec 64) (xs : List (BitVec 64)) (i : Nat) (hi : i < xs.length)
    (v : BitVec 64) (hn : base.toNat + 8 * xs.length ≤ 2 ^ 64) :
    Obj.set (base + BitVec.ofNat 64 (8 * i)) .W64 v (Obj.words base true .W64 xs) =
      Obj.words base true .W64 (xs.set i v) := by
  have hn' : (Obj.words base true .W64 xs).addr.toNat + (Obj.words base true .W64 xs).size ≤ 2 ^ 64 := by
    show base.toNat + (Obj.words base true .W64 xs).size ≤ 2 ^ 64
    rw [Obj.size, Obj.words, words_bytes]
    simp only [Width.bytes]
    omega
  have h1 := Obj.set_field (o := Obj.words base true .W64 xs) rfl hn'
    i (by simpa [Obj.words] using hi) .W64 (by simp [Obj.words]) v
  have h2 : (Obj.words base true .W64 xs).fieldOff i = 8 * i := by
    show (((List.map (Cell.mk .W64) xs).take i).map (fun c => c.w.bytes)).sum = 8 * i
    rw [words_fieldOff .W64 xs i (Nat.le_of_lt hi)]
  rw [h2] at h1
  simp only [Obj.words] at h1 ⊢
  rw [h1]
  simp [List.map_set]

/-- The cells of one entry of the trace object. -/
def entryCells (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) : List Cell :=
  [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]

/-- The cells of the trace object from its entries. -/
def traceCells (trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)) : List Cell :=
  trs.flatMap entryCells

theorem traceCells_toCell : ∀ trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64),
    traceCells trs =
      (trs.flatMap fun t => [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]).map toCell
  | [] => rfl
  | t :: trs => by
    have ih := traceCells_toCell trs
    show List.flatMap entryCells (t :: trs) = _
    rw [List.flatMap_cons, List.flatMap_cons, List.map_append, ← ih]
    simp [entryCells, toCell, traceCells]

theorem cellsSize_entryCells (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) :
    cellsSize (entryCells t) = 12 := rfl

theorem cellsSize_traceCells (trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)) :
    cellsSize (traceCells trs) = 12 * trs.length := by
  rw [traceCells, cellsSize_flatMap]
  have h : (trs.map fun t => cellsSize (entryCells t)) = trs.map fun _ => 12 := by
    apply List.map_congr_left
    intro t _
    exact cellsSize_entryCells t
  rw [h, sum_map_const]
  omega

theorem cellGet_entryCells_0 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) :
    cellGet (entryCells t) 0 .W8 = some t.1 := by
  simp [entryCells, cellGet, Cell.get]

theorem cellGet_entryCells_1 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) :
    cellGet (entryCells t) 1 .W8 = some t.2.1 := by
  simp [entryCells, cellGet, Cell.get]

theorem cellGet_entryCells_4 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) :
    cellGet (entryCells t) 4 .W64 = some t.2.2.2 := by
  simp [entryCells, cellGet, Cell.get]

theorem cellSet_entryCells_0 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) (v : BitVec 8) :
    cellSet (entryCells t) 0 .W8 v = entryCells (v, t.2.1, t.2.2.1, t.2.2.2) := by
  simp [entryCells, cellSet]

theorem cellSet_entryCells_1 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) (v : BitVec 8) :
    cellSet (entryCells t) 1 .W8 v = entryCells (t.1, v, t.2.2.1, t.2.2.2) := by
  simp [entryCells, cellSet]

theorem cellSet_entryCells_4 (t : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) (v : BitVec 64) :
    cellSet (entryCells t) 4 .W64 v = entryCells (t.1, t.2.1, t.2.2.1, v) := by
  simp [entryCells, cellSet]

theorem cellGet_traceCells (trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64))
    (k : Nat) (hk : k < trs.length) (off : Nat) (hoff : off < 12) (w : Width) :
    cellGet (traceCells trs) (12 * k + off) w = cellGet (entryCells (trs[k])) off w := by
  rw [traceCells, show 12 * k + off = k * 12 + off by omega]
  exact cellGet_flatMap w (fun t => cellsSize_entryCells t) hk hoff

theorem obj_set_mk (addr : BitVec 64) (cells : List Cell) (a : BitVec 64) (w : Width) (v : w.type) :
    Obj.set a w v ⟨addr, true, cells⟩ = ⟨addr, true, setCells addr a w v 0 cells⟩ := rfl

theorem obj_set_trace (trace : BitVec 64)
    (trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64))
    (k : Nat) (hk : k < trs.length) (off : Nat) (hoff : off < 12) (w : Width) (v : w.type)
    (t' : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)
    (he : cellSet (entryCells (trs[k])) off w v = entryCells t')
    (hn : trace.toNat + 12 * trs.length ≤ 2 ^ 64) :
    (⟨trace, true, traceCells trs⟩ : Obj).set (trace + BitVec.ofNat 64 (12 * k + off)) w v
      = ⟨trace, true, traceCells (trs.set k t')⟩ := by
  have hcs : 0 + cellsSize (traceCells trs) ≤ 2 ^ 64 := by
    rw [cellsSize_traceCells]; omega
  have hd : 0 + (12 * k + off) < 2 ^ 64 := by
    have h1 : 12 * k + off < 12 * trs.length := by
      have h2 : k + 1 ≤ trs.length := hk
      omega
    omega
  have hsc := setCells_eq_cellSet trace w v (traceCells trs) 0 (12 * k + off) hcs hd
  simp only [Nat.zero_add] at hsc
  have hfin : cellSet (traceCells trs) (12 * k + off) w v = traceCells (trs.set k t') := by
    rw [traceCells, show 12 * k + off = k * 12 + off by omega]
    exact cellSet_flatMap_set v t' (fun t => cellsSize_entryCells t) hk hoff he
  rw [obj_set_mk, hsc, hfin]

theorem storeB_words {policy : CpuPolicy} {m : DataMem} {pre post : Heap} {base : BitVec 64}
    {xs : List (BitVec 64)}
    (hHolds : Heap.Holds policy (pre ++ Obj.words base true .W64 xs :: post) m)
    (i : Nat) (hi : i < xs.length) (v : BitVec 64) :
    ∃ m', Heap.storeB (pre ++ Obj.words base true .W64 xs :: post)
        (base + BitVec.ofNat 64 (8 * i)) .W64 v
      = .ok (pre ++ Obj.words base true .W64 (xs.set i v) :: post) ∧
      Heap.Holds policy (pre ++ Obj.words base true .W64 (xs.set i v) :: post) m' := by
  have hn : base.toNat + 8 * xs.length ≤ 2 ^ 64 := by
    have h := hHolds.noWrap (Obj.words base true .W64 xs)
      (List.mem_append_right _ (List.mem_cons_self ..))
    rw [Obj.size, Obj.words, words_bytes] at h
    simpa using h
  have hc : (cellGet (Obj.words base true .W64 xs).cells
      ((base + BitVec.ofNat 64 (8 * i)) - (Obj.words base true .W64 xs).addr).toNat .W64).isSome := by
    show (cellGet (xs.map (Cell.mk .W64)) ((base + BitVec.ofNat 64 (8 * i)) - base).toNat .W64).isSome
    have haddr : ((base + BitVec.ofNat 64 (8 * i)) - base).toNat = 8 * i := by bv_omega
    rw [haddr]
    have hget : cellGet (xs.map (Cell.mk .W64)) (8 * i) .W64 = some (xs[i]) := by
      have hmem := mem_offsets_words .W64 xs 0 i hi
      have h := cellGet_of_mem_offsets hmem rfl
      simpa using h
    rw [hget]
    rfl
  have hst : Heap.storeB (pre ++ Obj.words base true .W64 xs :: post)
      (base + BitVec.ofNat 64 (8 * i)) .W64 v
      = .ok (pre ++ Obj.words base true .W64 (xs.set i v) :: post) :=
    Heap.storeB_at_append (policy := policy) (m := m) (pre := pre) (post := post)
      (o := Obj.words base true .W64 xs) (o' := Obj.words base true .W64 (xs.set i v))
      (a := base + BitVec.ofNat 64 (8 * i)) (w := .W64) (v := v)
      hHolds rfl hc (words_set base xs i hi v hn)
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hHolds hst
  exact ⟨m', hst, hm'⟩

theorem storeB_trace {policy : CpuPolicy} {m : DataMem} {pre post : Heap} {trace : BitVec 64}
    {trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)}
    (hHolds : Heap.Holds policy (pre ++ ⟨trace, true, traceCells trs⟩ :: post) m)
    (k : Nat) (hk : k < trs.length) (off : Nat) (hoff : off < 12) (w : Width) (v : w.type)
    (t' : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)
    (hc : (cellGet (entryCells (trs[k])) off w).isSome)
    (he : cellSet (entryCells (trs[k])) off w v = entryCells t') :
    ∃ m', Heap.storeB (pre ++ ⟨trace, true, traceCells trs⟩ :: post)
        (trace + BitVec.ofNat 64 (12 * k + off)) w v
      = .ok (pre ++ ⟨trace, true, traceCells (trs.set k t')⟩ :: post) ∧
      Heap.Holds policy (pre ++ ⟨trace, true, traceCells (trs.set k t')⟩ :: post) m' := by
  have hn := hHolds.noWrap (⟨trace, true, traceCells trs⟩ : Obj)
    (List.mem_append_right _ (List.mem_cons_self ..))
  have hn2 : trace.toNat + 12 * trs.length ≤ 2 ^ 64 := by
    have h : trace.toNat + cellsSize (traceCells trs) ≤ 2 ^ 64 := hn
    rwa [cellsSize_traceCells] at h
  have hc' : (cellGet (traceCells trs)
      ((trace + BitVec.ofNat 64 (12 * k + off)) - trace).toNat w).isSome := by
    have haddr : ((trace + BitVec.ofNat 64 (12 * k + off)) - trace).toNat = 12 * k + off := by
      bv_omega
    rw [haddr, cellGet_traceCells trs k hk off hoff w]
    exact hc
  have hst : Heap.storeB (pre ++ ⟨trace, true, traceCells trs⟩ :: post)
      (trace + BitVec.ofNat 64 (12 * k + off)) w v
      = .ok (pre ++ ⟨trace, true, traceCells (trs.set k t')⟩ :: post) :=
    Heap.storeB_at_append (policy := policy) (m := m) (pre := pre) (post := post)
      (o := ⟨trace, true, traceCells trs⟩) (o' := ⟨trace, true, traceCells (trs.set k t')⟩)
      (a := trace + BitVec.ofNat 64 (12 * k + off)) (w := w) (v := v)
      hHolds rfl hc' (obj_set_trace trace trs k hk off hoff w v t' he hn2)
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hHolds hst
  exact ⟨m', hst, hm'⟩

theorem addr_mul8 (base i : BitVec 64) : base + i * 8 = base + BitVec.ofNat 64 (8 * i.toNat) := by
  bv_omega

theorem addr_mul8_sub (base i : BitVec 64) (hi : 0 < i.toNat) :
    base + i * 8 + BitVec.ofNat 64 18446744073709551608 = base + BitVec.ofNat 64 (8 * (i.toNat - 1)) := by
  bv_omega

theorem addr_mul12 (base i : BitVec 64) (off : Nat) :
    base + i * 12 + BitVec.ofNat 64 off = base + BitVec.ofNat 64 (12 * i.toNat + off) := by
  bv_omega

theorem obj_set_single (addr : BitVec 64) (v x : BitVec 64) :
    Obj.set addr .W64 v ⟨addr, true, [⟨.W64, x⟩]⟩ = ⟨addr, true, [⟨.W64, v⟩]⟩ := by

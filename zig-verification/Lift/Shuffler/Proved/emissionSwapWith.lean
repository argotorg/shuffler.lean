  · apply Visits.goto (by simpa only [initP, if_neg hfull] using dataStep)
    have hroom : st.trace.length < Zig.maxTraceSize := by
      have hn : ¬ ¬ st.trace.length < Zig.maxTraceSize := fun h => hfull (traceTest.mpr h)
      omega
    exact SwapRecord.from_record self data trace mapping frame st pos trace0 a y hy hheap
      hrdi hrsi hC1 hC2 hC3 hC4 hlt hfin hdepth hroom (m := memSwap) holds2 head



    (hq8 : ¬(⟨v4⟩ : UInt64) < (~~~(initP a).input.rsi + (⟨v1⟩ : UInt64)))
    (head : Lbl)
    (x : St In2p Heap)
    (hx : x = ⟨(initP a).input, (initP a).rax &&& 18446744073709486080 ||| 1 &&& 65535,
        ~~~(initP a).input.rsi, ⟨v1⟩, (initP a).rdi, ~~~(initP a).input.rsi + ⟨v1⟩, 0,
        (initP a).mem⟩) :
    Lift.Sem.Visits blocksP head (fun _ => False)

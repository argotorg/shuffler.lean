    data := FlatShuffler.Flat.put first.data (st.size - 1) (FlatShuffler.Flat.get st.data pos),
    pad := FlatShuffler.Flat.put first.pad (st.size - 1) (FlatShuffler.Flat.get st.pad pos) }


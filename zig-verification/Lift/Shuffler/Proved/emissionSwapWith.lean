  have hposAddress : data + pos * 8 = data + BitVec.ofNat 64 (pos.toNat * 8) := by
    simp only [BitVec.ofNat_mul, BitVec.ofNat_toNat, BitVec.setWidth_eq]
    bv_decide
  have htopAddress : data + st.size * 8 + 18446744073709551608 =
      data + BitVec.ofNat 64 ((st.size - 1).toNat * 8) := by
    simp only [BitVec.ofNat_mul, BitVec.ofNat_toNat, BitVec.setWidth_eq]
    bv_decide
  have dataRead : H0.loadB (self + 40) .W64 = .ok data := SwapRepair.load_dataPtr holds0
  have oldRead : H0.loadB (data + pos * 8) .W64 = .ok oldWord := by
    rw [hposAddress]

theorem refines_l3 : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240), Refines (fun (_ : Unit) => SimArr self data trace mapping frame st pos trace0) (fun _ a y r => Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.SwapWithStatement.result st pos trace0 y) y) = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP self data trace mapping st pos trace0 ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.Proposed.SwapWithStatement.post st pos trace0 (Lift.Shuffler.Internal.Proposed.SwapWithStatement.envOf self data trace mapping) a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) (fun _ y => Lift.Shuffler.Internal.Proposed.SwapWithStatement.run st pos = some y) l2p.returns := by
  intro self data trace mapping frame st pos trace0 x a y hs hy
  obtain ⟨⟨⟨hC1, hC2, hC3⟩, hC4⟩, hrdi, hrsi, hheap, w, hw⟩ := hs
  change a.rdi.toBitVec = self at hrdi
  have hrsiCode : a.rsi = UInt64.ofBitVec pos := congrArg UInt64.ofBitVec hrsi
  have hh : Heap.Holds a.policy (objsP self data trace mapping st pos trace0 ++ frame) w := hheap ▸ hw
  have hsizeLoad : (initP a).mem.loadB ((initP a).rdi.toBitVec + 48) .W64 = .ok st.size := by
    change a.heap.loadB (a.rdi.toBitVec + 48) .W64 = _
    rw [hheap, hrdi]
    exact loadB_size self data trace mapping frame st pos trace0 a.policy w hh
  have hmapLoad : (initP a).mem.loadB ((initP a).rdi.toBitVec + 72) .W64 = .ok mapping := by
    change a.heap.loadB (a.rdi.toBitVec + 72) .W64 = _
    rw [hheap, hrdi]
    exact loadB_mapping self data trace mapping frame st pos trace0 a.policy w hh
  have hmaxLoad : (initP a).mem.loadB ((initP a).rdi.toBitVec + 24) .W64 = .ok st.maxSwapDepth := by
    change a.heap.loadB (a.rdi.toBitVec + 24) .W64 = _
    rw [hheap, hrdi]
    exact loadB_maxSwapDepth self data trace mapping frame st pos trace0 a.policy w hh
  have depthCode : ~~~a.rsi + UInt64.ofBitVec st.size = UInt64.ofBitVec (Zig.depthOf st pos) := by
    rw [hrsiCode, UInt64.eq_iff_toBitVec_eq]
    change ~~~pos + st.size = st.size - 1 - pos
    bv_decide
  lift_straight exits [.o59]
  case exit_1 =>
    refine from_o59 self data trace mapping frame st pos trace0 a y hy hheap hw hrdi hrsi hC1 hC2 hC3 hC4
      hp1 hp2 hp3 hp4 hp5 hp6 hp7 hp8 _ _ ?_
    rfl
  all_goals
    simp only [hsizeLoad, Res.ok.injEq, reduceCtorEq] at hp1
    try subst v1
  case ret_1 =>
    have hge : ¬pos < st.size := by
      simp only [initP, hrsiCode] at hp2
      change st.size.toNat ≤ pos.toNat at hp2
      change ¬pos.toNat < st.size.toNat
      omega
    apply SwapRepair.assertion_out self data trace mapping frame st pos trace0 a y hy hheap
    simp only [Zig.swapWith, hge, not_false_eq_true, reduceIte]
  all_goals
    simp only [hmapLoad, Res.ok.injEq, reduceCtorEq] at hp3
    try subst v2
  all_goals
    have hlt : pos < st.size := by
      simp only [initP, hrsiCode] at hp2
      change ¬st.size.toNat ≤ pos.toNat at hp2
      change pos.toNat < st.size.toNat
      omega
    have hsmall : pos.toNat < FlatShuffler.maxStackSize := Nat.lt_of_lt_of_le hlt hC1
    have hdestLoad : (initP a).mem.loadB (mapping + (initP a).input.rsi.toBitVec * 8) .W64 =
        .ok (st.dest.toList.getD pos.toNat default) := by
      change a.heap.loadB (mapping + a.rsi.toBitVec * 8) .W64 = _
      rw [hheap, hrsi]
      exact loadB_dest self data trace mapping frame st pos trace0 a.policy w pos hsmall hh
    simp only [hdestLoad, Res.ok.injEq, reduceCtorEq] at hp4
    try subst v3
  all_goals
    have hDestRead : st.dest.toList.getD pos.toNat default = FlatShuffler.Flat.get st.dest pos := by
      have hlist : pos.toNat < st.dest.toList.length := by simpa only [Vector.length_toList] using hsmall
      simp only [FlatShuffler.Flat.get, dif_pos hsmall, List.getD_eq_getElem?_getD,
        List.getElem?_eq_getElem hlist, Option.getD_some, Vector.getElem_toList]
    have htest : (UInt64.ofBitVec (st.dest.toList.getD pos.toNat default) = a.rsi) ↔
        FlatShuffler.Flat.get st.dest pos = pos := by
      rw [hDestRead, hrsiCode, UInt64.eq_iff_toBitVec_eq]
    simp only [initP, htest] at hp5
  case ret_2 =>
    have hfin : Zig.isFinal st pos = true := by simp [Zig.isFinal, hp5]
    apply SwapRepair.assertion_out self data trace mapping frame st pos trace0 a y hy hheap
    simp only [Zig.swapWith, hlt, hfin, not_true, reduceIte]
  case ret_3 =>
    have hfin : Zig.isFinal st pos = false := by simp [Zig.isFinal, hp5]
    have hzero : Zig.depthOf st pos = 0 := by
      simpa [initP, depthCode, UInt64.eq_iff_toBitVec_eq] using hp6
    have hbad : ¬(1 ≤ Zig.depthOf st pos ∧ Zig.depthOf st pos ≤ st.maxSwapDepth) := by
      intro h
      have hz : (Zig.depthOf st pos).toNat = 0 := congrArg BitVec.toNat hzero
      have hle : 1 ≤ (Zig.depthOf st pos).toNat := h.1
      omega
    apply SwapRepair.assertion_out self data trace mapping frame st pos trace0 a y hy hheap
    simp only [Zig.swapWith, hlt, hfin, hbad, not_true, not_false_eq_true, Bool.false_eq_true, reduceIte]
  all_goals
    simp only [hmaxLoad, Res.ok.injEq, reduceCtorEq] at hp7
    try subst v4
  case ret_4 =>
    have hfin : Zig.isFinal st pos = false := by simp [Zig.isFinal, hp5]
    have hbad : ¬(1 ≤ Zig.depthOf st pos ∧ Zig.depthOf st pos ≤ st.maxSwapDepth) := by
      intro h
      simp only [initP, depthCode] at hp8
      change st.maxSwapDepth.toNat < (Zig.depthOf st pos).toNat at hp8
      have hle : (Zig.depthOf st pos).toNat ≤ st.maxSwapDepth.toNat := h.2
      omega
    apply SwapRepair.assertion_out self data trace mapping frame st pos trace0 a y hy hheap
    simp only [Zig.swapWith, hlt, hfin, hbad, not_true, not_false_eq_true, Bool.false_eq_true, reduceIte]
end refines_l3.skel_proof
theorem refines_l3 : refines_l3.skel_statement := @refines_l3.skel_proof.refines_l3
theorem above_l3 : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (pol : CpuPolicy), Above l2p (l3 self data trace mapping frame st pos trace0 pol) := by
  intro self data trace mapping frame st pos trace0 pol
  refine Above.ofRefines (fun _ _ _ => SimArr self data trace mapping frame st pos trace0) _ (fun _ _ => refines_l3 self data trace mapping frame st pos trace0) ?_ ?_
  · rintro policy _ s ⟨hpol, hh, hperm, hC, he, hq0, hq1, harea⟩
    exact ⟨⟨policy, objsP self data trace mapping st pos trace0 ++ frame, s.data.regs.rax, s.data.regs.rsi, s.data.regs.rdi, s.data.regs.rsp.toBitVec⟩, ⟨rfl, hh, hperm, he, rfl, rfl, rfl, harea, rfl⟩, ⟨hC, hq0, hq1, rfl, ⟨_, hh⟩⟩⟩
  · rintro policy _ a s y r t ⟨hp, -⟩ ⟨hbp, -⟩ ⟨hv, hain, hm⟩ ⟨hex, hrax, hh, hfr⟩
    rw [hain] at hfr
    exact ⟨hex, by rw [hrax]; exact hv, by rw [hrax, ← hp, ← hbp]; exact hm _ hh, hfr⟩
theorem total : ∀ (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64), Lift.Shuffler.Internal.Proposed.SwapWithStatement.C st pos trace0 → ∃ y, Lift.Shuffler.Internal.Proposed.SwapWithStatement.run st pos = some y := by intros; exact ⟨_, rfl⟩
theorem decompiles : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (pol : CpuPolicy), Decompiles Lift.Shuffler.L1.step (l3 self data trace mapping frame st pos trace0 pol) := by intros; apply Decompiles.above (decompiles_l2.above above_l2p); apply above_l3
theorem decompiles_code : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (pol : CpuPolicy), Decompiles (fun s => Lift.Shuffler.Code.code.step s .done) (l3 self data trace mapping frame st pos trace0 pol) := by intros; exact (Sites.decompiles_l1Spec_iff Lift.Shuffler.Code.code Lift.Shuffler.L1.step Lift.Shuffler.L1.spec _).mp (by apply decompiles)
theorem contract : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (pol : CpuPolicy) (policy : CpuPolicy) (s : MachineState), (l3 self data trace mapping frame st pos trace0 pol).rep policy () s → Lift.Shuffler.Internal.Proposed.SwapWithStatement.C st pos trace0 → Reaches (fun s => Lift.Shuffler.Code.code.step s .done) policy (fun t => ∃ y, (l3 self data trace mapping frame st pos trace0 pol).post () y s t ∧ Lift.Shuffler.Internal.Proposed.SwapWithStatement.run st pos = some y) s := by intro self data trace mapping; intros; rename_i st pos trace0 _ _ _ _ _; apply Decompiles.transfer _ (fun (_ : Unit) => Lift.Shuffler.Internal.Proposed.SwapWithStatement.C st pos trace0) (fun _ y => Lift.Shuffler.Internal.Proposed.SwapWithStatement.run st pos = some y) (fun _ h => total st pos trace0 self data trace mapping h) (fun _ _ _ h => h) <;> first | assumption | apply decompiles_code
theorem final : Lift.Shuffler.Internal.Proposed.SwapWithStatement.SwapWithStatement := by
  intro st pos trace0 hC self data trace mapping policy ra s heB
  have he := heB.1
  have hrep : (l3 self data trace mapping [] st pos trace0 policy).rep policy () s :=
    ⟨rfl, Lift.Sem.Final.holds he, Lift.Sem.Final.permits heB, hC, Lift.Sem.Bridge.Fn.Entry.sysV (lo := Lift.Shuffler.shufflePC) (hi := Lift.Shuffler.shufflerEndPC) he (by decide +kernel) (by decide +kernel), Lift.Sem.Final.bv64 he.inRegs 0 rfl, Lift.Sem.Final.bv64 he.inRegs 1 rfl, Lift.Sem.Final.not_covered he 0 rfl⟩
  refine (contract self data trace mapping [] st pos trace0 policy policy s hrep hC).mono ?_
  rintro t ⟨y, ⟨hexit, hrel, hpp, hmem⟩, hrun⟩
  refine Lift.Sem.Final.ret he 0 rfl hexit (fun b ho _ => hmem b ho) ?_

    (hq2 : ¬(⟨v1⟩ : UInt64) ≤ (initP a).input.rsi)
    (hq3 : (initP a).mem.loadB ((initP a).rdi.toBitVec + 72) .W64 = .ok v2)
    (hq4 : (initP a).mem.loadB (v2 + (initP a).input.rsi.toBitVec * 8) .W64 = .ok v3)
    (hq5 : ¬(⟨v3⟩ : UInt64) = (initP a).input.rsi)

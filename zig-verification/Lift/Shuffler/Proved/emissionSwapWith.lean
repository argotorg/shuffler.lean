  Heap.loadB_word_addr hh (mem_objs_dataPtr self data trace mapping frame st pos trace0)

/-- A load of the trace pointer word of the statement. -/
theorem loadB_trace (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)

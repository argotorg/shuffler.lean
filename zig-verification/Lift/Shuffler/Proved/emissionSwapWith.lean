    · simp only [initP, depthCode] at hq8
      change ¬ st.maxSwapDepth.toNat < (Zig.depthOf st pos).toNat at hq8
      change (Zig.depthOf st pos).toNat ≤ st.maxSwapDepth.toNat
      omega
  let traceSize := BitVec.ofNat 64 st.trace.length
  let oldWord := (Zig.Slot.join (FlatShuffler.Flat.get st.data pos, FlatShuffler.Flat.get st.pad pos)).word
  let topWord := (Zig.Slot.join (FlatShuffler.Flat.get st.data (st.size - 1),
    FlatShuffler.Flat.get st.pad (st.size - 1))).word
  let stFirst : Zig.St := { st with
    data := FlatShuffler.Flat.put st.data pos (FlatShuffler.Flat.get st.data (st.size - 1)),
    pad := FlatShuffler.Flat.put st.pad pos (FlatShuffler.Flat.get st.pad (st.size - 1)) }
  let stSwap : Zig.St := { stFirst with
    data := FlatShuffler.Flat.put stFirst.data (st.size - 1) (FlatShuffler.Flat.get st.data pos),
    pad := FlatShuffler.Flat.put stFirst.pad (st.size - 1) (FlatShuffler.Flat.get st.pad pos) }

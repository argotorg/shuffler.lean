theorem assertion_out (self data trace mapping : BitVec 64) (frame : Heap) (st : Zig.St)
    (pos : FlatShuffler.Word)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (a : In2p) (y : Zig.Outcome FlatShuffler.Flat.Status)
    (hy : Internal.Proposed.SwapWithStatement.run st pos = some y)
    (hheap : a.heap = objsP self data trace mapping st pos trace0 ++ frame)
    (hex : Zig.swapWith st pos = (Zig.Exit.assertionExit, st)) :
    Qrel self data trace mapping frame st pos trace0 a y
      ((a.rax &&& 18446744073709486080) ||| (1 &&& 65535), a.heap) := by
  have hy' : y = (Zig.Exit.assertionExit, st) := by
    simpa only [Internal.Proposed.SwapWithStatement.run, hex, Option.some.injEq] using hy.symm
  subst y
  have hcode : ((a.rax &&& 18446744073709486080) ||| (1 &&& 65535)).toBitVec.setWidth 16 =
      (1 : BitVec 16) := by
    bv_decide
  refine ⟨?_, hheap, ?_⟩
  · rw [encode_result_assertion, hcode]
  · intro m hm
    change Internal.Proposed.SwapWithStatement.post st pos trace0
      (Internal.Proposed.SwapWithStatement.envOf self data trace mapping) a.policy
        ⟨.W16, ((a.rax &&& 18446744073709486080) ||| (1 &&& 65535)).toBitVec.setWidth 16⟩ m
    rw [hcode]
    exact post_exit self data trace mapping frame st pos trace0 a.policy m hex (hheap ▸ hm)

end SwapRepair


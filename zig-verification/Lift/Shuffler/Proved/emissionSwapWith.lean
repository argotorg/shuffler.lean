    rw [hposAddress]
    dsimp only [H0, H1]
    rw [dw1]
    exact SwapRepair.store_data pos.toNat topWord
      (by simpa only [dw, List.length_map, List.length_range] using hsmall) holds0
  obtain ⟨memFirst, holds1⟩ := Heap.storeB_holds holds0 store1
  have dataPtrRead1 : H1.loadB (self + 40) .W64 = .ok data := SwapRepair.load_dataPtr holds1
  have sizeRead1 : H1.loadB (self + 48) .W64 = .ok st.size := SwapRepair.load_size holds1
  have store2 : H1.storeB (data + st.size * 8 + 18446744073709551608) .W64 oldWord = .ok H2 := by
    rw [htopAddress]
    dsimp only [H1, H2]
    rw [dw2]

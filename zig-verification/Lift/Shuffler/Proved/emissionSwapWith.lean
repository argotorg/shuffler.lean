theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : (UInt64 × Heap)) (q : (UInt64 × Heap)) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    callState (fun (r : (UInt64 × Heap)) (q : (UInt64 × Heap)) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l x z n hs ht
      rcases hs with ⟨hinput, h_rax, h_rcx, h_rdx, h_rdi, h_r8, h_r9, h_mem, htrue⟩
      cases l <;> simp only [blocksP, callInput, hinput, h_rax, h_rcx, h_rdx, h_rdi, h_r8, h_r9, h_mem] at ht
      all_goals repeat' split at ht
      all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
      all_goals subst n
      all_goals simp_all [skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
      all_goals (split <;> simp_all [callState, callInput])
      all_goals grind)
    hr (by simp [callState, initP, skel_call.initP, callInput])

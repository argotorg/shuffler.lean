  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ r.2.Holds a.policy t.data.dmem ∧ ∀ b, ¬ a.heap.Owned b → t.data.dmem.get? b = s.data.dmem.get? b

def l2p : Model In2p (UInt64 × Heap) where
  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ Heap.Permits policy a.heap ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.emissionSwapWithPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocksP.Returns noCall .entry (initP a) r
  post := postP



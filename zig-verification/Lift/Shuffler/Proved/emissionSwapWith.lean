def hOf (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (traceSize : BitVec 64) (dest pos : List (BitVec 64)) (dataW : List (BitVec 64))
    (cells : List Lift.Sem.Cell) : Heap :=
  Obj.words data true .W64 dataW :: Obj.words (self + 64) true .W64 [traceSize] ::
  Obj.words mapping true .W64 dest :: Obj.words (mapping + 8192) true .W64 pos ::
  (⟨trace, true, cells⟩ : Obj) ::
  Obj.words (self + 48) false .W64 [st.size] :: Obj.words (self + 24) false .W64 [st.maxSwapDepth] ::
  Obj.words (self + 40) false .W64 [data] :: Obj.words (self + 56) false .W64 [trace] ::
  Obj.words (self + 72) false .W64 [mapping] :: frame

/-- The object of the trace array of the statement. -/
theorem toObj_trace (trace : BitVec 64)
    (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    Lift.Sem.Bridge.toObj ⟨trace, trace0.toList.flatMap (fun t =>
      [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]), true⟩ =
      (⟨trace, true, tcells trace0⟩ : Obj) := by
  simp [tcells, Lift.Sem.Bridge.toObj]

/-- The initial heap is the heap of the statement. -/
theorem hOf_init (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    hOf self data trace mapping frame st (BitVec.ofNat 64 st.trace.length) st.dest.toList st.pos.toList
      (dw st) (tcells trace0) = objsP self data trace mapping st pos trace0 ++ frame := by
  have h1 : Lift.Sem.Bridge.toObj
      { addr := mapping, fields := List.map (fun v => (⟨Width.W64, v⟩ : Lift.Trusted.Field)) st.dest.toList,
        writable := true } = Obj.words mapping true .W64 st.dest.toList :=
    toObj_map_words64_id mapping st.dest.toList true
  have h2 : Lift.Sem.Bridge.toObj
      { addr := mapping + BitVec.ofNat 64 8192,
        fields := List.map (fun v => (⟨Width.W64, v⟩ : Lift.Trusted.Field)) st.pos.toList,
        writable := true } = Obj.words (mapping + BitVec.ofNat 64 8192) true .W64 st.pos.toList :=
    toObj_map_words64_id (mapping + BitVec.ofNat 64 8192) st.pos.toList true
  simp [h1, h2, hOf, objsP, Lift.Shuffler.Internal.Proposed.SwapWithStatement.objects,
    Lift.Shuffler.Internal.Proposed.SwapWithStatement.envOf,
    Lift.Shuffler.Internal.Proposed.Layout.data, Lift.Shuffler.Internal.Proposed.Layout.traceSize,
    Lift.Shuffler.Internal.Proposed.Layout.dest, Lift.Shuffler.Internal.Proposed.Layout.pos,
    Lift.Shuffler.Internal.Proposed.Layout.size, Lift.Shuffler.Internal.Proposed.Layout.maxSwapDepth,
    Lift.Shuffler.Internal.Proposed.Layout.dataPtr, Lift.Shuffler.Internal.Proposed.Layout.tracePtr,
    Lift.Shuffler.Internal.Proposed.Layout.mappingPtr, Lift.Shuffler.Internal.Proposed.Layout.word,
    dw, toObj_map_words64, toObj_word, toObj_map_words64_id, toObj_trace,
    Lift.Shuffler.Internal.Proposed.Layout.slotWord]
  all_goals exact h2.symm

/-- A load of the size word of the statement. -/
theorem loadB_size (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240)
    (pol : CpuPolicy) (m : DataMem)
    (hh : Heap.Holds pol (objsP self data trace mapping st pos trace0 ++ frame) m) :
    (objsP self data trace mapping st pos trace0 ++ frame).loadB (self + 48) .W64 = .ok st.size :=
  Heap.loadB_word_addr hh (mem_objs_size self data trace mapping frame st pos trace0)

/-- A load of the mapping pointer word of the statement. -/
theorem loadB_mapping (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)

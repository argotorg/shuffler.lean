  have traceRead2 : H2.loadB (self + 64) .W64 = .ok traceSize := SwapRepair.load_traceSize holds2
  let next : St In2p Heap := ⟨a, (a.rax &&& 18446744073709486080) ||| (1 &&& 65535),
    ~~~a.rsi, UInt64.ofBitVec traceSize, a.rdi, UInt64.ofBitVec st.size, UInt64.ofBitVec oldWord, H2⟩
  have dataStep : blocksP.step .o59
      ⟨a, (a.rax &&& 18446744073709486080) ||| (1 &&& 65535),

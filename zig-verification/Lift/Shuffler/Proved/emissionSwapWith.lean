/-- The objects of the callee's heap, with the mutable contents. -/
def pre0 (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (xs ds ps : List (BitVec 64)) (tl : BitVec 64) (tr : List Cell) : Heap :=
  [Obj.words data true .W64 xs, ⟨self + 64, true, [⟨.W64, tl⟩]⟩,
   Obj.words mapping true .W64 ds, Obj.words (mapping + BitVec.ofNat 64 8192) true .W64 ps,
   ⟨trace, true, tr⟩, ⟨self + 48, false, [⟨.W64, st.size⟩]⟩,
   ⟨self + 24, false, [⟨.W64, st.maxSwapDepth⟩]⟩, ⟨self + 40, false, [⟨.W64, data⟩]⟩,
   ⟨self + 56, false, [⟨.W64, trace⟩]⟩, ⟨self + 72, false, [⟨.W64, mapping⟩]⟩]

/-- A bound on the destination words is kept by an update inside the bound. -/
theorem bound_set {ds : List (BitVec 64)} {n : Nat} (hlen : n ≤ ds.length)
    (h : ∀ i, i < n → ∀ v, ds[i]? = some v →
      UInt64.ofBitVec v = 18446744073709551615 ∨ v.toNat < 1024)
    {k : Nat} (hk : k < n) {x : BitVec 64}
    (hx : UInt64.ofBitVec x = 18446744073709551615 ∨ x.toNat < 1024) :
    ∀ i, i < n → ∀ v, (ds.set k x)[i]? = some v →
      UInt64.ofBitVec v = 18446744073709551615 ∨ v.toNat < 1024 := by
  intro i hi v hv
  by_cases hik : i = k
  · subst hik
    rw [List.getElem?_set_self (by omega)] at hv
    injection hv with hv
    subst hv
    exact hx
  · rw [List.getElem?_set_ne (Ne.symm hik)] at hv
    exact h i hi v hv

theorem addr_mul12_0 (base i : BitVec 64) :
    base + i * 12 = base + BitVec.ofNat 64 (12 * i.toNat) := by
  bv_omega

/-- A store in the trace object of the callee's heap. -/
theorem storeB_pre0_trace {policy : CpuPolicy} {m : DataMem} {frame : Heap}
    {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St}
    {xs ds ps : List (BitVec 64)} {tl : BitVec 64}
    {trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)}
    (hHolds : Heap.Holds policy (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame) m)
    (k : Nat) (hk : k < trs.length) (off : Nat) (hoff : off < 12) (w : Width) (v : w.type)
    (t' : BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)
    (hc : (cellGet (entryCells (trs[k])) off w).isSome)
    (he : cellSet (entryCells (trs[k])) off w v = entryCells t') :
    ∃ m', Heap.storeB (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame)
        (trace + BitVec.ofNat 64 (12 * k + off)) w v
      = .ok (pre0 self data trace mapping st xs ds ps tl (traceCells (trs.set k t')) ++ frame) ∧
      Heap.Holds policy
        (pre0 self data trace mapping st xs ds ps tl (traceCells (trs.set k t')) ++ frame) m' := by
  obtain ⟨m', hst, hm'⟩ := storeB_trace
    (pre := [Obj.words data true .W64 xs, ⟨self + 64, true, [⟨.W64, tl⟩]⟩,
      Obj.words mapping true .W64 ds, Obj.words (mapping + BitVec.ofNat 64 8192) true .W64 ps])
    (post := (pre0 self data trace mapping st xs ds ps tl (traceCells trs)).tail.tail.tail.tail.tail ++ frame)
    (trace := trace) (trs := trs) (by simpa [pre0] using hHolds) k hk off hoff w v t' hc he
  exact ⟨m', by simpa [pre0] using hst, by simpa [pre0] using hm'⟩

/-- The three stores of one trace record. -/
theorem storeB_pre0_trace3 {policy : CpuPolicy} {m : DataMem} {frame : Heap}
    {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St}
    {xs ds ps : List (BitVec 64)} {tl : BitVec 64}
    {trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)}
    (hHolds : Heap.Holds policy
      (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame) m)
    (k : Nat) (hk : k < trs.length) (v0 vb : BitVec 8) (v4 : BitVec 64) :
    ∃ m', Heap.storeB (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame)
        (trace + BitVec.ofNat 64 (12 * k)) .W8 v0
      = .ok (pre0 self data trace mapping st xs ds ps tl
        (traceCells (trs.set k (v0, (trs[k]).2.1, (trs[k]).2.2.1, (trs[k]).2.2.2))) ++ frame) ∧
      Heap.storeB (pre0 self data trace mapping st xs ds ps tl
          (traceCells (trs.set k (v0, (trs[k]).2.1, (trs[k]).2.2.1, (trs[k]).2.2.2))) ++ frame)
        (trace + BitVec.ofNat 64 (12 * k + 1)) .W8 vb
      = .ok (pre0 self data trace mapping st xs ds ps tl
        (traceCells ((trs.set k (v0, (trs[k]).2.1, (trs[k]).2.2.1, (trs[k]).2.2.2)).set k
          (v0, vb, (trs[k]).2.2.1, (trs[k]).2.2.2))) ++ frame) ∧
      Heap.storeB (pre0 self data trace mapping st xs ds ps tl
          (traceCells ((trs.set k (v0, (trs[k]).2.1, (trs[k]).2.2.1, (trs[k]).2.2.2)).set k
            (v0, vb, (trs[k]).2.2.1, (trs[k]).2.2.2))) ++ frame)
        (trace + BitVec.ofNat 64 (12 * k + 4)) .W64 v4
      = .ok (pre0 self data trace mapping st xs ds ps tl
        (traceCells (((trs.set k (v0, (trs[k]).2.1, (trs[k]).2.2.1, (trs[k]).2.2.2)).set k
            (v0, vb, (trs[k]).2.2.1, (trs[k]).2.2.2)).set k
          (v0, vb, (trs[k]).2.2.1, v4))) ++ frame) ∧
      Heap.Holds policy (pre0 self data trace mapping st xs ds ps tl
        (traceCells (((trs.set k (v0, (trs[k]).2.1, (trs[k]).2.2.1, (trs[k]).2.2.2)).set k
            (v0, vb, (trs[k]).2.2.1, (trs[k]).2.2.2)).set k
          (v0, vb, (trs[k]).2.2.1, v4))) ++ frame) m' := by
  obtain ⟨m1, hst1, hh1⟩ := storeB_pre0_trace (frame := frame) (self := self) (data := data)
    (trace := trace) (mapping := mapping) (st := st) (xs := xs) (ds := ds) (ps := ps)
    (tl := tl) (trs := trs) (m := m) hHolds k hk 0 (by omega) .W8 v0
    (v0, (trs[k]).2.1, (trs[k]).2.2.1, (trs[k]).2.2.2)
    (by rw [cellGet_entryCells_0]; rfl)
    (cellSet_entryCells_0 (trs[k]) v0)
  obtain ⟨m2, hst2, hh2⟩ := storeB_pre0_trace (frame := frame) (self := self) (data := data)
    (trace := trace) (mapping := mapping) (st := st) (xs := xs) (ds := ds) (ps := ps)
    (tl := tl) (trs := trs.set k (v0, (trs[k]).2.1, (trs[k]).2.2.1, (trs[k]).2.2.2))
    (m := m1) hh1 k (by rw [List.length_set]; exact hk) 1 (by omega) .W8 vb
    (v0, vb, (trs[k]).2.2.1, (trs[k]).2.2.2)
    (by rw [List.getElem_set_self (by rw [List.length_set]; exact hk), cellGet_entryCells_1]; rfl)
    (by rw [List.getElem_set_self (by rw [List.length_set]; exact hk), cellSet_entryCells_1])
  obtain ⟨m3, hst3, hh3⟩ := storeB_pre0_trace (frame := frame) (self := self) (data := data)
    (trace := trace) (mapping := mapping) (st := st) (xs := xs) (ds := ds) (ps := ps)
    (tl := tl)
    (trs := (trs.set k (v0, (trs[k]).2.1, (trs[k]).2.2.1, (trs[k]).2.2.2)).set k
      (v0, vb, (trs[k]).2.2.1, (trs[k]).2.2.2))
    (m := m2) hh2 k (by rw [List.length_set, List.length_set]; exact hk) 4 (by omega) .W64 v4
    (v0, vb, (trs[k]).2.2.1, v4)
    (by rw [List.getElem_set_self (by rw [List.length_set, List.length_set]; exact hk),
      cellGet_entryCells_4]; rfl)
    (by rw [List.getElem_set_self (by rw [List.length_set, List.length_set]; exact hk),
      cellSet_entryCells_4])
  exact ⟨m3, hst1, hst2, hst3, hh3⟩

/-- A store in an array of one word. -/
theorem storeB_single {policy : CpuPolicy} {m : DataMem} {pre post : Heap} {addr : BitVec 64}
    {x : BitVec 64}
    (hHolds : Heap.Holds policy (pre ++ (⟨addr, true, [⟨.W64, x⟩]⟩ : Obj) :: post) m)
    (v : BitVec 64) :
    ∃ m', Heap.storeB (pre ++ (⟨addr, true, [⟨.W64, x⟩]⟩ : Obj) :: post) addr .W64 v
      = .ok (pre ++ (⟨addr, true, [⟨.W64, v⟩]⟩ : Obj) :: post) ∧
      Heap.Holds policy (pre ++ (⟨addr, true, [⟨.W64, v⟩]⟩ : Obj) :: post) m' := by
  have hc : (cellGet (⟨addr, true, [⟨.W64, x⟩]⟩ : Obj).cells
      (addr - (⟨addr, true, [⟨.W64, x⟩]⟩ : Obj).addr).toNat .W64).isSome := by
    show (cellGet [⟨.W64, x⟩] (addr - addr).toNat .W64).isSome
    simp [cellGet, Cell.get]
  have hst : Heap.storeB (pre ++ (⟨addr, true, [⟨.W64, x⟩]⟩ : Obj) :: post) addr .W64 v
      = .ok (pre ++ (⟨addr, true, [⟨.W64, v⟩]⟩ : Obj) :: post) :=
    Heap.storeB_at_append (policy := policy) (m := m) (pre := pre) (post := post)
      (o := (⟨addr, true, [⟨.W64, x⟩]⟩ : Obj)) (o' := (⟨addr, true, [⟨.W64, v⟩]⟩ : Obj))
      (a := addr) (w := .W64) (v := v) hHolds rfl hc (obj_set_single addr v x)
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hHolds hst
  exact ⟨m', hst, hm'⟩

/-- A store in the data array of the callee's heap. -/
theorem storeB_pre0_data {policy : CpuPolicy} {m : DataMem} {frame : Heap}
    {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St}
    {xs ds ps : List (BitVec 64)} {tl : BitVec 64}
    {trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)}
    (hHolds : Heap.Holds policy (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame) m)
    (i : Nat) (hi : i < xs.length) (v : BitVec 64) :
    ∃ m', Heap.storeB (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame)
        (data + BitVec.ofNat 64 (8 * i)) .W64 v
      = .ok (pre0 self data trace mapping st (xs.set i v) ds ps tl (traceCells trs) ++ frame) ∧
      Heap.Holds policy
        (pre0 self data trace mapping st (xs.set i v) ds ps tl (traceCells trs) ++ frame) m' := by
  obtain ⟨m', hst, hm'⟩ := storeB_words (pre := ([] : Heap))
    (post := (pre0 self data trace mapping st xs ds ps tl (traceCells trs)).tail ++ frame)
    (base := data) (xs := xs) (by simpa [pre0] using hHolds) i hi v
  exact ⟨m', by simpa [pre0] using hst, by simpa [pre0] using hm'⟩

/-- A store in the destination array of the callee's heap. -/
theorem storeB_pre0_ds {policy : CpuPolicy} {m : DataMem} {frame : Heap}
    {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St}
    {xs ds ps : List (BitVec 64)} {tl : BitVec 64}
    {trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)}
    (hHolds : Heap.Holds policy (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame) m)
    (i : Nat) (hi : i < ds.length) (v : BitVec 64) :
    ∃ m', Heap.storeB (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame)
        (mapping + BitVec.ofNat 64 (8 * i)) .W64 v
      = .ok (pre0 self data trace mapping st xs (ds.set i v) ps tl (traceCells trs) ++ frame) ∧
      Heap.Holds policy
        (pre0 self data trace mapping st xs (ds.set i v) ps tl (traceCells trs) ++ frame) m' := by
  obtain ⟨m', hst, hm'⟩ := storeB_words
    (pre := [Obj.words data true .W64 xs, ⟨self + 64, true, [⟨.W64, tl⟩]⟩])
    (post := (pre0 self data trace mapping st xs ds ps tl (traceCells trs)).tail.tail.tail ++ frame)
    (base := mapping) (xs := ds) (by simpa [pre0] using hHolds) i hi v
  exact ⟨m', by simpa [pre0] using hst, by simpa [pre0] using hm'⟩

/-- A store in the position array of the callee's heap. -/
theorem storeB_pre0_ps {policy : CpuPolicy} {m : DataMem} {frame : Heap}
    {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St}
    {xs ds ps : List (BitVec 64)} {tl : BitVec 64}
    {trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)}
    (hHolds : Heap.Holds policy (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame) m)
    (i : Nat) (hi : i < ps.length) (v : BitVec 64) :
    ∃ m', Heap.storeB (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame)
        (mapping + BitVec.ofNat 64 8192 + BitVec.ofNat 64 (8 * i)) .W64 v
      = .ok (pre0 self data trace mapping st xs ds (ps.set i v) tl (traceCells trs) ++ frame) ∧
      Heap.Holds policy
        (pre0 self data trace mapping st xs ds (ps.set i v) tl (traceCells trs) ++ frame) m' := by
  obtain ⟨m', hst, hm'⟩ := storeB_words
    (pre := [Obj.words data true .W64 xs, ⟨self + 64, true, [⟨.W64, tl⟩]⟩,
      Obj.words mapping true .W64 ds])
    (post := (pre0 self data trace mapping st xs ds ps tl (traceCells trs)).tail.tail.tail.tail ++ frame)
    (base := mapping + BitVec.ofNat 64 8192) (xs := ps) (by simpa [pre0] using hHolds) i hi v
  exact ⟨m', by simpa [pre0] using hst, by simpa [pre0] using hm'⟩

/-- A store in the trace size word of the callee's heap. -/
theorem storeB_pre0_tl {policy : CpuPolicy} {m : DataMem} {frame : Heap}
    {self data trace mapping : BitVec 64} {st : Lift.Shuffler.Zig.St}
    {xs ds ps : List (BitVec 64)} {tl : BitVec 64}
    {trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)}
    (hHolds : Heap.Holds policy (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame) m)
    (v : BitVec 64) :
    ∃ m', Heap.storeB (pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame)
        (self + 64) .W64 v
      = .ok (pre0 self data trace mapping st xs ds ps v (traceCells trs) ++ frame) ∧
      Heap.Holds policy
        (pre0 self data trace mapping st xs ds ps v (traceCells trs) ++ frame) m' := by
  obtain ⟨m', hst, hm'⟩ := storeB_single (pre := [Obj.words data true .W64 xs])
    (post := (pre0 self data trace mapping st xs ds ps tl (traceCells trs)).tail.tail ++ frame)
    (addr := self + 64) (x := tl) (by simpa [pre0] using hHolds) v
  exact ⟨m', by simpa [pre0] using hst, by simpa [pre0] using hm'⟩

/-- The register facts that each label needs. -/
def extra (pos : FlatShuffler.Word) (self mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (ds : List (BitVec 64)) (tl : BitVec 64) : Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x.rdi.toBitVec = self
  | .o17, x => x.rdi.toBitVec = self ∧ x.rdx.toBitVec = st.size ∧ pos.toNat < st.size.toNat
  | .o31, x => x.rdi.toBitVec = self ∧ x.rdx.toBitVec = st.size ∧ pos.toNat < st.size.toNat
  | .o49, x => x.rdi.toBitVec = self ∧ x.rdx.toBitVec = st.size ∧ pos.toNat < st.size.toNat
  | .o59, x => x.rdi.toBitVec = self ∧ x.rdx.toBitVec = st.size ∧ pos.toNat < st.size.toNat
  | .o102, x => x.rdi.toBitVec = self ∧ x.rdx.toBitVec = tl ∧ pos.toNat < st.size.toNat ∧
      tl.toNat ≤ 10239
  | .o176, x => x.rcx.toBitVec = mapping ∧ x.rax.toBitVec = st.size ∧
      pos.toNat < st.size.toNat ∧ ∃ d, x.rdi.toBitVec = d ∧ d.toNat < 1024
  | .LBB9_6, x => x.rcx.toBitVec = mapping ∧ x.rax.toBitVec = st.size ∧
      (x.rdx = 18446744073709551615 ∨ ∃ d, x.rdx.toBitVec = d ∧ d.toNat < 1024)
  | .o195, x => x.rcx.toBitVec = mapping ∧ x.rax.toBitVec = st.size ∧
      ∃ d, x.rdx.toBitVec = d ∧ d.toNat < 1024
  | .LBB9_8, _ => True
  | .LBB9_9, _ => True

/-- The invariant of the run of the callee's heap model. -/
def inv (self data trace mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (a : skel_call.In2p) : Lbl → St skel_call.In2p Heap → Prop :=
  fun l x => x.input = a ∧
    ∃ (xs ds ps : List (BitVec 64)) (tl : BitVec 64)
      (trs : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)) (m : DataMem),
      x.mem = pre0 self data trace mapping st xs ds ps tl (traceCells trs) ++ frame ∧
      x.mem.Holds a.policy m ∧
      xs.length = 1024 ∧ ds.length = 1024 ∧ ps.length = 1024 ∧ trs.length = 10240 ∧
      (∀ i, i < st.size.toNat → ∀ v, ds[i]? = some v →
        UInt64.ofBitVec v = 18446744073709551615 ∨ v.toNat < 1024) ∧
      extra pos self mapping st ds tl l x

/-- The size of the cell list of the trace object. -/
theorem traceCells_sum (l : List (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64)) :
    (List.map (fun c : Cell => c.w.bytes) (List.map toCell
      (List.flatMap (fun t => [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]) l))).sum
      = 12 * l.length := by
  induction l with
  | nil => rfl
  | cons t l ih =>
    have h4 : (List.map (fun c : Cell => c.w.bytes) (List.map toCell
        [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩])).sum = 12 := rfl
    simp only [List.flatMap_cons, List.map_append, List.sum_append, ih, List.length_cons, h4]
    omega

/-- The elements of a `take` up to the bound satisfy the test. -/
theorem all_take_getElem? {α : Type} {l : List α} {n : Nat} {f : α → Bool}
    (h : (l.take n).all f = true) : ∀ i, i < n → ∀ a, l[i]? = some a → f a = true := by
  induction l generalizing n with
  | nil => intro i hi a ha; cases ha
  | cons x l ih =>
    intro i hi a ha
    cases n with
    | zero => omega
    | succ n =>
      rw [List.take_succ_cons, List.all_cons, Bool.and_eq_true] at h
      cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at ha
        subst ha
        exact h.1
      | succ j =>
        simp only [List.getElem?_cons_succ] at ha
        exact ih h.2 j (by omega) a ha

/-- The initial heap is the heap of the statement's objects. -/
theorem pre0_objsP (self data trace mapping : BitVec 64) (st : Lift.Shuffler.Zig.St)
    (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) :
    pre0 self data trace mapping st
      ((List.range FlatShuffler.maxStackSize).map fun i =>
        Lift.Shuffler.Internal.Proposed.Layout.slotWord (st.data.toList.getD i default)
          (st.pad.toList.getD i 0))
      st.dest.toList st.pos.toList (BitVec.ofNat 64 st.trace.length)
      ((trace0.toList.flatMap fun t =>
        [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]).map toCell)
      = objsP self data trace mapping st pos trace0 := by
  simp [pre0, objsP, Lift.Shuffler.Internal.Proposed.SwapWithStatement.objects,
    Lift.Shuffler.Internal.Proposed.Layout.data, Lift.Shuffler.Internal.Proposed.Layout.traceSize,
    Lift.Shuffler.Internal.Proposed.Layout.dest, Lift.Shuffler.Internal.Proposed.Layout.pos,
    Lift.Shuffler.Internal.Proposed.Layout.size, Lift.Shuffler.Internal.Proposed.Layout.maxSwapDepth,
    Lift.Shuffler.Internal.Proposed.Layout.dataPtr, Lift.Shuffler.Internal.Proposed.Layout.tracePtr,
    Lift.Shuffler.Internal.Proposed.Layout.mappingPtr, Lift.Shuffler.Internal.Proposed.SwapWithStatement.envOf,
    Lift.Shuffler.Internal.Proposed.Layout.word,
    toObj, toCell, Obj.words, List.map_map]
theorem call_frame : ∀ (self : BitVec 64) (data : BitVec 64) (trace : BitVec 64) (mapping : BitVec 64) (frame : Heap) (st : Lift.Shuffler.Zig.St) (pos : FlatShuffler.Word) (trace0 : Vector (BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64) 10240) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre self data trace mapping frame st pos trace0 a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro self data trace mapping frame st pos trace0 a q hpre hret
  obtain ⟨hC, hrdi, hrsi, hheap, m0, hh0⟩ := hpre
  simp only [callInput] at hrdi hrsi hheap hh0
  refine Lift.Sem.CallArm.Blocks.Returns.inv (inv self data trace mapping frame st pos a)
    (fun r => ∀ m, r.2.Holds a.policy m → frame.Holds a.policy m) ?_ hret ?_
  have hsize : st.size.toNat ≤ 1024 := by
    simpa [FlatShuffler.maxStackSize] using hC.1.1
  · intro l x n hI hstep
    cases l with
    | entry =>
      simp only [inv, extra] at hI
      obtain ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, hrdi⟩ := hI
      simp only [skel_call.blocksP] at hstep
      have hl : x.mem.loadB (x.rdi.toBitVec + 48) .W64 = .ok st.size := by
        rw [hrdi]
        refine Heap.loadB_of_load ?_
        have hcell := Heap.load_of_mem hHolds
          (o := ⟨self + 48, false, [⟨.W64, st.size⟩]⟩) (x := (0, ⟨.W64, st.size⟩))
          (by rw [hmem]; simp [pre0]) (by simp [offsets])
        simpa using hcell
      simp only [hl] at hstep
      split at hstep
      · cases hstep
        simp only [Lift.Sem.CallArm.Next.Inv, inv, extra]
        exact ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, trivial⟩
      · cases hstep
        rename_i hcond
        simp only [Lift.Sem.CallArm.Next.Inv, inv, extra]
        refine ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, hrdi, trivial, ?_⟩
        rw [UInt64.le_iff_toBitVec_le, BitVec.not_le, BitVec.lt_def] at hcond
        rw [UInt64.toBitVec_ofBitVec] at hcond
        rw [hin, hrsi] at hcond
        exact hcond
    | o17 =>
      simp only [inv, extra] at hI
      obtain ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, hrdi, hrdx, hpos⟩ := hI
      simp only [skel_call.blocksP] at hstep
      have h1 : x.mem.loadB (x.rdi.toBitVec + 72) .W64 = .ok mapping := by
        rw [hrdi]
        refine Heap.loadB_of_load ?_
        have hcell := Heap.load_of_mem hHolds
          (o := ⟨self + 72, false, [⟨.W64, mapping⟩]⟩) (x := (0, ⟨.W64, mapping⟩))
          (by rw [hmem]; simp [pre0]) (by simp [offsets])
        simpa using hcell
      simp only [h1, hin, hrsi] at hstep
      have h2 : x.mem.loadB (mapping + pos * 8) .W64 = .ok (ds[pos.toNat]'(by omega)) := by
        rw [BitVec.mul_comm]
        refine Heap.loadB_of_load ?_
        exact Heap.load_words64 (wr := true) hHolds (by rw [hmem]; exact List.mem_append_left _ (by simp [pre0]))
          (by omega)
      simp only [h2] at hstep
      split at hstep
      · cases hstep
        simp only [Lift.Sem.CallArm.Next.Inv, inv, extra]
        exact ⟨trivial, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, trivial⟩
      · cases hstep
        simp only [Lift.Sem.CallArm.Next.Inv, inv, extra]
        exact ⟨trivial, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, hrdi, hrdx, hpos⟩
    | o31 =>
      simp only [inv, extra] at hI
      obtain ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, hrdi, hsz, hpos⟩ := hI
      simp only [skel_call.blocksP] at hstep
      split at hstep
      · cases hstep
        exact ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, trivial⟩
      · cases hstep
        exact ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, hrdi, hsz, hpos⟩
    | o49 =>
      simp only [inv, extra] at hI
      obtain ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, hrdi, hsz, hpos⟩ := hI
      simp only [skel_call.blocksP] at hstep
      split at hstep
      · split at hstep
        · cases hstep
          exact ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, trivial⟩
        · cases hstep
          exact ⟨hin, xs, ds, ps, tl, trs, m, hmem, hHolds, hxs, hds, hps, htr, hc, hrdi, hsz, hpos⟩
      · cases hstep
      · cases hstep

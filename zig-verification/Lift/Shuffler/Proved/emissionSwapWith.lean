namespace SwapRecord

abbrev Entry := BitVec 8 × BitVec 8 × BitVec 16 × BitVec 64

def group (t : Entry) : List Cell :=
  [⟨.W8, t.1⟩, ⟨.W8, t.2.1⟩, ⟨.W16, t.2.2.1⟩, ⟨.W64, t.2.2.2⟩]

theorem group_size (t : Entry) : cellsSize (group t) = 12 := by
  simp [group, cellsSize, Width.bytes]

theorem trace_cells_eq (T : Vector Entry 10240) : tcells T = T.toList.flatMap group := by
  simp only [tcells, group, List.map_flatMap, toCell]
  rfl

theorem trace_store {self data trace mapping traceSize : BitVec 64} {frame : Heap} {st : Zig.St}
    {dest positions dataW : List (BitVec 64)} {T : Vector Entry 10240}
    {pol : CpuPolicy} {m : DataMem}
    (k r : Nat) (hk : k < 10240) (hr : r < 12) (w : Width) (v : w.type) (entry : Entry)
    (he : cellSet (group T[k]) r w v = group entry)
    (hc : (cellGet (group T[k]) r w).isSome = true)
    (hh : Heap.Holds pol (hOf self data trace mapping frame st traceSize dest positions dataW (tcells T)) m) :
    (hOf self data trace mapping frame st traceSize dest positions dataW (tcells T)).storeB
      (trace + BitVec.ofNat 64 (k * 12 + r)) w v =
      .ok (hOf self data trace mapping frame st traceSize dest positions dataW (tcells (T.set k entry))) := by
  have hlist : k < T.toList.length := by simpa only [Vector.length_toList] using hk
  have hset : cellSet (tcells T) (k * 12 + r) w v = tcells (T.set k entry) := by
    rw [trace_cells_eq, trace_cells_eq, Vector.toList_set hk]
    apply cellSet_flatMap_set v entry group_size hlist hr
    simpa only [Vector.getElem_toList] using he
  have hget : cellGet (tcells T) (k * 12 + r) w = cellGet (group T[k]) r w := by
    rw [trace_cells_eq, cellGet_flatMap w group_size hlist hr, Vector.getElem_toList]
  have haddr : (trace + BitVec.ofNat 64 (k * 12 + r) - trace).toNat = k * 12 + r := by
    bv_omega
  have hobj : (⟨trace, true, tcells (T.set k entry)⟩ : Obj) =
      (⟨trace, true, tcells T⟩ : Obj).setAt (trace + BitVec.ofNat 64 (k * 12 + r)) w v := by
    simp only [Obj.setAt, haddr, hset]
  apply Heap.storeB_of_storeAt hh
  simp only [hOf]
  rw [hobj]
  refine .tail (.tail (.tail (.tail (.head rfl ?_))))
  simpa only [haddr, hget] using hc

theorem load_size32 {self data trace mapping traceSize : BitVec 64} {frame : Heap} {st : Zig.St}
    {dest positions dataW : List (BitVec 64)} {cells : List Cell}
    {pol : CpuPolicy} {m : DataMem}
    (hh : Heap.Holds pol (hOf self data trace mapping frame st traceSize dest positions dataW cells) m) :
    (hOf self data trace mapping frame st traceSize dest positions dataW cells).loadB
      (self + 48) .W32 = .ok (st.size.extractLsb' 0 32) := by
  have ho : Obj.words (self + 48) false .W64 [st.size] ∈
      hOf self data trace mapping frame st traceSize dest positions dataW cells := by
    simp only [hOf, List.mem_cons, List.mem_singleton, or_true, true_or]
  have hs := Heap.loadB_words_slice hh ho .W32 (index := 0) (offset := 0)
    (by simp) (by decide)
  simpa only [Nat.zero_mul, Nat.add_zero, BitVec.ofNat_eq_ofNat, BitVec.add_zero,
    Width.bits, List.getElem_cons_zero] using hs


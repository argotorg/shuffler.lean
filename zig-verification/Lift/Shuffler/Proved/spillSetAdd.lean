/-! ### The cells of the buffer of the statement -/

theorem cellsSize_bytes (l : List (BitVec 8)) :
    cellsSize (l.flatMap fun v => [⟨.W8, v⟩]) = l.length := by
  induction l with
  | nil => rfl
  | cons x t ih =>
    rw [List.flatMap_cons, cellsSize_append, ih]
    have hc : cellsSize ([⟨.W8, x⟩] : List Cell) = 1 := rfl
    rw [hc, List.length_cons]
    omega

theorem cellGet_bytes (l : List (BitVec 8)) (k : Nat) (hk : k < l.length) :
    cellGet (l.flatMap fun v => [⟨.W8, v⟩]) k .W8 = some l[k] := by
  induction l generalizing k with
  | nil => cases hk
  | cons x t ih =>
    rw [List.flatMap_cons]
    cases k with
    | zero =>
      rw [cellGet_append_left _ (by simp [cellsSize]), cellGet_cons_zero, Cell.get_self]
      simp
    | succ k =>
      have hc : cellsSize ([⟨.W8, x⟩] : List Cell) = 1 := rfl
      rw [cellGet_append_right _ (by rw [hc]; omega), hc, Nat.add_sub_cancel,
        ih k (by simpa using hk)]
      simp

theorem cellSet_bytes (l : List (BitVec 8)) (k : Nat) (hk : k < l.length) (v : BitVec 8) :
    cellSet (l.flatMap fun v => [⟨.W8, v⟩]) k .W8 v
      = (l.set k v).flatMap fun v => [⟨.W8, v⟩] := by
  induction l generalizing k with
  | nil => cases hk
  | cons x t ih =>
    rw [List.flatMap_cons]
    cases k with
    | zero =>
      rw [cellSet_append_left _ _ (by simp [cellsSize]), cellSet_cons_zero, List.set_cons_zero,
        List.flatMap_cons]
      simp
    | succ k =>
      have hc : cellsSize ([⟨.W8, x⟩] : List Cell) = 1 := rfl
      rw [cellSet_append_right _ _ (by rw [hc]; omega), hc, Nat.add_sub_cancel,
        ih k (by simpa using hk), List.set_cons_succ, List.flatMap_cons]

theorem cells_spilledBuf {n : Nat} (buf : Vector (BitVec 8) n) (sp : BitVec 64) :
    (toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp)).cells
      = buf.toList.flatMap (fun v => [⟨.W8, v⟩]) := by
  simp [Lift.Shuffler.Internal.AddStatement.spilledBuf, toObj, toCell, Lift.Trusted.Encode.encode,
    List.map_flatMap]

theorem toObj_spilledField (self sp : BitVec 64) :
    toObj (Lift.Shuffler.Internal.AddStatement.spilledField self sp) = ⟨self, false, [⟨.W64, sp⟩]⟩ :=
  rfl

theorem size_spilledBuf {n : Nat} (buf : Vector (BitVec 8) n) (sp : BitVec 64) :
    (toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp)).size = n := by
  show cellsSize (toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp)).cells = n
  rw [cells_spilledBuf, cellsSize_bytes, Vector.length_toList]

theorem set_spilledBuf {n : Nat} (buf : Vector (BitVec 8) n) (sp : BitVec 64) (k : Nat) (hk : k < n)
    (hsp : sp.toNat + n ≤ 2 ^ 64) :
    Obj.set (sp + BitVec.ofNat 64 k) .W8 (1 : BitVec 8)
        (toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp))
      = toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf (buf.set k 1 hk) sp) := by
  have hsz := size_spilledBuf buf sp
  have hk' : k < buf.toList.length := by simpa using hk
  have hset : (buf.set k 1 hk).toList = buf.toList.set k 1 := Vector.toList_set ..
  have key : setCells sp (sp + BitVec.ofNat 64 k) .W8 (1 : BitVec 8) 0
        (buf.toList.flatMap fun v => [⟨.W8, v⟩])
      = (buf.set k 1 hk).toList.flatMap (fun v => [⟨.W8, v⟩]) := by
    have hb : 0 + cellsSize (buf.toList.flatMap fun v => [⟨.W8, v⟩]) ≤ 2 ^ 64 := by
      rw [cellsSize_bytes, Vector.length_toList]; omega
    have hd : 0 + k < 2 ^ 64 := by omega
    have h := setCells_eq_cellSet sp .W8 1 (buf.toList.flatMap fun v => [⟨.W8, v⟩]) 0 k hb hd
    rw [Nat.zero_add] at h
    rw [h, cellSet_bytes buf.toList k hk' 1, hset]
  simp only [Obj.set, Lift.Shuffler.Internal.AddStatement.spilledBuf, toObj, toCell,
    Lift.Trusted.Encode.encode, List.map_flatMap, List.map_cons, List.map_nil, ite_true]
  rw [key]

theorem Heap.store_eq_map {h : Heap} {a : BitVec 64} {w : Width} {v : w.type}
    (hc : h.any (fun o => o.writable && (o.get a w).isSome) = true) :
    h.store a w v = .ok (h.map (Obj.set a w v)) := by
  unfold Heap.store
  rw [hc]
  rfl

theorem cellGet_buf {n : Nat} (buf : Vector (BitVec 8) n) (sp : BitVec 64) (k : Nat) (hk : k < n)
    (hn : n ≤ 2 ^ 64) :
    cellGet (toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp)).cells
        ((sp + BitVec.ofNat 64 k) - sp).toNat .W8 = some (buf[k]'hk) := by
  have hcg : cellGet (buf.toList.flatMap fun v => [⟨.W8, v⟩]) k .W8 = some buf[k] := by
    rw [← Vector.getElem_toList (h := by simpa using hk)]
    exact cellGet_bytes buf.toList k (by simpa using hk)
  have hk64 : k < 2 ^ 64 := by omega
  have hoff : (sp + BitVec.ofNat 64 k - sp).toNat = k := by
    rw [BitVec.add_comm sp (BitVec.ofNat 64 k), BitVec.add_sub_cancel, BitVec.toNat_ofNat,
      Nat.mod_eq_of_lt hk64]
  rw [hoff, cells_spilledBuf]
  exact hcg

theorem Obj.get_isSome_buf {n : Nat} (buf : Vector (BitVec 8) n) (sp : BitVec 64) (k : Nat)
    (hk : k < n) :
    ((toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp)).get
      (sp + BitVec.ofNat 64 k) .W8).isSome := by
  apply Obj.get_isSome_of_cell
  refine ⟨(k, ⟨.W8, buf[k]⟩), ?_, rfl, rfl⟩
  have hcg : cellGet (buf.toList.flatMap fun v => [⟨.W8, v⟩]) k .W8 = some buf[k] := by
    rw [← Vector.getElem_toList (h := by simpa using hk)]
    exact cellGet_bytes buf.toList k (by simpa using hk)
  rw [cells_spilledBuf]
  simpa using mem_offsets_of_cellGet 0 hcg

/-! ### The L3 run on the four paths -/

theorem run_of_novar {n : Nat} (slot : Lift.Pilot.Slot) (buf : Vector (BitVec 8) n)
    (h : ¬ (slot.kind = 0 ∧ slot.opcode ≠ 0)) :
    Lift.Pilot.AddSpec.run slot buf = some (1, buf) := by
  rw [Lift.Pilot.AddSpec.run, if_neg h]

theorem run_of_byte {n : Nat} (slot : Lift.Pilot.Slot) (buf : Vector (BitVec 8) n)
    (h : slot.kind = 0 ∧ slot.opcode ≠ 0) (hk : slot.payload.toNat < n)
    (hb : buf[slot.payload.toNat]'hk = 0) :
    Lift.Pilot.AddSpec.run slot buf = some (0, buf.set slot.payload.toNat 1 hk) := by
  rw [Lift.Pilot.AddSpec.run, if_pos h, dif_pos hk, if_pos hb]

theorem run_of_byte_ne {n : Nat} (slot : Lift.Pilot.Slot) (buf : Vector (BitVec 8) n)
    (h : slot.kind = 0 ∧ slot.opcode ≠ 0) (hk : slot.payload.toNat < n)
    (hb : ¬ buf[slot.payload.toNat]'hk = 0) :
    Lift.Pilot.AddSpec.run slot buf = some (1, buf) := by
  rw [Lift.Pilot.AddSpec.run, if_pos h, dif_pos hk, if_neg hb]

theorem post_error {n : Nat} (slot : Lift.Pilot.Slot) (buf : Vector (BitVec 8) n) (sp : BitVec 64)
    (policy : CpuPolicy) (m : DataMem) (h : Heap) (r : Lift.Trusted.Field)
    (hh : h.Holds policy m)
    (hmem : toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp) ∈ h)
    (hrun : Lift.Pilot.AddSpec.run slot buf = some (1, buf))
    (hr : Lift.Trusted.Encode.encode (1 : BitVec 16) = [r]) :
    Lift.Shuffler.Internal.AddStatement.post slot buf sp policy r m :=
  ⟨(1, buf), hrun, hr, Bridge.has_of_holds_mem hh hmem⟩

theorem post_ok {n : Nat} (slot : Lift.Pilot.Slot) (buf : Vector (BitVec 8) n) (sp : BitVec 64)
    (policy : CpuPolicy) (m : DataMem) (h : Heap) (r : Lift.Trusted.Field)
    (hk : slot.payload.toNat < n) (hh : h.Holds policy m)
    (hmem : toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf (buf.set slot.payload.toNat 1 hk) sp)
      ∈ h)
    (hrun : Lift.Pilot.AddSpec.run slot buf = some (0, buf.set slot.payload.toNat 1 hk))
    (hr : Lift.Trusted.Encode.encode (0 : BitVec 16) = [r]) :
    Lift.Shuffler.Internal.AddStatement.post slot buf sp policy r m :=
  ⟨(0, buf.set slot.payload.toNat 1 hk), hrun, hr, Bridge.has_of_holds_mem hh hmem⟩

/-! ### The bits of the slot word -/

theorem kind_test (s : Lift.Pilot.Slot) :
    ((UInt64.ofBitVec s.word >>> (32 : UInt64)).toUInt8.toUInt64 = 0) ↔ s.kind = 0 := by
  obtain ⟨p, k, o, d⟩ := s; simp only [Lift.Pilot.Slot.word]; bv_decide

theorem kind_test_ne (s : Lift.Pilot.Slot) :
    ((UInt64.ofBitVec s.word >>> (32 : UInt64)).toUInt8.toUInt64 ≠ 0) ↔ s.kind ≠ 0 := by
  obtain ⟨p, k, o, d⟩ := s; simp only [Lift.Pilot.Slot.word]; bv_decide

theorem opcode_test (s : Lift.Pilot.Slot) :
    (UInt64.ofBitVec s.word &&& (280375465082880 : UInt64) = 0) ↔ s.opcode = 0 := by
  obtain ⟨p, k, o, d⟩ := s; simp only [Lift.Pilot.Slot.word]; bv_decide

theorem opcode_test_ne (s : Lift.Pilot.Slot) :
    (UInt64.ofBitVec s.word &&& (280375465082880 : UInt64) ≠ 0) ↔ s.opcode ≠ 0 := by
  obtain ⟨p, k, o, d⟩ := s; simp only [Lift.Pilot.Slot.word]; bv_decide

theorem ofNat_payload (p : BitVec 32) : BitVec.ofNat 64 p.toNat = BitVec.setWidth 64 p := by
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_setWidth, BitVec.toNat_ofNat]

theorem payload_zext (s : Lift.Pilot.Slot) :
    BitVec.zeroExtend 64 (BitVec.truncate 32 s.word) = BitVec.ofNat 64 s.payload.toNat := by
  rw [ofNat_payload]
  obtain ⟨p, k, o, d⟩ := s; simp only [Lift.Pilot.Slot.word]; bv_decide

theorem payload_rcx (s : Lift.Pilot.Slot) :
    (UInt64.ofBitVec s.word).toUInt32.toUInt64.toBitVec = BitVec.ofNat 64 s.payload.toNat := by
  rw [ofNat_payload]
  obtain ⟨p, k, o, d⟩ := s; simp only [Lift.Pilot.Slot.word]; bv_decide

theorem rax_err (x : UInt64) :
    BitVec.setWidth 16 ((x &&& 18446744073709486080) ||| (1 &&& 65535)).toBitVec = 1 := by
  bv_decide

theorem byte_zero (v2 : BitVec 8) : (UInt64.ofBitVec (BitVec.zeroExtend 64 v2) = 0) ↔ v2 = 0 := by
  bv_decide

theorem truncate_one : BitVec.truncate 8 (1 : BitVec 64) = (1 : BitVec 8) := by decide
theorem refines_l3 : ∀ (self : BitVec 64) (sp : BitVec 64) (frame : Heap) (n : Nat) (buf : Vector (BitVec 8) n) (slot : Lift.Pilot.Slot), Refines (fun (_ : Unit) => SimArr self sp frame n buf slot) (fun _ a y r => Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP self sp n buf slot ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.AddStatement.post slot buf sp a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) (fun _ y => Lift.Pilot.AddSpec.run slot buf = some y) l2p.returns := by
  intro self sp frame n buf slot
  intro _ a y hs hy
  obtain ⟨hC, hself, hrsi, hheap, w, hw⟩ := hs
  have hshape : a.heap = toObj (Lift.Shuffler.Internal.AddStatement.spilledField self sp)
      :: toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp) :: frame := by
    rw [hheap]; simp [objsP, Lift.Shuffler.Internal.AddStatement.objects]
  have hbufmem : toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp) ∈ a.heap := by
    rw [hshape]; exact List.mem_cons_of_mem _ List.mem_cons_self
  have hnoWrap : sp.toNat + n ≤ 2 ^ 64 := by
    have := hw.noWrap _ hbufmem
    rwa [size_spilledBuf] at this
  have hhas := Bridge.has_of_holds_mem hw hbufmem
  have hfound1 : Heap.Found self .W64 sp a.heap := by
    rw [hshape]
    refine Heap.Found.head ?_
    simp [Lift.Shuffler.Internal.AddStatement.spilledField, toObj, toCell, Lift.Trusted.Encode.encode,
      cellGet, Cell.get]
  have hload1 : a.heap.load self .W64 = .ok sp := Heap.load_of_found hw hfound1
  have hrsi' : a.rsi = UInt64.ofBitVec slot.word := by rw [← hrsi]
  have hn64 : n ≤ 2 ^ 64 := by omega
  have hload2 : ∀ (k : Nat) (hk : k < n),
      a.heap.load (sp + BitVec.ofNat 64 k) .W8 = .ok (buf[k]'hk) := by
    intro k hk
    refine Heap.load_of_found hw ?_
    rw [hshape]
    refine Heap.Found.tail (Heap.Found.head ?_)
    exact cellGet_buf buf sp k hk hn64
  have hstore : ∀ (k : Nat) (hk : k < n),
      a.heap.store (sp + BitVec.ofNat 64 k) .W8 (1 : BitVec 8)
        = .ok (a.heap.map (Obj.set (sp + BitVec.ofNat 64 k) .W8 1)) := by
    intro k hk
    apply Heap.store_eq_map
    rw [hshape, List.any_cons, List.any_cons]
    have h2 : ((toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp)).writable
        && ((toObj (Lift.Shuffler.Internal.AddStatement.spilledBuf buf sp)).get
          (sp + BitVec.ofNat 64 k) .W8).isSome) = true := by
      rw [Obj.get_isSome_buf buf sp k hk]; rfl
    simp only [h2, Bool.or_true, Bool.true_or]
  lift_straight
  all_goals simp only [initP] at *
  case ret_1 =>
    have hk0 : slot.kind = 0 := by
      rw [hrsi'] at hp1; exact (kind_test slot).mp hp1
    have ho0 : slot.opcode = 0 := by
      rw [hrsi'] at hp2; exact (opcode_test slot).mp hp2
    have hrun : Lift.Pilot.AddSpec.run slot buf = some (1, buf) :=
      run_of_novar slot buf (by simp [hk0, ho0])
    have hyval : y = (1, buf) := by
      rw [hrun] at hy; exact (Option.some.inj hy).symm
    have henc : Lift.Trusted.Encode.encode (1 : BitVec 16)
        = [⟨.W16, BitVec.setWidth 16
            ((a.rax &&& 18446744073709486080) ||| (1 &&& 65535)).toBitVec⟩] := by
      rw [rax_err]; rfl
    refine ⟨?_, hheap, ?_⟩
    · rw [hyval]; exact henc
    · intro m hm
      exact post_error slot buf sp a.policy m a.heap _ hm hbufmem hrun henc
  case ret_4 =>
    have hp1' : ¬ ((UInt64.ofBitVec slot.word >>> (32 : UInt64)).toUInt8.toUInt64 = 0) := by
      rw [hrsi'] at hp1; exact hp1
    have hkne : slot.kind ≠ 0 := fun h0 => hp1' ((kind_test slot).mpr h0)
    have hrun : Lift.Pilot.AddSpec.run slot buf = some (1, buf) :=
      run_of_novar slot buf (by rintro ⟨h1, h2⟩; exact hkne h1)
    have hyval : y = (1, buf) := by
      rw [hrun] at hy; exact (Option.some.inj hy).symm
    have henc : Lift.Trusted.Encode.encode (1 : BitVec 16)
        = [⟨.W16, BitVec.setWidth 16
            ((a.rax &&& 18446744073709486080) ||| (1 &&& 65535)).toBitVec⟩] := by
      rw [rax_err]; rfl
    refine ⟨?_, hheap, ?_⟩
    · rw [hyval]; exact henc
    · intro m hm
      exact post_error slot buf sp a.policy m a.heap _ hm hbufmem hrun henc
  case ret_3 =>
    have hk0 : slot.kind = 0 := by
      rw [hrsi'] at hp1; exact (kind_test slot).mp hp1
    have hop : slot.opcode ≠ 0 := by
      rw [hrsi'] at hp2; exact (opcode_test_ne slot).mp hp2
    have hk : slot.payload.toNat < n := by
      have := hC ⟨hk0, hop⟩; simpa using this
    have hv1 : v1 = sp := by
      rw [hself, hload1] at hp3; exact (Res.ok.inj hp3).symm
    have haddr : v1 + BitVec.zeroExtend 64 (BitVec.truncate 32 a.rsi.toBitVec) * 1

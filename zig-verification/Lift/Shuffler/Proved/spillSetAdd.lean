    (hs : 0 < O.size) : O ∉ h₂ := by
  intro hO₂
  have hp := (List.pairwise_append.mp hh.apart).2.2 O hO O hO₂ (Or.inl hw)
  unfold Obj.Apart at hp
  omega

theorem sum_map_one (l : List (BitVec 8)) : (l.map (fun _ => 1)).sum = l.length := by
  induction l with
  | nil => rfl
  | cons a t ih => simp [ih]; omega

/-- The size of the buffer object is the length of the buffer. -/
theorem bufObj_size (sp : BitVec 64) (n : Nat) (buf : Vector (BitVec 8) n) :
    (Obj.words sp true .W8 buf.toList).size = n := by
  have h1 : (buf.toList.map (Cell.mk .W8)).map (fun c => c.w.bytes) = buf.toList.map (fun _ => 1) := by
    rw [List.map_map]
    rfl
  simp only [Obj.words, Obj.size, h1, sum_map_one, Vector.length_toList]

/-- The test of the kind of a slot, on the word of the slot. -/
theorem kind_slot (rsi : UInt64) (slot : Lift.Pilot.Slot) (hr : rsi = UInt64.ofBitVec slot.word)
    (h : (rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0) : slot.kind = 0 := by
  obtain ⟨p, k, o, d⟩ := slot
  rw [hr] at h
  exact (kind_zero_word p k o d).mp h

/-- The test of the opcode of a slot, on the word of the slot. -/
theorem opcode_slot (rsi : UInt64) (slot : Lift.Pilot.Slot) (hr : rsi = UInt64.ofBitVec slot.word)
    (h : rsi &&& 280375465082880 ≠ 0) : slot.opcode ≠ 0 := by
  obtain ⟨p, k, o, d⟩ := slot
  rw [hr] at h
  intro ho
  exact h ((opcode_word p k o d).mpr ho)

/-- The payload of a slot, on the word of the slot. -/
theorem rcx_slot (rsi : UInt64) (slot : Lift.Pilot.Slot) (hr : rsi = UInt64.ofBitVec slot.word) :
    (rsi.toUInt32.toUInt64).toBitVec = BitVec.setWidth 64 slot.payload := by
  obtain ⟨p, k, o, d⟩ := slot
  rw [hr]
  exact rcx_word p k o d

/-- The payload of a variable slot is an index of the buffer. -/
theorem payload_lt (n : Nat) (buf : Vector (BitVec 8) n) (slot : Lift.Pilot.Slot)
    (hC : Lift.Pilot.AddSpec.C buf slot) (hk : slot.kind = 0) (ho : slot.opcode ≠ 0) :
    slot.payload.toNat < n := by
  have := hC ⟨hk, ho⟩
  simpa using this

/-- A map that fixes each element of a list. -/
theorem map_eq_self_of {α : Type} {f : α → α} {l : List α} (h : ∀ a ∈ l, f a = a) :
    l.map f = l := by
  induction l with
  | nil => rfl
  | cons a t ih =>
    simp only [List.map_cons, h a (List.mem_cons_self ..),
      ih (fun b hb => h b (List.mem_cons_of_mem _ hb))]

/-- The heap after the call: the input heap, or the input heap with the byte of the buffer at the
payload index set to 1. -/
theorem returns_heap (self sp : BitVec 64) (frame : Heap) (n : Nat) (buf : Vector (BitVec 8) n)
    (slot : Lift.Pilot.Slot) (a : skel_call.In2p) (q : UInt64 × Heap)
    (hpre : callPre self sp frame n buf slot a) (h : skel_call.l2p.returns a q) :
    q.2 = a.heap ∨ ∃ k : Nat, k < n ∧
      q.2 = a.heap.map (Obj.set (sp + BitVec.ofNat 64 k) .W8 (BitVec.truncate 8 (1 : BitVec 64))) := by
  obtain ⟨hC, hrdi, hrsi, hheap, m₀, hHolds₀⟩ := hpre
  simp only [callInput] at hrdi hrsi hheap hHolds₀
  have hrdi' : a.rdi.toBitVec = self := hrdi
  have hrsi' : a.rsi = UInt64.ofBitVec slot.word := by
    rw [← UInt64.toBitVec_inj]
    simpa using hrsi
  have hheap' : a.heap = objsP self sp n buf slot ++ frame := hheap
  rw [hheap'] at hHolds₀
  have hload : a.heap.load self .W64 = .ok sp := by
    rw [hheap']
    exact load_field self sp n buf slot frame a.policy m₀ hHolds₀
  let P : Heap → Prop := fun hh => hh = a.heap ∨ ∃ k : Nat, k < n ∧
      hh = a.heap.map (Obj.set (sp + BitVec.ofNat 64 k) .W8 (BitVec.truncate 8 (1 : BitVec 64)))
  let I : Lbl → St skel_call.In2p Heap → Prop := fun l x => match l with
    | .entry => x.input = a ∧ x.mem = a.heap
    | .o15 => x.input = a ∧ x.mem = a.heap ∧ slot.kind = 0
    | .o30 => x.input = a ∧ x.mem = a.heap ∧ slot.kind = 0 ∧ slot.opcode ≠ 0
    | .o41 => x.input = a ∧ x.mem = a.heap ∧ slot.payload.toNat < n ∧
        x.rdx.toBitVec = sp ∧ x.rcx.toBitVec = BitVec.ofNat 64 slot.payload.toNat
    | .LBB6_4 => P x.mem
  let Q : UInt64 × Heap → Prop := fun r => P r.2
  have hmain : P q.2 := by
    refine Lift.Sem.CallArm.Blocks.Returns.inv (b := skel_call.blocksP) (callee := noCall)
      I Q ?_ h ⟨rfl, rfl⟩
    intro l x nx hx hstep
    cases l with
    | entry =>
      obtain ⟨hin, hmem⟩ := hx
      simp only [skel_call.blocksP] at hstep
      split at hstep
      · rename_i hc
        cases hstep
        exact ⟨hin, hmem, kind_slot a.rsi slot hrsi' (by rw [hin] at hc; exact hc)⟩
      · cases hstep
        exact Or.inl hmem
    | o15 =>
      obtain ⟨hin, hmem, hkind⟩ := hx
      simp only [skel_call.blocksP] at hstep
      split at hstep
      · cases hstep
        exact Or.inl hmem
      · rename_i hc
        cases hstep
        exact ⟨hin, hmem, hkind, opcode_slot a.rsi slot hrsi' (by rw [hin] at hc; exact hc)⟩
    | o30 =>
      obtain ⟨hin, hmem, hkind, hop⟩ := hx
      have hpl : slot.payload.toNat < n := payload_lt n buf slot hC hkind hop
      simp only [skel_call.blocksP] at hstep
      split at hstep
      · rename_i v hv
        split at hstep
        · rename_i v1 hv1
          split at hstep
          · rename_i hcond
            cases hstep
            have hv' : a.heap.load self .W64 = .ok v := by
              rw [hmem, hin, hrdi'] at hv
              exact hv
            have hvsp : v = sp := by
              rw [hload] at hv'
              exact (Res.ok.inj hv').symm
            refine ⟨hin, hmem, hpl, ?_, ?_⟩
            · show (UInt64.ofBitVec v).toBitVec = sp
              rw [UInt64.toBitVec_ofBitVec, hvsp]
            · show (x.input.rsi.toUInt32.toUInt64).toBitVec = BitVec.ofNat 64 slot.payload.toNat
              rw [hin, rcx_slot a.rsi slot hrsi', setWidth_ofNat]
          · cases hstep
            exact Or.inl hmem
        all_goals cases hstep
      all_goals cases hstep
    | o41 =>
      obtain ⟨hin, hmem, hpl, hrdx, hrcx⟩ := hx
      simp only [skel_call.blocksP] at hstep
      split at hstep
      · rename_i h' hst
        cases hstep
        refine Or.inr ⟨slot.payload.toNat, hpl, ?_⟩
        have hst' : a.heap.store (sp + BitVec.ofNat 64 slot.payload.toNat) .W8
            (BitVec.truncate 8 (1 : BitVec 64)) = .ok h' := by
          rw [hmem] at hst
          rw [hrdx, hrcx] at hst
          simpa using hst
        obtain ⟨he, -⟩ := Heap.store_ok hst'
        exact he
      all_goals cases hstep
    | LBB6_4 =>
      simp only [skel_call.blocksP] at hstep
      cases hstep
      exact hx
  exact hmain
theorem call_frame : ∀ (self : BitVec 64) (sp : BitVec 64) (frame : Heap) (n : Nat) (buf : Vector (BitVec 8) n) (slot : Lift.Pilot.Slot) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre self sp frame n buf slot a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro self sp frame n buf slot a q hpre hret m hm
  obtain ⟨hC, hrdi, hrsi, hheap, hm₀⟩ := hpre
  simp only [callInput] at hrdi hrsi hheap hm₀
  have hheap' : a.heap = objsP self sp n buf slot ++ frame := hheap
  have hpre' : callPre self sp frame n buf slot a :=
    ⟨hC, hrdi, hrsi, hheap, hm₀⟩
  obtain ⟨m₀, hHolds₀⟩ := hm₀
  rw [hheap'] at hHolds₀
  have hbufP : Obj.words sp true .W8 buf.toList ∈ objsP self sp n buf slot := by
    rw [objsP_eq]
    exact List.mem_cons_of_mem _ (List.mem_cons_self ..)
  have hbuf2 : Obj.words sp true .W8 buf.toList ∈ objsP self sp n buf slot ++ frame :=
    List.mem_append_left _ hbufP
  rcases returns_heap self sp frame n buf slot a q hpre' hret with hq | ⟨k, hk, hq⟩
  · rw [hq] at hm
    exact Heap.Holds.sublist hm (by rw [hheap']; exact List.sublist_append_right _ _)
  · rw [hq] at hm
    refine Heap.Holds.sublist hm ?_
    have hk' : k < buf.toList.length := by simpa using hk
    have hfix : ∀ o ∈ frame,
        Obj.set (sp + BitVec.ofNat 64 k) .W8 (BitVec.truncate 8 (1 : BitVec 64)) o = o := by
      intro o ho
      have hoa : o ∈ objsP self sp n buf slot ++ frame :=
        (List.sublist_append_right _ _).subset ho
      have hne : o ≠ Obj.words sp true .W8 buf.toList := by
        intro he
        have hmemF : Obj.words sp true .W8 buf.toList ∈ frame := by rw [← he]; exact ho
        exact not_mem_of_holds_append (h₁ := objsP self sp n buf slot)
          (O := Obj.words sp true .W8 buf.toList) hHolds₀ hbufP rfl
          (by rw [bufObj_size]; omega) hmemF
      have hx0 : (k, (⟨.W8, buf.toList[k]⟩ : Cell)) ∈
          offsets 0 (Obj.words sp true .W8 buf.toList).cells := by
        show (k, (⟨.W8, buf.toList[k]⟩ : Cell)) ∈ offsets 0 (buf.toList.map (Cell.mk .W8))
        simpa using mem_offsets_words .W8 buf.toList 0 k hk'
      have hset := Heap.Holds.set_other hHolds₀ hbuf2 rfl hx0 hoa hne
        (BitVec.truncate 8 (1 : BitVec 64))
      simpa only [Obj.words] using hset
    have hsub0 : frame.Sublist a.heap := by
      rw [hheap']
      exact List.sublist_append_right _ _
    have hmap := hsub0.map (Obj.set (sp + BitVec.ofNat 64 k) .W8 (BitVec.truncate 8 (1 : BitVec 64)))
    rwa [map_eq_self_of hfix] at hmap
end call_frame.skel_proof
theorem call_frame : call_frame.skel_statement := @call_frame.skel_proof.call_frame
def call_shape.skel_statement : Prop := ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2
namespace call_shape.skel_proof
skel_proof_aliases call_shape.skel_proof excluding [skel_call.summary_shape, call_shape]
namespace skel_call

theorem summary_shape : ∀ a r, l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2 := by
  intro a r h
  refine Lift.Sem.CallArm.Blocks.Returns.inv (fun _ x => Lift.Sem.CallArm.Shape a.heap x.mem) (fun r => Lift.Sem.CallArm.Shape a.heap r.2) ?_ h (Lift.Sem.CallArm.Shape.refl _)
  rintro l x n hsh hstep
  cases l with
  | entry =>
    simp only [blocksP, Res.ok.injEq] at hstep
    subst hstep
    split <;> exact hsh
  | o15 =>
    simp only [blocksP, Res.ok.injEq] at hstep
    subst hstep
    split <;> exact hsh
  | o30 =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i v hl0
      split at hstep
      · rename_i v1 hl1
        simp only [Res.ok.injEq] at hstep
        subst hstep
        split <;> exact hsh
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o41 =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i h hst0
      simp only [Res.ok.injEq] at hstep
      subst hstep
      exact (Lift.Sem.CallArm.Shape.store hsh hst0)
    · cases hstep
    · cases hstep
  | LBB6_4 =>
    simp only [blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact hsh

end skel_call
theorem call_shape : ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2 := by exact skel_call.summary_shape
end call_shape.skel_proof
theorem call_shape : call_shape.skel_statement := @call_shape.skel_proof.call_shape
theorem call_summary : callSummary := by
  intro self sp frame n buf slot a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 self sp frame n buf slot () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨⟨r, hrel, hmap⟩, call_shape a q hq, call_frame self sp frame n buf slot a q hs hq⟩⟩
end skel_semantic
end Skel.Gen.Level3.Shuffler.spillSetAdd

namespace skel_semantic
structure In2 where
  policy : CpuPolicy
  mem : DataMem
  sp : BitVec 64
  rax : UInt64
  rsi : UInt64
  rdi : UInt64

inductive Lbl where
  | entry
  | o15
  | o30
  | o41
  | LBB6_4

structure St (I M : Type) where
  input : I
  rax : UInt64
  rcx : UInt64
  rdx : UInt64
  mem : M

def init (a : In2) : St In2 DataMem := ⟨a, a.rax, 0, 0, a.mem⟩

abbrev Private (sp b : BitVec 64) : Prop := (b - (sp - 0)).toNat < 8

abbrev Clear (sp a : BitVec 64) (n : Nat := 8) : Prop := ∀ i, i < n → ¬ Private sp (a + BitVec.ofNat 64 i)

def blocks : Leaf Lbl (St In2 DataMem) (UInt64 × DataMem) where
  step
    | .entry, x =>
      .ok (if (x.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then .goto .o15 { x with rcx := x.input.rsi >>> (32 : UInt64), rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535) } else .goto .LBB6_4 { x with rcx := x.input.rsi >>> (32 : UInt64), rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535) })
    | .o15, x =>
      .ok (if x.input.rsi &&& 280375465082880 = 0 then .goto .LBB6_4 { x with rcx := 280375465082880 &&& x.input.rsi } else .goto .o30 { x with rcx := 280375465082880 &&& x.input.rsi })
    | .o30, x =>
      match readRam x.input.policy x.mem x.input.rdi.toBitVec .W64 with
      | .ok v =>
        match readRam x.input.policy x.mem (v + BitVec.zeroExtend 64 (BitVec.truncate 32 (x.input.rsi.toBitVec)) * 1) .W8 with
        | .ok v1 =>
          .ok (if UInt64.ofBitVec (BitVec.zeroExtend 64 v1) = 0 then .goto .o41 { x with rdx := UInt64.ofBitVec v, rcx := (x.input.rsi).toUInt32.toUInt64 } else .goto .LBB6_4 { x with rdx := UInt64.ofBitVec v, rcx := (x.input.rsi).toUInt32.toUInt64 })
        | .error _ => .stuck "read"
      | .error _ => .stuck "read"
    | .o41, x =>
      if Clear x.input.sp (x.rdx.toBitVec + x.rcx.toBitVec * 1) 1 then
        match writeRam x.input.policy x.mem (x.rdx.toBitVec + x.rcx.toBitVec * 1) .W8 (BitVec.truncate 8 (1 : BitVec 64)) with
        | .ok m1 =>
          .ok (.goto .LBB6_4 { x with mem := m1, rax := 0 })
        | .error _ => .stuck "store"
      else .stuck "store: private stack area"
    | .LBB6_4, x =>
      .ok (.ret (x.rax, x.mem))

def post {A : Type} (_ : A) (r : (UInt64 × DataMem)) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ t.data.dmem = r.2 ∧ SysV.MappedMemory s.data.dmem t.data.dmem

def l2 : Model In2 (UInt64 × DataMem) where
  rep policy a s := a.policy = policy ∧ a.mem = s.data.dmem ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.spillSetAddPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocks.Returns noCall .entry (init a) r
  post := post


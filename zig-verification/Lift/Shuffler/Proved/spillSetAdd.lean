structure In2p where
  policy : CpuPolicy
  heap : Heap
  rax : UInt64
  rsi : UInt64
  rdi : UInt64
  sp : BitVec 64 := 0

def initP (a : In2p) : St In2p Heap := ⟨a, a.rax, 0, 0, a.heap⟩

def blocksP : Leaf Lbl (St In2p Heap) (UInt64 × Heap) where
  step
    | .entry, x =>
      .ok (if (x.input.rsi >>> (32 : UInt64)).toUInt8.toUInt64 = 0 then .goto .o15 { x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := x.input.rsi >>> (32 : UInt64) } else .goto .LBB6_4 { x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := x.input.rsi >>> (32 : UInt64) })
    | .o15, x =>
      .ok (if x.input.rsi &&& 280375465082880 = 0 then .goto .LBB6_4 { x with rcx := 280375465082880 &&& x.input.rsi } else .goto .o30 { x with rcx := 280375465082880 &&& x.input.rsi })
    | .o30, x =>
      match x.mem.load x.input.rdi.toBitVec .W64 with
      | .ok v =>
        match x.mem.load (v + BitVec.zeroExtend 64 (BitVec.truncate 32 (x.input.rsi.toBitVec)) * 1) .W8 with
        | .ok v1 =>
          .ok (if UInt64.ofBitVec (BitVec.zeroExtend 64 v1) = 0 then .goto .o41 { x with rcx := (x.input.rsi).toUInt32.toUInt64, rdx := UInt64.ofBitVec v } else .goto .LBB6_4 { x with rcx := (x.input.rsi).toUInt32.toUInt64, rdx := UInt64.ofBitVec v })
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o41, x =>
      match x.mem.store (x.rdx.toBitVec + x.rcx.toBitVec * 1) .W8 (BitVec.truncate 8 (1 : BitVec 64)) with
      | .ok h =>
        .ok (.goto .LBB6_4 { x with rax := 0, mem := h })
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .LBB6_4, x =>
      .ok (.ret (x.rax, x.mem))

def postP (a : In2p) (r : UInt64 × Heap) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ r.2.Holds a.policy t.data.dmem ∧ ∀ b, ¬ a.heap.Owned b → t.data.dmem.get? b = s.data.dmem.get? b

def l2p : Model In2p (UInt64 × Heap) where
  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.spillSetAddPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocksP.Returns noCall .entry (initP a) r
  post := postP


def objsP (self : BitVec 64) (sp : BitVec 64) (n : Nat) (buf : Vector (BitVec 8) n) (slot : Lift.Pilot.Slot) : Heap := (Lift.Shuffler.Internal.AddStatement.objects buf self sp).map toObj

def SimIn (a : In2p) (b : In2) : Prop := a.policy = b.policy ∧ a.rax = b.rax ∧ a.rsi = b.rsi ∧ a.rdi = b.rdi ∧ a.heap.Holds b.policy b.mem ∧ (∀ c, Private b.sp c → ¬ Covered a.heap c) ∧ a.sp = b.sp

def SimSt (x : St In2p Heap) (y : St In2 DataMem) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rcx = y.rcx ∧ x.rdx = y.rdx ∧ x.mem.Holds y.input.policy y.mem ∧ ∀ b, ¬ x.input.heap.Owned b → y.mem.get? b = y.input.mem.get? b

def SimOut (x : In2p) (y : In2) (r : UInt64 × Heap) (r' : UInt64 × DataMem) : Prop := r.1 = r'.1 ∧ r.2.Holds x.policy r'.2 ∧ ∀ b, ¬ x.heap.Owned b → r'.2.get? b = y.mem.get? b

def SimArr (self : BitVec 64) (sp : BitVec 64) (frame : Heap) (n : Nat) (buf : Vector (BitVec 8) n) (slot : Lift.Pilot.Slot) (a : In2p) : Prop := (Lift.Pilot.AddSpec.C buf slot) ∧ a.rdi.toBitVec = self ∧ a.rsi.toBitVec = slot.word ∧ a.heap = objsP self sp n buf slot ++ frame ∧ ∃ m, a.heap.Holds a.policy m

def l3 (self : BitVec 64) (sp : BitVec 64) (frame : Heap) (n : Nat) (buf : Vector (BitVec 8) n) (slot : Lift.Pilot.Slot) (pol : CpuPolicy) := show Model Unit _ from
  { rep policy _ s := policy = pol ∧ Heap.Holds policy (objsP self sp n buf slot ++ frame) s.data.dmem ∧ (Lift.Pilot.AddSpec.C buf slot) ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.spillSetAddPC s ∧ s.data.regs.rdi.toBitVec = self ∧ s.data.regs.rsi.toBitVec = slot.word ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered (objsP self sp n buf slot ++ frame) b)
    returns _ y := Lift.Pilot.AddSpec.run slot buf = some y
    post _ y s t := SysV.Exit s t ∧ Lift.Trusted.Encode.encode y.1 = [⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩] ∧ Lift.Shuffler.Internal.AddStatement.post slot buf sp pol ⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩ t.data.dmem ∧ ∀ b, ¬ (objsP self sp n buf slot ++ frame).Owned b → t.data.dmem.get? b = s.data.dmem.get? b }


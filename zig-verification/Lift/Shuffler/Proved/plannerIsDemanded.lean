        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o50, x =>
      .ok (if x.r9 &&& 281474976710655 = x.input.rsi &&& 281474976710655 then .goto .LBB21_5 { x with r9 := (x.r9 ^^^ x.input.rsi) <<< (16 : UInt64) } else .goto .LBB21_4 { x with r9 := (x.r9 ^^^ x.input.rsi) <<< (16 : UInt64) })
    | .LBB21_4, x =>
      .ok (.goto .LBB21_1 { x with rcx := x.rcx + 1 })
    | .LBB21_5, x =>
      .ok (.ret ((x.rax &&& 18446744073709551360) ||| ((if ¬ (x.rax ≤ x.rcx) then 1 else 0) &&& 255)))

def postP {A : Type} (_ : A) (r : UInt64) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.dmem = s.data.dmem ∧ t.data.regs.rax = r

def l2p : Model In2p UInt64 where
  rep policy a s := a.heap.Holds policy s.data.dmem ∧ Heap.Permits policy a.heap ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.plannerIsDemandedPC s ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi
  returns a r := blocksP.Returns noCall .entry (initP a) r
  post := postP


end skel_call

def callInput (a : skel_call.In2p) : In2p := { heap := a.heap, rsi := a.rsi, rdi := a.rdi }

def callState (x : St In2p) (z : St skel_call.In2p) : Prop := x.input = callInput z.input ∧ x.rax = z.rax ∧ x.rcx = z.rcx ∧ x.rdx = z.rdx ∧ x.r8 = z.r8 ∧ x.r9 = z.r9 ∧ x.r10 = z.r10 ∧ True

def callPre (self : BitVec 64) (pad : BitVec 64) (frame : Heap) (pl : FlatShuffler.Flat.Planner) (slot : FlatShuffler.StackSlot) (a : skel_call.In2p) : Prop := SimArr self pad frame pl slot (callInput a)

def callPost (self : BitVec 64) (pad : BitVec 64) (frame : Heap) (pl : FlatShuffler.Flat.Planner) (slot : FlatShuffler.StackSlot) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Shuffler.Internal.Proposed.IsDemandedStatement.run pl slot)) (q : UInt64) : Prop := (∃ (r : UInt64), (Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.IsDemandedStatement.result pl slot y) y) = [⟨.W8, r.toBitVec.setWidth 8⟩]) ∧ r = q)

abbrev callSummary : Prop := ∀ (self : BitVec 64) (pad : BitVec 64) (frame : Heap) (pl : FlatShuffler.Flat.Planner) (slot : FlatShuffler.StackSlot) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Shuffler.Internal.Proposed.IsDemandedStatement.run pl slot)), callPre self pad frame pl slot a → Lift.Shuffler.Internal.Proposed.IsDemandedStatement.run pl slot = some y → ∃ q, skel_call.l2p.returns a q ∧ callPost self pad frame pl slot a y q

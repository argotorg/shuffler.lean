/-- The `isDemanded` test of the loop at the index `j` of the target array, read on the heap. -/
def hit (a : In2p) (j : Nat) : Bool :=
  match a.heap.loadB (a.rdi.toBitVec + 16) .W64 with
  | .ok base =>
    match a.heap.loadB (base + BitVec.ofNat 64 j * 8) .W64 with
    | .ok w =>
      decide ((UInt64.ofBitVec w &&& 1095216660480 ≠ 4294967296) ∧
        (UInt64.ofBitVec w &&& 281474976710655 = a.rsi &&& 281474976710655))
    | _ => false
  | _ => false

/-- The test of the loop from the index `lo` to `hi`. -/
def scan (a : In2p) (lo hi : Nat) : Bool :=
  if lo < hi then (hit a lo || scan a (lo + 1) hi) else false
termination_by hi - lo

/-- The result of the loop from a state: the high bits of `rax` and the low bit of the test. -/
def out (a : In2p) (x : St In2p) : UInt64 :=
  (x.rax &&& 18446744073709551360) ||| (if scan a x.rcx.toNat x.rax.toNat then 1 else 0)

/-- The invariant of the loop. -/
def Inv (a : In2p) (x : St In2p) : Prop :=
  x.input = a ∧ x.rcx.toNat ≤ x.rax.toNat ∧ x.rax.toNat ≤ 1024 ∧
    x.rdx = 1095216660480 ∧ x.r8 = 4294967296

theorem scan_of_lt {a : In2p} {lo hi : Nat} (h : lo < hi) :
    scan a lo hi = (hit a lo || scan a (lo + 1) hi) := by
  rw [scan]; simp only [h, ↓reduceIte]

theorem scan_of_ge {a : In2p} {lo hi : Nat} (h : ¬ lo < hi) : scan a lo hi = false := by
  rw [scan]; simp only [h, ↓reduceIte]

theorem scan_of_hit {a : In2p} {lo hi : Nat} (h : lo < hi) (hh : hit a lo = true) :
    scan a lo hi = true := by
  rw [scan_of_lt h, hh]; rfl

theorem scan_skip {a : In2p} {lo hi : Nat} (h : lo < hi) (hh : hit a lo = false) :
    scan a lo hi = scan a (lo + 1) hi := by
  rw [scan_of_lt h, hh]; rfl

/-- A junk kind is the mask test of the loop. -/
theorem slotWord_junk (s : FlatShuffler.StackSlot) (p : BitVec 16) :
    (Lift.Shuffler.Internal.Proposed.Layout.slotWord s p &&& 1095216660480#64 = 4294967296#64) ↔
      s.kind = FlatShuffler.Junk := by
  obtain ⟨payload, kind, opcode⟩ := s
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word, FlatShuffler.Junk]
  bv_decide

/-- Two slot words agree on the low 48 bits exactly when the slots are equal. -/
theorem slotWord_low48 (s t : FlatShuffler.StackSlot) (p q : BitVec 16) :
    (Lift.Shuffler.Internal.Proposed.Layout.slotWord s p &&& 281474976710655#64 =
      Lift.Shuffler.Internal.Proposed.Layout.slotWord t q &&& 281474976710655#64) ↔ s = t := by
  obtain ⟨payload, kind, opcode⟩ := s
  obtain ⟨payload', kind', opcode'⟩ := t
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word, FlatShuffler.StackSlot.mk.injEq]
  constructor
  · intro h
    have := h
    bv_decide
  · intro h
    obtain ⟨rfl, rfl, rfl⟩ := h
    bv_decide

/-- The address of the target array: the word at `self + 16`. -/
theorem loadB_16 {self pad : BitVec 64} {frame : Heap} {pl : FlatShuffler.Flat.Planner}
    {slot : FlatShuffler.StackSlot} {policy : CpuPolicy} {m : DataMem}
    (hh : (objsP self pad pl slot ++ frame).Holds policy m) :
    (objsP self pad pl slot ++ frame).loadB (self + 16) .W64 = .ok (self + 32) := by
  refine Heap.loadB_of_load ?_
  have hmem : (Obj.mk (self + 16) false [⟨.W64, self + 32⟩, ⟨.W64, pl.targetSize⟩] : Obj) ∈
      (objsP self pad pl slot ++ frame) := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.IsDemandedStatement.objects, toObj, toCell,
      Lift.Shuffler.Internal.Proposed.IsDemandedStatement.envOf]
  have hx : (0, (⟨.W64, self + 32⟩ : Cell)) ∈
      offsets 0 (Obj.mk (self + 16) false [⟨.W64, self + 32⟩, ⟨.W64, pl.targetSize⟩]).cells := by
    simp [offsets]
  have h := Heap.load_of_mem hh hmem hx
  simp only at h
  rw [show self + 16 + 0#64 = self + 16 from by bv_omega] at h
  exact h

/-- The length of the target array: the word at `self + 24`. -/
theorem loadB_24 {self pad : BitVec 64} {frame : Heap} {pl : FlatShuffler.Flat.Planner}
    {slot : FlatShuffler.StackSlot} {policy : CpuPolicy} {m : DataMem}
    (hh : (objsP self pad pl slot ++ frame).Holds policy m) :
    (objsP self pad pl slot ++ frame).loadB (self + 24) .W64 = .ok pl.targetSize := by
  refine Heap.loadB_of_load ?_
  have hmem : (Obj.mk (self + 16) false [⟨.W64, self + 32⟩, ⟨.W64, pl.targetSize⟩] : Obj) ∈
      (objsP self pad pl slot ++ frame) := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.IsDemandedStatement.objects, toObj, toCell,
      Lift.Shuffler.Internal.Proposed.IsDemandedStatement.envOf]
  have hx : (8, (⟨.W64, pl.targetSize⟩ : Cell)) ∈
      offsets 0 (Obj.mk (self + 16) false [⟨.W64, self + 32⟩, ⟨.W64, pl.targetSize⟩]).cells := by
    simp [offsets]
  have h := Heap.load_of_mem hh hmem hx
  simp only at h
  rw [show self + 16 + 8#64 = self + 24 from by bv_omega] at h
  exact h

/-- The word of the target array at index `j`. -/
theorem loadB_arr {self pad : BitVec 64} {frame : Heap} {pl : FlatShuffler.Flat.Planner}
    {slot : FlatShuffler.StackSlot} {policy : CpuPolicy} {m : DataMem}
    (hh : (objsP self pad pl slot ++ frame).Holds policy m) (j : Nat) (hj : j < 1024) :
    (objsP self pad pl slot ++ frame).loadB ((self + 32) + BitVec.ofNat 64 j * 8) .W64
      = .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord (pl.target.toList.getD j default) 0) := by
  refine Heap.loadB_of_load ?_
  have hmem : (Obj.words (self + 32) false .W64
      ((List.range FlatShuffler.maxStackSize).map
        (fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord (pl.target.toList.getD i default) 0)) : Obj) ∈
      (objsP self pad pl slot ++ frame) := by
    simp [objsP, Lift.Shuffler.Internal.Proposed.IsDemandedStatement.objects, toObj, toCell,
      Obj.words, Lift.Shuffler.Internal.Proposed.IsDemandedStatement.envOf]
  have hj' : j % 18446744073709551616 = j := Nat.mod_eq_of_lt (by omega)
  have hi : (BitVec.ofNat 64 j).toNat <
      ((List.range FlatShuffler.maxStackSize).map
        (fun i => Lift.Shuffler.Internal.Proposed.Layout.slotWord (pl.target.toList.getD i default) 0)).length := by
    simp only [List.length_map, List.length_range, FlatShuffler.maxStackSize, BitVec.toNat_ofNat]
    omega
  have h := Heap.load_words64 hh hmem (i := BitVec.ofNat 64 j) hi
  simp only [FlatShuffler.maxStackSize, BitVec.toNat_ofNat, hj',
    List.getElem_map, List.getElem_range] at h
  rw [BitVec.mul_comm] at h
  exact h

theorem getD_target (pl : FlatShuffler.Flat.Planner) (j : Nat) (hj : j < 1024) :
    pl.target.toList.getD j default = FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j) := by
  have hlen : j < pl.target.toList.length := by
    rw [Vector.length_toList]; simpa [FlatShuffler.maxStackSize] using hj
  have hnat : (BitVec.ofNat 64 j).toNat = j := by
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
  rw [FlatShuffler.Flat.get, hnat, dite_eq_left (by simpa [FlatShuffler.maxStackSize] using hj),
    List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlen, Option.getD_some,
    Vector.getElem_toList hlen]

/-- The test of the loop at the index `j` is the test of `isDemanded` at `j`. -/
theorem hit_eq {self pad : BitVec 64} {frame : Heap} {pl : FlatShuffler.Flat.Planner}
    {slot : FlatShuffler.StackSlot} {a : In2p} {policy : CpuPolicy} {m : DataMem}
    (hrdi : a.rdi.toBitVec = self)
    (hrsi : a.rsi.toBitVec = Lift.Shuffler.Internal.Proposed.Layout.slotWord slot (pad.setWidth 16))
    (hheap : a.heap = objsP self pad pl slot ++ frame) (hh : a.heap.Holds policy m)
    {j : Nat} (hj : j < 1024) :
    hit a j = (!FlatShuffler.isJunk (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j)) &&
      (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j) == slot)) := by
  have h1 : a.heap.loadB (a.rdi.toBitVec + 16) .W64 = .ok (self + 32) := by
    rw [hrdi, hheap]; exact loadB_16 (hheap ▸ hh)
  have h2 : a.heap.loadB ((self + 32) + BitVec.ofNat 64 j * 8) .W64
      = .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord (pl.target.toList.getD j default) 0) := by
    rw [hheap]; exact loadB_arr (hheap ▸ hh) j hj
  simp only [hit, h1, h2]
  rw [getD_target pl j hj]
  have hb1 : (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
        (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j)) 0) &&& 1095216660480 = 4294967296) ↔
      (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j)).kind = FlatShuffler.Junk := by
    rw [UInt64.eq_iff_toBitVec_eq, UInt64.toBitVec_and, UInt64.toBitVec_ofBitVec, UInt64.toBitVec_ofNat]
    exact slotWord_junk _ 0
  have hb2 : (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
        (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j)) 0) &&& 281474976710655 =
        a.rsi &&& 281474976710655) ↔ FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j) = slot := by
    rw [UInt64.eq_iff_toBitVec_eq, UInt64.toBitVec_and, UInt64.toBitVec_and, UInt64.toBitVec_ofBitVec,
      UInt64.toBitVec_ofNat, hrsi]
    exact slotWord_low48 _ slot 0 (pad.setWidth 16)
  have hjunk : (FlatShuffler.isJunk (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j)) = true) ↔
      (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j)).kind = FlatShuffler.Junk := by
    simp [FlatShuffler.isJunk]
  have hjunk' : (FlatShuffler.isJunk (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j)) = false) ↔
      ¬ (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 j)).kind = FlatShuffler.Junk := by
    rw [← hjunk]; simp
  rw [Bool.eq_iff_iff, decide_eq_true_eq, Bool.and_eq_true, Bool.not_eq_true', beq_iff_eq]
  simp only [hb1, hb2, hjunk', ne_eq]

theorem demandedFrom_lt {pl : FlatShuffler.Flat.Planner} {slot : FlatShuffler.StackSlot}
    {j : FlatShuffler.Word} (h : j < pl.targetSize) :
    FlatShuffler.Flat.demandedFrom pl slot j
      = (if !FlatShuffler.isJunk (FlatShuffler.Flat.get pl.target j) &&
            FlatShuffler.Flat.get pl.target j = slot
          then true else FlatShuffler.Flat.demandedFrom pl slot (j + 1)) := by
  rw [FlatShuffler.Flat.demandedFrom]
  rw [dite_eq_left h]

theorem demandedFrom_ge {pl : FlatShuffler.Flat.Planner} {slot : FlatShuffler.StackSlot}
    {j : FlatShuffler.Word} (h : ¬ j < pl.targetSize) :
    FlatShuffler.Flat.demandedFrom pl slot j = false := by
  rw [FlatShuffler.Flat.demandedFrom]
  rw [dite_eq_right h]

/-- A `UInt64` is the `BitVec` of its `toNat`. -/
theorem ofNat_toNat (x : UInt64) : BitVec.ofNat 64 x.toNat = x.toBitVec := by
  rw [UInt64.toNat, BitVec.ofNat_toNat, BitVec.setWidth_eq]

theorem toNat_add_one (x : UInt64) (h : x.toNat + 1 < 2 ^ 64) : (x + 1).toNat = x.toNat + 1 := by
  rw [UInt64.toNat_add]
  have h1 : (1 : UInt64).toNat = 1 := rfl
  rw [h1, Nat.mod_eq_of_lt h]

/-- The test of the loop at `j` with the two loads of the step. -/
theorem hit_unfold {a : In2p} {j : Nat} {v1 v2 : BitVec 64}
    (h1 : a.heap.loadB (a.rdi.toBitVec + 16) .W64 = .ok v1)
    (h2 : a.heap.loadB (v1 + BitVec.ofNat 64 j * 8) .W64 = .ok v2) :
    hit a j = decide ((UInt64.ofBitVec v2 &&& 1095216660480 ≠ 4294967296) ∧
      (UInt64.ofBitVec v2 &&& 281474976710655 = a.rsi &&& 281474976710655)) := by
  simp only [hit, h1, h2]

/-- The counter is below the bound in the loop body. -/
theorem Inv_lt {a : In2p} {x : St In2p} (hx : Inv a x) (hne : x.rax ≠ x.rcx) :
    x.rcx.toNat < x.rax.toNat := by
  obtain ⟨-, h2, -, -, -⟩ := hx
  rcases Nat.lt_or_ge x.rcx.toNat x.rax.toNat with h | h
  · exact h
  · exfalso
    apply hne
    apply UInt64.toNat_inj.mp
    omega

/-- The test of the loop from `0` is `isDemanded`. -/
theorem scan_eq {self pad : BitVec 64} {frame : Heap} {pl : FlatShuffler.Flat.Planner}
    {slot : FlatShuffler.StackSlot} {a : In2p} {policy : CpuPolicy} {m : DataMem}
    (hC : Lift.Shuffler.Internal.Proposed.IsDemandedStatement.C pl slot)
    (hrdi : a.rdi.toBitVec = self)
    (hrsi : a.rsi.toBitVec = Lift.Shuffler.Internal.Proposed.Layout.slotWord slot (pad.setWidth 16))
    (hheap : a.heap = objsP self pad pl slot ++ frame) (hh : a.heap.Holds policy m) :
    scan a 0 pl.targetSize.toNat = FlatShuffler.Flat.isDemanded pl slot := by
  have hH : pl.targetSize.toNat ≤ 1024 := hC
  have key : ∀ d lo, pl.targetSize.toNat - lo = d → lo ≤ pl.targetSize.toNat →
      scan a lo pl.targetSize.toNat
        = FlatShuffler.Flat.demandedFrom pl slot (BitVec.ofNat 64 lo) := by
    intro d
    induction d with
    | zero =>
      intro lo hd hle
      have hge : ¬ lo < pl.targetSize.toNat := by omega
      have hnat : (BitVec.ofNat 64 lo).toNat = lo := by
        rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
      have hnot : ¬ (BitVec.ofNat 64 lo < pl.targetSize) := by
        rw [BitVec.lt_def, hnat]; exact hge
      rw [scan_of_ge hge, demandedFrom_ge hnot]
    | succ d ih =>
      intro lo hd hle
      have hlt : lo < pl.targetSize.toNat := by omega
      have hnat : (BitVec.ofNat 64 lo).toNat = lo := by
        rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
      have hpos : BitVec.ofNat 64 lo < pl.targetSize := by
        rw [BitVec.lt_def, hnat]; exact hlt
      rw [scan_of_lt hlt, demandedFrom_lt hpos,
        hit_eq hrdi hrsi hheap hh (j := lo) (by omega)]
      have hstep : (BitVec.ofNat 64 lo + 1) = BitVec.ofNat 64 (lo + 1) := by bv_omega
      rw [hstep, ih (lo + 1) (by omega) (by omega)]
      cases (!FlatShuffler.isJunk (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 lo)) &&
        (FlatShuffler.Flat.get pl.target (BitVec.ofNat 64 lo) == slot)) <;> rfl
  rw [key (pl.targetSize.toNat - 0) 0 rfl (by omega)]
  rfl

theorem low_byte_bv (X : BitVec 64) (c : Bool) :
    ((X &&& 18446744073709551360#64) ||| (if c then 1#64 else 0#64)).setWidth 8
      = (if c then 1#8 else 0#8) := by
  cases c
  · simp only [Bool.false_eq_true, ite_false]
    bv_decide
  · simp only [ite_true]
    bv_decide

theorem low_byte (X : UInt64) (c : Bool) :
    ((X &&& 18446744073709551360) ||| (if c then 1 else 0) : UInt64).toBitVec.setWidth 8
      = (if c then 1 else 0 : BitVec 8) := by
  cases c
  · have h := low_byte_bv X.toBitVec false
    simp only [Bool.false_eq_true, ite_false, UInt64.toBitVec_and, UInt64.toBitVec_or,
      UInt64.toBitVec_ofNat] at h ⊢
    exact h
  · have h := low_byte_bv X.toBitVec true
    simp only [ite_true, UInt64.toBitVec_and, UInt64.toBitVec_or, UInt64.toBitVec_ofNat] at h ⊢
    exact h
end loop

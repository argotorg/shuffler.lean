/-- `replaceLow` of a 64-bit word is the mask of the high 56 bits with the low byte. -/
theorem replaceLow_mask (x : BitVec 64) (new : BitVec 8) :
    x &&& 18446744073709551360#64 ||| new.setWidth 64 = x.replaceLow new := by
  simp only [BitVec.replaceLow, BitVec.drop]
  bv_decide

/-- The `setcc` form of a word: the low byte written by the condition. -/
theorem seta_bit (x : UInt64) (c : Bool) :
    (x &&& 18446744073709551360) ||| ((if c then 1 else 0) &&& 255)
      = (⟨x.toBitVec.replaceLow (if c then 1#8 else 0#8)⟩ : UInt64) := by
  cases c
  · simp only [Bool.false_eq_true, ite_false]
    apply UInt64.eq_iff_toBitVec_eq.mpr
    simp only [UInt64.toBitVec_and, UInt64.toBitVec_or, UInt64.toBitVec_ofNat]
    rw [← replaceLow_mask]
    bv_decide
  · simp only [ite_true]
    apply UInt64.eq_iff_toBitVec_eq.mpr
    simp only [UInt64.toBitVec_and, UInt64.toBitVec_or, UInt64.toBitVec_ofNat]
    rw [← replaceLow_mask]
    bv_decide

/-- The condition of the `seta` of the block: `rax > rcx` is the sign of the difference of the
wrapped subtraction. -/
theorem seta_cond (x y : UInt64) :
    ((((↑(18446744073709551616 - x.toNat) : Int) + (↑y.toNat : Int)) %
      (18446744073709551616 : Int) != ((↑y.toNat : Int) - ↑x.toNat)) : Bool) = decide (¬ x ≤ y) := by
  rw [Bool.eq_iff_iff]
  simp only [bne_iff_ne, decide_eq_true_eq, UInt64.le_iff_toBitVec_le, BitVec.le_def, UInt64.toNat]
  have hx : (x.toBitVec.toNat : Int) < 18446744073709551616 := by
    have := UInt64.toNat_lt x
    simp only [UInt64.toNat] at this
    omega
  have hy : (y.toBitVec.toNat : Int) < 18446744073709551616 := by
    have := UInt64.toNat_lt y
    simp only [UInt64.toNat] at this
    omega
  have hx0 : (0:Int) ≤ x.toBitVec.toNat := by omega
  have hy0 : (0:Int) ≤ y.toBitVec.toNat := by omega
  omega

/-- The exit state of the block: the statement's mask and condition form is the composed form of
the site (`replaceLow`). -/
theorem seta_eq (x y : UInt64) :
    (x &&& 18446744073709551360) ||| ((if ¬ x ≤ y then 1 else 0) &&& 255)
      = (⟨x.toBitVec.replaceLow (BitVec.ofNat 8 ((((↑(18446744073709551616 - x.toNat) : Int) +
          (↑y.toNat : Int)) % (18446744073709551616 : Int) != ((↑y.toNat : Int) - ↑x.toNat))).toNat)⟩ : UInt64) := by
  rw [seta_cond]
  by_cases h : x ≤ y
  · have hd : decide (¬ x ≤ y) = false := by simp [h]
    rw [hd]
    rw [if_neg (fun hn => hn h)]
    exact seta_bit x false
  · have hd : decide (¬ x ≤ y) = true := by simp [h]
    rw [hd]
    rw [if_pos h]
    exact seta_bit x true
end block

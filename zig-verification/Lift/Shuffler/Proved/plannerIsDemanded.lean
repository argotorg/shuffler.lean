def bridgeState (z : St skel_call.In2p) : St In2p := { input := callInput z.input, rax := z.rax, rcx := z.rcx, rdx := z.rdx, r8 := z.r8, r9 := z.r9, r10 := z.r10 }

abbrev BridgeHiNext := Next Lbl (St In2p) UInt64 Empty Empty.elim Empty.elim
abbrev BridgeLoNext := Next Lbl (St skel_call.In2p) UInt64 Empty Empty.elim Empty.elim

def bridgeNext : BridgeLoNext → BridgeHiNext
  | .goto l z => .goto l (bridgeState z)
  | .ret r => .ret r
  | .call f x k => .call f x (fun r => ((k r).1, bridgeState (k r).2))

def bridgeRes : Res BridgeLoNext → Res BridgeHiNext
  | .ok n => .ok (bridgeNext n)
  | .stuck why => .stuck why
  | .noFuel => .noFuel

theorem bridgeState_related (z : St skel_call.In2p) : callState (bridgeState z) z := by
  simp [callState, bridgeState]

theorem bridge_related_eq (x : St In2p) (z : St skel_call.In2p)
    (h : callState x z) : x = bridgeState z := by
  cases x
  cases z
  simp_all [callState, bridgeState, callInput]

theorem bridgeNext_related (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      callState (fun (r : UInt64) (q : UInt64) => r = q) (bridgeNext n) (.ok n) := by
  cases n with
  | goto l z => exact ⟨z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, k, rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridgeNext_related_rev (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q) n (.ok (bridgeNext n)) := by
  cases n with
  | goto l z => exact ⟨bridgeState z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, (fun r => ((k r).1, bridgeState (k r).2)), rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridge_goto {l : Lbl} {input : skel_call.In2p} {rax : UInt64} {rcx : UInt64} {rdx : UInt64} {r8 : UInt64} {r9 : UInt64} {r10 : UInt64} :
    (Res.ok (Next.goto l { input := callInput input, rax := rax, rcx := rcx, rdx := rdx, r8 := r8, r9 := r9, r10 := r10 }) : Res BridgeHiNext) =
      bridgeRes (.ok (.goto l { input := input, rax := rax, rcx := rcx, rdx := rdx, r8 := r8, r9 := r9, r10 := r10 })) := rfl

set_option maxHeartbeats 400000 in
theorem bridge_step_eq_entry (z : St skel_call.In2p) :
    blocksP.step .entry (bridgeState z) = bridgeRes (skel_call.blocksP.step .entry z) := by
  simp only [blocksP, skel_call.blocksP, bridgeState, callInput]
  all_goals repeat' split
  all_goals first | exact bridge_goto | rfl


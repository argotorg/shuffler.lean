theorem LBB21_1 : ∀ (self : BitVec 64) (pad : BitVec 64) (frame : Heap) (pl : FlatShuffler.Flat.Planner) (slot : FlatShuffler.StackSlot) (a : In2p) (y : (Bool)) (v_rax : BitVec 64), SimArr self pad frame pl slot a → a.heap.loadB (a.rdi.toBitVec + 24) .W64 = .ok v_rax → Lift.Shuffler.Internal.Proposed.IsDemandedStatement.run pl slot = some y → ∃ r, blocksP.Returns noCall .LBB21_1 ⟨a, (UInt64.ofBitVec v_rax), 0, 1095216660480, 4294967296, 0, 0⟩ r ∧ Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.IsDemandedStatement.result pl slot y) y) = [⟨.W8, r.toBitVec.setWidth 8⟩] := by
  intro self pad frame pl slot a y v_rax hsim hload hrun
  obtain ⟨hC, hrdi, hrsi, hheap, policy, m, hh⟩ := hsim
  have h24 : a.heap.loadB (a.rdi.toBitVec + 24) .W64 = .ok pl.targetSize := by
    rw [hrdi, hheap]; exact loadB_24 (hheap ▸ hh)
  rw [h24] at hload
  simp only [Res.ok.injEq] at hload
  have hI : Inv a ⟨a, UInt64.ofBitVec v_rax, 0, 1095216660480, 4294967296, 0, 0⟩ := by
    refine ⟨rfl, by simp, ?_, rfl, rfl⟩
    rw [UInt64.toNat_ofBitVec, ← hload]
    exact hC
  refine ⟨out a ⟨a, UInt64.ofBitVec v_rax, 0, 1095216660480, 4294967296, 0, 0⟩, ?_, ?_⟩
  · lift_loop! (Inv a) (fun x => x.rax.toNat - x.rcx.toNat) (out a)
    case ret_1 =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      simp only [out, hp1, scan_of_ge (by omega : ¬ x.rcx.toNat < x.rcx.toNat)]
      simp
    case back_1.inv =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      refine ⟨h1, ?_, h3, h4, h5⟩
      show (x.rcx + 1).toNat ≤ x.rax.toNat
      have hlt := Inv_lt ⟨h1, h2, h3, h4, h5⟩ hp1
      have h' : (x.rcx + 1).toNat = x.rcx.toNat + 1 := toNat_add_one x.rcx (by omega)
      omega
    case back_1.dec =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      show x.rax.toNat - (x.rcx + 1).toNat < x.rax.toNat - x.rcx.toNat
      have hlt := Inv_lt ⟨h1, h2, h3, h4, h5⟩ hp1
      have h' : (x.rcx + 1).toNat = x.rcx.toNat + 1 := toNat_add_one x.rcx (by omega)
      omega
    case back_1.out =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      have hlt := Inv_lt ⟨h1, h2, h3, h4, h5⟩ hp1
      have hhit : hit a x.rcx.toNat = false := by
        rw [h1] at hp2 hp3
        rw [← ofNat_toNat x.rcx] at hp3
        rw [hit_unfold hp2 hp3, decide_eq_false_iff_not]
        intro hc
        exact hc.1 (by rw [← h4, ← h5]; exact hp4)
      have hstep : scan a (x.rcx + 1).toNat x.rax.toNat = scan a x.rcx.toNat x.rax.toNat := by
        rw [toNat_add_one x.rcx (by omega), scan_skip hlt hhit]
      simp only [out, hstep]
    case ret_2 =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      have hlt := Inv_lt ⟨h1, h2, h3, h4, h5⟩ hp1
      have hhit : hit a x.rcx.toNat = true := by
        rw [h1] at hp2 hp3 hp5
        rw [← ofNat_toNat x.rcx] at hp3
        rw [hit_unfold hp2 hp3]
        have h4' : UInt64.ofBitVec v2 &&& 1095216660480 ≠ 4294967296 := by
          rw [← h4, ← h5]; exact hp4
        simp [h4', hp5]
      have hscan : scan a x.rcx.toNat x.rax.toNat = true := scan_of_hit hlt hhit
      have hle : ¬ x.rax ≤ x.rcx := by
        rw [UInt64.le_iff_toBitVec_le, BitVec.le_def]
        have hlt' : x.rcx.toBitVec.toNat < x.rax.toBitVec.toNat := hlt
        omega
      simp only [out]
      rw [hscan]
      simp [hle]
    case back_2.inv =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      refine ⟨h1, ?_, h3, h4, h5⟩
      show (x.rcx + 1).toNat ≤ x.rax.toNat
      have hlt := Inv_lt ⟨h1, h2, h3, h4, h5⟩ hp1
      have h' : (x.rcx + 1).toNat = x.rcx.toNat + 1 := toNat_add_one x.rcx (by omega)
      omega
    case back_2.dec =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      show x.rax.toNat - (x.rcx + 1).toNat < x.rax.toNat - x.rcx.toNat
      have hlt := Inv_lt ⟨h1, h2, h3, h4, h5⟩ hp1
      have h' : (x.rcx + 1).toNat = x.rcx.toNat + 1 := toNat_add_one x.rcx (by omega)
      omega
    case back_2.out =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      have hlt := Inv_lt ⟨h1, h2, h3, h4, h5⟩ hp1
      have hhit : hit a x.rcx.toNat = false := by
        rw [h1] at hp2 hp3 hp5
        rw [← ofNat_toNat x.rcx] at hp3
        rw [hit_unfold hp2 hp3, decide_eq_false_iff_not]
        intro hc
        exact hp5 hc.2
      have hstep : scan a (x.rcx + 1).toNat x.rax.toNat = scan a x.rcx.toNat x.rax.toNat := by
        rw [toNat_add_one x.rcx (by omega), scan_skip hlt hhit]
      simp only [out, hstep]
    case nofault_1 =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      rw [h1] at hp2 hp3
      have hok1 : a.heap.loadB (a.rdi.toBitVec + 16) .W64 = .ok (self + 32) := by
        rw [hrdi, hheap]; exact loadB_16 (hheap ▸ hh)
      rw [hok1] at hp2
      rw [Res.ok.injEq] at hp2
      have hv1 : v1 = self + 32 := hp2.symm
      subst hv1
      have hlt := Inv_lt ⟨h1, h2, h3, h4, h5⟩ hp1
      have hok2 : a.heap.loadB ((self + 32) + x.rcx.toBitVec * 8) .W64
          = .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord
              (pl.target.toList.getD x.rcx.toNat default) 0) := by
        rw [hheap, ← ofNat_toNat x.rcx]
        exact loadB_arr (hheap ▸ hh) x.rcx.toNat (by omega)
      rw [hok2] at hp3
      cases hp3
    case nofault_2 =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      rw [h1] at hp2 hp3
      have hok1 : a.heap.loadB (a.rdi.toBitVec + 16) .W64 = .ok (self + 32) := by
        rw [hrdi, hheap]; exact loadB_16 (hheap ▸ hh)
      rw [hok1] at hp2
      rw [Res.ok.injEq] at hp2
      have hv1 : v1 = self + 32 := hp2.symm
      subst hv1
      have hlt := Inv_lt ⟨h1, h2, h3, h4, h5⟩ hp1
      have hok2 : a.heap.loadB ((self + 32) + x.rcx.toBitVec * 8) .W64
          = .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord
              (pl.target.toList.getD x.rcx.toNat default) 0) := by
        rw [hheap, ← ofNat_toNat x.rcx]
        exact loadB_arr (hheap ▸ hh) x.rcx.toNat (by omega)
      rw [hok2] at hp3
      cases hp3
    case nofault_3 =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      rw [h1] at hp2
      have hok : a.heap.loadB (a.rdi.toBitVec + 16) .W64 = .ok (self + 32) := by
        rw [hrdi, hheap]; exact loadB_16 (hheap ▸ hh)
      rw [hok] at hp2
      cases hp2
    case nofault_4 =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := hx
      rw [h1] at hp2
      have hok : a.heap.loadB (a.rdi.toBitVec + 16) .W64 = .ok (self + 32) := by
        rw [hrdi, hheap]; exact loadB_16 (hheap ▸ hh)
      rw [hok] at hp2
      cases hp2
  · have hres : Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.IsDemandedStatement.result pl slot y) y)
        = [⟨.W8, if y then 1 else 0⟩] := rfl
    rw [hres]
    have hy : y = FlatShuffler.Flat.isDemanded pl slot := by
      have hr := hrun
      rw [Lift.Shuffler.Internal.Proposed.IsDemandedStatement.run] at hr
      exact (Option.some.inj hr).symm
    rw [hy]
    have hlow : (out a ⟨a, UInt64.ofBitVec v_rax, 0, 1095216660480, 4294967296, 0, 0⟩).toBitVec.setWidth 8
        = (if FlatShuffler.Flat.isDemanded pl slot then 1 else 0 : BitVec 8) := by
      show ((UInt64.ofBitVec v_rax &&& 18446744073709551360) |||
        (if scan a 0 (UInt64.ofBitVec v_rax).toNat then 1 else 0) : UInt64).toBitVec.setWidth 8
        = (if FlatShuffler.Flat.isDemanded pl slot then 1 else 0 : BitVec 8)
      rw [UInt64.toNat_ofBitVec, ← hload, scan_eq hC hrdi hrsi hheap hh]
      exact low_byte _ _
    rw [hlow]
end loop

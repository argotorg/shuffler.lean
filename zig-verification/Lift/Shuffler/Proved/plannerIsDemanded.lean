        .ok (.goto .LBB21_1 { x with rax := UInt64.ofBitVec v, rcx := 0, rdx := 1095216660480, r8 := 4294967296 })
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .LBB21_1, x =>
      .ok (if x.rax = x.rcx then .goto .LBB21_5 x else .goto .o31 x)
    | .o31, x =>
      match x.input.heap.loadB (x.input.rdi.toBitVec + 16) .W64 with
      | .ok v =>
        match x.input.heap.loadB (v + x.rcx.toBitVec * 8) .W64 with
        | .ok v1 =>
          .ok (if UInt64.ofBitVec v1 &&& x.rdx = x.r8 then .goto .LBB21_4 { x with r9 := UInt64.ofBitVec v1, r10 := UInt64.ofBitVec v1 &&& x.rdx } else .goto .o50 { x with r9 := UInt64.ofBitVec v1, r10 := UInt64.ofBitVec v1 &&& x.rdx })

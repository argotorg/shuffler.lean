    Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode (pos.set d (BitVec.allOnes 64) hd), true⟩ := by
  have hd' : d < pos.toList.length := by simpa using hd
  have ho : ((mp + 8192) + BitVec.ofNat 64 (8 * d) - (mp + 8192)).toNat = 8 * d := by
    rw [show (mp + 8192) + BitVec.ofNat 64 (8 * d) - (mp + 8192) = BitVec.ofNat 64 (8 * d) from by bv_omega]
    rw [BitVec.toNat_ofNat]; omega
  have htoList : (pos.set d (BitVec.allOnes 64) hd).toList = pos.toList.set d (BitVec.allOnes 64) := Vector.toList_set hd
  have h1 : (Lift.Sem.Obj.setAt ((mp + 8192) + BitVec.ofNat 64 (8 * d)) Width.W64 (BitVec.allOnes 64)
      (Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode pos, true⟩)).cells
      = Lift.Sem.cellSet (pos.toList.flatMap cellOpW) (8 * d) Width.W64 (BitVec.allOnes 64) := by
    simp only [Lift.Sem.Obj.setAt]
    rw [pos_cells]
    show Lift.Sem.cellSet (pos.toList.flatMap cellOpW) (((mp + 8192) + BitVec.ofNat 64 (8 * d)) - (mp + 8192)).toNat Width.W64 (BitVec.allOnes 64) = _
    rw [ho]
  have h2 : (Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode (pos.set d (BitVec.allOnes 64) hd), true⟩).cells
      = (pos.toList.set d (BitVec.allOnes 64)).flatMap cellOpW := by
    rw [pos_cells, htoList]
  show (⟨mp + 8192, true, (Lift.Sem.Obj.setAt ((mp + 8192) + BitVec.ofNat 64 (8 * d)) Width.W64 (BitVec.allOnes 64)
      (Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode pos, true⟩)).cells⟩ : Lift.Sem.Obj)
    = ⟨mp + 8192, true, (Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode (pos.set d (BitVec.allOnes 64) hd), true⟩).cells⟩
  rw [h1, h2, setAtPos_cells pos mp d hd']

/-- The store of the new size on the heap of the statement is not stuck. -/
theorem store48_ok (x : Lift.Pilot.PopSpec.In) (self tr mp : BitVec 64) (frame : Heap) (pol : CpuPolicy)
    (m : DataMem) (hh : (heap4 self tr mp x.size x.traceSize x.trace x.pos x.dest frame).Holds pol m) :
    (heap4 self tr mp x.size x.traceSize x.trace x.pos x.dest frame).store (self + 48) .W64 (x.size - 1) =
      .ok (heap4 self tr mp (x.size - 1) x.traceSize x.trace x.pos x.dest frame) := by
  have hst : Lift.Sem.Heap.StoreAt (self + 48) .W64 (x.size - 1)
      (heap4 self tr mp x.size x.traceSize x.trace x.pos x.dest frame)
      (Lift.Sem.Obj.setAt (self + 48) .W64 (x.size - 1) (Lift.Sem.Bridge.toObj ⟨self + 48, Lift.Trusted.Encode.encode x.size, true⟩) ::
        (heap4 self tr mp x.size x.traceSize x.trace x.pos x.dest frame).tail) := by
    refine Lift.Sem.Heap.StoreAt.head (o := Lift.Sem.Bridge.toObj ⟨self + 48, Lift.Trusted.Encode.encode x.size, true⟩)
      (t := (heap4 self tr mp x.size x.traceSize x.trace x.pos x.dest frame).tail) rfl ?_
    simp [Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, Lift.Trusted.Encode.encode, Lift.Sem.cellGet, Lift.Sem.Cell.get]
  rw [Lift.Sem.Heap.store_of_storeAt hh hst]
  rw [setAt48 x.size self (x.size - 1)]
  simp only [heap4, List.tail_cons]


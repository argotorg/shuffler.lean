    simp [Lift.Sem.Bridge.toObj, Lift.Trusted.Encode.encode, List.map_flatMap, henc, Lift.Sem.Bridge.toCell]
  have hsz : ∀ a : Lift.Pilot.PopSpec.ShuffleOp,
      Lift.Sem.cellsSize [⟨Width.W16, a.depth ++ a.kind⟩, ⟨Width.W16, a.pad⟩, ⟨Width.W64, a.slot.word⟩] = 12 := by
    intro a; simp [Lift.Sem.cellsSize, Width.bytes]
  have htake : Lift.Sem.cellsSize ((trace.toList.take i).flatMap
      (fun a => [⟨Width.W16, a.depth ++ a.kind⟩, ⟨Width.W16, a.pad⟩, ⟨Width.W64, a.slot.word⟩])) = 12 * i := by
    rw [Lift.Sem.cellsSize_flatMap, List.map_congr_left (fun x _ => hsz x), Lift.Sem.sum_map_const,
      List.length_take]
    simp only [Vector.length_toList]
    omega
  have hB : ∀ a : Lift.Pilot.PopSpec.ShuffleOp, Lift.Sem.cellsSize (Lift.Sem.cellSet
      [⟨Width.W16, a.depth ++ a.kind⟩, ⟨Width.W16, a.pad⟩, ⟨Width.W64, a.slot.word⟩]
      0 Width.W16 (BitVec.truncate 16 (2 : BitVec 64))) = 12 := by
    intro a
    simp [Lift.Sem.cellSet, Lift.Sem.cellsSize, Width.bytes]

/-- The store of `none` in the array of positions is not stuck. -/
theorem storePos_heapX (self tr mp : BitVec 64) (sz ts : BitVec 64) (o3 : Lift.Sem.Obj)
    (pos dest : Vector (BitVec 64) 1024) (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (d : Nat) (hd : d < 1024)
    (hh : (heapX self tr mp sz ts o3 pos dest frame).Holds pol m) :

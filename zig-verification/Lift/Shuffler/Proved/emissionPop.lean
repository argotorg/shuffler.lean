/-! ### The frame of the callee's heap

The callee writes only the cells of its four written objects; the objects of the frame of its heap
are unchanged, so a memory that holds the result holds the frame. -/

/-- The heap object of an array of 64-bit words has the size of the array. -/
theorem obj_words_size (p : BitVec 64) (wr : Bool) (xs : List (BitVec 64)) :
    (Obj.words p wr .W64 xs).size = 8 * xs.length := by
  simpa [Obj.words, Obj.size, Width.bytes] using words_bytes .W64 xs

/-- The size of the trace object of the call. -/
theorem trace_obj_size (p : BitVec 64) (trace : Vector Lift.Pilot.PopSpec.ShuffleOp 10240)
    (wr : Bool) :
    (toObj ⟨p, Lift.Trusted.Encode.encode trace, wr⟩).size = 122880 := by
  rw [size_toObj]
  have e : Lift.Trusted.Object.size ⟨p, Lift.Trusted.Encode.encode trace, wr⟩
      = cellsSize ((Lift.Trusted.Encode.encode trace).map toCell) := by
    simp only [Lift.Trusted.Object.size, cellsSize, List.map_map, toCell, Function.comp_def]
  rw [e]
  have hv : Lift.Trusted.Encode.encode trace = trace.toList.flatMap Lift.Trusted.Encode.encode := rfl
  rw [hv, List.map_flatMap, cellsSize_flatMap]
  have h12 : ∀ x ∈ trace.toList,
      cellsSize ((Lift.Trusted.Encode.encode x).map toCell) = 12 := by
    intro x _
    simp only [Lift.Trusted.Encode.encode, cellsSize, toCell, List.map_cons, List.map_nil,
      List.sum_cons, List.sum_nil, Width.bytes]
    omega
  rw [List.map_eq_map_iff.mpr h12, sum_map_const]
  simp

/-- A store that changes no cell of the object leaves it unchanged. -/
theorem obj_set_self {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (h : ∀ x ∈ offsets 0 o.cells, ¬ (o.addr + BitVec.ofNat 64 x.1 = a ∧ x.2.w = w)) :
    o.set a w v = o := by
  unfold Obj.set
  split
  · show { o with cells := _ } = o
    rw [setCells_of_no_match _ _ _ _ _ _ h]
  · rfl

/-- A store leaves a read-only object unchanged. -/
theorem obj_set_of_not_writable {o : Obj} (h : o.writable = false) (a : BitVec 64) (w : Width)
    (v : w.type) : o.set a w v = o := by
  unfold Obj.set
  rw [h]
  rfl

/-- A store of a heap `pre ++ frame` whose target is a cell of a writable object of `pre` leaves
`frame` in place: the result is `pre.map (Obj.set a w v) ++ frame`. -/
theorem heap_store_suffix {policy : CpuPolicy} {m : DataMem} {pre frame : Heap}
    {a : BitVec 64} {w : Width} {v : w.type} {h' : Heap}
    (hh : (pre ++ frame).Holds policy m) (hs : (pre ++ frame).store a w v = .ok h')
    {O : Obj} (hO : O ∈ pre) (hw : O.writable = true) (hc : O.Covers a) :
    h' = pre.map (Obj.set a w v) ++ frame := by
  have hsep : pre.Separated frame := hh.separated
  have hno : ¬ frame.Owned a :=
    hsep.symm.not_owned_of_covered (covered_of_owned ⟨O, hO, hw, hc⟩)
  have hfr : frame.map (Obj.set a w v) = frame := by
    conv => rhs; rw [← List.map_id frame]
    refine List.map_congr_left fun p hp => ?_
    by_cases hpw : p.writable = true
    case pos =>
      refine obj_set_self fun x hx hxa => hno ⟨p, hp, hpw, ?_⟩
      have hnw : p.addr.toNat + (p.cells.map fun c => c.w.bytes).sum ≤ 2 ^ 64 :=
        hh.noWrap p (List.mem_append_right pre hp)
      obtain ⟨-, hb2⟩ := offsets_bound (n := 0) hx
      have hb2' : x.1 + x.2.w.bytes ≤ (p.cells.map fun c => c.w.bytes).sum := by
        simpa using hb2
      have hpos := width_bytes_pos x.2.w
      have hlt : p.addr.toNat + x.1 < 2 ^ 64 := by omega
      have he : (p.addr + BitVec.ofNat 64 x.1).toNat = p.addr.toNat + x.1 :=
        toNat_add_ofNat _ _ hlt
      unfold Obj.Covers
      rw [← hxa.1, he]
      simp only [Obj.size]
      omega
    case neg =>
      have hw : p.writable = false := by
        cases h : p.writable with
        | false => rfl
        | true => exact absurd h hpw
      exact obj_set_of_not_writable hw a w v
  rw [(Heap.store_ok hs).1, List.map_append, hfr]

/-- The four written objects of the call: their addresses, sizes and writability. -/
def WGeo (self tr mp : BitVec 64) (pre : Heap) : Prop :=
  (∃ o ∈ pre, o.addr = self + 48 ∧ o.size = 8 ∧ o.writable = true) ∧
  (∃ o ∈ pre, o.addr = self + 64 ∧ o.size = 8 ∧ o.writable = true) ∧
  (∃ o ∈ pre, o.addr = tr ∧ o.size = 122880 ∧ o.writable = true) ∧
  (∃ o ∈ pre, o.addr = mp + 8192 ∧ o.size = 8192 ∧ o.writable = true)

/-- The objects of the call that the function reads: the three read-only ones. -/
def oR1 (self tr : BitVec 64) : Obj := Obj.words (self + 56) false .W64 [tr]

/-- The `mapping` pointer at `self + 72`, read only. -/
def oR2 (self mp : BitVec 64) : Obj := Obj.words (self + 72) false .W64 [mp]

/-- `destination_of` at `mp`, read only. -/
def oR3 (mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) : Obj :=
  Obj.words mp false .W64 xi.dest.toList

/-- The written object at `self + 48`. -/
def oW1 (self v : BitVec 64) : Obj := Obj.words (self + 48) true .W64 [v]

/-- The written object at `self + 64`. -/
def oW2 (self v : BitVec 64) : Obj := Obj.words (self + 64) true .W64 [v]

/-- The written trace array. -/
def oW3 (tr : BitVec 64) (xi : Lift.Pilot.PopSpec.In) : Obj :=
  toObj ⟨tr, Lift.Trusted.Encode.encode xi.trace, true⟩

/-- The written `position_of` array. -/
def oW4 (mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) : Obj :=
  Obj.words (mp + 8192) true .W64 xi.pos.toList

/-- The geometry of the prefix of the callee's heap: the four written objects, and the three
read-only objects. -/
def Geo (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) (pre : Heap) : Prop :=
  WGeo self tr mp pre ∧ oR1 self tr ∈ pre ∧ oR2 self mp ∈ pre ∧ oR3 mp xi ∈ pre

/-- A store keeps the geometry of the prefix. -/
theorem Geo.store {self tr mp : BitVec 64} {xi : Lift.Pilot.PopSpec.In} {pre : Heap}
    (hg : Geo self tr mp xi pre) (a : BitVec 64) (w : Width) (v : w.type) :
    Geo self tr mp xi (pre.map (Obj.set a w v)) := by
  obtain ⟨⟨h1, h2, h3, h4⟩, r1, r2, r3⟩ := hg
  refine ⟨⟨?_, ?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  · obtain ⟨o, ho, ha, hz, hw⟩ := h1
    exact ⟨Obj.set a w v o, List.mem_map_of_mem ho, by rw [Obj.set_addr, ha],
      by rw [Obj.set_size, hz], by rw [Obj.set_writable, hw]⟩
  · obtain ⟨o, ho, ha, hz, hw⟩ := h2
    exact ⟨Obj.set a w v o, List.mem_map_of_mem ho, by rw [Obj.set_addr, ha],
      by rw [Obj.set_size, hz], by rw [Obj.set_writable, hw]⟩
  · obtain ⟨o, ho, ha, hz, hw⟩ := h3
    exact ⟨Obj.set a w v o, List.mem_map_of_mem ho, by rw [Obj.set_addr, ha],
      by rw [Obj.set_size, hz], by rw [Obj.set_writable, hw]⟩
  · obtain ⟨o, ho, ha, hz, hw⟩ := h4
    exact ⟨Obj.set a w v o, List.mem_map_of_mem ho, by rw [Obj.set_addr, ha],
      by rw [Obj.set_size, hz], by rw [Obj.set_writable, hw]⟩
  · exact List.mem_map.mpr ⟨_, r1, obj_set_of_not_writable (by simp [oR1, Obj.words]) a w v⟩
  · exact List.mem_map.mpr ⟨_, r2, obj_set_of_not_writable (by simp [oR2, Obj.words]) a w v⟩
  · exact List.mem_map.mpr ⟨_, r3, obj_set_of_not_writable (by simp [oR3, Obj.words]) a w v⟩

/-- An object covers its own address. -/
theorem obj_covers_self {o : Obj} {p : BitVec 64} (ha : o.addr = p) (hz : 0 < o.size) :
    o.Covers p := by
  unfold Obj.Covers
  rw [ha]
  omega

/-- An object of `n` cells of 8 bytes at `p` covers the cell at index `k`. -/
theorem obj_covers_words {o : Obj} {p k : BitVec 64} {n : Nat} (ha : o.addr = p)
    (hz : o.size = 8 * n) (hnw : o.addr.toNat + o.size ≤ 2 ^ 64) (hk : k.toNat < n) :
    o.Covers (p + k * 8) := by
  unfold Obj.Covers
  rw [ha, hz] at *
  have h8 : (8 : BitVec 64).toNat = 8 := by decide
  have h1 : (k * 8).toNat = 8 * k.toNat := by
    rw [BitVec.toNat_mul, h8]
    omega
  have h2 : p.toNat + (k * 8).toNat < 2 ^ 64 := by omega
  have h3 : (p.toNat + (k * 8).toNat) % 2 ^ 64 = p.toNat + 8 * k.toNat := by
    rw [Nat.mod_eq_of_lt h2]
    omega
  show p.toNat ≤ (p.toNat + (k * 8).toNat) % 2 ^ 64 ∧
    (p.toNat + (k * 8).toNat) % 2 ^ 64 < p.toNat + 8 * n
  rw [h3]
  omega

/-- The trace object of the call covers the cell at index `k` of the trace, at byte `d`. -/
theorem obj_covers_trace {o : Obj} {tr k d : BitVec 64} {dd : Nat} (ha : o.addr = tr)
    (hz : o.size = 122880) (hnw : o.addr.toNat + o.size ≤ 2 ^ 64) (hk : k.toNat < 10240)
    (hd : d = BitVec.ofNat 64 dd) (hdd : dd < 12) : o.Covers (tr + k * 12 + d) := by
  unfold Obj.Covers
  rw [ha, hz] at *
  have h12 : (12 : BitVec 64).toNat = 12 := by decide
  have h1 : (k * 12).toNat = 12 * k.toNat := by
    rw [BitVec.toNat_mul, h12]
    omega
  have h2 : tr.toNat + (k * 12).toNat < 2 ^ 64 := by omega
  have h3 : (tr.toNat + (k * 12).toNat) % 2 ^ 64 = tr.toNat + 12 * k.toNat := by
    rw [Nat.mod_eq_of_lt h2]
    omega
  have hd' : d.toNat = dd := by rw [hd, BitVec.toNat_ofNat]; omega
  have hA : tr.toNat + 12 * k.toNat < 2 ^ 64 := by omega
  have hB : tr.toNat + 12 * k.toNat + dd < 2 ^ 64 := by omega
  have hsum : (tr + k * 12 + d).toNat = tr.toNat + 12 * k.toNat + dd := by
    rw [BitVec.toNat_add, BitVec.toNat_add, h1, hd', Nat.mod_eq_of_lt hA,
      Nat.mod_eq_of_lt hB]
  rw [hsum]
  omega

/-- The trace object of the call covers the cell at index `k` of the trace. -/
theorem obj_covers_trace0 {o : Obj} {tr k : BitVec 64} (ha : o.addr = tr)
    (hz : o.size = 122880) (hnw : o.addr.toNat + o.size ≤ 2 ^ 64) (hk : k.toNat < 10240) :
    o.Covers (tr + k * 12) := by
  have h := obj_covers_trace (d := 0) (dd := 0) ha hz hnw hk rfl (by omega)
  simpa using h

/-- One store of the callee's blocks: the prefix changes, the frame stays, and the new heap is
held. -/
theorem step_store {policy : CpuPolicy} {m : DataMem} {pre frame : Heap}
    {a : BitVec 64} {w : Width} {v : w.type} {h' : Heap}
    (hh : (pre ++ frame).Holds policy m) (hs : (pre ++ frame).store a w v = .ok h')
    {O : Obj} (hO : O ∈ pre) (hw : O.writable = true) (hc : O.Covers a) :
    ∃ m', pre.map (Obj.set a w v) ++ frame = h' ∧ h'.Holds policy m' := by
  obtain ⟨m', -, hh', -⟩ := Heap.store_sound hh hs
  exact ⟨m', (heap_store_suffix hh hs hO hw hc).symm, hh'⟩

/-- The store at `self + 48` leaves the object at `self + 64` unchanged. -/
theorem set_w1_w2 (self u v : BitVec 64) :
    (oW2 self u).set (self + 48) .W64 v = oW2 self u := by
  refine obj_set_self fun x hx hxa => ?_
  have hx' : x = (0, (⟨.W64, u⟩ : Cell)) := by simpa [oW2, Obj.words, offsets] using hx
  subst hx'
  simp only [oW2, Obj.words, BitVec.add_zero] at hxa
  obtain ⟨h1, -⟩ := hxa
  bv_omega

/-- The elements of a vector at equal indices. -/
theorem vector_get_congr {α : Type} {n : Nat} (v : Vector α n) {i j : Nat} (h : i = j)
    (hi : i < n) (hj : j < n) : v[i]'hi = v[j]'hj := by
  subst h
  rfl

/-- The encoding of a vector of words is the encoding of its list. -/
theorem encode_vector_words {n : Nat} (xs : Vector (BitVec 64) n) :
    Lift.Trusted.Encode.encode xs = Lift.Trusted.Encode.encode xs.toList := by
  have h1 : Lift.Trusted.Encode.encode xs = xs.toList.flatMap Lift.Trusted.Encode.encode := rfl
  have h2 : Lift.Trusted.Encode.encode xs.toList = xs.toList.map (fun v => ⟨.W64, v⟩) := rfl
  rw [h1, h2, List.map_eq_flatMap]
  rfl

/-- The first written object of the call is in the heap of the call. -/
theorem oW1_mem (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) :
    oW1 self xi.size ∈ objsP self tr mp xi := by
  refine List.mem_map.mpr ⟨⟨self + 48, Lift.Trusted.Encode.encode xi.size, true⟩, ?_, ?_⟩
  · simp [Lift.Shuffler.Internal.PopStatement.objects, Lift.Shuffler.Internal.PopStatement.written,
      List.mem_append]
  · exact (toObj_encode_words64 (self + 48) [xi.size] true).symm

/-- The second written object of the call is in the heap of the call. -/
theorem oW2_mem (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) :
    oW2 self xi.traceSize ∈ objsP self tr mp xi := by
  refine List.mem_map.mpr ⟨⟨self + 64, Lift.Trusted.Encode.encode xi.traceSize, true⟩, ?_, ?_⟩
  · simp [Lift.Shuffler.Internal.PopStatement.objects, Lift.Shuffler.Internal.PopStatement.written,
      List.mem_append]
  · exact (toObj_encode_words64 (self + 64) [xi.traceSize] true).symm

/-- The trace object of the call is in the heap of the call. -/
theorem oW3_mem (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) :
    oW3 tr xi ∈ objsP self tr mp xi :=
  List.mem_map_of_mem (by
    simp [Lift.Shuffler.Internal.PopStatement.objects, Lift.Shuffler.Internal.PopStatement.written,
      List.mem_append])

/-- The `position_of` object of the call is in the heap of the call. -/
theorem oW4_mem (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) :
    oW4 mp xi ∈ objsP self tr mp xi := by
  refine List.mem_map.mpr ⟨⟨mp + 8192, Lift.Trusted.Encode.encode xi.pos, true⟩, ?_, ?_⟩
  · simp [Lift.Shuffler.Internal.PopStatement.objects, Lift.Shuffler.Internal.PopStatement.written,
      List.mem_append]
  · rw [encode_vector_words]
    exact toObj_encode_words64 (mp + 8192) xi.pos.toList true

/-- The `stack.trace` object of the call is in the heap of the call. -/
theorem oR1_mem (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) :
    oR1 self tr ∈ objsP self tr mp xi := by
  refine List.mem_map.mpr ⟨⟨self + 56, Lift.Trusted.Encode.encode tr, false⟩, ?_, ?_⟩
  · simp [Lift.Shuffler.Internal.PopStatement.objects, Lift.Shuffler.Internal.PopStatement.written,
      List.mem_append]
  · exact (toObj_encode_words64 (self + 56) [tr] false).symm

/-- The `mapping` object of the call is in the heap of the call. -/
theorem oR2_mem (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) :
    oR2 self mp ∈ objsP self tr mp xi := by
  refine List.mem_map.mpr ⟨⟨self + 72, Lift.Trusted.Encode.encode mp, false⟩, ?_, ?_⟩
  · simp [Lift.Shuffler.Internal.PopStatement.objects, Lift.Shuffler.Internal.PopStatement.written,
      List.mem_append]
  · exact (toObj_encode_words64 (self + 72) [mp] false).symm

/-- The `destination_of` object of the call is in the heap of the call. -/
theorem oR3_mem (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) :
    oR3 mp xi ∈ objsP self tr mp xi := by
  refine List.mem_map.mpr ⟨⟨mp, Lift.Trusted.Encode.encode xi.dest, false⟩, ?_, ?_⟩
  · simp [Lift.Shuffler.Internal.PopStatement.objects, Lift.Shuffler.Internal.PopStatement.written,
      List.mem_append]
  · rw [encode_vector_words]
    exact toObj_encode_words64 mp xi.dest.toList false

/-- The geometry of the heap of the call. -/
theorem geo_init (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) :
    Geo self tr mp xi (objsP self tr mp xi) := by
  refine ⟨⟨⟨oW1 self xi.size, oW1_mem self tr mp xi, rfl, ?_, rfl⟩,
    ⟨oW2 self xi.traceSize, oW2_mem self tr mp xi, rfl, ?_, rfl⟩,
    ⟨oW3 tr xi, oW3_mem self tr mp xi, rfl, trace_obj_size tr xi.trace true, rfl⟩,
    ⟨oW4 mp xi, oW4_mem self tr mp xi, rfl, ?_, rfl⟩⟩,
    oR1_mem self tr mp xi, oR2_mem self tr mp xi, oR3_mem self tr mp xi⟩
  · simp [oW1, obj_words_size]
  · simp [oW2, obj_words_size]
  · simp [oW4, obj_words_size, Vector.length_toList]

/-- The read of the first written object of the call. -/
theorem read_oW1 {policy : CpuPolicy} {m : DataMem} {pre : Heap} (self v : BitVec 64)
    (hh : pre.Holds policy m) (h : oW1 self v ∈ pre) :
    readRam policy m (self + 48) .W64 = .ok v := by
  have hc : (0, (⟨.W64, v⟩ : Cell)) ∈ offsets 0 (oW1 self v).cells := by
    simp [oW1, Obj.words, offsets]
  simpa [oW1, Obj.words] using hh.read (oW1 self v) h (0, (⟨.W64, v⟩ : Cell)) hc

/-- The read of the second written object of the call. -/
theorem read_oW2 {policy : CpuPolicy} {m : DataMem} {pre : Heap} (self v : BitVec 64)
    (hh : pre.Holds policy m) (h : oW2 self v ∈ pre) :
    readRam policy m (self + 64) .W64 = .ok v := by
  have hc : (0, (⟨.W64, v⟩ : Cell)) ∈ offsets 0 (oW2 self v).cells := by
    simp [oW2, Obj.words, offsets]
  simpa [oW2, Obj.words] using hh.read (oW2 self v) h (0, (⟨.W64, v⟩ : Cell)) hc

/-- The read of the trace pointer of the call. -/
theorem read_oR1 {policy : CpuPolicy} {m : DataMem} {pre : Heap} (self tr : BitVec 64)
    (hh : pre.Holds policy m) (h : oR1 self tr ∈ pre) :
    readRam policy m (self + 56) .W64 = .ok tr := by
  have hc : (0, (⟨.W64, tr⟩ : Cell)) ∈ offsets 0 (oR1 self tr).cells := by
    simp [oR1, Obj.words, offsets]
  simpa [oR1, Obj.words] using hh.read (oR1 self tr) h (0, (⟨.W64, tr⟩ : Cell)) hc

/-- The read of the mapping pointer of the call. -/
theorem read_oR2 {policy : CpuPolicy} {m : DataMem} {pre : Heap} (self mp : BitVec 64)
    (hh : pre.Holds policy m) (h : oR2 self mp ∈ pre) :
    readRam policy m (self + 72) .W64 = .ok mp := by
  have hc : (0, (⟨.W64, mp⟩ : Cell)) ∈ offsets 0 (oR2 self mp).cells := by
    simp [oR2, Obj.words, offsets]
  simpa [oR2, Obj.words] using hh.read (oR2 self mp) h (0, (⟨.W64, mp⟩ : Cell)) hc

/-- The read of the `destination_of` entry at index `k` of the call. -/
theorem read_oR3 {policy : CpuPolicy} {m : DataMem} {pre : Heap} (mp : BitVec 64)
    (xi : Lift.Pilot.PopSpec.In) (hh : pre.Holds policy m) (h : oR3 mp xi ∈ pre)
    (k : BitVec 64) (hk : k.toNat < xi.dest.toList.length) :
    readRam policy m (mp + 8 * k) .W64 = .ok xi.dest.toList[k.toNat] := by
  have hl : pre.load (mp + 8 * k) .W64 = .ok xi.dest.toList[k.toNat] :=
    Heap.load_words64 hh (by simpa [oR3] using h) hk
  exact Heap.load_sound hh hl

/-- The invariant of the callee's blocks: the heap is a prefix followed by the frame, the prefix
has the geometry of the call's objects, and the facts that the next block reads. -/
def Inv (self tr mp : BitVec 64) (xi : Lift.Pilot.PopSpec.In) (frame : Heap)
    (a : skel_call.In2p) : Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x.input = a ∧ ∃ pre' m, x.mem = pre' ++ frame ∧ x.mem.Holds a.policy m ∧
      Geo self tr mp xi pre' ∧ oW1 self xi.size ∈ pre' ∧ oW2 self xi.traceSize ∈ pre'
  | .o14, x => x.input = a ∧ ∃ pre' m, x.mem = pre' ++ frame ∧ x.mem.Holds a.policy m ∧
      Geo self tr mp xi pre' ∧ oW2 self xi.traceSize ∈ pre' ∧ xi.size ≠ 0 ∧
      x.rcx.toBitVec = xi.size - 1
  | .o31, x => x.input = a ∧ ∃ pre' m, x.mem = pre' ++ frame ∧ x.mem.Holds a.policy m ∧
      Geo self tr mp xi pre' ∧ xi.size ≠ 0 ∧
      x.rdx.toBitVec = xi.traceSize ∧ x.rcx.toBitVec = xi.size - 1 ∧
      xi.traceSize.toNat < 10240
  | .o78, x => x.input = a ∧ ∃ pre' m, x.mem = pre' ++ frame ∧ x.mem.Holds a.policy m ∧
      Geo self tr mp xi pre' ∧ x.rax.toBitVec = mp ∧ x.rcx.toBitVec.toNat < 1024
  | .LBB20_4, x => x.input = a ∧ ∃ pre' m, x.mem = pre' ++ frame ∧ x.mem.Holds a.policy m ∧
      Geo self tr mp xi pre'
  | .LBB20_5, x => x.input = a ∧ ∃ pre' m, x.mem = pre' ++ frame ∧ x.mem.Holds a.policy m ∧
      Geo self tr mp xi pre'

/-- The result of the callee's blocks: the frame is a suffix of the returned heap. -/
def FRes (frame : Heap) (r : UInt64 × Heap) : Prop := ∃ pre', r.2 = pre' ++ frame
theorem call_frame : ∀ (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (x : Lift.Pilot.PopSpec.In) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre self tr mp frame x a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro self tr mp frame xi a q hpre hq m hm
  obtain ⟨hC, hrdi, hheap, m₀, hholds₀⟩ := hpre
  have hinit : Inv self tr mp xi frame a .entry (skel_call.initP a) :=
    ⟨rfl, objsP self tr mp xi, m₀, hheap, hholds₀, geo_init self tr mp xi,
      oW1_mem self tr mp xi, oW2_mem self tr mp xi⟩
  have hblock : ∀ l x n, Inv self tr mp xi frame a l x →
      skel_call.blocksP.step l x = .ok n →
      Lift.Sem.CallArm.Next.Inv (Inv self tr mp xi frame a) (FRes frame) noCall n := by
    intro l x n hI hstep
    cases l with
    | entry =>
      obtain ⟨hin, pre', m, hmem, hholds, hgeo, hw1, hw2⟩ := hI
      have hrdix : x.input.rdi.toBitVec = self := by rw [hin]; exact hrdi
      simp only [skel_call.blocksP] at hstep
      rw [hmem] at hholds hstep
      split at hstep
      · rename_i v hload
        have hls := Heap.load_sound hholds hload
        rw [hrdix] at hls
        have hr1 := read_oW1 self xi.size hholds (List.mem_append_left _ hw1)
        rw [hr1] at hls
        have hv : v = xi.size := by cases hls; rfl
        subst hv
        split at hstep
        · rename_i hge
          cases hstep
          refine ⟨by simpa using hin, pre', m, rfl, hholds, hgeo, hw2, ?_, ?_⟩
          · intro h0
            rw [h0] at hge
            simp at hge
          · simp
        · cases hstep
          exact ⟨by simpa using hin, pre', m, rfl, hholds, hgeo⟩
      · cases hstep
      · cases hstep
    | o14 =>
      obtain ⟨hin, pre', m, hmem, hholds, hgeo, hw2, hsne, hrcx⟩ := hI
      have hrdix : x.input.rdi.toBitVec = self := by rw [hin]; exact hrdi
      simp only [skel_call.blocksP] at hstep
      rw [hmem] at hholds hstep
      split at hstep
      · rename_i m1 hstore
        rw [hrdix] at hstore
        obtain ⟨O, hO, ha, hz, hw⟩ := hgeo.1.1
        have hnw := hholds.noWrap O (List.mem_append_left _ hO)
        have hc : O.Covers (self + 48) := obj_covers_self ha (by omega)
        obtain ⟨m1', hmem1, hholds1⟩ := step_store hholds hstore hO hw hc
        have hgeo1 : Geo self tr mp xi (pre'.map (Obj.set (self + 48) .W64 x.rcx.toBitVec)) :=
          Geo.store hgeo _ _ _
        have hw2' : oW2 self xi.traceSize ∈ pre'.map (Obj.set (self + 48) .W64 x.rcx.toBitVec) :=
          List.mem_map.mpr ⟨_, hw2, set_w1_w2 self xi.traceSize x.rcx.toBitVec⟩
        split at hstep
        · rename_i v hload
          rw [hrdix] at hload
          have hls := Heap.load_sound hholds1 hload
          have hr2 := read_oW2 self xi.traceSize (hmem1.symm ▸ hholds1)
            (List.mem_append_left _ hw2')
          rw [hr2] at hls
          have hv : v = xi.traceSize := by cases hls; rfl
          subst hv
          split at hstep
          · cases hstep
            exact ⟨by simpa using hin, _, m1', hmem1.symm, hholds1, hgeo1⟩
          · rename_i hlt
            cases hstep
            refine ⟨by simpa using hin, _, m1', hmem1.symm, hholds1, hgeo1, hsne, ?_, ?_, ?_⟩
            · simp
            · simpa using hrcx
            · have h3 : ¬ (10240 ≤ xi.traceSize.toNat) := hlt
              omega
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    | o31 =>
      obtain ⟨hin, pre', m, hmem, hholds, hgeo, hsne, hrdx, hrcx, hts⟩ := hI
      have hrdix : x.input.rdi.toBitVec = self := by rw [hin]; exact hrdi
      simp only [skel_call.blocksP] at hstep
      rw [hmem] at hholds hstep
      split at hstep
      · rename_i v hload
        rw [hrdix] at hload
        have hls := Heap.load_sound hholds hload
        have hr1 := read_oR1 self tr hholds (List.mem_append_left _ hgeo.2.1)
        rw [hr1] at hls
        have hvt : v = tr := ((Except.ok.injEq _ _).mp hls).symm
        split at hstep
        · rename_i m1 hA
          rw [hrdx] at hA
          obtain ⟨O3, hO3, ha3, hz3, hw3⟩ := hgeo.1.2.2.1
          have ha3v : O3.addr = v := by rw [ha3]; exact hvt.symm
          have hnw3 := hholds.noWrap O3 (List.mem_append_left _ hO3)
          have hcA : O3.Covers (v + xi.traceSize * 12) := by
            rw [hvt]
            exact obj_covers_trace0 ha3 hz3 (by omega) hts
          obtain ⟨m1', hmemA, hholdsA⟩ := step_store hholds hA hO3 hw3 hcA
          have hgeoA : Geo self tr mp xi
              (pre'.map (Obj.set (v + xi.traceSize * 12) .W16 (BitVec.truncate 16 (2 : BitVec 64)))) :=
            Geo.store hgeo _ _ _
          split at hstep
          · rename_i m2 hB
            rw [hrdx] at hB
            rw [← hmemA] at hB
            obtain ⟨O3b, hO3b, ha3b, hz3b, hw3b⟩ := hgeoA.1.2.2.1
            have hnw3b := (hmemA.symm ▸ hholdsA).noWrap O3b (List.mem_append_left _ hO3b)
            have hcB : O3b.Covers (v + xi.traceSize * 12 + 4) := by
              rw [hvt]
              exact obj_covers_trace (dd := 4) ha3b hz3b (by omega) hts rfl (by omega)
            obtain ⟨m2', hmemB, hholdsB⟩ := step_store (hmemA.symm ▸ hholdsA) hB hO3b hw3b hcB
            have hgeoB : Geo self tr mp xi
                ((pre'.map (Obj.set (v + xi.traceSize * 12) .W16 (BitVec.truncate 16 (2 : BitVec 64)))).map
                  (Obj.set (v + xi.traceSize * 12 + 4) .W64 5501853106176)) :=
              Geo.store hgeoA _ _ _
            split at hstep
            · rename_i v1 hload1
              split at hstep
              · rename_i m3 hCst
                rw [hrdix] at hCst
                rw [← hmemB] at hCst
                obtain ⟨O2, hO2, ha2, hz2, hw2⟩ := hgeoB.1.2.1
                have hnw2 := (hmemB.symm ▸ hholdsB).noWrap O2 (List.mem_append_left _ hO2)
                have hcC : O2.Covers (self + 64) := obj_covers_self ha2 (by omega)
                obtain ⟨m3', hmemC, hholdsC⟩ := step_store (hmemB.symm ▸ hholdsB) hCst hO2 hw2 hcC
                have hgeoC : Geo self tr mp xi
                    (((pre'.map (Obj.set (v + xi.traceSize * 12) .W16 (BitVec.truncate 16 (2 : BitVec 64)))).map
                      (Obj.set (v + xi.traceSize * 12 + 4) .W64 5501853106176)).map
                        (Obj.set (self + 64) .W64 (v1 + 1))) :=
                  Geo.store hgeoB _ _ _
                have hhC : (m3).Holds a.policy m3' := hholdsC
                split at hstep
                · rename_i v2 hload2
                  rw [hrdix] at hload2
                  rw [← hmemC] at hload2
                  have hls2 := Heap.load_sound (hmemC.symm ▸ hholdsC) hload2
                  have hr2 := read_oR2 self mp (hmemC.symm ▸ hholdsC)
                    (List.mem_append_left _ hgeoC.2.2.1)
                  rw [hr2] at hls2
                  have hv2 : v2 = mp := ((Except.ok.injEq _ _).mp hls2).symm
                  split at hstep
                  · rename_i v3 hload3
                    rw [hv2] at hload3
                    rw [← hmemC] at hload3
                    obtain ⟨hsz, hdest⟩ := hC hsne hts
                    have hk1 : (xi.size - 1).toNat < 1024 := by bv_omega
                    have hk : x.rcx.toBitVec.toNat < 1024 := by rw [hrcx]; exact hk1
                    have hls3 := Heap.load_sound (hmemC.symm ▸ hholdsC) hload3
                    have hr3 := read_oR3 mp xi (hmemC.symm ▸ hholdsC)
                      (List.mem_append_left _ hgeoC.2.2.2) x.rcx.toBitVec (by simpa using hk)
                    rw [BitVec.mul_comm] at hls3
                    rw [hr3] at hls3
                    have hidx : x.rcx.toBitVec.toNat = (xi.size - 1).toNat := by rw [hrcx]
                    have e0 : xi.dest[x.rcx.toBitVec.toNat]'hk = xi.dest[(xi.size - 1).toNat]'hk1 :=
                      vector_get_congr xi.dest hidx hk hk1
                    have hv3 : v3 = xi.dest[x.rcx.toBitVec.toNat]'hk := by
                      have h := ((Except.ok.injEq _ _).mp hls3).symm
                      rw [h]
                      exact Vector.getElem_toList (by simpa using hk)
                    split at hstep
                    · cases hstep
                      exact ⟨by simpa using hin, _, m3', hmemC.symm, hholdsC, hgeoC⟩
                    · rename_i hne
                      cases hstep
                      refine ⟨by simpa using hin, _, m3', hmemC.symm, hholdsC, hgeoC, ?_, ?_⟩
                      · simp [hv2]
                      · have hd3 : v3.toNat < 1024 := by
                          rw [hv3, e0]
                          rcases hdest hk1 with hnone | hlt
                          · exfalso
                            apply hne
                            rw [hv3, e0, hnone]
                            simp [Lift.Pilot.IsRetainedSpec.none64]
                          · exact hlt
                        show v3.toNat < 1024
                        exact hd3
                  · cases hstep
                  · cases hstep
                · cases hstep
                · cases hstep
              · cases hstep
              · cases hstep
            · cases hstep
            · cases hstep
          · cases hstep
          · cases hstep
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    | o78 =>
      obtain ⟨hin, pre', m, hmem, hholds, hgeo, hrax, hrcxk⟩ := hI
      simp only [skel_call.blocksP] at hstep
      rw [hmem] at hholds hstep
      split at hstep
      · rename_i v hload
        split at hstep
        · rename_i m1 hstore
          obtain ⟨O, hO, ha, hz, hw⟩ := hgeo.1.2.2.2
          have hnw := hholds.noWrap O (List.mem_append_left _ hO)
          have hc : O.Covers (x.rax.toBitVec + x.rcx.toBitVec * 8 + 8192) := by
            have e : x.rax.toBitVec + x.rcx.toBitVec * 8 + 8192
                = (mp + 8192) + x.rcx.toBitVec * 8 := by
              rw [hrax]
              ac_rfl
            rw [e]
            exact obj_covers_words ha hz (by omega) hrcxk
          obtain ⟨m1', hmem1, hholds1⟩ := step_store hholds hstore hO hw hc
          have hgeo1 : Geo self tr mp xi (pre'.map (Obj.set (x.rax.toBitVec + x.rcx.toBitVec * 8 + 8192) .W64 (v ||| 18446744073709551615))) :=
            Geo.store hgeo _ _ _
          cases hstep
          exact ⟨by simpa using hin, _, m1', hmem1.symm, hholds1, hgeo1⟩
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    | LBB20_4 =>
      obtain ⟨hin, pre', m, hmem, hholds, hgeo⟩ := hI
      simp only [skel_call.blocksP] at hstep
      cases hstep
      exact ⟨by simpa using hin, pre', m, by simpa using hmem, hholds, hgeo⟩
    | LBB20_5 =>
      obtain ⟨hin, pre', m, hmem, hholds, hgeo⟩ := hI
      simp only [skel_call.blocksP] at hstep
      cases hstep
      exact ⟨pre', hmem⟩
  have hres : FRes frame q :=
    Lift.Sem.CallArm.Blocks.Returns.inv (Inv self tr mp xi frame a) (FRes frame) hblock hq hinit
  obtain ⟨pre', hq'⟩ := hres
  rw [hq'] at hm
  exact Heap.Holds.sublist hm (List.sublist_append_right pre' frame)
end call_frame.skel_proof
theorem call_frame : call_frame.skel_statement := @call_frame.skel_proof.call_frame
def call_shape.skel_statement : Prop := ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2
namespace call_shape.skel_proof
skel_proof_aliases call_shape.skel_proof excluding [skel_call.summary_shape, call_shape]
namespace skel_call

theorem summary_shape : ∀ a r, l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2 := by
  intro a r h
  refine Lift.Sem.CallArm.Blocks.Returns.inv (fun _ x => Lift.Sem.CallArm.Shape a.heap x.mem) (fun r => Lift.Sem.CallArm.Shape a.heap r.2) ?_ h (Lift.Sem.CallArm.Shape.refl _)
  rintro l x n hsh hstep
  cases l with
  | entry =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i v hl0
      simp only [Res.ok.injEq] at hstep
      subst hstep
      split <;> exact hsh
    · cases hstep
    · cases hstep
  | o14 =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i h hst0
      split at hstep
      · rename_i v hl0
        simp only [Res.ok.injEq] at hstep
        subst hstep
        split <;> exact (Lift.Sem.CallArm.Shape.store hsh hst0)
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o31 =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i v hl0
      split at hstep
      · rename_i h hst0
        split at hstep
        · rename_i h1 hst1
          split at hstep
          · rename_i v1 hl1
            split at hstep
            · rename_i h2 hst2
              split at hstep
              · rename_i v2 hl2
                split at hstep
                · rename_i v3 hl3
                  simp only [Res.ok.injEq] at hstep
                  subst hstep
                  split <;> exact (Lift.Sem.CallArm.Shape.store (Lift.Sem.CallArm.Shape.store (Lift.Sem.CallArm.Shape.store hsh hst0) hst1) hst2)
                · cases hstep
                · cases hstep
              · cases hstep
              · cases hstep
            · cases hstep
            · cases hstep
          · cases hstep
          · cases hstep
        · cases hstep
        · cases hstep
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o78 =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i v hl0
      split at hstep
      · rename_i h hst0
        simp only [Res.ok.injEq] at hstep
        subst hstep
        exact (Lift.Sem.CallArm.Shape.store hsh hst0)
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | LBB20_4 =>
    simp only [blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact hsh
  | LBB20_5 =>
    simp only [blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact hsh

end skel_call
theorem call_shape : ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2 := by exact skel_call.summary_shape
end call_shape.skel_proof
theorem call_shape : call_shape.skel_statement := @call_shape.skel_proof.call_shape
theorem call_summary : callSummary := by
  intro self tr mp frame x a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 self tr mp frame x (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨⟨r, hrel, hmap⟩, call_shape a q hq, call_frame self tr mp frame x a q hs hq⟩⟩
end skel_semantic

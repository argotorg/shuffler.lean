/-- The memory has the four written objects of a heap of the form `heapX`. -/
theorem has_written_heapX (self tr mp : BitVec 64) (sz ts : BitVec 64) (o3 : Lift.Sem.Obj)
    (pos dest : Vector (BitVec 64) 1024) (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (hh : (heapX self tr mp sz ts o3 pos dest frame).Holds pol m)
    (trace' : Vector Lift.Pilot.PopSpec.ShuffleOp 10240)
    (h3 : Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode trace', true⟩ = o3) :
    ∀ o ∈ Lift.Shuffler.Internal.PopStatement.written self tr mp sz ts trace' pos,
      Lift.Trusted.Mem.has pol m o := by
  intro o ho
  simp only [heapX] at hh
  refine Lift.Sem.Bridge.has_of_holds_mem hh ?_
  simp only [Lift.Shuffler.Internal.PopStatement.written, List.mem_cons, List.not_mem_nil,
    or_false] at ho
  rcases ho with h1 | h2 | h3' | h4
  · subst h1; exact List.mem_cons_self ..
  · subst h2; exact List.mem_cons_of_mem _ (List.mem_cons_self ..)
  · subst h3'
    rw [h3]
    exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_self ..))
  · subst h4
    exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
      (List.mem_cons_self ..)))
theorem refines_l3 : ∀ (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap), Refines (SimArr self tr mp frame) (fun x a y r => Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP self tr mp x ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.PopStatement.post x self tr mp a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) (fun x y => Lift.Pilot.PopSpec.run x = some y) l2p.returns := by
  intro self tr mp frame x a y hs hy
  have hC : Lift.Pilot.PopSpec.C x := hs.1
  have hself : a.rdi.toBitVec = self := hs.2.1
  have hheap : a.heap = objsP self tr mp x ++ frame := hs.2.2.1
  have hm : ∃ m, a.heap.Holds a.policy m := hs.2.2.2
  subst hself
  by_cases hz : x.size = 0
  · have hy' : y = ⟨.failed, x.size, x.traceSize, x.trace, x.pos⟩ := by
      simpa [Lift.Pilot.PopSpec.run, hz] using hy.symm
    subst hy'
    have hrax : (((a.rax &&& 18446744073709486080) ||| (1 &&& 65535) : UInt64).toBitVec.setWidth 16) = 1 := by
      bv_decide
    have henc : Lift.Trusted.Encode.encode (Lift.Pilot.PopSpec.Assert.failed) =
        [⟨.W16, (((a.rax &&& 18446744073709486080) ||| (1 &&& 65535) : UInt64).toBitVec.setWidth 16)⟩] := by
      rw [show Lift.Trusted.Encode.encode Lift.Pilot.PopSpec.Assert.failed = [⟨.W16, (1 : BitVec 16)⟩] from rfl,
        hrax]
    lift_straight
    case ret_4 =>
      refine ⟨henc, hheap, ?_⟩
      intro m hh
      refine ⟨_, hy, henc, ?_⟩
      intro o ho
      have hh' : Heap.Holds a.policy (objsP a.rdi.toBitVec tr mp x ++ frame) m := by
        simpa [initP, hheap] using hh
      refine Lift.Sem.Bridge.has_of_holds_mem hh' ?_
      have ho' : o ∈ Lift.Shuffler.Internal.PopStatement.written a.rdi.toBitVec tr mp x.size x.traceSize x.trace x.pos := ho
      rw [objsP, Lift.Shuffler.Internal.PopStatement.objects, List.map_append]
      refine List.mem_append_left _ (List.mem_append_left _ ?_)
      exact List.mem_map_of_mem (f := Lift.Sem.Bridge.toObj) ho'
    case ret_1 =>
      exfalso
      simp only [initP] at hp1
      rw [hheap, load48] at hp1
      simp only [Lift.Sem.Res.ok.injEq] at hp1
      subst hp1
      rw [hz] at hp2
      exact absurd hp2 (by decide)
    case ret_2 =>
      exfalso

    (s : MachineState), decompiles_l2_inv policy a s₀ .entry x s → ∀ (n : Next Lbl (St In2 DataMem) (UInt64 × DataMem) Empty Empty.elim Empty.elim),
    blocks.step .entry x = .ok n → Reaches Lift.Shuffler.L1.step policy (fun t => match n with
      | .goto l' x' => decompiles_l2_inv policy a s₀ l' x' t
      | .ret r => l2.post a r s₀ t

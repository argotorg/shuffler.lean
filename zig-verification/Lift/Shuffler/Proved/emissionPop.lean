          ∀ z u, (noCallee f).post y z t u → decompiles_l2_inv policy a s₀ (k z).1 (k z).2 u) s := by
  rintro policy a s₀ x s ⟨hrep, rfl, hat, hent, hkeep, hmapped⟩ n hn
  have ⟨hpol, hmem, he, hrax, hrdi, hsp⟩ := hrep

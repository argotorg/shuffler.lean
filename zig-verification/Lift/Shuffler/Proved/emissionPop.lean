  have hoff : (((mp + 8192) + BitVec.ofNat 64 (8 * d)) - (Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode pos, true⟩).addr).toNat = 8 * d := by
    have h1 : ((mp + 8192) + BitVec.ofNat 64 (8 * d)) - (Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode pos, true⟩).addr = BitVec.ofNat 64 (8 * d) := by
      simp only [Lift.Sem.Bridge.toObj]; bv_omega
    rw [h1, BitVec.toNat_ofNat]; omega
  have hst : Lift.Sem.Heap.StoreAt ((mp + 8192) + BitVec.ofNat 64 (8 * d)) .W64 (BitVec.allOnes 64)
      (heapX self tr mp sz ts o3 pos dest frame)
      (Lift.Sem.Bridge.toObj ⟨self + 48, Lift.Trusted.Encode.encode sz, true⟩ ::
        Lift.Sem.Bridge.toObj ⟨self + 64, Lift.Trusted.Encode.encode ts, true⟩ ::
        o3 ::
        Lift.Sem.Obj.setAt ((mp + 8192) + BitVec.ofNat 64 (8 * d)) .W64 (BitVec.allOnes 64) (Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode pos, true⟩) ::
        (heapX self tr mp sz ts o3 pos dest frame).tail.tail.tail.tail) := by
    refine Lift.Sem.Heap.StoreAt.tail (o := Lift.Sem.Bridge.toObj ⟨self + 48, Lift.Trusted.Encode.encode sz, true⟩)
      (Lift.Sem.Heap.StoreAt.tail (o := Lift.Sem.Bridge.toObj ⟨self + 64, Lift.Trusted.Encode.encode ts, true⟩)
      (Lift.Sem.Heap.StoreAt.tail (o := o3)
      (Lift.Sem.Heap.StoreAt.head (o := Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode pos, true⟩)
        (t := (heapX self tr mp sz ts o3 pos dest frame).tail.tail.tail.tail) rfl ?_)))
    show (Lift.Sem.cellGet (Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode pos, true⟩).cells
      (((mp + 8192) + BitVec.ofNat 64 (8 * d)) - (Lift.Sem.Bridge.toObj ⟨mp + 8192, Lift.Trusted.Encode.encode pos, true⟩).addr).toNat Width.W64).isSome = true
    rw [hoff, cell_arr pos (mp + 8192) true d hd]

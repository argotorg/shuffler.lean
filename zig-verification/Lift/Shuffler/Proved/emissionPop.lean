/-- A load of the element `d` of the array of positions. -/
theorem loadPos_heapX (self tr mp : BitVec 64) (sz ts : BitVec 64) (o3 : Lift.Sem.Obj)
    (pos dest : Vector (BitVec 64) 1024) (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (d : Nat) (hd : d < 1024)
    (hh : (heapX self tr mp sz ts o3 pos dest frame).Holds pol m) :
    (heapX self tr mp sz ts o3 pos dest frame).load
        ((mp + 8192) + BitVec.ofNat 64 (8 * d)) .W64 = .ok pos[d] := by
  have hoff : ((mp + 8192) + BitVec.ofNat 64 (8 * d) - (mp + 8192)).toNat = 8 * d := by
    rw [show (mp + 8192) + BitVec.ofNat 64 (8 * d) - (mp + 8192)
        = BitVec.ofNat 64 (8 * d) from by bv_omega]
    rw [BitVec.toNat_ofNat]
    omega
  refine Lift.Sem.Heap.load_of_found hh (Lift.Sem.Heap.Found.tail (Lift.Sem.Heap.Found.tail
    (Lift.Sem.Heap.Found.tail (Lift.Sem.Heap.Found.head ?_))))
  simp only [Lift.Sem.Bridge.toObj]
  rw [hoff]
  exact cell_arr pos (mp + 8192) true d hd

/-- A load of the element `d` of the array of destinations. -/
theorem loadDest_heapX (self tr mp : BitVec 64) (sz ts : BitVec 64) (o3 : Lift.Sem.Obj)
    (pos dest : Vector (BitVec 64) 1024) (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (d : Nat) (hd : d < 1024)
    (hh : (heapX self tr mp sz ts o3 pos dest frame).Holds pol m) :
    (heapX self tr mp sz ts o3 pos dest frame).load
        (mp + BitVec.ofNat 64 (8 * d)) .W64 = .ok dest[d] := by
  have hoff : (mp + BitVec.ofNat 64 (8 * d) - mp).toNat = 8 * d := by
    rw [show mp + BitVec.ofNat 64 (8 * d) - mp = BitVec.ofNat 64 (8 * d) from by bv_omega]
    rw [BitVec.toNat_ofNat]
    omega
  refine Lift.Sem.Heap.load_of_found hh (Lift.Sem.Heap.Found.tail (Lift.Sem.Heap.Found.tail
    (Lift.Sem.Heap.Found.tail (Lift.Sem.Heap.Found.tail (Lift.Sem.Heap.Found.tail
      (Lift.Sem.Heap.Found.tail (Lift.Sem.Heap.Found.head ?_)))))))
  simp only [Lift.Sem.Bridge.toObj]
  rw [hoff]
  exact cell_arr dest mp false d hd

/-- The cells of an element of the trace. -/
theorem cell_trace16 (trace : Vector Lift.Pilot.PopSpec.ShuffleOp 10240) (tr : BitVec 64) (i : Nat)
    (hi : i < 10240) :
    (Lift.Sem.cellGet (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode trace, true⟩).cells
      (12 * i) Width.W16).isSome := by
  have henc : ∀ a : Lift.Pilot.PopSpec.ShuffleOp,
      (Lift.Trusted.Encode.encode a).map Lift.Sem.Bridge.toCell
        = [⟨Width.W16, a.depth ++ a.kind⟩, ⟨Width.W16, a.pad⟩, ⟨Width.W64, a.slot.word⟩] := fun a => rfl
  have hcells : (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode trace, true⟩).cells
      = trace.toList.flatMap (fun a => [⟨Width.W16, a.depth ++ a.kind⟩, ⟨Width.W16, a.pad⟩, ⟨Width.W64, a.slot.word⟩]) := by
    simp [Lift.Sem.Bridge.toObj, Lift.Trusted.Encode.encode, List.map_flatMap, henc, Lift.Sem.Bridge.toCell]
  have hsz : ∀ a : Lift.Pilot.PopSpec.ShuffleOp,
      Lift.Sem.cellsSize [⟨Width.W16, a.depth ++ a.kind⟩, ⟨Width.W16, a.pad⟩, ⟨Width.W64, a.slot.word⟩] = 12 := by
    intro a; simp [Lift.Sem.cellsSize, Width.bytes]
  rw [hcells, show 12 * i = i * 12 + 0 from by omega]
  rw [Lift.Sem.cellGet_flatMap Width.W16 hsz (by simpa using hi) (by decide : 0 < 12)]
  simp [Lift.Sem.cellGet, Lift.Sem.Cell.get]

theorem store16_heapX (x : Lift.Pilot.PopSpec.In) (self tr mp : BitVec 64) (sz ts : BitVec 64)
    (pos dest : Vector (BitVec 64) 1024) (frame : Heap) (pol : CpuPolicy) (m : DataMem)
    (i : Nat) (hi : i < 10240)
    (hh : (heapX self tr mp sz ts
      (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode x.trace, true⟩) pos dest frame).Holds pol m) :
    (heapX self tr mp sz ts (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode x.trace, true⟩)
        pos dest frame).store (tr + BitVec.ofNat 64 (12 * i)) .W16 (BitVec.truncate 16 (2 : BitVec 64)) =
      .ok (heapX self tr mp sz ts
        (Lift.Sem.Obj.setAt (tr + BitVec.ofNat 64 (12 * i)) .W16 (BitVec.truncate 16 (2 : BitVec 64))
          (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode x.trace, true⟩)) pos dest frame) := by
  have hst : Lift.Sem.Heap.StoreAt (tr + BitVec.ofNat 64 (12 * i)) .W16 (BitVec.truncate 16 (2 : BitVec 64))
      (heapX self tr mp sz ts (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode x.trace, true⟩)
        pos dest frame)
      (heapX self tr mp sz ts
        (Lift.Sem.Obj.setAt (tr + BitVec.ofNat 64 (12 * i)) .W16 (BitVec.truncate 16 (2 : BitVec 64))
          (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode x.trace, true⟩)) pos dest frame) := by
    refine Lift.Sem.Heap.StoreAt.tail
      (o := Lift.Sem.Bridge.toObj ⟨self + 48, Lift.Trusted.Encode.encode sz, true⟩)
      (Lift.Sem.Heap.StoreAt.tail
      (o := Lift.Sem.Bridge.toObj ⟨self + 64, Lift.Trusted.Encode.encode ts, true⟩)
      (Lift.Sem.Heap.StoreAt.head
        (o := Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode x.trace, true⟩)
        (t := (heapX self tr mp sz ts
          (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode x.trace, true⟩) pos dest frame).tail.tail.tail)
        rfl ?_))
    have hoff : (tr + BitVec.ofNat 64 (12 * i) - tr).toNat = 12 * i := by
      rw [show tr + BitVec.ofNat 64 (12 * i) - tr = BitVec.ofNat 64 (12 * i) from by bv_omega]
      rw [BitVec.toNat_ofNat]
      omega
    simp only [Lift.Sem.Bridge.toObj]
    rw [hoff]
    exact cell_trace16 x.trace tr i hi
  exact Lift.Sem.Heap.store_of_storeAt hh hst

/-- The cells of an element of the trace after the store of its first cell. -/
theorem cell_trace64_set (trace : Vector Lift.Pilot.PopSpec.ShuffleOp 10240) (tr : BitVec 64) (i : Nat)
    (hi : i < 10240) :
    (Lift.Sem.cellGet (Lift.Sem.Obj.setAt (tr + BitVec.ofNat 64 (12 * i)) Width.W16
      (BitVec.truncate 16 (2 : BitVec 64))
      (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode trace, true⟩)).cells

/-- The store of the new size, on `heap4`. -/
theorem store48_heap4 (self tr mp : BitVec 64) (sz ts : BitVec 64)
    (trace : Vector Lift.Pilot.PopSpec.ShuffleOp 10240) (pos dest : Vector (BitVec 64) 1024)
    (frame : Heap) (pol : CpuPolicy) (m : DataMem) (h' : Heap)
    (hh : (heap4 self tr mp sz ts trace pos dest frame).Holds pol m)
    (hs : (heap4 self tr mp sz ts trace pos dest frame).store (self + 48) .W64 (sz - 1) = .ok h') :
    h' = heap4 self tr mp (sz - 1) ts trace pos dest frame := by
  have hst : Lift.Sem.Heap.StoreAt (self + 48) .W64 (sz - 1)
      (heap4 self tr mp sz ts trace pos dest frame)
      (Lift.Sem.Obj.setAt (self + 48) .W64 (sz - 1)
          (Lift.Sem.Bridge.toObj ⟨self + 48, Lift.Trusted.Encode.encode sz, true⟩) ::
        (heap4 self tr mp sz ts trace pos dest frame).tail) := by
    refine Lift.Sem.Heap.StoreAt.head
      (o := Lift.Sem.Bridge.toObj ⟨self + 48, Lift.Trusted.Encode.encode sz, true⟩)
      (t := (heap4 self tr mp sz ts trace pos dest frame).tail) rfl ?_
    simp [Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, Lift.Trusted.Encode.encode, Lift.Sem.cellGet,
      Lift.Sem.Cell.get]
  have h1 := Lift.Sem.Heap.store_of_storeAt hh hst
  rw [h1] at hs
  have h2 := (Lift.Sem.Res.ok.injEq _ _).mp hs
  rw [← h2]
  simp only [heap4, List.tail_cons]
  rw [setAt48 sz self (sz - 1)]

/-- A store that is stuck is not a store. -/

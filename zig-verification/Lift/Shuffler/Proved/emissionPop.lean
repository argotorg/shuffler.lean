  rfl

/-- The array of positions after the store of `none`. -/
theorem setAtPos (pos : Vector (BitVec 64) 1024) (mp : BitVec 64) (d : Nat) (hd : d < 1024) :
    Lift.Sem.Obj.setAt ((mp + 8192) + BitVec.ofNat 64 (8 * d)) Width.W64 (BitVec.allOnes 64)

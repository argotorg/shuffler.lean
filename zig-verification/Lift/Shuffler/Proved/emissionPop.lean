  | .o14, x, s => ∃ f, s = ⟨{ s₀.data with regs := { s₀.data.regs with rax := x.rax, rcx := x.rcx }, dmem := x.mem, status := f }, Lift.Shuffler.emissionPopPC + 14⟩

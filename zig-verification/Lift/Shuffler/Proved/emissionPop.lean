theorem setAtPos_cells (pos : Vector (BitVec 64) 1024) (mp : BitVec 64) (d : Nat)
    (hd : d < pos.toList.length) :
    Lift.Sem.cellSet (pos.toList.flatMap cellOpW) (8 * d) Width.W64 (BitVec.allOnes 64)
      = (pos.toList.set d (BitVec.allOnes 64)).flatMap cellOpW := by
  have hsz : ∀ v : BitVec 64, Lift.Sem.cellsSize (cellOpW v) = 8 := by
    intro v; simp [cellOpW, Lift.Sem.cellsSize, Width.bytes]
  have h0 : 0 < 8 := by decide

  rw [Lift.Sem.cellSet_flatMap_zero (w := Width.W16) (v := BitVec.truncate 16 (2 : BitVec 64)) hsz
    (by simpa using hi) (by decide : 0 < 12)]
  rw [Lift.Sem.cellGet_append_left Width.W64 (by rw [Lift.Sem.cellsSize_append, htake, hB]; omega)]
  rw [Lift.Sem.cellGet_append_right Width.W64 (by rw [htake]; omega)]
  rw [htake, show i * 12 + 4 - 12 * i = 4 from by omega]
  rw [Lift.Sem.cellSet_cons_zero]
  simp [Lift.Sem.cellGet, Lift.Sem.Cell.get, Width.bytes]


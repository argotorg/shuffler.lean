/-- The cell at index `d` of an array of words. -/
theorem cell_arr (xs : Vector (BitVec 64) 1024) (base : BitVec 64) (wr : Bool) (d : Nat)
    (hd : d < 1024) :
    Lift.Sem.cellGet (Lift.Sem.Bridge.toObj ⟨base, Lift.Trusted.Encode.encode xs, wr⟩).cells
      (8 * d) Width.W64 = some xs[d] := by
  have hsz : ∀ v : BitVec 64, Lift.Sem.cellsSize [⟨Width.W64, v⟩] = 8 := by intro v; rfl
  rw [show (Lift.Sem.Bridge.toObj ⟨base, Lift.Trusted.Encode.encode xs, wr⟩).cells
      = xs.toList.flatMap (fun v => [⟨Width.W64, v⟩]) from by
    simp [Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, Lift.Trusted.Encode.encode, List.map_flatMap]]
  rw [show 8 * d = d * 8 + 0 from by omega]
  rw [Lift.Sem.cellGet_flatMap Width.W64 hsz (by simpa using hd) (by decide : 0 < 8)]
  rw [Lift.Sem.cellGet_cons_zero, Lift.Sem.Cell.get_self]
  congr 2


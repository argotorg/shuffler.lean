def postP (a : In2p) (r : UInt64 × Heap) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ r.2.Holds a.policy t.data.dmem ∧ ∀ b, ¬ a.heap.Owned b → t.data.dmem.get? b = s.data.dmem.get? b

def l2p : Model In2p (UInt64 × Heap) where
  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.emissionPopPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rdi = a.rdi ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocksP.Returns noCall .entry (initP a) r
  post := postP


def objsP (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (x : Lift.Pilot.PopSpec.In) : Heap := (Lift.Shuffler.Internal.PopStatement.objects x self tr mp).map toObj

def SimIn (a : In2p) (b : In2) : Prop := a.policy = b.policy ∧ a.rax = b.rax ∧ a.rdi = b.rdi ∧ a.heap.Holds b.policy b.mem ∧ (∀ c, Private b.sp c → ¬ Covered a.heap c) ∧ a.sp = b.sp

def SimSt (x : St In2p Heap) (y : St In2 DataMem) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rcx = y.rcx ∧ x.rdx = y.rdx ∧ x.rsi = y.rsi ∧ x.mem.Holds y.input.policy y.mem ∧ ∀ b, ¬ x.input.heap.Owned b → y.mem.get? b = y.input.mem.get? b

def SimOut (x : In2p) (y : In2) (r : UInt64 × Heap) (r' : UInt64 × DataMem) : Prop := r.1 = r'.1 ∧ r.2.Holds x.policy r'.2 ∧ ∀ b, ¬ x.heap.Owned b → r'.2.get? b = y.mem.get? b

def SimArr (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (x : Lift.Pilot.PopSpec.In) (a : In2p) : Prop := (Lift.Pilot.PopSpec.C x) ∧ a.rdi.toBitVec = self ∧ a.heap = objsP self tr mp x ++ frame ∧ ∃ m, a.heap.Holds a.policy m

def l3 (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (pol : CpuPolicy) := show Model Lift.Pilot.PopSpec.In _ from
  { rep policy x s := policy = pol ∧ Heap.Holds policy (objsP self tr mp x ++ frame) s.data.dmem ∧ (Lift.Pilot.PopSpec.C x) ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.emissionPopPC s ∧ s.data.regs.rdi.toBitVec = self ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered (objsP self tr mp x ++ frame) b)
    returns x y := Lift.Pilot.PopSpec.run x = some y
    post x y s t := SysV.Exit s t ∧ Lift.Trusted.Encode.encode y.1 = [⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩] ∧ Lift.Shuffler.Internal.PopStatement.post x self tr mp pol ⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩ t.data.dmem ∧ ∀ b, ¬ (objsP self tr mp x ++ frame).Owned b → t.data.dmem.get? b = s.data.dmem.get? b }

namespace skel_call

structure In2p where
  policy : CpuPolicy
  heap : Heap
  rax : UInt64
  rdi : UInt64
  sp : BitVec 64 := 0

def initP (a : In2p) : St In2p Heap := ⟨a, a.rax, 0, 0, 0, a.heap⟩

def blocksP : Leaf Lbl (St In2p Heap) (UInt64 × Heap) where
  step
    | .entry, x =>
      match x.mem.load (x.input.rdi.toBitVec + 48) .W64 with
      | .ok v =>
        .ok (if 1 ≤ UInt64.ofBitVec v then .goto .o14 { x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := UInt64.ofBitVec v - 1 } else .goto .LBB20_5 { x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := UInt64.ofBitVec v - 1 })
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o14, x =>
      match x.mem.store (x.input.rdi.toBitVec + 48) .W64 x.rcx.toBitVec with
      | .ok h =>
        match h.load (x.input.rdi.toBitVec + 64) .W64 with
        | .ok v =>
          .ok (if 10240 ≤ UInt64.ofBitVec v then .goto .LBB20_5 { x with rdx := UInt64.ofBitVec v, mem := h } else .goto .o31 { x with rdx := UInt64.ofBitVec v, mem := h })
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o31, x =>
      match x.mem.load (x.input.rdi.toBitVec + 56) .W64 with
      | .ok v =>
        match x.mem.store (v + x.rdx.toBitVec * 12) .W16 (BitVec.truncate 16 (2 : BitVec 64)) with
        | .ok h =>
          match h.store (v + x.rdx.toBitVec * 12 + 4) .W64 5501853106176 with
          | .ok h1 =>
            match h1.load (x.input.rdi.toBitVec + 64) .W64 with
            | .ok v1 =>
              match h1.store (x.input.rdi.toBitVec + 64) .W64 (v1 + 1) with
              | .ok h2 =>
                match h2.load (x.input.rdi.toBitVec + 72) .W64 with
                | .ok v2 =>
                  match h2.load (v2 + x.rcx.toBitVec * 8) .W64 with
                  | .ok v3 =>
                    .ok (if UInt64.ofBitVec v3 = 18446744073709551615 then .goto .LBB20_4 { x with rax := UInt64.ofBitVec v2, rcx := UInt64.ofBitVec v3, rdx := x.rdx * 12, rsi := 5501853106176, mem := h2 } else .goto .o78 { x with rax := UInt64.ofBitVec v2, rcx := UInt64.ofBitVec v3, rdx := x.rdx * 12, rsi := 5501853106176, mem := h2 })
                  | .stuck why => .stuck why
                  | .noFuel => .noFuel
                | .stuck why => .stuck why
                | .noFuel => .noFuel
              | .stuck why => .stuck why
              | .noFuel => .noFuel
            | .stuck why => .stuck why
            | .noFuel => .noFuel
          | .stuck why => .stuck why
          | .noFuel => .noFuel
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o78, x =>
      match x.mem.load (x.rax.toBitVec + x.rcx.toBitVec * 8 + 8192) .W64 with
      | .ok v =>
        match x.mem.store (x.rax.toBitVec + x.rcx.toBitVec * 8 + 8192) .W64 (v ||| 18446744073709551615) with
        | .ok h =>
          .ok (.goto .LBB20_4 { x with mem := h })
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .LBB20_4, x =>
      .ok (.goto .LBB20_5 { x with rax := 0 })
    | .LBB20_5, x =>
      .ok (.ret (x.rax, x.mem))

def postP (a : In2p) (r : UInt64 × Heap) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ r.2.Holds a.policy t.data.dmem ∧ ∀ b, ¬ a.heap.Owned b → t.data.dmem.get? b = s.data.dmem.get? b

def l2p : Model In2p (UInt64 × Heap) where
  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.emissionPopPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rdi = a.rdi ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocksP.Returns noCall .entry (initP a) r
  post := postP


end skel_call

def callInput (a : skel_call.In2p) : In2p := { policy := a.policy, heap := a.heap, rax := a.rax, rdi := a.rdi, sp := a.sp }

def callState (x : St In2p Heap) (z : St skel_call.In2p Heap) : Prop := x.input = callInput z.input ∧ x.rax = z.rax ∧ x.rcx = z.rcx ∧ x.rdx = z.rdx ∧ x.rsi = z.rsi ∧ x.mem = z.mem ∧ True

def callPre (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (x : Lift.Pilot.PopSpec.In) (a : skel_call.In2p) : Prop := SimArr self tr mp frame x (callInput a)

def callPost (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (x : Lift.Pilot.PopSpec.In) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Pilot.PopSpec.run x)) (q : (UInt64 × Heap)) : Prop := (∃ (r : (UInt64 × Heap)), (Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ (callInput a).heap = objsP self tr mp x ++ frame ∧ ∀ m, r.2.Holds (callInput a).policy m → Lift.Shuffler.Internal.PopStatement.post x self tr mp (callInput a).policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) ∧ r = q) ∧ Lift.Sem.CallArm.Shape a.heap q.2 ∧ (∀ m, q.2.Holds a.policy m → frame.Holds a.policy m)

abbrev callSummary : Prop := ∀ (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (x : Lift.Pilot.PopSpec.In) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Pilot.PopSpec.run x)), callPre self tr mp frame x a → Lift.Pilot.PopSpec.run x = some y → ∃ q, skel_call.l2p.returns a q ∧ callPost self tr mp frame x a y q

theorem refines_l3 : refines_l3.skel_statement := @refines_l3.skel_proof.refines_l3
theorem above_l3 : ∀ (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (pol : CpuPolicy), Above l2p (l3 self tr mp frame pol) := by
  intro self tr mp frame pol
  refine Above.ofRefines (fun _ _ => SimArr self tr mp frame) _ (fun _ _ => refines_l3 self tr mp frame) ?_ ?_
  · rintro policy x s ⟨hpol, hh, hC, he, hq0, harea⟩
    exact ⟨⟨policy, objsP self tr mp x ++ frame, s.data.regs.rax, s.data.regs.rdi, s.data.regs.rsp.toBitVec⟩, ⟨rfl, hh, he, rfl, rfl, harea, rfl⟩, ⟨hC, hq0, rfl, ⟨_, hh⟩⟩⟩
  · rintro policy _ a s y r t ⟨hp, -⟩ ⟨hbp, -⟩ ⟨hv, hain, hm⟩ ⟨hex, hrax, hh, hfr⟩
    rw [hain] at hfr
    exact ⟨hex, by rw [hrax]; exact hv, by rw [hrax, ← hp, ← hbp]; exact hm _ hh, hfr⟩
theorem total : ∀ (x : Lift.Pilot.PopSpec.In) (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64), Lift.Pilot.PopSpec.C x → ∃ y, Lift.Pilot.PopSpec.run x = some y := by intros; apply Lift.Pilot.PopSpec.total; assumption
theorem decompiles : ∀ (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (pol : CpuPolicy), Decompiles Lift.Shuffler.L1.step (l3 self tr mp frame pol) := by intros; apply Decompiles.above (decompiles_l2.above above_l2p); apply above_l3
theorem decompiles_code : ∀ (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (pol : CpuPolicy), Decompiles (fun s => Lift.Shuffler.Code.code.step s .done) (l3 self tr mp frame pol) := by intros; exact (Sites.decompiles_l1Spec_iff Lift.Shuffler.Code.code Lift.Shuffler.L1.step Lift.Shuffler.L1.spec _).mp (by apply decompiles)
theorem contract : ∀ (self : BitVec 64) (tr : BitVec 64) (mp : BitVec 64) (frame : Heap) (pol : CpuPolicy) (policy : CpuPolicy) (x : Lift.Pilot.PopSpec.In) (s : MachineState), (l3 self tr mp frame pol).rep policy x s → Lift.Pilot.PopSpec.C x → Reaches (fun s => Lift.Shuffler.Code.code.step s .done) policy (fun t => ∃ y, (l3 self tr mp frame pol).post x y s t ∧ Lift.Pilot.PopSpec.run x = some y) s := by intro self tr mp; intros; apply Decompiles.transfer _ Lift.Pilot.PopSpec.C (fun x y => Lift.Pilot.PopSpec.run x = some y) (fun x h => total x self tr mp h) (fun _ _ _ h => h) <;> first | assumption | apply decompiles_code
theorem final : Lift.Shuffler.Internal.PopStatement.PopStatement := by
  intro x hC self tr mp policy ra s he
  have hrep : (l3 self tr mp [] policy).rep policy x s :=
    ⟨rfl, Lift.Sem.Final.holds he, hC, Lift.Sem.Bridge.Fn.Entry.sysV (lo := Lift.Shuffler.shufflePC) (hi := Lift.Shuffler.shufflerEndPC) he (by decide +kernel) (by decide +kernel), Lift.Sem.Final.bv64 he.inRegs 0 rfl, Lift.Sem.Final.not_covered he 0 rfl⟩
  refine (contract self tr mp [] policy policy x s hrep hC).mono ?_
  rintro t ⟨y, ⟨hexit, hrel, hpp, hmem⟩, hrun⟩
  refine Lift.Sem.Final.ret he 0 rfl hexit (fun b ho _ => hmem b ho) ?_
  exact hpp
theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : (UInt64 × Heap)) (q : (UInt64 × Heap)) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst a
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    callState (fun (r : (UInt64 × Heap)) (q : (UInt64 × Heap)) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l x z n hs ht
      rcases hs with ⟨hinput, h_rax, h_rcx, h_rdx, h_rsi, h_mem, htrue⟩
      cases l <;> simp only [blocksP, callInput, hinput, h_rax, h_rcx, h_rdx, h_rsi, h_mem] at ht
      all_goals repeat' split at ht
      all_goals simp only [Res.ok.injEq, reduceCtorEq] at ht
      all_goals subst n
      all_goals simp_all [skel_call.blocksP, Lift.Sem.Next.Sim, callState, callInput]
      all_goals repeat' split
      all_goals (try simp_all)
      all_goals (simp only [UInt64.lt_iff_toNat_lt, UInt64.le_iff_toNat_le] at *; omega))
    hr (by simp [callState, initP, skel_call.initP, callInput])
def call_bridge_rev.skel_statement : Prop := Refines (fun a b => b = callInput a) (fun _ _ (q : (UInt64 × Heap)) (r : (UInt64 × Heap)) => r = q) skel_call.l2p.returns l2p.returns
namespace call_bridge_rev.skel_proof
skel_proof_aliases call_bridge_rev.skel_proof excluding [bridgeState, BridgeHiNext, BridgeLoNext, bridgeNext, bridgeRes, bridgeState_related, bridge_related_eq, bridgeNext_related, bridgeNext_related_rev, bridge_goto, bridge_step_eq_entry, bridge_step_eq_o14, bridge_step_eq_o31, bridge_step_eq_o78, bridge_step_eq_LBB20_4, bridge_step_eq_LBB20_5, bridge_step_eq, call_bridge_rev]
def bridgeState (z : St skel_call.In2p Heap) : St In2p Heap := { input := callInput z.input, rax := z.rax, rcx := z.rcx, rdx := z.rdx, rsi := z.rsi, mem := z.mem }

abbrev BridgeHiNext := Next Lbl (St In2p Heap) (UInt64 × Heap) Empty Empty.elim Empty.elim
abbrev BridgeLoNext := Next Lbl (St skel_call.In2p Heap) (UInt64 × Heap) Empty Empty.elim Empty.elim

def bridgeNext : BridgeLoNext → BridgeHiNext
  | .goto l z => .goto l (bridgeState z)
  | .ret r => .ret r
  | .call f x k => .call f x (fun r => ((k r).1, bridgeState (k r).2))

def bridgeRes : Res BridgeLoNext → Res BridgeHiNext
  | .ok n => .ok (bridgeNext n)
  | .stuck why => .stuck why
  | .noFuel => .noFuel

theorem bridgeState_related (z : St skel_call.In2p Heap) : callState (bridgeState z) z := by
  simp [callState, bridgeState]

theorem bridge_related_eq (x : St In2p Heap) (z : St skel_call.In2p Heap)
    (h : callState x z) : x = bridgeState z := by
  cases x
  cases z
  simp_all [callState, bridgeState, callInput]

theorem bridgeNext_related (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      callState (fun (r : (UInt64 × Heap)) (q : (UInt64 × Heap)) => r = q) (bridgeNext n) (.ok n) := by
  cases n with
  | goto l z => exact ⟨z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, k, rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridgeNext_related_rev (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      (fun z x => callState x z) (fun (q : (UInt64 × Heap)) (r : (UInt64 × Heap)) => r = q) n (.ok (bridgeNext n)) := by
  cases n with
  | goto l z => exact ⟨bridgeState z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, (fun r => ((k r).1, bridgeState (k r).2)), rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩


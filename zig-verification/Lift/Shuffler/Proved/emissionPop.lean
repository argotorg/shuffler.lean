        rfl ?_))
    have hoff : (tr + BitVec.ofNat 64 (12 * i) + 4 -
        (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode x.trace, true⟩).addr).toNat = 12 * i + 4 := by
      rw [show (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode x.trace, true⟩).addr = tr from rfl]
      have h1 : tr + BitVec.ofNat 64 (12 * i) + 4 - tr = BitVec.ofNat 64 (12 * i) + 4 := by bv_omega
      rw [h1, BitVec.toNat_add, BitVec.toNat_ofNat, show (4 : BitVec 64).toNat = 4 from by decide]
      omega
    simp only [Lift.Sem.Obj.setAt]
    rw [hoff]
    exact cell_trace64_set x.trace tr i hi
  exact Lift.Sem.Heap.store_of_storeAt hh hst

/-- The `kind` and `depth` of the element that `pop` writes: `2` and `0` as one 16-bit field. -/
theorem junk_kd (a : Lift.Pilot.PopSpec.ShuffleOp) :
    ({ a with kind := 2, depth := 0, slot := Lift.Pilot.PopSpec.junk } : Lift.Pilot.PopSpec.ShuffleOp).depth ++
      ({ a with kind := 2, depth := 0, slot := Lift.Pilot.PopSpec.junk } : Lift.Pilot.PopSpec.ShuffleOp).kind =
      BitVec.truncate 16 (2 : BitVec 64) := by
  show (0 : BitVec 8) ++ (2 : BitVec 8) = BitVec.truncate 16 (2 : BitVec 64)
  decide

theorem junk_slot : Lift.Pilot.PopSpec.junk.word = 5501853106176 := by decide

theorem or_allOnes (a : BitVec 64) : a ||| 18446744073709551615 = BitVec.allOnes 64 := by
  bv_decide

/-- The cells of one element of the trace. -/
def cellOp (a : Lift.Pilot.PopSpec.ShuffleOp) : List Lift.Sem.Cell :=
  [⟨Width.W16, a.depth ++ a.kind⟩, ⟨Width.W16, a.pad⟩, ⟨Width.W64, a.slot.word⟩]

/-- The cells of the trace object. -/
theorem trace_cells (trace : Vector Lift.Pilot.PopSpec.ShuffleOp 10240) (tr : BitVec 64) :
    (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode trace, true⟩).cells = trace.toList.flatMap cellOp := by
  simp [Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, Lift.Trusted.Encode.encode, List.map_flatMap]
  rfl

theorem cellOp_size (a : Lift.Pilot.PopSpec.ShuffleOp) : Lift.Sem.cellsSize (cellOp a) = 12 := by
  simp [cellOp, Lift.Sem.cellsSize, Width.bytes]

/-- The cells of the trace after the two stores of `pop` at the element `i`. -/
theorem setAtTrace_cells (trace : Vector Lift.Pilot.PopSpec.ShuffleOp 10240) (i : Nat)
    (hi : i < trace.toList.length) (op : Lift.Pilot.PopSpec.ShuffleOp)
    (hpad : op.pad = (trace.toList[i]'hi).pad)
    (hkd : op.depth ++ op.kind = BitVec.truncate 16 (2 : BitVec 64))
    (hslot : op.slot.word = 5501853106176) :
    Lift.Sem.cellSet (Lift.Sem.cellSet (trace.toList.flatMap cellOp) (i * 12) Width.W16 (BitVec.truncate 16 (2 : BitVec 64)))
        (i * 12 + 4) Width.W64 5501853106176
      = (trace.toList.set i op).flatMap cellOp := by
  have hi2 : i < 10240 := by simpa using hi
  have htake : Lift.Sem.cellsSize ((trace.toList.take i).flatMap cellOp) = 12 * i := by
    rw [Lift.Sem.cellsSize_flatMap, List.map_congr_left (fun x _ => cellOp_size x), Lift.Sem.sum_map_const, List.length_take]
    simp only [Vector.length_toList]; omega
  rw [Lift.Sem.cellSet_flatMap_zero Width.W16 (BitVec.truncate 16 (2 : BitVec 64)) cellOp_size hi (by decide : 0 < 12)]
  rw [Lift.Sem.flatMap_set op hi]
  have hset1 : Lift.Sem.cellSet (cellOp (trace.toList[i]'hi)) 0 Width.W16 (BitVec.truncate 16 (2 : BitVec 64))
      = [⟨Width.W16, BitVec.truncate 16 (2 : BitVec 64)⟩, ⟨Width.W16, (trace.toList[i]'hi).pad⟩, ⟨Width.W64, (trace.toList[i]'hi).slot.word⟩] := by
    simp [cellOp, Lift.Sem.cellSet_cons_zero]
  rw [hset1]
  rw [Lift.Sem.cellSet_append_left Width.W64 5501853106176 (by rw [Lift.Sem.cellsSize_append, htake]; simp [Lift.Sem.cellsSize]; omega)]
  rw [Lift.Sem.cellSet_append_right Width.W64 5501853106176 (by rw [htake]; omega)]
  rw [htake, show i * 12 + 4 - 12 * i = 4 from by omega]
  rw [Lift.Sem.cellSet_cons_ge Width.W64 5501853106176 (by decide : Width.W16.bytes ≤ 4)]
  rw [show 4 - Width.W16.bytes = 2 from by decide]
  rw [Lift.Sem.cellSet_cons_ge Width.W64 5501853106176 (by decide : Width.W16.bytes ≤ 2)]
  rw [show 2 - Width.W16.bytes = 0 from by decide]
  rw [Lift.Sem.cellSet_cons_zero]
  simp only [Lift.Sem.Cell.get, ite_true]
  rw [show cellOp op = [⟨Width.W16, BitVec.truncate 16 (2 : BitVec 64)⟩, ⟨Width.W16, (trace.toList[i]'hi).pad⟩, ⟨Width.W64, 5501853106176⟩] from by
    simp [cellOp, hpad, hkd, hslot]]

/-- The trace object after the two stores of `pop` at the element `i`. -/
theorem setAtTrace (trace : Vector Lift.Pilot.PopSpec.ShuffleOp 10240) (tr : BitVec 64) (i : Nat)
    (hi : i < trace.toList.length) (op : Lift.Pilot.PopSpec.ShuffleOp)
    (hpad : op.pad = (trace.toList[i]'hi).pad)
    (hkd : op.depth ++ op.kind = BitVec.truncate 16 (2 : BitVec 64))
    (hslot : op.slot.word = 5501853106176) :
    Lift.Sem.Obj.setAt (tr + BitVec.ofNat 64 (12 * i) + 4) Width.W64 5501853106176
      (Lift.Sem.Obj.setAt (tr + BitVec.ofNat 64 (12 * i)) Width.W16 (BitVec.truncate 16 (2 : BitVec 64))
        (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode trace, true⟩)) =
    Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode (trace.set i op (by simpa using hi)), true⟩ := by
  have hi2 : i < 10240 := by simpa using hi
  have ho1 : (tr + BitVec.ofNat 64 (12 * i) - tr).toNat = 12 * i := by
    rw [show tr + BitVec.ofNat 64 (12 * i) - tr = BitVec.ofNat 64 (12 * i) from by bv_omega]
    rw [BitVec.toNat_ofNat]; omega
  have ho2 : (tr + BitVec.ofNat 64 (12 * i) + 4 - tr).toNat = 12 * i + 4 := by
    rw [show tr + BitVec.ofNat 64 (12 * i) + 4 - tr = BitVec.ofNat 64 (12 * i) + 4 from by bv_omega]
    rw [BitVec.toNat_add, BitVec.toNat_ofNat, show (4 : BitVec 64).toNat = 4 from by decide]
    omega
  have htoList : (trace.set i op (by simpa using hi)).toList = trace.toList.set i op := Vector.toList_set _
  have h1 : (Lift.Sem.Obj.setAt (tr + BitVec.ofNat 64 (12 * i) + 4) Width.W64 5501853106176
      (Lift.Sem.Obj.setAt (tr + BitVec.ofNat 64 (12 * i)) Width.W16 (BitVec.truncate 16 (2 : BitVec 64))
        (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode trace, true⟩))).cells
      = Lift.Sem.cellSet (Lift.Sem.cellSet (trace.toList.flatMap cellOp) (i * 12) Width.W16 (BitVec.truncate 16 (2 : BitVec 64))) (i * 12 + 4) Width.W64 5501853106176 := by
    simp only [Lift.Sem.Obj.setAt]
    rw [trace_cells]
    show Lift.Sem.cellSet (Lift.Sem.cellSet (trace.toList.flatMap cellOp) (tr + BitVec.ofNat 64 (12 * i) - tr).toNat Width.W16 (BitVec.truncate 16 (2 : BitVec 64))) (tr + BitVec.ofNat 64 (12 * i) + 4 - tr).toNat Width.W64 5501853106176 = _
    rw [ho1, ho2, show 12 * i = i * 12 from by omega]
  have h2 : (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode (trace.set i op (by simpa using hi)), true⟩).cells
      = (trace.toList.set i op).flatMap cellOp := by
    rw [trace_cells, htoList]
  show (⟨tr, true, (Lift.Sem.Obj.setAt (tr + BitVec.ofNat 64 (12 * i) + 4) Width.W64 5501853106176
      (Lift.Sem.Obj.setAt (tr + BitVec.ofNat 64 (12 * i)) Width.W16 (BitVec.truncate 16 (2 : BitVec 64))
        (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode trace, true⟩))).cells⟩ : Lift.Sem.Obj)
    = ⟨tr, true, (Lift.Sem.Bridge.toObj ⟨tr, Lift.Trusted.Encode.encode (trace.set i op (by simpa using hi)), true⟩).cells⟩
  rw [h1, h2, setAtTrace_cells trace i hi op hpad hkd hslot]

/-- The cells of one word of an array. -/
def cellOpW (v : BitVec 64) : List Lift.Sem.Cell := [⟨Width.W64, v⟩]

theorem pos_cells (pos : Vector (BitVec 64) 1024) (mp : BitVec 64) :
    (Lift.Sem.Bridge.toObj ⟨mp, Lift.Trusted.Encode.encode pos, true⟩).cells = pos.toList.flatMap cellOpW := by
  simp [Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, Lift.Trusted.Encode.encode, List.map_flatMap, cellOpW]

    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      (fun z x => callState x z) (fun (q : (UInt64 × Heap)) (r : (UInt64 × Heap)) => r = q) n (.ok (bridgeNext n)) := by
  cases n with

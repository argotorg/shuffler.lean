def callInput (a : skel_call.In2p) : In2p := { policy := a.policy, heap := a.heap, rax := a.rax, rdx := a.rdx, rsi := a.rsi, rdi := a.rdi, sp := a.sp }

def callState (x : St In2p Heap) (z : St skel_call.In2p Heap) : Prop := x.input = callInput z.input ∧ x.rax = z.rax ∧ x.rcx = z.rcx ∧ x.mem = z.mem ∧ True

def callPre (self : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (s : Nat) (t : Nat) (a : skel_call.In2p) : Prop := SimArr self dp mp frame dropped dest pos s t (callInput a)

def callPost (self : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (s : Nat) (t : Nat) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Pilot.MapSpec.run dropped dest pos s t)) (q : (UInt64 × Heap)) : Prop := (∃ (r : (UInt64 × Heap)), (Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ (callInput a).heap = objsP self dp mp dropped dest pos s t ++ frame ∧ ∀ m, r.2.Holds (callInput a).policy m → Lift.Shuffler.Internal.MapStatement.post dropped dest pos s t mp (callInput a).policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) ∧ r = q) ∧ Lift.Sem.CallArm.Shape a.heap q.2 ∧ (∀ m, q.2.Holds a.policy m → frame.Holds a.policy m)

abbrev callSummary : Prop := ∀ (self : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (s : Nat) (t : Nat) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Pilot.MapSpec.run dropped dest pos s t)), callPre self dp mp frame dropped dest pos s t a → Lift.Pilot.MapSpec.run dropped dest pos s t = some y → ∃ q, skel_call.l2p.returns a q ∧ callPost self dp mp frame dropped dest pos s t a y q

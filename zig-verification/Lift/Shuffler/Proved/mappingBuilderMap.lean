theorem Obj.set_eq_self_of_not_covers {o : Obj} {a : BitVec 64} {w : Width} {v : w.type}
    (hn : o.addr.toNat + o.size ≤ 2 ^ 64) (hc : ¬ o.Covers a) : o.set a w v = o := by
  unfold Obj.set
  split
  · rename_i hw
    have h : setCells o.addr a w v 0 o.cells = o.cells := by
      rw [setCells_of_no_match]
      intro x hx hcon
      apply hc
      obtain ⟨e, b⟩ := Obj.toNat_cell hn hx
      rw [hcon.1] at e
      have := width_bytes_pos x.2.w
      unfold Obj.Covers
      omega
    rw [h]
  · rfl


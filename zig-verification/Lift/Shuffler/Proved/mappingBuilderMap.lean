theorem refines_l3 : ∀ (self : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (s : Nat) (t : Nat), Refines (fun (_ : Unit) => SimArr self dp mp frame dropped dest pos s t) (fun _ a y r => Lift.Trusted.Encode.encode y.1 = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP self dp mp dropped dest pos s t ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.MapStatement.post dropped dest pos s t mp a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) (fun _ y => Lift.Pilot.MapSpec.run dropped dest pos s t = some y) l2p.returns := by
  intro self dp mp frame dropped dest pos s t
  intro x a y hs hy
  split_hyps
  rename_i hrdi hrsi hrdx hheap w hheld
  have hri : a.rsi.toBitVec = BitVec.ofNat 64 s := by
    rw [← hrsi]
    exact ((BitVec.ofNat_toNat 64 a.rsi.toBitVec).trans (BitVec.setWidth_eq _)).symm
  have hrd : a.rdx.toBitVec = BitVec.ofNat 64 t := by
    rw [← hrdx]
    exact ((BitVec.ofNat_toNat 64 a.rdx.toBitVec).trans (BitVec.setWidth_eq _)).symm

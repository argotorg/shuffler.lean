namespace skel_semantic
structure In2 where
  policy : CpuPolicy
  mem : DataMem
  sp : BitVec 64
  rax : UInt64
  rdx : UInt64
  rsi : UInt64
  rdi : UInt64

inductive Lbl where
  | entry
  | o14
  | o25
  | o36
  | LBB25_4

structure St (I M : Type) where
  input : I
  rax : UInt64
  rcx : UInt64
  mem : M

def init (a : In2) : St In2 DataMem := ⟨a, a.rax, 0, a.mem⟩

abbrev Private (sp b : BitVec 64) : Prop := (b - (sp - 0)).toNat < 8

abbrev Clear (sp a : BitVec 64) (n : Nat := 8) : Prop := ∀ i, i < n → ¬ Private sp (a + BitVec.ofNat 64 i)

def blocks : Leaf Lbl (St In2 DataMem) (UInt64 × DataMem) where
  step
    | .entry, x =>
      match readRam x.input.policy x.mem (x.input.rdi.toBitVec + 32) .W64 with
      | .ok v =>
        match readRam x.input.policy x.mem (v + x.input.rsi.toBitVec * 1) .W8 with
        | .ok v1 =>
          .ok (if UInt64.ofBitVec (BitVec.zeroExtend 64 v1) = 0 then .goto .o14 { x with rcx := UInt64.ofBitVec v, rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535) } else .goto .LBB25_4 { x with rcx := UInt64.ofBitVec v, rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535) })
        | .error _ => .stuck "read"
      | .error _ => .stuck "read"
    | .o14, x =>
      match readRam x.input.policy x.mem (x.input.rdi.toBitVec + 48) .W64 with
      | .ok v =>
        match readRam x.input.policy x.mem (v + x.input.rsi.toBitVec * 8) .W64 with
        | .ok v1 =>
          .ok (if UInt64.ofBitVec v1 = 18446744073709551615 then .goto .o25 { x with rcx := UInt64.ofBitVec v } else .goto .LBB25_4 { x with rcx := UInt64.ofBitVec v })
        | .error _ => .stuck "read"
      | .error _ => .stuck "read"
    | .o25, x =>
      match readRam x.input.policy x.mem (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64 with
      | .ok v =>
        .ok (if UInt64.ofBitVec v = 18446744073709551615 then .goto .o36 x else .goto .LBB25_4 x)
      | .error _ => .stuck "read"
    | .o36, x =>
      if Clear x.input.sp (x.rcx.toBitVec + x.input.rsi.toBitVec * 8) then
        match writeRam x.input.policy x.mem (x.rcx.toBitVec + x.input.rsi.toBitVec * 8) .W64 x.input.rdx.toBitVec with
        | .ok m1 =>
          if Clear x.input.sp (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) then
            match writeRam x.input.policy m1 (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64 x.input.rsi.toBitVec with
            | .ok m2 =>
              .ok (.goto .LBB25_4 { x with mem := m2, rax := 0 })
            | .error _ => .stuck "store"
          else .stuck "store: private stack area"
        | .error _ => .stuck "store"
      else .stuck "store: private stack area"
    | .LBB25_4, x =>
      .ok (.ret (x.rax, x.mem))

def post {A : Type} (_ : A) (r : (UInt64 × DataMem)) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ t.data.dmem = r.2 ∧ SysV.MappedMemory s.data.dmem t.data.dmem

def l2 : Model In2 (UInt64 × DataMem) where
  rep policy a s := a.policy = policy ∧ a.mem = s.data.dmem ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderMapPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rdx = a.rdx ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocks.Returns noCall .entry (init a) r
  post := post

def At (s₀ : MachineState) : Lbl → St In2 DataMem → MachineState → Prop
  | .entry, _, s => s = s₀
  | .o14, x, s => ∃ f, s = ⟨{ s₀.data with regs := { s₀.data.regs with rax := x.rax, rcx := x.rcx }, dmem := x.mem, status := f }, Lift.Shuffler.mappingBuilderMapPC + 14⟩
  | .o25, x, s => ∃ f, s = ⟨{ s₀.data with regs := { s₀.data.regs with rax := x.rax, rcx := x.rcx }, dmem := x.mem, status := f }, Lift.Shuffler.mappingBuilderMapPC + 25⟩
  | .o36, x, s => ∃ f, s = ⟨{ s₀.data with regs := { s₀.data.regs with rax := x.rax, rcx := x.rcx }, dmem := x.mem, status := f }, Lift.Shuffler.mappingBuilderMapPC + 36⟩
  | .LBB25_4, x, s => ∃ f, s = ⟨{ s₀.data with regs := { s₀.data.regs with rax := x.rax, rcx := x.rcx }, dmem := x.mem, status := f }, Lift.Shuffler.mappingBuilderMapPC + 50⟩


structure In2p where
  policy : CpuPolicy
  heap : Heap
  rax : UInt64
  rdx : UInt64
  rsi : UInt64
  rdi : UInt64
  sp : BitVec 64 := 0

def initP (a : In2p) : St In2p Heap := ⟨a, a.rax, 0, a.heap⟩

def blocksP : Leaf Lbl (St In2p Heap) (UInt64 × Heap) where
  step
    | .entry, x =>
      match x.mem.load (x.input.rdi.toBitVec + 32) .W64 with
      | .ok v =>
        match x.mem.load (v + x.input.rsi.toBitVec * 1) .W8 with
        | .ok v1 =>
          .ok (if UInt64.ofBitVec (BitVec.zeroExtend 64 v1) = 0 then .goto .o14 { x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := UInt64.ofBitVec v } else .goto .LBB25_4 { x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := UInt64.ofBitVec v })
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o14, x =>
      match x.mem.load (x.input.rdi.toBitVec + 48) .W64 with
      | .ok v =>
        match x.mem.load (v + x.input.rsi.toBitVec * 8) .W64 with
        | .ok v1 =>
          .ok (if UInt64.ofBitVec v1 = 18446744073709551615 then .goto .o25 { x with rcx := UInt64.ofBitVec v } else .goto .LBB25_4 { x with rcx := UInt64.ofBitVec v })
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o25, x =>
      match x.mem.load (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64 with
      | .ok v =>
        .ok (if UInt64.ofBitVec v = 18446744073709551615 then .goto .o36 x else .goto .LBB25_4 x)
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o36, x =>
      match x.mem.store (x.rcx.toBitVec + x.input.rsi.toBitVec * 8) .W64 x.input.rdx.toBitVec with
      | .ok h =>
        match h.store (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64 x.input.rsi.toBitVec with
        | .ok h1 =>
          .ok (.goto .LBB25_4 { x with rax := 0, mem := h1 })
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .LBB25_4, x =>
      .ok (.ret (x.rax, x.mem))

def postP (a : In2p) (r : UInt64 × Heap) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ r.2.Holds a.policy t.data.dmem ∧ ∀ b, ¬ a.heap.Owned b → t.data.dmem.get? b = s.data.dmem.get? b

def l2p : Model In2p (UInt64 × Heap) where
  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderMapPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rdx = a.rdx ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocksP.Returns noCall .entry (initP a) r
  post := postP


def objsP (self : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (s : Nat) (t : Nat) : Heap := (Lift.Shuffler.Internal.MapStatement.objects dropped dest pos self dp mp).map toObj

def SimIn (a : In2p) (b : In2) : Prop := a.policy = b.policy ∧ a.rax = b.rax ∧ a.rdx = b.rdx ∧ a.rsi = b.rsi ∧ a.rdi = b.rdi ∧ a.heap.Holds b.policy b.mem ∧ (∀ c, Private b.sp c → ¬ Covered a.heap c) ∧ a.sp = b.sp

def SimSt (x : St In2p Heap) (y : St In2 DataMem) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rcx = y.rcx ∧ x.mem.Holds y.input.policy y.mem ∧ ∀ b, ¬ x.input.heap.Owned b → y.mem.get? b = y.input.mem.get? b

def SimOut (x : In2p) (y : In2) (r : UInt64 × Heap) (r' : UInt64 × DataMem) : Prop := r.1 = r'.1 ∧ r.2.Holds x.policy r'.2 ∧ ∀ b, ¬ x.heap.Owned b → r'.2.get? b = y.mem.get? b

def SimArr (self : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (s : Nat) (t : Nat) (a : In2p) : Prop := (Lift.Pilot.MapSpec.C s t) ∧ a.rdi.toBitVec = self ∧ a.rsi.toNat = s ∧ a.rdx.toNat = t ∧ a.heap = objsP self dp mp dropped dest pos s t ++ frame ∧ ∃ m, a.heap.Holds a.policy m

def l3 (self : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (s : Nat) (t : Nat) (pol : CpuPolicy) := show Model Unit _ from
  { rep policy _ s' := policy = pol ∧ Heap.Holds policy (objsP self dp mp dropped dest pos s t ++ frame) s'.data.dmem ∧ (Lift.Pilot.MapSpec.C s t) ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderMapPC s' ∧ s'.data.regs.rdi.toBitVec = self ∧ s'.data.regs.rsi.toNat = s ∧ s'.data.regs.rdx.toNat = t ∧ (∀ b, Private s'.data.regs.rsp.toBitVec b → ¬ Covered (objsP self dp mp dropped dest pos s t ++ frame) b)
    returns _ y := Lift.Pilot.MapSpec.run dropped dest pos s t = some y
    post _ y s' t' := SysV.Exit s' t' ∧ Lift.Trusted.Encode.encode y.1 = [⟨.W16, t'.data.regs.rax.toBitVec.setWidth 16⟩] ∧ Lift.Shuffler.Internal.MapStatement.post dropped dest pos s t mp pol ⟨.W16, t'.data.regs.rax.toBitVec.setWidth 16⟩ t'.data.dmem ∧ ∀ b, ¬ (objsP self dp mp dropped dest pos s t ++ frame).Owned b → t'.data.dmem.get? b = s'.data.dmem.get? b }


    {b : BitVec 64} {w : Width} {v : w.type}
    (hb : W.addr.toNat ≤ b.toNat ∧ b.toNat < W.addr.toNat + W.size) :
    F.map (Obj.set b w v) = F := by
  refine (List.map_congr_left ?_).trans (List.map_id F)
  intro p hp
  have hcross := (List.pairwise_append.mp hh.apart).2.2 W hW p hp (Or.inl hw)
  exact Obj.set_eq_self_of_not_covers (hh.noWrap p (List.mem_append_right _ hp))
    (not_covers_of_apart hcross hb)

/-! ### The invariant of the callee's blocks -/

def FrameInv (self dp mp : BitVec 64) (frame : Heap) (dropped : Vector (BitVec 8) 1024)
    (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (s t : Nat)
    (a : skel_call.In2p) : Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x = skel_call.initP a
  | .o14, x => x.input = a ∧ x.mem = objsP self dp mp dropped dest pos s t ++ frame
  | .o25, x => x.input = a ∧ x.mem = objsP self dp mp dropped dest pos s t ++ frame ∧
      x.rcx = UInt64.ofBitVec mp
  | .o36, x => x.input = a ∧ x.mem = objsP self dp mp dropped dest pos s t ++ frame ∧
      x.rcx = UInt64.ofBitVec mp
  | .LBB25_4, x => ∃ k, x.mem = k ++ frame

def FrameOut (frame : Heap) (r : UInt64 × Heap) : Prop := ∃ k, r.2 = k ++ frame

theorem step_entry {x : St skel_call.In2p Heap}
    {n : Lift.Sem.Next Lbl (St skel_call.In2p Heap) (UInt64 × Heap) Empty Empty.elim Empty.elim}
    (h : skel_call.blocksP.step .entry x = .ok n) :
    ∃ x' : St skel_call.In2p Heap,
      (n = .goto .o14 x' ∨ n = .goto .LBB25_4 x') ∧ x'.input = x.input ∧ x'.mem = x.mem := by
  simp only [skel_call.blocksP] at h
  split at h
  · rename_i v hv
    split at h
    · rename_i v1 hv1
      split at h
      · rename_i hc
        exact ⟨{ x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := UInt64.ofBitVec v }, .inl (by simpa using h.symm), rfl, rfl⟩
      · rename_i hc
        exact ⟨{ x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := UInt64.ofBitVec v }, .inr (by simpa using h.symm), rfl, rfl⟩
    · cases h
    · cases h
  · cases h
  · cases h

theorem step_o14 {x : St skel_call.In2p Heap}
    {n : Lift.Sem.Next Lbl (St skel_call.In2p Heap) (UInt64 × Heap) Empty Empty.elim Empty.elim}
    (h : skel_call.blocksP.step .o14 x = .ok n) :
    ∃ v v1 : BitVec 64, x.mem.load (x.input.rdi.toBitVec + 48) .W64 = .ok v ∧
      x.mem.load (v + x.input.rsi.toBitVec * 8) .W64 = .ok v1 ∧
      (n = .goto .o25 { x with rcx := UInt64.ofBitVec v } ∨
       n = .goto .LBB25_4 { x with rcx := UInt64.ofBitVec v }) := by
  simp only [skel_call.blocksP] at h
  split at h
  · rename_i v hv
    split at h
    · rename_i v1 hv1
      split at h
      · rename_i hc
        exact ⟨v, v1, hv, hv1, .inl (by simpa using h.symm)⟩
      · rename_i hc
        exact ⟨v, v1, hv, hv1, .inr (by simpa using h.symm)⟩
    · cases h
    · cases h
  · cases h
  · cases h

theorem step_o25 {x : St skel_call.In2p Heap}
    {n : Lift.Sem.Next Lbl (St skel_call.In2p Heap) (UInt64 × Heap) Empty Empty.elim Empty.elim}
    (h : skel_call.blocksP.step .o25 x = .ok n) :
    n = .goto .o36 x ∨ n = .goto .LBB25_4 x := by
  simp only [skel_call.blocksP] at h
  split at h
  · split at h
    · rename_i hc
      exact .inl (by simpa using h.symm)
    · rename_i hc
      exact .inr (by simpa using h.symm)
  · cases h
  · cases h

theorem step_o36 {x : St skel_call.In2p Heap}
    {n : Lift.Sem.Next Lbl (St skel_call.In2p Heap) (UInt64 × Heap) Empty Empty.elim Empty.elim}
    (h : skel_call.blocksP.step .o36 x = .ok n) :
    ∃ h1 h2 : Heap,
      x.mem.store (x.rcx.toBitVec + x.input.rsi.toBitVec * 8) .W64 x.input.rdx.toBitVec = .ok h1 ∧
      h1.store (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64 x.input.rsi.toBitVec =
        .ok h2 ∧
      n = .goto .LBB25_4 { x with rax := 0, mem := h2 } := by
  simp only [skel_call.blocksP] at h
  split at h
  · rename_i h1 hst1
    split at h
    · rename_i h2 hst2
      exact ⟨h1, h2, hst1, hst2, by simpa using h.symm⟩
    · cases h
    · cases h
  · cases h
  · cases h

theorem step_LBB25_4 {x : St skel_call.In2p Heap}
    {n : Lift.Sem.Next Lbl (St skel_call.In2p Heap) (UInt64 × Heap) Empty Empty.elim Empty.elim}
    (h : skel_call.blocksP.step .LBB25_4 x = .ok n) : n = .ret (x.rax, x.mem) := by
  simp only [skel_call.blocksP] at h
  simpa using h.symm
theorem call_frame : ∀ (self : BitVec 64) (dp : BitVec 64) (mp : BitVec 64) (frame : Heap) (dropped : Vector (BitVec 8) 1024) (dest : Vector (BitVec 64) 1024) (pos : Vector (BitVec 64) 1024) (s : Nat) (t : Nat) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre self dp mp frame dropped dest pos s t a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro self dp mp frame dropped dest pos s t a q hpre hret m hm
  obtain ⟨hC, hrdi₀, hrsi₀, hrdx₀, hheap, m₀, hh₀⟩ := hpre
  obtain ⟨hs1024, ht1024⟩ := hC
  have hrdi : a.rdi.toBitVec = self := hrdi₀
  have hrsi : a.rsi.toNat = s := hrsi₀
  have hrdx : a.rdx.toNat = t := hrdx₀
  have hHolds : (objsP self dp mp dropped dest pos s t ++ frame).Holds a.policy m₀ := by
    rw [← hheap]; exact hh₀
  have hno1 : mp.toNat + 8192 ≤ 2 ^ 64 := by
    have h := hHolds.noWrap (toObj (Lift.Shuffler.Internal.MapStatement.destArr dest mp))
      (List.mem_append_left _ (objsP_destArr_mem self dp mp dropped dest pos s t))
    rw [show (toObj (Lift.Shuffler.Internal.MapStatement.destArr dest mp)).addr = mp from rfl,
      size_toObj_destArr] at h
    exact h
  have hno2 : (mp + BitVec.ofNat 64 8192).toNat + 8192 ≤ 2 ^ 64 := by
    have h := hHolds.noWrap (toObj (Lift.Shuffler.Internal.MapStatement.posArr pos mp))
      (List.mem_append_left _ (objsP_posArr_mem self dp mp dropped dest pos s t))
    rw [show (toObj (Lift.Shuffler.Internal.MapStatement.posArr pos mp)).addr =
      mp + BitVec.ofNat 64 8192 from rfl, size_toObj_posArr] at h
    exact h
  have hQ : FrameOut frame q := by
    refine Lift.Sem.CallArm.Blocks.Returns.inv (b := skel_call.blocksP) (callee := noCall)
      (FrameInv self dp mp frame dropped dest pos s t a) (FrameOut frame) ?_ hret ?_
    · intro l x n hI hs
      cases l with
      | entry =>
        simp only [FrameInv] at hI
        subst hI
        obtain ⟨x', hcase, hin, hmem⟩ := step_entry hs
        rcases hcase with hcase | hcase
        · rw [hcase]
          simp only [Lift.Sem.CallArm.Next.Inv, FrameInv]
          have h1 : x'.input = a := by simpa [skel_call.initP] using hin
          have h2 : x'.mem = objsP self dp mp dropped dest pos s t ++ frame := by
            rw [hmem]
            simpa [skel_call.initP, callInput] using hheap
          exact ⟨h1, h2⟩
        · rw [hcase]
          simp only [Lift.Sem.CallArm.Next.Inv, FrameInv]
          have h2 : x'.mem = objsP self dp mp dropped dest pos s t ++ frame := by
            rw [hmem]
            simpa [skel_call.initP, callInput] using hheap
          exact ⟨objsP self dp mp dropped dest pos s t, h2⟩
      | o14 =>
        simp only [FrameInv] at hI
        obtain ⟨hinput, hmem⟩ := hI
        obtain ⟨v, v1, hload, hload2, hcase⟩ := step_o14 hs
        have hv : v = mp := by
          have h1 := hload
          rw [hinput] at h1
          rw [show a.rdi.toBitVec = self from hrdi] at h1
          rw [hmem, objsP_load_mappingField self dp mp dropped dest pos s t frame hHolds] at h1
          simpa using h1.symm
        rcases hcase with hcase | hcase
        · rw [hcase]
          simp only [Lift.Sem.CallArm.Next.Inv, FrameInv]
          refine ⟨hinput, hmem, ?_⟩
          rw [hv]
        · rw [hcase]
          simp only [Lift.Sem.CallArm.Next.Inv, FrameInv]
          exact ⟨objsP self dp mp dropped dest pos s t, hmem⟩
      | o25 =>
        simp only [FrameInv] at hI
        obtain ⟨hinput, hmem, hrcx⟩ := hI
        rcases step_o25 hs with hcase | hcase
        · rw [hcase]
          simp only [Lift.Sem.CallArm.Next.Inv, FrameInv]
          exact ⟨hinput, hmem, hrcx⟩
        · rw [hcase]
          simp only [Lift.Sem.CallArm.Next.Inv, FrameInv]
          exact ⟨objsP self dp mp dropped dest pos s t, hmem⟩
      | o36 =>
        simp only [FrameInv] at hI
        obtain ⟨hinput, hmem, hrcx⟩ := hI
        obtain ⟨h1, h2, hst1, hst2, hcase⟩ := step_o36 hs
        rw [hcase]
        simp only [Lift.Sem.CallArm.Next.Inv, FrameInv]
        have hst1' : h1 = x.mem.map
            (Obj.set (x.rcx.toBitVec + x.input.rsi.toBitVec * 8) .W64 x.input.rdx.toBitVec) :=
          (Heap.store_eq_ok_iff.mp hst1).2
        have hst2' : h2 = h1.map
            (Obj.set (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64
              x.input.rsi.toBitVec) :=
          (Heap.store_eq_ok_iff.mp hst2).2
        have hrcx' : x.rcx.toBitVec = mp := by rw [hrcx]
        have hrsi' : x.input.rsi.toBitVec.toNat = s := by
          rw [hinput, UInt64.toNat_toBitVec]; exact hrsi
        have hrdx' : x.input.rdx.toBitVec.toNat = t := by
          rw [hinput, UInt64.toNat_toBitVec]; exact hrdx
        have hb1 : mp.toNat ≤ (x.rcx.toBitVec + x.input.rsi.toBitVec * 8).toNat ∧
            (x.rcx.toBitVec + x.input.rsi.toBitVec * 8).toNat < mp.toNat + 8192 := by
          bv_omega
        have hb2 : (mp + BitVec.ofNat 64 8192).toNat ≤
              (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192).toNat ∧
            (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192).toNat <
              (mp + BitVec.ofNat 64 8192).toNat + 8192 := by
          bv_omega
        have hb1' : (toObj (Lift.Shuffler.Internal.MapStatement.destArr dest mp)).addr.toNat ≤
              (x.rcx.toBitVec + x.input.rsi.toBitVec * 8).toNat ∧
            (x.rcx.toBitVec + x.input.rsi.toBitVec * 8).toNat <
              (toObj (Lift.Shuffler.Internal.MapStatement.destArr dest mp)).addr.toNat +
                (toObj (Lift.Shuffler.Internal.MapStatement.destArr dest mp)).size := by
          rw [show (toObj (Lift.Shuffler.Internal.MapStatement.destArr dest mp)).addr = mp from rfl,
            size_toObj_destArr]
          exact hb1
        have hb2' : (toObj (Lift.Shuffler.Internal.MapStatement.posArr pos mp)).addr.toNat ≤
              (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192).toNat ∧
            (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192).toNat <
              (toObj (Lift.Shuffler.Internal.MapStatement.posArr pos mp)).addr.toNat +
                (toObj (Lift.Shuffler.Internal.MapStatement.posArr pos mp)).size := by
          rw [show (toObj (Lift.Shuffler.Internal.MapStatement.posArr pos mp)).addr =
            mp + BitVec.ofNat 64 8192 from rfl, size_toObj_posArr]
          exact hb2
        have hfix1 : frame.map (Obj.set (x.rcx.toBitVec + x.input.rsi.toBitVec * 8) .W64
            x.input.rdx.toBitVec) = frame :=
          frame_map_set hHolds (objsP_destArr_mem self dp mp dropped dest pos s t) rfl hb1'
        have hfix2 : frame.map (Obj.set (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64
            x.input.rsi.toBitVec) = frame :=
          frame_map_set hHolds (objsP_posArr_mem self dp mp dropped dest pos s t) rfl hb2'
        have hset1 : h1 = (objsP self dp mp dropped dest pos s t).map
            (Obj.set (x.rcx.toBitVec + x.input.rsi.toBitVec * 8) .W64 x.input.rdx.toBitVec) ++
            frame := by
          rw [hst1', hmem, List.map_append, hfix1]
        have hset2 : h2 = ((objsP self dp mp dropped dest pos s t).map
            (Obj.set (x.rcx.toBitVec + x.input.rsi.toBitVec * 8) .W64 x.input.rdx.toBitVec)).map
            (Obj.set (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64
              x.input.rsi.toBitVec) ++ frame := by
          rw [hst2', hset1, List.map_append, hfix2]
        exact ⟨_, hset2⟩
      | LBB25_4 =>
        simp only [FrameInv] at hI
        rw [step_LBB25_4 hs]
        simp only [Lift.Sem.CallArm.Next.Inv]
        exact hI
    · simp only [FrameInv]
  obtain ⟨k, hk⟩ := hQ
  rw [hk] at hm
  exact hm.sublist (List.sublist_append_right k frame)
end call_frame.skel_proof
theorem call_frame : call_frame.skel_statement := @call_frame.skel_proof.call_frame
def call_shape.skel_statement : Prop := ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2
namespace call_shape.skel_proof
skel_proof_aliases call_shape.skel_proof excluding [skel_call.summary_shape, call_shape]
namespace skel_call

theorem summary_shape : ∀ a r, l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2 := by
  intro a r h
  refine Lift.Sem.CallArm.Blocks.Returns.inv (fun _ x => Lift.Sem.CallArm.Shape a.heap x.mem) (fun r => Lift.Sem.CallArm.Shape a.heap r.2) ?_ h (Lift.Sem.CallArm.Shape.refl _)
  rintro l x n hsh hstep
  cases l with
  | entry =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i v hl0
      split at hstep
      · rename_i v1 hl1
        simp only [Res.ok.injEq] at hstep
        subst hstep
        split <;> exact hsh
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o14 =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i v hl0
      split at hstep
      · rename_i v1 hl1
        simp only [Res.ok.injEq] at hstep
        subst hstep
        split <;> exact hsh
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | o25 =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i v hl0
      simp only [Res.ok.injEq] at hstep
      subst hstep
      split <;> exact hsh
    · cases hstep
    · cases hstep
  | o36 =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i h hst0
      split at hstep
      · rename_i h1 hst1
        simp only [Res.ok.injEq] at hstep
        subst hstep
        exact (Lift.Sem.CallArm.Shape.store (Lift.Sem.CallArm.Shape.store hsh hst0) hst1)
      · cases hstep
      · cases hstep
    · cases hstep
    · cases hstep
  | LBB25_4 =>
    simp only [blocksP, Res.ok.injEq] at hstep
    subst hstep
    exact hsh

end skel_call
theorem call_shape : ∀ a r, skel_call.l2p.returns a r → Lift.Sem.CallArm.Shape a.heap r.2 := by exact skel_call.summary_shape
end call_shape.skel_proof
theorem call_shape : call_shape.skel_statement := @call_shape.skel_proof.call_shape
theorem call_summary : callSummary := by
  intro self dp mp frame dropped dest pos s t a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 self dp mp frame dropped dest pos s t () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨⟨r, hrel, hmap⟩, call_shape a q hq, call_frame self dp mp frame dropped dest pos s t a q hs hq⟩⟩
end skel_semantic
end Skel.Gen.Level3.Shuffler.mappingBuilderMap

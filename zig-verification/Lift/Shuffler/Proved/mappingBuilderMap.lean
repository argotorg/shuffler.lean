theorem load_dest (self dp mp : BitVec 64) (dropped : Vector (BitVec 8) 1024)
    (dest pos : Vector (BitVec 64) 1024) (s t : Nat) (frame : Heap) (m : DataMem) (pol : CpuPolicy)
    (hs : s < 1024)
    (hh : (objsP self dp mp dropped dest pos s t ++ frame).Holds pol m) :
    (objsP self dp mp dropped dest pos s t ++ frame).load (mp + BitVec.ofNat 64 s * 8) .W64

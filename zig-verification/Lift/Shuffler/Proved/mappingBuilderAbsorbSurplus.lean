def callInput (a : skel_call.In2p) : In2p := { policy := a.policy, heap := a.heap, rax := a.rax, rbx := a.rbx, rdi := a.rdi, rbp := a.rbp, r12 := a.r12, r13 := a.r13, r14 := a.r14, r15 := a.r15, sp := a.sp }

def callState (x : St In2p Heap) (z : St skel_call.In2p Heap) : Prop := x.input = callInput z.input ∧ x.rax = z.rax ∧ x.rbx = z.rbx ∧ x.rcx = z.rcx ∧ x.rdx = z.rdx ∧ x.rsi = z.rsi ∧ x.rdi = z.rdi ∧ x.rbp = z.rbp ∧ x.r8 = z.r8 ∧ x.r9 = z.r9 ∧ x.r10 = z.r10 ∧ x.r12 = z.r12 ∧ x.r13 = z.r13 ∧ x.r14 = z.r14 ∧ x.r15 = z.r15 ∧ x.mem = z.mem ∧ True

def callPre (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : skel_call.In2p) : Prop := SimArr frame b M (callInput a)

def callPost (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.run b M)) (q : (UInt64 × Heap)) : Prop := (∃ (r : (UInt64 × Heap)), (Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.result b M y) y) = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ (callInput a).heap = objsP b M ++ frame ∧ ∀ m, r.2.Holds (callInput a).policy m → Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.post b M Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf (callInput a).policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) ∧ r = q) ∧ Lift.Sem.CallArm.ShapeB a.heap q.2 ∧ (∀ m, q.2.Holds a.policy m → frame.Holds a.policy m)

abbrev callSummary : Prop := ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : skel_call.In2p) (y : (fun {R : Type} (_ : Option R) => R) (Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.run b M)), callPre frame b M a → Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.run b M = some y → ∃ q, skel_call.l2p.returns a q ∧ callPost frame b M a y q

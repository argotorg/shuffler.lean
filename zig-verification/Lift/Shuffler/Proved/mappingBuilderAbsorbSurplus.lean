        let s2 : St In2p Heap := { s with rax := 24576, r14 := s.r14 + 1, rbp := s.rbp - 1 }
        have hstep5 : blocksP.step .LBB23_5 { s with rax := 24576 } = .ok (.goto .LBB23_1 s2) := by

/-- The entry region. -/
theorem region_entry (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (y : FlatShuffler.Flat.ExecutionOutcome FlatShuffler.Flat.Status FlatShuffler.Flat.Mapping)
    (a : In2p) (hs : SimArr frame b M a) (hy : y = FlatShuffler.Flat.absorbSurplus b M)
    (s : St In2p Heap) (h : inv b M frame y a .entry s) :
    ∃ e, (blocksP.cut regionHeads).Returns callee (.block .entry) s e ∧
      Lift.Sem.CutExit.Progress (inv b M frame y a) (rank b) (out b frame y) .entry s e := by
  obtain ⟨hC, hrdi, hheap, hm⟩ := hs
  obtain rfl : s = initP a := h
  obtain ⟨m, hm⟩ := hm
  have hh : (heapOf b M frame).Holds a.policy m := (objsP_append b M frame) ▸ (hheap ▸ hm)
  have hload : (initP a).mem.loadB ((initP a).rdi.toBitVec + 24) .W64 = .ok b.targetSize := by
    have hmem : (initP a).mem = heapOf b M frame := by
      simp only [initP]
      exact hheap.trans (objsP_append b M frame)
    rw [hmem]
    rw [show (initP a).rdi.toBitVec + 24 = 24 from by simp only [initP, hrdi]; rfl]
    exact heapOf_loadB_24 b M frame a.policy m hh
  let s1 : St In2p Heap := { initP a with rbx := (initP a).rdi, rbp := 0, r12 := 4294967296, r13 := UInt64.ofBitVec 18446744073709551615, r14 := 0, r15 := UInt64.ofBitVec b.targetSize }
  refine ⟨.next .LBB23_1 s1, ?_, ?_, ?_, rfl⟩
  · have h1 : (blocksP.cut regionHeads).step (.block .entry) (initP a) = .ok (.goto (.stop .LBB23_1) s1) := by
      simp only [Blocks.cut, blocksP, hload, regionHeads, s1, ↓reduceIte]
    have h2 : (blocksP.cut regionHeads).step (.stop .LBB23_1) s1 = .ok (.ret (.next .LBB23_1 s1)) := rfl
    exact Blocks.Returns.goto h1 (Blocks.Returns.ret h2)
  · refine ⟨rfl, ?_, rfl, rfl, rfl, ?_, ?_, ?_⟩
    · show a.rdi = 0
      exact UInt64.toBitVec_inj.mp hrdi
    · rfl
    · show (0 : Nat) ≤ b.targetSize.toNat
      omega
    · refine ⟨M, ?_, ?_, ⟨m, hh⟩⟩
      · exact hheap.trans (objsP_append b M frame)
      · show FlatShuffler.Flat.absorbFrom b M 0 = y
        rw [show FlatShuffler.Flat.absorbFrom b M 0 = FlatShuffler.Flat.absorbSurplus b M from rfl]
        exact hy.symm
  · have hss : 0 < b.sourceSize.toNat + 3 := by omega
    show (b.targetSize.toNat - s1.r14.toNat) * (b.sourceSize.toNat + 3) + (b.sourceSize.toNat + 2) <
      (b.targetSize.toNat + 1) * (b.sourceSize.toNat + 3) + (b.sourceSize.toNat + 2)
    have hz : s1.r14.toNat = 0 := rfl
    rw [hz, Nat.sub_zero]
    exact Nat.add_lt_add_right
      (Nat.mul_lt_mul_of_pos_right (by omega : b.targetSize.toNat < b.targetSize.toNat + 1) hss) _

/-- The abstract loop at or past the target size. -/
theorem absorbFrom_ge (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j : FlatShuffler.Word) (h : ¬ j < b.targetSize) :
    FlatShuffler.Flat.absorbFrom b M j = (FlatShuffler.Flat.ExecutionControl.done, M) := by
  rw [FlatShuffler.Flat.absorbFrom.eq_def, dif_neg h]

/-- The `NONE` word is the all-ones word. -/
theorem ofBitVec_none (v : BitVec 64) :
    (UInt64.ofBitVec v = 18446744073709551615) ↔ v = FlatShuffler.Flat.NONE := by
  constructor
  · intro h
    have := congrArg UInt64.toBitVec h
    simpa [FlatShuffler.Flat.NONE] using this
  · intro h
    rw [h]
    rfl

/-- The zero-extended byte is zero exactly at a zero byte. -/
theorem ofBitVec_zeroExtend_zero (d : BitVec 8) :
    (UInt64.ofBitVec (BitVec.zeroExtend 64 d) = 0) ↔ d = 0 := by
  constructor
  · intro h
    have hz : BitVec.zeroExtend 64 d = 0 := by
      have := congrArg UInt64.toBitVec h
      simpa using this
    have h2 : (BitVec.zeroExtend 64 d).toNat = d.toNat := by
      rw [BitVec.zeroExtend]
      exact BitVec.toNat_setWidth_of_le (by omega)
    have hd : d.toNat = 0 := by rw [← h2, hz]; rfl
    exact BitVec.eq_of_toNat_eq (by rw [hd]; rfl)
  · intro h
    rw [h]
    decide

/-- The load of the `kind` byte of a target slot of the heap.

Proof plan (the only remaining memory-level lemma):
1. `readRam` of the target cell (`Holds.read` at the `W64` cell `(0, ⟨.W64, slotWord s 0⟩)` of the
   object at `12288`) gives `Mem.loadInt m (12288 + 8j) 8 = some (slotWord s 0).toInt`.
2. `loadB` gives `readRam policy m (12288 + 8j + 4) .W8 = .ok v` in either branch
   (`Heap.load_sound` when some object has a `W8` cell there — only a read-only object of `frame`
   can, and then step 1 + `Holds.read` for that object make its byte the same one — and
   `Obj.loadBytes` otherwise).
3. `Mem.loadInt` of 8 bytes at `a` and of 1 byte at `a + 4` are the 5th byte of the same bytes, and
   `(Int.toBytes 8 (slotWord s 0).toInt)[4] = s.kind` because
   `slotWord s pad = pad ++ valueOpcode ++ kind ++ payload` (`Pilot.Slot.word`).
-/
theorem ofInt_nat8 (x : BitVec 8) : BitVec.ofInt 8 (↑x.toNat : Int) = x := by
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_ofInt]
  have h : (↑x.toNat % (2 ^ 8 : Int)).toNat = x.toNat := by
    rw [Int.emod_eq_of_lt (Int.natCast_nonneg _) (by norm_cast; exact x.isLt)]
    rfl
  rw [show ((2 ^ 8 : Nat) : Int) = (2 ^ 8 : Int) from rfl, h]

theorem toBytes_get4 (v : BitVec 64) : (Int.toBytes 8 v.toInt)[4]! = v.extractLsb' 32 8 := by
  have h := Lift.Sem.ByteLemmas.ofInt_slice_toBytes 8 v 4 1 (by decide)
  have hlen : (Int.toBytes 8 v.toInt).length = 8 := Int.toBytes_length _ _
  have htk : ((Int.toBytes 8 v.toInt).drop 4).take 1 = [(Int.toBytes 8 v.toInt)[4]!] := by
    rw [List.drop_eq_getElem_cons (by omega)]
    rfl
  rw [htk] at h
  simp only [Int.ofBytes, List.foldr_cons, List.foldr_nil] at h
  have h2 : BitVec.ofInt 8 (↑((Int.toBytes 8 v.toInt)[4]!).toNat : Int) = (Int.toBytes 8 v.toInt)[4]! :=
    ofInt_nat8 _
  rw [show (0 : Int) * 256 + ↑((Int.toBytes 8 v.toInt)[4]!).toNat
        = ↑((Int.toBytes 8 v.toInt)[4]!).toNat from by simp] at h
  rw [show (8 * 1 : Nat) = 8 from rfl, h2] at h
  simpa using h

/-- The slot word with zero padding. -/
abbrev slotW (s : FlatShuffler.StackSlot) : BitVec 64 :=
  Lift.Shuffler.Internal.Proposed.Layout.slotWord s 0

theorem toBytes_slotW_4 (s : FlatShuffler.StackSlot) :
    (Int.toBytes 8 (slotW s).toInt)[4]! = s.kind := by
  rw [slotW, toBytes_get4]
  show (Lift.Shuffler.Zig.Slot.join (s, 0)).word.extractLsb' 32 8 = s.kind
  exact Lift.Pilot.kind_byte _

/-- A byte of a block of bytes is the value of the memory at that byte. -/
theorem contains_byte {m : DataMem} {policy : CpuPolicy} {a0 : BitVec 64} {bs : List UInt8}
    (hc : m.Contains a0 bs) (hlen : bs.length ≤ 2 ^ 64)
    {k : Nat} (hk : k < bs.length) {v : BitVec 8}
    (hr : readRam policy m (a0 + BitVec.ofNat 64 k) .W8 = .ok v) : v = bs[k]! := by
  have hk64 : k < 2 ^ 64 := by omega
  have hd : (a0 + BitVec.ofNat 64 k - a0).toNat = k := by
    rw [BitVec.add_comm a0, BitVec.add_sub_cancel]
    simp [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hk64]
  have hl := Mem.Contains.loadInt hc (by rw [hd]; exact hk)
  rw [hd] at hl
  unfold readRam at hr
  split at hr
  · split at hr
    · rename_i x hx
      simp only [Except.ok.injEq] at hr
      have hx' : x = ↑bs[k]!.toNat := (Option.some.inj (hl.symm.trans hx)).symm
      subst hx'
      rw [← hr]
      exact ofInt_nat8 _
    · cases hr
  · cases hr

theorem flatMap_chunk {α : Type} [Inhabited α] {g : α → List UInt8} {n : Nat} :
    ∀ (xs : List α), (∀ a ∈ xs, (g a).length = n) → ∀ (k : Nat), k < xs.length →
      ((xs.flatMap g).drop (n * k)).take n = g (xs[k]!)
  | [], _, k, hk => by simp at hk
  | a :: xs, hg, 0, _ => by
    rw [Nat.mul_zero, List.drop_zero, List.flatMap_cons, List.getElem!_cons_zero]
    rw [← hg a (List.mem_cons_self ..), List.take_left]
  | a :: xs, hg, k + 1, hk => by
    have ha : (g a).length = n := hg a (List.mem_cons_self ..)
    have hxs : ∀ b ∈ xs, (g b).length = n := fun b hb => hg b (List.mem_cons_of_mem _ hb)
    rw [Nat.mul_succ, List.flatMap_cons, List.drop_append,
      List.drop_eq_nil_of_le (by omega), List.nil_append, ha, Nat.add_sub_cancel,
      List.getElem!_cons_succ]
    exact flatMap_chunk xs hxs k (by simpa using hk)

theorem words_bytes_eq (w : Width) (addr : BitVec 64) (wr : Bool) :
    ∀ (xs : List w.type), (Obj.words addr wr w xs).bytes
      = xs.flatMap (fun v => Int.toBytes w.bytes v.toInt)
  | [] => rfl
  | x :: xs => by
    show Int.toBytes w.bytes x.toInt ++ (Obj.words addr wr w xs).bytes
      = Int.toBytes w.bytes x.toInt ++ xs.flatMap (fun v => Int.toBytes w.bytes v.toInt)
    rw [words_bytes_eq w addr wr xs]

/-- The object of the target slots at `12288`. -/
abbrev targetObj (b : FlatShuffler.Flat.Builder) : Obj :=
  Obj.words 12288 false .W64 (b.target.toList.map fun s => slotW s)

theorem targetObj_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap) :
    targetObj b ∈ heapOf b M frame := by
  have hmem : (⟨12288, b.target.toList.map (fun s => (⟨.W64, slotW s⟩ : Lift.Trusted.Field)), false⟩ : Lift.Trusted.Object)
      ∈ List.take 10 (objects b M envOf) := by
    simp [objects, slotW]
  refine List.mem_append.mpr (Or.inl (List.mem_append.mpr (Or.inl ?_)))
  refine List.mem_map.mpr ⟨_, hmem, ?_⟩
  rw [show b.target.toList.map (fun s => (⟨.W64, slotW s⟩ : Lift.Trusted.Field))
      = (b.target.toList.map fun s => slotW s).map (fun v => (⟨.W64, v⟩ : Lift.Trusted.Field))
      from (List.map_map).symm]
  exact toObj_words_w .W64 12288 _ false

theorem target_bytes_chunk (b : FlatShuffler.Flat.Builder) (k : Nat) (hk : k < b.target.toList.length) :
    (((targetObj b).bytes).drop (8 * k)).take 8
      = Int.toBytes 8 (slotW (b.target.toList[k]!)).toInt := by
  have h := flatMap_chunk (α := BitVec 64) (g := fun v => Int.toBytes 8 v.toInt) (n := 8)
    (b.target.toList.map fun s => slotW s) (fun s _ => Int.toBytes_length _ _) k (by simpa using hk)
  have hmap : (b.target.toList.map fun s => slotW s)[k]! = slotW (b.target.toList[k]!) := by
    rw [List.getElem!_of_getElem? (List.getElem?_eq_getElem (by simpa using hk)),
        List.getElem!_of_getElem? (List.getElem?_eq_getElem hk), List.getElem_map]
  rw [hmap] at h
  rw [show (targetObj b).bytes
      = (b.target.toList.map fun s => slotW s).flatMap (fun v => Int.toBytes 8 v.toInt) from
    words_bytes_eq .W64 12288 false _]
  exact h

/-- Two blocks of bytes of the same memory agree where they overlap. -/
theorem contains_byte_eq {m : DataMem} {a1 a2 : BitVec 64} {l1 l2 : List UInt8}
    (h1 : m.Contains a1 l1) (h2 : m.Contains a2 l2) {k : Nat}
    (ha : a2 = a1 + BitVec.ofNat 64 k) (hk64 : k < 2 ^ 64) (hk : k < l1.length)
    (h2pos : 0 < l2.length) : l2[0]! = l1[k]! := by
  have hd : (a1 + BitVec.ofNat 64 k - a1).toNat = k := by
    rw [BitVec.add_comm a1, BitVec.add_sub_cancel]
    simp [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hk64]
  have e1 := Mem.Contains.loadInt h1 (by rw [hd]; exact hk)
  rw [hd] at e1
  have e2 := Mem.Contains.loadInt h2 (by rw [BitVec.sub_self]; simpa using h2pos)
  rw [BitVec.sub_self, BitVec.toNat_zero] at e2
  rw [ha, e1] at e2
  have hnat : l2[0]!.toNat = l1[k]!.toNat := by
    have := Option.some.inj e2
    exact (Int.ofNat.inj this).symm
  exact UInt8.toBitVec_inj.mp (BitVec.eq_of_toNat_eq hnat)

theorem heapOf_loadB_kind (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (policy : CpuPolicy) (m : DataMem) (hh : (heapOf b M frame).Holds policy m)
    (j : BitVec 64) (hj : j.toNat < FlatShuffler.maxStackSize) :
    (heapOf b M frame).loadB (12288 + j * 8 + 4) .W8
      = .ok (FlatShuffler.Flat.get b.target j).kind := by
  have hmem := targetObj_mem b M frame
  have hc := Heap.Holds.contains hh hmem
  have hjk : j.toNat < b.target.toList.length := by simpa using hj
  have hchunk : ((targetObj b).bytes.drop (8 * j.toNat)).take 8
      = Int.toBytes 8 (slotW (b.target.toList[j.toNat]!)).toInt :=
    target_bytes_chunk b _ hjk
  have hc8 : m.Contains (12288 + BitVec.ofNat 64 (8 * j.toNat))
      (Int.toBytes 8 (slotW (b.target.toList[j.toNat]!)).toInt) := by
    have h := Lift.Sem.ByteLemmas.Contains.slice hc (8 * j.toNat) 8
    rw [hchunk] at h
    exact h
  have hkind : (Int.toBytes 8 (slotW (b.target.toList[j.toNat]!)).toInt)[4]!
      = (FlatShuffler.Flat.get b.target j).kind := by
    rw [toBytes_slotW_4, List.getElem!_of_getElem? (List.getElem?_eq_getElem hjk)]
    simp [FlatShuffler.Flat.get, hj, Vector.getElem_toList]
  have haddr : (12288 : BitVec 64) + j * 8 + 4
      = (12288 + BitVec.ofNat 64 (8 * j.toNat)) + BitVec.ofNat 64 4 := by
    bv_omega
  rw [haddr]
  unfold Heap.loadB
  split
  · rename_i v hl
    have hr := Heap.load_sound hh hl
    have hv : v = (Int.toBytes 8 (slotW (b.target.toList[j.toNat]!)).toInt)[4]! :=
      contains_byte hc8 (by rw [Int.toBytes_length]; decide)
        (by rw [Int.toBytes_length]; decide) hr
    rw [hv, hkind]
  · split
    · rename_i v' hf
      obtain ⟨o, ho, hlb⟩ := List.exists_of_findSome?_eq_some hf
      obtain ⟨k', ha, hk', rfl⟩ := Obj.loadBytes_spec hlb
      have hklen : k' < o.bytes.length := by
        rw [Obj.bytes_length]
        have := hk'
        simp [Width.bytes] at this
        omega
      have hdrop : ((o.bytes.drop k').take 1) = [o.bytes[k']!] := by
        rw [List.drop_eq_getElem_cons hklen, List.take_succ_cons, List.take_zero,
          List.getElem!_of_getElem? (List.getElem?_eq_getElem hklen)]
      have hco : m.Contains (o.addr + BitVec.ofNat 64 k') ((o.bytes.drop k').take 1) :=
        Lift.Sem.ByteLemmas.Contains.slice (Heap.Holds.contains hh ho) k' 1
      have hov : ((o.bytes.drop k').take 1)[0]!
          = (Int.toBytes 8 (slotW (b.target.toList[j.toNat]!)).toInt)[4]! :=
        contains_byte_eq hc8 hco (k := 4) (by rw [← ha]) (by decide)
          (by rw [Int.toBytes_length]; decide) (by rw [hdrop]; simp)
      have hofb : BitVec.ofInt 8 (Int.ofBytes ((o.bytes.drop k').take 1))
          = ((o.bytes.drop k').take 1)[0]! := by
        rw [hdrop]
        simp only [Int.ofBytes, List.foldr_cons, List.foldr_nil]
        rw [show (0 : Int) * 256 + ↑(o.bytes[k']!).toNat = ↑(o.bytes[k']!).toNat from by simp,
          List.getElem!_cons_zero]
        exact ofInt_nat8 _
      show Res.ok (BitVec.ofInt 8 (Int.ofBytes ((o.bytes.drop k').take 1)))
        = Res.ok (FlatShuffler.Flat.get b.target j).kind
      rw [hofb, hov, hkind]
    · rename_i heq
      have hj1024 : j.toNat < 1024 := hj
      have hlen1024 : b.target.toList.length = 1024 := by
        rw [Vector.length_toList]
        rfl
      have hsize : (targetObj b).size = 8 * b.target.toList.length := by
        show (((b.target.toList.map fun s => slotW s).map (Cell.mk .W64)).map (fun c => c.w.bytes)).sum
          = 8 * b.target.toList.length
        rw [Lift.Sem.words_bytes]
        simp [Width.bytes]
      have haddrT : (targetObj b).addr = 12288 := rfl
      have hspans : (targetObj b).Spans ((12288 + BitVec.ofNat 64 (8 * j.toNat)) + BitVec.ofNat 64 4) .W8 := by
        simp only [Obj.Spans, haddrT, hsize, hlen1024, Width.bytes]
        constructor <;> bv_omega
      have hsome : (targetObj b).loadBytes ((12288 + BitVec.ofNat 64 (8 * j.toNat)) + BitVec.ofNat 64 4) .W8 ≠ none := by
        unfold Obj.loadBytes
        rw [if_pos hspans]
        simp
      exfalso
      exact absurd (List.findSome?_eq_none_iff.mp heq _ hmem) hsome

/-- The load of the `dropped` byte of a source slot of the heap. -/
theorem heapOf_loadB_dropped (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (policy : CpuPolicy) (m : DataMem) (hh : (heapOf b M frame).Holds policy m)
    (i : BitVec 64) (hi : i.toNat < FlatShuffler.maxStackSize) :
    (heapOf b M frame).loadB (20480 + i) .W8 = .ok (FlatShuffler.Flat.get b.dropped i) := by
  have ho : Obj.words 20480 false .W8 b.dropped.toList ∈ heapOf b M frame := by
    refine List.mem_append.mpr (Or.inl (List.mem_append.mpr (Or.inl ?_)))
    refine List.mem_map.mpr ⟨_, ?_, toObj_words_w .W8 20480 b.dropped.toList false⟩
    simp [Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.objects,
      Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf]
  have h := Heap.load_words (w := .W8) hh ho (k := i.toNat) (by simpa using hi)
  rw [show (20480 : BitVec 64) + BitVec.ofNat 64 (Width.W8.bytes * i.toNat) = 20480 + i from by
        simp [Width.bytes, BitVec.ofNat_toNat]] at h
  rw [Heap.loadB_of_load h]
  simp only [FlatShuffler.Flat.get, dif_pos hi]
  congr 1

/-- The kind test of `.o46`: the byte is `1` exactly for a wildcard target. -/
theorem isWildcardTarget_eq (b : FlatShuffler.Flat.Builder) (t : FlatShuffler.Word) :
    (FlatShuffler.Flat.isWildcardTarget b t = true) ↔
      (FlatShuffler.Flat.get b.target t).kind = 1 := by
  simp [FlatShuffler.Flat.isWildcardTarget, FlatShuffler.isJunk, FlatShuffler.Junk]

/-- The shift test of `.o46`. -/
theorem kind_test (v : BitVec 8) :
    (UInt64.ofBitVec (BitVec.zeroExtend 64 v) <<< (32 : UInt64) = 4294967296) ↔ v = 1 := by
  constructor
  · intro h
    have h2 : (BitVec.zeroExtend 64 v) <<< (32 : BitVec 64) = 4294967296 := by
      have := congrArg UInt64.toBitVec h
      simpa using this
    have h3 : v = 1 := by
      revert h2
      bv_decide
    exact h3
  · rintro rfl
    decide

theorem uint64_add_zero (x : UInt64) : x + 0 = x := by
  apply UInt64.toBitVec_inj.mp
  rw [UInt64.toBitVec_add]
  simp

/-- The successor of a `UInt64`, as a natural number. -/
theorem toNat_add_one (x : UInt64) (h : x.toNat + 1 < 2 ^ 64) :
    (x + 1).toNat = x.toNat + 1 := by
  have hb1 : x.toNat = x.toBitVec.toNat := rfl
  have hb2 : (x + 1).toBitVec = x.toBitVec + (1 : BitVec 64) := by simp
  have h1 : (x + 1).toNat = (x.toBitVec + 1).toNat := by
    show (x + 1).toBitVec.toNat = (x.toBitVec + 1).toNat
    rw [hb2]
  rw [h1, BitVec.toNat_add]
  rw [show (1 : BitVec 64).toNat = 1 from rfl, Nat.mod_eq_of_lt (by simpa using h), hb1]

/-- The outer loop region. -/
theorem region_outer (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (y : FlatShuffler.Flat.ExecutionOutcome FlatShuffler.Flat.Status FlatShuffler.Flat.Mapping)
    (a : In2p) (hs : SimArr frame b M a) (hy : y = FlatShuffler.Flat.absorbSurplus b M)
    (s : St In2p Heap) (h : inv b M frame y a .LBB23_1 s) :
    ∃ e, (blocksP.cut regionHeads).Returns callee (.block .LBB23_1) s e ∧
      Lift.Sem.CutExit.Progress (inv b M frame y a) (rank b) (out b frame y) .LBB23_1 s e := by
  obtain ⟨hC, hrdi, hheap, hm0⟩ := hs
  obtain ⟨hin, hrbx, hr12, hr13, hr15, hrbp, hr14le, Mj, hmem, habs, m, hh⟩ := h
  by_cases hcase : s.r14 = s.r15
  · have hr14eq : s.r14.toBitVec = b.targetSize := by rw [hcase]; exact hr15
    have hge : ¬ (s.r14.toBitVec < b.targetSize) := by rw [hr14eq]; exact BitVec.lt_irrefl _
    have hyv : y = (FlatShuffler.Flat.ExecutionControl.done, Mj) := by
      rw [← habs]
      exact absorbFrom_ge b Mj s.r14.toBitVec hge
    have hy2 : y.2 = Mj := by rw [hyv]
    refine ⟨.ret (0, s.mem), ?_, ?_⟩
    · have hs1 : blocksP.step .LBB23_1 s = .ok (.goto .LBB23_2 s) := by
        simp only [blocksP]
        rw [if_pos hcase]
      have hs2 : blocksP.step .LBB23_2 s = .ok (.goto .LBB23_3 { s with rax := 0 }) := by
        simp only [blocksP]
      have hs3 : blocksP.step .LBB23_3 { s with rax := 0 } = .ok (.ret (0, s.mem)) := by
        simp only [blocksP]
      have h1 : (blocksP.cut regionHeads).step (.block .LBB23_1) s = .ok (.goto (.block .LBB23_2) s) := by
        simp only [Blocks.cut, hs1, regionHeads, Bool.false_eq_true, ↓reduceIte]
      have h2 : (blocksP.cut regionHeads).step (.block .LBB23_2) s = .ok (.goto (.block .LBB23_3) { s with rax := 0 }) := by
        simp only [Blocks.cut, hs2, regionHeads, Bool.false_eq_true, ↓reduceIte]
      have h3 : (blocksP.cut regionHeads).step (.block .LBB23_3) { s with rax := 0 } = .ok (.ret (.ret (0, s.mem))) := by
        simp only [Blocks.cut, hs3, regionHeads, Bool.false_eq_true, ↓reduceIte]
      exact Blocks.Returns.goto h1 (Blocks.Returns.goto h2 (Blocks.Returns.ret h3))
    · show (0, s.mem) = out b frame y .LBB23_1 s
      rw [hmem]
      simp only [out]
      rw [hy2]
  · -- `s.r14 ≠ s.r15`: the body of the outer loop
    have hr14lt : s.r14.toNat < b.targetSize.toNat := by
      rcases Nat.lt_or_ge s.r14.toNat b.targetSize.toNat with h | h
      · exact h
      · exfalso
        apply hcase
        have hr15n : s.r15.toNat = b.targetSize.toNat := by
          have := congrArg BitVec.toNat hr15
          simpa using this
        have h2 : s.r14.toNat = s.r15.toNat := by omega
        exact UInt64.toBitVec_inj.mp (BitVec.eq_of_toNat_eq (by simpa using h2))
    have hlt : s.r14.toBitVec < b.targetSize := by
      show s.r14.toBitVec.toNat < b.targetSize.toNat
      simpa using hr14lt
    have hr14max : s.r14.toNat < FlatShuffler.maxStackSize := by
      have h2 : b.targetSize.toNat ≤ FlatShuffler.maxStackSize := by
        have h3 := hC.2
        rw [BitVec.le_def] at h3
        simpa [FlatShuffler.maxStackSize] using h3
      omega
    have hload16 : (heapOf b Mj frame).loadB (s.rbx.toBitVec + 16) .W64 = .ok 12288 := by
      rw [show s.rbx.toBitVec + 16 = 16 from by rw [hrbx]; rfl]
      exact heapOf_loadB_16 b Mj frame a.policy m hh
    have hloadkind : (heapOf b Mj frame).loadB (12288 + s.r14.toBitVec * 8 + 4) .W8
        = .ok (FlatShuffler.Flat.get b.target s.r14.toBitVec).kind :=
      heapOf_loadB_kind b Mj frame a.policy m hh s.r14.toBitVec hr14max
    have hstep1 : blocksP.step .LBB23_1 s = .ok (.goto .o46 s) := by
      simp only [blocksP]
      rw [if_neg hcase]
    have hstep2 : blocksP.step .o46 s = .ok (if UInt64.ofBitVec (BitVec.zeroExtend 64 (FlatShuffler.Flat.get b.target s.r14.toBitVec).kind) <<< (32 : UInt64) = s.r12 then .goto .o69 { s with rax := UInt64.ofBitVec (BitVec.zeroExtend 64 (FlatShuffler.Flat.get b.target s.r14.toBitVec).kind) <<< (32 : UInt64) } else .goto .LBB23_5 { s with rax := UInt64.ofBitVec (BitVec.zeroExtend 64 (FlatShuffler.Flat.get b.target s.r14.toBitVec).kind) <<< (32 : UInt64) }) := by
      simp only [blocksP, hmem, hload16, hloadkind]
    by_cases hk : (FlatShuffler.Flat.get b.target s.r14.toBitVec).kind = 1
    · -- the target slot is a wildcard: `.o69`
      have hw : FlatShuffler.Flat.isWildcardTarget b s.r14.toBitVec = true :=
        (isWildcardTarget_eq b s.r14.toBitVec).mpr hk
      have hkindX : UInt64.ofBitVec (BitVec.zeroExtend 64 (FlatShuffler.Flat.get b.target s.r14.toBitVec).kind) <<< (32 : UInt64) = s.r12 := by
        rw [hr12, hk]
        decide
      let X : UInt64 := UInt64.ofBitVec (BitVec.zeroExtend 64 (FlatShuffler.Flat.get b.target s.r14.toBitVec).kind) <<< (32 : UInt64)
      have hstep3 : blocksP.step .o46 s = .ok (.goto .o69 { s with rax := X }) := by

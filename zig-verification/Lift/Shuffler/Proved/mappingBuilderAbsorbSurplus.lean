      have hkindne : UInt64.ofBitVec (BitVec.zeroExtend 64 (FlatShuffler.Flat.get b.target s.r14.toBitVec).kind) <<< (32 : UInt64) ≠ s.r12 := by
        rw [hr12]
        intro h

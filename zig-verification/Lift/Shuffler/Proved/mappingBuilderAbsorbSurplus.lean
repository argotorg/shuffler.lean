  post := postP


def objsP (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) : Heap := (Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.objects b M Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf).map toObj

def SimIn (a : In2p) (b : In2) : Prop := a.policy = b.policy ∧ a.rax = b.rax ∧ a.rbx = b.rbx ∧ a.rdi = b.rdi ∧ a.rbp = b.rbp ∧ a.r12 = b.r12 ∧ a.r13 = b.r13 ∧ a.r14 = b.r14 ∧ a.r15 = b.r15 ∧ a.heap.Holds b.policy b.mem ∧ Heap.Permits b.policy a.heap ∧ (∀ c, Private b.sp c → ¬ Covered a.heap c) ∧ (∀ c, SysV.Below b.sp 64 c → ¬ Covered a.heap c) ∧ SysV.RoomAt b.policy b.mem b.sp 64 ∧ a.sp = b.sp

def SimSt (x : St In2p Heap) (y : St In2 DataMem) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rbx = y.rbx ∧ x.rcx = y.rcx ∧ x.rdx = y.rdx ∧ x.rsi = y.rsi ∧ x.rdi = y.rdi ∧ x.rbp = y.rbp ∧ x.r8 = y.r8 ∧ x.r9 = y.r9 ∧ x.r10 = y.r10 ∧ x.r12 = y.r12 ∧ x.r13 = y.r13 ∧ x.r14 = y.r14 ∧ x.r15 = y.r15 ∧ x.mem.Holds y.input.policy y.mem ∧ (∀ b, ¬ x.input.heap.Owned b → ¬ SysV.Below y.input.sp 64 b → y.mem.get? b = y.input.mem.get? b) ∧ (∀ b, SysV.Below y.input.sp 64 b → ¬ Covered x.mem b) ∧ SysV.RoomAt y.input.policy y.mem y.input.sp 64

def SimOut (x : In2p) (y : In2) (r : UInt64 × Heap) (r' : UInt64 × DataMem) : Prop := r.1 = r'.1 ∧ r.2.Holds x.policy r'.2 ∧ ∀ b, ¬ x.heap.Owned b → ¬ SysV.Below y.sp 64 b → r'.2.get? b = y.mem.get? b

def SimArr (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : In2p) : Prop := (Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.C b M) ∧ a.rdi.toBitVec = 0 ∧ a.heap = objsP  b M ++ frame ∧ ∃ m, a.heap.Holds a.policy m

def l3 (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (pol : CpuPolicy) := show Model Unit _ from
  { rep policy _ s := policy = pol ∧ Heap.Holds policy (objsP  b M ++ frame) s.data.dmem ∧ Heap.Permits policy (objsP  b M ++ frame) ∧ (Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.C b M) ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderAbsorbSurplusPC s ∧ s.data.regs.rdi.toBitVec = 0 ∧ (∀ b', Private s.data.regs.rsp.toBitVec b' → ¬ Covered (objsP  b M ++ frame) b') ∧ (∀ b', SysV.Below s.data.regs.rsp.toBitVec 64 b' → ¬ Covered (objsP  b M ++ frame) b') ∧ SysV.StackRoom policy s 64
    returns _ y := Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.run b M = some y
    post _ y s t := SysV.Exit s t ∧ Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.result b M y) y) = [⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩] ∧ Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.post b M Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf pol ⟨.W16, t.data.regs.rax.toBitVec.setWidth 16⟩ t.data.dmem ∧ ∀ b', ¬ (objsP  b M ++ frame).Owned b' → ¬ SysV.Below s.data.regs.rsp.toBitVec 64 b' → t.data.dmem.get? b' = s.data.dmem.get? b' }


/-- The caller keeps the frame: a run of its blocks from a heap that is a permutation of the own
objects and the frame leaves a heap that still has the frame. -/
theorem outer_frame (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (a : skel_call.In2p) (q : UInt64 × Heap) (hpre : callPre frame b M a)
    (hq : skel_call.l2p.returns a q) : OuterRes a frame b q := by
  obtain ⟨hC, hrdi, hheap, hm0⟩ := hpre
  refine Lift.Sem.CallArm.Blocks.Returns.inv (I := OuterInv a frame b) (Q := OuterRes a frame b)
    (block := outer_block a frame b M hC hrdi hheap hm0) hq ?_
  exact rfl

end callFrameAux
theorem call_frame : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : skel_call.In2p) (q : (UInt64 × Heap)), callPre frame b M a → skel_call.l2p.returns a q → ∀ m, q.2.Holds a.policy m → frame.Holds a.policy m := by
  intro frame b M a q hpre hq m hm
  obtain ⟨xs, ys, -, -, hperm⟩ := (callFrameAux.outer_frame frame b M a q hpre hq).perm
  have h1 : (callFrameAux.ownHeap b xs ys ++ frame).Holds a.policy m :=
    (Heap.Holds_perm hperm).mpr hm
  exact (Heap.Holds.append_iff.mp h1).2.1
end call_frame.skel_proof
theorem call_frame : call_frame.skel_statement := @call_frame.skel_proof.call_frame

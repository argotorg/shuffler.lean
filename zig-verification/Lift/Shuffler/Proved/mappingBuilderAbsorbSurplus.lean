theorem dest_mem (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap) :
    Obj.words 24576 true .W64 M.dest.toList ∈ heapOf b M frame := by
  refine List.mem_append.mpr (Or.inl (List.mem_append.mpr (Or.inr ?_)))
  exact List.mem_cons_self ..


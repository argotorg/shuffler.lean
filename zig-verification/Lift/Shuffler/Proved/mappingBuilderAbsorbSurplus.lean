          simp [UInt64.toBitVec_add]
        rw [e, ← habs1]
        exact habs
      have hrank : rank b .LBB23_1 s2 < rank b .LBB23_1 s := by
        show (b.targetSize.toNat - s2.r14.toNat) * (b.sourceSize.toNat + 3) + (b.sourceSize.toNat + 2)

        have hret8 : (blocksP.cut regionHeads).Returns callee (.block .LBB23_1) s (.next .LBB23_8 s3) := by
          have h1 : (blocksP.cut regionHeads).step (.block .LBB23_1) s = .ok (.goto (.block .o46) s) := by

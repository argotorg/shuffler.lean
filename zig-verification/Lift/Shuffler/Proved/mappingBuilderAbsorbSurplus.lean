/-! ### The heap of the model: the fixed objects, the two mapping arrays, and the frame -/

open Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement

/-- The objects of the call before the two mapping arrays. -/
def heapHead (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) : Heap :=
  ((objects b M envOf).take 10).map Lift.Sem.Bridge.toObj

/-- The heap of the model at the mapping `M` and the frame. -/
def heapOf (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap) : Heap :=
  heapHead b M ++ [Obj.words 24576 true .W64 M.dest.toList, Obj.words 32768 true .W64 M.pos.toList] ++
    frame

theorem objsP_heapOf (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) :
    objsP b M = heapHead b M ++
      [Obj.words 24576 true .W64 M.dest.toList, Obj.words 32768 true .W64 M.pos.toList] := by
  simp [objsP, heapHead, objects, Lift.Sem.Bridge.toObj_encode_words64, Lift.Trusted.Encode.encode,
    Lift.Sem.Bridge.toCell, Obj.words, Lift.Sem.Bridge.toObj, Cell.mk]

theorem heapHead_bind (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (p d : FlatShuffler.Word) : heapHead b (M.bind p d) = heapHead b M := rfl

theorem destList_bind (M : FlatShuffler.Flat.Mapping) (p d : FlatShuffler.Word) :
    (M.bind p d).dest.toList = M.dest.toList.set p.toNat d := by
  simp [FlatShuffler.Flat.Mapping.bind, FlatShuffler.Flat.put, Vector.toList_setIfInBounds]

theorem posList_bind (M : FlatShuffler.Flat.Mapping) (p d : FlatShuffler.Word) :
    (M.bind p d).pos.toList = M.pos.toList.set d.toNat p := by
  simp [FlatShuffler.Flat.Mapping.bind, FlatShuffler.Flat.put, Vector.toList_setIfInBounds]

/-- The callee relation of the region proof. -/
def callee : ∀ _ : Unit, mappingBuilderMap.In2p → (UInt64 × Heap) → Prop :=
  fun _ x r => Lift.Sem.CallFrame.PermLift
    (fun k k' => mappingBuilderMap.l2p.returns { x with heap := k } (r.1, k')) x.heap r.2

/-- The heap of the model at the initial mapping. -/
theorem objsP_append (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap) :
    objsP b M ++ frame = heapOf b M frame := by
  rw [objsP_heapOf]; rfl

theorem ite_dite_eq {α : Type} (c : Prop) [Decidable c] (a b : α) :
    (if c then a else b) = (if h : c then a else b) := by
  by_cases h : c
  · rw [if_pos h, dif_pos h]
  · rw [if_neg h, dif_neg h]

theorem toObj_words (p : BitVec 64) (xs : List FlatShuffler.Word) (wr : Bool) :
    Lift.Sem.Bridge.toObj (⟨p, xs.map (fun v => (⟨.W64, v⟩ : Lift.Trusted.Field)), wr⟩ : Lift.Trusted.Object)
      = Obj.words p wr .W64 xs := by
  simp [Lift.Sem.Bridge.toObj, Obj.words, Lift.Sem.Bridge.toCell, List.map_map]

theorem toObj_words_w (w : Width) (p : BitVec 64) (xs : List w.type) (wr : Bool) :
    Lift.Sem.Bridge.toObj (⟨p, xs.map (fun v => (⟨w, v⟩ : Lift.Trusted.Field)), wr⟩ : Lift.Trusted.Object)
      = Obj.words p wr w xs := by
  simp [Lift.Sem.Bridge.toObj, Obj.words, Lift.Sem.Bridge.toCell, List.map_map]

/-- The state invariant of the region certificate. -/
def inv (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (y : FlatShuffler.Flat.ExecutionOutcome FlatShuffler.Flat.Status FlatShuffler.Flat.Mapping)
    (a : In2p) : Lbl → St In2p Heap → Prop
  | .entry, s => s = initP a
  | .LBB23_1, s =>
      s.input = a ∧ s.rbx = 0 ∧ s.r12 = 4294967296 ∧ s.r13 = 18446744073709551615 ∧
      s.r15 = b.targetSize ∧ s.rbp + s.r14 = 0 ∧ s.r14.toNat ≤ b.targetSize.toNat ∧
      ∃ Mj, s.mem = heapOf b Mj frame ∧ FlatShuffler.Flat.absorbFrom b Mj s.r14.toBitVec = y ∧
        ∃ m, (heapOf b Mj frame).Holds a.policy m
  | .LBB23_8, s =>
      s.input = a ∧ s.rbx = 0 ∧ s.r12 = 4294967296 ∧ s.r13 = 18446744073709551615 ∧
      s.r15 = b.targetSize ∧
      s.rbp + s.r14 = 0 ∧ s.rax = 24576 ∧ s.rcx = b.sourceSize ∧ s.rdx + s.rdi = s.r14 ∧
      s.rdi.toNat ≤ b.sourceSize.toNat ∧ s.r14.toNat < b.targetSize.toNat ∧
      ∃ Mj best, s.mem = heapOf b Mj frame ∧ FlatShuffler.Flat.absorbFrom b Mj s.r14.toBitVec = y ∧
        s.rsi.toBitVec = best ∧
        FlatShuffler.Flat.absorbBest b Mj s.r14.toBitVec s.rdi.toBitVec best =
          FlatShuffler.Flat.absorbBest b Mj s.r14.toBitVec 0 FlatShuffler.Flat.NONE ∧
        FlatShuffler.Flat.isWildcardTarget b s.r14.toBitVec = true ∧
        FlatShuffler.Flat.get Mj.pos s.r14.toBitVec = FlatShuffler.Flat.NONE ∧
        ∃ m, (heapOf b Mj frame).Holds a.policy m
  | _, _ => False

/-- The rank of the region certificate. -/
def rank (b : FlatShuffler.Flat.Builder) : Lbl → St In2p Heap → Nat
  | .entry, _ => (b.targetSize.toNat + 1) * (b.sourceSize.toNat + 3) + (b.sourceSize.toNat + 2)
  | .LBB23_1, s =>
      (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) + (b.sourceSize.toNat + 2)
  | .LBB23_8, s =>
      (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) + (b.sourceSize.toNat - s.rdi.toNat)
  | _, _ => 0

/-- The result of the region certificate: the loop returns 0 on the heap of the abstract result. -/
def out (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (y : FlatShuffler.Flat.ExecutionOutcome FlatShuffler.Flat.Status FlatShuffler.Flat.Mapping) :
    Lbl → St In2p Heap → (UInt64 × Heap) :=
  fun _ _ => (0, heapOf b y.2 frame)

/-- A load of a cell of an object of a heap that the memory holds. -/
theorem Heap.loadB_of_mem {policy : CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds policy m)
    {o : Obj} {x : Nat × Cell} (ho : o ∈ h) (hx : x ∈ offsets 0 o.cells) :
    h.loadB (o.addr + BitVec.ofNat 64 x.1) x.2.w = .ok x.2.v :=
  Heap.loadB_of_load (Heap.load_of_mem hh ho hx)

/-- A one-word object of the fixed head of the heap is in the heap. -/
theorem heapHead_words (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (p v : BitVec 64) (wr : Bool)
    (h : (⟨p, [⟨.W64, v⟩], wr⟩ : Lift.Trusted.Object) ∈
      (Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.objects b M
        Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf).take 10) :
    Obj.words p wr .W64 [v] ∈ heapOf b M frame := by
  refine List.mem_append.mpr (Or.inl (List.mem_append.mpr (Or.inl ?_)))
  exact List.mem_map.mpr ⟨_, h, toObj_words p [v] wr⟩

theorem heapHead_words_24 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap) :
    Obj.words 24 false .W64 [b.targetSize] ∈ heapOf b M frame :=
  heapHead_words b M frame 24 b.targetSize false (by
    simp [Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.objects,
      Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf])

theorem heapOf_loadB_24 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (policy : CpuPolicy) (m : DataMem) (hh : (heapOf b M frame).Holds policy m) :
    (heapOf b M frame).loadB 24 .W64 = .ok b.targetSize := by
  have := Heap.loadB_of_mem hh (heapHead_words_24 b M frame)
    (x := (0, (⟨.W64, b.targetSize⟩ : Cell))) (by simp [Obj.words, offsets])
  simpa [Obj.words] using this

/-- A one-word field of the fixed head of the heap. -/
theorem heapOf_loadB_field (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (policy : CpuPolicy) (m : DataMem) (hh : (heapOf b M frame).Holds policy m)
    (p v : BitVec 64)
    (h : (⟨p, [⟨.W64, v⟩], false⟩ : Lift.Trusted.Object) ∈
      (Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.objects b M
        Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf).take 10) :
    (heapOf b M frame).loadB p .W64 = .ok v := by
  have := Heap.loadB_of_mem hh (heapHead_words b M frame p v false h)
    (x := (0, (⟨.W64, v⟩ : Cell))) (by simp [Obj.words, offsets])
  simpa [Obj.words] using this

theorem heapOf_loadB_8 (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)

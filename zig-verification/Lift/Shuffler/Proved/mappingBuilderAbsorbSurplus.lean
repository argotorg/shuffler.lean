/-- `absorbBest` past the source size is the current best. -/
theorem absorbBest_ge (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j o best : FlatShuffler.Word) (h : ¬ o < b.sourceSize) :
    FlatShuffler.Flat.absorbBest b M j o best = best := by
  rw [FlatShuffler.Flat.absorbBest.eq_def, dif_neg h]

/-- One step of `absorbBest` at an offset below the source size. -/
theorem absorbBest_unfold (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j o best : FlatShuffler.Word) (h : o < b.sourceSize) :
    FlatShuffler.Flat.absorbBest b M j o best =
      FlatShuffler.Flat.absorbBest b M j (o + 1)
        (if FlatShuffler.Flat.mappable b M o &&
            (best = FlatShuffler.Flat.NONE ||
              FlatShuffler.Flat.absDiff o j < FlatShuffler.Flat.absDiff best j) then o else best) := by
  rw [FlatShuffler.Flat.absorbBest.eq_def, dif_pos h]

theorem absorbBest_not_mappable (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j o best : FlatShuffler.Word) (h : o < b.sourceSize)
    (hm : FlatShuffler.Flat.mappable b M o = false) :
    FlatShuffler.Flat.absorbBest b M j o best = FlatShuffler.Flat.absorbBest b M j (o + 1) best := by
  rw [absorbBest_unfold b M j o best h, hm]
  rfl

theorem absorbBest_take (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j o best : FlatShuffler.Word) (h : o < b.sourceSize)
    (hm : FlatShuffler.Flat.mappable b M o = true)
    (hc : (best = FlatShuffler.Flat.NONE ||
      FlatShuffler.Flat.absDiff o j < FlatShuffler.Flat.absDiff best j) = true) :
    FlatShuffler.Flat.absorbBest b M j o best = FlatShuffler.Flat.absorbBest b M j (o + 1) o := by
  rw [absorbBest_unfold b M j o best h, hm, hc]
  rfl

theorem absorbBest_keep (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j o best : FlatShuffler.Word) (h : o < b.sourceSize)
    (hm : FlatShuffler.Flat.mappable b M o = true)
    (hc : (best = FlatShuffler.Flat.NONE ||
      FlatShuffler.Flat.absDiff o j < FlatShuffler.Flat.absDiff best j) = false) :
    FlatShuffler.Flat.absorbBest b M j o best = FlatShuffler.Flat.absorbBest b M j (o + 1) best := by
  rw [absorbBest_unfold b M j o best h, hm, hc]
  rfl

/-- The value of `absorbBest` is `NONE` or a stack offset. -/
theorem absorbBest_bound (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j : FlatShuffler.Word) (hsrc : b.sourceSize.toNat ≤ FlatShuffler.maxStackSize) :
    ∀ (o best : FlatShuffler.Word),
      (best = FlatShuffler.Flat.NONE ∨ best.toNat < FlatShuffler.maxStackSize) →
      (FlatShuffler.Flat.absorbBest b M j o best = FlatShuffler.Flat.NONE ∨
        (FlatShuffler.Flat.absorbBest b M j o best).toNat < FlatShuffler.maxStackSize) := by
  refine FlatShuffler.Flat.absorbBest.induct (b := b) (M := M) (j := j)
    (motive := fun o best =>
      (best = FlatShuffler.Flat.NONE ∨ best.toNat < FlatShuffler.maxStackSize) →
      (FlatShuffler.Flat.absorbBest b M j o best = FlatShuffler.Flat.NONE ∨
        (FlatShuffler.Flat.absorbBest b M j o best).toNat < FlatShuffler.maxStackSize)) ?_ ?_
  · intro o best ho best1 hb hb0
    have hstep : FlatShuffler.Flat.absorbBest b M j o best =
        FlatShuffler.Flat.absorbBest b M j (o + 1) best1 := by
      rw [FlatShuffler.Flat.absorbBest.eq_def]
      simp only [ho, dif_pos, best1]
      rw [ite_dite_eq]
    rw [hstep]
    apply hb
    simp only [best1]
    split
    · rename_i hc
      right
      rw [BitVec.lt_def] at ho
      omega
    · exact hb0
  · intro o best ho hb0
    rw [FlatShuffler.Flat.absorbBest.eq_def]
    simp only [dif_neg ho]
    exact hb0

/-- The first difference of `.o142` is the absolute difference. -/
theorem absDiff_first (j best : FlatShuffler.Word) :
    (if j ≤ best then best - j else j - best) = FlatShuffler.Flat.absDiff best j := by
  unfold FlatShuffler.Flat.absDiff
  split <;> split <;> bv_omega

/-- The second difference of `.o142` is the absolute difference. -/
theorem absDiff_second (j i : FlatShuffler.Word) :
    (if i ≤ j then j - i else i + (0 - j)) = FlatShuffler.Flat.absDiff i j := by
  unfold FlatShuffler.Flat.absDiff
  split <;> split <;> bv_omega

/-- The comparison of `.o142`. -/
theorem o142_iff (j i best : FlatShuffler.Word) :
    ((if j ≤ best then best - j else j - best) ≤ (if i ≤ j then j - i else i + (0 - j)))
      ↔ (FlatShuffler.Flat.absDiff best j ≤ FlatShuffler.Flat.absDiff i j) := by
  rw [absDiff_first, absDiff_second]

/-- The value of the cell at the offset `8 * k` of an array of words. -/
theorem cellGet_map_words64 (xs : List (BitVec 64)) (k : Nat) (hk : k < xs.length) :
    cellGet (xs.map (Cell.mk .W64)) (8 * k) .W64 = some xs[k] := by
  induction xs generalizing k with
  | nil => simp at hk
  | cons x xs ih =>
    cases k with
    | zero => simp [cellGet_cons_zero, Cell.get_self]
    | succ k =>
      rw [List.map_cons, show 8 * (k + 1) = 8 + 8 * k by omega,
        cellGet_cons_ge .W64 (by show 8 ≤ 8 + 8 * k; omega),
        show 8 + 8 * k - 8 = 8 * k by omega, ih k (by simpa using hk), List.getElem_cons_succ]

/-- The cells of an array of words after a store to the cell at the offset `8 * k`. -/
theorem cellSet_map_words64 (xs : List (BitVec 64)) (k : Nat) (hk : k < xs.length) (v : BitVec 64) :
    cellSet (xs.map (Cell.mk .W64)) (8 * k) .W64 v = (xs.set k v).map (Cell.mk .W64) := by
  induction xs generalizing k with
  | nil => simp at hk
  | cons x xs ih =>
    cases k with
    | zero => simp [cellSet_cons_zero]
    | succ k =>
      rw [List.map_cons, List.set_cons_succ, show 8 * (k + 1) = 8 + 8 * k by omega,
        cellSet_cons_ge .W64 v (by show 8 ≤ 8 + 8 * k; omega),
        show 8 + 8 * k - 8 = 8 * k by omega, ih k (by simpa using hk), List.map_cons]

theorem Heap.StoreAt.append_left {a : BitVec 64} {w : Width} {v : w.type} {t t' : Heap}
    (hs : Heap.StoreAt a w v t t') (l : Heap) : Heap.StoreAt a w v (l ++ t) (l ++ t') := by
  induction l with
  | nil => simpa using hs
  | cons o l ih => exact .tail ih

/-- A store of a word into the cell `k` of an array of words of a heap. -/
theorem StoreAt_array_words64 (base : BitVec 64) (xs : List (BitVec 64)) (k : Nat)
    (hk : k < xs.length) (hk64 : 8 * k < 2 ^ 64) (v : BitVec 64) (l rest : Heap) :
    Heap.StoreAt (base + BitVec.ofNat 64 (8 * k)) .W64 v
      (l ++ Obj.words base true .W64 xs :: rest)
      (l ++ Obj.words base true .W64 (xs.set k v) :: rest) := by
  have e : (base + BitVec.ofNat 64 (8 * k)) - base = BitVec.ofNat 64 (8 * k) := by bv_omega
  have hc : (cellGet (xs.map (Cell.mk .W64))
      ((base + BitVec.ofNat 64 (8 * k)) - base).toNat .W64).isSome := by
    rw [e, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hk64, cellGet_map_words64 xs k hk]
    rfl
  have hhead : Heap.StoreAt (base + BitVec.ofNat 64 (8 * k)) .W64 v
      (Obj.words base true .W64 xs :: rest) (Obj.words base true .W64 (xs.set k v) :: rest) := by
    have h := Heap.StoreAt.head (o := Obj.words base true .W64 xs) (t := rest) (v := v) rfl hc
    have hset : (Obj.words base true .W64 xs).setAt (base + BitVec.ofNat 64 (8 * k)) .W64 v
        = Obj.words base true .W64 (xs.set k v) := by
      show (⟨base, true, xs.map (Cell.mk .W64)⟩ : Obj).setAt (base + BitVec.ofNat 64 (8 * k)) .W64 v
        = ⟨base, true, (xs.set k v).map (Cell.mk .W64)⟩
      unfold Obj.setAt
      rw [show (base + BitVec.ofNat 64 (8 * k) - base).toNat = 8 * k from by
        rw [e, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hk64]]
      rw [cellSet_map_words64 xs k hk v]
    rw [hset] at h
    exact h
  exact Heap.StoreAt.append_left hhead l

/-- The heap after the store into the `dest` array. -/
def heapOfD (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (p d : FlatShuffler.Word) : Heap :=
  heapHead b M ++
    [Obj.words 24576 true .W64 (M.dest.toList.set p.toNat d),
      Obj.words 32768 true .W64 M.pos.toList] ++ frame

theorem storeB_dest (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (policy : CpuPolicy) (m : DataMem) (p d : FlatShuffler.Word)
    (hp : p.toNat < FlatShuffler.maxStackSize)
    (hh : (heapOf b M frame).Holds policy m) :
    (heapOf b M frame).storeB (24576 + p * 8) .W64 d = .ok (heapOfD b M frame p d) := by
  have hp64 : 8 * p.toNat < 2 ^ 64 := by
    have h : FlatShuffler.maxStackSize = 1024 := rfl
    omega
  have haddr : (24576 : BitVec 64) + p * 8 = (24576 : BitVec 64) + BitVec.ofNat 64 (8 * p.toNat) := by
    congr 1
    bv_omega
  have hshape : heapOf b M frame = heapHead b M ++ Obj.words 24576 true .W64 M.dest.toList ::
      Obj.words 32768 true .W64 M.pos.toList :: frame := by
    simp [heapOf, List.append_assoc]
  have hshape' : heapOfD b M frame p d = heapHead b M ++
      Obj.words 24576 true .W64 (M.dest.toList.set p.toNat d) ::
      Obj.words 32768 true .W64 M.pos.toList :: frame := by
    simp [heapOfD, List.append_assoc]
  rw [haddr, hshape, hshape']
  exact Heap.storeB_of_storeAt hh (StoreAt_array_words64 24576 M.dest.toList p.toNat
    (by simpa using hp) hp64 d (heapHead b M) (Obj.words 32768 true .W64 M.pos.toList :: frame))

theorem storeB_pos (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (policy : CpuPolicy) (m : DataMem) (p d : FlatShuffler.Word)
    (hp : p.toNat < FlatShuffler.maxStackSize) (hd : d.toNat < FlatShuffler.maxStackSize)
    (hh : (heapOfD b M frame p d).Holds policy m) :
    (heapOfD b M frame p d).storeB (24576 + d * 8 + 8192) .W64 p =
      .ok (heapOf b (M.bind p d) frame) := by
  have hd64 : 8 * d.toNat < 2 ^ 64 := by
    have h : FlatShuffler.maxStackSize = 1024 := rfl
    omega
  have haddr : (24576 : BitVec 64) + d * 8 + 8192
      = (32768 : BitVec 64) + BitVec.ofNat 64 (8 * d.toNat) := by
    bv_omega
  have hshape : heapOfD b M frame p d = (heapHead b M ++
      [Obj.words 24576 true .W64 (M.dest.toList.set p.toNat d)]) ++
      Obj.words 32768 true .W64 M.pos.toList :: frame := by
    simp [heapOfD, List.append_assoc]
  have hshape' : heapOf b (M.bind p d) frame = (heapHead b M ++
      [Obj.words 24576 true .W64 (M.dest.toList.set p.toNat d)]) ++
      Obj.words 32768 true .W64 (M.pos.toList.set d.toNat p) :: frame := by
    simp only [heapOf, heapHead_bind, destList_bind, posList_bind, List.append_assoc]
    rfl
  rw [haddr, hshape, hshape']
  exact Heap.storeB_of_storeAt hh (StoreAt_array_words64 32768 M.pos.toList d.toNat
    (by simpa using hd) hd64 p
    (heapHead b M ++ [Obj.words 24576 true .W64 (M.dest.toList.set p.toNat d)]) frame)

/-- The input of the callee `mappingBuilderMap` at the call of `.o188`. -/
def calleeIn (policy : CpuPolicy) (H : Heap) (rax : UInt64) (p d : FlatShuffler.Word)
    (sp : BitVec 64) : mappingBuilderMap.In2p :=
  ⟨policy, H, rax, UInt64.ofBitVec d, UInt64.ofBitVec p, 0, sp⟩

/-- The callee returns `0` and the heap of the mapping with the new binding. -/
theorem callee_returns (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (policy : CpuPolicy) (rax : UInt64) (p d : FlatShuffler.Word) (sp : BitVec 64)
    (hp : p.toNat < FlatShuffler.maxStackSize) (hd : d.toNat < FlatShuffler.maxStackSize)
    (hm : ∃ m, (heapOf b M frame).Holds policy m)
    (h1 : FlatShuffler.Flat.get b.dropped p = 0)
    (h2 : FlatShuffler.Flat.get M.dest p = FlatShuffler.Flat.NONE)
    (h3 : FlatShuffler.Flat.get M.pos d = FlatShuffler.Flat.NONE) :
    mappingBuilderMap.blocksP.Returns noCall .entry
      (mappingBuilderMap.initP (calleeIn policy (heapOf b M frame) rax p d sp))
      ((0 : UInt64), heapOf b (M.bind p d) frame) := by
  obtain ⟨m, hh⟩ := hm
  have hs1 : (heapOf b M frame).storeB (24576 + p * 8) .W64 d = .ok (heapOfD b M frame p d) :=
    storeB_dest b M frame policy m p d hp hh
  obtain ⟨m', hm'⟩ := Heap.storeB_holds hh hs1
  have hs2 : (heapOfD b M frame p d).storeB (24576 + d * 8 + 8192) .W64 p
      = .ok (heapOf b (M.bind p d) frame) :=
    storeB_pos b M frame policy m' p d hp hd hm'
  have h32 : (heapOf b M frame).loadB ((0 : UInt64).toBitVec + 32) .W64 = .ok 20480 := by
    have e : (0 : UInt64).toBitVec + (32 : BitVec 64) = 32 := by
      show (0 : BitVec 64) + 32 = 32
      bv_omega
    rw [e]
    exact heapOf_loadB_32 b M frame policy m hh
  have hdrop : (heapOf b M frame).loadB (20480 + (UInt64.ofBitVec p).toBitVec * 1) .W8
      = .ok (FlatShuffler.Flat.get b.dropped p) := by
    have e : (20480 : BitVec 64) + (UInt64.ofBitVec p).toBitVec * 1 = 20480 + p := by
      show (20480 : BitVec 64) + p * 1 = 20480 + p
      bv_omega
    rw [e]
    exact heapOf_loadB_dropped b M frame policy m hh p hp
  have h48 : (heapOf b M frame).loadB ((0 : UInt64).toBitVec + 48) .W64 = .ok 24576 := by
    have e : (0 : UInt64).toBitVec + (48 : BitVec 64) = 48 := by
      show (0 : BitVec 64) + 48 = 48
      bv_omega
    rw [e]
    exact heapOf_loadB_48 b M frame policy m hh
  have hdest : (heapOf b M frame).loadB (24576 + (UInt64.ofBitVec p).toBitVec * 8) .W64
      = .ok (FlatShuffler.Flat.get M.dest p) := by
    have e : (24576 : BitVec 64) + (UInt64.ofBitVec p).toBitVec * 8 = 24576 + 8 * p := by
      show (24576 : BitVec 64) + p * 8 = 24576 + 8 * p
      bv_omega
    rw [e]
    exact heapOf_loadB_dest b M frame policy m hh p hp
  have hpos : (heapOf b M frame).loadB ((UInt64.ofBitVec 24576).toBitVec +
      (UInt64.ofBitVec d).toBitVec * 8 + 8192) .W64 = .ok (FlatShuffler.Flat.get M.pos d) := by
    have e : (UInt64.ofBitVec 24576).toBitVec + (UInt64.ofBitVec d).toBitVec * 8 + 8192
        = 24576 + d * 8 + 8192 := by
      show (24576 : BitVec 64) + d * 8 + 8192 = 24576 + d * 8 + 8192
      rfl
    rw [e]
    exact heapOf_loadB_pos b M frame policy m hh d hd
  have hz : UInt64.ofBitVec (BitVec.zeroExtend 64 (FlatShuffler.Flat.get b.dropped p)) = 0 := by
    rw [h1]; decide
  have h2' : UInt64.ofBitVec (FlatShuffler.Flat.get M.dest p) = 18446744073709551615 :=
    ofBitVec_none _ |>.mpr h2
  have h3' : UInt64.ofBitVec (FlatShuffler.Flat.get M.pos d) = 18446744073709551615 :=
    ofBitVec_none _ |>.mpr h3
  let x0 : mappingBuilderMap.St mappingBuilderMap.In2p Heap :=
    mappingBuilderMap.initP (calleeIn policy (heapOf b M frame) rax p d sp)
  let x1 : mappingBuilderMap.St mappingBuilderMap.In2p Heap :=
    { x0 with rax := (rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := UInt64.ofBitVec 20480 }
  let x2 : mappingBuilderMap.St mappingBuilderMap.In2p Heap := { x1 with rcx := UInt64.ofBitVec 24576 }
  let x4 : mappingBuilderMap.St mappingBuilderMap.In2p Heap :=
    { x2 with rax := 0, mem := heapOf b (M.bind p d) frame }
  have hstep1 : mappingBuilderMap.blocksP.step .entry x0 = .ok (.goto .o14 x1) := by
    simp only [mappingBuilderMap.blocksP, x0, x1, calleeIn, mappingBuilderMap.initP, h32, hdrop,
      hz, ↓reduceIte]
  have hstep2 : mappingBuilderMap.blocksP.step .o14 x1 = .ok (.goto .o25 x2) := by
    simp only [mappingBuilderMap.blocksP, x0, x1, x2, calleeIn, mappingBuilderMap.initP, h48, hdest,
      h2', ↓reduceIte]
  have hstep3 : mappingBuilderMap.blocksP.step .o25 x2 = .ok (.goto .o36 x2) := by
    simp only [mappingBuilderMap.blocksP, x0, x2, x1, calleeIn, mappingBuilderMap.initP, hpos, h3',
      ↓reduceIte]
  have hstep4 : mappingBuilderMap.blocksP.step .o36 x2 = .ok (.goto .LBB25_4 x4) := by
    simp only [mappingBuilderMap.blocksP, x0, x2, x1, x4, calleeIn, mappingBuilderMap.initP,
      hs1, hs2]
  have hstep5 : mappingBuilderMap.blocksP.step .LBB25_4 x4
      = .ok (.ret ((0 : UInt64), heapOf b (M.bind p d) frame)) := by
    simp only [mappingBuilderMap.blocksP, x4, x2, x1, calleeIn, mappingBuilderMap.initP]
  exact Blocks.Returns.goto hstep1 (Blocks.Returns.goto hstep2 (Blocks.Returns.goto hstep3
    (Blocks.Returns.goto hstep4 (Blocks.Returns.ret hstep5))))

/-- The callee relation at the success of `mbMap`. -/
theorem calleeRel_done (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (policy : CpuPolicy) (rax : UInt64) (p d : FlatShuffler.Word) (sp : BitVec 64)
    (hp : p.toNat < FlatShuffler.maxStackSize) (hd : d.toNat < FlatShuffler.maxStackSize)
    (hm : ∃ m, (heapOf b M frame).Holds policy m)
    (h1 : FlatShuffler.Flat.get b.dropped p = 0)
    (h2 : FlatShuffler.Flat.get M.dest p = FlatShuffler.Flat.NONE)
    (h3 : FlatShuffler.Flat.get M.pos d = FlatShuffler.Flat.NONE) :
    callee () (calleeIn policy (heapOf b M frame) rax p d sp) ((0 : UInt64), heapOf b (M.bind p d) frame) := by
  refine ⟨heapOf b M frame, heapOf b (M.bind p d) frame, ?_, ?_⟩
  · exact callee_returns b M frame policy rax p d sp hp hd hm h1 h2 h3
  · exact ⟨rfl, rfl, List.Perm.refl _⟩

/-- `absorbFrom` skips `j` when the best source is `NONE`. -/
theorem absorbFrom_skip_none (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j : FlatShuffler.Word) (hlt : j < b.targetSize)
    (h : FlatShuffler.Flat.absorbBest b M j 0 FlatShuffler.Flat.NONE = FlatShuffler.Flat.NONE) :
    FlatShuffler.Flat.absorbFrom b M j = FlatShuffler.Flat.absorbFrom b M (j + 1) := by
  rw [FlatShuffler.Flat.absorbFrom.eq_def, dif_pos hlt, if_neg]
  intro hc
  have h3 := (Bool.and_eq_true _ _).mp hc |>.2
  rw [h] at h3
  simp at h3

/-- `absorbFrom` maps the binding `p` at `j`. -/
theorem absorbFrom_map (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j p : FlatShuffler.Word) (hlt : j < b.targetSize)
    (hw : FlatShuffler.Flat.isWildcardTarget b j = true)
    (hp : FlatShuffler.Flat.get M.pos j = FlatShuffler.Flat.NONE)
    (hbest : FlatShuffler.Flat.absorbBest b M j 0 FlatShuffler.Flat.NONE = p)
    (hpne : p ≠ FlatShuffler.Flat.NONE)
    (hm : FlatShuffler.Flat.mappable b M p = true) :
    FlatShuffler.Flat.absorbFrom b M j = FlatShuffler.Flat.absorbFrom b (M.bind p j) (j + 1) := by
  have hm' : ((FlatShuffler.Flat.get b.dropped p == 0) &&
      (FlatShuffler.Flat.get M.dest p == FlatShuffler.Flat.NONE)) = true := by
    simpa [FlatShuffler.Flat.mappable] using hm
  have hd : FlatShuffler.Flat.get M.dest p = FlatShuffler.Flat.NONE := by
    have h := (Bool.and_eq_true _ _).mp hm' |>.2
    simpa using h
  rw [FlatShuffler.Flat.absorbFrom.eq_def, dif_pos hlt]
  rw [if_pos]
  · rw [hbest]
    have hmb : FlatShuffler.Flat.mbMap b M p j
        = (FlatShuffler.Flat.ExecutionControl.done, M.bind p j) := by
      simp [FlatShuffler.Flat.mbMap, hm, hd, hp]
    rw [hmb]
    simp
  · refine (Bool.and_eq_true _ _).mpr ⟨(Bool.and_eq_true _ _).mpr ⟨hw, ?_⟩, ?_⟩
    · simp [FlatShuffler.Flat.hasSourceAssigned, hp]
    · rw [hbest]
      simpa using hpne

/-- The final clause of the certificate. -/
theorem holds_has {policy : Lift.P2.Total.CpuPolicy} {h : Heap} {m : DataMem} (hh : h.Holds policy m)
    {obj : Lift.Trusted.Object} (ho : Lift.Sem.Bridge.toObj obj ∈ h) :
    Lift.Trusted.Mem.has policy m obj :=
  (Lift.Sem.Bridge.has_iff policy m obj).mpr ⟨hh.noWrap _ ho, hh.read _ ho, hh.write _ ho⟩

theorem mappable_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (p : FlatShuffler.Word) :
    (FlatShuffler.Flat.mappable b M p = true) ↔
      (FlatShuffler.Flat.get b.dropped p = 0 ∧ FlatShuffler.Flat.get M.dest p = FlatShuffler.Flat.NONE) := by
  simp [FlatShuffler.Flat.mappable, Bool.and_eq_true]

theorem mbMap_done (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (p t : FlatShuffler.Word) (hm : FlatShuffler.Flat.mappable b M p = true)
    (hp : FlatShuffler.Flat.get M.pos t = FlatShuffler.Flat.NONE) :
    FlatShuffler.Flat.mbMap b M p t = (FlatShuffler.Flat.ExecutionControl.done, M.bind p t) := by
  have hd : FlatShuffler.Flat.get M.dest p = FlatShuffler.Flat.NONE := (mappable_eq b M p).mp hm |>.2
  have hm' : ¬ (FlatShuffler.Flat.mappable b M p = false) := by rw [hm]; simp
  simp [FlatShuffler.Flat.mbMap, hm, hd, hp]

theorem absorbBest_ok (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j : FlatShuffler.Word) :
    ∀ (o best : FlatShuffler.Word), (best = FlatShuffler.Flat.NONE ∨ FlatShuffler.Flat.mappable b M best = true) →
      (FlatShuffler.Flat.absorbBest b M j o best = FlatShuffler.Flat.NONE ∨
        FlatShuffler.Flat.mappable b M (FlatShuffler.Flat.absorbBest b M j o best) = true) := by
  refine FlatShuffler.Flat.absorbBest.induct (b := b) (M := M) (j := j)
    (motive := fun o best => (best = FlatShuffler.Flat.NONE ∨ FlatShuffler.Flat.mappable b M best = true) →
      (FlatShuffler.Flat.absorbBest b M j o best = FlatShuffler.Flat.NONE ∨
        FlatShuffler.Flat.mappable b M (FlatShuffler.Flat.absorbBest b M j o best) = true)) ?_ ?_
  · intro o best ho best1 hb hb0
    have hstep : FlatShuffler.Flat.absorbBest b M j o best =
        FlatShuffler.Flat.absorbBest b M j (o + 1) best1 := by
      rw [FlatShuffler.Flat.absorbBest.eq_def]
      simp only [ho, dif_pos, best1]
      rw [ite_dite_eq]
    rw [hstep]
    apply hb
    simp only [best1]
    split
    · rename_i hc
      exact Or.inr ((Bool.and_eq_true _ _).mp hc |>.1)
    · exact hb0
  · intro o best ho hb0
    rw [FlatShuffler.Flat.absorbBest.eq_def]
    simp only [dif_neg ho]
    exact hb0

theorem absorbBest_mappable (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j : FlatShuffler.Word) (o best : FlatShuffler.Word)
    (hb : best = FlatShuffler.Flat.NONE ∨ FlatShuffler.Flat.mappable b M best = true)
    (hne : FlatShuffler.Flat.absorbBest b M j o best ≠ FlatShuffler.Flat.NONE) :
    FlatShuffler.Flat.mappable b M (FlatShuffler.Flat.absorbBest b M j o best) = true := by
  rcases absorbBest_ok b M j o best hb with h | h
  · exact absurd h hne
  · exact h

theorem absorbFrom_ok (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (j : FlatShuffler.Word) :
    (FlatShuffler.Flat.absorbFrom b M j).1 = FlatShuffler.Flat.ExecutionControl.done := by
  refine FlatShuffler.Flat.absorbFrom.induct (b := b)
    (motive := fun M j => (FlatShuffler.Flat.absorbFrom b M j).1 = FlatShuffler.Flat.ExecutionControl.done)
    ?_ ?_ ?_ ?_ M j
  · intro M j hlt hcond r hr
    exfalso
    have hbest : FlatShuffler.Flat.mappable b M (FlatShuffler.Flat.absorbBest b M j 0 FlatShuffler.Flat.NONE) = true :=
      absorbBest_mappable b M j 0 FlatShuffler.Flat.NONE (Or.inl rfl) (by
        have h2 := (Bool.and_eq_true _ _).mp hcond |>.2
        simpa using h2)
    have hpos : FlatShuffler.Flat.get M.pos j = FlatShuffler.Flat.NONE := by
      have h1 := (Bool.and_eq_true _ _).mp hcond |>.1
      have h2 := (Bool.and_eq_true _ _).mp h1 |>.2
      simpa [FlatShuffler.Flat.hasSourceAssigned] using h2
    have hmap := mbMap_done b M (FlatShuffler.Flat.absorbBest b M j 0 FlatShuffler.Flat.NONE) j hbest hpos
    exact hr (by
      show (FlatShuffler.Flat.mbMap b M (FlatShuffler.Flat.absorbBest b M j 0 FlatShuffler.Flat.NONE) j).1
        = FlatShuffler.Flat.ExecutionControl.done
      rw [hmap])
  · intro M j hlt hcond r hr ih
    rw [FlatShuffler.Flat.absorbFrom.eq_def, dif_pos hlt, if_pos hcond, if_neg hr]
    exact ih
  · intro M j hlt hcond ih
    rw [FlatShuffler.Flat.absorbFrom.eq_def, dif_pos hlt, if_neg hcond]
    exact ih
  · intro M j hlt
    rw [FlatShuffler.Flat.absorbFrom.eq_def, dif_neg hlt]

theorem result_eq (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping)
    (y : FlatShuffler.Flat.ExecutionOutcome FlatShuffler.Flat.Status FlatShuffler.Flat.Mapping)
    (hy : y.1 = FlatShuffler.Flat.ExecutionControl.done) :
    Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.result b M y = ⟨.W16, 0⟩ := by
  obtain ⟨c, m⟩ := y
  change c = FlatShuffler.Flat.ExecutionControl.done at hy
  rw [hy]
  rfl

theorem final_clause (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (y : FlatShuffler.Flat.ExecutionOutcome FlatShuffler.Flat.Status FlatShuffler.Flat.Mapping)
    (a : In2p) (hs : SimArr frame b M a) (hy : y = FlatShuffler.Flat.absorbSurplus b M) :
    Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.result b M y) y) =
        [⟨.W16, (out b frame y .entry (initP a)).1.toBitVec.setWidth 16⟩] ∧
      a.heap = objsP b M ++ frame ∧
      ∀ m, (out b frame y .entry (initP a)).2.Holds a.policy m →
        Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.post b M
          Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf a.policy
          ⟨.W16, (out b frame y .entry (initP a)).1.toBitVec.setWidth 16⟩ m := by
  obtain ⟨hC, hrdi, hheap, hm⟩ := hs
  have hy1 : y.1 = FlatShuffler.Flat.ExecutionControl.done := by
    rw [hy]
    exact absorbFrom_ok b M 0
  have hres := result_eq b M y hy1
  refine ⟨?_, hheap, ?_⟩
  · change Lift.Trusted.Encode.encode (Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.result b M y) =
      [⟨.W16, (out b frame y .entry (initP a)).1.toBitVec.setWidth 16⟩]
    rw [hres]
    rfl
  · intro m hm'
    refine ⟨y, ?_, ?_, ?_⟩
    · rw [hy]
      rfl
    · rw [hres]; rfl
    · intro o ho
      simp only [Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.written, List.mem_cons,
        List.not_mem_nil, or_false] at ho
      rcases ho with rfl | rfl
      · refine holds_has hm' ?_
        have hmem : Lift.Sem.Bridge.toObj (⟨24576, y.2.dest.toList.map (fun v => (⟨.W64, v⟩ : Lift.Trusted.Field)), true⟩ : Lift.Trusted.Object)
            ∈ (heapHead b y.2 ++ [Obj.words 24576 true .W64 y.2.dest.toList,
                Obj.words 32768 true .W64 y.2.pos.toList]) ++ frame := by
          refine List.mem_append.mpr (Or.inl (List.mem_append.mpr (Or.inr ?_)))
          rw [toObj_words]
          exact List.mem_cons_self ..
        simpa only [out, heapOf] using hmem
      · refine holds_has hm' ?_
        have hmem : Lift.Sem.Bridge.toObj (⟨32768, y.2.pos.toList.map (fun v => (⟨.W64, v⟩ : Lift.Trusted.Field)), true⟩ : Lift.Trusted.Object)
            ∈ (heapHead b y.2 ++ [Obj.words 24576 true .W64 y.2.dest.toList,
                Obj.words 32768 true .W64 y.2.pos.toList]) ++ frame := by
          refine List.mem_append.mpr (Or.inl (List.mem_append.mpr (Or.inr ?_)))
          rw [toObj_words]
          exact List.mem_cons_of_mem _ (List.mem_cons_self ..)
        simpa only [out, heapOf] using hmem


/-- A block step of the region, with a target that is not a head. -/
theorem cut_goto_block {l : Lbl} {s : St In2p Heap} {k : Lbl} {t : St In2p Heap}
    (h : blocksP.step l s = .ok (.goto k t)) (hk : regionHeads k = false) :
    (blocksP.cut regionHeads).step (.block l) s = .ok (.goto (.block k) t) := by
  rw [show (blocksP.cut regionHeads).step (.block l) s
      = .ok (.goto (if regionHeads k then .stop k else .block k) t) from by
    simp only [Blocks.cut, h], hk]
  rfl

/-- A block step of the region, with a target that is a head. -/
theorem cut_goto_stop {l : Lbl} {s : St In2p Heap} {k : Lbl} {t : St In2p Heap}
    (h : blocksP.step l s = .ok (.goto k t)) (hk : regionHeads k = true) :
    (blocksP.cut regionHeads).step (.block l) s = .ok (.goto (.stop k) t) := by
  rw [show (blocksP.cut regionHeads).step (.block l) s
      = .ok (.goto (if regionHeads k then .stop k else .block k) t) from by
    simp only [Blocks.cut, h], hk]
  rfl

/-- The inner loop region. -/
theorem region_inner (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (y : FlatShuffler.Flat.ExecutionOutcome FlatShuffler.Flat.Status FlatShuffler.Flat.Mapping)
    (a : In2p) (hs : SimArr frame b M a) (hy : y = FlatShuffler.Flat.absorbSurplus b M)
    (s : St In2p Heap) (h : inv b M frame y a .LBB23_8 s) :
    ∃ e, (blocksP.cut regionHeads).Returns callee (.block .LBB23_8) s e ∧
      Lift.Sem.CutExit.Progress (inv b M frame y a) (rank b) (out b frame y) .LBB23_8 s e := by
  obtain ⟨hC, hrdi0, hheap, hm0⟩ := hs
  obtain ⟨hin, hrbx, hr12, hr13, hr15, hrbp, hrax, hrcx, hrdx, hrdib, hr14lt, Mj, best, hmem, habs,
    hrsi, hbest, hw, hpos, hm⟩ := h
  obtain ⟨m, hh⟩ := hm
  have htgt : b.targetSize.toNat ≤ FlatShuffler.maxStackSize := by
    have h2 := hC.2
    rw [BitVec.le_def] at h2
    simpa [FlatShuffler.maxStackSize] using h2
  have hsrc : b.sourceSize.toNat ≤ FlatShuffler.maxStackSize := by
    have h2 := hC.1
    rw [BitVec.le_def] at h2
    simpa [FlatShuffler.maxStackSize] using h2
  have hjms : s.r14.toNat < FlatShuffler.maxStackSize := by omega
  have hlt : s.r14.toBitVec < b.targetSize := by
    show s.r14.toBitVec.toNat < b.targetSize.toNat
    simpa using hr14lt
  by_cases heq : s.rcx = s.rdi
  · have hrdi_eq : s.rdi.toBitVec = b.sourceSize := by
      have h2 := congrArg UInt64.toBitVec heq
      rw [hrcx] at h2
      exact h2.symm
    have hge : ¬ s.rdi.toBitVec < b.sourceSize := by
      rw [hrdi_eq, BitVec.lt_def]
      omega
    have hbest_end : best =
        FlatShuffler.Flat.absorbBest b Mj s.r14.toBitVec 0 FlatShuffler.Flat.NONE := by
      rw [← hbest, absorbBest_ge b Mj s.r14.toBitVec s.rdi.toBitVec best hge]
    have hstep8 : blocksP.step .LBB23_8 s = .ok (.goto .LBB23_16 s) := by
      simp only [blocksP]
      rw [if_pos heq]
    by_cases hnone : s.rsi = 18446744073709551615
    · -- the best source is `NONE`: `.LBB23_5` and back to `.LBB23_1`
      have hbestnone : best = FlatShuffler.Flat.NONE := by
        rw [← hrsi, hnone]
        decide
      have hskip : FlatShuffler.Flat.absorbFrom b Mj s.r14.toBitVec
          = FlatShuffler.Flat.absorbFrom b Mj (s.r14.toBitVec + 1) := by
        refine absorbFrom_skip_none b Mj s.r14.toBitVec hlt ?_
        rw [← hbest_end, hbestnone]
      let s2 : St In2p Heap := { s with r14 := s.r14 + 1, rbp := s.rbp - 1 }
      have hstep16 : blocksP.step .LBB23_16 s = .ok (.goto .LBB23_5 s) := by
        simp only [blocksP]
        rw [if_pos hnone]
      have hstep5 : blocksP.step .LBB23_5 s = .ok (.goto .LBB23_1 s2) := by
        simp only [blocksP, s2]
      have hsum : s2.rbp + s2.r14 = 0 := by
        apply UInt64.toBitVec_inj.mp
        simp only [s2, UInt64.toBitVec_add, UInt64.toBitVec_sub, UInt64.toBitVec_zero]
        have h2 := congrArg UInt64.toBitVec hrbp
        simp only [UInt64.toBitVec_add, UInt64.toBitVec_zero] at h2
        bv_omega
      have hle2 : s2.r14.toNat ≤ b.targetSize.toNat := by
        show (s.r14 + 1).toNat ≤ b.targetSize.toNat
        rw [toNat_add_one s.r14 (by omega)]
        omega
      have habs2 : FlatShuffler.Flat.absorbFrom b Mj s2.r14.toBitVec = y := by
        have e : s2.r14.toBitVec = s.r14.toBitVec + 1 := by
          show (s.r14 + 1).toBitVec = s.r14.toBitVec + 1
          simp [UInt64.toBitVec_add]
        rw [e, ← hskip]
        exact habs
      have hrank : rank b .LBB23_1 s2 < rank b .LBB23_8 s := by
        show (b.targetSize.toNat - s2.r14.toNat) * (b.sourceSize.toNat + 3) +
            (b.sourceSize.toNat + 2)
          < (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
            (b.sourceSize.toNat - s.rdi.toNat)
        have h2 : s2.r14.toNat = s.r14.toNat + 1 := toNat_add_one s.r14 (by omega)
        have h3 : (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3)
            = (b.targetSize.toNat - (s.r14.toNat + 1)) * (b.sourceSize.toNat + 3) +
              (b.sourceSize.toNat + 3) := by
          have h5 : b.targetSize.toNat - (s.r14.toNat + 1) + 1 = b.targetSize.toNat - s.r14.toNat := by
            omega
          rw [← h5, Nat.succ_mul]
        have h4 : s.rdi.toNat = b.sourceSize.toNat := congrArg BitVec.toNat hrdi_eq
        rw [h2, h3, h4]
        omega
      have hinv : inv b M frame y a .LBB23_1 s2 :=
        ⟨hin, hrbx, hr12, hr13, hr15, hsum, hle2, Mj, hmem, habs2, ⟨m, hh⟩⟩
      have hret : (blocksP.cut regionHeads).Returns callee (.block .LBB23_8) s (.next .LBB23_1 s2) := by
        have h1 : (blocksP.cut regionHeads).step (.block .LBB23_8) s = .ok (.goto (.block .LBB23_16) s) := by
          simp only [Blocks.cut, hstep8, regionHeads, Bool.false_eq_true, ↓reduceIte]
        have h2 : (blocksP.cut regionHeads).step (.block .LBB23_16) s = .ok (.goto (.block .LBB23_5) s) := by
          simp only [Blocks.cut, hstep16, regionHeads, Bool.false_eq_true, ↓reduceIte]
        have h3 : (blocksP.cut regionHeads).step (.block .LBB23_5) s = .ok (.goto (.stop .LBB23_1) s2) := by
          simp only [Blocks.cut, hstep5, regionHeads, ↓reduceIte]
        exact Blocks.Returns.goto h1 (Blocks.Returns.goto h2 (Blocks.Returns.goto h3 (Blocks.Returns.ret rfl)))
      refine ⟨.next .LBB23_1 s2, hret, ?_⟩
      show inv b M frame y a .LBB23_1 s2 ∧ rank b .LBB23_1 s2 < rank b .LBB23_8 s ∧
        out b frame y .LBB23_1 s2 = out b frame y .LBB23_8 s
      exact ⟨hinv, hrank, rfl⟩
    · -- the best source is `p`: the call of `.o188`
      have hbestne : best ≠ FlatShuffler.Flat.NONE := by
        intro hb
        exact hnone (by apply UInt64.toBitVec_inj.mp; rw [hrsi, hb]; decide)
      have hmapp : FlatShuffler.Flat.mappable b Mj best = true := by
        have h2 := absorbBest_mappable b Mj s.r14.toBitVec 0 FlatShuffler.Flat.NONE (Or.inl rfl)
          (by rw [← hbest_end]; exact hbestne)
        rwa [← hbest_end] at h2
      have hdropped : FlatShuffler.Flat.get b.dropped best = 0 :=
        (mappable_eq b Mj best).mp hmapp |>.1
      have hdest : FlatShuffler.Flat.get Mj.dest best = FlatShuffler.Flat.NONE :=
        (mappable_eq b Mj best).mp hmapp |>.2
      have hbms : best.toNat < FlatShuffler.maxStackSize := by
        have h2 := absorbBest_bound b Mj s.r14.toBitVec hsrc 0 FlatShuffler.Flat.NONE (Or.inl rfl)
        rw [← hbest_end] at h2
        rcases h2 with h2 | h2
        · exact absurd h2 hbestne
        · exact h2
      have habsmap : FlatShuffler.Flat.absorbFrom b Mj s.r14.toBitVec
          = FlatShuffler.Flat.absorbFrom b (Mj.bind best s.r14.toBitVec) (s.r14.toBitVec + 1) :=
        absorbFrom_map b Mj s.r14.toBitVec best hlt hw hpos hbest_end.symm hbestne hmapp
      have hs1 : (heapOf b Mj frame).storeB (24576 + best * 8) .W64 s.r14.toBitVec
          = .ok (heapOfD b Mj frame best s.r14.toBitVec) :=
        storeB_dest b Mj frame a.policy m best s.r14.toBitVec hbms hh
      obtain ⟨m1, hm1⟩ := Heap.storeB_holds hh hs1
      have hs2 : (heapOfD b Mj frame best s.r14.toBitVec).storeB
            (24576 + s.r14.toBitVec * 8 + 8192) .W64 best
          = .ok (heapOf b (Mj.bind best s.r14.toBitVec) frame) :=
        storeB_pos b Mj frame a.policy m1 best s.r14.toBitVec hbms hjms hm1
      obtain ⟨m2, hm2⟩ := Heap.storeB_holds hm1 hs2
      let s4 : St In2p Heap := { s with rdi := s.rbx, rdx := s.r14, mem := heapOf b (Mj.bind best s.r14.toBitVec) frame, rax := 0 }
      let s5 : St In2p Heap := { s4 with r14 := s4.r14 + 1, rbp := s4.rbp - 1 }
      have hinp : (⟨s.input.policy, s.mem, s.rax, s.r14, s.rsi, s.rbx, s.input.sp - 56 - 8⟩ : mappingBuilderMap.In2p)
          = calleeIn a.policy (heapOf b Mj frame) s.rax best s.r14.toBitVec (s.input.sp - 56 - 8) := by
        simp only [calleeIn, hin, hmem, hrbx, ← hrsi]
      have hcall : callee () (calleeIn a.policy (heapOf b Mj frame) s.rax best s.r14.toBitVec
            (s.input.sp - 56 - 8)) ((0 : UInt64), heapOf b (Mj.bind best s.r14.toBitVec) frame) :=
        calleeRel_done b Mj frame a.policy s.rax best s.r14.toBitVec (s.input.sp - 56 - 8) hbms hjms
          ⟨m, hh⟩ hdropped hdest hpos
      have hstep16 : blocksP.step .LBB23_16 s = .ok (.goto .o188 s) := by
        simp only [blocksP]
        rw [if_neg hnone]
      have hstep188 : blocksP.step .o188 s =
          .ok (.call () (calleeIn a.policy (heapOf b Mj frame) s.rax best s.r14.toBitVec
              (s.input.sp - 56 - 8))
            (fun r => (.o199, { s with rdi := s.rbx, rdx := s.r14, mem := r.2, rax := r.1 }))) := by
        rw [← hinp]
        simp only [blocksP]
      have hstep199 : blocksP.step .o199 s4 = .ok (.goto .LBB23_5 s4) := by
        simp only [blocksP, s4]
        rw [if_pos]
        decide
      have hstep5 : blocksP.step .LBB23_5 s4 = .ok (.goto .LBB23_1 s5) := by
        simp only [blocksP, s5, s4]
      have hsum : s5.rbp + s5.r14 = 0 := by
        apply UInt64.toBitVec_inj.mp
        simp only [s5, s4, UInt64.toBitVec_add, UInt64.toBitVec_sub, UInt64.toBitVec_zero]
        have h2 := congrArg UInt64.toBitVec hrbp
        simp only [UInt64.toBitVec_add, UInt64.toBitVec_zero] at h2
        bv_omega
      have hle2 : s5.r14.toNat ≤ b.targetSize.toNat := by
        show (s.r14 + 1).toNat ≤ b.targetSize.toNat
        rw [toNat_add_one s.r14 (by omega)]
        omega
      have habs2 : FlatShuffler.Flat.absorbFrom b (Mj.bind best s.r14.toBitVec) s5.r14.toBitVec = y := by
        have e : s5.r14.toBitVec = s.r14.toBitVec + 1 := by
          show (s.r14 + 1).toBitVec = s.r14.toBitVec + 1
          simp [UInt64.toBitVec_add]
        rw [e, ← habsmap]
        exact habs
      have hrank : rank b .LBB23_1 s5 < rank b .LBB23_8 s := by
        show (b.targetSize.toNat - s5.r14.toNat) * (b.sourceSize.toNat + 3) +
            (b.sourceSize.toNat + 2)
          < (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
            (b.sourceSize.toNat - s.rdi.toNat)
        have h2 : s5.r14.toNat = s.r14.toNat + 1 := toNat_add_one s.r14 (by omega)
        have h3 : (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3)
            = (b.targetSize.toNat - (s.r14.toNat + 1)) * (b.sourceSize.toNat + 3) +
              (b.sourceSize.toNat + 3) := by
          have h5 : b.targetSize.toNat - (s.r14.toNat + 1) + 1 = b.targetSize.toNat - s.r14.toNat := by
            omega
          rw [← h5, Nat.succ_mul]
        rw [h2, h3]
        omega
      have hinv : inv b M frame y a .LBB23_1 s5 :=
        ⟨hin, hrbx, hr12, hr13, hr15, hsum, hle2, Mj.bind best s.r14.toBitVec, rfl, habs2,
          ⟨m2, hm2⟩⟩
      have hret : (blocksP.cut regionHeads).Returns callee (.block .LBB23_8) s (.next .LBB23_1 s5) := by
        have h1 : (blocksP.cut regionHeads).step (.block .LBB23_8) s = .ok (.goto (.block .LBB23_16) s) := by
          simp only [Blocks.cut, hstep8, regionHeads, Bool.false_eq_true, ↓reduceIte]
        have h2 : (blocksP.cut regionHeads).step (.block .LBB23_16) s = .ok (.goto (.block .o188) s) := by
          simp only [Blocks.cut, hstep16, regionHeads, Bool.false_eq_true, ↓reduceIte]
        have h3 : (blocksP.cut regionHeads).step (.block .o188) s =
            .ok (.call () (calleeIn a.policy (heapOf b Mj frame) s.rax best s.r14.toBitVec
                (s.input.sp - 56 - 8))
              (fun r => (.block .o199, { s with rdi := s.rbx, rdx := s.r14, mem := r.2, rax := r.1 }))) := by
          simp only [Blocks.cut, hstep188, regionHeads, Bool.false_eq_true, ↓reduceIte]
        have h4 : (blocksP.cut regionHeads).step (.block .o199) s4 = .ok (.goto (.block .LBB23_5) s4) := by
          simp only [Blocks.cut, hstep199, regionHeads, Bool.false_eq_true, ↓reduceIte]
        have h5 : (blocksP.cut regionHeads).step (.block .LBB23_5) s4 = .ok (.goto (.stop .LBB23_1) s5) := by
          simp only [Blocks.cut, hstep5, regionHeads, ↓reduceIte]
        exact Blocks.Returns.goto h1 (Blocks.Returns.goto h2
          (Blocks.Returns.call h3 hcall
            (Blocks.Returns.goto h4 (Blocks.Returns.goto h5 (Blocks.Returns.ret rfl)))))
      refine ⟨.next .LBB23_1 s5, hret, ?_⟩
      show inv b M frame y a .LBB23_1 s5 ∧ rank b .LBB23_1 s5 < rank b .LBB23_8 s ∧
        out b frame y .LBB23_1 s5 = out b frame y .LBB23_8 s
      exact ⟨hinv, hrank, rfl⟩
  · -- the loop body: `¬ s.rcx = s.rdi`
    have hdi_ne : s.rdi.toBitVec ≠ b.sourceSize := by
      intro hh2
      apply heq
      apply UInt64.toBitVec_inj.mp
      rw [hrcx]
      exact hh2.symm
    have hdi_lt : s.rdi.toNat < b.sourceSize.toNat := by
      rcases Nat.lt_or_ge s.rdi.toNat b.sourceSize.toNat with h | h
      · exact h
      · have he : s.rdi.toNat = b.sourceSize.toNat := by omega
        have hbv : s.rdi.toBitVec.toNat = s.rdi.toNat := rfl
        exact absurd (BitVec.eq_of_toNat_eq (by rw [hbv, he])) hdi_ne
    have homs : s.rdi.toNat < FlatShuffler.maxStackSize := by omega
    have hdiLtB : s.rdi.toBitVec < b.sourceSize := by
      show s.rdi.toBitVec.toNat < b.sourceSize.toNat
      simpa using hdi_lt
    have hload32 : (heapOf b Mj frame).loadB (s.rbx.toBitVec + 32) .W64 = .ok 20480 := by
      rw [show s.rbx.toBitVec + 32 = 32 from by rw [hrbx]; rfl]
      exact heapOf_loadB_32 b Mj frame a.policy m hh
    have hloaddrop : (heapOf b Mj frame).loadB (20480 + s.rdi.toBitVec * 1) .W8
        = .ok (FlatShuffler.Flat.get b.dropped s.rdi.toBitVec) := by
      rw [show (20480 : BitVec 64) + s.rdi.toBitVec * 1 = 20480 + s.rdi.toBitVec from by bv_omega]
      exact heapOf_loadB_dropped b Mj frame a.policy m hh s.rdi.toBitVec homs
    have hrax' : s.rax.toBitVec = (24576 : BitVec 64) := by rw [hrax]; rfl
    have hloaddest : (heapOf b Mj frame).loadB (s.rax.toBitVec + s.rdi.toBitVec * 8) .W64
        = .ok (FlatShuffler.Flat.get Mj.dest s.rdi.toBitVec) := by
      rw [hrax', show (24576 : BitVec 64) + s.rdi.toBitVec * 8
          = 24576 + 8 * s.rdi.toBitVec from by bv_omega]
      exact heapOf_loadB_dest b Mj frame a.policy m hh s.rdi.toBitVec homs
    have hstep8 : blocksP.step .LBB23_8 s = .ok (.goto .o101 s) := by
      simp only [blocksP]
      rw [if_neg heq]
    have hcut8 : (blocksP.cut regionHeads).step (.block .LBB23_8) s
        = .ok (.goto (.block .o101) s) := cut_goto_block hstep8 rfl
    have hstep101 : blocksP.step .o101 s =
        .ok (if UInt64.ofBitVec (BitVec.zeroExtend 64
            (FlatShuffler.Flat.get b.dropped s.rdi.toBitVec)) = 0
          then .goto .o112 { s with r8 := UInt64.ofBitVec 20480 }
          else .goto .LBB23_10 { s with r8 := UInt64.ofBitVec 20480 }) := by
      simp only [blocksP, hmem, hload32, hloaddrop]
    by_cases hmapp : FlatShuffler.Flat.mappable b Mj s.rdi.toBitVec = true
    · -- `o` is mappable: the dropped byte is zero and the destination is unassigned
      have hd0 : FlatShuffler.Flat.get b.dropped s.rdi.toBitVec = 0 :=
        ((mappable_eq b Mj s.rdi.toBitVec).mp hmapp).1
      have hdest : FlatShuffler.Flat.get Mj.dest s.rdi.toBitVec = FlatShuffler.Flat.NONE :=
        ((mappable_eq b Mj s.rdi.toBitVec).mp hmapp).2
      have hcond1 : UInt64.ofBitVec (BitVec.zeroExtend 64
          (FlatShuffler.Flat.get b.dropped s.rdi.toBitVec)) = 0 := by
        rw [hd0]
        decide
      have hcond2 : UInt64.ofBitVec (FlatShuffler.Flat.get Mj.dest s.rdi.toBitVec)
          = 18446744073709551615 := (ofBitVec_none _).mpr hdest
      let b1 : St In2p Heap := { s with r8 := UInt64.ofBitVec 20480 }
      have hstep101m : blocksP.step .o101 s = .ok (.goto .o112 b1) := by
        rw [hstep101, if_pos hcond1]
      have hstep112 : blocksP.step .o112 b1 = .ok (.goto .LBB23_13 b1) := by
        simp only [blocksP, hmem, hloaddest, b1]
        rw [if_pos hcond2]
      have hcut101m : (blocksP.cut regionHeads).step (.block .o101) s
          = .ok (.goto (.block .o112) b1) := cut_goto_block hstep101m rfl
      have hcut112 : (blocksP.cut regionHeads).step (.block .o112) b1
          = .ok (.goto (.block .LBB23_13) b1) := cut_goto_block hstep112 rfl
      by_cases hnone : s.rsi = 18446744073709551615
      · -- the best source is `NONE`: `.LBB23_13` takes `r8 := rdi`
        have hbestnone : best = FlatShuffler.Flat.NONE := by
          rw [← hrsi, hnone]
          decide
        let b2 : St In2p Heap := { s with r8 := s.rdi }
        let sB : St In2p Heap := { s with r8 := s.rdi, rsi := s.rdi, rdx := s.rdx - 1, rdi := s.rdi + 1 }
        have hstep13 : blocksP.step .LBB23_13 b1 = .ok (.goto .LBB23_11 b2) := by
          simp only [blocksP, b1, b2]
          rw [if_pos hnone]
        have hstep11 : blocksP.step .LBB23_11 b2 = .ok (.goto .LBB23_8 sB) := by
          simp only [blocksP, b2, sB]
        have hcut13 : (blocksP.cut regionHeads).step (.block .LBB23_13) b1
            = .ok (.goto (.block .LBB23_11) b2) := cut_goto_block hstep13 rfl
        have hcut11 : (blocksP.cut regionHeads).step (.block .LBB23_11) b2
            = .ok (.goto (.stop .LBB23_8) sB) := cut_goto_stop hstep11 rfl
        have hret : (blocksP.cut regionHeads).Returns callee (.block .LBB23_8) s
            (.next .LBB23_8 sB) :=
          Blocks.Returns.goto hcut8 (Blocks.Returns.goto hcut101m (Blocks.Returns.goto hcut112
            (Blocks.Returns.goto hcut13 (Blocks.Returns.goto hcut11 (Blocks.Returns.ret rfl)))))
        refine ⟨.next .LBB23_8 sB, hret, ?_⟩
        show inv b M frame y a .LBB23_8 sB ∧ rank b .LBB23_8 sB < rank b .LBB23_8 s ∧
          out b frame y .LBB23_8 sB = out b frame y .LBB23_8 s
        refine ⟨?_, ?_, ?_⟩
        · refine ⟨hin, hrbx, hr12, hr13, hr15, hrbp, hrax, hrcx, ?_, ?_, hr14lt, ?_⟩
          · apply UInt64.toBitVec_inj.mp
            simp only [sB, UInt64.toBitVec_add, UInt64.toBitVec_sub]
            have h2 := congrArg UInt64.toBitVec hrdx
            simp only [UInt64.toBitVec_add] at h2
            bv_omega
          · show (s.rdi + 1).toNat ≤ b.sourceSize.toNat
            rw [toNat_add_one s.rdi (by omega)]
            omega
          · refine ⟨Mj, sB.rsi.toBitVec, hmem, habs, rfl, ?_, hw, hpos, ⟨m, hh⟩⟩
            have ht := absorbBest_take b Mj s.r14.toBitVec s.rdi.toBitVec best hdiLtB hmapp (by
              rw [Bool.or_eq_true]
              left
              rw [hbestnone]
              rfl)
            rw [show sB.rdi.toBitVec = s.rdi.toBitVec + 1 from by
                  show (s.rdi + 1).toBitVec = s.rdi.toBitVec + 1
                  rw [UInt64.toBitVec_add]
                  rfl,
                show sB.rsi.toBitVec = s.rdi.toBitVec from rfl]
            exact ht.symm.trans hbest
        · show (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
              (b.sourceSize.toNat - (s.rdi + 1).toNat)
            < (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
              (b.sourceSize.toNat - s.rdi.toNat)
          rw [toNat_add_one s.rdi (by omega)]
          omega
        · show ((0 : UInt64), heapOf b y.2 frame) = (0, heapOf b y.2 frame)
          rfl
      · -- the best source is a stack offset: `.LBB23_13` then `.o142`
        have hbestne : best ≠ FlatShuffler.Flat.NONE := by
          intro hb
          refine hnone (UInt64.toBitVec_inj.mp ?_)
          rw [hrsi, hb]
          decide
        let d1 : UInt64 := if s.r14 ≤ s.rsi then s.rsi - s.r14 else s.r14 - s.rsi
        let d2 : UInt64 := if s.rdi ≤ s.r14 then s.rdx else s.rdi + s.rbp
        let c1 : St In2p Heap := { s with r8 := s.rdi }
        let c2 : St In2p Heap := { s with r8 := s.rsi, r9 := d2, r10 := d1 }
        let c3 : St In2p Heap := { s with r8 := s.rdi, r9 := d2, r10 := d1 }
        let sC1 : St In2p Heap := { s with r8 := s.rsi, r9 := d2, r10 := d1, rsi := s.rsi, rdx := s.rdx - 1, rdi := s.rdi + 1 }
        let sC2 : St In2p Heap := { s with r8 := s.rdi, r9 := d2, r10 := d1, rsi := s.rdi, rdx := s.rdx - 1, rdi := s.rdi + 1 }
        have hstep13 : blocksP.step .LBB23_13 b1 = .ok (.goto .o142 c1) := by
          simp only [blocksP, b1, c1]
          rw [if_neg hnone]
        have hstep142 : blocksP.step .o142 c1
            = .ok (if d1 ≤ d2 then .goto .LBB23_11 c2 else .goto .o177 c2) := by
          simp only [blocksP, c1, c2, d1, d2]
        have hcut13 : (blocksP.cut regionHeads).step (.block .LBB23_13) b1
            = .ok (.goto (.block .o142) c1) := cut_goto_block hstep13 rfl
        have hd1 : d1.toBitVec = FlatShuffler.Flat.absDiff best s.r14.toBitVec := by
          simp only [d1]
          by_cases h : s.r14 ≤ s.rsi
          · have h'' : s.r14.toBitVec ≤ best := by rw [← hrsi]; exact h
            rw [if_pos h, UInt64.toBitVec_sub, hrsi, ← absDiff_first, if_pos h'']
          · have h'' : ¬ (s.r14.toBitVec ≤ best) := by rw [← hrsi]; exact h
            rw [if_neg h, UInt64.toBitVec_sub, hrsi, ← absDiff_first, if_neg h'']
        have hrdxb : s.rdx.toBitVec = s.r14.toBitVec - s.rdi.toBitVec := by
          have h2 := congrArg UInt64.toBitVec hrdx
          simp only [UInt64.toBitVec_add] at h2
          bv_omega
        have hrbb : s.rbp.toBitVec = 0 - s.r14.toBitVec := by
          have h2 := congrArg UInt64.toBitVec hrbp
          simp only [UInt64.toBitVec_add, UInt64.toBitVec_zero] at h2
          bv_omega
        have hd2 : d2.toBitVec = FlatShuffler.Flat.absDiff s.rdi.toBitVec s.r14.toBitVec := by
          simp only [d2]
          by_cases h : s.rdi ≤ s.r14
          · have h'' : s.rdi.toBitVec ≤ s.r14.toBitVec := h
            rw [if_pos h, ← absDiff_second, if_pos h'', hrdxb]
          · have h'' : ¬ (s.rdi.toBitVec ≤ s.r14.toBitVec) := h
            rw [if_neg h, UInt64.toBitVec_add, ← absDiff_second, if_neg h'', hrbb]
        have hiff : (d1 ≤ d2) ↔ (FlatShuffler.Flat.absDiff best s.r14.toBitVec ≤
            FlatShuffler.Flat.absDiff s.rdi.toBitVec s.r14.toBitVec) := by
          show d1.toBitVec ≤ d2.toBitVec ↔
            (FlatShuffler.Flat.absDiff best s.r14.toBitVec ≤
              FlatShuffler.Flat.absDiff s.rdi.toBitVec s.r14.toBitVec)
          rw [hd1, hd2]
        by_cases hc : FlatShuffler.Flat.absDiff best s.r14.toBitVec ≤
            FlatShuffler.Flat.absDiff s.rdi.toBitVec s.r14.toBitVec
        · -- keep the current best: `.LBB23_11` with `r8 := rsi`
          have hcond : d1 ≤ d2 := hiff.mpr hc
          have hstep142t : blocksP.step .o142 c1 = .ok (.goto .LBB23_11 c2) := by
            rw [hstep142, if_pos hcond]
          have hcut142t : (blocksP.cut regionHeads).step (.block .o142) c1
              = .ok (.goto (.block .LBB23_11) c2) := cut_goto_block hstep142t rfl
          have hstep11 : blocksP.step .LBB23_11 c2 = .ok (.goto .LBB23_8 sC1) := by
            simp only [blocksP, c2, sC1]
          have hcut11 : (blocksP.cut regionHeads).step (.block .LBB23_11) c2
              = .ok (.goto (.stop .LBB23_8) sC1) := cut_goto_stop hstep11 rfl
          have hret : (blocksP.cut regionHeads).Returns callee (.block .LBB23_8) s
              (.next .LBB23_8 sC1) :=
            Blocks.Returns.goto hcut8 (Blocks.Returns.goto hcut101m (Blocks.Returns.goto hcut112
              (Blocks.Returns.goto hcut13 (Blocks.Returns.goto hcut142t (Blocks.Returns.goto hcut11
                (Blocks.Returns.ret rfl))))))
          have hcf : (best = FlatShuffler.Flat.NONE ||
              FlatShuffler.Flat.absDiff s.rdi.toBitVec s.r14.toBitVec <
                FlatShuffler.Flat.absDiff best s.r14.toBitVec) = false := by
            rw [Bool.or_eq_false_iff]
            refine ⟨?_, ?_⟩
            · rw [Bool.eq_false_iff]
              simpa using hbestne
            · rw [decide_eq_false_iff_not]
              bv_omega
          have ht := absorbBest_keep b Mj s.r14.toBitVec s.rdi.toBitVec best hdiLtB hmapp hcf
          refine ⟨.next .LBB23_8 sC1, hret, ?_⟩
          show inv b M frame y a .LBB23_8 sC1 ∧ rank b .LBB23_8 sC1 < rank b .LBB23_8 s ∧
            out b frame y .LBB23_8 sC1 = out b frame y .LBB23_8 s
          refine ⟨?_, ?_, ?_⟩
          · refine ⟨hin, hrbx, hr12, hr13, hr15, hrbp, hrax, hrcx, ?_, ?_, hr14lt, ?_⟩
            · apply UInt64.toBitVec_inj.mp
              simp only [sC1, UInt64.toBitVec_add, UInt64.toBitVec_sub]
              have h2 := congrArg UInt64.toBitVec hrdx
              simp only [UInt64.toBitVec_add] at h2
              bv_omega
            · show (s.rdi + 1).toNat ≤ b.sourceSize.toNat
              rw [toNat_add_one s.rdi (by omega)]
              omega
            · refine ⟨Mj, sC1.rsi.toBitVec, hmem, habs, rfl, ?_, hw, hpos, ⟨m, hh⟩⟩
              rw [show sC1.rdi.toBitVec = s.rdi.toBitVec + 1 from by
                    show (s.rdi + 1).toBitVec = s.rdi.toBitVec + 1
                    rw [UInt64.toBitVec_add]
                    rfl,
                  show sC1.rsi.toBitVec = s.rsi.toBitVec from rfl, hrsi]
              exact ht.symm.trans hbest
          · show (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
                (b.sourceSize.toNat - (s.rdi + 1).toNat)
              < (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
                (b.sourceSize.toNat - s.rdi.toNat)
            rw [toNat_add_one s.rdi (by omega)]
            omega
          · show ((0 : UInt64), heapOf b y.2 frame) = (0, heapOf b y.2 frame)
            rfl
        · -- take the new source: `.o177` and `.LBB23_11` with `r8 := rdi`
          have hcond : ¬ (d1 ≤ d2) := fun h => hc (hiff.mp h)
          have hstep142f : blocksP.step .o142 c1 = .ok (.goto .o177 c2) := by
            rw [hstep142, if_neg hcond]
          have hcut142f : (blocksP.cut regionHeads).step (.block .o142) c1
              = .ok (.goto (.block .o177) c2) := cut_goto_block hstep142f rfl
          have hstep177 : blocksP.step .o177 c2 = .ok (.goto .LBB23_11 c3) := by
            simp only [blocksP, c2, c3]
          have hcut177 : (blocksP.cut regionHeads).step (.block .o177) c2
              = .ok (.goto (.block .LBB23_11) c3) := cut_goto_block hstep177 rfl
          have hstep11 : blocksP.step .LBB23_11 c3 = .ok (.goto .LBB23_8 sC2) := by
            simp only [blocksP, c3, sC2]
          have hcut11 : (blocksP.cut regionHeads).step (.block .LBB23_11) c3
              = .ok (.goto (.stop .LBB23_8) sC2) := cut_goto_stop hstep11 rfl
          have hret : (blocksP.cut regionHeads).Returns callee (.block .LBB23_8) s
              (.next .LBB23_8 sC2) :=
            Blocks.Returns.goto hcut8 (Blocks.Returns.goto hcut101m (Blocks.Returns.goto hcut112
              (Blocks.Returns.goto hcut13 (Blocks.Returns.goto hcut142f (Blocks.Returns.goto hcut177
                (Blocks.Returns.goto hcut11 (Blocks.Returns.ret rfl)))))))
          have hct : (best = FlatShuffler.Flat.NONE ||
              FlatShuffler.Flat.absDiff s.rdi.toBitVec s.r14.toBitVec <
                FlatShuffler.Flat.absDiff best s.r14.toBitVec) = true := by
            rw [Bool.or_eq_true]
            right
            rw [decide_eq_true_iff]
            bv_omega
          have ht := absorbBest_take b Mj s.r14.toBitVec s.rdi.toBitVec best hdiLtB hmapp hct
          refine ⟨.next .LBB23_8 sC2, hret, ?_⟩
          show inv b M frame y a .LBB23_8 sC2 ∧ rank b .LBB23_8 sC2 < rank b .LBB23_8 s ∧
            out b frame y .LBB23_8 sC2 = out b frame y .LBB23_8 s
          refine ⟨?_, ?_, ?_⟩
          · refine ⟨hin, hrbx, hr12, hr13, hr15, hrbp, hrax, hrcx, ?_, ?_, hr14lt, ?_⟩
            · apply UInt64.toBitVec_inj.mp
              simp only [sC2, UInt64.toBitVec_add, UInt64.toBitVec_sub]
              have h2 := congrArg UInt64.toBitVec hrdx
              simp only [UInt64.toBitVec_add] at h2
              bv_omega
            · show (s.rdi + 1).toNat ≤ b.sourceSize.toNat
              rw [toNat_add_one s.rdi (by omega)]
              omega
            · refine ⟨Mj, sC2.rsi.toBitVec, hmem, habs, rfl, ?_, hw, hpos, ⟨m, hh⟩⟩
              rw [show sC2.rdi.toBitVec = s.rdi.toBitVec + 1 from by
                    show (s.rdi + 1).toBitVec = s.rdi.toBitVec + 1
                    rw [UInt64.toBitVec_add]
                    rfl,
                  show sC2.rsi.toBitVec = s.rdi.toBitVec from rfl]
              exact ht.symm.trans hbest
          · show (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
                (b.sourceSize.toNat - (s.rdi + 1).toNat)
              < (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
                (b.sourceSize.toNat - s.rdi.toNat)
            rw [toNat_add_one s.rdi (by omega)]
            omega
          · show ((0 : UInt64), heapOf b y.2 frame) = (0, heapOf b y.2 frame)
            rfl
    · -- `o` is not mappable: `.LBB23_10` then `.LBB23_11`
      have hmappf : FlatShuffler.Flat.mappable b Mj s.rdi.toBitVec = false := by
        rw [Bool.eq_false_iff]
        exact hmapp
      let a1 : St In2p Heap := { s with r8 := UInt64.ofBitVec 20480 }
      let a2 : St In2p Heap := { s with r8 := s.rsi }
      let sA : St In2p Heap := { s with r8 := s.rsi, rsi := s.rsi, rdx := s.rdx - 1, rdi := s.rdi + 1 }
      have hstep10 : blocksP.step .LBB23_10 a1 = .ok (.goto .LBB23_11 a2) := by
        simp only [blocksP, a1, a2]
      have hstep11 : blocksP.step .LBB23_11 a2 = .ok (.goto .LBB23_8 sA) := by
        simp only [blocksP, a2, sA]
      have hcut10 : (blocksP.cut regionHeads).step (.block .LBB23_10) a1
          = .ok (.goto (.block .LBB23_11) a2) := cut_goto_block hstep10 rfl
      have hcut11 : (blocksP.cut regionHeads).step (.block .LBB23_11) a2
          = .ok (.goto (.stop .LBB23_8) sA) := cut_goto_stop hstep11 rfl
      have hrest : (blocksP.cut regionHeads).Returns callee (.block .LBB23_10) a1
          (.next .LBB23_8 sA) :=
        Blocks.Returns.goto hcut10 (Blocks.Returns.goto hcut11 (Blocks.Returns.ret rfl))
      refine ⟨.next .LBB23_8 sA, ?_, ?_⟩
      · by_cases hd : UInt64.ofBitVec (BitVec.zeroExtend 64
            (FlatShuffler.Flat.get b.dropped s.rdi.toBitVec)) = 0
        · have hd0 : FlatShuffler.Flat.get b.dropped s.rdi.toBitVec = 0 :=
            (ofBitVec_zeroExtend_zero _).mp hd
          have hdestne : FlatShuffler.Flat.get Mj.dest s.rdi.toBitVec ≠ FlatShuffler.Flat.NONE := by
            intro hc'
            exact hmapp ((mappable_eq b Mj s.rdi.toBitVec).mpr ⟨hd0, hc'⟩)
          have hcond2 : ¬ (UInt64.ofBitVec (FlatShuffler.Flat.get Mj.dest s.rdi.toBitVec)
              = 18446744073709551615) := by
            intro hc'
            exact hdestne ((ofBitVec_none _).mp hc')
          have hstep101a : blocksP.step .o101 s = .ok (.goto .o112 a1) := by
            rw [hstep101, if_pos hd]
          have hstep112a : blocksP.step .o112 a1 = .ok (.goto .LBB23_10 a1) := by
            simp only [blocksP, hmem, hloaddest, a1]
            rw [if_neg hcond2]
          have hc1 : (blocksP.cut regionHeads).step (.block .o101) s
              = .ok (.goto (.block .o112) a1) := cut_goto_block hstep101a rfl
          have hc2 : (blocksP.cut regionHeads).step (.block .o112) a1
              = .ok (.goto (.block .LBB23_10) a1) := cut_goto_block hstep112a rfl
          exact Blocks.Returns.goto hcut8 (Blocks.Returns.goto hc1 (Blocks.Returns.goto hc2 hrest))
        · have hstep101a : blocksP.step .o101 s = .ok (.goto .LBB23_10 a1) := by
            rw [hstep101, if_neg hd]
          have hc1 : (blocksP.cut regionHeads).step (.block .o101) s
              = .ok (.goto (.block .LBB23_10) a1) := cut_goto_block hstep101a rfl
          exact Blocks.Returns.goto hcut8 (Blocks.Returns.goto hc1 hrest)
      · show inv b M frame y a .LBB23_8 sA ∧ rank b .LBB23_8 sA < rank b .LBB23_8 s ∧
          out b frame y .LBB23_8 sA = out b frame y .LBB23_8 s
        refine ⟨?_, ?_, ?_⟩
        · refine ⟨hin, hrbx, hr12, hr13, hr15, hrbp, hrax, hrcx, ?_, ?_, hr14lt, ?_⟩
          · apply UInt64.toBitVec_inj.mp
            simp only [sA, UInt64.toBitVec_add, UInt64.toBitVec_sub]
            have h2 := congrArg UInt64.toBitVec hrdx
            simp only [UInt64.toBitVec_add] at h2
            bv_omega
          · show (s.rdi + 1).toNat ≤ b.sourceSize.toNat
            rw [toNat_add_one s.rdi (by omega)]
            omega
          · refine ⟨Mj, sA.rsi.toBitVec, hmem, habs, rfl, ?_, hw, hpos, ⟨m, hh⟩⟩
            have ht := absorbBest_not_mappable b Mj s.r14.toBitVec s.rdi.toBitVec best hdiLtB hmappf
            rw [show sA.rdi.toBitVec = s.rdi.toBitVec + 1 from by
                  show (s.rdi + 1).toBitVec = s.rdi.toBitVec + 1
                  rw [UInt64.toBitVec_add]
                  rfl,
                show sA.rsi.toBitVec = s.rsi.toBitVec from rfl, hrsi]
            exact ht.symm.trans hbest
        · show (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
              (b.sourceSize.toNat - (s.rdi + 1).toNat)
            < (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) +
              (b.sourceSize.toNat - s.rdi.toNat)
          rw [toNat_add_one s.rdi (by omega)]
          omega
        · show ((0 : UInt64), heapOf b y.2 frame) = (0, heapOf b y.2 frame)
          rfl
theorem regions : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (a : In2p) y, SimArr frame b M a → Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.run b M = some y →
  ∃ (inv : Lbl → St In2p Heap → Prop) (rank : Lbl → St In2p Heap → Nat) (out : Lbl → St In2p Heap → (UInt64 × Heap)),
    inv .entry (initP a) ∧
    (∀ l s, inv l s → ∃ e, (blocksP.cut regionHeads).Returns (fun _ => (fun (x : mappingBuilderMap.In2p) (r : UInt64 × Heap) => Lift.Sem.CallFrame.PermLift (fun k k' => mappingBuilderMap.l2p.returns { x with heap := k } (r.1, k')) x.heap r.2)) (.block l) s e ∧
      Lift.Sem.CutExit.Progress inv rank out l s e) ∧
    (Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.result b M y) y) = [⟨.W16, (out .entry (initP a)).1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP b M ++ frame ∧ ∀ m, (out .entry (initP a)).2.Holds a.policy m → Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.post b M Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf a.policy ⟨.W16, (out .entry (initP a)).1.toBitVec.setWidth 16⟩ m) := by
  intro frame b M a y hs hy
  have hy' : y = FlatShuffler.Flat.absorbSurplus b M := by
    have h : some (FlatShuffler.Flat.absorbSurplus b M) = some y := by
      simpa [Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.run] using hy
    exact (Option.some.inj h).symm
  refine ⟨inv b M frame y a, rank b, out b frame y, rfl, ?_, ?_⟩
  · intro l s hl
    cases l with
    | entry => exact region_entry b M frame y a hs hy' s hl
    | LBB23_1 => exact region_outer b M frame y a hs hy' s hl
    | LBB23_8 => exact region_inner b M frame y a hs hy' s hl
    | _ => exact hl.elim
  · exact final_clause b M frame y a hs hy'
end regions.skel_proof
theorem regions : regions.skel_statement := @regions.skel_proof.regions
theorem refines_l3 : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping), Refines (fun (_ : Unit) => SimArr frame b M) (fun _ a y r => Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.result b M y) y) = [⟨.W16, r.1.toBitVec.setWidth 16⟩] ∧ a.heap = objsP b M ++ frame ∧ ∀ m, r.2.Holds a.policy m → Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.post b M Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.envOf a.policy ⟨.W16, r.1.toBitVec.setWidth 16⟩ m) (fun _ y => Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.run b M = some y) l2p.returns := by
  intro frame b M
  intro _ a y hs hy
  obtain ⟨inv, rank, out, hstart, hsteps, hresult⟩ := regions frame b M a y hs hy
  exact ⟨out .entry (initP a), blocksP.cut_loop regionHeads _ inv rank out hsteps .entry (initP a) hstart, hresult⟩
theorem above_l3 : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (pol : CpuPolicy), Above l2p (l3 frame b M pol) := by
  intro frame b M pol
  refine Above.ofRefines (fun _ _ _ => SimArr frame b M) _ (fun _ _ => refines_l3 frame b M) ?_ ?_
  · rintro policy _ s ⟨hpol, hh, hperm, hC, he, hq0, harea, hbelow, hroom⟩
    exact ⟨⟨policy, objsP b M ++ frame, s.data.regs.rax, s.data.regs.rbx, s.data.regs.rdi, s.data.regs.rbp, s.data.regs.r12, s.data.regs.r13, s.data.regs.r14, s.data.regs.r15, s.data.regs.rsp.toBitVec⟩, ⟨rfl, hh, hperm, he, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, harea, hbelow, hroom, rfl⟩, ⟨hC, hq0, rfl, ⟨_, hh⟩⟩⟩
  · rintro policy _ a s y r t ⟨hp, -⟩ ⟨hbp, -⟩ ⟨hv, hain, hm⟩ ⟨hex, hrax, hh, hfr⟩
    rw [hain] at hfr
    exact ⟨hex, by rw [hrax]; exact hv, by rw [hrax, ← hp, ← hbp]; exact hm _ hh, hfr⟩
theorem total : ∀ (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping), Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.C b M → ∃ y, Lift.Shuffler.Internal.Proposed.AbsorbSurplusStatement.run b M = some y := by intros; exact ⟨_, rfl⟩
theorem decompiles : ∀ (frame : Heap) (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (pol : CpuPolicy), Decompiles Lift.Shuffler.L1.step (l3 frame b M pol) := by intros; apply Decompiles.above (decompiles_l2.above above_l2p); apply above_l3

theorem heapOf_loadB_dest (b : FlatShuffler.Flat.Builder) (M : FlatShuffler.Flat.Mapping) (frame : Heap)
    (policy : CpuPolicy) (m : DataMem) (hh : (heapOf b M frame).Holds policy m) (i : BitVec 64)
    (hi : i.toNat < FlatShuffler.maxStackSize) :
    (heapOf b M frame).loadB (24576 + 8 * i) .W64 = .ok (FlatShuffler.Flat.get M.dest i) := by
  have h := Heap.load_words64 hh (dest_mem b M frame) (i := i) (by simpa using hi)
  rw [Heap.loadB_of_load h]
  simp only [FlatShuffler.Flat.get, dif_pos hi]
  congr 1


  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ Heap.Permits policy a.heap ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderAbsorbSurplusPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rbx = a.rbx ∧ s.data.regs.rdi = a.rdi ∧ s.data.regs.rbp = a.rbp ∧ s.data.regs.r12 = a.r12 ∧ s.data.regs.r13 = a.r13 ∧ s.data.regs.r14 = a.r14 ∧ s.data.regs.r15 = a.r15 ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ (∀ b, SysV.Below s.data.regs.rsp.toBitVec 64 b → ¬ Covered a.heap b) ∧ SysV.StackRoom policy s 64 ∧ a.sp = s.data.regs.rsp.toBitVec

def callLift (z : St skel_call.In2p Heap) : St In2p Heap :=
  { input := callInput z.input, rax := z.rax, rbx := z.rbx, rcx := z.rcx, rdx := z.rdx, rsi := z.rsi,
    rdi := z.rdi, rbp := z.rbp, r8 := z.r8, r9 := z.r9, r10 := z.r10, r12 := z.r12, r13 := z.r13,
    r14 := z.r14, r15 := z.r15, mem := z.mem }

abbrev CallLoNext := Next Lbl (St skel_call.In2p Heap) (UInt64 × Heap) Unit (fun _ => mappingBuilderMap.In2p) (fun _ => UInt64 × Heap)
abbrev CallHiNext := Next Lbl (St In2p Heap) (UInt64 × Heap) Unit (fun _ => mappingBuilderMap.In2p) (fun _ => UInt64 × Heap)
abbrev CallLoRes := Res CallLoNext
abbrev CallHiRes := Res CallHiNext

def callMapNext : CallLoRes → CallHiRes
  | .ok (.goto l s) => .ok (.goto l (callLift s))
  | .ok (.ret r) => .ok (.ret r)
  | .ok (.call f x k) => .ok (.call f x fun y => ((k y).1, callLift (k y).2))
  | .stuck w => .stuck w
  | .noFuel => .noFuel

theorem callMapNext_goto (l : Lbl) (s : St skel_call.In2p Heap) :
    callMapNext (.ok (.goto l s)) = .ok (.goto l (callLift s)) := rfl
theorem callMapNext_ret (r : UInt64 × Heap) : callMapNext (.ok (.ret r)) = .ok (.ret r) := rfl
theorem callMapNext_call (f : Unit) (x : mappingBuilderMap.In2p) (k : (UInt64 × Heap) → Lbl × St skel_call.In2p Heap) :
    callMapNext (.ok (.call f x k)) = .ok (.call f x fun y => ((k y).1, callLift (k y).2)) := rfl
theorem callMapNext_stuck (w : String) : callMapNext (.stuck w) = .stuck w := rfl
theorem callMapNext_noFuel : callMapNext (.noFuel) = .noFuel := rfl
theorem callMapNext_ite (c : Prop) [Decidable c] (a b : CallLoNext) :
    callMapNext (.ok (if c then a else b)) = if c then callMapNext (.ok a) else callMapNext (.ok b) := by
  by_cases h : c <;> simp [h]

theorem callStepMap (l : Lbl) (z : St skel_call.In2p Heap) :
    blocksP.step l (callLift z) = callMapNext (skel_call.blocksP.step l z) := by
  cases l <;> simp only [blocksP, skel_call.blocksP, callLift, callInput, callMapNext_ite,
    callMapNext_goto, callMapNext_ret, callMapNext_call] <;>
    (repeat' split) <;> rfl

theorem callSimOfMapNext {l : Lbl} {z : St skel_call.In2p Heap} {n : CallHiNext}
    (h : callMapNext (skel_call.blocksP.step l z) = .ok n) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ r q => r = q) (fun x y => x = callLift y)
      (fun r q => r = q) n (skel_call.blocksP.step l z) := by
  cases hstep : skel_call.blocksP.step l z with
  | ok m =>
    rw [hstep] at h
    cases m with
    | goto l' s =>
      rw [callMapNext_goto] at h
      cases h
      exact ⟨s, rfl, rfl⟩
    | ret r =>
      rw [callMapNext_ret] at h
      cases h
      exact ⟨r, rfl, rfl⟩
    | call f x k =>
      rw [callMapNext_call] at h
      cases h
      exact ⟨x, k, rfl, rfl, fun y y' hy => by rw [hy]; exact ⟨rfl, rfl⟩⟩
  | stuck w => rw [hstep] at h; rw [callMapNext_stuck] at h; cases h
  | noFuel => rw [hstep] at h; rw [callMapNext_noFuel] at h; cases h
theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : (UInt64 × Heap)) (q : (UInt64 × Heap)) => r = q) l2p.returns skel_call.l2p.returns := by
  intro xh xl yh hsim hret
  subst xh
  obtain ⟨r', hret', hr⟩ := Blocks.Returns.sim (fun _ a b => a = b) (fun _ _ _ r q => r = q)
    (fun x y => x = callLift y) (fun r q => r = q)
    (fun f xh xl yh hx hy => ⟨yh, hx ▸ hy, rfl⟩)
    (fun l x y n hs hstep => by
      cases hs
      rw [callStepMap l y] at hstep
      exact callSimOfMapNext hstep)
    hret (show initP (callInput xl) = callLift (skel_call.initP xl) from rfl)
  exact ⟨r', hret', hr⟩
end call_bridge.skel_proof

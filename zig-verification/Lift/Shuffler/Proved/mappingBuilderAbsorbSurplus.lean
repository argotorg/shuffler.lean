              then .goto .o84 { s with rax := 24576 } else .goto .LBB23_5 { s with rax := 24576 }) := by
        simp only [blocksP, hmem, hload48, hloadpos, ofBitVec_none]
        rfl
      by_cases hpos : FlatShuffler.Flat.get Mj.pos s.r14.toBitVec = FlatShuffler.Flat.NONE
      · -- the source slot at `j` is unassigned: `.o84` and the inner loop
        let s3 : St In2p Heap := { s with rax := 24576, rdi := 0, rsi := s.r13, rdx := s.r14, rcx := UInt64.ofBitVec b.sourceSize }
        have hstep5 : blocksP.step .o84 { s with rax := 24576 } = .ok (.goto .LBB23_8 s3) := by

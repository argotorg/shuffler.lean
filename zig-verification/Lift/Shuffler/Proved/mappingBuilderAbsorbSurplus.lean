structure In2p where
  policy : CpuPolicy
  heap : Heap
  rax : UInt64
  rdx : UInt64
  rsi : UInt64
  rdi : UInt64
  sp : BitVec 64 := 0

def initP (a : In2p) : St In2p Heap := ⟨a, a.rax, 0, a.heap⟩

def blocksP : Leaf Lbl (St In2p Heap) (UInt64 × Heap) where
  step
    | .entry, x =>
      match x.mem.loadB (x.input.rdi.toBitVec + 32) .W64 with
      | .ok v =>
        match x.mem.loadB (v + x.input.rsi.toBitVec * 1) .W8 with
        | .ok v1 =>
          .ok (if UInt64.ofBitVec (BitVec.zeroExtend 64 v1) = 0 then .goto .o14 { x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := UInt64.ofBitVec v } else .goto .LBB25_4 { x with rax := (x.rax &&& 18446744073709486080) ||| (1 &&& 65535), rcx := UInt64.ofBitVec v })
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o14, x =>
      match x.mem.loadB (x.input.rdi.toBitVec + 48) .W64 with
      | .ok v =>
        match x.mem.loadB (v + x.input.rsi.toBitVec * 8) .W64 with
        | .ok v1 =>
          .ok (if UInt64.ofBitVec v1 = 18446744073709551615 then .goto .o25 { x with rcx := UInt64.ofBitVec v } else .goto .LBB25_4 { x with rcx := UInt64.ofBitVec v })
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o25, x =>
      match x.mem.loadB (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64 with
      | .ok v =>
        .ok (if UInt64.ofBitVec v = 18446744073709551615 then .goto .o36 x else .goto .LBB25_4 x)
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o36, x =>
      match x.mem.storeB (x.rcx.toBitVec + x.input.rsi.toBitVec * 8) .W64 x.input.rdx.toBitVec with
      | .ok h =>
        match h.storeB (x.rcx.toBitVec + x.input.rdx.toBitVec * 8 + 8192) .W64 x.input.rsi.toBitVec with
        | .ok h1 =>
          .ok (.goto .LBB25_4 { x with rax := 0, mem := h1 })
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .LBB25_4, x =>
      .ok (.ret (x.rax, x.mem))

def postP (a : In2p) (r : UInt64 × Heap) (s t : MachineState) : Prop :=
  SysV.Exit s t ∧ t.data.regs.rax = r.1 ∧ r.2.Holds a.policy t.data.dmem ∧ ∀ b, ¬ a.heap.Owned b → t.data.dmem.get? b = s.data.dmem.get? b

def l2p : Model In2p (UInt64 × Heap) where
  rep policy a s := a.policy = policy ∧ a.heap.Holds policy s.data.dmem ∧ Heap.Permits policy a.heap ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.mappingBuilderMapPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rdx = a.rdx ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi ∧ (∀ b, Private s.data.regs.rsp.toBitVec b → ¬ Covered a.heap b) ∧ a.sp = s.data.regs.rsp.toBitVec
  returns a r := blocksP.Returns noCall .entry (initP a) r
  post := postP


def SimIn (a : In2p) (b : In2) : Prop := a.policy = b.policy ∧ a.rax = b.rax ∧ a.rdx = b.rdx ∧ a.rsi = b.rsi ∧ a.rdi = b.rdi ∧ a.heap.Holds b.policy b.mem ∧ Heap.Permits b.policy a.heap ∧ (∀ c, Private b.sp c → ¬ Covered a.heap c) ∧ a.sp = b.sp

def SimSt (x : St In2p Heap) (y : St In2 DataMem) : Prop := SimIn x.input y.input ∧ x.rax = y.rax ∧ x.rcx = y.rcx ∧ x.mem.Holds y.input.policy y.mem ∧ ∀ b, ¬ x.input.heap.Owned b → y.mem.get? b = y.input.mem.get? b

def SimOut (x : In2p) (y : In2) (r : UInt64 × Heap) (r' : UInt64 × DataMem) : Prop := r.1 = r'.1 ∧ r.2.Holds x.policy r'.2 ∧ ∀ b, ¬ x.heap.Owned b → r'.2.get? b = y.mem.get? b

abbrev skel_row_types.refines_l2p : Prop := Refines SimIn (fun a b r r' => SimOut a b r r') l2p.returns l2.returns

abbrev skel_row_types.shape : Prop := ∀ a r, l2p.returns a r → Lift.Sem.CallArm.ShapeB a.heap r.2


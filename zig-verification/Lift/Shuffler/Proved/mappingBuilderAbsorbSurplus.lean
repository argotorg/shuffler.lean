        have hrank : rank b .LBB23_1 s2 < rank b .LBB23_1 s := by
          show (b.targetSize.toNat - s2.r14.toNat) * (b.sourceSize.toNat + 3) + (b.sourceSize.toNat + 2)
            < (b.targetSize.toNat - s.r14.toNat) * (b.sourceSize.toNat + 3) + (b.sourceSize.toNat + 2)
          have h2 : s2.r14.toNat = s.r14.toNat + 1 := toNat_add_one s.r14 (by omega)
          rw [h2]
          have h3 : b.targetSize.toNat - (s.r14.toNat + 1) < b.targetSize.toNat - s.r14.toNat := by omega
          exact Nat.add_lt_add_right (Nat.mul_lt_mul_of_pos_right h3 (by omega)) _
        have hinv2 : inv b M frame y a .LBB23_1 s2 :=
          ⟨hin, hrbx, hr12, hr13, hr15, hsum, hle2, Mj, hmem, habs2, ⟨m, hh⟩⟩
        have hret2 : (blocksP.cut regionHeads).Returns callee (.block .LBB23_1) s (.next .LBB23_1 s2) := by
          have h1 : (blocksP.cut regionHeads).step (.block .LBB23_1) s = .ok (.goto (.block .o46) s) := by
            simp only [Blocks.cut, hstep1, regionHeads, Bool.false_eq_true, ↓reduceIte]
          have h2 : (blocksP.cut regionHeads).step (.block .o46) s = .ok (.goto (.block .o69) { s with rax := X }) := by
            simp only [Blocks.cut, hstep3, regionHeads, Bool.false_eq_true, ↓reduceIte]
          have h3 : (blocksP.cut regionHeads).step (.block .o69) { s with rax := X } = .ok (.goto (.block .LBB23_5) { s with rax := 24576 }) := by
            simp only [Blocks.cut, hstep4, if_neg hpos, regionHeads, Bool.false_eq_true, ↓reduceIte]
          have h4 : (blocksP.cut regionHeads).step (.block .LBB23_5) { s with rax := 24576 } = .ok (.goto (.stop .LBB23_1) s2) := by
            simp only [Blocks.cut, hstep5, regionHeads, ↓reduceIte]
          exact Blocks.Returns.goto h1 (Blocks.Returns.goto h2 (Blocks.Returns.goto h3 (Blocks.Returns.goto h4 (Blocks.Returns.ret rfl))))
        refine ⟨.next .LBB23_1 s2, hret2, ?_⟩
        show inv b M frame y a .LBB23_1 s2 ∧ rank b .LBB23_1 s2 < rank b .LBB23_1 s ∧

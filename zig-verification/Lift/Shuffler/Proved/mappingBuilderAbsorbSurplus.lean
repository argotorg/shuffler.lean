      let X : UInt64 := UInt64.ofBitVec (BitVec.zeroExtend 64 (FlatShuffler.Flat.get b.target s.r14.toBitVec).kind) <<< (32 : UInt64)
      let s2 : St In2p Heap := { s with rax := X, r14 := s.r14 + 1, rbp := s.rbp - 1 }
      have hstep3 : blocksP.step .o46 s = .ok (.goto .LBB23_5 { s with rax := X }) := by
        rw [hstep2]
        simp only [hkindne, ↓reduceIte]
        rfl
      have hstep4 : blocksP.step .LBB23_5 { s with rax := X } = .ok (.goto .LBB23_1 s2) := by
        simp only [blocksP, s2]
      have hsum : s2.rbp + s2.r14 = 0 := by
        apply UInt64.toBitVec_inj.mp
        simp only [s2, UInt64.toBitVec_add, UInt64.toBitVec_sub, UInt64.toBitVec_zero]
        have h := congrArg UInt64.toBitVec hrbp
        simp only [UInt64.toBitVec_add, UInt64.toBitVec_zero] at h
        bv_omega
      have hle2 : s2.r14.toNat ≤ b.targetSize.toNat := by
        show (s.r14 + 1).toNat ≤ b.targetSize.toNat
        rw [toNat_add_one s.r14 (by omega)]
        omega
      have habs2 : FlatShuffler.Flat.absorbFrom b Mj s2.r14.toBitVec = y := by
        have e : s2.r14.toBitVec = s.r14.toBitVec + 1 := by

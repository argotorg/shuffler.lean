/-- The callee keeps the frame: a run of its blocks from a heap that is a permutation of the own
objects and the frame leaves a heap that still has the frame. -/
theorem inner_frame (policy : CpuPolicy) (b : FlatShuffler.Flat.Builder) (frame : Heap)
    (k : mappingBuilderMap.In2p) (r : UInt64 × Heap)
    (hrdi : k.rdi.toBitVec = 0) (hrsi : k.rsi.toNat < 1024) (hrdx : k.rdx.toNat < 1024)
    (xs ys : List (BitVec 64)) (hlenx : xs.length = 1024) (hleny : ys.length = 1024)
    (hperm : (ownHeap b xs ys ++ frame).Perm k.heap)
    (hm : ∃ m, k.heap.Holds policy m)
    (hr : mappingBuilderMap.l2p.returns k r) :
    InnerRes policy b frame r := by
  refine Lift.Sem.CallArm.Blocks.Returns.inv (I := InnerInv policy b frame) (Q := InnerRes policy b frame)
    (block := inner_block policy b frame) hr ?_
  exact ⟨xs, ys, ⟨hlenx, hleny, hperm, hm, hrdi, hrsi, hrdx, by simp⟩⟩

/-- The labels of the outer loop body, where the loop counter is strictly below the bound. -/
def OuterStrict (l : Lbl) : Prop :=
  l = .o46 ∨ l = .o69 ∨ l = .o84 ∨ l = .LBB23_8 ∨ l = .o101 ∨ l = .o112 ∨ l = .LBB23_10 ∨
    l = .LBB23_11 ∨ l = .LBB23_13 ∨ l = .o142 ∨ l = .o177 ∨ l = .LBB23_16 ∨ l = .o188 ∨
    l = .o199 ∨ l = .LBB23_5 ∨ l = .LBB23_18

/-- The labels of the inner loop body, where `rdi < rcx`. -/
def InnerLoop (l : Lbl) : Prop :=
  l = .o101 ∨ l = .o112 ∨ l = .LBB23_10 ∨ l = .LBB23_11 ∨ l = .LBB23_13 ∨ l = .o142 ∨ l = .o177

/-- The labels where `r8` is one of the two bounded counters. -/
def R8Ok (l : Lbl) : Prop :=
  l = .LBB23_11 ∨ l = .o142 ∨ l = .o177

/-- The data of the invariant of the caller's run. -/
structure OuterData (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder)
    (xs ys : List (BitVec 64)) (l : Lbl) (x : St skel_call.In2p Heap) : Prop where
  hxs : xs.length = 1024
  hys : ys.length = 1024
  perm : (ownHeap b xs ys ++ frame).Perm x.mem
  holds : ∃ m, x.mem.Holds a.policy m
  inp : x.input = a
  rbx : x.rbx.toBitVec = 0
  r13 : x.r13 = 18446744073709551615
  r14le : x.r14.toNat ≤ x.r15.toNat
  r15le : x.r15.toNat ≤ 1024
  rdiLe : x.rdi.toNat ≤ x.rcx.toNat
  rcxLe : x.rcx.toNat ≤ 1024
  rsib : x.rsi = 18446744073709551615 ∨ x.rsi.toNat < 1024
  rsiLt : l = .o188 → x.rsi.toNat < 1024
  r8ok : R8Ok l → (x.r8 = 18446744073709551615 ∨ x.r8.toNat < 1024)
  rdiLt : InnerLoop l → x.rdi.toNat < x.rcx.toNat
  strict : OuterStrict l → x.r14.toNat < x.r15.toNat

def OuterInv (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder) :
    Lbl → St skel_call.In2p Heap → Prop
  | .entry, x => x = skel_call.initP a
  | l, x => ∃ xs ys, OuterData a frame b xs ys l x

/-- The result of the caller's run. -/
structure OuterRes (a : skel_call.In2p) (frame : Heap) (b : FlatShuffler.Flat.Builder)
    (r : UInt64 × Heap) : Prop where
  perm : ∃ xs ys, xs.length = 1024 ∧ ys.length = 1024 ∧ (ownHeap b xs ys ++ frame).Perm r.2

/-- The callee relation of the caller's model. -/
def CallRel : ∀ _ : Unit, mappingBuilderMap.In2p → (UInt64 × Heap) → Prop :=
  fun _ x y => Lift.Sem.CallFrame.PermLift
    (fun k k' => mappingBuilderMap.l2p.returns {x with heap := k} (y.1, k')) x.heap y.2

theorem size_toNat_le {w : BitVec 64} (h : w ≤ BitVec.ofNat 64 FlatShuffler.maxStackSize) :
    w.toNat ≤ 1024 := by
  have h1 := BitVec.le_def.mp h
  have h2 : (BitVec.ofNat 64 FlatShuffler.maxStackSize).toNat = 1024 := by
    simp [FlatShuffler.maxStackSize]
  omega

theorem succ_toNat_le {x y : UInt64} (h1 : x.toNat < y.toNat) (h2 : y.toNat ≤ 1024) :
    (x + 1).toNat ≤ y.toNat := by
  rw [UInt64.toNat_add]
  have h1' : (1 : UInt64).toNat = 1 := rfl
  rw [h1']
  have h3 : x.toNat + 1 < 2 ^ 64 := by omega
  rw [Nat.mod_eq_of_lt h3]
  omega


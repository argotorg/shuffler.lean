        have habs2 : FlatShuffler.Flat.absorbFrom b Mj s2.r14.toBitVec = y := by
          have e : s2.r14.toBitVec = s.r14.toBitVec + 1 := by
            show (s.r14 + 1).toBitVec = s.r14.toBitVec + 1

    · -- the target slot is not a wildcard: `.LBB23_5` and back to `.LBB23_1`
      have hw : FlatShuffler.Flat.isWildcardTarget b s.r14.toBitVec = false := by
        rw [Bool.eq_false_iff]
        intro h
        exact hk ((isWildcardTarget_eq b s.r14.toBitVec).mp h)

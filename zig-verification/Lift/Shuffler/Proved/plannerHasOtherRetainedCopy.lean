theorem final : Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.HasOtherRetainedCopyStatement := by
  intro pl M dn offset hC policy ra s heB
  have he := heB.1
  have hrep : (l3 [] pl M dn offset).rep policy () s :=
    ⟨Lift.Sem.Final.holds he, Lift.Sem.Final.permits heB, hC, Lift.Sem.Bridge.Fn.Entry.sysV (lo := Lift.Shuffler.shufflePC) (hi := Lift.Shuffler.shufflerEndPC) he (by decide +kernel) (by decide +kernel), Lift.Sem.Final.bv64 he.inRegs 0 rfl, Lift.Sem.Final.bv64 he.inRegs 1 rfl, Lift.Sem.Final.bv64 he.inRegs 2 rfl, Lift.Sem.Final.bv64 he.inRegs 3 rfl, Lift.Sem.Final.not_covered he 64 rfl, Lift.Sem.Final.hidden he 64 rfl, Lift.Sem.Final.room he 64 rfl⟩
  refine (contract [] pl M dn offset policy s hrep hC).mono ?_
  rintro t ⟨y, ⟨hexit, hmem, hrel⟩, hrun⟩
  refine Lift.Sem.Final.ret he 64 rfl hexit (fun b _ hb => hmem b hb) ?_
  simp only [Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.post, Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.fn]

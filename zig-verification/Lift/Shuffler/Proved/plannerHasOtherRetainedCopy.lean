theorem mem_dest_arr (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word) :
    Obj.words 16384 false .W64 M.dest.toList ∈ objsP pl M dn offset ++ frame := by

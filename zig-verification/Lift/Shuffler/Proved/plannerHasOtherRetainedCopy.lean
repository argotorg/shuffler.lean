def SimIn (a : In2p) (b : In2) : Prop := a.rax = b.rax ∧ a.rsi = b.rsi ∧ a.rdi = b.rdi ∧ a.heap.Holds b.policy b.mem ∧ Heap.Permits b.policy a.heap


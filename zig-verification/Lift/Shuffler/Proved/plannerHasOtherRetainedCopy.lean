/-- The entry load of the L2⁺ block: the source size of the planner. -/
theorem load_entry (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (a : In2p) (hrdi : a.rdi.toBitVec = 0) (hheap : a.heap = objsP pl M dn offset ++ frame) :
    a.heap.loadB (a.rdi.toBitVec + 8) .W64 = .ok pl.sourceSize := by
  rw [hheap, hrdi]
  simp only [objsP, Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.objects,
    List.map_cons, Heap.loadB, Heap.load, Obj.get, Cell.get, toObj, toCell]
  rfl
theorem refines_l3 : ∀ (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping) (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word), Refines (fun (_ : Unit) => SimArr frame pl M dn offset) (fun _ _ y r => Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.result pl M dn offset y) y) = [⟨.W8, r.toBitVec.setWidth 8⟩]) (fun _ y => Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.run pl M dn offset = some y) l2p.returns := by
  intro frame pl M dn offset
  intro _ a y hs hy
  have hs' : SimArr frame pl M dn offset a := hs
  simp only [SimArr] at hs
  obtain ⟨-, hrdi, -, -, -, hheap, -⟩ := hs
  have hloadB := load_entry frame pl M dn offset a hrdi hheap
  obtain ⟨r, hres, hrel⟩ := loop.LBB22_1 frame pl M dn offset a y pl.sourceSize hs' hloadB hy
  refine ⟨r, ?_, hrel⟩
  refine .goto ?_ hres
  simp only [blocksP, initP, hloadB]
end refines_l3.skel_proof

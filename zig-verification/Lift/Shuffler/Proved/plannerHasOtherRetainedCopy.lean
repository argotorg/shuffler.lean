theorem mem_dn_arr (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word) :

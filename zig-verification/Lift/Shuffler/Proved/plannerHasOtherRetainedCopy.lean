open FlatShuffler

theorem flatMap_singleton_map {α β : Type} (f : α → β) (l : List α) :
    l.flatMap (fun a => [f a]) = l.map f := by
  induction l with
  | nil => rfl
  | cons a l ih => simp [List.flatMap_cons, ih]

theorem encode_vector64 (v : Vector (BitVec 64) FlatShuffler.maxStackSize) :
    Lift.Trusted.Encode.encode v = v.toList.map (fun x => (⟨.W64, x⟩ : Lift.Trusted.Field)) := by
  show v.toList.flatMap _ = _
  exact flatMap_singleton_map _ _

theorem encode_vector8 (v : Vector (BitVec 8) FlatShuffler.maxStackSize) :
    Lift.Trusted.Encode.encode v = v.toList.map (fun x => (⟨.W8, x⟩ : Lift.Trusted.Field)) := by
  show v.toList.flatMap _ = _
  exact flatMap_singleton_map _ _

def srcCells (pl : FlatShuffler.Flat.Planner) : List (BitVec 64) :=
  (List.range FlatShuffler.maxStackSize).map fun i =>
    Lift.Shuffler.Internal.Proposed.Layout.slotWord (pl.source.toList.getD i default) (0 : BitVec 16)

theorem objsP_eq (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word) :
    objsP pl M dn offset =
      [Obj.words 0 false .W64 [4096, pl.sourceSize],
       Obj.words 4096 false .W64 (srcCells pl),
       Obj.words 16384 false .W64 M.dest.toList,
       Obj.words 24576 false .W8 dn.toList] := by
  simp only [objsP, Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.objects,
    List.map_cons, List.map_nil, srcCells, encode_vector64, encode_vector8,
    Lift.Sem.Bridge.toObj, Lift.Sem.Bridge.toCell, Obj.words, List.map_map, Function.comp_def]

theorem mem_src_head (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word) :
    Obj.words 0 false .W64 [4096, pl.sourceSize] ∈ objsP pl M dn offset ++ frame := by
  rw [objsP_eq]; simp

theorem mem_src_arr (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word) :
    Obj.words 4096 false .W64 (srcCells pl) ∈ objsP pl M dn offset ++ frame := by

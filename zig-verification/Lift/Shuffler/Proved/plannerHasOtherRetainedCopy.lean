    (x &&& 18446744073709551360) ||| ((if ¬ (a ≤ b) then 1 else 0) &&& 255)
      = { toBitVec := x.toBitVec.replaceLow (BitVec.ofNat 8 (cfSub a b).toNat) } := by
  rw [setb_cf_eq a b]
  exact setcc_field x (¬ (a ≤ b))

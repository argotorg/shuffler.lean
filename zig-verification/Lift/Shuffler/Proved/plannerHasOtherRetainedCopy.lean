  rep policy a s := a.heap.Holds policy s.data.dmem ∧ Heap.Permits policy a.heap ∧ SysV.Entry policy Lift.Shuffler.shufflePC Lift.Shuffler.shufflerEndPC Lift.Shuffler.plannerIsRetainedPC s ∧ s.data.regs.rax = a.rax ∧ s.data.regs.rsi = a.rsi ∧ s.data.regs.rdi = a.rdi

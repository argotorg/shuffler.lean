theorem refines_l2p : plannerIsRetained.skel_row_types.refines_l2p := by
  intro a b r hs h
  refine Blocks.Returns.sim (fun f => f.elim) (fun f => f.elim) SimSt Eq (fun f => f.elim) ?_ h
    (y := init b) ⟨hs, hs.1⟩
  rintro l x y n ⟨⟨hin_rax, hin_rsi, hin_rdi, hh, hperm⟩, hst_rax⟩ hstep
  cases l with
  | entry =>
    simp only [blocksP] at hstep
    split at hstep
    · rename_i v hl0
      simp only [Res.ok.injEq] at hstep
      subst hstep
      have hr0 := Heap.loadB_sound hh hperm hl0
      rw [hin_rdi, hin_rsi] at hr0
      exact ⟨((y.rax &&& 18446744073709551360) ||| ((if ¬ (UInt64.ofBitVec v = 18446744073709551615) then 1 else 0) &&& 255)), by simp only [blocks, hr0], by simp only [hst_rax]⟩
    · cases hstep
    · cases hstep

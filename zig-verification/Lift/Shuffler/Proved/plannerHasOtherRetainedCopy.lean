theorem LBB22_1 : ∀ (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping) (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word) (a : In2p) (y : (Bool)) (v_rbp : BitVec 64), SimArr frame pl M dn offset a → a.heap.loadB (a.rdi.toBitVec + 8) .W64 = .ok v_rbp → Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.run pl M dn offset = some y → ∃ r, blocksP.Returns (fun _ => (fun (x : plannerIsRetained.In2p) (r : UInt64) => plannerIsRetained.l2p.returns x r)) .LBB22_1 ⟨a, a.rax, a.rcx, a.rcx, a.rsi, a.rdi, (UInt64.ofBitVec v_rbp), a.rdi, 0, a.rdx, a.rsi, a.heap⟩ r ∧ Lift.Trusted.Encode.encode ((fun y => Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.result pl M dn offset y) y) = [⟨.W8, r.toBitVec.setWidth 8⟩] := by
  intro frame pl M dn offset a y v_rbp hs hload hy
  obtain ⟨hC, hrdi, hrsi, hrdx, hrcx, hheap, pol, m, hHolds⟩ := hs
  obtain ⟨hsize, hoff⟩ := hC
  rw [hheap] at hHolds
  have hsrc : v_rbp = pl.sourceSize := by
    have h1 : a.heap.loadB (a.rdi.toBitVec + 8) .W64 = .ok pl.sourceSize := by
      rw [hheap, hrdi]
      simpa using loadB_srcSize frame pl M dn offset hHolds
    rw [h1] at hload
    cases hload
    rfl
  have hy' : y = FlatShuffler.Flat.hasOtherRetainedCopy pl M dn offset := by
    have h := hy
    unfold Lift.Shuffler.Internal.Proposed.HasOtherRetainedCopyStatement.run at h
    exact (Option.some.inj h).symm
  let x0 : St In2p Heap := ⟨a, a.rax, a.rcx, a.rcx, a.rsi, a.rdi, UInt64.ofBitVec v_rbp, a.rdi, 0, a.rdx, a.rsi, a.heap⟩
  refine ⟨Out a pl M dn offset x0, ?_, ?_⟩
  · apply blocksP'_Returns
    exact loop_returns frame pl M dn offset a pol m hHolds hrdi hrsi hrdx hrcx hsize hoff hheap x0
      (by simp [Inv, x0, hsrc, neFrom_zero])
  · change ([⟨.W8, if y then 1 else 0⟩] : List Lift.Trusted.Field) =
      ([⟨.W8, (Out a pl M dn offset x0).toBitVec.setWidth 8⟩] : List Lift.Trusted.Field)
    rw [hy']
    congr 1
    rw [show (Out a pl M dn offset x0).toBitVec.setWidth 8 =
        (if FlatShuffler.Flat.otherFrom pl M dn offset 0 then 1 else 0) by
      simp only [Out, x0]
      exact low_byte_or _ _]
    rfl
end loop

theorem bridgeBlock (l : Lbl) (x : St In2p Heap)
    (n : Lift.Sem.Next Lbl (St In2p Heap) UInt64 Unit (fun _ => plannerIsRetained.In2p) (fun _ => UInt64))
    (ht : blocksP.step l x = .ok n) :
    Lift.Sem.Next.Sim (fun _ (p q : plannerIsRetained.In2p) => p = q) (fun _ _ _ u v => u = v)
      (fun p q => q = bridgeSt p) (fun r q => r = q) n (skel_call.blocksP.step l (bridgeSt x)) := by
  cases l <;> simp only [blocksP] at ht
  all_goals (repeat' (first | split at ht | cases ht))
  all_goals (simp only [skel_call.blocksP, bridgeSt, bridgeIn, Lift.Sem.Next.Sim])
  all_goals (first | exact ⟨_, rfl, rfl⟩ | exact ⟨_, rfl⟩ | rfl | (refine ⟨_, _, rfl, rfl, ?_⟩; intro y y' hyy; subst hyy; exact ⟨rfl, rfl⟩) | simp_all)
theorem call_bridge : Refines (fun a b => a = callInput b) (fun _ _ (r : UInt64) (q : UInt64) => r = q) l2p.returns skel_call.l2p.returns := by
  intro a b r hab hr
  subst hab
  obtain ⟨q, hq, hqr⟩ :=
    Lift.Sem.Blocks.Returns.sim
      (simX := fun _ (p q : plannerIsRetained.In2p) => p = q)
      (simY := fun _ _ _ (u v : UInt64) => u = v)
      (sim := fun (p : St In2p Heap) (q : St skel_call.In2p Heap) => q = bridgeSt p)
      (simR := fun (r q : UInt64) => r = q)
      (callee := by intro f x y v hx hc; cases hx; exact ⟨v, hc, rfl⟩)
      (block := by
        intro l x y n hs ht
        subst hs
        exact bridgeBlock l x n ht)
      hr
      (show skel_call.initP b = bridgeSt (initP (callInput b)) from rfl)
  exact ⟨q, hq, hqr⟩

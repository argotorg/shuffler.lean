theorem above_l3 : ∀ (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping) (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word), Above l2p (l3 frame pl M dn offset) := by
  intro frame pl M dn offset
  refine Above.ofRefines (fun _ _ _ => SimArr frame pl M dn offset) _ (fun _ _ => refines_l3 frame pl M dn offset) ?_ ?_
  · rintro policy _ s ⟨hh, hperm, hC, he, hq0, hq1, hq2, hq3, harea, hbelow, hroom⟩
    exact ⟨⟨objsP pl M dn offset ++ frame, s.data.regs.rax, s.data.regs.rbx, s.data.regs.rcx, s.data.regs.rdx, s.data.regs.rsi, s.data.regs.rdi, s.data.regs.rbp, s.data.regs.r12, s.data.regs.r13, s.data.regs.r14, s.data.regs.r15, s.data.regs.rsp.toBitVec⟩, ⟨hh, hperm, he, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, harea, hbelow, hroom, rfl⟩, ⟨hC, hq0, hq1, hq2, hq3, rfl, ⟨policy, _, hh⟩⟩⟩
  · rintro _ _ _ _ _ _ _ _ _ hr ⟨hx, hm, ht⟩
    exact ⟨hx, hm, by rw [ht]; exact hr⟩

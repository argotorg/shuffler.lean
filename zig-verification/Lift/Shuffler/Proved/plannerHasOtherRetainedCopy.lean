/-- The carry flag of `cmpq %rbp, %r13` (`r13 - rbp`), in the form of the composed site. -/
abbrev cfSub (a b : UInt64) : Bool :=
  ((((↑(18446744073709551616 - a.toNat) : Int) + (↑b.toNat : Int)) % (18446744073709551616 : Int)) != ((↑b.toNat : Int) - ↑a.toNat))

/-- The carry flag of `cmpq %rbp, %r13` (`r13 - rbp`) is `r13 < rbp`. -/
theorem setb_cf_eq (a b : UInt64) : cfSub a b = decide (¬ (a ≤ b)) := by
  show ((b.toBitVec - a.toBitVec).unsigned != b.toBitVec.unsigned - a.toBitVec.unsigned) = decide (¬ (a ≤ b))
  rw [BitVec.unsigned_sub_bne, Bool.eq_iff_iff, BitVec.usubOverflow_eq_true_iff, decide_eq_true_eq]
  simp only [UInt64.toNat_toBitVec, UInt64.le_iff_toNat_le]
  omega

/-- The low byte of `rax` after `setb %al`. -/
theorem setcc_field (x : UInt64) (c : Prop) [Decidable c] :
    (x &&& 18446744073709551360) ||| ((if c then 1 else 0) &&& 255)
      = { toBitVec := x.toBitVec.replaceLow (BitVec.ofNat 8 (decide c).toNat) } := by
  by_cases h : c
  · rw [if_pos h, decide_eq_true h]
    apply UInt64.toBitVec_inj.mp
    simp only [UInt64.toBitVec_and, UInt64.toBitVec_or, UInt64.toBitVec_ofNat]
    simp only [BitVec.replaceLow, BitVec.drop]
    bv_decide
  · rw [if_neg h, decide_eq_false h]
    apply UInt64.toBitVec_inj.mp
    simp only [UInt64.toBitVec_and, UInt64.toBitVec_or, UInt64.toBitVec_ofNat]
    simp only [BitVec.replaceLow, BitVec.drop]
    bv_decide

/-- The field equation of the exit of the epilogue after `cmpq %rbp, %r13; setb %al`. -/

abbrev BridgeHiNext := Next Lbl (St In2p Heap) UInt64 Unit (fun _ => plannerIsRetained.In2p) (fun _ => UInt64)
abbrev BridgeLoNext := Next Lbl (St skel_call.In2p Heap) UInt64 Unit (fun _ => plannerIsRetained.In2p) (fun _ => UInt64)

def bridgeNext : BridgeLoNext → BridgeHiNext
  | .goto l z => .goto l (bridgeState z)
  | .ret r => .ret r
  | .call f x k => .call f x (fun r => ((k r).1, bridgeState (k r).2))

def bridgeRes : Res BridgeLoNext → Res BridgeHiNext
  | .ok n => .ok (bridgeNext n)
  | .stuck why => .stuck why
  | .noFuel => .noFuel

theorem bridgeState_related (z : St skel_call.In2p Heap) : callState (bridgeState z) z := by
  simp [callState, bridgeState]

theorem bridge_related_eq (x : St In2p Heap) (z : St skel_call.In2p Heap)
    (h : callState x z) : x = bridgeState z := by
  cases x
  cases z
  simp_all [callState, bridgeState, callInput]

theorem bridgeNext_related (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      callState (fun (r : UInt64) (q : UInt64) => r = q) (bridgeNext n) (.ok n) := by
  cases n with
  | goto l z => exact ⟨z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, k, rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩

theorem bridgeNext_related_rev (n : BridgeLoNext) :
    Next.Sim (fun _ a b => a = b) (fun _ _ _ a b => a = b)
      (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q) n (.ok (bridgeNext n)) := by
  cases n with
  | goto l z => exact ⟨bridgeState z, rfl, bridgeState_related z⟩
  | ret r => exact ⟨r, rfl, rfl⟩
  | call f x k =>
    refine ⟨x, (fun r => ((k r).1, bridgeState (k r).2)), rfl, rfl, ?_⟩
    intro y y' hy
    cases hy
    exact ⟨rfl, bridgeState_related _⟩


theorem bridge_step_eq (l : Lbl) (z : St skel_call.In2p Heap) :
    blocksP.step l (bridgeState z) = bridgeRes (skel_call.blocksP.step l z) := by
  cases l with
  | entry => exact bridge_step_eq_entry z
  | LBB22_1 => exact bridge_step_eq_LBB22_1 z
  | o35 => exact bridge_step_eq_o35 z
  | o40 => exact bridge_step_eq_o40 z
  | o58 => exact bridge_step_eq_o58 z
  | o69 => exact bridge_step_eq_o69 z
  | o73 => exact bridge_step_eq_o73 z
  | LBB22_6 => exact bridge_step_eq_LBB22_6 z
  | LBB22_7 => exact bridge_step_eq_LBB22_7 z
theorem call_bridge_rev : Refines (fun a b => b = callInput a) (fun _ _ (q : UInt64) (r : UInt64) => r = q) skel_call.l2p.returns l2p.returns := by
  intro a b r hab hr
  subst b
  exact Lift.Sem.Blocks.Returns.sim (fun _ x y => x = y) (fun _ _ _ u v => u = v)
    (fun z x => callState x z) (fun (q : UInt64) (r : UInt64) => r = q)
    (by intro f x y v h hc; cases h; exact ⟨v, hc, rfl⟩)
    (by
      intro l z x n hs ht
      have hx := bridge_related_eq x z hs
      subst x
      rw [bridge_step_eq, ht]
      exact bridgeNext_related_rev n)
    hr (by simp [callState, initP, skel_call.initP, callInput])
end call_bridge_rev.skel_proof
theorem call_bridge_rev : call_bridge_rev.skel_statement := @call_bridge_rev.skel_proof.call_bridge_rev
theorem call_summary : callSummary := by
  intro frame pl M dn offset a y hs hy
  obtain ⟨r, hr, hrel⟩ := refines_l3 frame pl M dn offset () (callInput a) y hs hy
  obtain ⟨q, hq, hmap⟩ := call_bridge (callInput a) a r rfl hr
  exact ⟨q, hq, ⟨r, hrel, hmap⟩⟩
end skel_semantic
end Skel.Gen.Level3.Shuffler.plannerHasOtherRetainedCopy

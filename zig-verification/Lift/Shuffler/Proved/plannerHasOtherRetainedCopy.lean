theorem loadB_ptr (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    {policy : CpuPolicy} {m : DataMem} (hh : (objsP pl M dn offset ++ frame).Holds policy m) :
    (objsP pl M dn offset ++ frame).loadB 0 .W64 = .ok 4096 := by
  apply Heap.loadB_of_load
  have := Heap.load_words64_mul (h := objsP pl M dn offset ++ frame) hh
    (mem_src_head frame pl M dn offset) (i := 0) (by simp)
  simpa using this

theorem loadB_srcSize (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    {policy : CpuPolicy} {m : DataMem} (hh : (objsP pl M dn offset ++ frame).Holds policy m) :
    (objsP pl M dn offset ++ frame).loadB 8 .W64 = .ok pl.sourceSize := by
  apply Heap.loadB_of_load
  have := Heap.load_words64_mul (h := objsP pl M dn offset ++ frame) hh
    (mem_src_head frame pl M dn offset) (i := 1) (by simp)

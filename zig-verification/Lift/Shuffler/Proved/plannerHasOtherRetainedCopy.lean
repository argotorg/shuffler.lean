theorem slotWord_low48_iff (s1 s2 : FlatShuffler.StackSlot) (p1 p2 : BitVec 16) :
    (Lift.Shuffler.Internal.Proposed.Layout.slotWord s1 p1 &&& 281474976710655 =
      Lift.Shuffler.Internal.Proposed.Layout.slotWord s2 p2 &&& 281474976710655) ↔ s1 = s2 := by
  obtain ⟨p1', k1, o1⟩ := s1
  obtain ⟨p2', k2, o2⟩ := s2
  simp only [Lift.Shuffler.Internal.Proposed.Layout.slotWord, Lift.Shuffler.Zig.Slot.join,
    Lift.Pilot.Slot.word, FlatShuffler.StackSlot.mk.injEq]
  constructor
  · intro h
    refine ⟨?_, ?_, ?_⟩ <;> bv_decide
  · intro h
    obtain ⟨rfl, rfl, rfl⟩ := h
    bv_decide

theorem get_dest_eq (M : FlatShuffler.Flat.Mapping) (p : FlatShuffler.Word) :
    FlatShuffler.Flat.get M.dest p = M.dest.toList.getD p.toNat 0 := by
  unfold FlatShuffler.Flat.get
  split
  · rename_i h
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by simpa using h)]
    simp
  · rename_i h
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simpa using h)]
    rfl

theorem isRetained_eq_false (M : FlatShuffler.Flat.Mapping) (p : FlatShuffler.Word)
    (h : FlatShuffler.Flat.get M.dest p = FlatShuffler.Flat.NONE) :
    FlatShuffler.Flat.isRetained M p = false := by
  simp [FlatShuffler.Flat.isRetained, h]

theorem otherFrom_step (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (hlt : o < pl.sourceSize)
    (hne : o ≠ offset)
    (hslot : FlatShuffler.Flat.get pl.source o = FlatShuffler.Flat.get pl.source offset)
    (hret : FlatShuffler.Flat.isRetained M o = false) :
    FlatShuffler.Flat.otherFrom pl M dn offset o = FlatShuffler.Flat.otherFrom pl M dn offset (o + 1) := by
  rw [FlatShuffler.Flat.otherFrom.eq_1, dite_eq_left hlt, if_neg]
  simp [hne, hslot, hret]

theorem low_bit_and (x : UInt64) (c : Bool) :
    1 &&& (((x &&& 18446744073709551360) ||| ((if c then 1 else 0) &&& 255)).toUInt8.toUInt64) = 0 ↔
      c = false := by
  cases c <;> simp only [Bool.false_eq_true, if_true, if_false, Bool.true_eq_false] <;> bv_decide

theorem toNat_add_one (x : UInt64) (h : x.toNat + 1 < 2 ^ 64) :
    (x + 1).toNat = x.toNat + 1 := by
  simp only [UInt64.toNat_add, UInt64.toNat_one]
  exact Nat.mod_eq_of_lt h

/-- Some `j < n` has `UInt64.ofNat j ≠ rbx`. -/
def neFrom (rbx : UInt64) : Nat → Bool
  | 0 => false
  | n + 1 => neFrom rbx n || (UInt64.ofNat n != rbx)

@[simp] theorem neFrom_zero (rbx : UInt64) : neFrom rbx 0 = false := rfl

@[simp] theorem neFrom_succ (rbx : UInt64) (n : Nat) :
    neFrom rbx (n + 1) = (neFrom rbx n || (UInt64.ofNat n != rbx)) := rfl

theorem neFrom_self (rbx : UInt64) (n : Nat) (h : UInt64.ofNat n = rbx) :
    neFrom rbx (n + 1) = neFrom rbx n := by
  subst h
  simp

theorem neFrom_true (rbx : UInt64) (n : Nat) (h : UInt64.ofNat n ≠ rbx) :
    neFrom rbx (n + 1) = true := by
  rw [neFrom_succ]
  simp [h]

theorem neFrom_mono (rbx : UInt64) {n m : Nat} (h : n ≤ m) (h1 : neFrom rbx n = true) :
    neFrom rbx m = true := by
  induction m with
  | zero =>
    have hn : n = 0 := by omega
    subst hn
    rw [neFrom_zero] at h1
    cases h1
  | succ k ih =>
    rcases Nat.lt_or_ge n (k + 1) with hlt | hge
    · rw [neFrom_succ, ih (by omega)]
      rfl
    · have hn : n = k + 1 := by omega
      subst hn
      exact h1

theorem get_source_eq (pl : FlatShuffler.Flat.Planner) (p : FlatShuffler.Word) :
    FlatShuffler.Flat.get pl.source p = pl.source.toList.getD p.toNat default := by
  unfold FlatShuffler.Flat.get
  split
  · rename_i h
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by simpa using h)]
    simp
  · rename_i h
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simpa using h)]
    rfl

theorem otherFrom_not_lt (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : ¬ o < pl.sourceSize) :
    FlatShuffler.Flat.otherFrom pl M dn offset o = false := by
  rw [FlatShuffler.Flat.otherFrom.eq_1, dite_eq_right h]

theorem otherFrom_step_self (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (h : offset < pl.sourceSize) :
    FlatShuffler.Flat.otherFrom pl M dn offset offset =
      FlatShuffler.Flat.otherFrom pl M dn offset (offset + 1) := by
  rw [FlatShuffler.Flat.otherFrom.eq_1, dite_eq_left h, if_neg]
  simp

theorem otherFrom_step_slot_ne (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : o < pl.sourceSize)
    (hs : FlatShuffler.Flat.get pl.source o ≠ FlatShuffler.Flat.get pl.source offset) :
    FlatShuffler.Flat.otherFrom pl M dn offset o =
      FlatShuffler.Flat.otherFrom pl M dn offset (o + 1) := by
  have hc : decide (FlatShuffler.Flat.get pl.source o = FlatShuffler.Flat.get pl.source offset) = false :=
    by simpa using hs
  rw [FlatShuffler.Flat.otherFrom.eq_1, dite_eq_left h, hc]
  simp

theorem otherFrom_step_not_retained (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : o < pl.sourceSize) (hr : FlatShuffler.Flat.isRetained M o = false) :
    FlatShuffler.Flat.otherFrom pl M dn offset o =
      FlatShuffler.Flat.otherFrom pl M dn offset (o + 1) := by
  rw [FlatShuffler.Flat.otherFrom.eq_1, dite_eq_left h, hr]
  simp

theorem otherFrom_step_dn_ne (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : o < pl.sourceSize) (hd : FlatShuffler.Flat.get dn o ≠ 0) :
    FlatShuffler.Flat.otherFrom pl M dn offset o =
      FlatShuffler.Flat.otherFrom pl M dn offset (o + 1) := by
  have hc : decide (FlatShuffler.Flat.get dn o = 0) = false := by simpa using hd
  rw [FlatShuffler.Flat.otherFrom.eq_1, dite_eq_left h, hc]
  simp

theorem get_dn_eq (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (p : FlatShuffler.Word) :
    FlatShuffler.Flat.get dn p = dn.toList.getD p.toNat 0 := by
  unfold FlatShuffler.Flat.get
  split
  · rename_i h
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by simpa using h)]
    simp
  · rename_i h
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simpa using h)]
    rfl

theorem otherFrom_true (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset o : FlatShuffler.Word)
    (h : o < pl.sourceSize) (hne : o ≠ offset)
    (hslot : FlatShuffler.Flat.get pl.source o = FlatShuffler.Flat.get pl.source offset)
    (hret : FlatShuffler.Flat.isRetained M o = true) (hdn : FlatShuffler.Flat.get dn o = 0) :
    FlatShuffler.Flat.otherFrom pl M dn offset o = true := by
  have hc1 : decide (o ≠ offset) = true := by simpa using hne
  have hc2 : decide (FlatShuffler.Flat.get pl.source o = FlatShuffler.Flat.get pl.source offset) = true :=
    by simpa using hslot
  have hc4 : decide (FlatShuffler.Flat.get dn o = 0) = true := by simpa using hdn
  rw [FlatShuffler.Flat.otherFrom.eq_1, dite_eq_left h, hc1, hc2, hc4, hret]
  simp

theorem low_bit_iff (x : UInt64) (c : Prop) [Decidable c] :
    (1 &&& (((x &&& 18446744073709551360) ||| ((if c then 1 else 0) &&& 255)).toUInt8.toUInt64) = 0) ↔
      ¬ c := by
  by_cases h : c <;> simp [h] <;> bv_decide

theorem ofBitVec_and_low48_eq {a b : BitVec 64}
    (h : UInt64.ofBitVec a &&& 281474976710655 = UInt64.ofBitVec b &&& 281474976710655) :
    a &&& 281474976710655 = b &&& 281474976710655 := by
  have h' : (UInt64.ofBitVec a &&& 281474976710655).toBitVec =
      (UInt64.ofBitVec b &&& 281474976710655).toBitVec := by rw [h]
  simpa using h'

theorem bitvec_lt_of_toNat_lt {a b : BitVec 64} (h : a.toNat < b.toNat) : a < b := by omega

theorem bitvec_not_le_of_toNat_lt {a b : BitVec 64} (h : a.toNat < b.toNat) : ¬ b ≤ a := by
  intro h2
  have h3 : b.toNat ≤ a.toNat := by omega
  omega

theorem slotWord_low48_eq_symm {s1 s2 : FlatShuffler.StackSlot} {p1 p2 : BitVec 16}
    (h : UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s1 p1) &&& 281474976710655 =
      UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord s2 p2) &&& 281474976710655) :
    s2 = s1 := by
  have h1 := ofBitVec_and_low48_eq h
  exact ((slotWord_low48_iff s1 s2 p1 p2).mp h1).symm

abbrev Inv (a : In2p) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (x : St In2p Heap) : Prop :=
  x.input = a ∧ x.mem = a.heap ∧ x.rbp = UInt64.ofBitVec pl.sourceSize ∧ x.rbx = a.rcx ∧
    x.r12 = a.rdi ∧ x.r14 = a.rdx ∧ x.r15 = a.rsi ∧ x.r13.toNat ≤ pl.sourceSize.toNat ∧
    x.rax &&& 18446744073709551360 =
      (if neFrom x.rbx x.r13.toNat then (4096 : UInt64) else a.rax &&& 18446744073709551360) ∧
    FlatShuffler.Flat.otherFrom pl M dn offset 0 =
      FlatShuffler.Flat.otherFrom pl M dn offset x.r13.toBitVec

def μ (pl : FlatShuffler.Flat.Planner) (x : St In2p Heap) : Nat :=
  pl.sourceSize.toNat - x.r13.toNat

def Out (a : In2p) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    (x : St In2p Heap) : UInt64 :=
  ((if neFrom x.rbx pl.sourceSize.toNat then (4096 : UInt64) else a.rax)
      &&& 18446744073709551360) |||
    ((if FlatShuffler.Flat.otherFrom pl M dn offset 0 then 1 else 0) &&& 255)

theorem low_byte_or (x : UInt64) (c : Bool) :
    ((x &&& 18446744073709551360) ||| ((if c then 1 else 0) &&& 255)).toBitVec.setWidth 8 =
      (if c then 1 else 0) := by
  cases c
  · simp only [Bool.false_eq_true, if_false, UInt64.toBitVec_and, UInt64.toBitVec_or,
      UInt64.toBitVec_ofNat]
    bv_decide
  · simp only [if_true, UInt64.toBitVec_and, UInt64.toBitVec_or, UInt64.toBitVec_ofNat]
    bv_decide

attribute [heap_load] loadB_ptr loadB_srcSize loadB_src loadB_dest loadB_dn
attribute [heap_norm] objsP_eq

abbrev callee : Unit → plannerIsRetained.In2p → UInt64 → Prop :=
  fun _ => (fun (x : plannerIsRetained.In2p) (r : UInt64) => plannerIsRetained.l2p.returns x r)

set_option maxHeartbeats 400000 in
theorem loop_returns (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word) (a : In2p)
    (pol : CpuPolicy) (m : DataMem)
    (hHolds : (objsP pl M dn offset ++ frame).Holds pol m)
    (hrdi : a.rdi.toBitVec = 0) (hrsi : a.rsi.toBitVec = 16384) (hrdx : a.rdx.toBitVec = 24576)
    (hrcx : a.rcx.toBitVec = offset)
    (hsize : pl.sourceSize.toNat ≤ FlatShuffler.maxStackSize)
    (hoff : offset.toNat < FlatShuffler.maxStackSize)
    (hheap : a.heap = objsP pl M dn offset ++ frame) :
    ∀ x, Inv a pl M dn offset x → blocksP'.Returns noCall .LBB22_1 x (Out a pl M dn offset x) := by
  refine Blocks.Returns.loop (Inv a pl M dn offset) (μ pl) (Out a pl M dn offset) ?_
  intro x hx ih
  obtain ⟨hxin, hxmem, hxrbp, hxrbx, hxr12, hxr14, hxr15, hxle, hxrax, hxoth⟩ := hx
  have hmem : x.mem = objsP pl M dn offset ++ frame := by rw [hxmem, hheap]
  have hlink13 : (x.r13.toBitVec).toNat = x.r13.toNat := UInt64.toNat_toBitVec x.r13
  have hlinkbp : (x.rbp.toBitVec).toNat = x.rbp.toNat := UInt64.toNat_toBitVec x.rbp
  have hrbpn : x.rbp.toNat = pl.sourceSize.toNat := by simp [hxrbp]
  have hmaxval : FlatShuffler.maxStackSize = 1024 := rfl
  by_cases h1 : x.rbp = x.r13
  · -- exit at LBB22_7
    have hle : x.rbp ≤ x.r13 := by simp [h1]
    have hr13v : x.r13 = UInt64.ofBitVec pl.sourceSize := by rw [← h1]; exact hxrbp
    have h13n : x.r13.toNat = pl.sourceSize.toNat := by rw [hr13v]; rfl
    have hoth0 : FlatShuffler.Flat.otherFrom pl M dn offset 0 = false := by
      have hrv : x.r13.toBitVec = pl.sourceSize := by rw [hr13v]
      rw [hxoth, hrv]
      exact otherFrom_not_lt pl M dn offset pl.sourceSize (by simp)
    refine Blocks.Returns.goto (l' := .LBB22_7) (s' := x) ?_ ?_
    · simp only [blocksP', if_pos h1]
    refine Blocks.Returns.ret (r := Out a pl M dn offset x) ?_
    have hnn : ¬¬ x.rbp ≤ x.r13 := fun hh => hh hle
    simp only [blocksP', Res.ok.injEq, Next.ret.injEq, if_neg hnn,
      Out, hoth0, if_false, UInt64.zero_and, UInt64.or_zero]
    rw [h13n] at hxrax
    rw [hxrax]
    cases hc : neFrom x.rbx pl.sourceSize.toNat
    · simp [hc]
    · simp only [hc, if_true]
      bv_decide
  · -- rbp ≠ r13
    have hne13 : x.r13.toNat ≠ pl.sourceSize.toNat := by
      intro he
      apply h1
      rw [hxrbp, ← UInt64.toNat_inj, UInt64.toNat_ofBitVec]
      exact he.symm
    have hlt13 : x.r13.toNat < pl.sourceSize.toNat := by omega
    have hlt13b : x.r13.toBitVec < pl.sourceSize := bitvec_lt_of_toNat_lt (by omega)
    have hrcxlt : a.rcx.toNat < FlatShuffler.maxStackSize := by
      have h1' : a.rcx.toBitVec.toNat = offset.toNat := by rw [hrcx]
      rw [UInt64.toNat_toBitVec] at h1'
      rw [h1']
      exact hoff
    have hbbx : (x.rbx.toBitVec).toNat < FlatShuffler.maxStackSize := by
      rw [UInt64.toNat_toBitVec, hxrbx]; exact hrcxlt
    have hb13 : (x.r13.toBitVec).toNat < FlatShuffler.maxStackSize := by omega
    have hrbxv : x.rbx.toBitVec = offset := by rw [hxrbx, hrcx]
    have load0 : x.mem.loadB x.r12.toBitVec .W64 = .ok (4096 : BitVec 64) := by
      rw [hmem, hxr12, hrdi]
      exact loadB_ptr frame pl M dn offset hHolds
    have loadSrcB : x.mem.loadB (4096 + x.rbx.toBitVec * 8) .W64 =
        .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord
          (pl.source.toList.getD (x.rbx.toBitVec).toNat default) (0 : BitVec 16)) := by
      rw [hmem]
      exact loadB_src frame pl M dn offset hHolds x.rbx.toBitVec hbbx
    have loadSrc13 : x.mem.loadB (4096 + x.r13.toBitVec * 8) .W64 =
        .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord
          (pl.source.toList.getD (x.r13.toBitVec).toNat default) (0 : BitVec 16)) := by
      rw [hmem]
      exact loadB_src frame pl M dn offset hHolds x.r13.toBitVec hb13
    have loadDest : x.mem.loadB (x.r15.toBitVec + x.r13.toBitVec * 8) .W64 =
        .ok (M.dest.toList.getD (x.r13.toBitVec).toNat 0) := by
      rw [hmem, hxr15, hrsi]
      exact loadB_dest frame pl M dn offset hHolds x.r13.toBitVec hb13
    have loadDn : x.mem.loadB (x.r14.toBitVec + x.r13.toBitVec * 1) .W8 =
        .ok (dn.toList.getD (x.r13.toBitVec).toNat 0) := by
      rw [hmem, hxr14, hrdx]
      have haddr : (24576 : BitVec 64) + x.r13.toBitVec * 1 = 24576 + x.r13.toBitVec := by
        bv_omega
      rw [haddr]
      exact loadB_dn frame pl M dn offset hHolds x.r13.toBitVec hb13
    have mkInv : ∀ (y : St In2p Heap), y.input = x.input → y.mem = x.mem → y.rbp = x.rbp →
        y.rbx = x.rbx → y.r12 = x.r12 → y.r14 = x.r14 → y.r15 = x.r15 →
        y.r13 = x.r13 + 1 →
        y.rax &&& 18446744073709551360 =
          (if neFrom y.rbx y.r13.toNat then (4096 : UInt64) else a.rax &&& 18446744073709551360) →
        FlatShuffler.Flat.otherFrom pl M dn offset 0 =
          FlatShuffler.Flat.otherFrom pl M dn offset y.r13.toBitVec →
        Inv a pl M dn offset y := by
      intro y h1' h2' h3' h4' h5' h6' h7' h8' h9' h10'
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [h1']; exact hxin
      · rw [h2']; exact hxmem
      · rw [h3']; exact hxrbp
      · rw [h4']; exact hxrbx
      · rw [h5']; exact hxr12
      · rw [h6']; exact hxr14
      · rw [h7']; exact hxr15
      · rw [h8', toNat_add_one x.r13 (by omega)]
        omega
      · exact h9'
      · exact h10'
    have mkDec : ∀ (y : St In2p Heap), y.r13 = x.r13 + 1 → μ pl y < μ pl x := by
      intro y h8'
      simp only [μ, h8', toNat_add_one x.r13 (by omega)]
      omega
    have mkRA : ∀ (v : UInt64), v &&& 18446744073709551360 = 4096 → x.rbx ≠ x.r13 →
        v &&& 18446744073709551360 =
          (if neFrom x.rbx (x.r13 + 1).toNat then (4096 : UInt64) else a.rax &&& 18446744073709551360) := by
      intro v hv hne
      rw [toNat_add_one x.r13 (by omega), hv,
        neFrom_true x.rbx x.r13.toNat (by rw [UInt64.ofNat_toNat]; exact fun he => hne he.symm)]
      simp
    by_cases h2 : x.rbx = x.r13
    · -- back edge: rbx = r13
      have hrv : x.r13.toBitVec = offset := by rw [← h2, hxrbx, hrcx]
      have hothS : FlatShuffler.Flat.otherFrom pl M dn offset 0 =
          FlatShuffler.Flat.otherFrom pl M dn offset (x.r13 + 1).toBitVec := by
        rw [hxoth, hrv, show (x.r13 + 1).toBitVec = offset + 1 by
          rw [UInt64.toBitVec_add, hrv, UInt64.toBitVec_one]
          rfl]
        exact otherFrom_step_self pl M dn offset (by bv_omega)
      refine Blocks.Returns.goto (l' := .o35) (s' := x) ?_ ?_
      · simp only [blocksP', if_neg h1]
      refine Blocks.Returns.goto (l' := .LBB22_6) (s' := x) ?_ ?_
      · simp only [blocksP', if_pos h2]
      refine Blocks.Returns.goto (l' := .LBB22_1) (s' := { x with r13 := x.r13 + 1 }) ?_ ?_
      · simp only [blocksP']
      apply ih
      · refine mkInv _ rfl rfl rfl rfl rfl rfl rfl rfl ?_ hothS
        rw [toNat_add_one x.r13 (by omega),
          neFrom_self x.rbx x.r13.toNat (by rw [h2, UInt64.ofNat_toNat])]
        exact hxrax
      · exact mkDec _ rfl
    · -- the body of the loop: o40
      have hofNat' : UInt64.ofNat x.r13.toNat ≠ x.rbx := by
        rw [UInt64.ofNat_toNat]
        intro he
        exact h2 he.symm
      refine Blocks.Returns.goto (l' := .o35) (s' := x) ?_ ?_
      · simp only [blocksP', if_neg h1]
      refine Blocks.Returns.goto (l' := .o40) (s' := x) ?_ ?_
      · simp only [blocksP', if_neg h2]
      by_cases hcmp : (UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
            (pl.source.toList.getD (x.rbx.toBitVec).toNat default) (0 : BitVec 16)) &&& 281474976710655 =
          UInt64.ofBitVec (Lift.Shuffler.Internal.Proposed.Layout.slotWord
            (pl.source.toList.getD (x.r13.toBitVec).toNat default) (0 : BitVec 16)) &&& 281474976710655)
      · -- the slots agree
        apply Blocks.Returns.goto (l' := .o58)
        · simp only [blocksP', load0, loadSrcB, loadSrc13, if_pos hcmp]
          try rfl
        apply Blocks.Returns.goto (l' := .o69)
        · simp only [blocksP', loadDest]
          try rfl
        by_cases hc : ¬ (UInt64.ofBitVec (M.dest.toList.getD (x.r13.toBitVec).toNat 0) =
          18446744073709551615)
        · -- retained: o73
          apply Blocks.Returns.goto (l' := .o73)
          · simp only [blocksP', low_bit_iff, hc]
            try rfl
          by_cases hdn : UInt64.ofBitVec (BitVec.zeroExtend 64
            (dn.toList.getD (x.r13.toBitVec).toNat 0)) = 0
          · -- dn is zero: return
            have hnotle : ¬ x.rbp ≤ x.r13 := bitvec_not_le_of_toNat_lt (by omega)
            have hothT : FlatShuffler.Flat.otherFrom pl M dn offset 0 = true := by
              rw [hxoth]
              apply otherFrom_true pl M dn offset x.r13.toBitVec hlt13b
              · intro he
                have hb : x.rbx.toBitVec = x.r13.toBitVec := by rw [hxrbx, hrcx]; exact he.symm
                exact h2 (UInt64.toBitVec_inj.mp hb)
              · rw [← hrbxv, get_source_eq, get_source_eq]
                exact slotWord_low48_eq_symm hcmp
              · rw [FlatShuffler.Flat.isRetained, get_dest_eq, bne_iff_ne]
                intro he
                apply hc
                rw [he]
                show UInt64.ofBitVec (-1 : BitVec 64) = 18446744073709551615
                bv_decide
              · rw [get_dn_eq]
                have h1' : BitVec.zeroExtend 64 (dn.toList.getD (x.r13.toBitVec).toNat 0) = 0 := by
                  have h2' := hdn
                  rw [UInt64.eq_iff_toBitVec_eq] at h2'
                  simpa using h2'
                bv_decide
            have hneT : neFrom x.rbx pl.sourceSize.toNat = true :=
              neFrom_mono x.rbx (by omega) (neFrom_true x.rbx x.r13.toNat hofNat')
            apply Blocks.Returns.goto (l' := .LBB22_7)
            · simp only [blocksP', loadDn, hdn]
              try rfl
            refine Blocks.Returns.ret (r := Out a pl M dn offset x) ?_
            simp only [blocksP', Res.ok.injEq, Next.ret.injEq, if_pos hnotle, Out, hothT,
              hneT, if_true, if_pos hc]
            bv_decide
          · -- dn is nonzero: back edge
            have hdn0 : FlatShuffler.Flat.get dn x.r13.toBitVec ≠ 0 := by
              rw [get_dn_eq]
              intro he
              apply hdn
              rw [he]
              rfl
            have hothS : FlatShuffler.Flat.otherFrom pl M dn offset 0 =
                FlatShuffler.Flat.otherFrom pl M dn offset (x.r13 + 1).toBitVec := by
              rw [hxoth, show (x.r13 + 1).toBitVec = x.r13.toBitVec + 1 by
                rw [UInt64.toBitVec_add, UInt64.toBitVec_one]
                rfl]
              exact otherFrom_step_dn_ne pl M dn offset x.r13.toBitVec hlt13b hdn0
            apply Blocks.Returns.goto (l' := .LBB22_6)
            · simp only [blocksP', loadDn, hdn]
              try rfl
            apply Blocks.Returns.goto (l' := .LBB22_1)
            · simp only [blocksP']
              try rfl
            apply ih
            · refine mkInv _ rfl rfl rfl rfl rfl rfl rfl rfl ?_ hothS
              refine mkRA _ ?_ h2
              simp only [if_pos hc]
              bv_decide
            · exact mkDec _ rfl
        · -- not retained: back edge
          have hret0 : FlatShuffler.Flat.isRetained M x.r13.toBitVec = false := by
            apply isRetained_eq_false
            rw [get_dest_eq]
            have hb : UInt64.ofBitVec (M.dest.toList.getD (x.r13.toBitVec).toNat 0) =
                18446744073709551615 := by
              by_cases hP : UInt64.ofBitVec (M.dest.toList.getD (x.r13.toBitVec).toNat 0) = 18446744073709551615
              · exact hP
              · exact absurd hP hc
            have h1' : (UInt64.ofBitVec (M.dest.toList.getD (x.r13.toBitVec).toNat 0)).toBitVec =
                (-1 : BitVec 64) := by
              rw [hb]
              bv_decide
            simpa [FlatShuffler.Flat.NONE] using h1'
          have hothS : FlatShuffler.Flat.otherFrom pl M dn offset 0 =
              FlatShuffler.Flat.otherFrom pl M dn offset (x.r13 + 1).toBitVec := by
            rw [hxoth, show (x.r13 + 1).toBitVec = x.r13.toBitVec + 1 by
              rw [UInt64.toBitVec_add, UInt64.toBitVec_one]
              rfl]
            exact otherFrom_step_not_retained pl M dn offset x.r13.toBitVec hlt13b hret0
          apply Blocks.Returns.goto (l' := .LBB22_6)
          · simp only [blocksP', low_bit_iff, hc]
            try rfl
          apply Blocks.Returns.goto (l' := .LBB22_1)
          · simp only [blocksP']
            try rfl
          apply ih
          · refine mkInv _ rfl rfl rfl rfl rfl rfl rfl rfl ?_ hothS
            refine mkRA _ ?_ h2
            simp only [if_neg hc]
            bv_decide
          · exact mkDec _ rfl
      · -- the slots differ: back edge
        have hrbxv : x.rbx.toBitVec = offset := by rw [hxrbx, hrcx]
        have hslot : FlatShuffler.Flat.get pl.source x.r13.toBitVec ≠
            FlatShuffler.Flat.get pl.source offset := by
          rw [← hrbxv, get_source_eq, get_source_eq]
          intro he
          apply hcmp
          rw [he]
        have hothS : FlatShuffler.Flat.otherFrom pl M dn offset 0 =
            FlatShuffler.Flat.otherFrom pl M dn offset (x.r13 + 1).toBitVec := by
          rw [hxoth, show (x.r13 + 1).toBitVec = x.r13.toBitVec + 1 by
            rw [UInt64.toBitVec_add, UInt64.toBitVec_one]
            rfl]
          exact otherFrom_step_slot_ne pl M dn offset x.r13.toBitVec hlt13b hslot
        apply Blocks.Returns.goto (l' := .LBB22_6)
        · simp only [blocksP', load0, loadSrcB, loadSrc13, if_neg hcmp]
          try rfl
        apply Blocks.Returns.goto (l' := .LBB22_1)
        · simp only [blocksP']
          try rfl
        apply ih
        · refine mkInv _ rfl rfl rfl rfl rfl rfl rfl rfl ?_ hothS
          refine mkRA _ ?_ h2
          bv_decide
        · exact mkDec _ rfl
end loop

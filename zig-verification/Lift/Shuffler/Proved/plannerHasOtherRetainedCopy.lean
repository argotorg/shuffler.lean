theorem loadB_src (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    {policy : CpuPolicy} {m : DataMem} (hh : (objsP pl M dn offset ++ frame).Holds policy m)
    (i : BitVec 64) (hi : i.toNat < FlatShuffler.maxStackSize) :
    (objsP pl M dn offset ++ frame).loadB (4096 + i * 8) .W64 =
      .ok (Lift.Shuffler.Internal.Proposed.Layout.slotWord (pl.source.toList.getD i.toNat default) (0 : BitVec 16)) := by
  apply Heap.loadB_of_load
  have hlen : i.toNat < (srcCells pl).length := by simpa [srcCells] using hi
  have := Heap.load_words64_mul (h := objsP pl M dn offset ++ frame) hh
    (mem_src_arr frame pl M dn offset) hlen
  simpa only [srcCells, List.getElem_map, List.getElem_range] using this

theorem loadB_dest (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    {policy : CpuPolicy} {m : DataMem} (hh : (objsP pl M dn offset ++ frame).Holds policy m)
    (i : BitVec 64) (hi : i.toNat < FlatShuffler.maxStackSize) :
    (objsP pl M dn offset ++ frame).loadB (16384 + i * 8) .W64 =
      .ok (M.dest.toList.getD i.toNat 0) := by
  apply Heap.loadB_of_load
  have hlen : i.toNat < M.dest.toList.length := by simpa using hi
  have := Heap.load_words64_mul (h := objsP pl M dn offset ++ frame) hh
    (mem_dest_arr frame pl M dn offset) hlen
  simpa [List.getElem?_eq_getElem hlen] using this

theorem loadB_dn (frame : Heap) (pl : FlatShuffler.Flat.Planner) (M : FlatShuffler.Flat.Mapping)
    (dn : Vector (BitVec 8) FlatShuffler.maxStackSize) (offset : FlatShuffler.Word)
    {policy : CpuPolicy} {m : DataMem} (hh : (objsP pl M dn offset ++ frame).Holds policy m)
    (i : BitVec 64) (hi : i.toNat < FlatShuffler.maxStackSize) :
    (objsP pl M dn offset ++ frame).loadB (24576 + i) .W8 =
      .ok (dn.toList.getD i.toNat 0) := by
  apply Heap.loadB_of_load
  have hlen : i.toNat < dn.toList.length := by simpa using hi
  have h := Heap.load_words (h := objsP pl M dn offset ++ frame) hh
    (mem_dn_arr frame pl M dn offset) (w := .W8) (k := i.toNat) hlen
  rw [show BitVec.ofNat 64 (Width.W8.bytes * i.toNat) = i by
    apply BitVec.eq_of_toNat_eq
    simp [Width.bytes]] at h
  simpa [List.getElem?_eq_getElem hlen] using h

theorem plannerIsRetained_returns (x : St In2p Heap) (v : BitVec 64)
    (hv : x.mem.loadB (x.r15.toBitVec + x.r13.toBitVec * 8) .W64 = .ok v) :
    plannerIsRetained.l2p.returns ⟨x.mem, x.rax, x.r13, x.r15⟩
      ((x.rax &&& 18446744073709551360) |||
        ((if ¬ (UInt64.ofBitVec v = 18446744073709551615) then 1 else 0) &&& 255)) := by
  change plannerIsRetained.blocksP.Returns noCall plannerIsRetained.Lbl.entry
    (plannerIsRetained.initP ⟨x.mem, x.rax, x.r13, x.r15⟩) _
  apply Blocks.Returns.ret
  change (match x.mem.loadB (x.r15.toBitVec + x.r13.toBitVec * 8) .W64 with
    | .ok v => Res.ok (Next.ret ((x.rax &&& 18446744073709551360) |||
        ((if ¬ (UInt64.ofBitVec v = 18446744073709551615) then 1 else 0) &&& 255)))
    | .stuck why => .stuck why
    | .noFuel => .noFuel) = .ok (.ret _)
  rw [hv]

def blocksP' : Leaf Lbl (St In2p Heap) UInt64 where
  step
    | .entry, x =>
      match x.mem.loadB (x.rdi.toBitVec + 8) .W64 with
      | .ok v =>
        .ok (.goto .LBB22_1 { x with rbx := x.rcx, rbp := UInt64.ofBitVec v, r12 := x.rdi, r13 := 0, r14 := x.input.rdx, r15 := x.rsi })
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .LBB22_1, x =>
      .ok (if x.rbp = x.r13 then .goto .LBB22_7 x else .goto .o35 x)
    | .o35, x =>
      .ok (if x.rbx = x.r13 then .goto .LBB22_6 x else .goto .o40 x)
    | .o40, x =>
      match x.mem.loadB x.r12.toBitVec .W64 with
      | .ok v =>
        match x.mem.loadB (v + x.rbx.toBitVec * 8) .W64 with
        | .ok v1 =>
          match x.mem.loadB (v + x.r13.toBitVec * 8) .W64 with
          | .ok v2 =>
            .ok (if UInt64.ofBitVec v1 &&& 281474976710655 = UInt64.ofBitVec v2 &&& 281474976710655 then .goto .o58 { x with rcx := (UInt64.ofBitVec v1 ^^^ UInt64.ofBitVec v2) <<< (16 : UInt64), rax := UInt64.ofBitVec v } else .goto .LBB22_6 { x with rcx := (UInt64.ofBitVec v1 ^^^ UInt64.ofBitVec v2) <<< (16 : UInt64), rax := UInt64.ofBitVec v })
          | .stuck why => .stuck why
          | .noFuel => .noFuel
        | .stuck why => .stuck why
        | .noFuel => .noFuel
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o58, x =>
      match x.mem.loadB (x.r15.toBitVec + x.r13.toBitVec * 8) .W64 with
      | .ok v =>
        .ok (.goto .o69 { x with rsi := x.r13, rdi := x.r15, rax := (x.rax &&& 18446744073709551360) ||| ((if ¬ (UInt64.ofBitVec v = 18446744073709551615) then 1 else 0) &&& 255) })
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .o69, x =>
      .ok (if 1 &&& (x.rax).toUInt8.toUInt64 = 0 then .goto .LBB22_6 x else .goto .o73 x)
    | .o73, x =>
      match x.mem.loadB (x.r14.toBitVec + x.r13.toBitVec * 1) .W8 with
      | .ok v =>
        .ok (if UInt64.ofBitVec (BitVec.zeroExtend 64 v) = 0 then .goto .LBB22_7 x else .goto .LBB22_6 x)
      | .stuck why => .stuck why
      | .noFuel => .noFuel
    | .LBB22_6, x =>
      .ok (.goto .LBB22_1 { x with r13 := x.r13 + 1 })
    | .LBB22_7, x =>
      .ok (.ret ((x.rax &&& 18446744073709551360) ||| ((if ¬ (x.rbp ≤ x.r13) then 1 else 0) &&& 255)))


    (h : blocksP'.Returns noCall l x r) :
    blocksP.Returns (fun _ => (fun (x : plannerIsRetained.In2p) (r : UInt64) => plannerIsRetained.l2p.returns x r)) l x r := by
  refine @Blocks.Returns.rec Lbl (St In2p Heap) UInt64 Empty Empty.elim Empty.elim blocksP' noCall
    (fun l x r _ => blocksP.Returns (fun _ => (fun (x : plannerIsRetained.In2p) (r : UInt64) => plannerIsRetained.l2p.returns x r)) l x r)
    ?_ ?_ ?_ l x r h

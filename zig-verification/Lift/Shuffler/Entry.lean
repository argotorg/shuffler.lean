module

public import Lift.P1.Command
public import Lift.P1.Execution
public import Lift.Shuffler.Code

@[expose] public section

/-! The entry PC of each of the 31 functions of the full shuffler (`Lift/Shuffler/Code.lean`), and the first address after
the code (SH-C). The values are the addresses of the labels in `Code.code`; the theorems below check each value against the
labels. Generated by `scratch/shc/mkentry.py` from `scratch/shc/Layout.lean`. -/

namespace Lift.Shuffler

def shufflePC : Int64 := 0x100000
def workspaceAlignmentPC : Int64 := 0x10049b
def plannerRunPC : Int64 := 0x10049f
def workspaceSizePC : Int64 := 0x1007c6
def plannerResolvePC : Int64 := 0x1007cc
def emissionRunPC : Int64 := 0x100962
def spillSetAddPC : Int64 := 0x100a43
def emissionBuildBottomUpPC : Int64 := 0x100a73
def emissionIsAvailablePC : Int64 := 0x100da0
def emissionSwapWithPC : Int64 := 0x100def
def emissionGeneratePC : Int64 := 0x100ec0
def emissionShallowestCopyPositionPC : Int64 := 0x100f67
def emissionProducePC : Int64 := 0x100f8d
def emissionIsSpilledPC : Int64 := 0x101067
def emissionDupPC : Int64 := 0x101094
def emissionPushPC : Int64 := 0x10112f
def emissionPermutePC : Int64 := 0x1011cc
def emissionPermuteAtLowestHeightPC : Int64 := 0x10141c
def emissionRemoveSurplusPC : Int64 := 0x1014cc
def plannerClassifyPC : Int64 := 0x1015ed
def emissionPopPC : Int64 := 0x101714
def plannerIsDemandedPC : Int64 := 0x10176e
def plannerHasOtherRetainedCopyPC : Int64 := 0x1017b5
def mappingBuilderAbsorbSurplusPC : Int64 := 0x10181f
def plannerIsRetainedPC : Int64 := 0x10190d
def mappingBuilderMapPC : Int64 := 0x101916
def mappingBuilderKeepWildcardSlotsPC : Int64 := 0x101949
def mappingBuilderMapWildcardSlotCopiesPC : Int64 := 0x1019d5
def mappingBuilderMapClosestCopiesPC : Int64 := 0x101a79
def mappingBuilderClosestCopyPC : Int64 := 0x101afb
def mappingBuilderMapInPlacePC : Int64 := 0x101bc6

/-- The first address after the code. -/
def shufflerEndPC : Int64 := 0x101c36

/-- Each entry PC is the address of the label of its name. -/
theorem entryPCs_label :
    [("solidity_shuffler_shuffle", shufflePC),
      ("solidity_shuffler_workspaceAlignment", workspaceAlignmentPC),
      (".Lshuffler.Planner.run", plannerRunPC),
      ("solidity_shuffler_workspaceSize", workspaceSizePC),
      (".Lshuffler.Planner.resolve", plannerResolvePC),
      (".Lshuffler.Emission.run", emissionRunPC),
      (".Lshuffler.SpillSet.add", spillSetAddPC),
      (".Lshuffler.Emission.buildBottomUp", emissionBuildBottomUpPC),
      (".Lshuffler.Emission.isAvailable", emissionIsAvailablePC),
      (".Lshuffler.Emission.swapWith", emissionSwapWithPC),
      (".Lshuffler.Emission.generate", emissionGeneratePC),
      (".Lshuffler.Emission.shallowestCopyPosition", emissionShallowestCopyPositionPC),
      (".Lshuffler.Emission.produce", emissionProducePC),
      (".Lshuffler.Emission.isSpilled", emissionIsSpilledPC),
      (".Lshuffler.Emission.dup", emissionDupPC),
      (".Lshuffler.Emission.push", emissionPushPC),
      (".Lshuffler.Emission.permute", emissionPermutePC),
      (".Lshuffler.Emission.permuteAtLowestHeight", emissionPermuteAtLowestHeightPC),
      (".Lshuffler.Emission.removeSurplus", emissionRemoveSurplusPC),
      (".Lshuffler.Planner.classify", plannerClassifyPC),
      (".Lshuffler.Emission.pop", emissionPopPC),
      (".Lshuffler.Planner.isDemanded", plannerIsDemandedPC),
      (".Lshuffler.Planner.hasOtherRetainedCopy", plannerHasOtherRetainedCopyPC),
      (".Lshuffler.MappingBuilder.absorbSurplus", mappingBuilderAbsorbSurplusPC),
      (".Lshuffler.Planner.isRetained", plannerIsRetainedPC),
      (".Lshuffler.MappingBuilder.map", mappingBuilderMapPC),
      (".Lshuffler.MappingBuilder.keepWildcardSlots", mappingBuilderKeepWildcardSlotsPC),
      (".Lshuffler.MappingBuilder.mapWildcardSlotCopies", mappingBuilderMapWildcardSlotCopiesPC),
      (".Lshuffler.MappingBuilder.mapClosestCopies", mappingBuilderMapClosestCopiesPC),
      (".Lshuffler.MappingBuilder.closestCopy", mappingBuilderClosestCopyPC),
      (".Lshuffler.MappingBuilder.mapInPlace", mappingBuilderMapInPlacePC)].all
      (fun p => (Code.code.labels).label p.1 == p.2) = true := by
  unfold Executable.labels
  rw [Lift.P1.withAddresses_eq]
  decide +kernel

/-- The sizes of the code add up to `shufflerEndPC`. -/
theorem shufflerEndPC_eq :
    Code.code.startAddr + Int64.ofNat (Code.code.sizeBefore Code.code.program.length) = shufflerEndPC := by
  decide +kernel

theorem shufflePC_start : shufflePC = Code.code.startAddr := by decide +kernel

end Lift.Shuffler

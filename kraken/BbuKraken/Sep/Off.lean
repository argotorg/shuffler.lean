module

@[expose] public section

/-!
The lemmas on struct offsets that `Fields.lean` (generated by `test/gen_fields.sh`) uses.
-/

namespace Bbu.Fld

theorem off_zero (S : BitVec 64) : S = S + BitVec.ofNat 64 0 := by simp

theorem off_arr (S : BitVec 64) (o i : Nat) :
    S + BitVec.ofNat 64 o + BitVec.ofNat 64 (8 * i) = S + BitVec.ofNat 64 (o + 8 * i) := by
  rw [BitVec.add_assoc, ← BitVec.ofNat_add]

theorem in_off {S : BitVec 64} {o B : Nat} (h : o + 8 ≤ B) (hB : B ≤ 2 ^ 64) :
    (S + BitVec.ofNat 64 o - S).toNat + 8 ≤ B := by
  rw [BitVec.add_comm S, BitVec.add_sub_cancel, BitVec.toNat_ofNat]; omega

theorem toNat_off {S : BitVec 64} {o B : Nat} (hS : S.toNat + B ≤ 2 ^ 64) (h : o < B) :
    (S + BitVec.ofNat 64 o).toNat = S.toNat + o := by
  rw [BitVec.toNat_add, BitVec.toNat_ofNat]; omega

-- The asm address `S + x * 8 + o` of element `x` of an array at offset `o`.
theorem fold_arr (S x : BitVec 64) (o : Nat) :
    S + x * 8#64 + BitVec.ofNat 64 o = S + BitVec.ofNat 64 o + BitVec.ofNat 64 (8 * x.toNat) := by
  bv_omega

end Bbu.Fld
